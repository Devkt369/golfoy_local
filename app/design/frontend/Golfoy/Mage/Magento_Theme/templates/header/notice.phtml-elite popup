<?php 
    // Code to fetch customer group if logged in
    $objectManager = \Magento\Framework\App\ObjectManager::getInstance();
    $customerSession = $objectManager->get('Magento\Customer\Model\Session');
    $customerGroup = null;
    $customerGroupId = null;
    $isLoggedIn = false;

    if ($customerSession->isLoggedIn()) {
        $isLoggedIn = true;
        $customer = $customerSession->getCustomer();
        $customerGroupId = $customer->getGroupId();
        
        // Get customer group model
        $customerGroupRepository = $objectManager->get('Magento\Customer\Api\GroupRepositoryInterface');
        try {
            $customerGroup = $customerGroupRepository->getById($customerGroupId);
        } catch (\Exception $e) {
            $customerGroup = null;
        }
    }

    echo $this->getLayout()->createBlock('Magento\Cms\Block\Block')->setBlockId('notice_header')->toHtml();
?>

