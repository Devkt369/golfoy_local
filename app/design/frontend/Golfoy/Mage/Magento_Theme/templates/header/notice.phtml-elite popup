<script type="text/javascript">
    require(["jquery", "bootstrap"], function(jQuery) {
        jQuery(document).ready(function() {
            // Elite Popup functionality
            function setCookie(name, value, days) {
                var expires = "";
                if (days) {
                    var date = new Date();
                    date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
                    expires = "; expires=" + date.toUTCString();
                }
                document.cookie = name + "=" + (value || "") + expires + "; path=/";
            }

            function getCookie(name) {
                var nameEQ = name + "=";
                var ca = document.cookie.split(';');
                for(var i = 0; i < ca.length; i++) {
                    var c = ca[i];
                    while (c.charAt(0) == ' ') c = c.substring(1, c.length);
                    if (c.indexOf(nameEQ) == 0) return c.substring(nameEQ.length, c.length);
                }
                return null;
            }

            // Show Elite popup if conditions are met and cookie is not set
            if (jQuery('#elitePopup').length > 0) {
                var elitePopupCookie = getCookie('elitePopupShown');
                if (!elitePopupCookie) {
                    jQuery('#elitePopup').show().css('display', 'flex');
                }
            }

            // Close popup and set cookie
            jQuery('#closeElitePopup').on('click', function() {
                jQuery('#elitePopup').fadeOut();
                setCookie('elitePopupShown', '1', 1); // Set cookie for 1 day
            });

            // Close popup when clicking outside
            jQuery('#elitePopup').on('click', function(e) {
                if (e.target === this) {
                    jQuery('#elitePopup').fadeOut();
                    setCookie('elitePopupShown', '1', 1); // Set cookie for 1 day
                }
            });

            // Add 'no_notice' class to body by default
            jQuery("body").addClass("no_notice");

            // Function to check and remove 'no_notice' class if 'notice_top' is not found
            function checkNoticeTop() {
                if (jQuery(".notice_top").length === 0) {
                    jQuery("body").removeClass("no_notice");
                }
            }

            // Initial check when the page loads
            checkNoticeTop();

            // Event handler for closing notice
            jQuery(".close_notice").on("click", function() {
                jQuery("body").removeClass("no_notice");
            });

            // Check again after any DOM manipulation or AJAX loading
            jQuery(document).ajaxComplete(function() {
                checkNoticeTop();
            });
        });
    });
</script>

