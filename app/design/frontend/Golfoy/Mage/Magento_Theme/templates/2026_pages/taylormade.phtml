<script>
    // Magento2 compatible jQuery
    require(['jquery'], function($) {
        'use strict';

        $(document).ready(function() {

            // ======================================
            // GENERIC SLIDER FACTORY (JQUERY)
            // ======================================
            var initSlider = function($container, $prevBtn, $nextBtn, $bullets) {
                if (!$container.length) return null;

                var $wrapper = $container.find(".swiper-wrapper");
                if (!$wrapper.length) return null;

                var total = $wrapper.children().length;
                var index = 0;
                var slidePercent = $(window).width() < 768 ? 100 : 70;
                var startX = 0;
                var getMaxIndex = function() {
                    return total - 1;
                };
                var currentX = 0;
                var isDragging = false;

                var getSlideWidth = function() {
                    var slide = $wrapper.children().first();
                    return slide.outerWidth(true); // true = include margin
                };

                var getTranslateX = function() {
                    if ($(window).width() < 768) {
                        return index * getSlideWidth();
                    }
                    return index * slidePercent;
                };

                var update = function() {
                    slidePercent = $(window).width() < 768 ? 100 : 70;

                    index = Math.min(index, getMaxIndex());

                    if ($(window).width() < 768) {
                        $wrapper.css(
                            'transform',
                            'translateX(-' + getTranslateX() + 'px)'
                        );
                    } else {
                        $wrapper.css(
                            'transform',
                            'translateX(-' + (index * slidePercent) + '%)'
                        );
                    }


                    if ($bullets && $bullets.length) {
                        $bullets.each(function(i) {
                            if (i === index) {
                                $(this).addClass("swiper-pagination-bullet-active");
                            } else {
                                $(this).removeClass("swiper-pagination-bullet-active");
                            }
                        });
                    }

                    if ($prevBtn && $prevBtn.length) {
                        if (index === 0) {
                            $prevBtn.addClass("swiper-button-disabled");
                        } else {
                            $prevBtn.removeClass("swiper-button-disabled");
                        }
                    }

                    if ($nextBtn && $nextBtn.length) {
                        if (index === total - 1) {
                            $nextBtn.addClass("swiper-button-disabled");
                        } else {
                            $nextBtn.removeClass("swiper-button-disabled");
                        }
                    }
                };

                // Button Handlers
                if ($prevBtn && $prevBtn.length) {
                    $prevBtn.on('click', function(e) {
                        e.preventDefault();
                        if (index > 0) {
                            index--;
                            update();
                        }
                    });
                }

                if ($nextBtn && $nextBtn.length) {
                    $nextBtn.on('click', function(e) {
                        e.preventDefault();
                        if (index < total - 1) {
                            index++;
                            update();
                        }
                    });
                }

                if ($bullets && $bullets.length) {
                    $bullets.on('click', function(e) {
                        e.preventDefault();
                        index = $(this).index();
                        update();
                    });
                }

                // Touch / Drag
                var startDrag = function(x) {
                    isDragging = true;
                    startX = x;
                    $wrapper.css('transition', 'none');
                };

                var onDrag = function(x) {
                    if (!isDragging) return;
                    currentX = x - startX;
                    if ($(window).width() < 768) {
                        $wrapper.css(
                            'transform',
                            'translateX(-' + (getTranslateX() - currentX) + 'px)'
                        );
                    } else {
                        $wrapper.css(
                            'transform',
                            'translateX(calc(-' + (index * slidePercent) + '% + ' + currentX + 'px))'
                        );
                    }

                };

                var endDrag = function() {
                    if (!isDragging) return;
                    isDragging = false;
                    $wrapper.css('transition', 'transform 0.5s ease');

                    var threshold = $(window).width() < 768 ? 40 : 60;

                    if (currentX < -threshold && index < total - 1) index++;
                    if (currentX > threshold && index > 0) index--;

                    currentX = 0;
                    slidePercent = $(window).width() < 768 ? 100 : 70;

                    update();
                };

                $container.on('touchstart', function(e) {
                    if (e.touches && e.touches[0]) {
                        startDrag(e.touches[0].clientX);
                    }
                });

                $container.on('touchmove', function(e) {
                    if (e.touches && e.touches[0]) {
                        onDrag(e.touches[0].clientX);
                    }
                });

                $container.on('touchend', endDrag);
                $container.on('mousedown', function(e) {
                    startDrag(e.clientX);
                });

                $container.on('mousemove', function(e) {
                    onDrag(e.clientX);
                });

                $container.on('mouseup', endDrag);
                $container.on('mouseleave', endDrag);

                update();

                return {
                    goTo: function(i) {
                        index = i;
                        update();
                    }
                };
            };

            // ======================================
            // MAIN SLIDER
            // ======================================
            var mainSlider = null;

            $(document).on('mouseenter', '.swiper-container321', function() {
                if (!mainSlider) {
                    mainSlider = initSlider(
                        $('.swiper-container321'),
                        $('.btn-prev-0'),
                        $('.btn-next-0'),
                        $('.swiper-pagination321 .swiper-pagination-bullet')
                    );
                }
            });

            if ($(window).width() < 768) {
                $(document).on('touchstart', '.swiper-container321', function() {
                    if (!mainSlider) {
                        mainSlider = initSlider(
                            $('.swiper-container321'),
                            $('.btn-prev-0'),
                            $('.btn-next-0'),
                            $('.swiper-pagination321 .swiper-pagination-bullet')
                        );
                    }
                });
                $(document).on('click', 'span.swiper-pagination-bullet', function() {
                    if (!mainSlider) {
                        mainSlider = initSlider(
                            $('.swiper-container321'),
                            $('.btn-prev-0'),
                            $('.btn-next-0'),
                            $('.swiper-pagination321 .swiper-pagination-bullet')
                        );
                    }
                });
            }

            // ======================================
            // MODAL SLIDER
            // ======================================
            var modalSlider = initSlider(
                $('.swiper-container-1'),
                $('.modal .swiper-button-prev'),
                $('.modal .swiper-button-next'),
                null
            );

            // ======================================
            // MODAL OPEN / CLOSE
            // ======================================
            var $modal = $('.modal-wrapper');

            $(document).on('click', '.open-modal', function(e) {
                e.preventDefault();
                if ($modal.length && modalSlider) {
                    $modal.addClass('active');
                    var modalIndex = Number($(this).data('index'));
                    modalSlider.goTo(modalIndex);
                }
            });

            $(document).on('click', '.btn-close', function(e) {
                e.preventDefault();
                if ($modal.length) {
                    $modal.removeClass('active');
                }
            });

            // ======================================
            // CLUB TYPE NAVIGATION
            // ======================================
            var $navContainer = $("#qi4d-nav-container");
            var $nav = $("#qi4d-nav");
            var $toggleSection = $(".qi4d-toggle-info");
            var $compareSection = $(".qi4d-compare");

            if ($nav.length) {
                var infoSections = {
                    driver: $(".qi4d-drivers-info"),
                    fairway: $(".qi4d-fairways-info"),
                    hybrid: $(".qi4d-hybrids-info")
                };

                var tableSections = {
                    driver: $(".drivers-compare-table"),
                    fairway: $(".fairways-compare-table"),
                    hybrid: $(".hybrids-compare-table")
                };

                // Initialize: Hide all sections, show hybrid by default
                $.each(infoSections, function(key, $el) {
                    if ($el.length) {
                        $el.addClass("d-none");
                    }
                });

                $.each(tableSections, function(key, $el) {
                    if ($el.length) {
                        $el.addClass("d-none");
                    }
                });

                if (infoSections.hybrid.length) {
                    infoSections.hybrid.removeClass("d-none");
                }
                if (tableSections.hybrid.length) {
                    tableSections.hybrid.removeClass("d-none");
                }

                // Set initial selected state
                $nav.find("a[data-club]").removeClass("selected");
                $nav.find('[data-club="hybrid"]').addClass("selected");

                // Handle club type tab clicks
                $(document).on('click', 'a[data-club]', function(e) {
                    var $this = $(this);
                    if (!$this.closest("#qi4d-nav").length) return;

                    e.preventDefault();
                    var club = $this.data('club');

                    // Update nav selection
                    $nav.find("a[data-club]").removeClass("selected");
                    $this.addClass("selected");

                    // Hide all sections
                    $.each(infoSections, function(key, $el) {
                        if ($el.length) {
                            $el.addClass("d-none");
                        }
                    });

                    $.each(tableSections, function(key, $el) {
                        if ($el.length) {
                            $el.addClass("d-none");
                        }
                    });

                    // Show selected section
                    if (infoSections[club] && infoSections[club].length) {
                        infoSections[club].removeClass("d-none");
                    }
                    if (tableSections[club] && tableSections[club].length) {
                        tableSections[club].removeClass("d-none");
                    }
                });
            }

            // ======================================
            // PRODUCT TILES CATEGORY SWITCHER
            // ======================================
            $(document).on('click', '.qi4d-product-navs a.show-qi4d-driver-products', function(e) {
                e.preventDefault();
                $('.qi4d-product-navs a').removeClass('is-active-product');
                $(this).addClass('is-active-product');
                $(".show-qi4d-hybrid-products").removeClass("selected");
                $(".qi4d-drivers-products.tw-flex").removeClass("d-none");
                $(".qi4d-fairways-products.tw-flex").addClass("d-none");
                $(".qi4d-hybrids-products.tw-flex").addClass("d-none");
            });

            $(document).on('click', '.qi4d-product-navs a.show-qi4d-fairway-products', function(e) {
                e.preventDefault();
                $('.qi4d-product-navs a').removeClass('is-active-product');
                $(this).addClass('is-active-product');
                $(".show-qi4d-hybrid-products").removeClass("selected");
                $(".qi4d-drivers-products.tw-flex").addClass("d-none");
                $(".qi4d-fairways-products.tw-flex").removeClass("d-none");
                $(".qi4d-hybrids-products.tw-flex").addClass("d-none");
            });

            $(document).on('click', '.qi4d-product-navs a.show-qi4d-hybrid-products', function(e) {
                e.preventDefault();
                $('.qi4d-product-navs a').removeClass('is-active-product');
                $(this).addClass('is-active-product');
                $(".show-qi4d-fairway-products").removeClass("selected");
                $(".qi4d-drivers-products.tw-flex").addClass("d-none");
                $(".qi4d-fairways-products.tw-flex").addClass("d-none");
                $(".qi4d-hybrids-products.tw-flex").removeClass("d-none");
            });
            $(document).on('click', '.qi4d-drivers-info-select', function(e) {
                e.preventDefault();
                // console.log("Driver Products");
                $('.qi4d-product-navs a').removeClass('selected');
                $('.qi4d-fairways-info-select').removeClass('selected');
                $('.qi4d-hybrids-info-select').removeClass('selected');
                $(this).addClass('selected');
                $(".compare-cards.drivers-compare-table").removeClass('d-none');
                $(".tw-flex.qi4d-drivers-info").removeClass('d-none');
                $(".tw-flex.qi4d-fairways-info").addClass('d-none');
                $(".tw-flex.qi4d-hybrids-info").addClass('d-none');
                $(".compare-cards.fairways-compare-table").addClass('d-none');
                $(".compare-cards.hybrids-compare-table").addClass('d-none');
            });

            $(document).on('click', '.qi4d-fairways-info-select', function(e) {
                e.preventDefault();
                // console.log("Fairway Products");
                $('.qi4d-product-navs a').removeClass('selected');
                $('.qi4d-drivers-info-select').removeClass('selected');
                $('.qi4d-hybrids-info-select').removeClass('selected');
                $(this).addClass('selected');
                $(".compare-cards.drivers-compare-table").addClass('d-none');
                $(".compare-cards.fairways-compare-table").removeClass('d-none');
                $(".tw-flex.qi4d-drivers-info").addClass('d-none');
                $(".tw-flex.qi4d-fairways-info").removeClass('d-none');
                $(".tw-flex.qi4d-hybrids-info").addClass('d-none');
                $(".compare-cards.hybrids-compare-table").addClass('d-none');
            });

            $(document).on('click', '.qi4d-hybrids-info-select', function(e) {
                e.preventDefault();
                // console.log("Hybrid Products");
                $('.qi4d-product-navs a').removeClass('selected');
                $('.qi4d-drivers-info-select').removeClass('selected');
                $('.qi4d-fairways-info-select').removeClass('selected');
                $(this).addClass('selected');
                $(".compare-cards.drivers-compare-table").addClass('d-none');
                $(".compare-cards.fairways-compare-table").addClass('d-none');
                $(".compare-cards.hybrids-compare-table").removeClass('d-none');
                $(".tw-flex.qi4d-drivers-info").addClass('d-none');
                $(".tw-flex.qi4d-fairways-info").addClass('d-none');
                $(".tw-flex.qi4d-hybrids-info").removeClass('d-none');
            });

            // ======================================
            // STICKY NAVIGATION
            // ======================================
            let originalOffsetTop = 0;

            function updateOffset() {
                const $navContainer = jQuery('#qi4d-nav-container');
                if ($navContainer.length) {
                    originalOffsetTop = $navContainer.offset().top;
                }
            }

            jQuery(window).on('load resize', updateOffset);
            updateOffset();

            if ($(window).width() > 768) {
                let isNavFixed = false;
                let ticking = false;

                function isElementAboveViewport($el, offset = 0) {
                    if (!$el.length) return false;

                    const elementBottom = $el.offset().top + $el.outerHeight();
                    const viewportTop = jQuery(window).scrollTop() + offset;

                    return elementBottom < viewportTop;
                }

                jQuery(window).on('scroll', function() {

                    if (ticking) return;
                    ticking = true;

                    window.requestAnimationFrame(function() {

                        const $window = jQuery(window);
                        const scrollTop = $window.scrollTop();
                        const $video = jQuery('section.qi4d-compare');
                        const $nav = jQuery('#qi4d-nav-container');
                        const $placeholder = jQuery('#qi4d-nav-placeholder');

                        // ✅ SAME LOGIC FOR ALL DEVICES
                        const headerHeight = jQuery('header.page-header.fixed').outerHeight() || 0;
                        const navHeight = jQuery('.sections.nav-sections.fixed').outerHeight() || 0;

                        const totalFixedHeight = headerHeight + navHeight;

                        const videoAboveViewport = isElementAboveViewport($video, totalFixedHeight);

                        const shouldFix =
                            scrollTop >= originalOffsetTop - totalFixedHeight &&
                            !videoAboveViewport;

                        if (shouldFix && !isNavFixed) {
                            isNavFixed = true;

                            $placeholder.height($nav.outerHeight());

                            $nav.css({
                                position: 'fixed',
                                top: totalFixedHeight + 'px',
                                left: 0,
                                right: 0,
                                width: '100%',
                                padding: '15px',
                                zIndex: 90
                            });

                        } else if (!shouldFix && isNavFixed) {
                            isNavFixed = false;

                            $placeholder.height(0);

                            $nav.css({
                                position: '',
                                top: '',
                                left: '',
                                right: '',
                                width: '',
                                padding: '',
                                zIndex: ''
                            });
                        }

                        ticking = false;
                    });
                });
            } else {
                let isNavFixed = false;
                let ticking = false;

                function isElementAboveViewport($el) {
                    if (!$el.length) return false;

                    const elementBottom = $el.offset().top + $el.outerHeight();
                    const viewportTop = jQuery(window).scrollTop();

                    return elementBottom < viewportTop;
                }

                jQuery(window).on('scroll', function() {

                    if (ticking) return;
                    ticking = true;

                    window.requestAnimationFrame(function() {

                        const $window = jQuery(window);
                        const scrollTop = $window.scrollTop();
                        const $video = jQuery('section.qi4d-compare');
                        const $nav = jQuery('#qi4d-nav-container');
                        const $placeholder = jQuery('#qi4d-nav-placeholder');

                        const isMobile = $window.width() < 768;
                        const isLargeScreen = $window.width() >= 1600;
                        const largeScreenOffset = isLargeScreen ? 80 : 0;

                        const headerHeight = jQuery('header.page-header.fixed').outerHeight() || 0;
                        const navHeight = !isMobile && jQuery('.sections.nav-sections.fixed').length ?
                            jQuery('.sections.nav-sections.fixed').outerHeight() :
                            0;

                        const totalFixedHeight = headerHeight + navHeight;

                        const videoAboveViewport = isElementAboveViewport($video);
                        console.log(videoAboveViewport);
                        const shouldFix =
                            scrollTop >= originalOffsetTop - totalFixedHeight - largeScreenOffset &&
                            !videoAboveViewport;

                        setTimeout(() => {
                            if (shouldFix && !isNavFixed) {
                                isNavFixed = true;

                                // 🔒 lock layout height
                                $placeholder.height($nav.outerHeight());

                                $nav.css({
                                    position: 'fixed',
                                    top: totalFixedHeight + 'px',
                                    left: 0,
                                    right: 0,
                                    width: '100%',
                                    padding: '15px',
                                    zIndex: 90
                                });

                            } else if (!shouldFix && isNavFixed) {
                                isNavFixed = false;

                                // 🔓 unlock layout
                                $placeholder.height(0);

                                $nav.css({
                                    position: '',
                                    top: '',
                                    left: '',
                                    right: '',
                                    width: '',
                                    padding: '',
                                    zIndex: ''
                                });
                            }

                        }, 300);

                        ticking = false;
                    });
                });


            }


        });
    });
</script>