 </style>
<script>
    require(['jquery', 'jquery/ui'],function($){
        var popuprel = '';
        if( $(document).find('.category-modal-btn').length){
          popuprel  = $(document).find('.category-modal-btn').attr('data-rel');
        }
       function setcatpopCookie(cname,cvalue,exdays) {
            var d = new Date();
            d.setTime(d.getTime() + (exdays*24*60*60*1000));
            //d.setTime(d.getTime() + (2*60*1000));
            var expires = "expires=" + d.toUTCString();
            document.cookie = cname + "=" + cvalue + ";" + expires + ";path=/";
        }
        function getcatpopCookie(cname) {
            var name = cname + "=";
            var decodedCookie = decodeURIComponent(document.cookie);
            var ca = decodedCookie.split(';');
            for(var i = 0; i < ca.length; i++) {
                var c = ca[i];
                while (c.charAt(0) == ' ') {
                    c = c.substring(1);
                }
                if (c.indexOf(name) == 0) {
                    return c.substring(name.length, c.length);
                }
            }
            return "";
        }
        var catpopupclose = getcatpopCookie("catpopup"+popuprel+"close");
        if (catpopupclose != "show_no") {
            $(document).find('.category-modal-btn').click();
            setcatpopCookie("catpopup"+popuprel+"close","show_no",1);
        }
             
  });     
</script>
