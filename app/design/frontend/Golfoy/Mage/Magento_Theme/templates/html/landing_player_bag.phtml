$categoryId = 220;
$cacheKey = 'players_bag_slider_' . $categoryId;
$cacheLifetime = 24 * 60 * 60; // Use the cookie lifetime for the cache as well.
$cache = \Magento\Framework\App\ObjectManager::getInstance()->get(\Magento\Framework\App\CacheInterface::class);

if ($cachedHtml = $cache->load($cacheKey)) {
    echo $cachedHtml;

    return;
} else {
    $objectManager = \Magento\Framework\App\ObjectManager::getInstance();
    $category = $objectManager->create('Magento\Catalog\Model\Category')->load($categoryId);

    if ($category->getId()) {
        $subcategories = $category->getChildrenCategories();

        if ($subcategories && count($subcategories) > 0) {
            ob_start();
?>
            <div class="team-slider">
                <div class="slider-header">
                    <div class="col-xs-12 header-left">
                        <div class="heading_golfoy_left">
                            <h2>Players Bag</h2>
                            <p>Equipment Chosen by Tour Players</p>
                        </div>
                    </div>
                </div>
                <div class="slider-images-tour">
                    <div class="slider-container">
                        <button class="prev-slide left_arrow"></button>
                        <ol class="slider-wrapper products list items product-itemss" id="sliderWrapper">
                            <?php foreach ($subcategories as $subcategory) {
                                $subcategory = $objectManager->create('Magento\Catalog\Model\Category')->load($subcategory->getId());

                            ?>
                                <a href="<?php echo $subcategory->getUrl() . '#' . $subcategory->getId(); ?>" class="react-comp slider-wrapper-child">
                                    <div class="slider-item">
                                        <img src="http://golfoy.com<?php echo $subcategory->getImageUrl(); ?>" loading="lazy" alt="<?php echo $subcategory->getName(); ?>">
                                        <p><?php echo $subcategory->getName(); ?></p>
                                    </div>
                                </a>
                            <?php } ?>
                        </ol>
                        <button class="next-slide right_arrow"></button>
                    </div>
                    <div class="slider-footer">
                        <a class="react-comp" href="http://golfoy.com/shop-players-bag"><button class="explore-btn action primary">EXPLORE TOUR PLAYERS</button></a>
                    </div>
                </div>
            </div>
<?php
            $html = ob_get_clean();
            $scriptString = <<<JS
                localStorage.removeItem('playersBag');
                localStorage.setItem("playersBag", `$html`);
            JS;
            setcookie('playersBag', '', time() - 3600, '/');
            setcookie('playersBag', 'HTML', time() + (24 * 60 * 60), '/');
            echo $secureRenderer->renderTag('script', ['defer'], $scriptString, false);
            $cache->save($html, $cacheKey, ['catalog_category_view'], $cacheLifetime);
            echo $html;
        }
    }
}
