<?php
/**
 * Spin Wheel Test Template - Requires User Login
 */

// Check if user is logged in
$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$customerSession = $objectManager->get('\Magento\Customer\Model\Session');

if (!$customerSession->isLoggedIn()) {
    ?>
    <script>
        function openWheelManually() {
            jQuery(".account_icon_header.header_icon").click();
        }
    </script>
    <?php
    return; 
}

// User is logged in, get customer info for personalization
$customer = $customerSession->getCustomer();
$customerName = $customer->getFirstname();
$customerId = $customer->getId();

// Check if customer has already spun in the last 24 hours
$resource = $objectManager->get('\Magento\Framework\App\ResourceConnection');
$connection = $resource->getConnection();
$tableName = $resource->getTableName('customer_spin_wheel_coupons');

// Create table if it doesn't exist
$createTableSql = "CREATE TABLE IF NOT EXISTS `{$tableName}` (
    `id` int(11) NOT NULL AUTO_INCREMENT,
    `customer_id` int(11) NOT NULL,
    `coupon_code` varchar(100) NOT NULL,
    `offer_name` varchar(200) NOT NULL,
    `offer_tagline` varchar(200) NOT NULL,
    `spin_date` datetime NOT NULL,
    `expires_at` datetime NOT NULL,
    PRIMARY KEY (`id`),
    KEY `customer_id` (`customer_id`),
    KEY `expires_at` (`expires_at`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4";

try {
    $connection->query($createTableSql);
} catch (Exception $e) {
    // Table might already exist, continue
}

// Check for existing spin in last 24 hours
$select = $connection->select()
    ->from($tableName)
    ->where('customer_id = ?', $customerId)
    ->where('expires_at > NOW()')
    ->order('spin_date DESC')
    ->limit(1);

$existingSpin = $connection->fetchRow($select);
$hasRecentSpin = !empty($existingSpin);

// Handle AJAX request to reset spin (for testing)
if ($_SERVER['REQUEST_METHOD'] === 'POST' && !empty($_POST['reset_spin'])) {
    try {
        // Delete customer's spin records
        $connection->delete($tableName, ['customer_id = ?' => $customerId]);
        
        if (!empty($_SERVER['HTTP_X_REQUESTED_WITH']) && 
            strtolower($_SERVER['HTTP_X_REQUESTED_WITH']) === 'xmlhttprequest') {
            echo json_encode(['success' => true, 'message' => 'Spin reset successfully']);
            exit;
        } else {
            // Redirect to refresh the page
            header('Location: ' . $_SERVER['REQUEST_URI']);
            exit;
        }
    } catch (Exception $e) {
        error_log('Error resetting spin wheel: ' . $e->getMessage());
        if (!empty($_SERVER['HTTP_X_REQUESTED_WITH']) && 
            strtolower($_SERVER['HTTP_X_REQUESTED_WITH']) === 'xmlhttprequest') {
            echo json_encode(['success' => false, 'message' => 'Error resetting spin']);
            exit;
        }
    }
}

// Handle AJAX request to save coupon
if ($_SERVER['REQUEST_METHOD'] === 'POST' && !empty($_POST['coupon_code'])) {
    // Set JSON header
    header('Content-Type: application/json');
    
    try {
        // Log the request for debugging
        error_log('Spin wheel coupon save attempt - Customer ID: ' . $customerId . ', Coupon: ' . $_POST['coupon_code']);
        
        $data = [
            'customer_id' => $customerId,
            'coupon_code' => $_POST['coupon_code'],
            'offer_name' => $_POST['offer_name'],
            'offer_tagline' => $_POST['offer_tagline'],
            'spin_date' => date('Y-m-d H:i:s'),
            'expires_at' => date('Y-m-d H:i:s', strtotime('+24 hours'))
        ];
        
        // Insert the coupon record
        $connection->insert($tableName, $data);
        
        error_log('Spin wheel coupon saved successfully to database');
        
        // Always return JSON response for AJAX
        echo json_encode(['success' => true, 'message' => 'Coupon saved successfully']);
        exit;
        
    } catch (Exception $e) {
        error_log('Error saving spin wheel coupon: ' . $e->getMessage());
        echo json_encode(['success' => false, 'message' => 'Error saving coupon: ' . $e->getMessage()]);
        exit;
    }
}

// Sample offers array with probability weights
// Higher probability = more likely to win
// Total should add up to 100 for easier understanding
$offers = [
    [
        'offername' => '₹500 OFF',
        'tagline' => 'On orders above Rs. 5000*',
        'coupon' => 'SNW5-98IB',
        'probability' => 45
    ],
    [
        'offername' => 'Free VG Balls*',
        'tagline' => 'Free Viper Golf Balls Sleeve On order above Rs. 3500',
        'coupon' => 'VGBALL',
        'probability' => 3 
    ],
    [
        'offername' => '₹500 OFF*',
        'tagline' => 'On orders above Rs. 5000*',
        'coupon' => 'SNW5-98IB',
        'probability' => 46  
    ],
    [
        'offername' => 'Free Titleist Balls*',
        'tagline' => 'Free Titleist Pro V1 Balls Sleeve On order above 5000',
        'coupon' => 'PROV1SLEEVE',
        'probability' => 3
    ],
    [
        'offername' => 'Extra 10% Off',
        'tagline' => 'Not applicable on Clearance products',
        'coupon' => 'EXTRASNW10',
        'probability' => 3  
    ]
];

$offersJson = json_encode($offers);
?>

<!-- Trigger Button -->
<button id="openWheelBtn" class="open-wheel-btn" onclick="openWheelManually()">🎯 Spin to Win!</button>

<!-- Temporary Reset Button for Testing -->
<button id="resetSpinBtn" class="reset-spin-btn" onclick="resetSpin()">🔄 Reset Spin (Testing)</button>

<!-- Overlay -->
<div id="wheelOverlay" class="wheel-overlay"></div>

<!-- Slide-in Wheel Container -->
<div id="spinWheelModal" class="spin-wheel-container">
    <button id="closeWheelBtn" class="close-wheel-btn">✕</button>
    
    <?php if ($hasRecentSpin): ?>
        <!-- Already Spun Message -->
        <div class="already-spun-container">
            <h2 class="wheel-title">Hello <?php echo $this->escapeHtml($customerName); ?>!</h2>
            <div class="already-spun-message">
                <div class="spin-cooldown-icon">⏰</div>
                <h3>You've Already Claimed Your Reward!</h3>
                <div class="current-coupon">
                    <h4>Your Current Coupon:</h4>
                    <div class="coupon-display">
                        <input type="text" id="existingCouponCode" value="<?php echo $this->escapeHtml($existingSpin['coupon_code']); ?>" readonly>
                        <button id="copyExistingBtn" class="copy-btn">COPY</button>
                    </div>
                    <p class="coupon-details">
                        <strong><?php echo $this->escapeHtml($existingSpin['offer_name']); ?></strong><br>
                        <?php echo $this->escapeHtml($existingSpin['offer_tagline']); ?>
                    </p>
                </div>
            </div>
        </div>
    <?php else: ?>
        <h2 class="wheel-title">Hello <?php echo $this->escapeHtml($customerName); ?>! Spin to Win Amazing Offers!</h2>
    <?php endif; ?>
    
    <?php if (!$hasRecentSpin): ?>
    <div class="wheel-wrapper">
        <div class="wheel-pointer"></div>
        <div id="spinWheel" class="wheel-container">
            <svg viewBox="0 0 400 400" style="width: 100%; height: 100%;">
                <?php 
                $numOffers = count($offers);
                $anglePerSegment = 360 / $numOffers;
                $colors = ['#fb6850','#30abb1','#7d64bd','#f87082','#3ebbbd','#219a52'];
                
                for ($i = 0; $i < $numOffers; $i++): 
                    $startAngle = $i * $anglePerSegment;
                    $endAngle = ($i + 1) * $anglePerSegment;
                    
                    // Convert to radians
                    $startRad = deg2rad($startAngle - 90); // -90 to start from top
                    $endRad = deg2rad($endAngle - 90);
                    
                    // Calculate path coordinates (200,200 is center, 180 is radius)
                    $startX = 200 + 180 * cos($startRad);
                    $startY = 200 + 180 * sin($startRad);
                    $endX = 200 + 180 * cos($endRad);
                    $endY = 200 + 180 * sin($endRad);
                    
                    // Large arc flag: 1 if angle > 180 degrees
                    $largeArcFlag = ($anglePerSegment > 180) ? 1 : 0;
                    
                    // Text position for offer name only
                    $textAngle = ($startAngle + $endAngle) / 2 - 90;
                    $textRad = deg2rad($textAngle);

                    // Offer name position (centered in segment)
                    $offerX = 200 + 120 * cos($textRad);
                    $offerY = 200 + 120 * sin($textRad);

                    // Handle text wrapping for long offer names
                    $offerName = $offers[$i]['offername'];
                    $maxLength = 15;
                    if (strlen($offerName) > $maxLength) {
                        // Find the space closest to the middle
                        $middle = strlen($offerName) / 2;
                        $spacePos = strpos($offerName, ' ', intval($middle));
                        if ($spacePos === false) {
                            $spacePos = strrpos($offerName, ' ', -$maxLength);
                        }
                        if ($spacePos !== false && $spacePos > 0) {
                            $line1 = substr($offerName, 0, $spacePos);
                            $line2 = substr($offerName, $spacePos + 1);
                        } else {
                            // No space found, split at middle
                            $line1 = substr($offerName, 0, $middle);
                            $line2 = substr($offerName, $middle);
                        }
                    } else {
                        $line1 = $offerName;
                        $line2 = '';
                    }

                    $color = $colors[$i % count($colors)];
                ?>
                <!-- Segment <?php echo $i; ?>: <?php echo $this->escapeHtml($offers[$i]['offername']); ?> -->
                <path d="M 200 200 L <?php echo $startX; ?> <?php echo $startY; ?> A 180 180 0 <?php echo $largeArcFlag; ?> 1 <?php echo $endX; ?> <?php echo $endY; ?> Z"
                      fill="<?php echo $color; ?>" stroke="#fff" stroke-width="2"/>
                <text x="<?php echo $offerX; ?>" y="<?php echo $offerY; ?>" fill="white" text-anchor="middle" font-weight="bold" font-size="16" transform="rotate(<?php echo $textAngle; ?> <?php echo $offerX; ?> <?php echo $offerY; ?>)">
                    <tspan><?php echo $this->escapeHtml($line1); ?></tspan>
                    <?php if ($line2): ?>
                    <tspan x="<?php echo $offerX; ?>" dy="1.2em"><?php echo $this->escapeHtml($line2); ?></tspan>
                    <?php endif; ?>
                </text>
                <?php endfor; ?>
            </svg>
        </div>
        <button id="spinButton" class="spin-btn" onclick="testSpin()">SPIN NOW!</button>
    </div>
    
    <div id="result-section" class="result-section" style="display: none;">
        <div class="congratulations">Congratulations!</div>
        <div class="won-offer">
            <div class="offer-name" id="wonOfferName"></div>
            <div class="offer-tagline" id="wonOfferTagline"></div>
        </div>
        <div class="coupon-section">
            <label>Your Coupon Code:</label>
            <div class="coupon-display">
                <input type="text" id="couponCode" readonly>
                <button id="copyButton" class="copy-btn">COPY</button>
            </div>
        </div>
    </div>
    <?php endif; ?>
</div>

