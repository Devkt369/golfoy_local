<script>
    function latestFashionSliderNewScrollLeft() {
        let container = document.getElementById('latest-fashion-new-scroll-container');
        let scrollAmount = container.children[0].offsetWidth + 100; // Width of an image + gap
        if (container.scrollLeft > 0) {
            container.scrollBy({
                left: -scrollAmount,
                behavior: 'smooth'
            });
        }
    }

    function latestFashionSliderNewScrollRight() {
        let container = document.getElementById('latest-fashion-new-scroll-container');
        let scrollAmount = container.children[0].offsetWidth + 100; // Width of an image + gap
        let maxScroll = container.scrollWidth - container.clientWidth;

        if (container.scrollLeft < maxScroll) {
            container.scrollBy({
                left: scrollAmount,
                behavior: 'smooth'
            });
        }
    }
</script>