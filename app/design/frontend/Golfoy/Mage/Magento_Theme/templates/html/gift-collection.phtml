        }

        h2.section-title img {
            max-width: 200px;
        }

        .gift-collection {
            padding: 0px 0px 30px 0px;
        }

        .gift-banner {
            padding: 0px;
        }

        img.mobile-banner {
            display: block;
        }

        .banner-text {
            text-align: center;
        }

        .banner-img img {
            width: 180px;
            margin-top: 20px;
        }

        .gift-item {
            width: 45% !important;
            padding: 0px;
        }

        img.web-banner {
            display: none;
        }
    }

    @media (max-width: 480px) {
