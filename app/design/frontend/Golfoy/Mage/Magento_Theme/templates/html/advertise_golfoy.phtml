<script>
    function initCounters() {
        let audienceStarted = false;
        let metricsStarted = false;

        // --- Audience circular counter ---
        function startAudienceCounter(box) {
            const target = parseInt(box.getAttribute("data-target"));
            const progress = box.querySelector(".progress");
            const percent = box.querySelector(".percent");

            const r = progress.getAttribute("r");
            const circumference = 2 * Math.PI * r;

            progress.style.strokeDasharray = circumference;
            progress.style.strokeDashoffset = circumference;

            let value = 0;
            const animate = setInterval(() => {
                value++;
                if (value > target) {
                    clearInterval(animate);
                    return;
                }
                percent.textContent = value + "%";
                const offset = circumference - (circumference * value) / 100;
                progress.style.strokeDashoffset = offset;
            }, 25);
        }

        // --- Metrics Counter ---
        function startMetricsCounter() {
            document.querySelectorAll('.counter').forEach(counter => {
                const updateCount = () => {
                    const target = +counter.getAttribute('data-target');
                    const current = +counter.innerText;
                    const increment = target / 100;

                    if (current < target) {
                        counter.innerText = Math.ceil(current + increment);
                        setTimeout(updateCount, 20);
                    } else {
                        counter.innerText = target;
                    }
                };
                updateCount();
            });
        }

        function checkVisibility() {
            const audienceSection = document.getElementById('audienceSection');
            const metricsSection = document.querySelector('.metrics-section');

            if (!audienceStarted && audienceSection && isVisible(audienceSection)) {
                audienceStarted = true;
                document.querySelectorAll(".circle_box").forEach(box => startAudienceCounter(box));
            }

            if (!metricsStarted && metricsSection && isVisible(metricsSection)) {
                metricsStarted = true;
                startMetricsCounter();
            }
        }

        // Helper: check if section is visible in viewport
        function isVisible(el) {
            const rect = el.getBoundingClientRect();
            return rect.top < window.innerHeight && rect.bottom >= 0;
        }

        // Run once and on scroll
        checkVisibility();
        window.addEventListener("scroll", checkVisibility);
    }

    // Start scroll-based animations

    setInterval(() => {
        const percentEl = document.querySelector('.circle_box h3.percent');
        if (percentEl && percentEl.textContent.trim() === "0%") {
            initCounters();
        }
    }, 500);
</script>
<!-- scroll on click -->

<script>
    (function() {
        const SAFETY_EXTRA = 10; // your requested +10px
        const MAX_RETRIES = 20; // retry measurement frames (covers late DOM inserts)
        const RETRY_FRAME_MS = 16; // ~1 frame

        function getRectHeight(sel) {
            const el = document.querySelector(sel);
            return el ? el.getBoundingClientRect().height : 0;
        }

        // visual viewport compensation (mobile address bar)
        function visualViewportCompensation() {
            if (window.visualViewport) {
                return Math.max(0, window.innerHeight - window.visualViewport.height);
            }
            return 0;
        }

        // compute offset depending on device width and selectors you provided
        function computeOffsetForWidth(width) {
            let total = 0;
            if (width >= 1025) { // web / desktop
                total += getRectHeight(".page-header.fixed");
                total += getRectHeight(".sections.nav-sections.fixed");
            } else if (width >= 768) { // tablet
                total += getRectHeight("section#home");
                total += getRectHeight(".header.content");
                total += getRectHeight(".sections.nav-sections.fixed");
            } else { // mobile
                total += getRectHeight(".header.content");
                total += getRectHeight("section#home");
            }
            return total + SAFETY_EXTRA;
        }

        // measure with retries until stable or attempts exhausted
        function measureOffsetWithRetries(attemptsLeft, cb) {
            const width = window.innerWidth;
            const offset = computeOffsetForWidth(width);
            // if offset > SAFETY_EXTRA means we measured at least one element
            if (offset > SAFETY_EXTRA || attemptsLeft <= 0) {
                // Also add visualViewport compensation for mobile
                const vv = visualViewportCompensation();
                cb(offset + vv);
                return;
            }
            // retry after a frame
            setTimeout(() => measureOffsetWithRetries(attemptsLeft - 1, cb), RETRY_FRAME_MS);
        }

        // final safe scroll
        function safeScrollToElement(targetEl) {
            if (!targetEl) return;
            measureOffsetWithRetries(MAX_RETRIES, function(finalOffset) {
                const targetDocTop = targetEl.getBoundingClientRect().top + window.pageYOffset;
                const finalTop = Math.max(0, Math.round(targetDocTop - finalOffset));
                console.log("[scroll] target:", targetEl.id || targetEl.tagName, "finalOffset:", finalOffset, "finalTop:", finalTop);
                // small timeout to let mobile tap effects settle
                setTimeout(() => window.scrollTo({
                    top: finalTop,
                    behavior: "smooth"
                }), 40);
            });
        }

        // delegated click handler (covers <a>, <button><a>, data-scroll-target)
        document.body.addEventListener("click", function(e) {
            // 1) direct anchor
            let anchor = e.target.closest('a[href^="#"]');

            // 2) button containing anchor (your markup uses <button><a href="#...">)
            if (!anchor) {
                const btn = e.target.closest('button, .adertvise-btn, .get-In');
                if (btn) anchor = btn.querySelector('a[href^="#"]');
            }

            // 3) element with data-scroll-target (optional)
            let dataTargetEl = e.target.closest('[data-scroll-target]');
            if (!anchor && !dataTargetEl) return; // not a scroll action

            e.preventDefault();

            let href = "";
            if (anchor) href = anchor.getAttribute("href") || "";
            else href = dataTargetEl.getAttribute("data-scroll-target") || "";

            const id = href.replace(/^#/, "");
            if (!id) return;

            const target = document.getElementById(id);
            if (!target) {
                console.warn("[scroll] target not found for id:", id);
                return;
            }

            console.log("[scroll] click -> id:", id);
            safeScrollToElement(target);
        }, {
            passive: false
        });

        // Prevent initial auto-jump if page opens with the hash (common issue)
        window.addEventListener("load", function() {
            const h = window.location.hash;
            if (!h) return;
            if (h === "#advert-form-container" || h === "#advert_form") {
                console.log("[scroll] initial hash removed to prevent auto-jump:", h);
                history.replaceState(null, "", window.location.pathname + window.location.search);
                setTimeout(() => window.scrollTo(0, 0), 20);
            }
        });

        // Optional helpful logs on resize/orientation
        window.addEventListener("resize", () => console.log("[scroll] resize — will re-measure on next click"));
        window.addEventListener("orientationchange", () => console.log("[scroll] orientationchange — will re-measure on next click"));

        console.log("[scroll] dynamic sticky scroll initialized");
    })();
</script>
