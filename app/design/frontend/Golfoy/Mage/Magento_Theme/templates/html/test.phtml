<script>
    require(['jquery'], function($) {
        function initSlider() {
            const $container = $('#polo-new-scrollContainer');
            if (!$container.length) return;

            let centerIndex = 1;
            let isAnimating = false;

            function getItems() {
                const $items = $container.children();
                return $items.length ? $items.toArray() : [];
            }

            function updateActive(animate = true) {
                const $items = getItems();
                if (!$items.length || !$items[centerIndex]) return;

                $($items).removeClass('active');
                $($items[centerIndex]).addClass('active');

                // Calculate slide using item width (works with flex)
                const itemWidth = $($items[0]).outerWidth(true);
                const containerWidth = $container.outerWidth() || 0;
                const scrollPos = centerIndex * itemWidth - (containerWidth - itemWidth) / 2;

                $container.css({
                    'transition': animate ? 'transform 0.5s ease' : 'none',
                    'transform': 'translateX(' + (-scrollPos) + 'px)'
                });
            }

            function shiftNext() {
                if (isAnimating) return;
                isAnimating = true;

                const $items = getItems();
                if (!$items.length) {
                    isAnimating = false;
                    return;
                }

                centerIndex++;
                if (centerIndex >= $items.length) centerIndex = 0;

                updateActive(true);

                setTimeout(() => {
                    isAnimating = false;
                }, 500); // match CSS transition
            }

            function shiftPrev() {
                if (isAnimating) return;
                isAnimating = true;

                const $items = getItems();
                if (!$items.length) {
                    isAnimating = false;
                    return;
                }

                centerIndex--;
                if (centerIndex < 0) centerIndex = $items.length - 1;

                updateActive(true);

                setTimeout(() => {
                    isAnimating = false;
                }, 500);
            }

            // Delegated click events with isolation
            $(document).on('click', '.slider-new-next-btn', function(e) {
                e.stopImmediatePropagation();
                shiftNext();
            });

            $(document).on('click', '.polo-new-prev-btn', function(e) {
                e.stopImmediatePropagation();
                shiftPrev();
            });

            updateActive(false);

            $(window).on('resize', function() {
                requestAnimationFrame(() => updateActive(false));
            });
        }

        // Wait until container AND children exist
        const sliderInterval = setInterval(function() {
            const $container = $('#polo-new-scrollContainer');
            if ($container.length && $container.children().length) {
                clearInterval(sliderInterval);
                initSlider();
            }
        }, 100);
    });
</script>