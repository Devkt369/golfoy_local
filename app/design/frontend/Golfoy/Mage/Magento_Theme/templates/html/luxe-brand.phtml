<div class="row luxe-brand-container">

    <div class="col-sm-3">
        <h2>luxe brands</h2>
        <p>Designed to dominate the course in style</p>
        <button class="explore-btn action primary"><a class="react-comp" href="https://golfoy.com/golf-apparels/apparel-category/golf-t-shirts.html?brand=128%2C421%2C4550%2C3736%2C3008&cus=custom">SHOP NOW</a></button>
    </div>
    <div class="col-sm-9">
        <button class="luxe-new-scroll-btn luxe-new-prev-btn" onclick="luxeNewScrollLeft()">
            &#10094;
        </button>
        <div class="luxe-new-container">
            <div class="slider-new-scroll-container" id="luxe-new-scrollContainer">
                <div class="luxe-product-grids-block">
                    <a class="react-comp" href="https://golfoy.com/golf-apparels/apparel-category/golf-t-shirts.html?brand=128">
                        <div class="luxe-new-item"><img src="https://golfoy.com/pub/media/wysiwyg/2025/landing_page/html/footjoy-luxe-brand.jpg" alt="footjoy"></div>
                    </a>

                </div>
                <div class="luxe-product-grids-block">
                    <a class="react-comp" href="https://golfoy.com/golf-apparels/apparel-category/golf-t-shirts.html?brand=4550">
                        <div class="luxe-new-item"><img src="https://golfoy.com/pub/media/wysiwyg/2025/landing_page/html/jlindeberg-luxe-brand.jpg" alt="jlindeberg"></div>
                    </a>

                </div>
                <div class="luxe-product-grids-block">
                    <a class="react-comp" href="https://golfoy.com/golf-apparels/apparel-category/golf-t-shirts.html?brand=421">
                        <div class="luxe-new-item"><img src="https://golfoy.com/pub/media/wysiwyg/2025/landing_page/html/ping-luxe-brand.jpg" alt="ping"></div>
                    </a>

                </div>
            </div>

        </div>
        <button class="luxe-new-scroll-btn slider-new-next-btn" onclick="luxeNewScrollRight()">
            &#10095;
        </button>
    </div>

</div>
<script>
    function luxeNewScrollLeft() {
        let container = document.getElementById('luxe-new-scrollContainer');
        let scrollAmount = container.children[0].offsetWidth + 100; // Width of an image + gap
        if (container.scrollLeft > 0) {
            container.scrollBy({
                left: -scrollAmount,
                behavior: 'smooth'
            });
        }
    }

    function luxeNewScrollRight() {
        let container = document.getElementById('luxe-new-scrollContainer');
        let scrollAmount = container.children[0].offsetWidth + 100; // Width of an image + gap
        let maxScroll = container.scrollWidth - container.clientWidth;

        if (container.scrollLeft < maxScroll) {
            container.scrollBy({
                left: scrollAmount,
                behavior: 'smooth'
            });
        }
    }
</script>