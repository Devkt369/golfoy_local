            </div>

            <div class="product-card">
                <a href="https://golfoy.com/golf-apparels/apparel-category/trousers.html?cus=custom&amp;product_list_order=discount">
                    <img src="https://golfoy.com/media/wysiwyg/2024/landing/four_width/Trousers-4-Block-Mobile-2.jpg" alt="gfore" loading="lazy">
                </a>
                <div class="product_info"><a href="https://golfoy.com/golf-apparels/apparel-category/trousers.html?cus=custom&amp;product_list_order=discount"><span> Shop Now ></span></a></div>
            </div>

            <div class="product-card">
                <a href="https://golfoy.com/golf-apparels/apparel-category/headwear.html?brand=3736%2C3779%2C4550%2C128%2C8%2C7%2C421&amp;cus=custom">
                    <img src="https://golfoy.com/media/wysiwyg/2024/landing/four_width/Headwear-4-Block-Mobile-2.jpg" alt="ping" loading="lazy">
                </a>
                <div class="product_info"><a href="https://golfoy.com/golf-apparels/apparel-category/headwear.html?brand=3736%2C3779%2C4550%2C128%2C8%2C7%2C421&amp;cus=custom"><span> Shop Now ></span></a></div>
            </div>

            <div class="product-card">
                <a href="https://golfoy.com/golf-apparels/apparel-category/golf-eyewear.html">
                    <img src="https://golfoy.com/media/wysiwyg/2024/landing/four_width/Eyewear-4-Block-Mobile-2.jpg" alt="adidas" loading="lazy">
