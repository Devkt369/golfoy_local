</div>

<div id="block_winterwear" class="background-container">
    <div class="row full_block_web">

        <a href="https://golfoy.com/golf-apparels/apparel-category/golf-winter-wear.html"><img class="background-image" src="https://golfoy.com/media/wysiwyg/2024/landing/full_width/Winter-Hot-Styles-Mobile-new.jpg" alt="Winterwear" loading="lazy" /></a>
    </div>

    <div class="slider-container">
        <button class="slider-btn prev-btn" onclick="scrollLeftFun(this)">❮</button>
        <div class="product-grid">
            <div class="product-card">
                <a href="https://golfoy.com/golf-apparels/apparel-category/golf-t-shirts.html">
