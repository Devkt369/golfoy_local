<div class="col-xs-12 header-left" style="padding: 10px 0px 20px 0px !important;">
    <div class="heading_golfoy_left">
        <h2 style="padding: 0px 5px !important;">Clubs Collection</h2>
    </div>
</div>

<div id="block_winterwear" class="background-container">
    <div class="row full_block_web border-box-shadow">

        <a href="https://golfoy.com/clubs.html"><img class="background-image" src="https://golfoy.com/media/wysiwyg/2025/landing_page/html/clubs-sale-mobile.jpg" alt="clubs" loading="lazy" /></a>
    </div>

    <div class="slider-container clubs-collection">
        <button class="slider-btn prev-btn" onclick="scrollLeftFun(this)">❮</button>
        <div class="product-grid">

            <div class="product-card">
                <a href="https://golfoy.com/clubs/by-brand/taylormade.html">
                    <img src="https://golfoy.com/media/wysiwyg/2025/landing_page/html/taylormade.jpg" alt="taylormade" loading="lazy">
                </a>
                <div class="product_info"><a href="https://golfoy.com/clubs/by-brand/taylormade.html"><span> Shop Now ></span></a></div>
            </div>

            <div class="product-card">
                <a href="https://golfoy.com/clubs/by-brand/ping.html">
                    <img src="https://golfoy.com/media/wysiwyg/2025/landing_page/html/ping.jpg" alt="ping" loading="lazy">
                </a>
                <div class="product_info"><a href="https://golfoy.com/clubs/by-brand/ping.html"><span> Shop Now ></span></a></div>
            </div>


            <div class="product-card">
                <a href="https://golfoy.com/clubs/by-brand/titleist.html">
                    <img src="https://golfoy.com/media/wysiwyg/2025/landing_page/html/titleist.jpg" alt="titleist" loading="lazy">
                </a>
                <div class="product_info"><a href="https://golfoy.com/clubs/by-brand/titleist.html"><span> Shop Now ></span></a></div>
            </div>

            <div class="product-card">
                <a href="https://golfoy.com/clubs/by-brand/callaway.html">
                    <img src="https://golfoy.com/media/wysiwyg/2025/landing_page/html/callaway.jpg" alt="callaway" loading="lazy">
                </a>
                <div class="product_info"><a href="https://golfoy.com/clubs/by-brand/callaway.html"><span> Shop Now ></span></a></div>
            </div>

            <div class="product-card">
                <a href="https://golfoy.com/clubs/by-brand/cobra.html">
                    <img src="https://golfoy.com/media/wysiwyg/2025/landing_page/html/cobra.jpg" alt="cobra" loading="lazy">
                </a>
                <div class="product_info"><a href="https://golfoy.com/clubs/by-brand/cobra.html"><span> Shop Now ></span></a></div>
            </div>


        </div>
        <button class="slider-btn next-btn" onclick="scrollRight(this)">❯</button>
    </div>
</div>

<script>
    const productGrid = document.querySelector('.product-grid');
    const cardWidth = document.querySelector('.product-card').offsetWidth + 20;

    function scrollLeftFun(button) {
        const productGrid = button.nextElementSibling;
        const cardWidth = productGrid.querySelector('.product-card').offsetWidth + 20;

        productGrid.scrollBy({
            left: -cardWidth * 3,
            behavior: 'smooth',
        });
    }

    function scrollRight(button) {
        const productGrid = button.previousElementSibling;
        const cardWidth = productGrid.querySelector('.product-card').offsetWidth + 20;

        productGrid.scrollBy({
            left: cardWidth * 3,
            behavior: 'smooth',
        });
    }
</script>
<style>
    .row.five_width.border-box-shadow img {
        border: 1px solid transparent;
        border-radius: 20px;
        box-shadow: rgba(0, 0, 0, 0.15) 0px 5px 15px 0px;
    }

    @media only screen and (max-width:768px) {
        #block_winterwear .background-image {
            height: auto;
        }

        .slider-container.clubs-collection {
            top: 20%;
        }

        #block_winterwear {
            margin-bottom: 60px;
        }
    }

    @media only screen and (max-width:480px) {
        .slider-container.clubs-collection {
            top: -16%;
        }

        #block_winterwear {
            margin-bottom: 10px;
        }

        .slider-container.clubs-collection .product-card {
            min-width: 105px;
        }

        .slider-container.clubs-collection .product_info span {
            padding-left: 5px;
        }

        .slider-container.clubs-collection .product_info {
            padding-top: 5px;
        }

        #block_winterwear {
            margin-bottom: 20px;
        }
    }

    @media only screen and (max-width:360px) {
        .slider-container.clubs-collection {
            top: -23% !important;
        }

        #block_winterwear {
            margin-bottom: 0px;
        }
    }
</style>