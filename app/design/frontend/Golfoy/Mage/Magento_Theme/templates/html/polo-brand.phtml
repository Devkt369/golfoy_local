<script>
    function initializePoloSlider() {
        const container = document.getElementById('polo-new-scrollContainer');

        if (!container || container.dataset.initialized === 'true') return;
        container.dataset.initialized = 'true';

        let items = Array.from(container.children);
        let centerIndex = 1;
        let isAnimating = false;
        let lastTouchX = 0;
        let lastTouchTime = 0;

        function updateActive(animate = true) {
            items = Array.from(container.children); // refresh list in case DOM changed
            if (!items.length) return;

            // prevent invalid index
            if (centerIndex < 0) centerIndex = 0;
            if (centerIndex >= items.length) centerIndex = items.length - 1;
            if (!items[centerIndex]) return;

            items.forEach(item => item.classList.remove('active'));
            items[centerIndex].classList.add('active');

            const containerWidth = container.offsetWidth;
            const itemCenter = items[centerIndex].offsetLeft + items[centerIndex].offsetWidth / 2;
            const scrollPos = itemCenter - containerWidth / 2;

            container.style.transition = animate ? 'transform 0.5s ease' : 'none';
            container.style.transform = `translateX(${-scrollPos}px)`;
        }

        function shiftNext(steps = 1) {
            if (isAnimating) return;
            isAnimating = true;
            centerIndex += steps;
            updateActive();

            container.addEventListener('transitionend', function handler() {
                for (let i = 0; i < steps; i++) {
                    const first = items.shift();
                    container.appendChild(first);
                    items.push(first);
                }
                centerIndex -= steps;
                updateActive(false);
                isAnimating = false;
                container.removeEventListener('transitionend', handler);
            });
        }

        function shiftPrev(steps = 1) {
            if (isAnimating) return;
            isAnimating = true;
            for (let i = 0; i < steps; i++) {
                const last = items.pop();
                container.insertBefore(last, container.firstChild);
                items.unshift(last);
            }
            centerIndex += steps;
            updateActive(false);

            centerIndex -= steps;
            requestAnimationFrame(() => updateActive(true));

            container.addEventListener('transitionend', function handler() {
                isAnimating = false;
                container.removeEventListener('transitionend', handler);
            });
        }

        // --- SWIPE HANDLING ---
        let startX = 0;
        let startTime = 0;
        container.addEventListener('touchstart', e => {
            startX = e.touches[0].clientX;
            startTime = Date.now();
        });

        container.addEventListener('touchend', e => {
            const endX = e.changedTouches[0].clientX;
            const diff = endX - startX;
            const elapsed = Date.now() - startTime;

            if (Math.abs(diff) > 30) {
                const velocity = Math.abs(diff / elapsed);
                const steps = velocity > 0.8 ? 3 : velocity > 0.5 ? 2 : 1;
                if (diff < 0) shiftNext(steps);
                else shiftPrev(steps);
            }
        });

        // --- BUTTONS ---
        const nextBtn = document.querySelector('.slider-new-next-btn');
        const prevBtn = document.querySelector('.polo-new-prev-btn');

        if (nextBtn && !nextBtn.dataset.listenerAdded) {
            nextBtn.addEventListener('click', () => shiftNext(1));
            nextBtn.dataset.listenerAdded = 'true';
        }
        if (prevBtn && !prevBtn.dataset.listenerAdded) {
            prevBtn.addEventListener('click', () => shiftPrev(1));
            prevBtn.dataset.listenerAdded = 'true';
        }

        updateActive(false);

        if (!window.poloResizeListenerAdded) {
            window.addEventListener('resize', () => updateActive(false));
            window.poloResizeListenerAdded = true;
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializePoloSlider);
    } else {
        initializePoloSlider();
    }

    window.initializePoloSlider = initializePoloSlider;

    if (typeof window.poloObserver === 'undefined') {
        window.poloObserver = new MutationObserver(function (mutations) {
            mutations.forEach(mutation => {
                if (mutation.type === 'childList') {
                    mutation.addedNodes.forEach(node => {
                        if (node.nodeType === 1 &&
                            (node.id === 'polo-new-scrollContainer' ||
                             (node.querySelector && node.querySelector('#polo-new-scrollContainer')))) {
                            setTimeout(initializePoloSlider, 200);
                        }
                    });
                }
            });
        });

        const targetNode = document.querySelector('#maincontent') || document.body;
        window.poloObserver.observe(targetNode, { childList: true, subtree: true });
    }

    if (typeof window.poloIntervalChecker === 'undefined') {
        window.poloIntervalChecker = setInterval(() => {
            const container = document.getElementById('polo-new-scrollContainer');
            if (container && !container.dataset.initialized) {
                initializePoloSlider();
            }
        }, 500);

        setTimeout(() => {
            if (window.poloIntervalChecker) {
                clearInterval(window.poloIntervalChecker);
                window.poloIntervalChecker = undefined;
            }
        }, 30000);
    }
</script>