<script>
    function latestSliderNewScrollLeft() {
        let container = document.getElementById('latest-new-scroll-container');
        let scrollAmount = container.children[0].offsetWidth + 100; // Width of an image + gap
        if (container.scrollLeft > 0) {
            container.scrollBy({
                left: -scrollAmount,
                behavior: 'smooth'
            });
        }
    }

    function latestSliderNewScrollRight() {
        let container = document.getElementById('latest-new-scroll-container');
        let scrollAmount = container.children[0].offsetWidth + 100; // Width of an image + gap
        let maxScroll = container.scrollWidth - container.clientWidth;

        if (container.scrollLeft < maxScroll) {
            container.scrollBy({
                left: scrollAmount,
                behavior: 'smooth'
            });
        }
    }
</script>