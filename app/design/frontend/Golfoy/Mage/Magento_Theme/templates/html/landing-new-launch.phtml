<style>
    .slider-new-container {
        position: relative;
        padding: 35px 50px;
        background-color: black;
        overflow: hidden;
    }


    .slider-new-container h4 {
        font-size: 1.5rem;
        font-weight: 600;
        margin: 20px 0 5px;
        text-transform: uppercase;
        color: white;
    }

    .slider-new-container a.shop-nows {
        text-decoration: none;
        color: white;
        margin-top: 5px;
        font-size: 1.3rem;
        text-transform: uppercase;
    }

    .slider-new-title {
        font-size: 18px;
        text-transform: uppercase;
        margin-bottom: 40px;
        color: white;
        text-align: center;
    }

    .slider-new-scroll-container {
        display: flex;
        flex-wrap: nowrap;
        overflow-x: hidden;
        gap: 20px;
        scroll-behavior: smooth;
        white-space: nowrap;
        padding-bottom: 10px;
        max-width: 100%;
    }

    .product-grids-block {
        flex: 0 0 calc(25% - 20px);
        /* 4 items per row */
        height: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .slider-new-item {
        width: 210px;
        height: 270px;
        background-size: cover;
        background-position: center;
        border-radius: 5px;
    }

    .slider-new-scroll-btn {
        display: none;
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background-color: #fff;
        border: none;
        width: 40px;
        height: 40px;
        cursor: pointer;
        border-radius: 50% !important;
        font-size: 17px;
        box-shadow: 0 4px 6px -3px #9a9a9a;
    }

    .slider-new-prev-btn {
        left: 20px;
    }

    .slider-new-next-btn {
        right: 20px;
    }

    strong.golfoy-cls {
        font-size: 26px;
        /* padding-top: 28px; */
        line-height: 43px;
    }

    span.latest-cls {
        font-size: 16px;
    }

    @media only screen and (max-width: 1024px) {
        .product-grids-block {
            flex: 0 0 calc(25% - 10px);
        }
    }

    @media only screen and (max-width: 768px) {
        .product-grids-block {
            flex: 0 0 calc(50% - 10px);
        }

        .slider-new-item {
            width: 160px;
            height: 210px;
        }
    }

    @media only screen and (max-width: 480px) {
        .slider-new-container {
            padding: 35px 20px;
        }

        .slider-new-item {
            width: 160px;
            height: 210px;
        }

        .slider-new-scroll-btn {
            display: block !important;
            z-index: 10;
        }

        .slider-new-scroll-container {
            gap: 10px;
        }

        .slider-new-prev-btn {
            left: 10px;
        }

        .slider-new-next-btn {
            right: 10px;
        }

        .slider-new-scroll-container::-webkit-scrollbar {
            display: none;
        }

        .slider-new-scroll-container {
            display: flex;
            flex-wrap: nowrap;
            overflow-x: scroll !important;
            scroll-behavior: smooth;
            white-space: nowrap;
        }
    }

    a.shop-nows.small-caps {
        text-transform: capitalize;
    }

    a.shop-nows.initial-caps {
        text-transform: unset;
    }
</style>

<div class="slider-new-container">
    <div class="slider-new-title"><strong class="golfoy-cls">Latest on Golfoy</strong></div>
    <button class="slider-new-scroll-btn slider-new-prev-btn" onclick="launchsliderNewScrollLeft()">
        &#10094;
    </button>
    <div class="slider-new-scroll-container" id="slider-new-scrollContainer">
        <div class="product-grids-block">
            <a href="https://golfoy.com/clubs/by-brand/taylormade/by-type/qi35-family.html">
                <div class="slider-new-item " style="background-image: url('https://golfoy.com/pub/media/wysiwyg/2025/landing_page/taylormade.png');"></div>
            </a>
            <h4>taylormade</h4>
            <a href="https://golfoy.com/clubs/by-brand/taylormade/by-type/qi35-family.html" class="shop-nows small-caps">Qi35 ></a>
        </div>
        <div class="product-grids-block">
            <a href="https://golfoy.com/clubs/by-brand/cobra/by-type/ds-adapt-family.html">
                <div class="slider-new-item" style="background-image: url('https://golfoy.com/pub/media/wysiwyg/2025/landing_page/cobra.png');"></div>
            </a>
            <h4>cobra</h4> <a href="https://golfoy.com/clubs/by-brand/cobra/by-type/ds-adapt-family.html" class="shop-nows">DS ADAPT ></a>
        </div>
        <div class="product-grids-block">
            <a href="https://golfoy.com/clubs/by-brand/callaway/by-type/elyte-family.html">
                <div class="slider-new-item" style="background-image: url('https://golfoy.com/pub/media/wysiwyg/2025/landing_page/callaway.png');"></div>
            </a>
            <h4>callaway</h4> <a href="https://golfoy.com/clubs/by-brand/callaway/by-type/elyte-family.html" class="shop-nows">ELYTE ></a>
        </div>
        <div class="product-grids-block">
            <a href="https://golfoy.com/clubs/by-brand/srixon/by-type/srixon-zxi.html">
                <div class="slider-new-item" style="background-image: url('https://golfoy.com/pub/media/wysiwyg/2025/landing_page/Srixon.png');"></div>
            </a>
            <h4>srixon</h4> <a href="https://golfoy.com/clubs/by-brand/srixon/by-type/srixon-zxi.html" class="shop-nows initial-caps">ZXi ></a>
        </div>
        <div class="product-grids-block">
            <a href="https://golfoy.com/clubs/by-brand/ping/by-type/g440-family.html">
                <div class="slider-new-item" style="background-image: url('https://golfoy.com/pub/media/wysiwyg/2025/landing_page/ping.png');"></div>
            </a>
            <h4>ping</h4> <a href="https://golfoy.com/clubs/by-brand/ping/by-type/g440-family.html" class="shop-nows">G440 ></a>
        </div>
        <div class="product-grids-block">
            <a href="https://golfoy.com/golfoy-premieres">
                <div class="slider-new-item" style="background-image: url('https://golfoy.com/pub/media/wysiwyg/2025/landing_page/VIEW-ALL.png');"></div>
            </a>
        </div>
    </div>
    <button class="slider-new-scroll-btn slider-new-next-btn" onclick="launchsliderNewScrollRight()">
        &#10095;
    </button>
</div>


<script>
    function launchsliderNewScrollLeft() {
        let container = document.getElementById('slider-new-scrollContainer');
        let scrollAmount = container.clientWidth / 1.2;
        console.log("Scrolling Left by:", scrollAmount);
        container.scrollBy({
            left: -scrollAmount,
            behavior: 'smooth'
        });
    }

    function launchsliderNewScrollRight() {
        let container = document.getElementById('slider-new-scrollContainer');
        let scrollAmount = container.clientWidth / 1.2;
        console.log("Scrolling Right by:", scrollAmount);
        container.scrollBy({
            left: scrollAmount,
            behavior: 'smooth'
        });
    }
</script>