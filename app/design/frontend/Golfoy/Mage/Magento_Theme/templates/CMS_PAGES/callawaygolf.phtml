<script>
    require(['jquery'], function($) {

        /* ===============================
           TAB SWITCHING
        =============================== */
        const driverData = <?php echo json_encode($driver_data); ?>;
        $(document).on('click', '.menu-item', function(e) {
            e.preventDefault();

            const tab = $(this).data('tab');
            const $targetSection = $('section.section-2');

            $('.menu-item').removeClass('active');
            $('.content-section').removeClass('active');

            $(this).addClass('active');
            $('#' + tab + '-content').addClass('active');

            // refresh sliders AFTER tab switch
            refreshAllGalleries();

            // 🎯 SCROLL TO section-2
            if ($targetSection.length) {
                $('html, body').stop().animate({
                    scrollTop: $targetSection.offset().top
                }, 500);
            }
        });

        /* ===============================
           CORE SLIDER UPDATE
        =============================== */
        function updateGallery($container) {
            const $track = $container.find('.gallery-slider-track');
            const $slides = $track.find('.gallery-slide');

            if (!$slides.length) return;

            let index = $track.data('index') || 0;

            const slideWidth = $slides.first().outerWidth(true);
            const slidesToShow = window.innerWidth <= 768 ? 1 : 2;
            const maxIndex = Math.max(0, $slides.length - slidesToShow);

            if (index > maxIndex) index = maxIndex;
            if (index < 0) index = 0;

            $track.data('index', index);
            $track.css('transform', 'translateX(-' + (index * slideWidth) + 'px)');

            $container.find('button[class*="gallery-arrow-prev"]').prop('disabled', index === 0);
            $container.find('button[class*="gallery-arrow-next"]').prop('disabled', index >= maxIndex);
        }

        /* ===============================
           NEXT BUTTON (ALL VARIANTS)
        =============================== */
        $(document).on('click', 'button[class*="gallery-arrow-next"]', function() {
            const $container = $(this).closest('.gallery-slider-container');
            const $track = $container.find('.gallery-slider-track');

            let index = $track.data('index') || 0;

            const slides = $track.find('.gallery-slide').length;
            const slidesToShow = window.innerWidth <= 768 ? 1 : 2;
            const maxIndex = Math.max(0, slides - slidesToShow);

            if (index < maxIndex) {
                index++;
                $track.data('index', index);
                updateGallery($container);
            }
        });

        /* ===============================
           PREV BUTTON (ALL VARIANTS)
        =============================== */
        $(document).on('click', 'button[class*="gallery-arrow-prev"]', function() {
            const $container = $(this).closest('.gallery-slider-container');
            const $track = $container.find('.gallery-slider-track');

            let index = $track.data('index') || 0;

            if (index > 0) {
                index--;
                $track.data('index', index);
                updateGallery($container);
            }
        });

        /* ===============================
           RESIZE FIX
        =============================== */
        $(window).on('resize', function() {
            refreshAllGalleries();
        });

        /* ===============================
           REFRESH ALL VISIBLE GALLERIES
        =============================== */
        function refreshAllGalleries() {
            $('.gallery-slider-container:visible').each(function() {
                const $container = $(this);
                const $track = $container.find('.gallery-slider-track');

                if ($track.data('index') === undefined) {
                    $track.data('index', 0);
                }

                // Delay ensures layout is calculated
                setTimeout(function() {
                    updateGallery($container);
                }, 60);
            });
        }

        /* ===============================
           INIT ON PAGE LOAD
        =============================== */
        refreshAllGalleries();


        $(document).on('change', '.product-select', function() {

            const newProductIndex = $(this).val();
            const columnIndex = $(this).data('column-index');

            if (newProductIndex === null || newProductIndex === '') {
                return; // ignore disabled option
            }

            const table = $(this).closest('.comparison-table');

            updateComparisonColumn(table[0], columnIndex, parseInt(newProductIndex));
            updateSelectBoxes();
        });

        function updateComparisonColumn(table, columnIndex, newProductIndex) {

            const rows = $(table).find('tr');
            const newDriver = driverData[newProductIndex];

            if (!newDriver) return;

            rows.each(function(rowIndex) {

                const $row = $(this);
                if ($row.hasClass('product-selector-row')) return;

                const $td = $row.find('td').eq(columnIndex);
                if (!$td.length) return;

                switch (rowIndex) {

                    case 0:
                        $td.html(`
                    <img class="img_name" src="${newDriver.name_image}">
                    <img class="img_text" src="${newDriver.product_image}">
                    <div class="shop_now_from_compare">Coming Soon</div>
                `);
                        break;

                    case 1:
                        $td.text(newDriver.name);
                        break;

                    case 3:
                        $td.html(`<div class="compare_heading">overview</div><div class="compare_heading_value">${newDriver.overview}</div>`);
                        break;

                    case 4:
                        $td.html(`<div class="compare_heading">weigth system</div><div class="compare_heading_value">${newDriver.weight_system}</div>`);
                        break;

                    case 5:
                        $td.html(`<div class="compare_heading">forgiveness</div><div class="compare_heading_value">${newDriver.forgiveness}</div>`);
                        break;
                }
            });
        }

        function updateSelectBoxes($changedSelect, selectedIndex) {

            const nameRow = $('.comparison-table tr').eq(1);
            const currentProducts = [];

            // 1️⃣ Collect currently selected products (per column)
            nameRow.find('td').each(function() {
                const index = $(this).data('product-index');
                if (index !== undefined && index >= 0) {
                    currentProducts.push(index);
                } else {
                    currentProducts.push(null);
                }
            });

            $('.product-select').each(function(i) {

                const $select = $(this);

                // 🔹 CURRENT SELECT (keep selection)
                if ($changedSelect && $select[0] === $changedSelect[0]) {

                    $select.empty();
                    $select.append(
                        `<option value="${selectedIndex}" selected>${driverData[selectedIndex].name}</option>`
                    );

                    driverData.forEach(function(driver, idx) {
                        if (idx !== selectedIndex) {
                            const disabled = currentProducts.includes(idx) ? 'disabled' : '';
                            $select.append(
                                `<option value="${idx}" ${disabled}>${driver.name}</option>`
                            );
                        }
                    });

                    return;
                }

                // 🔹 OTHER SELECTS
                const current = currentProducts[i];

                if (current === null || !driverData[current]) {
                    return;
                }

                $select.empty();
                $select.append(
                    `<option value="${current}" selected disabled>${driverData[current].name}</option>`
                );

                driverData.forEach(function(driver, idx) {
                    if (idx !== current) {
                        const disabled = currentProducts.includes(idx) ? 'disabled' : '';
                        $select.append(
                            `<option value="${idx}" ${disabled}>${driver.name}</option>`
                        );
                    }
                });
            });
        }




        $(document).on('change', '.product-select', function() {
            console.log('Changed:', $(this).val(), $(this).data('column-index'));
        });


    });
</script>