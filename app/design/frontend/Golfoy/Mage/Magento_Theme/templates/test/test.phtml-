<style>
@media only screen and (max-width:768px) {
    #golfoy_container {
        width:100% !important;
        padding-left: 0px;
        padding-right: 0px;
    }
    .two_coll{
        padding-bottom:15px;
    }
    .three-coll{
        padding-bottom:15px;
    }
}
#golfoy_container {
     max-width: 1440px;
     width:100%;
}
 .head_golfoy > h1{
    font-size: 25px;
    font-family: 'headpro';
    font-weight: 700;
    margin-bottom: 10px;
    color: black;
    text-transform: uppercase;
  }
.product_slider_container {
    margin: 10px 0px 0px !important;
}
.row.block_landing_page{
    padding:20px 0px;
}
.header_golfoy  h1{
    margin-top:0px !important;
    font-size: 25px;
    font-family: 'headpro';
    font-weight: 700;
    margin-bottom: 10px;
    color: black;
    text-transform: uppercase;
}
main#maincontent {
    padding-left: 0px !important;
    padding-right: 0px !important;
}
.feature_head h1{
    margin-top:20px !important;
}
.columns .column.main {
    padding-bottom: 0px !important;
}
.heading_golfoy  h1{
    margin-top:30px;
}
.product-slider-first{
    margin-bottom:30px;
}
    @media only screen and (min-width:1280px){
        .visible_div_small > div {
            min-height: 175px;
        }
        .visible_div_big > div {
            min-height: 335px;
        }
    }
    @media only screen and (min-width:1092px) and (max-width:1280px){
        .visible_div_small > div {
            min-height: 150px;
        }
        .visible_div_big > div {
            min-height: 290px;
        }
    }
    @media only screen and (min-width:768px) and (max-width:1092px){
        .visible_div_small > div {
            min-height: 115px;
        }
        .visible_div_big > div {
            min-height: 205px;
        }
    }
    @media only screen and (min-width:550px) and (max-width:768px){
        .visible_div_small > div {
            min-height: 120px;
        }
        .visible_div_big > div {
            min-height: 250px;
        }
    }
    @media only screen and (max-width:550px) {
        .visible_div_small > div {
            min-height: 90px;
        }
        .visible_div_big > div {
            min-height: 200px;
        }
    }
</style>

<script type="text/javascript" defer>
    require(['jquery', 'bootstrap'],function(jQuery){
        jQuery(document).ready(function() {
            
            if ( jQuery(window).width() > 768 ){
                //desktop slider
                setTimeout(function(){
                    jQuery('#golfoy_slider').find('img').each(function(){
                        jQuery(this).attr('src' , jQuery(this).attr('data-src') );
                    });
                }, 2000)
            }else{
                //mobile slider
                setTimeout(function(){
                    jQuery('#golfoy-carousel-mobile').find('img').each(function(){
                        jQuery(this).attr('src' , jQuery(this).attr('data-src') );
                    });
                }, 2000)
            }
            
            jQuery('#golfoy_container').find('.animation_div').each(function(){
                jQuery(this).find('img').attr('src' , jQuery(this).find('img').attr('data-src') );
                jQuery(this).removeClass('animation_div');
            });

        });
    });
</script>

