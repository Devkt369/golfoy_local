<script type="text/javascript">
    require(['jquery', 'bootstrap'], function($) {

        /* ===============================
           MATCH HEIGHTS (DESKTOP ONLY)
        =============================== */
        function matchHeights() {
            if ($(window).width() >= 1024) {
                $('.launches_first_block .la_first_text')
                    .css('height', 'auto')
                    .height($('.launches_first_block .la_first_image').outerHeight(true))
                    .removeClass('hide');
            } else {
                $('.launches_first_block .la_first_text').css('height', 'auto');
            }
        }

        /* ===============================
           GET FIXED HEADER HEIGHT
        =============================== */
        function getHeaderHeight() {
            return $('.page-header.header_onecolumn').outerHeight(true) || 0;
        }

        /* ===============================
           SCROLL FUNCTION (ALL DEVICES)
        =============================== */
        function scrollToSection(id) {
            var headerHeight = getHeaderHeight();

            $('html, body').stop().animate({
                scrollTop: $(id).offset().top - headerHeight
            }, 300);
        }

        /* ===============================
           DOCUMENT READY
        =============================== */
        $(document).ready(function() {

            matchHeights();
            $(window).on('load resize', matchHeights);

            $('.clubs_click').on('click', function(e) {
                e.preventDefault();
                scrollToSection('#clubs-mb');
            });

            $('.apparels_click').on('click', function(e) {
                e.preventDefault();
                scrollToSection('#apparels-mb');
            });

            $('.techno_clicks').on('click', function(e) {
                e.preventDefault();
                scrollToSection('#technology-mb');
            });

        });

    });
</script>

