<?php

$objectManager = \Magento\Framework\App\ObjectManager::getInstance();

$storeManager = $objectManager->get('\Magento\Store\Model\StoreManagerInterface');
$orderCollectionFactory = $objectManager->get('\Magento\Sales\Model\ResourceModel\Order\CollectionFactory');
$TransportBuilder = $objectManager->get('\Magento\Framework\Mail\Template\TransportBuilder');
$timezone = $objectManager->get('\Magento\Framework\Stdlib\DateTime\TimezoneInterface');

// Fetch the orders in the last 60 minutes
//date_default_timezone_set('Asia/Kolkata');

$now = new \DateTime();

$minutesAgo = 60; //in minutes
$lastHour = $now->sub(new \DateInterval('PT' . $minutesAgo . 'M'))->format('Y-m-d H:i:s');

$orderCollection = $orderCollectionFactory->create()
    ->addFieldToSelect(['created_at'])
    ->addFieldToFilter('created_at', ['gteq' => $lastHour])
    ->setOrder('created_at', 'DESC');

if ($orderCollection->getSize() === 0) {

    $writer = new \Zend_Log_Writer_Stream(BP . '/var/log/sms.log');
    $logger = new \Zend_Log();
    $logger->addWriter($writer);
    $logger->info('Order not place last '.$minutesAgo.'minutes email sent');

    $lastOrder = $orderCollectionFactory->create()
        ->addFieldToSelect(['created_at'])
        ->setOrder('created_at', 'DESC')
        ->setPageSize(1)
        ->setCurPage(1);
    foreach($lastOrder as $lorder){
        $getId = $lorder->getId();
        $getCreatedAt = $lorder->getCreatedAt();
        
        $dateTime = new \DateTime($getCreatedAt, new \DateTimeZone('UTC'));
        $dateTime->modify('+5 hours 30 minutes');
        $getCreatedAt = $dateTime->format('Y-m-d H:i:s');
    }
    $lastOrderTime = $getId ? $getCreatedAt : 'No orders yet';

    $main_email = "admin@golfoy.com";
    $recipientEmails = 'tech1@golfoy.com,mohit@golfoy.com,testing@golfoy.com'; // Update with real email addresses
    
    $emailArray = explode(',', $recipientEmails);
    $emailSubject = "No Orders Captured in the Last ". $minutesAgo ." Minutes";

        $templateidentifier = '18';
        $templateVars = [
            'minutesAgo' => $minutesAgo,
            'lastOrderTime' => $lastOrderTime,
            'subj'  => $emailSubject
        ]; 
        $TransportBuilder
            ->setTemplateIdentifier($templateidentifier)
            ->setTemplateOptions(['area' => \Magento\Framework\App\Area::AREA_FRONTEND, 'store' => 1])
            ->setTemplateVars($templateVars)
            ->setFrom(['name' => "Admin",'email' => "admin@golfoy.com"])
            ->addTo($main_email);
    
            foreach ($emailArray as $email) {
                $TransportBuilder->addCc($email);
            }
        $transport = $TransportBuilder->getTransport();
        $result = $transport->sendMessage();
        echo "Mail sent";
        return true;
}else{
    echo "You got orders in last ".$minutesAgo." minutes";
}
