function GetIconHtml($baseUrl, $img_name, $text, $tooltip_text)
{
    $html = '';
    if ($tooltip_text != '') {
        $class = 'tooltip_exists';
        $tooltip_html = '<i class="fas fa-info-circle tooltip-btn"></i>
    <div class="tooltip">
      ' . $tooltip_text . '
    </div>';
    } else {
        $class = 'tooltip_not_exists';
        $tooltip_html = '';
    }
    $html = '
  <div class="icon ' . $class . '">
    <img src="https://golfoy.com/media/wysiwyg/product_feature_icon/new/' . $img_name . '">
    <span>' . $text . '</span>
    ' . $tooltip_html . '
  </div>';
    return $html;
}
