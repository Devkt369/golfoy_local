<style>
    @media only screen and (max-width:768px) and (min-width:480px){
        main#maincontent .catalog-product-view .product.info.detailed .col-md-8 {
            width: 100% !important;
        }
        main#maincontent .catalog-product-view .product.info.detailed .col-md-8 {
            margin-bottom: 30px !important;
            clear: both;
            display: inline-block;
        }
        main#maincontent .product.data.items .data.item {
            width: 32%;
            display: inline-block;
            padding: 0;
            text-align: center;
        }
        main#maincontent .col-md-12.des.float-right{
            padding-top: 40px !important;
        }
        main#maincontent .content{
            padding: 30px 10px;
        }
        main#maincontent .fotorama__stage{
            height: 360px !important;
        }
        main#maincontent .fotorama__nav__shaft .fotorama__nav__frame{
            height: 50px !important;
            width: 50px !important;
        }
    }
    @media only screen and (min-width:769px){
        main#maincontent .fotorama__nav-wrap .fotorama_vertical_ratio .fotorama__img{
            left:0;
        }
        main#maincontent .fotorama__thumb__arr {
            height: 70px;
            opacity: 1;
        }
        main#maincontent .fotorama__nav-wrap {
            width: 100px;
            overflow-y: auto;
        }
        main#maincontent .fotorama__wrap > div {
            display: inline-block !important;
        }
        main#maincontent .fotorama__stage {
            width: calc(100% - 100px) !important;
            float: right;
        }
        main#maincontent .fotorama__stage__shaft.fotorama__grab {
            width: 100% !important;
        }
        main#maincontent .fotorama__nav.fotorama__nav--thumbs {
            height: auto !important;
        }
        main#maincontent .fotorama__nav-wrap.fotorama__nav-wrap--horizontal{
            max-height: 515px;
        }
        main#maincontent .fotorama__nav__shaft {
            width: 100px !important;
            display: inline-block !important;
        }
        .product.media > .tags,
        .fotorama--fullscreen .fotorama__stage__shaft.fotorama__grab .tag{
            display: none;
        }
        .fotorama--fullscreen .fotorama__nav__shaft {
            text-align: center;
        }
        .fotorama--fullscreen .fotorama__nav__frame.fotorama__nav__frame--thumb {
            display: inline-block !important;
        }
        .fotorama--fullscreen .fotorama__loaded--img {
            text-align: left;
        }
        main#maincontent .fotorama__nav__shaft .fotorama__nav__frame,
        .fotorama--fullscreen .fotorama__nav__frame.fotorama__nav__frame--thumb
        {
            height: 70px !important;
            border: 2px solid #e9e8e8c4;
            width: 70px !important;
            border-radius: 5px;
            overflow: hidden;
            margin-right: 10px !important;
            position: initial;
            float: none !important;
            padding: 0 !important;
            cursor: pointer;
            display: block;
            margin-top: 10px;
          
        }
    }
    
    @media only screen and (max-width:769px){
        main#maincontent .product.media{
            width: 100% !important;
        }
        main#maincontent .product-info-main{
            width: 100% !important;
        }
    }
    @media only screen and (min-width:769px) and (max-width:1100px){
        main#maincontent .product.media{
            width: 40% !important;
        }
        main#maincontent .product-info-main{
            width: 57% !important;
        }
        main#maincontent .fotorama__nav__shaft .fotorama__nav__frame{
            width: 50px !important;
            height: 50px !important;
        }
        main#maincontent .fotorama__nav-wrap.fotorama__nav-wrap--horizontal{
            max-height: 330px !important;
        }
        
    }
    @media only screen and (min-width:1100px) and (max-width:1400px){
        main#maincontent .product.media{
            width: 45% !important;
        }
        main#maincontent .product-info-main{
            width: 52% !important;
        }
        main#maincontent .fotorama__nav__shaft .fotorama__nav__frame{
            width: 50px !important;
            height: 50px !important;
        }
        main#maincontent .fotorama__nav-wrap.fotorama__nav-wrap--horizontal{
            max-height: 400px !important;
        }
    }
    @media only screen and (min-width:1400px) and (max-width:1500px){
        main#maincontent .product.media{
            width: 50% !important;
        }
        main#maincontent .product-info-main{
            width: 47% !important;
        }
        main#maincontent .fotorama__nav-wrap.fotorama__nav-wrap--horizontal {
            max-height: 435px !important;
        }
        
    }
    @media only screen and (min-width:1500px) and (max-width:1900px){
        main#maincontent .product.media{
            width: 40% !important;
        }
        main#maincontent .product-info-main{
            width: 57% !important;
        }
        main#maincontent .fotorama__nav-wrap.fotorama__nav-wrap--horizontal{
            max-height: 525px !important;
        }
    }
    main#maincontent .fotorama__nav__frame.fotorama__nav__frame--thumb.fotorama__active {
        border: 2px solid #b9b9b9;
}

main#maincontent .fotorama__nav__frame.fotorama__nav__frame--thumb:hover{
    border: 2px solid #948f8f;
}
    
    main#maincontent .fotorama__stage__shaft.fotorama__grab > .tag {
        display: none;
    }
    main#maincontent .fotorama__stage__shaft.fotorama__grab> .tag {
        display: inline-block;
        position: fixed;
        z-index: 11;
        width: 100%;    
    }
    main#maincontent .fotorama__nav__shaft{
        margin-top: 0px !important;
    }
    main#maincontent .fotorama__thumb__arr {
    display: none !important;
}
</style>
