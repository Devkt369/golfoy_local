<?php 
    $objectManager = \Magento\Framework\App\ObjectManager::getInstance(); 
    $session_object = $objectManager->create('\Magento\Checkout\Model\Session');
    $cart_object = $objectManager->create('\Magento\Checkout\Model\Cart');

    $allItems = $session_object->getQuote()->getAllVisibleItems();
    foreach ($allItems as $item) {
        $itemId = $item->getItemId();
        $cart_object->removeItem($itemId)->save();
    }
?>
