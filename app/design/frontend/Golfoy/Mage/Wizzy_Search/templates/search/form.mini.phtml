                    <a href="#" class="wizzy-search-clear">
                        <span class="wizzy-icon"></span>
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>


<script>
    require(['jquery', 'bootstrap'], function(jQuery) {
        jQuery(document).ready(function() {
            jQuery('.wizzy-common-select-selectedItem').on('click', function() {
                jQuery('.wizzy-common-select-options').toggleClass('active', jQuery(this).css('display') === 'block');
            });
