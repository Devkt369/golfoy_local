</script>
<script>
    require(['jquery', 'bootstrap'], function(jQuery) {
        jQuery(document).ready(function() {
            jQuery(document).on("click", ".cross-icon-result", function(e) {
                e.preventDefault();
                jQuery('.wizzy-autocomplete-wrapper.onLeft').hide();
            });

            // ----Placeholder animation on mage
            const DELAY_AFTER_ANIMATION = 1000;
            /* const PLACEHOLDERS = [
                'Search for Shoes.....',
                'Search for Drivers.....',
                'Search for our latest Products.....',
                'Find your favorite Brands.....'
            ]; */

            const PLACEHOLDERS = <?php echo empty($placeholderJson) ? '" "' : json_encode($placeholderJson); ?>;
            const MIN_ANIMATION_DELAY = 50;
            const MAX_ANIMATION_DELAY = 90;

            function typePlaceholder(placeholder, index, direction) {
                if (direction === "forward") {
                    if (index < placeholder.length) {
                        jQuery('.wizzy-search-input').attr('placeholder', placeholder.substring(0, index + 1));
                        setTimeout(function() {
                            typePlaceholder(placeholder, index + 1, "forward");
                        }, Math.floor(Math.random() * (MAX_ANIMATION_DELAY - MIN_ANIMATION_DELAY)) + MIN_ANIMATION_DELAY);
                    } else {
                        setTimeout(function() {
                            typePlaceholder(placeholder, index - 1, "backward");
                        }, DELAY_AFTER_ANIMATION);
                    }
                } else {
                    if (index >= 0) {
                        jQuery('.wizzy-search-input').attr('placeholder', placeholder.substring(0, index + 1));
                        setTimeout(function() {
                            typePlaceholder(placeholder, index - 1, "backward");
                        }, Math.floor(Math.random() * (MAX_ANIMATION_DELAY - MIN_ANIMATION_DELAY)) + MIN_ANIMATION_DELAY);
                    } else {
                        setTimeout(function() {
                            animatePlaceholders();
                        }, DELAY_AFTER_ANIMATION);
                    }
                }
            }

            function animatePlaceholders() {
                if (PLACEHOLDERS.length === 0) {
                    // If all placeholders have been used, refill the array
                    const additionalArray = <?php echo empty($placeholderJson) ? '" "' : json_encode($placeholderJson); ?>;
                    // Push each element from the additionalArray into PLACEHOLDERS
                    additionalArray.forEach(function(element) {
                        PLACEHOLDERS.push(element);
                    });
                    const placeholder = PLACEHOLDERS.shift();
                    typePlaceholder(placeholder, 0, "forward");
                }
            }

            animatePlaceholders();
        });
    });
</script>

<script>
    require(['jquery'], function($) {
        $(document).ready(function() {
            $(document).on("click", "span.cross-btn-shipping", function(e) {
                e.preventDefault();
                $('li#shipping').removeClass('fixed');
            });
            $(document).on("click", ".cross-icon-result", function(e) {
                e.preventDefault();
                $('.wizzy-autocomplete-wrapper.onLeft').hide();
            });
            var liElements = $('#block-collapsible-nav .nav.items > .nav.item');
            liElements.each(function() {
                var text = $(this).text().trim();
                var newClass = text.replace(/\s+/g, '_').toLowerCase();
                $(this).addClass(newClass);
            });

        });
    });
</script>

<script>
    require(['jquery'], function($) {
        $(window).on('load', function() { // Ensure everything (images, resources) is fully loaded
            function applyStyles() {
                if ($('body').hasClass('wizzyMobileTapped') || $(window).width() <= 768) {
                    $('.block.block-search.wizzy-search-mini-block').css({
                        'background-image': 'url(https://golfoy.com/media/Search-Icon.svg)',
                        'background-repeat': 'no-repeat',
                        'background-position': 'center right',
                        'height': '37px',
                        'background-size': '23px'
                    });
                } else {
                    $('.block.block-search.wizzy-search-mini-block').css({
                        'background-image': '',
                        'background-repeat': '',
                        'background-position': '',
                        'height': '',
                        'background-size': ''
                    });
                }
            }

            applyStyles();

            const observer = new MutationObserver(function(mutationsList) {
                for (const mutation of mutationsList) {
                    if (mutation.attributeName === 'class') {
                        applyStyles();
                    }
                }
            });

            observer.observe(document.body, {
                attributes: true
            });

            $(window).on('resize', applyStyles);
        });
    });
</script>

