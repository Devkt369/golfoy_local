<?php

/** @var $block \Magento\Framework\View\Element\Template */

$helper = $block->getSearchDataHelper();
$configs = $block->getConfigs();
$placeholder = $configs['search']['input']['placeholder'];


//Get search placeholders for animate
$objectManager = \Magento\Framework\App\ObjectManager::getInstance();

// Get the Scope Config instance
$scopeConfig = $objectManager->get('\Magento\Framework\App\Config\ScopeConfigInterface');

// Retrieve the configuration value
$enable_animate = $scopeConfig->getValue('common/search_animate/enable_animate', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);
$configValue = $scopeConfig->getValue('common/search_animate/common_placeholder_animate', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);
$placeholderArr = [];

if ($enable_animate == 1) {
    $placeholderArr = explode('|', $configValue);
    $placeholderJson = json_encode($placeholderArr);
} else {
    $placeholderJson = '';
}

?>

