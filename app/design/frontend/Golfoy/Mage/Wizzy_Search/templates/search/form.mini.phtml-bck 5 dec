<script>
    require(['jquery', 'bootstrap'], function(jQuery) {
        jQuery(document).ready(function() {
            jQuery(document).on("click", ".cross-icon-result", function(e) {
                e.preventDefault();
                jQuery('.wizzy-autocomplete-wrapper.onLeft').hide();
            });

            // ----Placeholder animation on mage
            const DELAY_AFTER_ANIMATION = 1000;
            /* const PLACEHOLDERS = [
                'Search for Shoes.....',
                'Search for Drivers.....',
                'Search for our latest Products.....',
                'Find your favorite Brands.....'
            ]; */

            const PLACEHOLDERS = <?php echo empty($placeholderJson) ? '" "' : json_encode($placeholderJson); ?>;

            const MIN_ANIMATION_DELAY = 50;
            const MAX_ANIMATION_DELAY = 90;

            function typePlaceholder(placeholder, index, direction) {
                if (direction === "forward") {
                    if (index < placeholder.length) {
                        jQuery('.wizzy-search-input').attr('placeholder', placeholder.substring(0, index + 1));
                        setTimeout(function() {
                            typePlaceholder(placeholder, index + 1, "forward");
                        }, Math.floor(Math.random() * (MAX_ANIMATION_DELAY - MIN_ANIMATION_DELAY)) + MIN_ANIMATION_DELAY);
                    } else {
                        setTimeout(function() {
                            typePlaceholder(placeholder, index - 1, "backward");
                        }, DELAY_AFTER_ANIMATION);
                    }
                } else {
                    if (index >= 0) {
                        jQuery('.wizzy-search-input').attr('placeholder', placeholder.substring(0, index + 1));
                        setTimeout(function() {
                            typePlaceholder(placeholder, index - 1, "backward");
                        }, Math.floor(Math.random() * (MAX_ANIMATION_DELAY - MIN_ANIMATION_DELAY)) + MIN_ANIMATION_DELAY);
                    } else {
                        setTimeout(function() {
                            animatePlaceholders();
                        }, DELAY_AFTER_ANIMATION);
                    }
                }
            }

            function animatePlaceholders() {
                if (PLACEHOLDERS.length === 0) {
                    // If all placeholders have been used, refill the array
                    const additionalArray = <?php echo $placeholderJson; ?>;
                    // Push each element from the additionalArray into PLACEHOLDERS
                    additionalArray.forEach(function(element) {
                        PLACEHOLDERS.push(element);
                    });
                }
                const placeholder = PLACEHOLDERS.shift();
                typePlaceholder(placeholder, 0, "forward");
            }

            animatePlaceholders();
        });
    });
</script>

