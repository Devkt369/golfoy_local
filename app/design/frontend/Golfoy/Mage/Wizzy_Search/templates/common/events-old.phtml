<script defer="defer">
require(['jquery'], function($) {
    if (window.wizzyConfig.events !== null && window.wizzyConfig.events !== undefined) {
        wizzyInit();
    } else {
        window.onWizzyLoaded = [];
        window.onWizzyLoaded.push(function() {
            wizzyInit();
        });
    }

    function wizzyInit() {

        /* var socialLoginDiv = document.getElementById('social-login-popup');
                console.log("socialLoginDiv", socialLoginDiv);
                var clonedDiv = socialLoginDiv.cloneNode(true); */

        window.wizzyConfig.events.registerEvent(
            window.wizzyConfig.events.allowedEvents.BEFORE_INIT,
            function(payload) {
                window.wizzyConfig.search.configs.facets.leftFacets.mobileCollapsible = true;
                return payload;
            });
        window.wizzyConfig.events.registerEvent(
            window.wizzyConfig.events.allowedEvents.BEFORE_RENDER_RESULTS,
            function(payload) {
                try{
                const facets = payload.response.payload.facets;
                if (facets) {
                    facets.forEach((facet) => {
                        if (facet.key == "colors") {
                            const facetItem = facet.data;
                            facetItem.forEach((item) => {
                                if (typeof item.data.swatch !== "undefined" && item.data
                                    .swatch !== null) {
                                    item.data.swatch.value =
                                        "https://mage.golfoy.com/media/attribute/swatch/swatch_image/30x20" +
                                        item.data.swatch.value;
                                }
                            });
                        }
                    });
                }
                return payload;
            }catch(e){
                console.log("error",e);
            }
            });

           /*  window.wizzyConfig.events.registerEvent(
            window.wizzyConfig.events.allowedEvents.PRODUCTS_RESULTS_RENDERED,
            function(payload) {
                var destinationDiv = document.querySelector('.columns');
                destinationDiv.appendChild(clonedDiv);
                return payload;
            }); */

        window.wizzyConfig.events.registerEvent(
            window.wizzyConfig.events.allowedEvents.AFTER_PRODUCTS_TRANSFORMED,
            function(products) {
                products.forEach((product) => {
                    var swatches = product.swatches;
                    if (swatches) {
                        swatches.forEach((swatch) => {
                            if (swatch.key == "colors") {
                                var colorValues = swatch.values;
                                colorValues.forEach((colorValue) => {
                                    colorValue.isURLSwatch = true;
                                    colorValue.swatchValue =
                                        "https://mage.golfoy.com/media/attribute/swatch/swatch_image/30x20" +
                                        colorValue.swatchValue;
                                });
                            }
                        });
                    }
                });
                return products;
            });
    }
});
</script>