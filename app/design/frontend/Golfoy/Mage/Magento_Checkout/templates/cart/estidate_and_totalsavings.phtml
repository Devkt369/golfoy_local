<?php
    $objectManager = \Magento\Framework\App\ObjectManager::getInstance();
    $customerSession = $objectManager->create('Magento\Customer\Model\Session');
    $storeManager = $objectManager->get('\Magento\Store\Model\StoreManagerInterface');

    $cart = $objectManager->get('\Magento\Checkout\Model\Cart'); 
    $grandTotal = $cart->getQuote()->getGrandTotal();
    $Total = $cart->getQuote()->getSubtotal();
    $taxAmount = $cart->getQuote()->getShippingAddress()->getTaxAmount();


    $currencysymbol = $objectManager->get('Magento\Directory\Model\Currency');
    $currencysymbols = $currencysymbol->getCurrencySymbol();

    $priceHelper = $objectManager->create('Magento\Framework\Pricing\Helper\Data');
    $formattedPayablePrice = $priceHelper->currency($grandTotal, true, false);

    $total_savings = $Total + $taxAmount - $grandTotal;
    $formattedTotalSavings = $priceHelper->currency($total_savings, true, false);

?>
<a href="<?php echo $storeManager->getStore()->getBaseUrl(); ?>checkout/" class="action primary checkout pc"> 
    PROCEED TO CHECKOUT 
    <span class="price_custom visible-xs">
        <?php echo $formattedPayablePrice; ?>
    </span>
</a>
