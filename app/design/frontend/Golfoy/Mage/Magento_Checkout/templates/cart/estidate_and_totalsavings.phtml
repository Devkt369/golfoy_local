// Get all visible items in the cart
$cartItems = $cart->getQuote()->getAllVisibleItems();

$totalMRP = 0;

foreach ($cartItems as $item) {
    // Get product object
    $product = $item->getProduct();
    
    // Check if the product is configurable
    if ($product->getTypeId() == 'configurable') {
        // If it's configurable, get the associated simple product
        $childProduct = $item->getOptionByCode('simple_product')->getProduct();
        
        // Use the simple product for calculations
        $product = $childProduct;
    }
    
    // Get product price
    $productPrice = $product->getPrice();
    
    // Get quantity of the item in the cart
    $qty = $item->getQty();
    
    // Calculate total MRP for this item (Price * Quantity)
    $totalMRP += $productPrice * $qty;
}

// Display total MRP amount
echo "Total MRP Amount: " . $totalMRP;
