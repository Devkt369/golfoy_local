<?php if($this->helper(ArtM\Common\Helper\Data::class)->getConfig("artm_estimatedelivery/general/enabled") != 1) : ?>

<script>
    var ed;
    var edop;
    var nearestDate = null;
    var longestDate = null;
    var els = document.getElementsByClassName("eda");

    for (var i = 0; i < els.length; i++) {
        edop = els[i].innerHTML;
        ed = new Date(edop);

        if (!nearestDate || ed < nearestDate) {
            nearestDate = ed;
        }
        if (!longestDate || ed > longestDate) {
            longestDate = ed;
        }
    }
    if(longestDate == null && nearestDate == null){
        const elementToRemove = document.querySelector('#esta');
        if (elementToRemove) {
            elementToRemove.remove();
        }
    }

    function formatDateWithYear(date) {
        const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
            "Jul", "Aug", "Sept", "Oct", "Nov", "Dec"
        ];
        var day = date.getDate();
        var month = monthNames[date.getMonth()];
        var year = date.getFullYear();
        return day + ' ' + month + ' ' + year; 
    }
    function formatDateWithoutYear(date) {
        const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
            "Jul", "Aug", "Sept", "Oct", "Nov", "Dec"
        ];
        var day = date.getDate();
        var month = monthNames[date.getMonth()];
        var year = date.getFullYear();
        return day + ' ' + month; 
    }
    var formattedNearestDate = formatDateWithoutYear(nearestDate);
    var formattedLongestDate = formatDateWithYear(longestDate);
    if(nearestDate == longestDate){
        var combinedDateString = formattedLongestDate;
    }else{
        var combinedDateString = formattedNearestDate + ' to ' + formattedLongestDate;
    }
    if (document.getElementsByClassName('estif').length) {
        document.getElementsByClassName("estif")[0].innerHTML = combinedDateString;
    }


</script>

<?php endif; ?>