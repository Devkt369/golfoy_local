			//response_data = JSON.parse(response.responseText);
			return JSON.parse(response.responseText);
			
		}
	});*/
	
	//var output = [];
	var obj = {};
	if(qty <= 2)
	{
		obj['success'] = 0;
		//output.push(obj);
		return JSON.stringify(obj);
	}
	var setPromo = 0;
	<?php		
			$priceRule = $readConnection->fetchRow("Select * from salesrule where actions_serialized like '%".$product->getSku()."%' and simple_action = 'buy_2_get_1' and is_active = 1");
			
			if(!empty($priceRule) && $priceRule['application_method'] == 'catalog')
			{
				$actions = unserialize($priceRule['actions_serialized']);
				$conditions = $actions['conditions'];
				foreach($conditions as $condition)
				{
					if(isset($condition['aggregator']) && !empty($condition['aggregator']))
					{
						foreach($condition['conditions'] as $cond)
						{
							?>
							var attr = '<?php echo $cond['attribute']; ?>';
							var operator = '<?php echo $cond['operator']; ?>';
							var value = '<?php echo $cond['value']; ?>';
							if((attr == 'ticket_option') && (operator == '==')  && (value == jQuery.trim(ticketOption)))
							{
								setPromo = 1;
							}
							<?php
						}
					}
				}
			}
	?>
			
			if(setPromo == 1)
			{
				var price;
				price = unitPrice * parseInt(qty - parseInt(qty/3));
				obj['success'] = 1;
				obj['price'] = roundOff(price);
				//output.push(obj);
				return JSON.stringify(obj);
			}
			else
			{
				obj['success'] = 0;
				//output.push(obj);
				return JSON.stringify(obj);
			}
}


