        if (!isNaN(currentVal) && currentVal > 0) {
            // Decrement one
            jQuery('input[name='+fieldName+']').val(currentVal - 1);
        } else {
            // Otherwise put a 0 there
            jQuery('input[name='+fieldName+']').val(0);
        }
    });
});

var ch = 1;
function changePricePos(price)
{
	var unitPrice = price.split(',')[0];
    if(ch == 1)
    {
        jQuery('.price-box .price')[0].innerHTML = '<sup>'+symbol+'</sup>'+0;  
        ch = 2;
    }
    
    var nam = price.substring(price.indexOf(',')+1);
    var qty = document.getElementById(nam).value;
	
	// custom : for scale
	var scalemax = document.getElementById(nam).getAttribute('max');
	if(scalemax.length == 0)
	{
		scalemax = 10;
	}
	var scalemin = document.getElementById(nam).getAttribute('min');
	if(scalemin.length != 0 && qty < scalemin)
	{
		qty = scalemin-1;
	}
	
    if(parseInt(qty) < parseInt(scalemax))
    {        
        document.getElementById(nam).value = parseInt(qty) + 1;
		
		/* catalog promo */
		/*var fin = allSelectedOptionValue();
        jQuery('.price')[0].innerHTML = symbol+fin; */
		
		
		
		
			var fin = allSelectedOptionValue();
			
		if(parseInt(fin) == 0)
		{
			jQuery('.price-box .old-price').hide();
		}
		else
		{
			jQuery('.price-box .old-price').show();
		}
		var special_price = get_promo_price();
        jQuery('.price-box .price')[0].innerHTML = '<sup>'+symbol+'</sup>'+fin; 
		
		var action = '<?php echo $action; ?>';
		var product_id = '<?php echo $product_id; ?>';
		if(special_price != 0 && parseFloat(special_price) != parseFloat(fin))
		{
			jQuery('.price-box').html('<span class="special-price" id="product-price-'+product_id+'"><span class="price" id="product-price-'+product_id+'"><sup>'+symbol+'</sup>'+special_price+'</span></span><span class="old-price" id="product-price-'+product_id+'"><span class="price" id="product-price-'+product_id+'">'+'<sup>'+symbol+'</sup>'+fin+' </span></span>');
		}
		else if(action == '')
		{
			// update html
			jQuery('.price-box').html('<span class="regular-price" id="product-price-'+product_id+'"><span class="price">'+'<sup>'+symbol+'</sup>'+fin+'</span></span>');
		}
		else if(parseFloat(special_price) == parseFloat(fin))
		{
			// update html
			jQuery('.price-box').html('<span class="regular-price" id="product-price-'+product_id+'"><span class="price">'+'<sup>'+symbol+'</sup>'+fin+'</span></span>');
		}
		else if(jQuery('.price-box .special-price')[0] != undefined)
		{
			jQuery('.price-box .special-price .price')[0].innerHTML = '<sup>'+symbol+'</sup>'+special_price;
			jQuery('.price-box .old-price .price')[0].innerHTML = '<sup>'+symbol+'</sup>'+fin; 
			fin = special_price;
		}
		
		
		/*else if(jQuery('.special-price')[0] != undefined)
		{
			jQuery('.special-price .price')[0].innerHTML = '<sup>'+symbol+'</sup>'+fin; 
		}*/
		jQuery('input[name="tour_price"]').remove();
		var priceHtml= "<input type='hidden' name='tour_price' value='"+fin+"'/>";
		jQuery(priceHtml).insertAfter(jQuery(".price-box"));
    }
    
}

function changePriceNeg(price)
{
    var nam = price.substring(price.indexOf(',')+1);
    var qty = document.getElementById(nam).value;
	
	// custom : for scale
	/*var scalemin = document.getElementById(nam).getAttribute('min');
	if(scalemin.length == 0)
	{
		scalemin = 1;
	}*/
	
    //if(parseInt(qty) > parseInt(scalemin))
	if(parseInt(qty) > 0)
    {
        if(document.getElementById(nam).getAttribute('min') == qty)
		{
			document.getElementById(nam).value = 0;
		}
		else
		{
        	document.getElementById(nam).value = parseInt(qty) - 1;
		}
		
		/* catalog promo */
		/*var fin = allSelectedOptionValue();
        jQuery('.price')[0].innerHTML = symbol+fin;*/
		var fin = allSelectedOptionValue();
		if(parseInt(fin) == 0)
		{
			jQuery('.price-box .old-price').hide();
		}
		else
		{
			jQuery('.price-box .old-price').show();
		}
		var special_price = get_promo_price();
        jQuery('.price-box .price')[0].innerHTML = '<sup>'+symbol+'</sup>'+fin;
		
		var action = '<?php echo $action; ?>';
		var product_id = '<?php echo $product_id; ?>';
		if(special_price != 0 && parseFloat(special_price) != parseFloat(fin))
		{
			jQuery('.price-box').html('<span class="special-price" id="product-price-'+product_id+'"><span class="price" id="product-price-'+product_id+'"><sup>'+symbol+'</sup>'+special_price+'</span></span><span class="old-price" id="product-price-'+product_id+'"><span class="price" id="product-price-'+product_id+'">'+'<sup>'+symbol+'</sup>'+fin+' </span></span>');
		}
		else if(action == '')
		{
			// update html
			jQuery('.price-box').html('<span class="regular-price" id="product-price-'+product_id+'"><span class="price">'+'<sup>'+symbol+'</sup>'+fin+'</span></span>');
		}
		else if(parseFloat(special_price) == parseFloat(fin))
		{
			// update html
			jQuery('.price-box').html('<span class="regular-price" id="product-price-'+product_id+'"><span class="price">'+'<sup>'+symbol+'</sup>'+fin+'</span></span>');
		}
		else if(jQuery('.price-box .special-price')[0] != undefined )
		{
			jQuery('.price-box .special-price .price')[0].innerHTML = '<sup>'+symbol+'</sup>'+special_price; 
			jQuery('.price-box .old-price .price')[0].innerHTML = '<sup>'+symbol+'</sup>'+fin; 
			fin = special_price;
		}
		
		/*else if(jQuery('.special-price')[0] != undefined)
		{
			jQuery('.special-price .price')[0].innerHTML = '<sup>'+symbol+'</sup>'+fin; 
		}*/
		jQuery('input[name="tour_price"]').remove();
		var priceHtml= "<input type='hidden' name='tour_price' value='"+fin+"'/>";
		jQuery(priceHtml).insertAfter(jQuery(".price-box"));
    }
}

/* custom function for get all option price multiple to qty */
function allSelectedOptionValue(ticketOption)
{
	
	var price = 0;
	var total_qty = 0;
	var group_qty;
	var amount;
	// custom 
	if(jQuery('#option_selected_title .col-md-12').length == jQuery('#ticketClone .qty2').length)
	{
		
		jQuery('#option_selected_title .col-md-12').each(function()
		{
			var $this = jQuery(this).find('.numbers-row input');
			var qty = parseInt($this.val());
			amount = $this.attr('pricing_category_id');
			group_qty = parseInt($this.attr('group_qty'));
			
			
				if(isTourPrivate == 364 && !isNaN(group_qty) && group_qty != 1)
				{
					total_qty = total_qty + qty;
				}
				else
				{
					price = price + (qty * amount);
				}
			
		});
		if(isTourPrivate == 364 && !isNaN(group_qty) && group_qty != 1)
		{
			if(total_qty != 0)
			{
				if(total_qty <= group_qty)
				{
					price = (group_qty * amount);
				}
				else
				{
					price = (group_qty * Math.ceil(total_qty/group_qty) * amount);
				}
			}
		}
	}
	else
	{
			// if multiple ticket with same name
			jQuery('#option_selected_title .col-md-12').each(function()
			{
				var $this = jQuery(this).find('.numbers-row input');
				var qty = parseInt($this.val());
				name = $this.attr('name');
				group_qty = parseInt($this.attr('group_qty'));
				jQuery('#ticketClone .qty2').each(function()
				{
					if(jQuery(this).attr('name') == name && jQuery(this).attr('min') <= qty && jQuery(this).attr('max') >= qty )
					{
						amount = jQuery(this).attr('pricing_category_id');
					}
				});
				
				price = price + parseFloat(amount);
				
			});
			
	}
	if(isNaN(price)) price = 0;
	
	// round off
	price = roundOff(price);
	
	//return Math.ceil(price);
	//return (price.toFixed(2));
	return price;
}
/* custom function for get all option price multiple to qty */

/* custom : on change qty */
var is_valid;
var old_value;
function ValidateNumericValue(event)
{
	old_value = jQuery(event.element()).val();
	var iKeyCode = (event.which) ? event.which : event.keyCode;
	if (iKeyCode != 46 && iKeyCode > 31 && (iKeyCode < 48 || iKeyCode > 57))
	{
		is_valid = false;
		return false;
	}
	else
	{
		is_valid = true;
	}
}
	
function UpdatePriceOnKeyUp(event)
{
	if(is_valid == true)
	{
		var quantity_element = jQuery(event.element());
		var max_participants = quantity_element.attr('max');
		var min_participants = quantity_element.attr('min');
		var quantity = quantity_element.val();
		var action = '<?php echo $action; ?>';
		var product_id = '<?php echo $product_id; ?>';
		
		if(!isNaN(parseFloat(quantity)))
		{
			if(parseFloat(quantity) > parseFloat(max_participants))
			{
				jQuery(event.element()).val(old_value);
				var max_popup = new jQuery.popup({
					title : '',
					content : '<h3 id="pop_msg">Can not add more than ' + max_participants + ' participants.</h3><small></small>', 
					html: true,
					autoclose   : false,
					closeOverlay: true,
					closeEsc: true,
					buttons     : true
				});
				return false;
			}
			else if(parseInt(quantity) != 0 && parseFloat(quantity) < parseFloat(min_participants))
			{
				jQuery(event.element()).val(old_value);
				var max_popup = new jQuery.popup({
					title : '',
					content : '<h3 id="pop_msg">Can not add less than ' + min_participants + ' participants.</h3><small></small>', 
					html: true,
					autoclose   : false,
					closeOverlay: true,
					closeEsc: true,
					buttons     : true
				});
				return false;
			}
			else
			{
				/* catalog promo */
				/*var fin = allSelectedOptionValue();
				jQuery('.price')[0].innerHTML = symbol+fin;*/
				var fin = allSelectedOptionValue();
				if(parseInt(fin) == 0)
				{
					jQuery('.price-box .old-price').hide();
				}
				else
				{
					jQuery('.price-box .old-price').show();
				}
				var special_price = get_promo_price();
				jQuery('.price-box .price')[0].innerHTML = '<sup>'+symbol+'</sup>'+fin;
				
				if(special_price != 0 && parseFloat(special_price) != parseFloat(fin))
				{
					jQuery('.price-box').html('<span class="special-price" id="product-price-'+product_id+'"><span class="price" id="product-price-'+product_id+'"><sup>'+symbol+'</sup>'+special_price+'</span></span><span class="old-price" id="product-price-'+product_id+'"><span class="price" id="product-price-'+product_id+'">'+'<sup>'+symbol+'</sup>'+fin+' </span></span>');
				}
				else if(action == '')
				{
					// update html
					jQuery('.price-box .price-box').html('<span class="regular-price" id="product-price-'+product_id+'"><span class="price">'+'<sup>'+symbol+'</sup>'+fin+'</span></span>');
				}
				else if(parseFloat(special_price) == parseFloat(fin))
				{
					// update html
					jQuery('.price-box .price-box').html('<span class="regular-price" id="product-price-'+product_id+'"><span class="price">'+'<sup>'+symbol+'</sup>'+fin+'</span></span>');
				}
				else if(jQuery('.price-box .special-price')[0] != undefined)
				{
					jQuery('.price-box .special-price .price')[0].innerHTML = '<sup>'+symbol+'</sup>'+special_price; 
					jQuery('.price-box .old-price .price')[0].innerHTML = '<sup>'+symbol+'</sup>'+fin; 
					fin = special_price;
				}
				
				/*else if(jQuery('.special-price')[0] != undefined)
				{
					jQuery('.special-price .price')[0].innerHTML = '<sup>'+symbol+'</sup>'+fin; 
				}*/
				jQuery('input[name="tour_price"]').remove();
				var priceHtml= "<input type='hidden' name='tour_price' value='"+fin+"'/>";
				jQuery(priceHtml).insertAfter(jQuery(".price-box"));
			}
		}
		else
		{
			if(action == '')
			{
				// update html
				jQuery('.price-box').html('<span class="regular-price" id="product-price-'+product_id+'"><span class="price">'+'<sup>'+symbol+'</sup>'+'0</span></span>');
			}
			else
			{ 
				jQuery('.price-box .price')[0].innerHTML = '<sup>'+symbol+'</sup>'+' 0';
				if(jQuery('.price-box .special-price')[0] != undefined)
					jQuery('.price-box .special-price .price')[0].innerHTML = '<sup>'+symbol+'</sup>'+' 0';
					
				jQuery('input[name="tour_price"]').remove();
				var priceHtml= "<input type='hidden' name='tour_price' value='0'/>";
				jQuery(priceHtml).insertAfter(jQuery(".price-box"));
				//jQuery(".price-box .price").html(symbol + " 0");
			}
		}
	}
}
/* custom : on change qty  */


function setchildoptions()
{
   jQuery('.price-box .price')[0].innerHTML = '<sup>'+symbol+'</sup>'+0; 
}
  
/* custom : to apply catalog price rule dynamically depend on tour price */
function get_promo_price()
{
	
	var promo_price = 0;
	var price = 0;
	var total_qty = 0;
	var group_qty;
	var amount;
	var isBuy2get1free = 0;
	jQuery('#option_selected_title .col-md-12').each(function()
	{
		var $this = jQuery(this).find('.numbers-row input');
		var qty = parseInt($this.val());
		amount = $this.attr('pricing_category_id');
		group_qty = parseInt($this.attr('group_qty'));
		var tour_options_select = jQuery('select[name="tour_options_select"]').val();
		var Buy2Get1 = JSON.parse(Buy2Get1Free('<?php echo $product->getSku()?>', tour_options_select, amount, parseInt(qty)));
		if(Buy2Get1.success == 1)
		{
			isBuy2get1free = 1;
			price = price + Buy2Get1.price;
		}
		else
		{
			if(isTourPrivate == 364 && !isNaN(group_qty) && group_qty != 1)
			{
				
				total_qty = total_qty + qty;
			}
			else
			{
				price = price + (qty * amount);
			}
		}
	});
	if(isBuy2get1free == 1)
		return price;
		
	if(isTourPrivate == 364 && !isNaN(group_qty) && group_qty != 1)
	{
		if(total_qty != 0)
		{
			if(total_qty <= group_qty)
			{
				price = price + (group_qty * amount);
			}
			else
			{
				price = price + (group_qty * Math.ceil(total_qty/group_qty) * amount);
			}
		}
	}
	
	if(parseInt(price) == 0)
	{
		return 0;
	}
	
	// calculate promo_price
	var action = '<?php echo $action; ?>';
	var action_amount = '<?php echo $action_amount; ?>';
	var max_discount_amount = '<?php echo $max_discount_amount; ?>';
	var max_discount_enable = '<?php echo $max_discount_enable; ?>';
	
	if(action == '') return 0;
	
	if(action == 'by_percent')
	{
		promo_price = (price * action_amount)/100;
	}
	else
	{
		promo_price = action_amount;
	}
	if(max_discount_enable == 1 && (parseFloat(promo_price) > parseFloat(max_discount_amount))) promo_price = parseFloat(max_discount_amount);
	
	var special_amount = (price - promo_price);
	
	// round off
	special_amount = roundOff(special_amount);
	
	if(special_amount < 0) special_amount = 0;
	return parseFloat(special_amount).toFixed(2);
}

</script> 

