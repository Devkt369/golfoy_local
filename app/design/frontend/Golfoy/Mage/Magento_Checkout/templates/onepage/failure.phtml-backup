function Buy2Get1Free(sku, ticketOption, unitPrice, qty)
{
	
	/*var ajaxUrl = '<?php echo $this->getUrl('customizesalesrule/index/buy2Get1Free', array('_secure' => true)) ?>';
	
	new Ajax.Request(ajaxUrl, {
		method:'GET',
