<script type="text/javascript">
    require(['jquery'], function(jQuery) {
        jQuery(document).ready(function() {
            // Select the parent div
            var parentDiv = jQuery('.amrelated-pack-list');

            // Create the new div with class 'amrelated-pack-list_inside'
            var newDiv = jQuery('<div class="amrelated-pack-list_inside"></div>');

            // Clone all children from amrelated-pack-list and append them to the new div
            parentDiv.children().clone().appendTo(newDiv);

            // Append the new div to the parent div
            parentDiv.empty();
            parentDiv.append(newDiv);

            setInterval(function() {
                jQuery('body.catalog-product-view .amrelated-details .yousave_per_jquery').hide();
            }, 1000);

            setTimeout(function() {
                // Show the wrapper after 1 second
                jQuery('.amrelated-pack-wrapper').show();
            }, 1000);
        });
    });
</script>

