            <script>
                require(
                    [
                        'jquery',
                        'Magento_Ui/js/modal/modal'
                    ],
                    function ($, modal) {
                        var totalimgs =  $(".product-image").length;
                        totalimgs = parseInt(totalimgs);
                        $('body').on('click', ".product-image", function() {
                       // $(".product-image").on('click', function () {
                            var rel = $(this).attr('rel');
                            var reviewid = $(this).attr('data-reviewid');
                            var reviewhtmlli = $("#reviewli_"+reviewid).html();
                            var reviewhtml = '<li class="item review-item">' + reviewhtmlli + '</li>';
                             //update code of popup - 18-03-2023
                             if ($(window).innerWidth() >= 768) {
                                reviewhtml = '<div class="col-md-4 review_text_sec">' + reviewhtml + '</div>';
                            }

                            // Add a class for mobile screens
                            if ($(window).innerWidth() < 768) {
                                reviewhtml = '<div class="col-12 review_text_sec">' + reviewhtml + '</div>';
                            }

                            // Add a class for tablet screens
                            if ($(window).innerWidth() >= 768 && $(window).innerWidth() < 992) {
                                reviewhtml = '<div class="col-lg-4 col-md-6 review_text_sec">' + reviewhtml + '</div>';
                            }

                            //end

                            var nextrel = parseInt(rel) + 1;
                            if(nextrel > totalimgs){nextrel = 1;}

                            var prevrel = parseInt(rel) - 1;
                            if(prevrel < 1){prevrel = totalimgs;}

                            $("#prevarr").attr('rel',prevrel);
                            $("#nextarr").attr('rel',nextrel);                           
                            
                            $("#review-image-modal-content").html('<div class="row"></div>');
                            $("#review-image-modal-content").prepend(reviewhtml + '<div class="col-md-8 col-sm-8 col-xs-12 review_img_sec"><img id="review-image-lg"  src="' + $(this).attr("src") + '"/></div>');


                            $("#review-image-modal").modal({
                                type: 'popup',
                                title: 'Review Image',
                                modalClass: 'my-custom-class',
                                clickableOverlay: true,
                                buttons: [],
                                responsive: true
                            }).modal('openModal').css({"text-align": "center"});
                        });
                        //border-black
                        $('#review-image-modal').on('click', "#prevarr,#nextarr,.product-image", function() {
                        var torel = $(this).attr('rel'); 
                        var $newsrc = $('.product-image[rel="'+torel +'"]').attr("src");
                        var reviewid = $('.product-image[rel="'+torel +'"]').attr('data-reviewid');
                        $('.product-image').removeClass('border-black');
                        $('.product-image[rel="'+torel +'"]').addClass('border-black');
                        var reviewhtmlli = $("#reviewli_"+reviewid).html();
                        var reviewhtml = '<li class="item review-item">' + reviewhtmlli + '</li>';


                                    // border black end 

                             //update code of popup - 18-03-2023
                             if ($(window).innerWidth() >= 768) {
                                reviewhtml = '<div class="col-md-4 review_text_sec">' + reviewhtml + '</div>';
                            }

                            // Add a class for mobile screens
                            if ($(window).innerWidth() < 768) {
                                reviewhtml = '<div class="col-12 review_text_sec">' + reviewhtml + '</div>';
                            }

                            // Add a class for tablet screens
                            if ($(window).innerWidth() >= 768 && $(window).innerWidth() < 992) {
                                reviewhtml = '<div class="col-sm-4 review_text_sec">' + reviewhtml + '</div>';
                            }

                            //end
                            $("#review-image-modal-content").html('<div class="row"></div>');
                            $("#review-image-modal-content").prepend(reviewhtml + '<div class="col-md-8 col-md-8 col-xs-12 review_img_sec"><img id="review-image-lg"  src="' + $newsrc + '"/></div>');

                           
                            var nextrel = parseInt(torel) + 1;
                            if(nextrel > totalimgs){nextrel = 1;}

                            var prevrel = parseInt(torel) - 1;
                            if(prevrel < 1){prevrel = totalimgs;}

                            $("#prevarr").attr('rel',prevrel);
                            $("#nextarr").attr('rel',nextrel); 


                        });
                        
                    }
                );
            </script>


