<script>
    require(
        [ 'jquery', 'jquery/ui' ], function ($) {
             //----------------drag drop upload-----------------
         $("html").on("dragover", function(e) {
              e.preventDefault();
              e.stopPropagation();
             
          });
    
          $("html").on("drop", function(e) { e.preventDefault(); e.stopPropagation(); });
    
          // Drag enter        
            $("#review-form").on("dragenter", ".review-drag-area", function(e){ 
              e.stopPropagation();
              e.preventDefault();
          });
    
          // Drag over         
            $("#review-form").on("dragover", ".review-drag-area", function(e){ 
              e.stopPropagation();
              e.preventDefault();
          });
    
          // Drop         
            $("#review-form").on("drop", ".review-drag-area", function(e){                 
              e.stopPropagation();
              e.preventDefault();
              var file = e.originalEvent.dataTransfer.files;
              var ins = file.length;  
              var ln = $(".review-resultimg").length; 
              var tc = 0;
              if(ln){ tc = parseInt(ln) + parseInt(tc);}   
              if(ins){ tc = parseInt(ins) + parseInt(tc);}          
              if(tc >10){
                $("#media_field-error").show();
              }else{
                $("#media_field-error").hide();
                for (var x = 0; x < ins; x++) {
                        var fdata = new FormData();   
                        fdata.append("files[]", file[x]);
                        uploadlogofunc(fdata); 
                }
              }
          });  
          function uploadlogofunc(fdata) {             
           if(fdata != null && fdata != ''){
            $.ajax({
                url: "/reviewpopup/index/ajaxupload",
                type: "POST",
                cache: false,
                contentType: false,
                processData: false,
                data: fdata,      
                dataType: 'json',
                showLoader: true,
                success:function(res){
                  if(res.path){
                    $htmlstr = '<div class ="review-resultimg" ><img src = "/media/review_images'+res.path+'"><div class="review-img-cross" rel = "'+res.path+'">&#10006;</div>';                   
                    $htmlstr = $htmlstr + '<input type="hidden" name = "review_media_files[]" value ="'+ res.path +'"></div>'; 
                    $($htmlstr).insertBefore("#review-drag-area"); 
                                
                  }
                }
            });  
          }
          } 
          $("#review-form").on("click", ".review-dragdrop", function(){ 
               $("#review_media").trigger('click');
            }); 
            $("#review-form").on("click", ".review-img-cross", function(){  
                var el = $(this).parent(".review-resultimg");
                var rel = $(this).attr('rel');
                var path = 'review_images' + rel;
                $.ajax({
                    url: "/reviewpopup/index/deleteajaxupload",
                    type: "POST",
                    data: 'path='+path,      
                    dataType: 'json',
                    showLoader: true,
                    success:function(res){
                        el.remove();
                        $("#media_field-error").hide();
                    }
                }); 
            })
            $(document).on('change','#review_media',function(){
                var files = $(this)[0].files;
                var ins = files.length;
                var tc = 0;
                var ln = $(".review-resultimg").length; 
                if(ln){ tc = parseInt(ln) + parseInt(tc);}   
                if(ins){ tc = parseInt(ins) + parseInt(tc);}  
                if(tc > 10){
                    $(this).val('');
                    $("#media_field-error").show();
                }else{
                    for (var x = 0; x < ins; x++) {
                        var fdata = new FormData();   
                        fdata.append("files[]", document.getElementById('review_media').files[x]);
                        uploadlogofunc(fdata);                              
                    }
                    $("#media_field-error").hide();
                }
            });
        });
</script>
