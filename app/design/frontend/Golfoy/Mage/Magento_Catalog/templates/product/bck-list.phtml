<script>
require(['jquery', 'bootstrap'],function(jQuery){
jQuery(document).ready(function() {
       // ****ajax load for price, special price, tier price on category page
    function ajaxPriceSizeroll(){
        jQuery('.list-hidd-pid').each(function(){
            var el = jQuery(this);
            var rel  = jQuery(this).attr("rel");
            var url = '/common/index/productprices';
            var curr_param = jQuery("#ajax-price-"+rel);
            var curr_sizeroll = jQuery("#ajax-sizeroll-"+rel);
            var attrdata = jQuery(this).attr("data-attr");
            var arraydata = jQuery(this).attr("data-array");
            jQuery.ajax({
                url: url,
                type: "POST",
                dataType: 'json',
                data: { pid: rel, attrdata:attrdata, arraydata:arraydata },
                success: function (response) { 
                    if(curr_param.length){
                    curr_param.html(response.output);
                    curr_param.css('min-height','0px');}
                    if(curr_sizeroll.length && response.outputSizeroll){
                    curr_sizeroll.html(response.outputSizeroll);}
                    el.removeClass("list-hidd-pid").addClass("list-hidd-pid-done");
                },
                error: function(jqXHR, textStatus, errorThrown) {
                    console.log(textStatus, errorThrown);
                }
            }); 
        }); 
    }
ajaxPriceSizeroll();    
jQuery('#ajaxlist-reload-product_list').on('contentUpdated', function () {     
    ajaxPriceSizeroll(); 
}); 

}); 
}); 
</script>