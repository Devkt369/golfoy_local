<page layout="1column" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="mage/gallery/gallery.css"/>
        <link src="Magento_Catalog::js/custom-product-page.js"/>
    </head>
    <body>
          
        <referenceBlock name="product.info.details">
            
            <block name="catalog.myattribute"  template="Magento_Catalog::product/productattributeset.phtml" class="Magento\Catalog\Block\Product\View"/>
            <block name="catalog.myofferstatus"  template="Magento_Catalog::product/offerstatus.phtml" class="Magento\Catalog\Block\Product\View"/>
            <block name="catalog.mycustomball"  template="Magento_Catalog::product/ballsattribute.phtml" class="Magento\Catalog\Block\Product\View"/>
<!--             <block name="catalog.myplayerchoice"  template="Magento_Catalog::product/playerschoice.phtml" class="Magento\Catalog\Block\Product\View"/>-->
           
        </referenceBlock>
        <referenceBlock name="product.info.details">                
            <block class="Magento\Catalog\Block\Product\View\Description" name="packaging-content" template="Magento_Catalog::product/view/tab/blog/content.phtml" group="detailed_info">
                <arguments>
                    <argument name="at_call" xsi:type="string">blogesg</argument>
                    <argument name="at_code" xsi:type="string">blogesg</argument>
                    <argument name="css_class" xsi:type="string">blogesg</argument>
                    <argument name="at_label" xsi:type="string">blogesg</argument>
                    <argument name="sort_order" xsi:type="string">500</argument>
                    <argument name="title" translate="true" xsi:type="string">BUYING TIPS</argument>
                </arguments>
            </block>
        </referenceBlock>
        
        <move after="emi_text" element="catalog.myplayerchoice" destination="product.info.main"/>
        <move before="-" element="catalog.myattribute" destination="product.info.media"/>
        <move  element="catalog.myofferstatus" destination="alert.urls"/>
        <move before="product.info.options.wrapper.bottom" element="catalog.mycustomball" destination="product.info.form.options"/>
        
<!--        <move  element="catalog.myplayerchoice" destination="product.info.media.image"/>-->
        <referenceBlock name="product.info.description" remove="true" />
        <referenceBlock name="product.attributes" remove="true" />

        <referenceBlock name="product.info.details">
            
            <block class="Magento\Catalog\Block\Product\View\Description" name="product.info.description.custom" as="description_custom" template="Magento_Catalog::product/view/tab/details/details.phtml" group="detailed_info">
                <arguments>
                    <argument name="at_call" xsi:type="string">getDescription</argument>
                    <argument name="at_code" xsi:type="string">description</argument>
                    <argument name="css_class" xsi:type="string">description</argument>
                    <argument name="at_label" xsi:type="string">none</argument>
                    <argument name="title" translate="true" xsi:type="string">Details</argument>
                    <argument name="sort_order" xsi:type="string">10</argument>
                </arguments>
            </block>
            
        </referenceBlock>
        <referenceBlock name="product.info.details">
            <block class="Magento\Catalog\Block\Product\View" name="tab_expert_advice" template="Magento_Theme::catalog/product/view/tabs/expert_advice.phtml" group="detailed_info" before="-" >
                <arguments>
                    <argument translate="true" name="title" xsi:type="string">Expert Review</argument>
                    <argument name="sort_order" xsi:type="string">100</argument>
                </arguments>
            </block>
        </referenceBlock>
        <referenceBlock name="product.info.details">
            <block class="Magento\Review\Block\Product\Review" name="reviews.tab" as="reviews" template="Magento_Review::review.phtml" group="detailed_info" ifconfig="catalog/review/active">
                <arguments>
                    <argument name="sort_order" xsi:type="string">110</argument>
                </arguments>
                <block class="Magento\Review\Block\Form" name="product.review.form" as="review_form" ifconfig="catalog/review/active">
                    <container name="product.review.form.fields.before" as="form_fields_before" label="Review Form Fields Before"/>
                </block>
            </block>
        </referenceBlock>
        
<!--            <referenceBlock name="reviews.tab" remove="true" />-->
        <move element="tab_expert_advice" destination="product.info.details" before="-"/>
        <move element="breadcrumbs" destination="product_top" before="top_names" />
    </body>
</page>
