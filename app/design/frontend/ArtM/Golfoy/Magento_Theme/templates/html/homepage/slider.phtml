<script>
    require(['jquery', 'jssor'], function($) {
        $(function() {
            $('.jssor-slider').each(function() {
                var sliderId = this.id;
                var $slider = $(this);
                var $config = $slider.find('.slider_onfig');
                var imgHeight = parseInt($config.find('.img_height').text(), 10) || 500;
                var imgWidth = parseInt($config.find('.img_width').text(), 10) || 1920;
                var $slidesAll = $slider.find('.slides_all');

                function setSliderWidth() {
                    var windowWidth = $(window).width();
                    var imgRatio = imgHeight / imgWidth;
                    var renderWidth = Math.min(windowWidth, imgWidth);
                    var renderHeight = Math.round(renderWidth * imgRatio);
                    $slider[0].style.setProperty('width', renderWidth + 'px');
                    $slidesAll[0].style.setProperty('width', renderWidth + 'px');
                    $slider[0].style.setProperty('height', renderHeight + 'px');
                    $slidesAll[0].style.setProperty('height', renderHeight + 'px');
                }
                setSliderWidth();
                $(window).on('resize orientationchange', setSliderWidth);
                var options = {
                    $AutoPlay: 1,
                    $SlideDuration: 800,
                    $Loop: 1,
                    $ArrowNavigatorOptions: {
                        $Class: window.$JssorArrowNavigator$
                    },
                    $BulletNavigatorOptions: {
                        $Class: window.$JssorBulletNavigator$
                    }
                };
                var slider = new window.$JssorSlider$(sliderId, options);

                function ScaleSlider() {
                    var containerWidth = slider.$Elmt.parentNode.clientWidth;
                    if (containerWidth) {
                        slider.$ScaleWidth(containerWidth);
                        setSliderWidth();
                    }
                }
                ScaleSlider();
                $(window).on('resize orientationchange', ScaleSlider);
                // Show slider immediately after sizing is computed, no artificial delay
                $('.slider-static-preview').hide();
                $slider.show();
            });
        });
    });
</script>