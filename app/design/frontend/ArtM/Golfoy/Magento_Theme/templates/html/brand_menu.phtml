<?php
/**
 * Brand Menu: Proper Magento navigation submenu for Brands (category 307)
 */

$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$categoryRepository = $objectManager->get(\Magento\Catalog\Model\CategoryRepository::class);
$escaper = $objectManager->get(\Magento\Framework\Escaper::class);

// Initialize to avoid undefined variable error
$brandsCategoryId = 307;
$brandsCategory = null;
try {
    $brandsCategory = $categoryRepository->get($brandsCategoryId);
    $brandSubcategories = $brandsCategory->getChildrenCategories();
} catch (Exception $e) {
    $brandSubcategories = [];
}

// Output the Brands menu as a level0 parent with submenu, only if category is found
if ($brandsCategory && $brandsCategory->getId()) :
?>
<li class="level0 nav-brands category-item level-top parent ui-menu-item">
    <a href="<?= $escaper->escapeUrl($brandsCategory->getUrl()) ?>" class="level-top ui-menu-item-wrapper" aria-haspopup="true" role="menuitem">
        <span class="ui-menu-icon ui-icon ui-icon-caret-1-e"></span>
        <span><?= $escaper->escapeHtml($brandsCategory->getName()) ?></span>
    </a>
    <ul class="level0 submenu ui-menu ui-widget ui-widget-content ui-front submenu-reverse" role="menu" aria-hidden="true" aria-expanded="false" style="display: none;">
        <!-- Brand Directory Container -->
        <div class="brand-directory-container">
            <!-- Alphabet Navigation -->
            <nav class="alphabet-nav" id="alphabetNav">
                <div class="alphabet-list">
                    <!-- Letters will be generated by jQuery -->
                </div>
            </nav>

            <!-- Brand Sections -->
            <main class="brand-sections" id="brandSections">
                <!-- Sections will be generated by jQuery -->
            </main>
        </div>
    </ul>
</li>
<?php else: ?>
<!-- Brand category not found. Menu not rendered. -->
<?php endif; ?>
</li>


<script>
// Fixed Header and Navigation Handler
function initFixedHeader() {
    var $ = jQuery;
    
    // Calculate and set dynamic heights
    function updateFixedHeights() {
        if (window.innerWidth >= 768) {
            var headerHeight = $('.page-header').outerHeight() || 80;
            var navHeight = $('.navigation').outerHeight() || 60;
            var totalHeight = headerHeight + navHeight;
            
            // Set CSS custom properties
            document.documentElement.style.setProperty('--header-height', headerHeight + 'px');
            document.documentElement.style.setProperty('--nav-height', navHeight + 'px');
            document.documentElement.style.setProperty('--total-fixed-height', totalHeight + 'px');
            
            // Add class to body for fixed header styles
            $('body').addClass('fixed-header-active');
        } else {
            var mobileHeaderHeight = $('.page-header').outerHeight() || 70;
            document.documentElement.style.setProperty('--mobile-header-height', mobileHeaderHeight + 'px');
            $('body').addClass('fixed-header-active');
        }
    }
    
    // Initialize fixed header on page load
    $(window).on('load resize', function() {
        setTimeout(updateFixedHeights, 100); // Small delay to ensure elements are rendered
    });
    
    // Initialize immediately
    updateFixedHeights();
}

// Initialize using Magento's RequireJS and jQuery
require(['jquery'], function($) {
    // Use $ here instead of jQuery
    window.jQuery = $; // Set global jQuery if needed
    
    initFixedHeader();
    initBrandDirectory(); 
});

function initBrandDirectory() {
    var $ = jQuery;
    
    // Brand data from PHP (converted to JavaScript)
    var brands = [
        <?php
        // Convert PHP brands to JavaScript array
        $brandsByLetter = [];
        foreach ($brandSubcategories as $brandCat) {
            if (!$brandCat->getIsActive()) continue;
            $name = trim($brandCat->getName());
            $firstLetter = strtoupper(mb_substr($name, 0, 1));
            if (!preg_match('/[A-Z]/', $firstLetter)) {
                $firstLetter = '#'; // Non-alphabetic
            }
            echo '{ name: "' . $escaper->escapeJs($name) . '", letter: "' . $firstLetter . '", url: "' . $escaper->escapeJs($brandCat->getUrl()) . '" },';
        }
        ?>
    ];

    var alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");
    
    // Helper Functions
    function getBrandsByLetter(letter) {
        return brands.filter(function(brand) { return brand.letter === letter; });
    }
    
    function hasBrands(letter) {
        return getBrandsByLetter(letter).length > 0;
    }

    // Build Alphabet Navigation
    function buildAlphabetNav() {
        var $alphabetList = $('.alphabet-list');
        $alphabetList.empty();
        
        alphabet.forEach(function(letter, index) {
            var hasBrandsForLetter = hasBrands(letter);
            var $button = $('<button>')
                .addClass('alphabet-letter')
                .text(letter)
                .attr('data-letter', letter)
                .css('animation-delay', (index * 30) + 'ms');
            
            if (!hasBrandsForLetter) {
                $button.addClass('disabled');
            }
            
            $alphabetList.append($button);
        });
    }

    // Build Brand Sections
    function buildBrandSections() {
        var $brandSections = $('#brandSections');
        $brandSections.empty();
        
        alphabet.forEach(function(letter) {
            var letterBrands = getBrandsByLetter(letter);
            
            if (letterBrands.length === 0) return;
            
            // Create section
            var $section = $('<section>')
                .addClass('brand-section')
                .attr('id', 'section-' + letter);
            
            // Letter header
            var $letterDiv = $('<div>')
                .addClass('section-letter')
                .html('<h2>' + letter + '</h2>');
            
            // Brands grid
            var $brandsGrid = $('<div>').addClass('brands-grid');
            
            letterBrands.forEach(function(brand, index) {
                // Create brand image URL - remove "store" and spaces, first letter caps, rest lowercase
                var cleanName = brand.name.replace(/\s*store\s*/gi, ''); // Remove "store" (case insensitive)
                var imageName = cleanName.replace(/[^a-zA-Z0-9]/g, ''); // Remove spaces and special characters
                // First letter uppercase, rest lowercase
                imageName = imageName.charAt(0).toUpperCase() + imageName.slice(1).toLowerCase();
                var imageUrl = 'https://golfoy.com/pub/media/wysiwyg/2024/brands/' + imageName + '.svg';
                
                var $brandLink = $('<a>')
                    .addClass('brand-link')
                    .attr('href', brand.url)
                    .css('animation-delay', (index * 50) + 'ms');
                
                // Create image element
                var $brandImg = $('<img>')
                    .attr('src', imageUrl)
                    .attr('alt', brand.name)
                    .attr('title', brand.name)
                    .on('error', function() {
                        // Fallback: show text if image fails to load
                        $(this).hide();
                        $(this).parent().append('<span class="brand-fallback">' + brand.name + '</span>');
                    });
                
                // Create hidden text element for accessibility and fallback
                var $brandName = $('<span>')
                    .addClass('brand-name')
                    .text(brand.name);
                
                $brandLink.append($brandImg, $brandName);
                $brandsGrid.append($brandLink);
            });
            
            $section.append($letterDiv, $brandsGrid);
            $brandSections.append($section);
        });
    }

    // Event Handlers
    function initEventHandlers() {
        // Alphabet letter click
        $(document).on('click', '.alphabet-letter:not(.disabled)', function() {
            var letter = $(this).data('letter');
            
            // Update active state
            $('.alphabet-letter').removeClass('active');
            $(this).addClass('active');
            
            // Scroll to section
            var $section = $('#section-' + letter);
            if ($section.length) {
                $('.brand-sections').animate({
                    scrollTop: $section.offset().top - $('.brand-sections').offset().top + $('.brand-sections').scrollTop() - 60
                }, 500);
            }
        });
    }

    // Initialize
    function init() {
        buildAlphabetNav();
        buildBrandSections();
        initEventHandlers();
    }

    init();
}
</script>
