<div class="brand-directory-cms-page">
  <!-- A-Z bar at top for desktop only -->
  <nav class="brand-directory-cms-azbar" id="brandDirectoryCmsAzbar">
    <?php foreach ($alphabet as $letter): ?>
      <?php if (!empty($brandsByLetter[$letter])): ?>
        <button class="brand-directory-cms-letter-btn" data-letter="<?= $letter ?>"><?= $letter ?></button>
      <?php endif; ?>
    <?php endforeach; ?>
  </nav>
  <div class="brand-directory-cms-sections" id="brandDirectoryCmsSections">
    <?php foreach ($alphabet as $letter): ?>
      <?php if (!empty($brandsByLetter[$letter])): ?>
        <section class="brand-directory-cms-section" id="brandDirectoryCmsSection-<?= $letter ?>">
          <div class="brand-directory-cms-letter"><?= $letter ?></div>
          <div class="brand-directory-cms-grid">
            <?php foreach ($brandsByLetter[$letter] as $brand): ?>
              <?php
              $cleanName = preg_replace('/\s*store\s*/i', '', $brand['name']);
              $imageName = preg_replace('/[^a-zA-Z0-9]/', '', $cleanName);
              $imageName = ucfirst(strtolower($imageName));
              $imageUrl = 'https://golfoy.com/pub/media/wysiwyg/2024/brands/' . $imageName . '.svg';
              ?>
              <a class="brand-directory-cms-link" href="<?= $escaper->escapeUrl($brand['url']) ?>">
                <img src="<?= $escaper->escapeUrl($imageUrl) ?>" alt="<?= $escaper->escapeHtml($brand['name']) ?>" title="<?= $escaper->escapeHtml($brand['name']) ?>" onerror="this.style.display='none';this.parentNode.insertAdjacentHTML('beforeend','<span class=\'brand-directory-cms-fallback\'><?= $escaper->escapeHtml($brand['name']) ?></span>');">
                <span class="brand-directory-cms-name" style="display:none;"> <?= $escaper->escapeHtml($brand['name']) ?> </span>
              </a>
            <?php endforeach; ?>
          </div>
        </section>
      <?php endif; ?>
    <?php endforeach; ?>
  </div>
  <!-- Mobile right-side alphabet rail -->
  <nav class="brand-directory-cms-rail" id="brandDirectoryCmsRail">
    <?php foreach ($alphabet as $letter): ?>
      <?php if (!empty($brandsByLetter[$letter])): ?>
        <button class="brand-directory-cms-letter-btn" data-letter="<?= $letter ?>"><?= $letter ?></button>
      <?php endif; ?>
    <?php endforeach; ?>
  </nav>
</div>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Top A-Z bar
    var azbar = document.getElementById('brandDirectoryCmsAzbar');
    var azLetters = azbar ? azbar.querySelectorAll('.brand-directory-cms-letter-btn') : [];
    // Mobile right rail
    var rail = document.getElementById('brandDirectoryCmsRail');
    var railLetters = rail ? rail.querySelectorAll('.brand-directory-cms-letter-btn') : [];
    var sections = {};
    document.querySelectorAll('.brand-directory-cms-section').forEach(function(sec) {
      sections[sec.id.replace('brandDirectoryCmsSection-', '')] = sec;
    });
    // Scroll to section with extra offset
    function scrollToLetter(letter, source) {
      var sec = sections[letter];
      if (sec) {
        var headerOffset = window.innerWidth >= 768 ? getFixedHeaderHeight() : 0;
        var extraOffset = 100; // additional offset for fixed header/search bar
        var rect = sec.getBoundingClientRect();
        var scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        var top = rect.top + scrollTop - headerOffset - extraOffset;
        window.scrollTo({
          top: top,
          behavior: 'smooth'
        });
        if (source === 'azbar') {
          azLetters.forEach(function(btn) {
            btn.classList.toggle('active', btn.dataset.letter === letter);
          });
        } else if (source === 'rail') {
          railLetters.forEach(function(btn) {
            btn.classList.toggle('active', btn.dataset.letter === letter);
          });
        }
      }
    }
    // Top bar click
    azLetters.forEach(function(btn) {
      if (btn) {
        btn.addEventListener('click', function() {
          scrollToLetter(btn.dataset.letter, 'azbar');
        });
      }
    });
    // Mobile touch/drag
    if (rail) {
      var isTouching = false;
      var lastLetter = null;

      function handleTouch(e) {
        var touch = e.touches[0];
        var target = document.elementFromPoint(touch.clientX, touch.clientY);
        if (target && target.classList.contains('brand-directory-cms-letter-btn')) {
          var letter = target.dataset.letter;
          if (letter !== lastLetter) {
            scrollToLetter(letter, 'rail');
            lastLetter = letter;
          }
        }
      }

      if (rail) {
        rail.addEventListener('touchstart', function(e) {
          isTouching = true;
          handleTouch(e);
        });
        rail.addEventListener('touchmove', function(e) {
          handleTouch(e);
        });
        rail.addEventListener('touchend', function() {
          isTouching = false;
          lastLetter = null;
        });
      }

      // Mobile click
      railLetters.forEach(function(btn) {
        if (btn) {
          btn.addEventListener('click', function() {
            scrollToLetter(btn.dataset.letter, 'rail');
          });
        }
      });
    }
    // --- Improved scroll event for active alphabet highlight ---
    function updateActiveLetterOnScroll() {
      var scrollPosition = window.pageYOffset || document.documentElement.scrollTop;
      var headerOffset = window.innerWidth >= 768 ? getFixedHeaderHeight() : 0;
      var extraOffset = 200;
      var currentLetter = null;
      Object.keys(sections).forEach(function(letter) {
        var sec = sections[letter];
        var rect = sec.getBoundingClientRect();
        var top = rect.top + scrollPosition - headerOffset - extraOffset;
        if (scrollPosition >= top) {
          currentLetter = letter;
        }
      });
      if (currentLetter) {
        railLetters.forEach(function(btn) {
          btn.classList.toggle('active', btn.dataset.letter === currentLetter);
        });
        azLetters.forEach(function(btn) {
          btn.classList.toggle('active', btn.dataset.letter === currentLetter);
        });
      }
    }
    window.addEventListener('scroll', function() {
      updateActiveLetterOnScroll();
    });
    updateActiveLetterOnScroll();

    function getFixedHeaderHeight() {
      // Try to get CSS variable, fallback to 110px
      var val = getComputedStyle(document.documentElement).getPropertyValue('--total-fixed-height');
      if (val) {
        var px = parseInt(val);
        if (!isNaN(px)) return px;
      }
      return 110;
    }
  });
</script>