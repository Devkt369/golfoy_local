<!-- script for empty search page scrollbar -->
<script>
    const waitForList = setInterval(() => {
        const list = document.querySelector(".wizzy-search-empty-results-wrapper.wizzy-suggestions .wizzy-search-results-list");

        if (!list) return;

        clearInterval(waitForList);

        // Create wrapper div to position arrows absolutely
        const wrapper = document.createElement("div");
        wrapper.className = "product-scroll-wrapper";
        list.parentElement.insertBefore(wrapper, list);
        wrapper.appendChild(list);

        // Create left arrow
        const leftArrow = document.createElement("div");
        leftArrow.className = "scroll-arrow left-arrow";
        leftArrow.innerHTML = "❮";

        // Create right arrow
        const rightArrow = document.createElement("div");
        rightArrow.className = "scroll-arrow right-arrow";
        rightArrow.innerHTML = "❯";

        // Add to wrapper
        wrapper.appendChild(leftArrow);
        wrapper.appendChild(rightArrow);

        // Scroll functionality
        leftArrow.addEventListener("click", () => {
            const itemWidth = list.querySelector("li")?.offsetWidth || 150;
            list.scrollLeft -= itemWidth * 2;
        });

        rightArrow.addEventListener("click", () => {
            const itemWidth = list.querySelector("li")?.offsetWidth || 150;
            list.scrollLeft += itemWidth * 2;
        });
    }, 500);
</script>

