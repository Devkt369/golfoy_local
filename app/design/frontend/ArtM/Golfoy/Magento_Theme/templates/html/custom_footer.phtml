<!-- script for notice header -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        var bodyClass = 'notice_header_Show';
        var noticeEl = document.getElementById('textSlider');
        var headerEl = document.querySelector('header.page-header');
        var closeBtn = noticeEl ? noticeEl.querySelector('.close_notice') : null;

        // Move the full notice block to the top inside the page header.
        if (noticeEl && headerEl && headerEl.firstElementChild !== noticeEl) {
            headerEl.insertBefore(noticeEl, headerEl.firstChild);
        }

        function syncBodyClass() {
            if (!noticeEl) {
                document.body.classList.remove(bodyClass);
                return;
            }

            var isVisible = window.getComputedStyle(noticeEl).display !== 'none';
            document.body.classList.toggle(bodyClass, isVisible);
        }

        if (closeBtn) {
            closeBtn.addEventListener('click', function() {
                noticeEl.style.display = 'none';
                syncBodyClass();
            });
        }

        syncBodyClass();
    });
</script>
<!-- script for notice header -->
<script>
    (function() {
        var announcements = document.querySelectorAll('#textSlider .inner .announcement');

        if (!announcements.length) {
            return;
        }

        var currentIndex = 0;

        announcements.forEach(function(item, index) {
            item.classList.toggle('active', index === 0);
        });

        if (announcements.length === 1) {
            return;
        }

        setInterval(function() {
            announcements[currentIndex].classList.remove('active');
            currentIndex = (currentIndex + 1) % announcements.length;
            announcements[currentIndex].classList.add('active');
        }, 3600);
    })();
</script>
<!-- sccript for increement/decrement for ptoduct page -->
<script>
    function incrementQty() {
        var qtyInput = document.getElementById('qty');
        var currentValue = parseInt(qtyInput.value) || 1;
        qtyInput.value = currentValue + 1;
        qtyInput.dispatchEvent(new Event('change'));
    }

    function decrementQty() {
        var qtyInput = document.getElementById('qty');
        var currentValue = parseInt(qtyInput.value) || 1;
        if (currentValue > 1) {
            qtyInput.value = currentValue - 1;
            qtyInput.dispatchEvent(new Event('change'));
        }
    }

    // Ensure quantity doesn't go below 1 when manually typed
    document.addEventListener('DOMContentLoaded', function () {
        var qtyInput = document.getElementById('qty');
        if (qtyInput) {
            qtyInput.addEventListener('blur', function () {
                var value = parseInt(this.value) || 1;
                if (value < 1) {
                    this.value = 1;
                }
            });

            qtyInput.addEventListener('keyup', function () {
                var value = parseInt(this.value) || 1;
                if (value < 1) {
                    this.value = 1;
                }
            });
        }
    });
</script>
