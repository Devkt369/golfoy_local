<script>
    require(['jquery'], function($) {
        $(document).ready(function() {

            var oldDomain = 'https://staging-golfoy.hyperx.cloud/';
            var newDomain = 'https://golfoy.com';

            function replaceImgSources() {
                document.querySelectorAll('img').forEach(function(img) {
                    // Replace src
                    if (img.src && img.src.indexOf(oldDomain) === 0) {
                        img.src = img.src.replace(oldDomain, newDomain);
                    }
                    // Replace data-src (for lazy loading)
                    if (img.getAttribute('data-src') && img.getAttribute('data-src').indexOf(oldDomain) === 0) {
                        img.setAttribute('data-src', img.getAttribute('data-src').replace(oldDomain, newDomain));
                    }
                    // Replace srcset
                    if (img.srcset && img.srcset.indexOf(oldDomain) !== -1) {
                        img.srcset = img.srcset.split(',').map(function(src) {
                            return src.replace(oldDomain, newDomain);
                        }).join(',');
                    }
                });
            }
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', replaceImgSources);
            } else {
                replaceImgSources();
            }



        });
    });
</script>
