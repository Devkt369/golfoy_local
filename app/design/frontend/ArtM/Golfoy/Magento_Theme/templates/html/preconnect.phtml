<link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">
<link rel="preconnect" href="https://connect.facebook.net" crossorigin>
<link rel="dns-prefetch" href="https://connect.facebook.net">
<?php /* Preload the body-text weight (Spartan Regular, 400) - the most-used weight for above-the-fold text across the theme */ ?>
<link rel="preload" as="font" type="font/woff2" href="<?= $block->escapeUrl($block->getViewFileUrl('fonts/spartan/400_Spartan-Regular.woff2')) ?>" crossorigin>
