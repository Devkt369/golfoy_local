<script>
    require(['jquery'], function(jQuery) {
        jQuery(document).ready(function() {
            jQuery(document).on("click", ".view-action-button", function(e) {
                e.preventDefault();
                jQuery(this).siblings(".table_inside_cart_item").addClass("active_delete");
            });
            jQuery("body").click(function() {
                jQuery(".table_inside_cart_item").removeClass("active_delete");
            });
            jQuery('table.table_inside_cart_item').each(function() {
                var heightOfCartSinglePrd = jQuery(this).height();
                var finalPadding = ((heightOfCartSinglePrd - 15) / 2) - 23;
                var finalPadding = finalPadding / 2;
                console.log('finalPadding', finalPadding);
                if (jQuery(this).find('.actions-toolbar').hasClass('gift-cart-btns')) {

                } else {
                    jQuery(this).find('.actions-toolbar').children('a.action.action-delete, a.action.action-edit').each(function() {
                        var currentStyle = jQuery(this).attr('style') || '';
                        jQuery(this).attr('style', currentStyle + 'padding-top: ' + finalPadding + 'px !important; padding-bottom: ' + finalPadding + 'px !important;');
                    });
                }
            });

        });
    });
</script>

