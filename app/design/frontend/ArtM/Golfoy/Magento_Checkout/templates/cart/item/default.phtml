                                    <div class="estir">

                                        <?php
                                        $proid = $_item->getProductId();
                                        $objectManager = \Magento\Framework\App\ObjectManager::getInstance();
                                        $prod = $objectManager->create('Magento\Catalog\Model\Product')->load($proid);

                                        if ($prod->getAttributeText('shippingdays') == '') {
                                            $est_ship = 5;
                                        } else if ($prod->getAttributeText('shippingdays') == 0) {
                                            $est_ship = 5;
                                        } else {
                                            $est_ship = $prod->getAttributeText('shippingdays');
                                        }

                                        $unexpected_delay = $prod->getAttributeText('unexpected_delay');

                                        $total_days_of_shipping = $prod->getAttributeText('dispatch') + $est_ship + $unexpected_delay;
                                        $est_d = $prod->getAttributeText('dispatch');

                                        if ($est_d != '') {
                                            $t = time();
                                            $next_timestamp = strtotime('+' . $total_days_of_shipping . ' days', $t);
                                            $edate = date('F d, Y', $next_timestamp);
                                            echo "<span class='eda' style='display:none'>" . $edate . "</span>";
                                        }
                                        ?>
                                        <div class="esti"></div>
                                    </div>
                                <?php endif; ?>

