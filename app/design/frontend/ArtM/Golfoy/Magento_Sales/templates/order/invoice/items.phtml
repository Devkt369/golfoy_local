?>
<?php $_order = $block->getOrder() ?>
<div class="actions-toolbar">
    <a href="<?= $block->escapeUrl($block->getPrintAllInvoicesUrl($_order)) ?>"
       class="action print"
       target="_blank"
       rel="noopener">
        <span><?= $block->escapeHtml(__('Print All Invoices')) ?></span>
    </a>
</div>
<?php foreach ($_order->getInvoiceCollection() as $_invoice) : ?>
    <div class="order-title">
        <strong>
            <?php
                if(isset($_invoice['vin_invoice_number']) && $_invoice['vin_invoice_number'] != 0 && $_invoice['vin_invoice_number'] != null){
                    ?> 
                        <?= $block->escapeHtml(__('Invoice #')) ?><?= $_invoice['vin_invoice_number'] ?>
                    <?php
                }else{
                    ?>
                        <?= $block->escapeHtml(__('Invoice #')) ?><?= (int) $_invoice->getIncrementId() ?>
                    <?php
                }
            ?>
        </strong>
        <a href="<?= $block->escapeUrl($block->getPrintInvoiceUrl($_invoice)) ?>"
           class="action print"
           target="_blank"
           rel="noopener">
            <span><?= $block->escapeHtml(__('Download Invoice')) ?></span>
        </a>
        <div class="invoice-date">
            <strong><?= $block->escapeHtml(__('Invoice Date:')) ?></strong>
            <span><?= $block->escapeHtml($block->formatDate($_invoice->getCreatedAt(), 'medium', false)) ?></span>
        </div>
    </div>
    <div class="table-wrapper table-order-items invoice">
        <table class="data table table-order-items invoice" id="my-invoice-table-<?= (int) $_invoice->getId() ?>">
            <caption class="table-caption"><?= $block->escapeHtml(__('Items Invoiced')) ?></caption>
            <thead>
                <tr>
                    <th class="col name"><?= $block->escapeHtml(__('Product')) ?></th>
                    <th class="col sku"><?= $block->escapeHtml(__('SKU')) ?></th>
                    <th class="col sku"><?= $block->escapeHtml(__('HSN Code')) ?></th>
                    <th class="col price"><?= $block->escapeHtml(__('Price')) ?></th>
                    <th class="col qty"><?= $block->escapeHtml(__('Qty')) ?></th>
                    <th class="col subtotal"><?= $block->escapeHtml(__('Subtotal')) ?></th>
                </tr>
            </thead>
            <?php $_items = $_invoice->getAllItems(); ?>
            <?php foreach ($_items as $_item) : ?>
                <?php if (!$_item->getOrderItem()->getParentItem()) : ?>
                    <tbody>
                        <?= $block->getItemHtml($_item) ?>
                    </tbody>
                <?php endif; ?>
            <?php endforeach; ?>
            <tfoot>
                <?= $block->getInvoiceTotalsHtml($_invoice) ?>
            </tfoot>
        </table>
    </div>
    <?= $block->getInvoiceCommentsHtml($_invoice) ?>
<?php endforeach; ?>
<style>
    .invoice-date {
        display: inline-block;
        float: right;
        margin: 1.1rem;
    }
</style>