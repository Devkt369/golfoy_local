    .block-content .info-title-icon-wrap img {
        width: 20px;
        height: 20px;
        padding: 0px !important;
    }

    body.account strong.box-title * {
        padding: 0px !important;
    }

    .block-order-details-view .box-title .info-title-with-icon,
