?>
<?php /** @var $block \Magento\Sales\Block\Order\Info */ ?>
<?php $_order = $block->getOrder() ?>
<?php
$storeManager = \Magento\Framework\App\ObjectManager::getInstance()
    ->get(\Magento\Store\Model\StoreManagerInterface::class);
$iconBaseUrl = $storeManager->getStore()->getBaseUrl(\Magento\Framework\UrlInterface::URL_TYPE_MEDIA) . 'wysiwyg/order/';

/* Update only these file names when you upload your icons */
$shippingAddressIcon = 'location.svg';
$billingAddressIcon = 'delivery-car.svg';
$paymentMethodIcon = 'credit-card.svg';
?>
<div class="block block-order-details-view">
    <div class="block-title">
        <strong><?= $block->escapeHtml(__('Order Information')) ?></strong>
    </div>
    <div class="block-content">
        <?php if (!$_order->getIsVirtual()) : ?>
            <div class="box box-order-shipping-address">
                <strong class="box-title">
                    <span class="info-title-with-icon">
                        <div class="info-title-icon-wrap">
                            <img class="info-title-icon" src="<?= $block->escapeUrl($iconBaseUrl . $shippingAddressIcon) ?>" alt="" width="18" height="18">
                        </div>
                        <?= $block->escapeHtml(__('Shipping Address')) ?>
                    </span>
                </strong>
                <div class="box-content">
                    <address><?= /* @noEscape */ $block->getFormattedAddress($_order->getShippingAddress()) ?></address>
                </div>
            </div>

            <div class="box box-order-shipping-method">
                <strong class="box-title">
                    <span><?= $block->escapeHtml(__('Shipping Method')) ?></span>
                </strong>
                <div class="box-content">
                    <?php if ($_order->getShippingDescription()) : ?>
                        <?= $block->escapeHtml($_order->getShippingDescription()) ?>
                    <?php else : ?>
                        <?= $block->escapeHtml(__('No shipping information available')) ?>
                    <?php endif; ?>
                </div>
            </div>
        <?php endif; ?>

        <div class="box box-order-billing-address">
            <strong class="box-title">
                <span class="info-title-with-icon">
                    <div class="info-title-icon-wrap">
                        <img class="info-title-icon" src="<?= $block->escapeUrl($iconBaseUrl . $billingAddressIcon) ?>" alt="" width="18" height="18">
                    </div>
                    <?= $block->escapeHtml(__('Billing Address')) ?>
                </span>
            </strong>
            <div class="box-content">
                <address><?= /* @noEscape */ $block->getFormattedAddress($_order->getBillingAddress()) ?></address>
            </div>
        </div>
        <div class="box box-order-billing-method">
            <strong class="box-title">
                <span class="info-title-with-icon">
                    <div class="info-title-icon-wrap">
                        <img class="info-title-icon" src="<?= $block->escapeUrl($iconBaseUrl . $paymentMethodIcon) ?>" alt="" width="18" height="18">
                    </div>
                    <?= $block->escapeHtml(__('Payment Method')) ?>
                </span>
            </strong>
            <div class="box-content">
                <?php
                $paymentMethod = $_order->getPayment()->getMethod();

                if ($paymentMethod === 'cashondelivery') {
                    echo '<strong>Cash on Delivery</strong>';
                } elseif ($paymentMethod === 'razorpay') {
                    echo '<strong>Prepaid Order</strong>';
                } elseif ($paymentMethod === 'free') {
                    echo '<strong>Prepaid Order</strong>';
                } else {
                    echo '<strong>' . $block->escapeHtml(ucwords(str_replace('_', ' ', $paymentMethod))) . '</strong>';
                }
                ?>
            </div>
        </div>
    </div>
</div>
<div class="actions-toolbar-bottom">
    <div class="secondary">
        <a href="<?= $block->getUrl('sales/order/history') ?>" class="action back">
            <span>Back to My Orders</span>
        </a>
    </div>
</div>

