                                    } elseif ($attrValue === null || $attrValue === '') {
                                        $displayValue = '<span style="color: #999; font-style: italic;">' . $attrName . ' is not assigned</span>';
                                    } else {
                                        $attrValueStr = is_array($attrValue) ? json_encode($attrValue) : $attrValue;
                                        // Always pass string to escaper
                                        $safeAttrValueStr = is_array($attrValueStr) ? json_encode($attrValueStr) : (string)$attrValueStr;
