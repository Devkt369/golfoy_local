        //     show_once: true
        // }
        // Add more configs as needed
    ];

    var currentPath = window.location.pathname;
    var config = popupConfigs.find(function(cfg) { return cfg.url === currentPath; });

    if (config) {
        var popupKey = 'popup_shown_' + encodeURIComponent(config.url);
        var alreadyShown = config.show_once && window.localStorage && localStorage.getItem(popupKey);
        if (!alreadyShown) {
            setTimeout(function() {
                // Fade black background overlay
                var $overlay = $('<div id="custom-popup-overlay" style="position:fixed;top:0;left:0;width:100vw;height:100vh;background:rgba(0,0,0,0.6);z-index:2147483646;"></div>');
                // Popup box
                var $popup = $('<div id="custom-popup" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); z-index:2147483647; background:#fff; border-radius:8px; box-shadow:0 2px 16px rgba(0,0,0,0.2); padding:20px; text-align:center; min-width:300px; max-width:90vw;">' +
                    '<span id="popup-close" style="position:absolute; top:8px; right:12px; cursor:pointer; font-size:22px;">&times;</span>' +
                    '<div class="popup-content"></div>' +
                    '</div>');
                if (config.type === 'image') {
                    $popup.find('.popup-content').html('<img src="' + config.source + '" alt="Popup Image" style="max-width:100%;height:auto;">');
                } else {
                    $popup.find('.popup-content').html(config.source);
                }
                // Overlay click closes popup
                $overlay.on('click', function(e) {
                    $popup.fadeOut(200, function() { $popup.remove(); });
                    $overlay.fadeOut(200, function() { $overlay.remove(); });
                });
                // Prevent tabbing out of popup
                $popup.attr('tabindex', '-1');
                // Append at end of body
                $('body').append($overlay).append($popup);
                $popup.fadeIn(200);
                // Focus popup for accessibility
                $popup.focus();

                $popup.find('#popup-close').on('click', function(e) {
                    e.stopPropagation();
                    $popup.fadeOut(200, function() { $popup.remove(); });
                    $overlay.fadeOut(200, function() { $overlay.remove(); });
                });
                if (config.show_once && window.localStorage) {
                    localStorage.setItem(popupKey, '1');
                }
            }, 3000); // 3 seconds delay
        }
    }

    });
});
</script>

<script type="text/javascript">
    require(['jquery'], function($) {
        $(document).ready(function() {
        function debounce(func, wait) {
            var timeout;
            return function() {
                var context = this, args = arguments;
                clearTimeout(timeout);
                timeout = setTimeout(function() {
                    func.apply(context, args);
                }, wait);
            };
        }

        var lastBulkRun = 0;
        var lastProductCount = 0;
        window._bulkProductDataRunning = false;
        function runBulkProductDataOnce() {
            var now = Date.now();
            var currentCount = $('.product-item-info').length;
            if (window._bulkProductDataRunning) return;
            if (currentCount === 0) return;
            if (now - lastBulkRun < 1000) return;
            lastBulkRun = now;
            window._bulkProductDataQueue = [];
            window._bulkDataProcessed = false;
            $('.product-item-info').each(function() {
                var $container = $(this);
                var productId = $container.data('product-id');
                var sku = $container.data('sku');
                if (!productId || !sku) return; // skip invalid
                var attrSet = $container.data('attr-set');
                var printType = $container.data('print-type');
                var printTypeCapitalized = $container.data('print-type-capitalized');
                var canPrint = $container.data('can-print');
                var debugPlaceholder = $container.find('.ajax-debug-placeholder');
                var flarePositions = $container.data('flare-positions') || {};
                window._bulkProductDataQueue.push({
                    productId: productId,
                    attrSet: attrSet,
                    printType: printType,
                    printTypeCapitalized: printTypeCapitalized,
                    canPrint: canPrint,
                    sku: sku,
                    container: $container,
                    debugPlaceholder: debugPlaceholder,
                    flarePositions: flarePositions
                });
            });
            if (window._bulkProductDataQueue.length > 0 && typeof window.processBulkProductData === 'function') {
                window.processBulkProductData();
            }
        }

        // On page load (only once)
        var pageLoadTriggered = false;
        $(window).on('load', function() {
            if (pageLoadTriggered) return;
            pageLoadTriggered = true;
            window._bulkProductDataRunning = false;
            setTimeout(runBulkProductDataOnce, 200);
        });

        // On filter AJAX
        $(document).on('contentUpdated','#ajaxlist-reload-product_list', function() {
            window._bulkProductDataRunning = false;
            lastProductCount = 0;
            setTimeout(runBulkProductDataOnce, 200);
        });

        // Patch processBulkProductData to set the flag only after AJAX call is made
        var origProcessBulk = window.processBulkProductData;
        window.processBulkProductData = function() {
            if (window._bulkProductDataRunning) return;
            if (typeof origProcessBulk === 'function') {
                origProcessBulk.apply(this, arguments);
                window._bulkProductDataRunning = true; // Set flag after AJAX
            }
        };

    }); 

    });
</script>