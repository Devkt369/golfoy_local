                                    } elseif ($grade === 'Value') {
                                        $stars = 3;
                                        $color = '#f7b714'; // orange/yellow
                                    } elseif ($grade === 'Very Good') {
                                        $stars = 4;
                                        $color = '#66bb6a'; // green
                                    } elseif ($grade === 'Excellent') {
                                        $stars = 5;
                                        $color = '#388e3c'; // deep green
                                    }

                                    // Sanitize grade for class (remove spaces/special chars, lowercase)
                                    $gradeClass = strtolower(preg_replace('/[^a-zA-Z0-9]/', '', $grade));

                                    /* =====================
       HTML STRUCTURE
    ====================== */
                                    $usedClubsGradeHtml  = '<div class="flare used_clubs_grade">';
                                    $usedClubsGradeHtml .= '<div class="used-clubs-grade-wrapper">';

                                    // Stars
                                    $usedClubsGradeHtml .= '<div class="used-clubs-stars ' . $gradeClass . '" style="font-family:FontAwesome; letter-spacing:1px;">';

