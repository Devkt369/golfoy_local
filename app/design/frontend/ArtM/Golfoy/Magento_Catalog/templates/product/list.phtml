                                    continue;
                                }


                                // Create flare HTML with span tag
                                $safeDisplayValue = is_array($displayValue) ? json_encode($displayValue) : (string)$displayValue;
                                $flareHtml = '<span class="flare ' . $flareName . '" value="' . $escaper->escapeHtmlAttr($safeDisplayValue) . '">' . $displayLabel . '</span>';

                                // Determine position based on configuration
                                if (in_array($flareName, $flarePositions['left'])) {
                                    $leftFlares[] = $flareHtml;
                                } elseif (in_array($flareName, $flarePositions['right'])) {
                                    $rightFlares[] = $flareHtml;
                                } else {
