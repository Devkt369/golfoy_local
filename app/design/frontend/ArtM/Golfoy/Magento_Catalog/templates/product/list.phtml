$_helper = $block->getData('outputHelper');

// Cache configuration values for performance
$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$scopeConfig = $objectManager->get(\Magento\Framework\App\Config\ScopeConfigInterface::class);
$engraveAttrSets = $scopeConfig->getValue('category_setting/engrave_print/custom_printing', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);
$engraveAttrSets = $engraveAttrSets ? array_map('intval', explode(',', $engraveAttrSets)) : [];

// Get featured attributes config
$featuredAttrsConfig = $scopeConfig->getValue('common/categoryfeaturedattr/common_categoryfeaturedattr', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);
$featuredAttrsMapping = [];
if ($featuredAttrsConfig) {
    $pairs = explode('|', $featuredAttrsConfig);
    foreach ($pairs as $pair) {
        $parts = explode(':', $pair);
        if (count($parts) === 2) {
            $featuredAttrsMapping[trim($parts[0])] = trim($parts[1]);
        }
    }
}

// Fetch 'luxury' directly from EAV, keyed by entity_id, instead of relying on
// $_product->getData('luxury'). The category grid's product collection runs
// against the flat catalog table, which only has whatever attribute columns
// existed at the time of the last flat reindex — 'luxury' isn't guaranteed to
// be one of them (PDP loads the full EAV product so it always sees the value).
$luxuryValuesByEntity = [];
try {
    $eavConfig = $objectManager->get(\Magento\Eav\Model\Config::class);
    $luxuryAttribute = $eavConfig->getAttribute(\Magento\Catalog\Model\Product::ENTITY, 'luxury');
    if ($luxuryAttribute && $luxuryAttribute->getAttributeId()) {
        $entityIds = [];
        foreach ($_productCollection as $_productForLuxuryLookup) {
            $entityIds[] = (int) $_productForLuxuryLookup->getId();
        }
        if ($entityIds) {
            $storeId = (int) $objectManager->get(\Magento\Store\Model\StoreManagerInterface::class)->getStore()->getId();
            $connection = $luxuryAttribute->getResource()->getConnection();
            $rows = $connection->fetchAll(
                $connection->select()
                    ->from($luxuryAttribute->getBackend()->getTable(), ['entity_id', 'store_id', 'value'])
                    ->where('attribute_id = ?', (int) $luxuryAttribute->getAttributeId())
                    ->where('entity_id IN (?)', $entityIds)
                    ->where('store_id IN (?)', [0, $storeId])
            );
            foreach ($rows as $row) {
                $entityId = (int) $row['entity_id'];
                // A store-specific row (store_id = current store) overrides the default (store_id = 0) row
                if (!isset($luxuryValuesByEntity[$entityId]) || (int) $row['store_id'] === $storeId) {
                    $luxuryValuesByEntity[$entityId] = $row['value'];
                }
            }
        }
    }
} catch (\Exception $e) {
    $luxuryValuesByEntity = [];
}

