                            // Define flare labels
                            $flareLabels = [
                                'newarrivals' => 'New Arrival',
                                'offer_status' => 'Lowest Price',
                                'bestseller' => 'Best Seller',
                                'playerschoice' => 'Pro\'s Choice',
                                'limitedstock' => 'Limited Stock',
                                'used_clubs_grade' => 'Used Grade',
                                'can_customize' => 'Customization',
                                'free_print' => 'Free Print',
                                'free_engrave' => 'Free Engrave',
                                'custom_print' => 'Custom Print',
                                'luxury' => 'Luxe',
                                'custom_engrave' => 'Custom Engrave'
                            ];

                            // Show simple flares immediately
                            $immediateFlares = [];
                            foreach ($simpleAttributes as $attrName => $attrValue) {
                                // Special logic for offer_status - only show if "Yes" or "YES"
                                if ($attrName === 'offer_status') {
                                    $stringValue = (string)$attrValue;
                                    if ($stringValue === 'yes' || $stringValue === 'YES' || $stringValue === 'Yes') {
                                        $immediateFlares[$attrName] = $stringValue;
