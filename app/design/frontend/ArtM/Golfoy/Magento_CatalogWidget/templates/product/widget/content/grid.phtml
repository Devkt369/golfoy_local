        }
    }
</style>

<script>
    require(['jquery'], function($) {

        $(document).ready(function() {
            $('.widget-slider-wrap').each(function() {
                var slider = $(this);
                var container = slider.find('.slider-container');
                var leftBtn = slider.find('.slider-arrow.left');
                var rightBtn = slider.find('.slider-arrow.right');

                // If arrows are missing, skip this slider
                if (leftBtn.length === 0 || rightBtn.length === 0) {
                    return;
                }

                // Responsive slide width
                var itemWidth = ($(window).width() < 768) ? (250 * 1) : (270 * 3);

                // Right arrow click
                rightBtn.on('click', function() {
                    container.animate({
                        scrollLeft: container.scrollLeft() + itemWidth
                    }, 400);
                });

                // Left arrow click
                leftBtn.on('click', function() {
                    container.animate({
                        scrollLeft: container.scrollLeft() - itemWidth
                    }, 400);
                });

            });
        });

    });
</script>