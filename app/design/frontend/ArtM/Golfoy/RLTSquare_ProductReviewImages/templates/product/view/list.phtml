                            // $(".product-image").on('click', function () {
                            var rel = $(this).attr('rel');
                            var reviewid = $(this).attr('data-reviewid');
                            var reviewhtmlli = $("#reviewli_" + reviewid).html();
                            var reviewhtml = '<li class="item review-item">' + reviewhtmlli + '</li>';
                            //update code of popup - 18-03-2023

                            var imageHtml = '<div class="col-md-8 col-sm-8 col-xs-12 review_img_sec"><img id="review-image-lg"  src="' + $(this).attr("src") + '"/> ' + nxtPrvBtnHtml + '</div>';
