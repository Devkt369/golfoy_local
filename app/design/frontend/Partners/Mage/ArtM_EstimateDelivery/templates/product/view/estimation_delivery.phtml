                populateCache();
                <?php endif; ?>
            }, 100);

            function formatDate(dateStr) {
                const date = new Date(dateStr);
                return date.toLocaleDateString("en-US", {
                    month: "long",
                    day: "numeric",
                    year: "numeric"
                });
            }

            function populateCache() {
                $.ajax({
                    url: "/estimatedelivery/estimateDelivery/GetEstimateDelivery",
                    type: "POST",
                    dataType: "json",
                    data: {
                        sku: "<?= $sku ?>",
                        product_id: "<?= (int)$productId ?>",
                        form_key: "<?= $formKey ?>"
                    },
                    success: function(response) {
                        if (response) {
                            updateDeliveryDisplay(response);
                        }
                    },
                    error: function() {
                        console.log('Failed to load delivery estimation');
                    }
                });
            }

            function updateDeliveryDisplay(data) {
                var container = $("#estimate-delivery-box");
                if (!container.length) return;

