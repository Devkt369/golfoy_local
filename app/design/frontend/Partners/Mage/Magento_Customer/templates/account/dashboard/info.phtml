            </div>
            <h3 class="profile-name"><?= $block->escapeHtml($name) ?>
                <span class="btn-edit">
                    <a href="<?= $block->escapeUrl($block->getUrl('customer/account/edit')) ?>">
                        <img src="https://golfoy.com/media/partners/edit-info-grey.png" alt="account-edit-partners">
                    </a>
                </span>
            </h3>

