                    <span class="value"><?= $email ?></span>
                </div>
            </div>
            <?php if ($company !== ''): ?>
                <div class="info-box">
                    <div>
                        <span class="label">Company</span>
                        <span class="value"><?= $company ?></span>
                    </div>
                </div>
            <?php endif; ?>
            <?php if ($taxvat !== ''): ?>
                <div class="info-box">
                    <!-- <div class="hide">
                    <span class="label">PAN NO.</span>
                    <span class="value"><?= $panValue ?></span>
                </div> -->
                    <div>
                        <span class="label">GST NO.</span>
