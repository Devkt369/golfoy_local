<?php

/** @var \Magento\Customer\Block\Account\Dashboard\Info $block */
$customer = $block->getCustomer();
$name = $block->escapeHtml($block->getName());
$email = $block->escapeHtml($customer->getEmail());
$billingId = $customer->getDefaultBilling(); // e.g. 26770

$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$addressRepository = $objectManager->get(\Magento\Customer\Api\AddressRepositoryInterface::class);

try {
    $address = $addressRepository->getById($billingId);

    // Safely get address fields
    $company = $address->getCompany() ?: "";
    $gst = $address->getVatId() ?: '';

    $taxvat = $customer->getTaxvat();

    $pan = $customer->getCustomAttribute('pan_number');
    $panValue = $pan ? $block->escapeHtml($pan->getValue()) : '';
} catch (\Exception $e) {
    // Fallback defaults if something goes wrong
    $company = "";
    $taxvat = '';
    $panValue = '';
}

$customerCode = 'NOTFOUND';
?>
