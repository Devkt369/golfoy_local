<script>
    require(['jquery'], function(jQuery) {
        jQuery(document).ready(function() {


            var menuCache = localStorage.getItem('menu_cache_partners');

            if (!menuCache) {
                console.log('No menu cache found');
            }

            function applyMenu() {

                var $menuItem = jQuery('li.level0.nav-2.category-item.level-top.parent.ui-menu-item');
                var $submenu = $menuItem.find('ul.level0.submenu');

                // wait until menu exists
                if (!$menuItem.length || !$submenu.length) {
                    return false;
                }

                // already applied → stop
                if ($menuItem.hasClass('htmlAppend')) {
                    return true;
                }

                $menuItem.addClass('htmlAppend');

                // clear existing menu
                $submenu.empty();

                // append cached html
                $submenu.append(menuCache);

                $submenu.addClass('htmlAppend');

                console.log('Menu replaced from localStorage');

                return true; // 🔥 IMPORTANT
            }

            // 🔥 retry until success, then stop
            var interval = setInterval(function () {
                if (applyMenu()) {
                    clearInterval(interval);
                    console.log('Stopped interval');
                }
            }, 300);
            
            if (jQuery(window).width() > 768) {
                // jQuery('nav.navigation .level0.nav-2.category-item.last.level-top.parent.ui-menu-item').hover(function(e) {
                //     e.preventDefault();
                //     jQuery('ul.level0.submenu.ui-menu.ui-widget.ui-widget-content.ui-front.htmlAppend').removeClass('ui-menu');
                //     jQuery('.alphabets.menu_alphabets_block span[show_menu="A_block"]').click();
