                //     e.preventDefault();
                //     jQuery('ul.level0.submenu.ui-widget.ui-widget-content.ui-front.htmlAppend').css('display', 'none');
                // });

                jQuery(document).on("click", '.alphabets.menu_alphabets_block span', function(e) {
                    jQuery('.alphabets.menu_alphabets_block span').removeClass('active');
                    jQuery(this).addClass('active');
                    var targetBlock = jQuery(this).attr('show_menu');
                    var targetElement = jQuery('.single_alpha_brands_menu[for_menu="' + targetBlock + '"]');
                    var container = jQuery('.brands_html');
                    var scrollPosition = targetElement.offset().left - container.offset().left + container.scrollLeft();
                    container.animate({
                        scrollLeft: scrollPosition
                    }, 500);
                });
            }



            jQuery(document).on("click", ".nav-1 #ui-id-2", function(e) {
                e.preventDefault();
                window.location.href = "/";
            });







            if (jQuery(window).width() < 990) {
                jQuery(".level0 > a").addClass("collapsed");
                jQuery(".level0 > a").click(function() {
                    if (jQuery(window).width() < 768) {
                        var $siblingsUl = jQuery(this).siblings("ul.level0");

                        if ($siblingsUl.hasClass("expanded")) {
                            $siblingsUl.addClass("collapsed").removeClass("expanded");
                            jQuery(this).addClass("collapsed").removeClass("expanded");
                        } else {
                            $siblingsUl.addClass("expanded").removeClass("collapsed");
                            jQuery(this).addClass("expanded").removeClass("collapsed");
                        }
                    } else if (jQuery(window).width() === 768) {
                        window.location.href = jQuery(this).attr("href");
                    }
                });
                jQuery('a[rel-href]').each(function() {
                    var $linkToUpdate = jQuery(this);
                    var targetUrl = $linkToUpdate.attr('rel-href');
                    if (targetUrl) {
                        $linkToUpdate.attr('href', targetUrl);
                    }
                });
            }

            if (jQuery(window).width() < 990) {
                jQuery('.produc_name_sec').show();
                jQuery('.subcat_name .toggle-button').hide();
            }

            // Toggle on click for desktop screens
            jQuery(document).on("click", ".subcat_name", function() {
                if (jQuery(window).width() >= 990) { // Only toggle for screens 990px and above
                    var toggleButton = jQuery(this).find('.toggle-button');
                    var productSection = jQuery(this).siblings('.produc_name_sec');

                    jQuery(this).toggleClass('active');

                    productSection.slideToggle(function() {
                        if (toggleButton.text() === '+') {
                            toggleButton.text('\u2212');
                        } else {
                            toggleButton.text('+');
                        }
                    });
                }
            });


            jQuery(document).on("click", ".single_alpha_brands_menu .alpha_heading_menu , li.ui-menu-item.all-category , ul.submenu li.category-item.ui-menu-item a.ui-menu-item-wrapper", function(e) {
                if (jQuery(window).width() < 768) {
                    jQuery('span.action.nav-toggle').click();
                }
            });

            // function updateLinkMenu() {
            //     jQuery("li.level-top.parent").each(function() {
            //         var firstAnchor = jQuery(this).find("a.ui-menu-item-wrapper").first();
            //         var relHrefValue = firstAnchor.attr("rel-href");
            //         jQuery(this).find("li.ui-menu-item.all-category a").attr("rel-href", relHrefValue);
            //         firstAnchor.removeAttr("rel-href");
            //     });
            // }
            // if (jQuery(window).width() < 768) {
            //     setInterval(updateLinkMenu, 1000);
            //     if (jQuery(this).parent().hasClass("level-top parent ui-menu-item")) {
            //         e.preventDefault();
            //         console.log('click');
            //         return;
            //     }
            // }

            jQuery(document).on("click", "#gfmyBtn", function(e) {
                jQuery("#gfmore").toggle("slow", function() {
                    // check paragraph once toggle effect is completed
                    if (jQuery("#gfmore").is(":visible")) {
                        jQuery("#gfdots").hide();
                        jQuery("#gfmyBtn").html("Read less");
                    } else {
                        jQuery("#gfdots").show();
                        jQuery("#gfmyBtn").html("Read more");
                    }
                });
            });

            jQuery(document).on("click", "div#narrow-by-list .filter-options-item .filter-options-title", function(e) {
                e.preventDefault();
                e.stopPropagation();
                if (jQuery(this).parent('.filter-options-item').hasClass('active')) {
                    jQuery(this).parent('.filter-options-item').removeClass('active');
                } else {
                    jQuery(this).parent('.filter-options-item').addClass('active');
                }
            });

            jQuery(".block-content.filter-content strong.block-subtitle.filter-subtitle").on("click", function() {
                jQuery(".block-content.filter-content dl#narrow-by-list").toggle();
            });

        });
    });
</script>
