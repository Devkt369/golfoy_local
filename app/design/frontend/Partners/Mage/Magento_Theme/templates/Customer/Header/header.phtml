<script>
    document.addEventListener("DOMContentLoaded", function() {
        const filterSubtitle = document.querySelector(".filter-subtitle");
        const filterBlock = document.querySelector(".block.filter");
        const body = document.body;

        // Toggle open/close on subtitle
        if (filterSubtitle && filterBlock) {
            filterSubtitle.addEventListener("click", function() {
                body.classList.toggle("filter-open");
                filterBlock.classList.toggle("filter-is-open");
            });
        }

        // Remove filter-open when clicking any filter link
        const filterLinks = document.querySelectorAll(".swatch-option-link-layered, .layered-navigation-filter-link");
        if (filterLinks.length > 0) {
            filterLinks.forEach(link => {
                link.addEventListener("click", function() {
                    body.classList.remove("filter-open");
                    filterBlock.classList.remove("filter-is-open");
                });
            });
        }
    });
</script>
