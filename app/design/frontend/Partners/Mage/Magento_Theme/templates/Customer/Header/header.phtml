<!-- to add fixed class in header after refresh -->
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const header = document.querySelector("header.page-header");
        const navSections = document.querySelector(".page-wrapper > .sections.nav-sections");

        function fixHeader() {
            const windowScrollTop = window.scrollY;

            if (windowScrollTop > 0) { // instantly apply on any scroll
                header.classList.add("fixed");
                navSections.classList.add("fixed");

                if (window.innerWidth > 768) {
                    navSections.style.top = header.offsetHeight + "px";
                }
            } else {
                header.classList.remove("fixed");
                navSections.classList.remove("fixed");
            }
        }

        // Instant scroll detection with rAF
        window.addEventListener("scroll", () => {
            requestAnimationFrame(fixHeader);
        });

        // Run on page load
        fixHeader();
    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const container = document.querySelector(".block-collapsible-nav");

        if (!container) return;

        const observer = new MutationObserver(() => {
            const title = container.querySelector(".block-collapsible-nav-title");

            if (title.classList.contains("active")) {
                document.body.classList.add("collapse-open");
            } else {
                document.body.classList.remove("collapse-open");
            }
        });

        observer.observe(container, {
            attributes: true,
            attributeFilter: ["class"],
            subtree: true
        });
    });
</script>
