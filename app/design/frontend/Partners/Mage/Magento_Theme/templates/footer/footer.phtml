<script>
    require(['jquery'], function($) {
        $(document).ready(function() {
            if (jQuery(window).width() > 768) {
                setTimeout(function() {
                    jQuery("nav.navigation li.ui-menu-item a.ui-menu-item-wrapper").each(function() {
                        var newHref = jQuery(this).attr("rel-href");
                        if (newHref) {
                            newHref = newHref.split('#')[0];
                        }
                        jQuery(this).attr("href", newHref);
                    });
                }, 3000);
            }
            $(document).on("click", ".level0 > a", function() {
                if ($(window).width() < 768) {
                    var $siblingsUl = $(this).siblings("ul.level0");

                    if ($siblingsUl.hasClass("expanded")) {
                        $siblingsUl.addClass("collapsed").removeClass("expanded");
                        $(this).addClass("collapsed").removeClass("expanded");
                    } else {
                        $siblingsUl.addClass("expanded").removeClass("collapsed");
                        $(this).addClass("expanded").removeClass("collapsed");
                    }
                } else if ($(window).width() === 768) {
                    window.location.href = $(this).attr("href");
                }
            });
        });
    });
</script>