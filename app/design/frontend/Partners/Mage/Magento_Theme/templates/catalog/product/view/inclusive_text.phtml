<?php

use Magento\Framework\App\State;
use Magento\Store\Model\App\Emulation;
use Magento\Store\Model\StoreManagerInterface;
$product = $block->getProduct();
$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$storeManager = $objectManager->get(StoreManagerInterface::class);
$appEmulation = $objectManager->get(Emulation::class);
$mainStoreId = 1;

try {
    $emulationInfo = $appEmulation->startEnvironmentEmulation($mainStoreId);
    $productRepository = $objectManager->get(\Magento\Catalog\Api\ProductRepositoryInterface::class);
    $mainStoreProduct = $productRepository->getById($product->getId(), false, $mainStoreId);
    $finalPriceOtherStore = $mainStoreProduct->getFinalPrice();
    $regularPriceOtherStore = $mainStoreProduct->getPrice();
    $priceHelperOtherStore = $objectManager->get(\Magento\Framework\Pricing\Helper\Data::class);
    $appEmulation->stopEnvironmentEmulation($emulationInfo);
}catch (\Exception $e) {
    // echo 'Error fetching price from main store: ' . $e->getMessage();
}



echo '<div class="selling-price"><span>Our Selling Price: </span>' . $priceHelperOtherStore->currency($finalPriceOtherStore, true, false) . '</div>';
