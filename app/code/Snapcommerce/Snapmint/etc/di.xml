<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\App\Request\CsrfValidator">
        <plugin name="snapmint_csrf_validator_skip" type="Snapcommerce\Snapmint\Plugin\CsrfValidatorSkip" />
    </type>

    <type name="Magento\Sales\Model\Order\Email\Sender\OrderSender">
        <plugin name="snapmint_prevent_order_email" type="Snapcommerce\Snapmint\Plugin\PreventOrderEmailPlugin" sortOrder="5" />
    </type>

    <type name="Magento\Sales\Model\Order\Email\Sender\InvoiceSender">
        <plugin name="snapmint_prevent_invoice_email" type="Snapcommerce\Snapmint\Plugin\PreventOrderInvoiceEmailPlugin" sortOrder="5" />
    </type>

    <type name="Snapcommerce\Snapmint\Logger\Handler">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </type>
    <type name="Snapcommerce\Snapmint\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">customLogHandler</argument>
            <argument name="handlers"  xsi:type="array">
                <item name="system" xsi:type="object">Snapcommerce\Snapmint\Logger\Handler</item>
            </argument>
        </arguments>
    </type>

    <type name="Snapcommerce\Snapmint\Logger\HandlerPost">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </type>
    <type name="Snapcommerce\Snapmint\Logger\LoggerPost">
        <arguments>
            <argument name="name" xsi:type="string">customLogHandler</argument>
            <argument name="handlers"  xsi:type="array">
                <item name="system" xsi:type="object">Snapcommerce\Snapmint\Logger\HandlerPost</item>
            </argument>
        </arguments>
    </type>

        <type name="Magento\Framework\Session\SessionStartChecker">
        <plugin name="snapmint.call_back_session_checker"
                type="Snapcommerce\Snapmint\Plugin\CallbackSessionChecker"/>
    </type>
     <type name="Magento\Sales\Block\Adminhtml\Order\View">
        <plugin name="snapmint.refund" type="Snapcommerce\Snapmint\Plugin\OrderView"/>
    </type>


<type name="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="snapmint_refund" xsi:type="object">Snapcommerce\Snapmint\Logger\Handler\Refund</item>
            </argument>
        </arguments>
    </type>

</config>

