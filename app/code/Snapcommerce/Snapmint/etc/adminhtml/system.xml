<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
	<system>
		<section id="payment">
			<group id="snapmint" sortOrder="10" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
				<label>Snapmint</label>
				<field id="active" type="select" sortOrder="1" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
					<label>Enabled</label>
					<source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
				</field>

				<field id="enable_webhook" type="select" sortOrder="2" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
					<label>Enable Webhook</label>
					<source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
				</field>

				

				<field id="title" type="text" sortOrder="2" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
					<label>Title</label>
				</field>

                <field id="environment" translate="label" type="select" sortOrder="3" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Environment</label>
					<source_model>Snapcommerce\Snapmint\Model\adminhtml\Source\Env</source_model>
                </field>
				<field id="merchantkey" translate="label" type="text" sortOrder="4" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Merchant Key</label>
                </field>
				<field id="merchanttoken" translate="label" type="text" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Merchant Token</label>
                </field>
				<field id="submerchantid" translate="label" type="text" sortOrder="6" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Merchant ID</label>
                </field> 

				<field id="order_status" type="select" sortOrder="7" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
					<label>New Order Status</label>
					<source_model>Magento\Sales\Model\Config\Source\Order\Status\NewStatus</source_model>
				</field>
				<field id="allowspecific" type="allowspecific" sortOrder="8" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
					<label>Payment from Applicable Countries</label>
					<source_model>Magento\Payment\Model\Config\Source\Allspecificcountries</source_model>
				</field>
				<field id="specificcountry" type="multiselect" sortOrder="9" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
					<label>Payment from Applicable Countries</label>
					<source_model>Magento\Directory\Model\Config\Source\Country</source_model>
					<can_be_empty>1</can_be_empty>
				</field>
				<field id="sort_order" type="text" sortOrder="10" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
					<label>Sort Order</label>
				</field>

				<field id="min_order_total" type="text" sortOrder="11" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
					<label>Minimum Order Total</label>
				</field>

				<field id="max_order_total" type="text" sortOrder="12" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
					<label>Maximum Order Total</label>
                	<comment>Leave empty to disable limit</comment>
				</field>
				<field id="subventionfees" type="text" sortOrder="14" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
					<label>subvention fees</label>
				</field>

				<field id="createinvoice" type="select" sortOrder="15" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
					<label>Create Invoice</label>
					<source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                	<comment>Create Invoice When order status is successfull</comment>
				</field>

			</group>
		</section>
	</system>
</config>
