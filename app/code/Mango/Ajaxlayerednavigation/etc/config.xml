<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <ajaxlist>
            <general>
                <show_no_count>1</show_no_count>
                <show_hidden_categories>0</show_hidden_categories>
                <category_tree_parent>0</category_tree_parent>
                <use_priceslider>1</use_priceslider>
                <step>1</step>
                <priceslider_use_minimum_value>0</priceslider_use_minimum_value>
                <priceslider_search_fields>1</priceslider_search_fields>
                <use_category_price_step>0</use_category_price_step>
            </general>
            <!--ajaxcompare>
                <enable>0</enable>
            </ajaxcompare-->
            <frontend>
                <urlhandler>hashChangeJs</urlhandler>
                <hide_state>0</hide_state>
                <tooltips>0</tooltips>
                <tooltips_configuration></tooltips_configuration>
                <collapse>0</collapse>
                <expand_filters>color,price,size</expand_filters>
                <list_max_height>150</list_max_height>
                <select_all>0</select_all>
                <horizontal_mode>0</horizontal_mode>
                <horizontal_filters></horizontal_filters>
                <horizontal_only>0</horizontal_only>
            </frontend>
            <infinite_scroll>
                <enable>0</enable>
                <auto_trigger>1</auto_trigger>
                <padding>300</padding>
                <auto_trigger_until>0</auto_trigger_until>
                <button_text><![CDATA[Load more products...]]></button_text>
                <css_class>action primary</css_class>
                <button_alignment>center</button_alignment>
            </infinite_scroll>
            <!--ajax_configuration>
                <reload_blocks>product_list,layered_nav</reload_blocks>
            </ajax_configuration-->
        </ajaxlist>
    </default>
</config>
