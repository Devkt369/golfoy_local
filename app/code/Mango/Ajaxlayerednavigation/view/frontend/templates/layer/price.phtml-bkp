?>
<style>
input[type="range"]{
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    width: 100%;
    outline: none;
    position: absolute;
    margin: auto;
    top: 0;
    bottom: 0;
    background-color: transparent;
    pointer-events: none;
}
.slider-track{
    width: 100%;
    height: 5px;
    position: absolute;
    margin: auto;
    top: 0;
    bottom: 0;
    border-radius: 5px;
}
input[type="range"]::-webkit-slider-runnable-track{
    -webkit-appearance: none;
    height: 5px;
}
input[type="range"]::-moz-range-track{
    -moz-appearance: none;
    height: 5px;
}
input[type="range"]::-ms-track{
    appearance: none;
    height: 5px;
}
input[type="range"]::-webkit-slider-thumb{
    -webkit-appearance: none;
    height: 1.7em;
    width: 1.7em;
    background-color: #e60023;
    cursor: pointer;
    margin-top: -9px;
    pointer-events: auto;
    border-radius: 50%;
}
input[type="range"]::-moz-range-thumb{
    -webkit-appearance: none;
    height: 1.7em;
    width: 1.7em;
    cursor: pointer;
    border-radius: 50%;
    background-color: #e60023;
    pointer-events: auto;
}
input[type="range"]::-ms-thumb{
    appearance: none;
    height: 1.7em;
    width: 1.7em;
    cursor: pointer;
    border-radius: 50%;
    background-color: #e60023;
    pointer-events: auto;
}
input[type="range"]:active::-webkit-slider-thumb{
    background-color: #ffffff;
    border: 3px solid #e60023;
}
.values{
    background-color: #e60023;
    width: 32%;
    position: relative;
    margin: auto;
    padding: 5px 0 3px;
    border-radius: 5px;
    text-align: center;
    font-weight: 500;
    font-size: 9px;
    color: #ffffff;
}
.values:before{
    content: "";
    position: absolute;
    height: 0;
    width: 0;
    border-top: 10px solid #e60023;
    border-left: 10px solid transparent;
    border-right: 10px solid transparent;
    margin: auto;
    bottom: -10px;
    left: 0;
    right: 0;
}
.wrapper_price_slider > .container_price_slider {
    display: inline-block;
    height: 0px;
    position: relative;
    /* border: 1px solid red; */
    height: 25px;
    width: 98%;
    overflow: hidden;
    padding: 0px !important;
}
.wrapper_price_slider input:focus {
    box-shadow: none !important;
    border: 0px solid #66686C !important;
}

span.ui-slider-handle.ui-corner-all.ui-state-default {
    border: unset;
    border-radius: 10px;
    background: #e60023;
    padding: 8px;
    top: -8px;
}
div#price-slider-container {
    height: 4px;
    background: linear-gradient(to right, rgb(218, 218, 229) 2995%, rgb(230, 0, 35) 2995%, rgb(230, 0, 35) 4.10886e+06%, rgb(218, 218, 229) 4.10886e+06%);
}
.ui-slider-range.ui-corner-all.ui-widget-header {
    background: linear-gradient(to right, rgb(218, 218, 229) 2995%, rgb(230, 0, 35) 2995%, rgb(230, 0, 35) 4.10886e+06%, rgb(218, 218, 229) 4.10886e+06%);
}
#layered-filter-block.collapsible-filters .filter-options-item .filter-options-content{
    overflow: hidden;
}
.ui-slider-range.ui-corner-all.ui-widget-header {
    background: #e60023;
    border-color: #e60023;
    height: 4px;
}
.ajax-layered-navigation-slider .ui-slider-horizontal .ui-slider-range{
    top: -1px !important;
}
.price-slider-values button#price-filter-button {
    padding: 5px 10px;
}

@media only screen and (max-width: 768px) {
    .price-slider-values input[type=text] {
        width: 80px !important;
    }
}
    </style>

<div class="price-filter-container">
    <div class="ajax-layered-navigation-slider">
        <div id="price-slider-container"></div>
        <div class="hide">
            <div id="min_val_price_slider"><?= $min_price; ?></div>
            <div id="max_val_price_slider"><?= $max_price; ?></div>
        </div>
    </div>
    <div class="price-slider-values">
        <span class="filter-currency"><?= $filter->getCurrencySymbol(); ?></span>
        <input type="text" <?= ( $hide_input ) ? ' ' : ""; ?> 
               name="price_minimum" 
               id="price_minimum" 
               value="<?= $min_price; ?>"/>
