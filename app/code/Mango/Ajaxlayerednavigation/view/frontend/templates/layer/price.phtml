<script type="text/javascript">
require(['jquery'], function ($) {
    $(document).ready(function () {
        let valueChanged = false;

        $('.price-slider-values .first_price > input, .price-slider-values .second_price > input').on('focus', function () {
            $('.price-slider-values > .search.button').removeClass('hide');
        });

        $('.price-slider-values .first_price > input, .price-slider-values .second_price > input').on('input', function () {
            valueChanged = true;
            $('.price-slider-values > .search.button').removeClass('hide');
        });

        $('.price-slider-values .first_price > input, .price-slider-values .second_price > input').on('blur', function () {
            setTimeout(function () {
                if (!valueChanged && !$('.price-slider-values .first_price > input').is(':focus') && 
                    !$('.price-slider-values .second_price > input').is(':focus')) {
                    $('.price-slider-values > .search.button').addClass('hide');
                }
            }, 200);
        });

        $('#price-filter-button').on('click', function () {
            valueChanged = false;
            $('.price-slider-values > .search.button').addClass('hide');
        });
    });
});
</script>
