<tr>
    <td class="label">
        <label>
            <span><?= /* @noEscape */ __('Installation guide') ?></span>
        </label>
    </td>
    <td class="value <?= /* @noEscape */ $block->setupGuideClassName; ?>">
        <h4 class="title"><?= /* @noEscape */ __('Install the Stripe REST SDK') ?></h4>
        <ul class="stripe-installation-skd-guide">
            <li>
                <?= /* @noEscape */ __('If you can access to your server via SSH:'); ?><br/>
                <div class="guide-content">
                    <?= /* @noEscape */ __(
                        'Use cd command to your Magento root folder. After that, enter the command:'
                    ); ?>
                    <br/>
                    <b>composer require "stripe/stripe-php:*"</b>
                    <br/>
                    <a href="https://stripe.com/docs/libraries"><?= /* @noEscape */ __('View detail') ?></a>
                </div>
            </li>
        </ul>
        <h4 class="title"><?= /* @noEscape */ __('Test the API connection') ?></h4>
        <ul class="stripe-installation-test">
            <li>
                <?= /* @noEscape */ __(
                    'After install the SDK and save all the API information, '
                    . 'you can click the button below to test the connection'
                ); ?>
            </li>
            <li>
                <button type="button"
                        id="<?= /* @noEscape */ $block->testButtonId; ?>">
                    <?= /* @noEscape */ __('Test API connection'); ?>
                </button>
            </li>
            <li>
                <div id="<?= /* @noEscape */ $block->testResponseId; ?>">
                    <div class="loader hide"></div>
                    <div class="success hide"><?= /* @noEscape */ __('Success'); ?></div>
                    <div class="error hide"><?= /* @noEscape */ __('Error'); ?></div>
                </div>
            </li>
        </ul>
    </td>
    <td></td>
</tr>
<script>
    require([
        'jquery'
    ], function (jQuery) {
        var testAPIUrl = '<?= /* @noEscape */ $block->getTestApiUrl();?>';
        jQuery(document).ready(function () {
            jQuery('#<?= /* @noEscape */ $block->testButtonId; ?>').click(function () {
                jQuery("#<?= /* @noEscape */ $block->testResponseId; ?> .loader").removeClass('hide');
                jQuery.ajax({
                    method: 'get',
                    url: testAPIUrl
                }).complete(function (result, status) {
                    jQuery("#<?= /* @noEscape */ $block->testResponseId; ?> .loader").addClass('hide');
                    if (status !== 'success') {
                        return alert('<?= /* @noEscape */ __('Please check your network connection');?>');
                    }

                    var response = {};
                    if (result && result.responseText != 'undefined' && result.responseText) {
                        response = JSON.parse(result.responseText);
                    } else {
                        response = result;
                    }
                    if (!response.success) {
                        if (response && response.message) {
                            alert(response.message);
                        }
                        jQuery("#<?= /* @noEscape */ $block->testResponseId; ?> .success").addClass('hide');
                        jQuery("#<?= /* @noEscape */ $block->testResponseId; ?> .error").removeClass('hide');
                        return;
                    }

                    jQuery("#<?= /* @noEscape */ $block->testResponseId; ?> .success").removeClass('hide');
                    jQuery("#<?= /* @noEscape */ $block->testResponseId; ?> .error").addClass('hide');
                });
            });
        });
    });
</script>
<style type="text/css">
    .hide {
        display: none;
    }

    .<?= /* @noEscape */ $block->setupGuideClassName; ?> h4.title {
