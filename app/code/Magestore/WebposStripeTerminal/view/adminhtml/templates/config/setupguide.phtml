    .<?= /* @noEscape */ $block->setupGuideClassName; ?> ol li {
        list-style: inherit;
    }

    .<?= /* @noEscape */ $block->setupGuideClassName; ?> li .guide-content {
        padding-left: 20px;
    }

    .<?= /* @noEscape */ $block->setupGuideClassName; ?> .loader {
        border: 6px solid #f3f3f3;
        border-top: 6px solid #3498db;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        animation: spin 1.5s linear infinite;
    }

    @keyframes spin {
        0% {
            transform: rotate(0deg);
        }
        100% {
            transform: rotate(360deg);
        }
    }
</style>
