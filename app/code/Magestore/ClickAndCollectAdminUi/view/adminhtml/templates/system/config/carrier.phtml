<?php $scriptString = <<<script
require([
    'jquery'
], function ($) {
    'use strict';
    $(document).ready(function() {
        var selectClickCollect = $("#carriers_clickandcollect_active");
        var selectInStore = $("#carriers_instore_active");
        selectClickCollect.on("change", function() {
            if (1 == this.value  && 1 == selectInStore.find(":selected").val()) {
                selectInStore.val(0);
            }
        });
        selectInStore.on("change", function() {
            if (1 == this.value  && 1 == selectClickCollect.find(":selected").val()) {
                selectClickCollect.val(0);
            }
        });
    });
});
script;
?>
<?= /* @noEscape */ class_exists(\Magento\Framework\View\Helper\SecureHtmlRenderer::class) ?
    $secureRenderer->renderTag('script', [], $scriptString, false)
    : '<script>' . $scriptString . '</script>'
?>
