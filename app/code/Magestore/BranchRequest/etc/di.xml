<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="os_branchrequest_listing_data_source" xsi:type="string">
                    Magestore\BranchRequest\Model\ResourceModel\InventoryTransfer\Grid\Collection
                </item>
                <item name="os_branchrequest_shortfall_data_source" xsi:type="string">
                    Magestore\BranchRequest\Model\ResourceModel\InventoryTransfer\Grid\ShortFall
                </item>
            </argument>
        </arguments>
    </type>

    <preference for="Magestore\BranchRequest\Api\Data\InventoryTransfer\InventoryTransferInterface"
                type="Magestore\BranchRequest\Model\InventoryTransfer"/>
    <preference for="Magestore\BranchRequest\Api\Data\InventoryTransfer\InventoryTransferProductInterface"
                type="Magestore\BranchRequest\Model\InventoryTransfer\InventoryTransferProduct"/>

    <preference for="Magestore\BranchRequest\Api\TransferManagementInterface"
                type="Magestore\BranchRequest\Model\InventoryTransfer\TransferManagement"/>

    <preference for="Magestore\BranchRequest\Api\Data\InventoryTransfer\ReceiveInterface"
                type="Magestore\BranchRequest\Model\InventoryTransfer\Receive"/>
    <preference for="Magestore\BranchRequest\Api\Data\InventoryTransfer\ReceiveProductInterface"
                type="Magestore\BranchRequest\Model\InventoryTransfer\ReceiveProduct"/>

    <preference for="Magestore\BranchRequest\Api\MultiSourceInventory\SourceManagementInterface"
                type="Magestore\BranchRequest\Model\MultiSourceInventory\SourceManagement"/>

    <!-- Inventory movement -->
    <type name="Magestore\InventoryMovementApi\Model\ActionTypes">
        <arguments>
            <argument name="data" xsi:type="array">
                <item name="magestore_branchrequest_delivery" xsi:type="string">magestore_branchrequest_delivery</item>
                <item name="magestore_branchrequest_receive" xsi:type="string">magestore_branchrequest_receive</item>
            </argument>
        </arguments>
    </type>
    <type name="Magestore\InventoryMovementApi\Model\MetadataObjectTypes">
        <arguments>
            <argument name="data" xsi:type="array">
                <item name="magestore_branchrequest_delivery" xsi:type="array">
                    <item name="viewUrlPath" xsi:type="string">branchrequest/inventorytransfer_delivery/view</item>
                    <item name="urlEntityParamName" xsi:type="string">id</item>
                </item>
                <item name="magestore_branchrequest_receive" xsi:type="array">
                    <item name="viewUrlPath" xsi:type="string">branchrequest/inventorytransfer_receive/view</item>
                    <item name="urlEntityParamName" xsi:type="string">id</item>
                </item>
            </argument>
        </arguments>
    </type>
    <!-- End: Inventory movement -->
    <preference for="Magestore\BranchRequest\Api\Data\InventoryTransfer\DeliveryInterface"
                type="Magestore\BranchRequest\Model\InventoryTransfer\Delivery"/>
    <preference for="Magestore\BranchRequest\Api\Data\InventoryTransfer\DeliveryProductInterface"
                type="Magestore\BranchRequest\Model\InventoryTransfer\DeliveryProduct"/>
</config>
