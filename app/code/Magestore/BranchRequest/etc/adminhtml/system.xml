<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="inventory_movement">
            <group id="branch_requests" translate="label comment" sortOrder="50" type="text" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Branch Requests</label>
                <field id="notifier_sender" translate="label comment" type="select" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Notifier Sender</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Identity</source_model>
                    <comment></comment>
                </field>
                <field id="notifier_emails" translate="label comment" sortOrder="10" type="text" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Default Notifier Emails</label>
                    <validate>validate-emails</validate>
                    <comment>Comma-separated.</comment>
                </field>
                <field id="notifier_email_template" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Branch Request Email Template</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Template</source_model>
                </field>
                <field id="default_sending_source" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Default Sending Source</label>
                    <source_model>Magestore\BranchRequest\Model\Source\Adminhtml\Source</source_model>
                </field>
            </group>
        </section>
    </system>
</config>