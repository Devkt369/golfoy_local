<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="admin-1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Magestore_BranchRequest::css/timeline.css"/>
    </head>
    <body>
        <referenceContainer name="page.main.actions">
            <block class="Magestore\BranchRequest\Block\Adminhtml\InventoryTransfer\Edit\Steps\Timeline" name="variation-steps-wizard">
                <arguments>
                    <argument name="config" xsi:type="array">
                        <item name="form" xsi:type="string">os_branchrequest_form.os_branchrequest_form</item>
                    </argument>
                </arguments>
                <block class="Magestore\BranchRequest\Block\Adminhtml\InventoryTransfer\Edit\Steps\StatusNew" name="new">
                    <arguments>
                        <argument name="config" xsi:type="array">
                            <item name="form" xsi:type="string">os_branchrequest_form.os_branchrequest_form</item>
                        </argument>
                    </arguments>
                </block>
                <block class="Magestore\BranchRequest\Block\Adminhtml\InventoryTransfer\Edit\Steps\StatusWait" name="wait">
                    <arguments>
                        <argument name="config" xsi:type="array">
                            <item name="form" xsi:type="string">os_branchrequest_form.os_branchrequest_form</item>
                        </argument>
                    </arguments>
                </block>
                <block class="Magestore\BranchRequest\Block\Adminhtml\InventoryTransfer\Edit\Steps\StatusApproved" name="approved">
                    <arguments>
                        <argument name="config" xsi:type="array">
                            <item name="form" xsi:type="string">os_branchrequest_form.os_branchrequest_form</item>
                        </argument>
                    </arguments>
                </block>
                <block class="Magestore\BranchRequest\Block\Adminhtml\InventoryTransfer\Edit\Steps\StatusProcessing" name="processing">
                    <arguments>
                        <argument name="config" xsi:type="array">
                            <item name="form" xsi:type="string">os_branchrequest_form.os_branchrequest_form</item>
                        </argument>
                    </arguments>
                </block>
                <block class="Magestore\BranchRequest\Block\Adminhtml\InventoryTransfer\Edit\Steps\StatusCompleted" name="completed">
                    <arguments>
                        <argument name="config" xsi:type="array">
                            <item name="form" xsi:type="string">os_branchrequest_form.os_branchrequest_form</item>
                        </argument>
                    </arguments>
                </block>
                <block class="Magestore\BranchRequest\Block\Adminhtml\InventoryTransfer\Edit\Steps\StatusCanceled" name="canceled">
                    <arguments>
                        <argument name="config" xsi:type="array">
                            <item name="form" xsi:type="string">os_branchrequest_form.os_branchrequest_form</item>
                        </argument>
                    </arguments>
                </block>
            </block>
        </referenceContainer>
    </body>
</page>
