<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <!-- Webpos Performance -->
    <route url="/V1/webpos/performance" method="POST">
        <service class="Magestore\WebposPerformanceApi\Api\PerformanceTrackRepositoryInterface" method="save"/>
        <resources>
            <resource ref="Magestore_Webpos::manage_pos" />
        </resources>
    </route>
</routes>
