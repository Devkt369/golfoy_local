<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">ms_inventorymovement_listing.ms_inventorymovement_listing_data_source</item>
            <item name="deps" xsi:type="string">ms_inventorymovement_listing.ms_inventorymovement_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>inventorymovement_columns</spinner>
        <deps>
            <dep>ms_inventorymovement_listing.ms_inventorymovement_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="ms_inventorymovement_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">inventory_movement_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Magestore_InventoryMovementAdminUi::inventory_movement</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="ms_inventorymovement_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>inventory_movement_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <exportButton name="export_button"/>
        <filters name="listing_filters">
            <filterSelect name="source_code"
                          provider="${ $.parentName }"
                          component="Magento_Ui/js/form/element/ui-select"
                          template="ui/grid/filters/elements/ui-select">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="filterOptions" xsi:type="boolean">true</item>
                        <item name="multiple" xsi:type="boolean">false</item>
                        <item name="showCheckbox" xsi:type="boolean">false</item>
                    </item>
                </argument>
                <settings>
                    <options class="Magestore\InventoryMovementAdminUi\Model\Source\Adminhtml\Source"/>
                    <label translate="true">Source</label>
                    <dataScope>source_code</dataScope>
                </settings>
            </filterSelect>
            <filterSelect name="action_type"
                          provider="${ $.parentName }"
                          component="Magento_Ui/js/form/element/ui-select"
                          template="ui/grid/filters/elements/ui-select">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="filterOptions" xsi:type="boolean">true</item>
                        <item name="multiple" xsi:type="boolean">false</item>
                        <item name="showCheckbox" xsi:type="boolean">false</item>
                    </item>
                </argument>
                <settings>
                    <options class="Magestore\InventoryMovementAdminUi\Model\Source\Adminhtml\ActionType"/>
                    <label translate="true">Action Type</label>
                    <dataScope>action_type</dataScope>
                </settings>
            </filterSelect>
            <filterSelect name="is_in_stock"
                          provider="${ $.parentName }"
                          component="Magento_Ui/js/form/element/ui-select"
                          template="ui/grid/filters/elements/ui-select">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="filterOptions" xsi:type="boolean">false</item>
                        <item name="multiple" xsi:type="boolean">false</item>
                        <item name="showCheckbox" xsi:type="boolean">false</item>
                    </item>
                </argument>
                <settings>
                    <options class="Magento\InventoryImportExport\Model\Export\Source\StockStatus"/>
                    <label translate="true">Stock Status</label>
                    <dataScope>is_in_stock</dataScope>
                </settings>
            </filterSelect>
            <filterSelect name="status"
                          provider="${ $.parentName }"
                          component="Magento_Ui/js/form/element/ui-select"
                          template="ui/grid/filters/elements/ui-select">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="filterOptions" xsi:type="boolean">false</item>
                        <item name="multiple" xsi:type="boolean">false</item>
                        <item name="showCheckbox" xsi:type="boolean">false</item>
                    </item>
                </argument>
                <settings>
                    <options class="Magestore\InventoryMovementAdminUi\Model\Source\Adminhtml\Status"/>
                    <label translate="true">Status</label>
                    <dataScope>status</dataScope>
                </settings>
            </filterSelect>
        </filters>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="inventorymovement_columns">
        <selectionsColumn name="ids" sortOrder="1">
            <settings>
                <indexField>inventory_movement_id</indexField>
                <preserveSelectionsOnFilter>true</preserveSelectionsOnFilter>
                <visible>false</visible>
            </settings>
        </selectionsColumn>
        <column name="created_at"
                class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date"
                sortOrder="10">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Date</label>
                <sortable>true</sortable>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="status"
                class="Magestore\InventoryMovementAdminUi\Ui\Component\Listing\Columns\Status"
                sortOrder="20">
            <settings>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <filter>status</filter>
                <label translate="true">Status</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="product_sku"
                class="Magestore\InventoryMovementAdminUi\Ui\Component\Listing\Columns\ProductSku"
                sortOrder="30">
            <settings>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <filter>text</filter>
                <label translate="true">Product SKU</label>
                <sortable>true</sortable>
            </settings>
        </column>
        <column name="product_name" sortOrder="40">
            <settings>
                <filter>text</filter>
                <label translate="true">Product Name</label>
                <sortable>true</sortable>
            </settings>
        </column>
        <column name="source_code"
                component="Magento_Ui/js/grid/columns/select"
                sortOrder="50">
            <settings>
                <options class="Magestore\InventoryMovementAdminUi\Model\Source\Adminhtml\Source"/>
                <filter>source_code</filter>
                <dataType>select</dataType>
                <label translate="true">Source</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="old_qty"
                class="Magestore\InventoryMovementAdminUi\Ui\Component\Listing\Columns\Quantity"
                sortOrder="60">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Old Qty</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="change_qty"
                class="Magestore\InventoryMovementAdminUi\Ui\Component\Listing\Columns\Quantity"
                sortOrder="70">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Change Qty</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="new_qty"
                class="Magestore\InventoryMovementAdminUi\Ui\Component\Listing\Columns\Quantity"
                sortOrder="80">
            <settings>
                <filter>textRange</filter>
                <label translate="true">New Qty</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="is_in_stock" component="Magento_Ui/js/grid/columns/select" sortOrder="90">
            <settings>
                <options class="Magento\InventoryImportExport\Model\Export\Source\StockStatus"/>
                <filter>is_in_stock</filter>
                <dataType>select</dataType>
                <label translate="true">Stock Status</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="action_type"
                component="Magento_Ui/js/grid/columns/select"
                sortOrder="100">
            <settings>
                <options class="Magestore\InventoryMovementAdminUi\Model\Source\Adminhtml\ActionType"/>
                <filter>action_type</filter>
                <dataType>select</dataType>
                <label translate="true">Action Type</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="note"
                class="Magestore\InventoryMovementAdminUi\Ui\Component\Listing\Columns\Note"
                sortOrder="110">
            <settings>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <filter>text</filter>
                <label translate="true">Action Detail</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="user_name"
                class="Magestore\InventoryMovementAdminUi\Ui\Component\Listing\Columns\User"
                sortOrder="120">
            <settings>
                <filter>text</filter>
                <label translate="true">User</label>
                <sortable>false</sortable>
            </settings>
        </column>
    </columns>
</listing>