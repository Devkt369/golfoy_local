    latitude: SortEnum @doc(description: "Sort by the search latitude.")
    longitude: SortEnum @doc(description: "Sort by the search longitude.")
    schedule_id: SortEnum @doc(description: "Sort by the search schedule_id.")
}

type Locations @doc(description: "Locations") {
    items: [Location] @doc(description: "An array of locations that match the specified search criteria.")
    page_info: SearchResultPageInfo @doc(description: "An object that includes the page_info and currentPage values specified in the query.")
    total_count: Int @doc(description: "The number of locations.")
}

interface ProductInterface {
    stock_info: ProductStockInfo @doc(description: "Stock Info of the product") @resolver(class: "Magestore\\ClickAndCollectGraphQl\\Model\\Resolver\\Stock\\StockProductProvider")
}

type ProductStockInfo {
    item_id: Int @doc(description: "Item id")
    product_id: Int @doc(description: "Product id")
    stock_id: Int @doc(description: "Stock id")
    qty: Float @doc(description: "Stock Qty")
    is_qty_decimal: Boolean @doc(description: "Is Qty Decimal")
    show_default_notification_message: Boolean @doc(description: "Show Default Notification Message")
    use_config_min_qty: Boolean @doc(description: "Use Config Min Qty")
    min_qty: Float @doc(description: "Min Qty")
    use_config_min_sale_qty: Boolean @doc(description: "use Config Min Sale Qty")
    min_sale_qty: Float @doc(description: "Min Sale Qty")
    use_config_max_sale_qty: Boolean @doc(description: "Use Config Max Sale Qty")
    max_sale_qty: Float @doc(description: "Max Sale Qty")
    use_config_backorders: Boolean @doc(description: "Use Config BackOrder")
    backorders: Int @doc(description: "BackOrder")
    use_config_notify_stock_qty: Boolean @doc(description: "Use Config Notify Stock Qty")
    notify_stock_qty: Float @doc(description: "Notify Stock Qty")
    use_config_qty_increments: Boolean @doc(description: "Use Config Qty Increments")
    qty_increments: Float @doc(description: "Qty Increments")
    use_config_enable_qty_inc: Boolean @doc(description: "Use Config Enable Qty Inc")
    enable_qty_increments: Boolean @doc(description: "Enable Qty Increments")
    use_config_manage_stock: Boolean @doc(description: "Use Config Manage Stock")
    manage_stock: Boolean @doc(description: "Manage Stock")
    is_in_stock: Boolean @doc(description: "Is in Stock")
    low_stock_date: String @doc(description: "Low Stock Date")
    is_decimal_divided: Boolean @doc(description: "Is decimal divided")
    stock_status_changed_auto: Int @doc(description: "Stock Status Changed Auto")
}

input PickupPackageInput @doc(description:"Input of mutation saveOrderPickupPackage") {
    package_id: Int @doc(description: "ID of package.")
    order_id: Int! @doc(description: "ID of order which package is belong to.")
    status: String @doc(description: "Status of package.")
    location_id: Int! @doc(description: "Id of location creating package.")
}

input PickupPackageActionInput @doc(description:"Input of mutation processOrderPickupPackage") {
    package_id: Int! @doc(description: "ID of package.")
    location_id: Int! @doc(description: "Id of location creating package.")
}

type PickupPackageOutput {
    package: PickupPackage!
}

type PickupPackage @doc(description:"Type PickupPackage includes fields of object ClickAndCollectOrderPickupPackage") {
    package_id: Int @doc(description: "ID of package.")
    order_id: Int @doc(description: "ID of order which package is belong to.")
    location_id: Int @doc(description: "ID of Location which package is belong to.")
    status: String @doc(description: "Status of package.")
}

type ProductStore @doc(description: "Product's store infomation") {
    location: LocationWithDistance! @doc(description: "Location information with distance.")
    saleable_qty: Float @doc(description: "Product's saleable quantity")
    stock_status: ProductStockStatus @doc(description: "Stock status of the product") @resolver(class: "Magestore\\ClickAndCollectGraphQl\\Model\\Resolver\\Stock\\ProductStockStatusType")
}

type ProductInfoOnStoresOutput @doc(description: "Product information on stores output") {
    items: [ProductStore] @doc(description: "An array of product's stores.")
}

type TotalCountSummaryOutput {
    total: Int!
}

input ReadyPickDateInput @doc(description:"Input of mutation save order ready pick date") {
    order_id: Int! @doc(description: "Order's ID")
    ready_pick_date: String! @doc(description: "Ready pick date value")
}

type ReadyPickDateOutput {
    result: Boolean!
}

