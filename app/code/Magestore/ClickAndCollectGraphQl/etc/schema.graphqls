    use_config_receipt_header: SortEnum @doc(description: "Sort by the search use_config_receipt_header.")
    receipt_header: SortEnum @doc(description: "Sort by the search receipt_header.")
    use_config_receipt_footer: SortEnum @doc(description: "Sort by the search use_config_receipt_footer.")
    receipt_footer: SortEnum @doc(description: "Sort by the search receipt_footer.")
    store_id: SortEnum @doc(description: "Sort by the search store_id.")
