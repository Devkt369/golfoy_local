}


type StoreConfig {
    magestore_click_and_collect_general_allow_to_choose_collect_data_and_time: String @doc(description: "Click and collect allow to choose date and time")
    magestore_click_and_collect_general_search_radius: String @doc(description: "Click and collect search radius")
