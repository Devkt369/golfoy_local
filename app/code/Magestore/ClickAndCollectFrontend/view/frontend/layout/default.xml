<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="header.links">
            <block class="Magento\Framework\View\Element\Html\Link\Current"
                   name="clickandcollect-stores" after="register-link-new"
                   ifconfig="click_and_collect/general/show_store_list_on_frontend">
                <arguments>
                    <argument name="label" xsi:type="string" translate="true">Stores</argument>
                    <argument name="path" xsi:type="string">clickandcollect/store/index</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
