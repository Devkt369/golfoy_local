                            <div class="container-fluid day-container">
                                <div class="col-xs-3"><%- data.scheduleInfo[i].label %></div>
                                <div class="col-xs-9"><%- data.scheduleInfo[i].workingHour %></div>
                            </div>
                        </div>
                        <% } %>
                    </div>
                </div>
                <% } %>
                <p>
                    <span class="btn-link more-info">
