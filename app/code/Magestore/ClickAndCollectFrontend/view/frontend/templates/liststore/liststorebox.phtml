                <span class="glyphicon glyphicon-menu-down"></span>
            </div>
        </div>
    </li>
</script>

<script id="pagination-template" class="store-template" type="text/x-magento-template">
    <ul class="pagination">
        <li data-first-page="1"
            class="page-item <% if (data.curPage == 1) { %>disabled<% } %>"
        ><span>&laquo;</span></li>
        <% if (data.curPage > 1) { %>
            <li data-page-id="<%- data.curPage - 1 %>"  class="page-item"><a><?= /* @noEscape */ __('Prev') ?></a></li>
        <% } %>
        <% for (var page = data.minPage; page <= data.maxPage; ++page) { %>
            <li class="page-item <% if (page == data.curPage) { %>active<% } %>"
                data-page-id="<%- page %>"
            ><a><%- page %></a></li>
        <% } %>
        <% if (data.curPage < data.totalPage) { %>
            <li data-page-id="<%- data.curPage + 1 %>" class="page-item"><a><?= /* @noEscape */ __('Next') ?></a></li>
        <% } %>
        <li data-last-page="<%- data.totalPage %>"
            class="page-item <% if (data.curPage == data.totalPage) { %>disabled<% } %>"
        ><a>&raquo;</a></li>
    </ul>
</script>