type MsApplyGiftCodeToCartOutput {
    cart: Cart! @doc(description: "The customer cart after gift code are applied")
    notice_messages: [String] @doc(description: "Notice message when applied gift code")
}

type MsRemoveGiftCodeToCartOutput {
    cart: Cart! @doc(description: "The customer cart after gift code are removed")
    notice_messages: [String] @doc(description: "Notice message when removed gift code")
}

type CartPrices {
    ms_gift_voucher_info: MagestoreGiftVoucherInfo @doc(description: "Gift voucher information in quote") @resolver(class: "Magestore\\GiftvoucherGraphQl\\Model\\Resolver\\GetGiftVoucherInfoInQuote")
}

type MagestoreGiftVoucherInfo {
