    giftcard_template_id: Int @doc(description: "Giftcard Template Id")
    giftcard_template_image: String @doc(description: "Giftcard Template Image")
    timezone_to_send: String @doc(description: "Timezone To Send")
    day_store: String @doc(description: "Day Store")
    used: Int @doc(description: "used")
    set_id: Int @doc(description: "Set Id")
}

type Mutation {
    addGiftCardProductsToCart(input: AddGiftCardProductsToCartInput): AddGiftCardProductsToCardOutput @resolver(class: "Magestore\\GiftvoucherGraphQl\\Model\\Resolver\\AddGiftCardProductsToCart")
    uploadGiftCardTemplateImage(
        base64_encoded_data: String! @doc(description: "The image in base64 format.")
        name: String! @doc(description: "The file name of the image.")
        type: String! @doc(description: "The MIME type of the file, such as image/png.")
    ): GiftCardTemplateImage @resolver(class: "Magestore\\GiftvoucherGraphQl\\Model\\Resolver\\UploadGiftCardTemplateImage")
    msApplyGiftCodeToCart(cart_id: ID!, gift_code: String!, amount_applied: Float): MsApplyGiftCodeToCartOutput @resolver (class: "\\Magestore\\GiftvoucherGraphQl\\Model\\Resolver\\ApplyGiftCode") @doc(description: "Apply gift code into cart.")
    msRemoveGiftCodeFromCart(cart_id: ID!, gift_code: String, is_remove_all: Boolean): MsRemoveGiftCodeToCartOutput @resolver (class: "\\Magestore\\GiftvoucherGraphQl\\Model\\Resolver\\RemoveGiftCode") @doc(description: "Remove gift code into cart.")
}

type GiftCardTemplateImage {
    error_message: String @doc(description: "Error Message")
    url: String @doc(description: "Image Url")
}

input AddGiftCardProductsToCartInput {
    cart_id: String!
    cart_items: [GiftCardProductCartItemInput!]!
}

input GiftCardProductCartItemInput {
    data: CartItemInput!
    customizable_options:[CustomizableOptionInput!]
}

input CartItemInput {
    giftcard_options: GiftCardOptions @doc(description: "Gift Card Option")
}

input GiftCardOptions {
    recipient_name: String @doc(description: "Recipient Name")
    recipient_email: String @doc(description: "Recipient Email")
    message: String @doc(description: "Message")
    day_to_send: String @doc(description: "Day to send")
    timezone_to_send: String @doc(description: "Timezone to send")
    recipient_address: String @doc(description: "Recipient Address")
    notify_success: Int @doc(description: "Notify success or not")
    send_friend: Int @doc(description: "Send friend")
    giftcard_template_id: Int @doc(description: "Gift card template id")
    customer_name: String @doc(description: "Customer name")
    giftcard_template_image: String @doc(description: "Gift card template image")
    giftcard_use_custom_image: Int @doc(description: "Gift card use custom image")
    amount: Float @doc(description: "Amount")
    giftcard_amount: Float @doc(description: "Gift card amount")
}

type AddGiftCardProductsToCardOutput {
    cart: Cart!
}

type GiftCardCartItem implements CartItemInterface @doc(description: "Gift Card Cart Item") {
    customizable_options: [SelectedCustomizableOption] @resolver(class: "Magento\\QuoteGraphQl\\Model\\Resolver\\CustomizableOptions")
    giftcard_options: GiftCardOptionsOutput @doc(description: "Gift card options output") @resolver(class: "Magestore\\GiftvoucherGraphQl\\Model\\Resolver\\GiftCardOptions")
}

type GiftCardOptionsOutput {
    recipient_name: String @doc(description: "Recipient Name")
    recipient_email: String @doc(description: "Recipient Email")
    message: String @doc(description: "Message")
    day_to_send: String @doc(description: "Day to send")
    timezone_to_send: String @doc(description: "Timezone to send")
    recipient_address: String @doc(description: "Recipient Address")
    notify_success: Int @doc(description: "Notify success or not")
    send_friend: Int @doc(description: "Send friend")
    giftcard_template_id: Int @doc(description: "Gift card template id")
    giftcard_template: GiftCardTemplate @doc(description: "Gift card template")  @resolver(class: "Magestore\\GiftvoucherGraphQl\\Model\\Resolver\\GiftCardOptions\\GiftCardTemplate")
    customer_name: String @doc(description: "Customer name")
    giftcard_template_image: String @doc(description: "Gift card template image")
    giftcard_use_custom_image: Int @doc(description: "Gift card use custom image")
    amount: Float @doc(description: "Amount")
    giftcard_amount: Float @doc(description: "Gift card amount")
