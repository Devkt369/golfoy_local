    currency: String @doc(description: "Currency")
    status: Int @doc(description: "Status")
    expired_at: String @doc(description: "Expired At")
    customer_id: Int @doc(description: "Customer Id")
    customer_name: String @doc(description: "Customer Name")
    recipient_name: String @doc(description: "Recipient Name")
    recipient_email: String @doc(description: "Recipient Email")
    recipient_address: String @doc(description: "Recipient Address")
    message: String @doc(description: "Message")
    store_id: Int @doc(description: "Store Id")
    day_to_send: String @doc(description: "Day to send")
    is_sent: String @doc(description: "Is Sent")
    shipped_to_customer: Int @doc(description: "Shipped To customer")
    created_form: String @doc(description: "Created Form")
    template_id: Int @doc(description: "Template Id")
    description: String @doc(description: "Description")
    giftvoucher_comments: String @doc(description: "Giftvoucher Comments")
    email_sender: Int @doc(description: "Email sender")
