    giftvoucher_shipping_hidden_tax_amount: Float @doc(description: "Gift voucher shipping hidden tax amount")
    base_giftvoucher_discount_for_shipping: Float @doc(description: "Base gift voucher discount for shipping")
    giftvoucher_discount_for_shipping: Float @doc(description: "Gift voucher discount for shipping")
    giftvoucher_base_hidden_tax_amount: Float @doc(description: "Base gift voucher hidden tax")
    giftvoucher_hidden_tax_amount: Float @doc(description: "Gift voucher hidden tax")
    base_gift_voucher_discount: Float @doc(description: "Base gift voucher discount")
    gift_voucher_discount: Float @doc(description: "Gift voucher discount")
    gift_voucher_gift_codes: [String] @doc(description: "Gift code list used in quote")
    giftcodes_applied_discount: [GiftCodeAppliedAmount] @doc(description: "Gift code used and discount in quote")
    giftcodes_applied_discount_for_shipping: [GiftCodeAppliedAmount] @doc(description: "Gift codes applied for shipping")
}

type GiftCodeAppliedAmount {
