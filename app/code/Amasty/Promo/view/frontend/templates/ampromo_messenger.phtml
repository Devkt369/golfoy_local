/**
 * @var $block Magento\Backend\Block\Template
 * @var $viewModel Amasty\Promo\ViewModel\Checkout\Messenger
 * @var $escaper Magento\Framework\Escaper
 * @var $secureRenderer Magento\Framework\View\Helper\SecureHtmlRenderer
 */
$viewModel = $block->getViewModel();
$errorMessages = /* @noEscape */ $viewModel->getErrorMessages();
?>
<?php if ($viewModel->isShowErrorMessage()): ?>
    <?php
    $messengerScript = <<<SCRIPT
        require(['uiRegistry'], function (registry) {
                registry.get('checkout.errors', function (errors) {
                    errors.messageContainer.errorMessages({$errorMessages});
                });
            });
    SCRIPT;
    ?>
    <?= /* @noEscape */ $secureRenderer->renderTag('script', [], $messengerScript, false) ?>
<?php endif; ?>
