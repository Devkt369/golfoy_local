<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <fastsearch>
            <general>
                <enabled>1</enabled>
                <autocomplete_enabled>1</autocomplete_enabled>
                <autocomplete_limit>8</autocomplete_limit>
                <search_limit>20</search_limit>
                <results_loading_mode>pagination</results_loading_mode>
                <min_query_length>2</min_query_length>
                <max_query_length>128</max_query_length>
                <debug_mode>0</debug_mode>
            </general>
            <engine>
                <use_magento_config>1</use_magento_config>
            </engine>
            <filtering>
                <hide_out_of_stock>0</hide_out_of_stock>
                <fuzzy_search>0</fuzzy_search>
            </filtering>
            <indexing>
                <attributes>name,sku,price,special_price,brand,thumbnail,image,small_image</attributes>
            </indexing>
        </fastsearch>
    </default>
</config>
