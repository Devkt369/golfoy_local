<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <!-- Redeclares the existing ArtM top-level resource (owned by ArtM_BlogEsg) only to
                     attach a child under it - matches the pattern used by the other ArtM modules. -->
                <resource id="ArtM_BlogEsg::ArtM" title="ArtM" sortOrder="51">
                    <resource id="ArtM_InventoryPlanner::inventory_planner" title="Inventory Planner" sortOrder="10">
                        <resource id="ArtM_InventoryPlanner::sync_data" title="Sync Data" sortOrder="10"/>
                        <resource id="ArtM_InventoryPlanner::settings" title="Settings" sortOrder="20"/>
                        <resource id="ArtM_InventoryPlanner::dashboard" title="Dashboard" sortOrder="30"/>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
