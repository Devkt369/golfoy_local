<script>
    (function () {
        'use strict';

        var panel = document.getElementById('artm_columns_panel');
        if (!panel) {
            return;
        }

        panel.addEventListener('change', function (event) {
            var target = event.target;

            if (target.matches('[data-role="group-toggle"]')) {
                var groupKey = target.getAttribute('data-group');
                var checked = target.checked;
                panel.querySelectorAll('[data-role="column-toggle"][data-group="' + groupKey + '"]').forEach(function (checkbox) {
                    checkbox.checked = checked;
                });
                return;
            }

            if (target.matches('[data-role="column-toggle"]')) {
                var parentGroupKey = target.getAttribute('data-group');
                var siblingCheckboxes = panel.querySelectorAll('[data-role="column-toggle"][data-group="' + parentGroupKey + '"]');
                var master = panel.querySelector('[data-role="group-toggle"][data-group="' + parentGroupKey + '"]');
                if (master) {
                    master.checked = Array.prototype.every.call(siblingCheckboxes, function (checkbox) {
                        return checkbox.checked;
                    });
                }
            }
        });
    })();
</script>
