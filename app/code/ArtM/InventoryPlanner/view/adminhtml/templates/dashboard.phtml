/**
 * Renders an inventory cell's contents - shared markup for both the Captured
 * Inventory and Live Inventory columns, which only differ in where their data
 * comes from ($row['captured_inventory'] vs $row['live_inventory']).
 */
$renderInventoryCell = static function (?array $inventory) use ($escaper): void {
    if ($inventory === null) {
        ?>
        <span class="artm-inventory-empty">&mdash;</span>
        <?php
        return;
    }
    ?>
    <div class="artm-inventory-cell">
        <div class="artm-inventory-dated">
            <?= $escaper->escapeHtml(__('Dated')) ?>: <?= $escaper->escapeHtml($inventory['calculated_at']) ?>
        </div>
        <div class="artm-inventory-line">
            <span class="artm-inventory-label"><?= $escaper->escapeHtml(__('Total In Selected Sources')) ?>:</span>
            <strong><?= $escaper->escapeHtml((string) $inventory['total_selected_source_qty']) ?></strong>
        </div>
        <?php foreach ($inventory['sources'] as $source): ?>
            <div class="artm-inventory-source-line">
                <?= $escaper->escapeHtml($source['name']) ?>: <?= $escaper->escapeHtml((string) $source['qty']) ?>
            </div>
        <?php endforeach; ?>
    </div>
    <?php
};

/**
 * Renders a sortable column header: a plain link that resubmits the page with
 * sort/dir query params - there is no JS framework in this module, so sorting is
 * handled entirely server-side via normal page reloads.
 */
$renderSortableHeader = static function (string $field, $label) use ($block, $escaper): void {
    ?>
    <th>
        <a href="<?= $escaper->escapeUrl($block->getSortUrl($field)) ?>">
            <?= $escaper->escapeHtml((string) $label) ?>
            <?= /* @noEscape */ $block->getSortIndicator($field) ?>
        </a>
    </th>
    <?php
};

/**
 * Renders the Previous/Next + "Showing X to Y out of Z" pagination bar - used both
 * above and below the table.
 */
$renderPagination = static function () use ($block, $escaper, $currentPage, $totalPages, $totalRecords): void {
    ?>
    <div class="artm-pagination">
        <span class="artm-pagination-summary">
            <?= $escaper->escapeHtml(__(
                'Showing %1 to %2 out of %3',
                $block->getRangeStart(),
                $block->getRangeEnd(),
                $totalRecords
            )) ?>
        </span>
        <span class="artm-pagination-links">
            <?php if ($currentPage > 1): ?>
                <a href="<?= $escaper->escapeUrl($block->getPageUrl($currentPage - 1)) ?>"><?= $escaper->escapeHtml(__('&laquo; Previous')) ?></a>
            <?php else: ?>
                <span class="artm-pagination-disabled"><?= $escaper->escapeHtml(__('&laquo; Previous')) ?></span>
            <?php endif; ?>

            <?php if ($currentPage < $totalPages): ?>
                <a href="<?= $escaper->escapeUrl($block->getPageUrl($currentPage + 1)) ?>"><?= $escaper->escapeHtml(__('Next &raquo;')) ?></a>
            <?php else: ?>
                <span class="artm-pagination-disabled"><?= $escaper->escapeHtml(__('Next &raquo;')) ?></span>
            <?php endif; ?>
        </span>
    </div>
    <?php
};

/**
 * Renders every hidden field needed to carry the current weeks/filters/sort/page
 * state through the (separate, POST) Columns form, so saving column visibility
 * doesn't reset the view the admin was looking at.
 */
$renderCarriedStateFields = static function () use ($currentQueryParams, $escaper): void {
    foreach ($currentQueryParams as $name => $value) {
        if (is_array($value)) {
            foreach ($value as $singleValue) {
                ?>
                <input type="hidden" name="<?= $escaper->escapeHtmlAttr($name) ?>[]" value="<?= $escaper->escapeHtmlAttr($singleValue) ?>"/>
                <?php
            }
        } else {
            ?>
            <input type="hidden" name="<?= $escaper->escapeHtmlAttr($name) ?>" value="<?= $escaper->escapeHtmlAttr($value) ?>"/>
            <?php
        }
    }
};
