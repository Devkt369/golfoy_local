    $(document).on('click', '#btn-sync-inventory', function() {
        $('#match-complete-notification').hide();

        if (isSyncing) return;
        if (!currentBatchId) { alert('Please load a batch first'); return; }

        let $btn = $(this);
        let $status = $('#sync-status');
        isSyncing = true;

        $btn.prop('disabled', true).text('Syncing Inventory...');
        $status.text('Updating Magento stock quantities...').css('color', '#f57c00');

            $.ajax({
                url: '<?= $block->getUrl("brandinventory/data/syncInventory") ?>',
                type: 'POST',
                data: {
                    batch_id: currentBatchId,
                    form_key: window.FORM_KEY
                },
                success: function(res) {
                    isSyncing = false;
                    $btn.prop('disabled', false).text('📦 Sync Inventory');

                    if (res.status === 'error') {
                        $status.text('❌ Sync failed: ' + res.message).css('color', '#dc3545');
                        return;
                    }

                    if (res.status === 'info') {
                        $status.text('ℹ️ ' + res.message).css('color', '#ed6c02');
                        loadSavedData();
                        return;
                    }

                    let updated = res.updated || 0;
                    let failed = res.failed || 0;
                    let total = res.total || 0;
                    let failedItems = res.failed_items || [];

                    let msgHtml = '';
                    let statusColor = failed > 0 ? '#ed6c02' : '#28a745';

                    if (failed === 0) {
                        msgHtml = `✅ Inventory synced successfully! <strong>${updated}</strong> of <strong>${total}</strong> SKUs updated.`;
                    } else {
                        // Parse "SKU (reason)" format
                        let failures = [];
                        failedItems.forEach(function(item) {
                            let match = item.match(/^([^\s(]+)\s*\((.+)\)$/);
                            if (match) {
                                failures.push({ sku: match[1], reason: match[2] });
                            } else {
                                failures.push({ sku: item, reason: 'Unknown' });
                            }
                        });

                        // Group by reason
                        let reasonGroups = {};
                        failures.forEach(function(f) {
                            if (!reasonGroups[f.reason]) reasonGroups[f.reason] = [];
                            reasonGroups[f.reason].push(f.sku);
                        });

                        let reasonList = Object.entries(reasonGroups).map(function([reason, skus]) {
                            return `<div style="margin-left:12px;font-size:12px;color:#721c24;">• <strong>${skus.length}</strong> failed: ${escapeHtml(reason)}</div>`;
                        }).join('');

                        msgHtml = `<div>⚠️ Inventory sync partial: <strong style="color:#28a745">${updated}</strong> synced, <strong style="color:#dc3545">${failed}</strong> failed out of <strong>${total}</strong> total.</div>` +
                                `<div style="margin-top:6px;padding:10px;background:#f8d7da;border:1px solid #f5c6cb;border-radius:4px;">` +
                                `<strong style="color:#721c24;">Failure breakdown:</strong>` +
                                reasonList +
                                `</div>`;
                    }

                    $status.html(msgHtml).css('color', statusColor);
                    loadSavedData();

                    if (res.pending === 0) {
                        $('#match-complete-notification').show();
                    }
                },
                error: function() {
                    isSyncing = false;
                    $btn.prop('disabled', false).text('📦 Sync Inventory');
                    $status.text('❌ Error during inventory sync').css('color', '#dc3545');
                }
            });
         });

        // ===============================
        // MANUAL MATCH MODAL
        // ===============================
        $(document).on('click', '#btn-manual-match', function() {
            if (!currentBatchId) {
                alert('Please load a batch first');
                return;
            }
            //alert(currentSourceType);
            $('#manual-match-modal').css('display', 'flex');
        });

        $(document).on('click', '#btn-close-modal, #manual-match-modal', function(e) {
            if (e.target === this) {
                $('#manual-match-modal').hide();
                $('#manual-match-file').val('');
                $('#match-result').html('');
            }
    });

    // Upload manual match file
    $(document).on('click', '#btn-upload-match', function() {
        let $btn = $(this);
        let fileInput = $('#manual-match-file')[0];
        
        if (!fileInput.files.length) {
            alert('Please select a CSV file');
            return;
        }

        let formData = new FormData();
        formData.append('match_file', fileInput.files[0]);
        formData.append('batch_id', currentBatchId);
        formData.append('form_key', window.FORM_KEY);

        $btn.prop('disabled', true).text('Processing...');

        $.ajax({
            url: '<?= $block->getUrl("brandinventory/data/manualMatch") ?>',
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            success: function(res) {
                if (res.success) {
                    let stats = res.stats;
                    let detailsHtml = '';
                    
                    res.details.forEach(function(d) {
                        let color = d.status === 'applied' ? '#28a745' : (d.status === 'skipped' ? '#fd7e14' : '#dc3545');
                        detailsHtml += `<div style="font-size:12px; color:${color}; padding:2px 0;">
                            ${d.status === 'applied' ? '✓' : (d.status === 'skipped' ? '⚠' : '✗')} 
                            ${d.potential_sku} → ${d.magento_sku} (${d.reason})
                        </div>`;
                    });

                    $('#match-result').html(
                        `<div style="padding: 15px; background: #f8f9fa; border-radius: 3px; margin-top: 10px;">
                            <div style="margin-bottom: 10px; font-weight: bold;">
                                ✅ Applied: <span style="color:#28a745">${stats.applied}</span> | 
                                ⚠ Skipped: <span style="color:#fd7e14">${stats.skipped}</span> | 
                                ✗ Not Found: <span style="color:#dc3545">${stats.not_found}</span> | 
                                🔒 Already Linked: <span style="color:#6c757d">${stats.already_linked}</span>
                            </div>
                            <div style="max-height: 200px; overflow-y: auto; border: 1px solid #ddd; padding: 5px; background: white;">
                                ${detailsHtml}
                            </div>
                        </div>`
                    );

                    $btn.prop('disabled', false).text('Upload & Apply');
                    
                    // Reload data
                    loadAllData();
                    loadSavedData(); 
                } else {
                    alert(res.message);
                    $btn.prop('disabled', false).text('Upload & Apply');
                }
            },
            error: function() {
                alert('Upload failed');
                $btn.prop('disabled', false).text('Upload & Apply');
            }
        });
    });

    // Download template for manual matching
    $(document).on('click', '#btn-download-template', function(e) {
        e.preventDefault();
        
        if (currentBatchId && allSkuData.length > 0) {
            generateTemplateFromBatch();
            return;
        }

        let pendingData = allSkuData.filter(row => {
            let status = row.match_status || '';
            return (!row.linked_sku || row.linked_sku.trim() === '') 
                && status !== 'duplicate_record_found';
        });
        
        if (pendingData.length === 0) {
            alert('No pending SKUs found. All items are already linked!');
            return;
        }
                
        let csvContent = 'Style Group,Style,Color,Size,Potential SKU,Magento SKU\n';
        
        let escapeCsv = (str) => {
            str = String(str || '').replace(/"/g, '""');
            return `"${str}"`;
        };

        pendingData.forEach(row => {
            let styleGroup = '-', styleCode = '-';
            
            if (row.product_data) {
                try {
                    let filterData = typeof row.product_data === 'string' 
                        ? JSON.parse(row.product_data) 
                        : row.product_data;
                    styleCode = filterData.style || filterData.Style || '-';
                    const styleKey = Object.keys(filterData).find(
                        k => k.replace(/\s+/g, '').toLowerCase() === 'stylegroup'
                    );
                    styleGroup = styleKey ? filterData[styleKey] : '-';
                } catch (e) {
                    styleGroup = '-'; 
                    styleCode = '-';
                }
            }

            let color = row.color || '-';
            let size = row.size || '-';
            
            // Strip spaces only, keep internal dashes (e.g., G7S21K-480, T-SHIRT)
            let cleanStyleGroup = String(styleGroup).replace(/\s+/g, '');
            let cleanStyle = String(styleCode).replace(/\s+/g, '');
            let cleanColor = String(color).replace(/\s+/g, '');
            let cleanSize = String(size).replace(/\s+/g, '');
            
            // Potential SKU = raw concatenation, spaces removed, internal dashes preserved
            let potentialSku = cleanStyleGroup + cleanStyle + cleanColor + cleanSize;

            let csvRow = [
                escapeCsv(styleGroup),
                escapeCsv(styleCode),
                escapeCsv(color),
                escapeCsv(size),
                escapeCsv(potentialSku),
                escapeCsv('')
            ];
            
            csvContent += csvRow.join(',') + '\n';
        });

        let blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        let link = document.createElement('a');
        let url = URL.createObjectURL(blob);
        link.setAttribute('href', url);
        link.setAttribute('download', `manual_match_template_batch_${currentBatchId}.csv`);
        link.style.visibility = 'hidden';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    });

    function generateTemplateFromBatch() {
        let originalHeaders = JSON.parse(localStorage.getItem('brand_csv_headers') || '[]');
        console.log('Original CSV Headers:', originalHeaders);

        let pendingData = allSkuData.filter(row => {
            let status = row.match_status || '';
            return (!row.linked_sku || row.linked_sku.trim() === '') 
                && status !== 'duplicate_record_found';
        });
        
        if (pendingData.length === 0) {
            alert('No pending SKUs found. All items are already linked!');
            return;
        }

        let csvContent = '';
        let escapeCsv = (str) => {
            str = String(str || '').replace(/"/g, '""');
            return `"${str}"`;
        };

        if (currentSourceType === "direct_sku") {
            // ═══════════════════════════════════════════════════════
            // DIRECT SKU FORMAT
            // SKU itself is the potential SKU — no concatenation
            // ═══════════════════════════════════════════════════════
            
            const includeProductType = pendingData.some(row => {
            let productData = {};

            if (row.product_data) {
                try {
                    productData = typeof row.product_data === 'string'
                        ? JSON.parse(row.product_data)
                        : row.product_data;
                } catch (e) {
                    productData = {};
                }
            }

            const productType =
                row.style_code ||
                productData.product_type ||
                productData.Product_Type ||
                productData["Product Name"] ||
                '';

            return String(productType).trim() !== '';
        });

        // Set header once
        csvContent = includeProductType
            ? 'SKU,Product Type,Potential SKU,Magento SKU\n'
            : 'SKU,Potential SKU,Magento SKU\n';

        // Add all rows
        pendingData.forEach(row => {

            let productData = {};

            if (row.product_data) {
                try {
                    productData = typeof row.product_data === 'string'
                        ? JSON.parse(row.product_data)
                        : row.product_data;
                } catch (e) {
                    productData = {};
                }
            }

            let sku = row.style || productData.sku || productData.SKU || '-';

            let productType =
                row.style_code ||
                productData.product_type ||
                productData.Product_Type ||
                productData["Product Name"] ||
                '';

            let potentialSku = sku;

            let csvRow;

            if (includeProductType) {
                csvRow = [
                    escapeCsv(sku),
                    escapeCsv(productType),
                    escapeCsv(potentialSku),
                    escapeCsv('')
                ];
            } else {
                csvRow = [
                    escapeCsv(sku),
                    escapeCsv(potentialSku),
                    escapeCsv('')
                ];
            }

            csvContent += csvRow.join(',') + '\n';
        });


        } else {
            // ═══════════════════════════════════════════════════════
            // STYLE COMPOSITE FORMAT (existing logic)
            // ═══════════════════════════════════════════════════════
            csvContent = 'Style Group,Style,Color,Size,Potential SKU,Magento SKU\n';

            pendingData.forEach(row => {
                let styleGroup = '-', styleCode = '-';
                
                if (row.product_data) {
                    try {
                        let filterData = typeof row.product_data === 'string' 
                            ? JSON.parse(row.product_data) 
                            : row.product_data;
                        styleCode = filterData.style || filterData.Style || '-';
                        const styleKey = Object.keys(filterData).find(
                            k => k.replace(/\s+/g, '').toLowerCase() === 'stylegroup'
                        );
                        styleGroup = styleKey ? filterData[styleKey] : '-';
                    } catch (e) {
                        styleGroup = '-'; 
                        styleCode = '-';
                    }
                }

                let color = row.color || '-';
                let size = row.size || '-';
                
                // Strip spaces only, keep internal dashes
                let cleanStyleGroup = String(styleGroup).replace(/\s+/g, '');
                let cleanStyle = String(styleCode).replace(/\s+/g, '');
                let cleanColor = String(color).replace(/\s+/g, '');
                let cleanSize = String(size).replace(/\s+/g, '');
                
                // Potential SKU = concatenation
                let potentialSku = cleanStyleGroup + cleanStyle + cleanColor + cleanSize;

                let csvRow = [
                    escapeCsv(styleGroup),
                    escapeCsv(styleCode),
                    escapeCsv(color),
                    escapeCsv(size),
                    escapeCsv(potentialSku),
                    escapeCsv('')
                ];
                
                csvContent += csvRow.join(',') + '\n';
            });
        }

        let blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        let link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = `manual_match_template_batch_${currentBatchId}.csv`;
        link.click();
    }

    function toggleGeneratedControls(show) {
        if (show && allSkuData.length > 0) {
            $('#generated-content .match-summary-bar').show();
            $('#generated-content .sync-bar').css('display', 'flex');
            $('#generated-content .pagination-controls').show();

            let $syncBtn = $('#btn-sync-magento');
            if (batchSyncStatus === 1) {
                $syncBtn
                    .prop('disabled', true)
                    .addClass('btn-disabled')
                    .text('✓ SKUs Already Synced')
                    .attr('title', 'SKUs have already been matched with Magento');
            } else {
                $syncBtn
                    .prop('disabled', false)
                    .removeClass('btn-disabled')
                    .text('🔄 Match With Magento SKUs')
                    .removeAttr('title');
            }
        } else {
            $('#generated-content .match-summary-bar').hide();
            $('#generated-content .sync-bar').hide();
            $('#generated-content .pagination-controls').hide();
        }
    }


    $(document).on('click', '#saved-prev', function() { if(savedPage>1){savedPage--; renderSavedTable(savedRows);} });
    $(document).on('click', '#saved-next', function() { let max=Math.ceil(savedRows.length/savedPerPage)||1; if(savedPage<<max){savedPage++; renderSavedTable(savedRows);} });
    $(document).on('change', '#saved-per-page', function() { savedPerPage=+this.value; savedPage=1; renderSavedTable(savedRows); });

    // When format is selected, fetch and display details
    // When format is selected, fetch and display details
    $(document).on('change', '#format-select', function() {
        let formatId = $(this).val();
        let $preview = $('#format-preview');
        let $details = $('#format-details');

        if (!formatId) {
            $preview.hide();
            return;
        }

        $details.html('<p>Loading format details...</p>');
        $preview.show();

        $.ajax({
            url: '<?= $block->getUrl("brandinventory/data/updates") ?>',
            type: 'GET',
            data: {
                action: 'getFormatDetails',
                format_id: formatId,
                form_key: window.FORM_KEY
            },
            success: function(res) {
                if (res.success && res.format) {
                    
                    let fmt = res.format;
                    let html = '';
                    currentFormatHeading = fmt.heading || 'Choose Sku Containing Column';
                    console.log('Current Format Heading:', currentFormatHeading);
                    
                    html += '<div style="margin-bottom: 8px;"><strong>Format:</strong> ' + escapeHtml(fmt.format) + '</div>';

                    let columns = [];
                    let rows = [];

                    try {
                        let data = (typeof fmt.format_data === 'string') ? JSON.parse(fmt.format_data) : fmt.format_data;

                        // ✅ Handle array of objects (your actual data structure)
                        if (Array.isArray(data) && data.length > 0 && typeof data[0] === 'object') {
                            columns = Object.keys(data[0]); // Extract column names from first row
                            rows = data; // Store all sample rows
                        }
                        // Handle object with columns array
                        else if (data && typeof data === 'object' && data.columns && Array.isArray(data.columns)) {
                            columns = data.columns;
                            rows = data.rows || (data.sample ? [data.sample] : []);
                        }
                        // Handle flat array of strings
                        else if (Array.isArray(data)) {
                            columns = data;
                        }
                        // Handle single object
                        else if (data && typeof data === 'object') {
                            columns = Object.keys(data);
                        }
                    } catch (e) {
                        columns = [String(fmt.format_data)];
                    }

                    // Show columns as tags
                    if (columns.length > 0) {
                        // html += '<div style="margin-bottom: 8px;"><strong>Expected Columns (' + columns.length + '):</strong></div>';
                        // html += '<div style="display: flex; flex-wrap: wrap; gap: 6px;">';
                        // columns.forEach(function(col) {
                        //     html += '<span style="background: #e3f2fd; color: #1565c0; padding: 3px 10px; border-radius: 12px; font-size: 12px; border: 1px solid #bbdefb;">' + escapeHtml(String(col)) + '</span>';
                        // });
                        // html += '</div>';
                    }

                    // Show sample data as a table
                    if (rows.length > 0) {
                        html += '<div style="margin-top: 15px;"><strong>Sample Data (' + rows.length + ' rows):</strong></div>';
                        html += '<div style="overflow-x: auto; margin-top: 8px;">';
                        html += '<table style="width: 100%; border-collapse: collapse; font-size: 12px; background: #fff; border: 1px solid #ddd;">';
                        
                        // Header
                        html += '<thead><tr style="background: #f4f4f4;">';
                        columns.forEach(function(col) {
                            html += '<th style="padding: 8px; border: 1px solid #ddd; text-align: left; font-weight: bold;">' + escapeHtml(String(col)) + '</th>';
                        });
                        html += '</tr></thead><tbody>';

                        // Rows (show max 3 rows)
                        rows.slice(0, 3).forEach(function(row) {
                            html += '<tr>';
                            columns.forEach(function(col) {
                                let val = row[col] !== undefined ? row[col] : '-';
                                html += '<td style="padding: 8px; border: 1px solid #ddd;">' + escapeHtml(String(val)) + '</td>';
                            });
                            html += '</tr>';
                        });

                        if (rows.length > 3) {
                            html += '<tr><td colspan="' + columns.length + '" style="padding: 8px; border: 1px solid #ddd; text-align: center; color: #666; font-style: italic;">... and ' + (rows.length - 3) + ' more rows</td></tr>';
                        }

                        html += '</tbody></table></div>';
                    }

                    // Raw data toggle
                    html += '<div style="margin-top: 12px; padding-top: 10px; border-top: 1px solid #ddd;">';
                    html += '<details><summary style="font-size: 12px; color: #666; cursor: pointer;">View Raw Format Data</summary>';
                    html += '<pre style="background: #fff; padding: 10px; border-radius: 4px; border: 1px solid #e0e0e0; font-size: 11px; overflow-x: auto; margin-top: 8px;">' + escapeHtml(JSON.stringify(fmt.format_data, null, 2)) + '</pre>';
                    html += '</details></div>';

                    $details.html(html);
                } else {
                    $details.html('<p style="color: #dc3545;">Failed to load format details</p>');
                }
            },
            error: function() {
                $details.html('<p style="color: #dc3545;">Error fetching format details</p>');
            }
        });
    });
});
</script>