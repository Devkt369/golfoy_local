    $(document).on('click', '#process-data', function() {
        let selectedLabels = [];
        let fileName = $('#uploaded_file').val();
        
        $('.header-checkbox:checked, .header-radio:checked').each(function() {
            selectedLabels.push($(this).next('label').text().trim());
        });
        
        if (selectedLabels.length === 0) { 
            alert('Please select at least one column'); 
            return; 
        }
        
        let source = $('select[name="source_code"]').val();
        let sourceType = $('#source_type_hidden').val();
        let formatType = $('#format-select').val();

        if (!source) { 
            alert('Please select source'); 
            return; 
        }
        
        let headers = JSON.parse(localStorage.getItem('brand_csv_headers'));
        let rows = JSON.parse(localStorage.getItem('brand_csv_rows'));
        
        // Apply row filters
        let rowsToProcess = rows;
        let skippedCount = 0;
        let hasFilters = window.activeRowFilters && window.activeRowFilters.length > 0;
        
        if (hasFilters) {
            rowsToProcess = rows.filter(function(row) {
                let skip = shouldSkipRow(row);
                if (skip) skippedCount++;
                return !skip;
            });
        }
        
        let requestData = {
            selected_columns: selectedLabels,
            headers: headers,
            fileName: fileName,
            source_code: source,
            sourceType: sourceType,
            formatType: formatType,
            form_key: window.FORM_KEY
        };
        
        // ✅ Send filters to server for saving
        if (hasFilters) {
            requestData.rows = JSON.stringify(rowsToProcess);
            requestData.skipped_count = skippedCount;
            requestData.row_filters = JSON.stringify(window.activeRowFilters);
        }
        
        $.ajax({
            url: '<?= $block->getUrl("brandinventory/data/process") ?>',
            type: 'POST',
            data: requestData,
            success: function(res) {
                alert('Sheet has been processed successfully');
                $('#uploaded_file').val('');
                $('#csv-upload-form button[type="submit"]').prop('disabled', true);
                loadSavedData();
                collapseSection('upload-content');
                expandSection('saved-content');
            },
            error: function() { 
                alert('Processing failed'); 
            }
        });
    });

