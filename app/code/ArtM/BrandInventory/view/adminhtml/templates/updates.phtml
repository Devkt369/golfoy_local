    // ===============================
    // EXTRACT UNIQUE VALUES FOR DROPDOWNS
    // ===============================
    function extractUniqueValues() {
        let genders = new Set();
        let sizes = new Set();

        allSkuData.forEach(row => {
            let gender = getCellValue(row, 'gender');
            let size = getCellValue(row, 'size');
            
            if (gender && gender !== '-') genders.add(gender);
            if (size && size !== '-') sizes.add(size);
        });

        uniqueGenders = Array.from(genders).sort();
        uniqueSizes = Array.from(sizes).sort();
    }

