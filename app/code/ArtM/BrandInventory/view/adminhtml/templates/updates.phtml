    // ===============================
    // DOWNLOAD EXCEL
    // ===============================
    $(document).on('click', '#btn-download-excel', function() {
        if (!currentBatchId) { alert('Please load a batch first'); return; }

        let exportData = filteredData.length > 0 ? filteredData : allSkuData;
        console.log('Exporting data:', exportData);
        if (exportData.length === 0) { alert('No data to download'); return; }

        // ─── 1. DISCOVER SYSTEM COLUMNS ───
        let activeSystemColumns = [];
        let hasGenderInProductData = false;

        exportData.forEach(row => {
            // Check which system columns have data
            ['entity_id', 'style', 'style_code', 'color', 'size', 'qty', 'update_qty', 
            'potential_sku', 'linked_sku', 'match_status', 'location'].forEach(col => {
                if (row[col] !== null && row[col] !== undefined && String(row[col]).trim() !== '') {
                    if (!activeSystemColumns.includes(col)) activeSystemColumns.push(col);
                }
            });

            // Check if gender exists in product_data for any row
            if (row.product_data) {
                try {
                    let pd = typeof row.product_data === 'string' ? JSON.parse(row.product_data) : row.product_data;
                    if (pd.gender !== undefined || pd.Gender !== undefined) {
                        hasGenderInProductData = true;
                    }
                } catch (e) {}
            }
        });

        // ─── 2. DEFINE FIXED COLUMN ORDER ───
        // Only include columns that actually have data, in your preferred order
        let desiredOrder = ['entity_id', 'style', 'style_code'];
        
        // Insert gender here (between style_code and color) if it exists anywhere
        if (hasGenderInProductData) {
            desiredOrder.push('gender');
        }
        
        desiredOrder.push('color', 'size', 'qty', 'update_qty', 'potential_sku', 'linked_sku', 'match_status', 'location');

        // Filter to only columns that have data
        let allColumns = desiredOrder.filter(col => activeSystemColumns.includes(col) || col === 'gender');

        // ─── 3. COLUMN LABELS ───
        let columnLabels = {
            'entity_id': 'ID',
            'style': 'Style',
            'style_code': 'Style Code',
            'gender': 'Gender',
            'color': 'Color',
            'size': 'Size',
            'qty': 'Brand Qty',
            'update_qty': 'Update Qty',
            'potential_sku': 'Potential SKU',
            'linked_sku': 'Matched Magento SKU',
            'match_status': 'Status',
            'location': 'Location'
        };

        // ─── 4. BUILD CSV ───
        let csvHeader = allColumns.map(col => `"${columnLabels[col].replace(/"/g, '""')}"`).join(',') + '\n';
        let csvContent = csvHeader;

        let escapeCsv = (str) => {
            if (str === null || str === undefined) return '""';
            str = String(str).replace(/"/g, '""');
            return `"${str}"`;
        };

        exportData.forEach(row => {
            let rowValues = allColumns.map(col => {
                // Special handling for gender — pull from product_data if not in row directly
                if (col === 'gender') {
                    // First check direct row property
                    if (row.gender !== undefined && row.gender !== null && String(row.gender).trim() !== '') {
                        return escapeCsv(row.gender);
                    }
                    // Then check product_data JSON
                    if (row.product_data) {
                        try {
                            let pd = typeof row.product_data === 'string' ? JSON.parse(row.product_data) : row.product_data;
                            let genderVal = pd.gender || pd.Gender || '';
                            return escapeCsv(genderVal);
                        } catch (e) {
                            return escapeCsv('');
                        }
                    }
                    return escapeCsv('');
                }
                
                // All other columns — pull directly from row
                return escapeCsv(row[col]);
            });
            csvContent += rowValues.join(',') + '\n';
        });

        // ─── 5. DOWNLOAD ───
        let blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        let link = document.createElement('a');
        let url = URL.createObjectURL(blob);
        link.setAttribute('href', url);
        link.setAttribute('download', `brand_inventory_batch_${currentBatchId}.csv`);
        link.style.visibility = 'hidden';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    });

