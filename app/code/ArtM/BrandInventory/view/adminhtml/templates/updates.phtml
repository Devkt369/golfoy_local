<script>
require(['jquery'], function($) {
    let currentBatchId = null;
    let currentFileName = null;
    let baseLoadUrl = '<?= $block->getUrl("brandinventory/data/load") ?>';
    let allSkuData = [];
    let filteredData = [];
    let currentPage = 1;
    let perPage = 15;
    let savedAttributes = [];
    let isSyncing = false;
    let sortColumn = '';
    let sortDirection = 'asc';

    // Store unique values for dropdowns
    let uniqueGenders = [];
    let uniqueSizes = [];
    function isColumnVisible(columnKey) {
        if (columnKey === 'action') return true;
            if (!visibleColumns || visibleColumns.length === 0) {
                return defaultVisibleColumns.includes(columnKey);
        }
        return visibleColumns.includes(columnKey);
    }

    $(function () {
        var $btn = $('#csv-upload-form button[type="submit"]');
        var $source = $('select[name="source_code"]');
        var $file = $('input[name="csv_file"]');

        $btn.prop('disabled', true);

        function validate() {
            $btn.prop('disabled', !($source.val() && $file.val()));
        }

        $source.on('change', validate);
        $file.on('change', validate);
    });
    // ===============================
    // SECTION TOGGLE
    // ===============================
    $(document).on('click', '.section-header', function() {
        let targetId = $(this).data('target');
        let $content = $('#' + targetId);
        let $icon = $(this).find('.toggle-icon');
        $content.slideToggle(300);
        $icon.toggleClass('collapsed');

        $('input[name="csv_file"]').on('change', function() {
            let file = this.files[0];
            if (!file) return;

            let allowedExtensions = ['csv'];
            let extension = file.name.split('.').pop().toLowerCase();

            if (!allowedExtensions.includes(extension)) {
                alert('Invalid file type: "' + extension + '"\n\nPlease upload a valid .csv file only.');
                this.value = ''; // Clear the invalid file
            }
        });
    });

    function collapseSection(sectionId) {
        let $content = $('#' + sectionId);
        let $header = $content.prev('.section-header');
        let $icon = $header.find('.toggle-icon');
        $content.slideUp(300);
        $icon.addClass('collapsed');
    }

    function expandSection(sectionId) {
        let $content = $('#' + sectionId);
        let $header = $content.prev('.section-header');
        let $icon = $header.find('.toggle-icon');
        $content.slideDown(300);
        $icon.removeClass('collapsed');
    }

    // ===============================
    // SOURCE & ATTRIBUTES
    // ===============================
    $(document).on('change', 'select[name="source_code"]', function() {
        let sourceCode = $(this).val();
        let $formatWrapper = $('#format-selector-wrapper');
        let $formatSelect = $('#format-select');
        let $preview = $('#format-preview');
        let $sourceTypeHidden = $('#source_type_hidden');

        // Reset
        $formatSelect.html('<option value="">-- Select Format --</option>');
        
        $preview.hide();
        $('#format-details').html('');
        savedAttributes = [];

        if (!sourceCode) {
            $formatWrapper.hide();
            return;
        }

        // For KF source: fetch formats first, then attributes
        if (sourceCode === 'KF' || sourceCode === 'ZSPL') {
            $formatWrapper.show();

        if (sourceCode === 'KF') {
                $sourceTypeHidden.val('style_composite');
        } else {
                $sourceTypeHidden.val('direct_sku'); // ZSPL uses direct_sku
        }
            $.ajax({
                url: '<?= $block->getUrl("brandinventory/data/updates") ?>',
                type: 'GET',
                data: { 
                    action: 'getFormats', 
                    source: sourceCode, 
                    form_key: window.FORM_KEY 
                },
                success: function(res) {
                    console.log('Formats response kf:', res);
                    if (res.success && res.formats && res.formats.length > 0) {
                        res.formats.forEach(function(fmt) {
                            $formatSelect.append(
                                `<option value="${fmt.id}">${escapeHtml(fmt.format)}</option>`
                            );
                        });
                       
                    } else {
                        $formatSelect.append('<option value="" disabled>No formats found</option>');
                    }
                },
                error: function() {
                    $formatSelect.append('<option value="" disabled>Error loading formats</option>');
                }
            });

        } else { 

                $sourceTypeHidden.val('direct_sku'); // default
                // Non-KF: hide format, fetch attributes directly
                $formatWrapper.hide();
                fetchSavedAttributes(sourceCode, '');
        }
    });

    // ✅ Call fetchSavedAttributes only when customer selects a format
    $(document).on('change', '#format-select', function() {
        let formatId = $(this).val();
        let sourceCode = $('select[name="source_code"]').val();

        if (formatId && sourceCode === 'KF' || sourceCode === 'ZSPL') {
            fetchSavedAttributes(sourceCode, formatId);
        }
    });

    // Separate reusable function
    function fetchSavedAttributes(sourceCode, formatType) {
        console.log('Fetching saved attributes for source:', sourceCode, 'format:', formatType);
        
        // ✅ Clear existing checkboxes and highlights before fetching new data
        $('.header-checkbox').prop('checked', false);
        $('#csv-result table tr').each(function() {
            $(this).find('td').css('background', '');
        });

        let requestData = {
            action: 'getSelectedAttrs',
            source: sourceCode,
            form_key: window.FORM_KEY
        };

        // Only send formatType if KF and format is selected
        if (sourceCode === 'KF' && formatType) {
            requestData.formatType = formatType;
        }

        $.ajax({
            url: '<?= $block->getUrl("brandinventory/data/updates") ?>',
            type: 'GET',
            data: requestData,
            success: function(res) {
                savedAttributes = (res.success && res.attributes) ? res.attributes : [];
                
                // Apply checkboxes if table is rendered
                if ($('.header-checkbox').length > 0) {
                    applySavedAttributes();
                }
            },
            error: function() {
                savedAttributes = [];
            }
        });
    }

    function applySavedAttributes() {
        if (!savedAttributes || savedAttributes.length === 0) return;
        let matchedCount = 0;
        $('.header-checkbox, .header-radio').each(function() {
            let labelText = $(this).next('label').text().trim();
            if (savedAttributes.includes(labelText)) {
                $(this).prop('checked', true);
                matchedCount++;
            }
        });
        if (matchedCount > 0) {
            let checkedCols = [];
            $('.header-checkbox:checked, .header-radio:checked').each(function() { checkedCols.push(parseInt($(this).val())); });
            $('#csv-result table tr').each(function() {
                $(this).find('td').css('background', '');
                checkedCols.forEach(colIndex => { $(this).find('td').eq(colIndex).css('background', '#d4edda'); });
            });
            $('.header-checkbox, .header-radio').first().trigger('change');
        }
    }

    // ===============================
    // CSV UPLOAD
    // ===============================
    $(document).ready(function() { 
        collapseSection('upload-content');
        collapseSection('saved-content');
        collapseSection('generated-content');
        
        toggleGeneratedControls(false);
        loadSavedData(); 
    });

    $('#csv-upload-form').on('submit', function(e) {
        e.preventDefault();

        let $form = $(this);
        let source = $('select[name="source_code"]').val();
        let fileInput = $('input[name="csv_file"]')[0];
        let sourceType = $('#source_type_hidden').val();
        let file = fileInput.files[0];
        let formatType = $('#format-select').val(); // Get selected format

        // 1. Validate source
        if (!source) {
            alert('Please select a source first.');
            return;
        }

        // 2. Validate file selected
        if (!file) {
            alert('Please select a file to upload.');
            return;
        }

        var formData = new FormData(this);
        formData.append('form_key', window.FORM_KEY);
        formData.append('source_type', sourceType);

        if (source === 'KF' && formatType) {
            if(formatType =='' || formatType == null){
                alert('Please select a format type.');
                return;
            }
            formData.append('format_type', formatType);
        }

        $.ajax({
            url: $form.attr('action'),
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            showLoader: true,
            success: function(response) {
                console.log('Upload CSV response:', response);
                if (response.success) {
                    $("#uploaded_file").val(response.file_path);
                    localStorage.removeItem('brand_csv_headers');
                    localStorage.removeItem('brand_csv_rows');
                    localStorage.setItem('brand_csv_headers', JSON.stringify(response.headers));
                    localStorage.setItem('brand_csv_rows', JSON.stringify(response.rows));
                    $('#filtered-result').html('');
                    $('#csv-result').html('');
                    renderTable(response.headers, response.rows,sourceType,source);
                    expandSection('upload-content');
                } else {
                    // Server returned success: false with a message
                    let msg = response.message || 'Upload failed. Please check the file and try again.';
                    alert('Upload Failed:\n' + msg);
                }
            },
            error: function(xhr, status, error) {
                console.error('Upload error:', xhr, status, error);
                
                let message = 'Upload failed. Please try again.';
                
                // Try to extract server error message
                if (xhr.responseJSON && xhr.responseJSON.message) {
                    message = xhr.responseJSON.message;
                } else if (xhr.responseText) {
                    // Sometimes Magento returns HTML error pages
                    try {
                        let resp = JSON.parse(xhr.responseText);
                        if (resp.message) message = resp.message;
                    } catch (e) {
                        // If it's HTML, show a generic message
                        if (xhr.status === 413) {
                            message = 'File is too large for the server to process.';
                        } else if (xhr.status === 500) {
                            message = 'Server error occurred. Please check the file format and try again.';
                        }
                    }
                }
                alert('Upload Failed:\n' + message);
            }
        });
    });

    let currentFormatHeading ='Choose Sku Containing Column';
    function renderTable(headers, rows, sourceType,source) {
        //console.log('new -  '+sourceType); 
        let html = '';
        html += '<h3 style="margin-top:20px;">' + escapeHtml(currentFormatHeading) + '</h3>';
        html += '<div id="header-checkboxes">';
        
        // Select All button
        html += '<button id="select-all-headers" type="button" style="margin-bottom:10px;">Select All</button>';
        
        let inputType = (currentFormatHeading === 'Choose Sku Containing Column') ? 'radio' : 'checkbox';
        let inputClass = (inputType === 'radio') ? 'header-radio' : 'header-checkbox';
        let inputName = (inputType === 'radio') ? ' name="sku-column"' : '';
        console.log('source -  '+source);

        html += `<div id="header-checkbox-grid">`;
        headers.forEach(function(header, index) {
            html += `<div class="checkbox-item"><input type="${inputType}" class="${inputClass}" value="${index}" id="col_${index}"${inputName}><label for="col_${index}">${header}</label></div>`;
        });
        html += '</div>';;
        
        
        // ✅ NEW: Row Filter Section
        html += '<div id="row-filter-section" style="margin-top:20px; padding:15px; background:#f8f9fa; border:1px solid #ddd; border-radius:4px;">';
        html += '<h4 style="margin:0 0 10px 0;">🚫 Skip Rows Filter</h4>';
        html += '<p style="font-size:12px; color:#666; margin-bottom:10px;">Select a column and enter values to skip those rows during SKU creation.</p>';
    
        // Filter column dropdown
        html += '<div style="margin-bottom:10px;">';
        html += '<label style="display:block; font-size:12px; margin-bottom:4px;">Filter Column:</label>';
        html += '<select id="row-filter-column" style="padding:5px; border-radius:4px; border:1px solid #ccc; min-width:150px;">';
        html += '<option value="">-- Select Column --</option>';
        headers.forEach(function(header, index) {
            html += `<option value="${index}">${escapeHtml(header)}</option>`;
        });
        html += '</select>';
        html += '</div>';
        
        // Filter values input
        html += '<div style="margin-bottom:10px;">';
        html += '<label style="display:block; font-size:12px; margin-bottom:4px;">Skip Values (comma separated):</label>';
        html += '<input type="text" id="row-filter-values" placeholder="e.g. gloves, hats, shoes" style="padding:5px; border-radius:4px; border:1px solid #ccc; width:100%; max-width:300px;" />';
        html += '</div>';
        
        // Active filters display
        html += '<div id="active-row-filters" style="display:none;">';
        html += '<label style="display:block; font-size:12px; margin-bottom:4px;">Active Filters:</label>';
        html += '<div id="active-filters-list" style="display:flex; flex-wrap:wrap; gap:6px;"></div>';
        html += '</div>';
        
        // Add filter button
        html += '<button id="add-row-filter" type="button" class="btn btn-small" style="background:#dc3545; color:#fff; border:none; padding:5px 12px; border-radius:4px; cursor:pointer;">Add Skip Filter</button>';
        
        html += '</div>'; // end row-filter-section
        
        html += '</div>'; // end header-checkboxes
        html += '<button id="process-data" style="margin-top:15px;">Process Sheet</button>';
        
        $('#csv-result').html(html);
        // ✅ Move this AFTER the html is inserted
        if (source === 'TGIP') {
            $('#row-filter-section').hide();
        }

        applySavedAttributes();
        
        // Bind Select All button
        bindSelectAllHandler();
        
        // ✅ Store rows for filtering
        window.csvRows = rows;
        window.csvHeaders = headers;
        window.activeRowFilters = []; // Store active filters
    }

    // Add row filter
$(document).on('click', '#add-row-filter', function() {
    let columnIndex = $('#row-filter-column').val();
    let filterValues = $('#row-filter-values').val().trim();
    
    if (!columnIndex) {
        alert('Please select a column to filter');
        return;
    }
    
    if (!filterValues) {
        alert('Please enter values to skip');
        return;
    }
    
    let columnName = window.csvHeaders[parseInt(columnIndex)];
    let values = filterValues.split(',').map(v => v.trim().toLowerCase()).filter(v => v);
    
    // Check if filter already exists for this column
    let existingIndex = window.activeRowFilters.findIndex(f => f.columnIndex === columnIndex);
    if (existingIndex !== -1) {
        window.activeRowFilters[existingIndex].values = values;
    } else {
        window.activeRowFilters.push({
            columnIndex: columnIndex,
            columnName: columnName,
            values: values
        });
    }
    
    // Clear input
    $('#row-filter-values').val('');
    
    // Update display
    renderActiveFilters();
    
    // Preview filtered rows
    previewFilteredRows();
});

// Remove a filter
$(document).on('click', '.remove-filter-btn', function() {
    let index = $(this).data('index');
    window.activeRowFilters.splice(index, 1);
    renderActiveFilters();
    previewFilteredRows();
});

// Render active filters as tags
function renderActiveFilters() {
    let $container = $('#active-row-filters');
    let $list = $('#active-filters-list');
    
    if (window.activeRowFilters.length === 0) {
        $container.hide();
        return;
    }
    
    let html = '';
    window.activeRowFilters.forEach(function(filter, index) {
        html += `<span style="background:#f8d7da; color:#721c24; padding:4px 10px; border-radius:12px; font-size:12px; border:1px solid #f5c6cb; display:inline-flex; align-items:center; gap:6px;">`;
        html += `<strong>${escapeHtml(filter.columnName)}</strong>: ${escapeHtml(filter.values.join(', '))}`;
        html += `<button class="remove-filter-btn" data-index="${index}" style="background:#dc3545; color:#fff; border:none; border-radius:50%; width:18px; height:18px; font-size:11px; cursor:pointer; line-height:1;">×</button>`;
        html += `</span>`;
    });
    
    $list.html(html);
    $container.show();
}

// Preview how many rows will be skipped
function previewFilteredRows() {
    if (!window.csvRows || window.activeRowFilters.length === 0) return;
    
    let skippedCount = 0;
    window.csvRows.forEach(function(row) {
        if (shouldSkipRow(row)) {
            skippedCount++;
        }
    });
    
    // You can show this info somewhere if needed
    console.log(`Rows to be skipped: ${skippedCount} of ${window.csvRows.length}`);
}

// Check if a row should be skipped
function shouldSkipRow(row) {
    if (!window.activeRowFilters || window.activeRowFilters.length === 0) return false;
    
    return window.activeRowFilters.some(function(filter) {
        let colIndex = parseInt(filter.columnIndex);
        let cellValue = String(row[colIndex] || '').trim().toLowerCase();
        
        return filter.values.some(function(val) {
            return cellValue.includes(val);
        });
    });
}

