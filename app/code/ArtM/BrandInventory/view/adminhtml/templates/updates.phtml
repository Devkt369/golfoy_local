    function renderSavedTable(data) 
    {
        savedRows = data;
        const total = data.length, pages = Math.ceil(total / savedPerPage) || 1;
        savedPage = Math.min(savedPage, pages) || 1;
        const slice = data.slice((savedPage - 1) * savedPerPage, savedPage * savedPerPage);

        let html = '';
        if (total === 0) { 
            html += '<p class="no-data">No records found</p>'; 
            $('#saved-data').html(html); 
            return; 
        }

        html += '<table class="custom-table">';
        html += '<thead><tr>';
        html += '<th>ID</th>';
        html += '<th>File</th>';
        html += '<th>Source</th>';
        html += '<th>User</th>';
        html += '<th>Date</th>';
        html += '<th>Status</th>';
        html += '<th>Total</th>';
        html += '<th>Matched</th>';
        html += '<th>Pending</th>';
        html += '<th>Actions</th>';
        html += '</tr></thead><tbody>';

        if (!slice.length) {
            html += '<tr><td colspan="10" style="text-align:center;padding:12px;">No records on this page</td></tr>';
        } else {
            slice.forEach(function(row) {
                let skuSynced = row.status === "Unsynced";
                let reportBtnAttrs = skuSynced ? 'disabled title="Report available after SKU sync"' : '';
                let reportBtnStyle = skuSynced ? 'opacity:0.6; cursor:not-allowed;' : '';

                let statusClass = '';
                let statusIcon = '';
                let statusText = row.status || 'Pending';
                console.log('Row status:', row.status);
                if(statusText == 'Partially Synced'){
                    statusText = 'Loaded';
                }
                
                let inventorySynced = parseInt(row.synced_inventory, 10) === 1;
                
                if (inventorySynced) {
                    statusClass = 'status-synced';
                    statusIcon = '✅';
                    statusText = 'Inventory Synced';
                }else if (row.status === 'Unsynced') {
                    statusText = 'Uploaded';
                    statusClass = 'status-pending';
                } else if (row.status === 'Complete') {
                    statusClass = 'status-complete';
                    statusIcon = '✅';
                } else if (row.status === 'In Progress') {
                    statusClass = 'status-progress';
                    statusIcon = '🔄';
                } else if (row.status === 'Sku Synced') {
                    statusText = 'All Matched';
                    statusClass = 'status-complete';
                    statusIcon = '🔄';
                } else {
                    statusClass = 'status-pending';
                    statusIcon = '⏳';
                }
                
                let inventorySyncedBtn = parseInt(row.synced_inventory, 10) === 1;
                let loadButtonAttrs = inventorySynced ? 'disabled title="Inventory already synced for this batch"' : '';
                let loadButtonStyle = inventorySynced ? 'opacity:0.6; cursor:not-allowed;' : '';
                let loadButtonText = inventorySynced ? 'Inventory Synced' : 'Load';
                html += `<tr>
                        <td>${row.id}</td>
                        <td>
                            <a href="#" class="file-download-link" data-file="${escapeHtml(row.file)}" style="color: #007bdb; text-decoration: underline; cursor: pointer;">
                                📄 ${escapeHtml(row.file)}
                            </a>
                        </td>
                        <td>${escapeHtml(row.source)}</td>
                        <td>${escapeHtml(row.user)}</td>
                        <td>${row.date}</td>
                        <td><span class="status-badge ${statusClass}">${statusIcon} ${statusText}</span></td>
                        <td><strong>${row.total}</strong></td>
                        <td style="color: #28a745;"><strong>${row.matched}</strong></td>
                        <td style="color: ${row.pending > 0 ? '#dc3545' : '#28a745'};"><strong>${row.pending}</strong></td>
                        <td>
                            <button class="btn load-btn" data-id="${row.id}" data-file="${escapeHtml(row.file)}" data-status="${row.status || 'Pending'}" ${loadButtonAttrs} style="${loadButtonStyle}">${loadButtonText}</button>
                            <!--<button class="btn btn-view-all" data-id="${row.id}" data-file="${escapeHtml(row.file)}">🔍 View All</button> -->
                            <button class="btn btn-history" data-batch="${row.id}">📜 History</button>
                            <button class="btn btn-report" data-id="${row.id}" data-file="${escapeHtml(row.file)}" data-matched="${row.matched}" ${reportBtnAttrs} style="${reportBtnStyle}">📊 Download Report</button>
                        </td>
                    </tr>`;
            });
        }

        html += '</tbody></table>';
        html += `<div style="margin:10px 0;display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
            <button class="btn btn-small" id="saved-prev" ${savedPage==1?'disabled':''}>← Prev</button>
            <b>Page ${savedPage} / ${pages}</b>
            <span style="color:#666;font-size:12px;">(${total} total)</span>
            <button class="btn btn-small" id="saved-next" ${savedPage==pages?'disabled':''}>Next →</button>
