    function renderBatchHistory(batchId, comments, summaryLogs) {
        let html = '<div style="margin-bottom: 16px;"><strong>Batch ID:</strong> ' + escapeHtml(batchId) + '</div>';

        if (summaryLogs.length > 0) {
            html += '<div style="margin-bottom: 16px;"><strong>Manual Match Uploads</strong><div style="margin-top: 8px;">';
            summaryLogs.forEach(function(summary) {
                html += '<div style="padding: 10px; border: 1px solid #e1e1e1; margin-bottom: 8px; border-radius: 4px; background: #fafafa;">';
                html += '<div><strong>Uploaded By:</strong> ' + escapeHtml(summary.uploaded_by || 'unknown') + '</div>';

                // File with download link when available
                var fileDisplay = escapeHtml(summary.file_path || summary.file || '-');
                if (summary.file_path) {
                    var dl = '<?= $block->getUrl("brandinventory/data/download") ?>'
                        + '?file=' + encodeURIComponent(summary.file_path)
                        + '&batch_id=' + encodeURIComponent(batchId)
                        + '&type=manual_match'
                        + '&form_key=' + encodeURIComponent(window.FORM_KEY);
                    fileDisplay += ' <a href="' + dl + '" style="margin-left:8px; color:#0066cc; text-decoration:none;">⬇ Download</a>';
                }

                html += '<div><strong>File:</strong> ' + fileDisplay + '</div>';
                html += '<div><strong>Applied:</strong> ' + escapeHtml(summary.applied_count || 0) + ', <strong>Skipped:</strong> ' + escapeHtml(summary.skipped_count || 0) + ', <strong>Not Found:</strong> ' + escapeHtml(summary.not_found_count || 0) + ', <strong>Already Linked:</strong> ' + escapeHtml(summary.already_linked_count || 0) + '</div>';
                html += '<div><strong>Date:</strong> ' + escapeHtml(summary.created_at || '-') + '</div>';
                html += '</div>';
            });
            html += '</div></div>';
        }

        if (comments.length === 0) {
            html += '<p>No batch history entries found for this batch.</p>';
            $('#batch-history-content').html(html);
            return;
        }

        html += '<div style="display: grid; gap: 10px;">';
        comments.forEach(function(entry) {
            html += '<div style="padding: 12px; border: 1px solid #e1e1e1; border-radius: 6px; background: #fafafa;">';

            // Normalize label and user to avoid [object Object]
            var labelText = (typeof entry.label === 'string') ? entry.label : ((typeof entry.action === 'string') ? entry.action : JSON.stringify(entry.label));
            var userText = (typeof entry.user === 'string') ? entry.user : (entry.user && entry.user.username ? entry.user.username : JSON.stringify(entry.user));

            html += '<div><strong>' + escapeHtml(labelText) + '</strong>: ' + escapeHtml(userText || '-') + '</div>';

            // Display details if present
            if (entry.details && typeof entry.details === 'object') {
                let detailsHtml = '<div style="margin-top: 6px; padding: 6px; background: #f0f0f0; border-radius: 4px; font-size: 12px;">';

                if (entry.details.sku) {
                    detailsHtml += '<div><strong>SKU:</strong> ' + escapeHtml(entry.details.sku) + '</div>';
                }

                if (entry.details.file) {
                    // Show filename
                    detailsHtml += '<div><strong>File:</strong> ' + escapeHtml(entry.details.file);

                    // If a download path exists, show a simple clickable link
                    var downloadPath = entry.details.file_path || entry.details.file_path_rel || null;
                    if (!downloadPath && entry.details.file && entry.details.file.indexOf('/') !== -1) {
                        downloadPath = entry.details.file; // fallback if full path stored in file
                    }

                    if (downloadPath) {
                        let downloadUrl = '<?= $block->getUrl("brandinventory/data/download") ?>'
                            + '?file=' + encodeURIComponent(downloadPath)
                            + '&batch_id=' + encodeURIComponent(batchId)
                            + '&type=manual_match'
                            + '&form_key=' + encodeURIComponent(window.FORM_KEY);
                        detailsHtml += ' <a href="' + downloadUrl + '" style="margin-left: 8px; color: #0066cc; text-decoration: none; font-weight: bold;">⬇ Download</a>';
                    }

                    detailsHtml += '</div>';
                }

                if (entry.details.applied_count) {
                    detailsHtml += '<div><strong>Applied:</strong> ' + escapeHtml(entry.details.applied_count) + '/' + escapeHtml(entry.details.total_processed) + '</div>';
                }

                detailsHtml += '</div>';
                html += detailsHtml;
            }

            html += '<div style="margin-top: 6px; color: #555; font-size: 12px;">' + escapeHtml(entry.created_at || '-') + '</div>';
            html += '</div>';
        });
        html += '</div>';

        $('#batch-history-content').html(html);
    }

