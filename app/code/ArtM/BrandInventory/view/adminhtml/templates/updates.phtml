    // ===============================
    // ESCAPE HTML TO PREVENT XSS
    // ===============================
    function escapeHtml(text) {
        if (!text && text !== 0) return '';
        text = String(text);
        return text
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    // ===============================
    // APPLY FILTERS
    // ===============================
    function applyFilters() {
        filteredData = allSkuData.filter(function(row) {
        let productData = {};
        if (row.product_data) {
            try {
                productData = typeof row.product_data === 'string' ? JSON.parse(row.product_data) : row.product_data;
            } catch (e) {
                productData = {};
            }
        }

        // Dynamic sheet column filters
        if (currentSheetColumns && currentSheetColumns.length > 0) {
            let shouldInclude = true;
            
            currentSheetColumns.forEach(function(colName, index) {
                let filterVal = ($('#filter-sheet-' + index).val() || '').trim().toLowerCase();
                if (!filterVal) return;
                
                let lowerCol = colName.toLowerCase().replace(/\s+/g, '');
                let keys = Object.keys(productData);
                let matchedKey = keys.find(k => k.toLowerCase().replace(/\s+/g, '') === lowerCol);
                let cellValue = matchedKey ? String(productData[matchedKey]).toLowerCase() : '';
                
                if (!cellValue.includes(filterVal)) {
                    shouldInclude = false;
                }
            });
            
            if (!shouldInclude) return false;
        } else {
            // Default filters
            let styleGroupSearch = ($('#filter-style-group').val() || '').trim().toLowerCase();
            let genderFilter = $('#filter-gender').val();
            let sizeFilter = $('#filter-size').val();
            let brandSkuSearch = ($('#filter-brand-sku').val() || '').trim().toLowerCase();
            
            if (styleGroupSearch) {
                let sg = getCellValue(row, 'style_group').toLowerCase();
                if (!sg.includes(styleGroupSearch)) return false;
            }
            if (genderFilter) {
                let g = getCellValue(row, 'gender');
                if (g !== genderFilter) return false;
            }
            if (sizeFilter) {
                let s = getCellValue(row, 'size');
                if (s !== sizeFilter) return false;
            }
            if (brandSkuSearch) {
                let brandSku = getCellValue(row, 'brand_sku').toLowerCase();
                if (!brandSku.includes(brandSkuSearch)) return false;
            }
        }

        // Brand Qty filter
        let brandQtyOperator = $('#filter-brand-qty-operator').val();
        let brandQtyValue = $('#filter-brand-qty-value').val();
        if (brandQtyOperator && brandQtyValue !== '') {
            let qty = parseFloat(row.qty) || 0;
            let val = parseFloat(brandQtyValue);
            switch (brandQtyOperator) {
                case '<': if (!(qty < val)) return false; break;
                case '<=': if (!(qty <= val)) return false; break;
                case '=': if (!(qty === val)) return false; break;
                case '>=': if (!(qty >= val)) return false; break;
                case '>': if (!(qty > val)) return false; break;
            }
        }

        // Color filter
        let colorSearch = ($('#filter-color').val() || '').trim().toLowerCase();
        if (colorSearch) {
            let color = row.color || '';
            let pdColor = productData.color || productData.Color || '';
            if (!color.toLowerCase().includes(colorSearch) && !pdColor.toLowerCase().includes(colorSearch)) {
                return false;
            }
        }

        // Potential SKU filter
        let potentialSearch = ($('#filter-potential').val() || '').trim().toLowerCase();
        if (potentialSearch) {
            let allPotentialSkus = [];
            let raw = row.potential_sku || '';
            try {
                if (raw.trim().startsWith('[') && raw.trim().endsWith(']')) {
                    let decoded = JSON.parse(raw);
                    allPotentialSkus = Array.isArray(decoded) ? decoded : [String(decoded)];
                } else {
                    allPotentialSkus = raw ? [raw] : [];
                }
            } catch (e) {
                allPotentialSkus = raw ? [raw] : [];
            }
            let found = allPotentialSkus.some(function(ps) {
                return String(ps).toLowerCase().includes(potentialSearch);
            });
            if (!found) return false;
        }

        // Linked SKU filter
        let linkedSkuSearch = ($('#filter-linked-sku').val() || '').trim().toLowerCase();
        if (linkedSkuSearch && row.linked_sku) {
            if (!row.linked_sku.toLowerCase().includes(linkedSkuSearch)) return false;
        } else if (linkedSkuSearch && !row.linked_sku) {
            return false;
        }

        // Status filter
        let statusSearch = $('#filter-status').val();
        if (statusSearch) {
            let effectiveStatus = row.match_status || '';
            if (!effectiveStatus && row.linked_sku) {
                effectiveStatus = 'linked';
            } else if (!effectiveStatus) {
                effectiveStatus = 'pending';
            }
            if (effectiveStatus !== statusSearch) return false;
        }

        return true;
    });

    applySort();

    let totalQty = filteredData.reduce(function(sum, row) {
        return sum + (parseFloat(row.qty) || 0);
    }, 0);
    $('#sku-stats').text(`Matched: ${filteredData.length} of ${allSkuData.length} | Total Qty: ${totalQty}`);

    currentPage = 1;
    renderCurrentPage();
}

    // ===============================
    // SORTING
    // ===============================
    function applySort() {
        if (!sortColumn) return;
        filteredData.sort(function(a, b) {
            let valA = getCellValue(a, sortColumn).toLowerCase();
            let valB = getCellValue(b, sortColumn).toLowerCase();
            let numA = parseFloat(valA);
            let numB = parseFloat(valB);
            if (!isNaN(numA) && !isNaN(numB) && valA !== '' && valB !== '') {
                return sortDirection === 'asc' ? numA - numB : numB - numA;
            }
            if (valA < valB) return sortDirection === 'asc' ? -1 : 1;
            if (valA > valB) return sortDirection === 'asc' ? 1 : -1;
            return 0;
        });
    }

    function getCellValue(row, column) {
        switch(column) {
            case 'style_group':
                if (!row.product_data) return '-';
                try {
                    let data = typeof row.product_data === 'string' ? JSON.parse(row.product_data) : row.product_data;
                    const key = Object.keys(data).find(k => k.replace(/\s+/g, '').toLowerCase() === 'stylegroup');
                    return key ? data[key] : '-';
                } catch(e) { return '-'; }
            case 'brand_sku':
                if (!row.product_data) return '-';
                try {
                    let data = typeof row.product_data === 'string' ? JSON.parse(row.product_data) : row.product_data;
                    return data.style || data.Style || '-';
                } catch(e) { return '-'; }
            case 'gender':
                if (!row.product_data) return '-';
                try {
                    let data = typeof row.product_data === 'string' ? JSON.parse(row.product_data) : row.product_data;
                    return data.gender || data.Gender || '-';
                } catch(e) { return '-'; }
            case 'size': return row.size || '-';
            case 'qty': return row.qty || '0';
            case 'update_qty': return row.update_qty || '0';
            case 'color': return row.color || '-';
            case 'potential_sku':
            let rawPs = row.potential_sku || '-';
            try {
                if (String(rawPs).trim().startsWith('[') && String(rawPs).trim().endsWith(']')) {
                    let decoded = JSON.parse(rawPs);
                    return Array.isArray(decoded) ? decoded.join(', ') : String(rawPs);
                }
            } catch (e) {}
            return rawPs;
            case 'linked_sku': return row.linked_sku || '-';
            case 'match_status': return row.match_status || 'pending';
            default: return '';
        }
    }

    // ===============================
    // SORT CLICK
    // ===============================
    $(document).on('click', '.sortable-header', function() {
        let column = $(this).data('column');
        if (sortColumn === column) {
            sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
        } else {
            sortColumn = column;
            sortDirection = 'asc';
        }
        applyFilters();
    });

    // ===============================
    // COLUMN FILTER EVENTS - BLUR (FOCUS OUT) FOR TEXT, CHANGE FOR DROPDOWNS
    // ===============================
    
    // Text inputs: apply on blur (focus out) - preserves value visibility while typing
    $(document).on('blur', '#filter-style-group', function() { applyFilters(); });
    $(document).on('blur', '#filter-color', function() { applyFilters(); });
    $(document).on('blur', '#filter-potential', function() { applyFilters(); });
    $(document).on('blur', '#filter-linked-sku', function() { applyFilters(); });
    
    // Also allow Enter key to trigger filter immediately
    $(document).on('keypress', '#filter-style-group, #filter-color, #filter-potential, #filter-linked-sku', function(e) {
        if (e.which === 13) {
            $(this).blur();
            applyFilters();
        }
    });

    // Dropdowns: apply on change
    $(document).on('change', '#filter-gender', function() { applyFilters(); });
    $(document).on('change', '#filter-size', function() { applyFilters(); });
    $(document).on('change', '#filter-status', function() { applyFilters(); });

    // ===============================
    // UPDATE BUTTON (Linked SKU + Update Qty)
    // ===============================
   $(document).on('click', '.btn-update', function() {
    let $btn = $(this);
    let $row = $btn.closest('tr');
    let rowId = $row.data('id');
    let batchId = $row.data('batch');
    let linkedSku = $row.find('.linked-sku-input').val().trim();
    let updateQty = $row.find('.update-qty-input').val().trim();
    let originalSku = $row.find('.linked-sku-input').data('original');
    let originalQty = $row.find('.update-qty-input').data('original');

    // No changes
    if (linkedSku === originalSku && updateQty === originalQty) {
        alert('No changes to save');
        return;
    }

    // If linked SKU is being set/changed, check for duplicates first
    if (linkedSku && linkedSku !== originalSku) {
        $btn.prop('disabled', true).text('Checking...');

        $.ajax({
            url: '<?= $block->getUrl("brandinventory/data/updates") ?>',
            type: 'GET',
            data: {
                action: 'checkDuplicateSku',
                batch_id: batchId,
                linked_sku: linkedSku,
                exclude_id: rowId,
                form_key: window.FORM_KEY
            },
            success: function(checkRes) {
                if (checkRes.duplicate) {
                    // Show error with existing potential SKU info
                    let existing = checkRes.existing;
                    let potentialSkus = existing.potential_sku || '-';
                    
                    // Format potential SKUs for display
                    let displaySkus = potentialSkus;
                    try {
                        let decoded = JSON.parse(potentialSkus);
                        if (Array.isArray(decoded)) {
                            displaySkus = decoded.join(', ');
                        }
                    } catch(e) {}

                    let errorHtml = `
                        <div style="text-align:left;">
                            <h3 style="color:#dc3545; margin-bottom:10px;">❌ Duplicate SKU</h3>
                            <p><strong>${checkRes.message}</strong></p>
                            <hr style="margin:10px 0;">
                            <p><strong>Already linked to:</strong></p>
                            <ul style="margin:5px 0; padding-left:20px;">
                                <li><strong>Potential SKU:</strong> ${escapeHtml(displaySkus)}</li>
                                <li><strong>Size:</strong> ${escapeHtml(existing.size || '-')}</li>
                                <li><strong>Color:</strong> ${escapeHtml(existing.color || '-')}</li>
                                <li><strong>Row ID:</strong> ${existing.entity_id}</li>
                            </ul>
                        </div>
                    `;

                    // Use a nicer alert or modal
                    alert(`❌ ${checkRes.message}\n\nAlready linked to:\nPotential SKU: ${displaySkus}\nSize: ${existing.size || '-'}\nColor: ${existing.color || '-'}\nRow ID: ${existing.entity_id}`);

                    // Highlight the conflicting row if visible
                    highlightConflictingRow(existing.entity_id);

                    $btn.prop('disabled', false).text('Update');
                    return;
                }

                // No duplicate, proceed with save
                doSaveUpdate($btn, $row, rowId, linkedSku, updateQty);
            },
            error: function() {
                alert('Error checking duplicate SKU');
                $btn.prop('disabled', false).text('Update');
            }
        });
    } else {
        // No linked SKU change, just save
        doSaveUpdate($btn, $row, rowId, linkedSku, updateQty);
    }
});
/**
 * Actual save function
 */
    function doSaveUpdate($btn, $row, rowId, linkedSku, updateQty) {
    $btn.prop('disabled', true).text('Saving...');

    // Remove any old inline messages from this row
    $row.find('.sync-warning-msg').remove();

    $.ajax({
        url: '<?= $block->getUrl("brandinventory/data/updates") ?>',
        type: 'POST',
        data: {
            action: 'update',
            id: rowId,
            linked_sku: linkedSku,
            update_qty: updateQty,
            form_key: window.FORM_KEY
        },
        success: function(res) {
            if (res.success) {
                $row.find('.linked-sku-input').data('original', linkedSku);
                $row.find('.update-qty-input').data('original', updateQty);

                let $qtyInput = $row.find('.update-qty-input');
                $qtyInput.addClass('updated-success');
                setTimeout(() => $qtyInput.removeClass('updated-success'), 1500);

                let $statusCell = $row.find('.match-status');
                if (linkedSku) {
                    $statusCell.text('✎ Manual')
                        .removeClass('status-pending status-sync status-linked')
                        .addClass('status-manual');
                } else {
                    $statusCell.text('✗ Pending')
                        .removeClass('status-manual status-sync status-linked')
                        .addClass('status-pending');
                }

                let dataIndex = allSkuData.findIndex(r => r.entity_id == rowId);
                if (dataIndex > -1) {
                    allSkuData[dataIndex].linked_sku = linkedSku;
                    allSkuData[dataIndex].update_qty = updateQty;
                    allSkuData[dataIndex].match_status = linkedSku ? 'manually_updated' : 'pending';
                }

                // ✅ Handle sync failure vs full success
                if (res.synced === false) {
                    // Extract clean error from message
                    let syncError = res.message.includes('(') 
                        ? res.message.match(/\(([^)]+)\)/)?.[1] 
                        : 'Magento sync failed';

                    // Show orange button
                    $btn.text('Saved ⚠').css('background', '#fd7e14');

                    // Add small inline message below the buttons
                    let $actionCell = $btn.closest('td');
                    $actionCell.append(
                        `<div class="sync-warning-msg" style="margin-top:6px;padding:4px 8px;background:#fff3cd;border:1px solid #ffc107;border-radius:4px;color:#856404;font-size:11px;line-height:1.3;">
                            ⚠️ Saved but <b>not synced</b><br>
                            <span style="color:#dc3545;">${escapeHtml(syncError)}</span>
                        </div>`
                    );

                    setTimeout(() => {
                        $btn.prop('disabled', false).text('Update').css('background', '');
                        $row.find('.sync-warning-msg').fadeOut(400, function(){ $(this).remove(); });
                    }, 4000);
                } else {
                    // Full success
                    $btn.text('Updated').css('background', '#28a745');
                    setTimeout(() => {
                        $btn.prop('disabled', false).text('Update').css('background', '');
                    }, 1500);
                }

                updateMatchSummary();
            } else if (res.duplicate) {
                let existing = res.existing;
                let displaySkus = existing.potential_sku || '-';
                try {
                    let decoded = JSON.parse(displaySkus);
                    if (Array.isArray(decoded)) displaySkus = decoded.join(', ');
                } catch(e) {}
                
                alert(`❌ ${res.message}\n\nAlready linked to Potential SKU: ${displaySkus}\nSize: ${existing.size || '-'}\nColor: ${existing.color || '-'}`);
                $btn.prop('disabled', false).text('Update');
            } else {
                alert(res.message || 'Update failed');
                $btn.prop('disabled', false).text('Update');
            }
        },
        error: function() {
            alert('Error saving data');
            $btn.prop('disabled', false).text('Update');
        }
    });
}

/**
