    function renderDbTable(data, showNoResultsMsg, showResetMsg, showNoRecordsAvailable) {
        console.log('Rendering table with data:', data);
        let html = '';

        if (showResetMsg) {
            html += '<p class="no-data" style="background:#fff3cd;color:#856404;border:1px solid #ffeaa7;padding:10px;margin-bottom:10px;border-radius:4px;">⚠ No data found matching your filters — showing all records instead.</p>';
        }

        if (showNoResultsMsg) {
            html += '<p class="no-data">No data found matching your filters</p>';
            $('#result-container').html(html);
            return;
        }

        if (showNoRecordsAvailable) {
            html += '<p class="no-data">No records available</p>';
            $('#result-container').html(html);
            return;
        }

        if (!data || data.length === 0) {
            html += '<p class="no-data">No records available</p>';
            $('#result-container').html(html);
            return;
        }

        // ✅ BUILD DYNAMIC COLUMNS
        let columns = buildDynamicColumns();

        // ✅ COLUMN VISIBILITY TOGGLE BAR
        html += buildColumnToggleBar(columns);

        // ✅ TABLE
        html += `<table class="admin__table-primary" id="sku-data-table"><thead><tr>`;

        columns.forEach(function(col) {
            // Only show if visible
            if (!isColumnVisible(col.key)) return;

            let sortIcon = '';
            let activeClass = '';
            let tooltipHtml = '';

            if (sortColumn === col.key) {
                sortIcon = sortDirection === 'asc' ? ' ▲' : ' ▼';
                activeClass = ' sorted-active';
            }

            if (col.key === 'match_status') {
                tooltipHtml = ` <span class="header-tooltip" title="pending = Not yet synced&#10;not_found = No Magento SKU found&#10;manually_updated = User entered via UI&#10;updated_via_sheet = Bulk CSV upload&#10;table_matched = Found via lookup table&#10;sync_matched = Auto-matched in Magento&#10;duplicate_record_found = SKU already in use">ℹ️</span>`;
            }
            
            html += `<th class="sortable-header${activeClass}" data-column="${col.key}">${col.label}${sortIcon}${tooltipHtml}</th>`;
        });

        html += `</tr>`;

        // ✅ FILTER ROW — only for visible columns
        html += buildDynamicFilterRow(columns);
        html += `</thead><tbody>`;

        // ROWS
        data.forEach((row) => {
            html += renderDynamicRow(row, columns);
        });

        html += '</tbody></table>';
        $('#result-container').html(html);
    }

    function buildColumnToggleBar(columns) {
        let html = '<div id="column-toggle-bar" style="margin-bottom: 15px; padding: 10px; background: #f8f9fa; border: 1px solid #ddd; border-radius: 4px;">';
        html += '<div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">';
        html += '<strong style="font-size: 13px;">📊 Columns:</strong>';
        
        // "Show All" / "Show Default" buttons
        html += '<button id="btn-show-default" class="btn btn-small btn-secondary" style="font-size: 11px; padding: 3px 8px;">Default</button>';
        html += '<button id="btn-show-all" class="btn btn-small btn-secondary" style="font-size: 11px; padding: 3px 8px;">Show All</button>';
        
        html += '<span style="color: #666; font-size: 11px;">| Click to toggle:</span>';
        
        // Individual column toggles
        columns.forEach(function(col) {
            if (col.key === 'action') return; // Always show action column
            
            let isVisible = isColumnVisible(col.key);
            let activeClass = isVisible ? 'btn-primary' : 'btn-secondary';
            let opacity = isVisible ? '1' : '0.6';
            
            html += `<button class="btn btn-small column-toggle-btn ${activeClass}" 
                data-column="${col.key}" 
                style="font-size: 11px; padding: 3px 10px; opacity: ${opacity};">
                ${isVisible ? '✓' : ''} ${col.label}
            </button>`;
        });
        
        html += '</div></div>';
        return html;
    }

    function buildDynamicColumns() {
        let columns = [];
        
        // If we have sheet columns from the uploaded file, use them
        if (currentSheetColumns && currentSheetColumns.length > 0) {
            currentSheetColumns.forEach(function(colName, index) {
                let key = 'sheet_col_' + index;
                let label = colName;
                
                // Map known columns to friendly keys for sorting/filtering
                let lowerCol = colName.toLowerCase().replace(/\s+/g, '');
                
                if (lowerCol.includes('style') && lowerCol.includes('group')) {
                    key = 'style_group';
                } else if (lowerCol === 'style' || lowerCol === 'stylecode') {
                    key = 'brand_sku';
                } else if (lowerCol.includes('gender')) {
                    key = 'gender';
                } else if (lowerCol.includes('size')) {
                    key = 'size';
                } else if (lowerCol.includes('color') || lowerCol.includes('colour')) {
                    key = 'color';
                } else if (lowerCol.includes('qty') || lowerCol.includes('quantity') || lowerCol.includes('balance') || lowerCol.includes('stock')) {
                    key = 'qty';
                } else if (lowerCol.includes('location')) {
                    key = 'location';
                 }
                
                columns.push({ key: key, label: label, sheetIndex: index });
            });
        } else {
            // Fallback to default columns
            columns = [
                { key: 'style_group', label: 'Style Group' },
                { key: 'brand_sku', label: 'Brand SKU' },
                { key: 'gender', label: 'Gender' },
                { key: 'size', label: 'Size' },
                { key: 'qty', label: 'Brand Qty' }
            ];
        }

        // Always add these fixed columns at the end
        columns.push(

            // { key: 'qty', label: 'Brand Qty' },
            { key: 'style', label: 'Sku' },
            { key: 'potential_sku', label: 'Potential SKU' },
            { key: 'linked_sku', label: 'Linked SKU' },
            { key: 'update_qty', label: 'Update Qty' },
            { key: 'match_status', label: 'Match Status' },
            { key: 'action', label: 'Action' }
        );

        return columns;
    }

