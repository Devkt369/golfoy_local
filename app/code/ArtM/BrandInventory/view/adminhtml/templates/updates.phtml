    // ===============================
    // PAGINATION
    // ===============================
    // Track active reset timeout to prevent stacking
let filterResetTimeout = null;

function renderCurrentPage() {
    let totalRecords = filteredData.length;
    let totalPages = Math.ceil(totalRecords / perPage) || 1;
    let showResetMsg = false;

    // If active filters returned nothing, show message then auto-reset after delay
    if (filteredData.length === 0 && allSkuData.length > 0) {
        // Render the "No records available" message immediately
        renderDbTable([], false, false, true);
        renderPagination(1, 1, 0);
        
        // Clear any existing pending reset
        if (filterResetTimeout) clearTimeout(filterResetTimeout);
        
        // Auto-clear filters after 2.5 seconds and show all data
        filterResetTimeout = setTimeout(function() {
            // Clear all filter inputs
            $('#filter-style-group').val('');
            $('#filter-brand-sku').val('');
            $('#filter-gender').val('');
            $('#filter-size').val('');
            $('#filter-brand-qty-operator').val('');
            $('#filter-brand-qty-value').val('');
            $('#filter-color').val('');
            $('#filter-potential').val('');
            $('#filter-linked-sku').val('');
            $('#filter-status').val('');

            // Reset to full dataset
            filteredData = [...allSkuData];
            currentPage = 1;
            applySort();
            renderCurrentPage();
        }, 2500);
        
        return;
    }

    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;
    let start = (currentPage - 1) * perPage;
    let end = start + perPage;

    let pageData = filteredData.slice(start, end);
    //console.log('pageData:', pageData);
    renderDbTable(pageData, false, false, false);
    renderPagination(currentPage, totalPages, totalRecords);
}

    function renderPagination(current, total, totalRecords) {
        let html = '';
        if (total <= 1) { $('#pagination').html(html); return; }
        html += '<div class="custom-pagination">';
        html += `<span class="page-info">Page ${current} of ${total} (${totalRecords} records)</span>`;
        if (current > 1) html += `<button class="page-btn" data-page="${current - 1}">Prev</button>`;
        html += `<button class="page-btn ${current === 1 ? 'active' : ''}" data-page="1">1</button>`;
        if (current > 4) html += `<span class="dots">...</span>`;
        let start = Math.max(2, current - 2), end = Math.min(total - 1, current + 2);
        for (let i = start; i <= end; i++) html += `<button class="page-btn ${i === current ? 'active' : ''}" data-page="${i}">${i}</button>`;
        if (current < total - 3) html += `<span class="dots">...</span>`;
        if (total > 1) html += `<button class="page-btn ${current === total ? 'active' : ''}" data-page="${total}">${total}</button>`;
        if (current < total) html += `<button class="page-btn" data-page="${current + 1}">Next</button>`;
        html += '</div>';
        $('#pagination').html(html);
    }

