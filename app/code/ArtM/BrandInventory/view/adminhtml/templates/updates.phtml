    function renderDynamicRow(row, columns) {
        console.log('Rendering row:', row);
        console.log(row.location);
        let rowId = row.entity_id;
        let html = `<tr data-id="${rowId}" data-batch="${currentBatchId}" data-file="${currentFileName}">`;
        
        // Parse product_data
        let productData = {};
        if (row.product_data) {
            try {
                productData = typeof row.product_data === 'string' ? JSON.parse(row.product_data) : row.product_data;
            } catch (e) {
                productData = {};
            }
        }

        // Render each column only if visible
        columns.forEach(function(col) {
            if (!isColumnVisible(col.key)) return;

            switch(col.key) {
                case 'style_group':
                    let styleGroup = '-';
                    if (row.product_data) {
                        try {
                            let data = typeof row.product_data === 'string' ? JSON.parse(row.product_data) : row.product_data;
                            const key = Object.keys(data).find(k => k.replace(/\s+/g, '').toLowerCase() === 'stylegroup');
                            styleGroup = key ? data[key] : '-';
                        } catch(e) { styleGroup = '-'; }
                    }
                    if (styleGroup === '-' && row.style_code) styleGroup = row.style_code;
                    html += `<td>${styleGroup}</td>`;
                    break;

                case 'brand_sku':
                    let brandSku = '-';
                    if (row.product_data) {
                        try {
                            let data = typeof row.product_data === 'string' ? JSON.parse(row.product_data) : row.product_data;
                            brandSku = data.style || data.Style || '-';
                        } catch(e) { brandSku = '-'; }
                    }
                    if (brandSku === '-' && row.style) brandSku = row.style;
                    html += `<td>${brandSku}</td>`;
                    break;

                case 'gender':
                    let gender = '-';
                    if (row.product_data) {
                        try {
                            let data = typeof row.product_data === 'string' ? JSON.parse(row.product_data) : row.product_data;
                            gender = data.gender || data.Gender || '-';
                        } catch(e) { gender = '-'; }
                    }
                    html += `<td>${gender}</td>`;
                    break;

                case 'size':
                    html += `<td>${row.size || '-'}</td>`;
                    break;

                case 'qty':
                    html += `<td>${row.qty || '0'}</td>`;
                    break;
                case 'style':
                    html += `<td>${row.style || '-'}</td>`;
                    break;

                case 'update_qty':
                    html += `<td>
                        <input type="number" class="update-qty-input" value="${row.update_qty || '0'}" min="0" data-original="${row.update_qty || '0'}" data-id="${rowId}" />
                    </td>`;
                    break;

                case 'color':
                    html += `<td>${row.color || '-'}</td>`;
                    break;

                case 'potential_sku':
                    let potentialSkuHtml = renderPotentialSkus(row);
                    html += `<td class="potential-sku">${potentialSkuHtml || '-'}</td>`;
                    break;

                case 'linked_sku':
                    html += `<td>
                        <input type="text" class="linked-sku-input" value="${row.linked_sku || ''}" placeholder="Enter SKU..." data-original="${row.linked_sku || ''}" />
                    </td>`;
                    break;

                case 'match_status':
                    let matchStatus = row.match_status || '';
                    let matchClass = '';
                    if (!matchStatus && row.linked_sku) {
                        matchStatus = 'linked';
                        matchClass = 'status-linked';
                    } else if (!matchStatus) {
                        matchStatus = 'pending';
                        matchClass = 'status-pending';
                    } else {
                        switch (matchStatus) {
                            case 'manually_updated':
                            case 'updated_via_sheet':
                                matchClass = 'status-manual';
                                break;
                            case 'duplicate_record_found':
                                matchClass = 'status-duplicate';
                                break;
                            case 'table_matched':
                                matchClass = 'status-table';
                                break;
                            case 'sync_matched':
                                matchClass = 'status-sync';
                                break;
                            default:
                                matchClass = 'status-default';
                        }
                    }
                    html += `<td class="match-status ${matchClass}" id="status-${rowId}">${matchStatus}</td>`;
                    break;

                case 'location':
                    let locationHtml = '-';
                    if (row.location) {
                        try {
                            let locations = typeof row.location === 'string' ? JSON.parse(row.location) : row.location;
                            
                            if (Array.isArray(locations) && locations.length > 0) {
                                // Array format: [{location: 'DELHI', limit_value: 3, availability: 'OK'}, ...]
                                locationHtml = locations.map(function(loc) {
                                    let badge = loc.availability === 'OK' 
                                        ? '<span style="color:#28a745;">✓</span>' 
                                        : '<span style="color:#fd7e14;">⚠</span>';
                                    return `<div style="font-size:11px; margin-bottom:2px;">
                                        ${badge} <strong>${escapeHtml(loc.location)}</strong>: ${loc.limit_value} (${escapeHtml(loc.availability)})
                                    </div>`;
                                }).join('');
                            } else if (locations && typeof locations === 'object') {
                                // Object format: {"DELHI": {"LIMIT VALUE": 3, "AVAILABILITY": "LTD"}, ...}
                                locationHtml = Object.keys(locations).map(function(locName) {
                                    let loc = locations[locName];
                                    let availability = loc.AVAILABILITY || loc.availability || '-';
                                    let limitValue = loc['LIMIT VALUE'] || loc.limit_value || loc.limitValue || '-';
                                    let badge = availability === 'OK' 
                                        ? '<span style="color:#28a745;">✓</span>' 
                                        : '<span style="color:#fd7e14;">⚠</span>';
                                    return `<div style="font-size:11px; margin-bottom:2px;">
                                        ${badge} <strong>${escapeHtml(locName)}</strong>: ${limitValue} (${escapeHtml(availability)})
                                    </div>`;
                                }).join('');
                            }
                        } catch (e) {
                            locationHtml = escapeHtml(row.location);
                        }
                    }
                html += `<td class="location-cell">${locationHtml}</td>`;
                break;

                case 'action':
                    html += `<td>
                        <button class="btn btn-update" data-id="${rowId}">Update</button>
                        <button class="btn btn-remove" data-id="${rowId}">Remove</button>
                    </td>`;
                    break;

                default:
                    // Dynamic sheet columns
                    if (col.sheetIndex !== undefined) {
                        let colName = currentSheetColumns[col.sheetIndex];
                        let lowerCol = colName.toLowerCase().replace(/\s+/g, '');
                        let keys = Object.keys(productData);
                        let matchedKey = keys.find(k => k.toLowerCase().replace(/\s+/g, '') === lowerCol);
                        let value = matchedKey ? productData[matchedKey] : '-';
                        html += `<td>${escapeHtml(value || '-')}</td>`;
                    } else {
                        html += `<td>-</td>`;
                    }
            }
        });

        html += `</tr>`;
        return html;
    }
    
function renderPotentialSkus(row) 
{
    let rawPotential = row.potential_sku || '';
    let linkedSku = (row.linked_sku || '').trim().toUpperCase();
    let potentialSkus = [];

    if (rawPotential) {
        try {
            if (rawPotential.trim().startsWith('[')) {
                let decoded = JSON.parse(rawPotential);
                if (Array.isArray(decoded)) {
                    potentialSkus = decoded.map(s => String(s).trim()).filter(s => s);
                } else {
                    potentialSkus = [String(decoded).trim()];
                }
            } else if (rawPotential.includes(',')) {
                potentialSkus = rawPotential.split(',').map(s => s.trim()).filter(s => s);
            } else {
                potentialSkus = [rawPotential.trim()];
            }
        } catch (e) {
            if (rawPotential.includes(',')) {
                potentialSkus = rawPotential.split(',').map(s => s.trim()).filter(s => s);
            } else {
                potentialSkus = [rawPotential.trim()];
            }
        }
    }

    if (potentialSkus.length > 0) {
        return potentialSkus.map(function(ps) {
            let cleanPs = String(ps).trim();
            let isMatched = linkedSku.length > 0 && cleanPs.toUpperCase() === linkedSku;
            
            if (isMatched) {
                return `<strong style="color:#155724;background:#d4edda;padding:3px 8px;border-radius:4px;border:2px solid #28a745;font-weight:bold;">${escapeHtml(cleanPs)}</strong>`;
            }
            return `<span>${escapeHtml(cleanPs)}</span>`;
        }).join(', ');
    }
    return '-';
}


