                            <option value="=" ${($('#filter-brand-qty-operator').val() === '=') ? 'selected' : ''}>=</option>
                            <option value=">=" ${($('#filter-brand-qty-operator').val() === '>=') ? 'selected' : ''}>&gt;=</option>
                            <option value=">" ${($('#filter-brand-qty-operator').val() === '>') ? 'selected' : ''}>&gt;</option>
                        </select>
                        <input type="number" id="filter-brand-qty-value" placeholder="Qty" class="column-filter-input" style="width:50%; display:inline-block; margin-left:5px;" value="${escapeHtml($('#filter-brand-qty-value').val() || '')}" min="0" />
                    </div>
