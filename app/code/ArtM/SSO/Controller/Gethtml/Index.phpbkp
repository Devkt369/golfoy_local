    public function forgot_password_validation($formData)
    {

        if (isset($_COOKIE['forgot-password-mobilenumber'])) {
            $forgotPassPhoneNumber = $_COOKIE['forgot-password-mobilenumber'];
            $otpValidationResponse = $this->_data->validateOTP($formData, $forgotPassPhoneNumber);
            if ($otpValidationResponse == 'true' || $otpValidationResponse == 'false') {
                $html = '<button class="revert-back" id="back-to-use_email">Back</button>
                    <div class="sign-up-form-detials">
                            <div class="login-heading">
                                <h3>Reset your password</h3>
                            </div>
                            <div class="forgot-password-form-content">
                                <form action="" method="post"  id="forgot_password_enter">
                                    <label for="newPassword">New Password</lable>
                                    <input type="password" name="password" class="password-input1" placeholder="Password" required>
                                    <span toggle="#password-field" class="fa fa-fw fa-eye-slash field_icon toggle-password"></span>
                                    <label for="newPassword">Confirm Password</lable>
                                    <input type="password" name="password" class="password-input2" placeholder="Confirm Password " required>
                                    <input type="hidden" name="pagetype" value="set_new_password">
                                    <button type="submit" class="button-submit" id="validate-password">Verify Password</button>
                                </form>
                            </div>
                        </div>';
                return $html;
            } else {
                $forgotUserEmail = $_COOKIE['forgot-password-user-email'];
                // <input type='number' oninput='javascript: if (this.value.length > 6) this.value = this.value.slice(0, 6);' name='otp' class='otp-input' id='forgot-password-otpvalidation' placeholder='Enter OTP' inputmode='numeric' autocomplete='one-time-code' required>
                $html = "<button class='revert-back' id='back-to-forgot_password'>Back</button>
                        <div class='sign-up-forms-details'> 
                            <div class='enter_otpsignonform'>
                                <div class='login-heading'>
                                    <h3>Almost There</h3>
                                    <p>Hi " . $forgotUserEmail . "</p>
                                    <p>Please enter the 6 digit OTP that we just sent on +91-" . $forgotPassPhoneNumber . "</p>
                                    <p class='error'>OTP not valid</p>
                                </div>
                                <div class='sign-up-content'>
                                    <form action='' method='post' id='forgot_password_otp_form'>
                                        <div class='input_field_box'>
                                            <input type='number' oninput='javascript: if (this.value.length > 6) this.value = this.value.slice(0, 6);' class='otp_input_field'/>
                                            <input type='number' class='hide' />
                                            <input type='number' class='hide' />
                                            <input type='number' class='hide' />
                                            <input type='number' class='hide' />
                                            <input type='number' class='hide' />
                                        </div>
                                        <input type='hidden' value='forgot_password_validation'>
                                        <div id='resend_otp_forgot'>Resend OTP</div>
                                        <button type='submit' class='button-submit' id='submitotp'>Verify OTP</button>
                                    </form>
                                </div>
                            </div>
                        </div>";
                return $html;
            }
        } else {
            $html = '<button class="revert-back" id="back-to-use_email">Back</button>
                        <div class="sign-up-forms-details">
                            <div class="login-heading">
                            <img src="https://golfoy.com/media/logo/stores/1/Golfoy.png" title="Golfoy.com: India Online Golf Shop" alt="Golfoy.com India Online Golf Shop" width="403" height="103">         

                            <p>Please enter your mobile number to <br> Sign In / Sign Up</p>
                                <p class="error">Something went wrong. Please try again.</p>
                            </div>
                            <div class="mobile-number-login-create">
                                <form action="" method="post" id="forgot-password">
                                    <div class="mobile-number-login">+91</div>
                                    <input type="text" inputmode="numeric" maxlength="10" oninput="javascript: if (this.value.length > 10) this.value = this.value.slice(0, 10);"  class="new-mobile-number" name="mobileNumber" placeholder="Enter Mobile Number" autocomplete="off" id="forgot-password-mobile" required>
                                    <input type="hidden" name="pagetype" value="forgot_password_otp" class="new-number-pagetype">
                                    <div id="resend_otp_forgot">Resend OTP</div>
