    public function enter_number()
    {
        if (isset($_COOKIE['new-user-email'])) {
            $newEmail = $_COOKIE['new-user-email'];

            $html = '<button class="revert-back" id="back-to-enter_email">Back</button><div class="sign-up-forms-details">
                            <div class="mobile-number-login-create">
                            <div class="login-heading">
                                <h4>Create an account</h4>
                                <p class="error"> Your are not register with this email ' . $newEmail . '</p>
                            </div>
                                <form action="" method="post" id="create-account-otp">
