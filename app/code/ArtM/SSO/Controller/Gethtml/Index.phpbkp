    public function enter_otp_registration($formData)
    {
        if (isset($_COOKIE['new-user-email']) && isset($_COOKIE['new-user-email-password'])) {

            if ($this->_data->isMobileNumberRegistered($formData) !== false) {
                setcookie('userid', '', time() - 3600, '/');
                setcookie('userid', $formData, time() + 300, '/');
                $newEmail = $_COOKIE['new-user-email'];

                $html = '<button class="revert-back" id="back-to-enter_email">Back</button><div class="sign-up-forms-details">
