    public function valid_otp($formData)
    {
        if (isset($_COOKIE['userid'])) {
            $userId = $_COOKIE['userid'];
        } else {
            return $this->signon();
        }

        $errorMessage = $this->_data->validateOTP($formData, $userId);
        if ($errorMessage !== null) {

            if ($errorMessage == 'true' || $errorMessage == 'false') {
                //isMobileNumberRegistered
                if ($this->_data->isMobileNumberRegistered($userId)) {
                    if ($this->customerLogin($userId)) {
                        $html = "<div class='enter_phone'>valid</div>";
                        return '<h2 class="login-successful">Login Successful</h2><img class="success_image" src="https://golfoy.com/media/sales/download.gif"><h3 class="signup-line">You are successfully logged in</h3>';
                    }
                } else {
                    if (isset($_COOKIE['new-user-email-password']) && isset($_COOKIE['new-user-email'])) {

                        return $this->enter_golfoy($_COOKIE['new-user-email']);
                    } else {
                        $dummyData = '';
                        return $this->create_email($dummyData);
                    }
                }

                // Perform further operations with $position
            } elseif ($errorMessage == 'OTP_NOT_VALIDE' || $errorMessage == 'OTP_EXPIRED') {
                // <input type='text' name='otp' oninput='javascript: if (this.value.length > 6) this.value = this.value.slice(0, 6);' class='otp-input' id='otpvalidation' placeholder='Enter OTP' inputmode='numeric' autocomplete='one-time-code' required>
                $html = "<div class='sign-up-forms-details'> 
                            <div class='enter_otpsignonform'>
                                <div class='login-heading'>
                                    <h3>Almost There</h3>
                                    <p>Please enter the 6 digit OTP that we just sent on +91- " . $userId . "</p>
                                    <p class='error'>OTP not valid</p>
                                </div>
                                <div class='sign-up-content'>
                                    <form action='' method='post' id='otp_form'>
                                        <div class='input_field_box'>
                                            <input type='number' oninput='javascript: if (this.value.length > 6) this.value = this.value.slice(0, 6);' class='otp_input_field'/>
                                            <input type='number' class='hide' />
                                            <input type='number' class='hide' />
                                            <input type='number' class='hide' />
                                            <input type='number' class='hide' />
                                            <input type='number' class='hide' />
                                        </div>
                                        <div class='edit-button'>
                                        <h2 id='edit_number'>Edit Number</h2>
                                        <h2 id='resend_otp'>Resend OTP</h2>
                                        </div>
                                        <button type='submit' class='button-submit' id='submitotp'>Verify OTP</button>
                                    </form>
                                </div>
                            </div>
                        </div>";
                return $html;
            } else {
                $dummyData = '';
                return $this->create_email($dummyData);
            }
        } else {
            $html = "<div class='enter_otpsignonform'>OTP not valid
                               
                        <form action='' method='post' id='otp_form'>
                            <input type='text' name='otp' class='otp-input' placeholder='Enter OTP' inputmode='numeric' autocomplete='one-time-code' required>
                            <div class='edit-button'>
                            <div id='edit_number'>Edit Number</div>
                            <div id='resend_otp'>Resend OTP</div>
                            </div>
                            <button type='submit' class='button-submit' id='submitotp'>Verify OTP</button>
                        </form>
                        
                    </div>";
            return $html;
        }
    }
    public function create_email($formData)
    {
        setcookie('new-user-email', '', time() - 3600, '/');

        // if (!filter_var($formData, FILTER_VALIDATE_EMAIL)){
        //     return $this->signon();
        // }else{
        // }
        setcookie('new-user-email', $formData, time() + 300, '/');

        if (isset($_COOKIE['userid'])) {
            $currentTimeStamp = time();
            $html = "<button class='revert-back' id='back-to-use_number'>Back</button>
                    <div class='enter_email'>                    
                        <form action='' method='post'  id='create_email'>
                        <div class='login-heading'>
                            <h3>Almost There</h3>
                            <p>Your are not register with this phone number " . $_COOKIE['userid'] . "</p>
                        </div>
                        <div class='form-group'>
                            <input type='text' name='firstname' placeholder='Enter Name' class='first-name'>
                            <lable for='firstname' class='first-name-label'>First Name</lable>
                        </div>
                            <div class='form-group'>
                                <input type='email' name='email' class='email-input' id='notregisteredemail' placeholder='Enter email'>
                                <label for='email' class='email-label'>Email Address</label>
                            </div>
                            <input type='hidden' name='password' value=" . $currentTimeStamp . " id='notregisteredemailpassword' class='password-input' placeholder='Password' required>
                            <span toggle='#password-field' class='fa fa-fw fa-eye-slash field_icon toggle-password'></span>
                            <input type='hidden' name='pagetype' value='enter_golfoy'>
                                                                
                            <div class='terms-condition-content'>
                                    <p>On Clicking Log In, I agree to <a href='https://golfoy.com/terms-and-conditions' class='acnhor_page'>Terms of Service </a>& <a href='https://golfoy.com/privacy-policy-cookie-restriction-mode'
                                    class='acnhor_page'>Privacy Policy </a>
                                </div>
                            <button type='submit' class='button-submit' class='log_in'>Log In</button>
                        </form>        
                    </div>";
            return $html;
        } else {
            return $this->signon();
        }
    }
    public function enter_golfoy($username)
    {
        //setcookie('new-user-email', $username, time() + 300, '/');

        if ($this->_data->isMobileNumberRegisteredOnThisEmail($username, $_COOKIE['userid']) == 'set_phone_number') {
            if ($this->customerLogin($_COOKIE['userid'])) {
                $html = "<div class='enter_phone'>valid</div>";
                return '<h2 class="login-successful">Login Successful</h2><img class="success_image" src="https://golfoy.com/media/sales/download.gif"><h3 class="signup-line">You are successfully logged in</h3>';
            }
        } elseif ($this->_data->isMobileNumberRegisteredOnThisEmail($username, $_COOKIE['userid']) == false) {
            // return $this->create_email($username);
            $currentTimeStamp = time();
            $html = "<button class='revert-back' id='back-to-use_number'>Back</button>
                    <div class='enter_email'>                    
                        <form action='' method='post'  id='create_email'>
                        <div class='login-heading'>
                            <h3>Almost There</h3>
                            <p>Your are not register with this phone number " . $_COOKIE['userid'] . "</p>
                            <p class='error hide'>This email already registered.</p>
                        </div>
                        <div class='form-group'>
                            <input type='text' name='firstname' placeholder='Enter Name' class='first-name'>
                            <lable for='firstname' class='first-name-label'>First Name</lable>
                        </div>
                        <div class='form-group'>
                            <input type='email' name='email' class='email-input' id='notregisteredemail' placeholder='Enter email'>
                            <lable for='email' class='email-label'>E-Mail Address</lable>
                        </div>
                            
                            <input type='hidden' name='password' value=" . $currentTimeStamp . "  id='notregisteredemailpassword' class='password-input' placeholder='Password' required>
                            <span toggle='#password-field' class='fa fa-fw fa-eye-slash field_icon toggle-password'></span>
                            <input type='hidden' name='pagetype' value='enter_golfoy'>
                                                                
                            <div class='terms-condition-content'>
                            <p>On Clicking Log In, I agree to <a href='https://golfoy.com/terms-and-conditions' class='acnhor_page'>Terms of Service </a>& <a href='https://golfoy.com/privacy-policy-cookie-restriction-mode'
                            class='acnhor_page'>Privacy Policy </a>
                        </div>
                            <button type='submit' class='button-submit' class='log_in'>Log In</button>
                        </form>        
                    </div>";
            return $html;
        } else {
            //$new_user_email = $_COOKIE['new-user-email'];
            if (isset($_COOKIE['new-user-email'])) {
                $new_user_email = $_COOKIE['new-user-email'];
                $userNumber = $_COOKIE['userid'];
            } else {
                return "Something went Wrong please try again !!";
            }
            $userpassword = $_COOKIE['new-user-email-password'];
            $userName = $_COOKIE['new-user-name'];
            $postData['email'] = $new_user_email;
            $postData['phone'] = $userNumber;
            $postData['name'] = $userName;
            $passwordModification = substr($userName, 0, 2) . '-' . $userpassword . '-' . substr($userNumber, -4);
            $postData['password'] = $passwordModification;
            $currentWebsiteId = $this->storeManager->getStore()->getWebsiteId();


            $createCustomerStatus = $this->_data->createAccount($postData, $currentWebsiteId);
            if ($createCustomerStatus) {

                if ($this->customerLogin($userNumber)) {
                    $html = "<div class='account-created-successfully'>
                                <h3>Account has created</h3>
                            </div>";
                    $html = "<div class='enter_phone'>valid</div>";

                    return '<h2 class="signup-successful">SignUp Successful</h2><img class="success_image" rel="account_created" src="https://golfoy.com/media/sales/download.gif"><h3 class="signup-line">Your account is created successfully and You are logging in</h3>';

                    //return $html;
                }
            } else {
                $html = "<div class='account-created-successfully'>
                            <h3Something went Wrong please try again !!</h3>
                        </div>";

                return $html;
            }
        }
    }


    public function enter_phone()
    {
        $html = "<div class='enter_phone'>enter_phone html here</div>";
        return $html;
    }

    public function customerLogin($number)
    {
        $customer = $this->customerModel->getCollection()->addAttributeToFilter('phone_number', $number);

        foreach ($customer as $customers) {
            $email = $customers->getEmail();
        }

        $customer = $this->customerModel->setWebsiteId(1)->loadByEmail($email);
        $this->customerSession->setCustomerAsLoggedIn($customer);

        return true;
    }
}
