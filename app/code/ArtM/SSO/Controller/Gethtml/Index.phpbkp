                                    class='acnhor_page'>Privacy Policy </a>
                                </div>
                                    <button type='submit' class='button-submit'>Log In</button>

                                </form>
                                <h2 class='use-number' id='use_number'>Use Mobile Number</h2>
                            </div>
                        </div>
                    </div>";
            return $html;
        }
    }

    public function validate_password($formData)
    {
        $validationPasswordHtml = "Your are Logging";
        if (isset($_COOKIE['new-user-email'])) {
            $userEmail = $_COOKIE['new-user-email'];
            $validationUserByEmail =  $this->_data->customerLoginByEmail($userEmail, $formData);
            if ($validationUserByEmail) {

                if (!$this->_data->isPhoneNumberAvailable($userEmail)) {
                    setcookie('new-user-email', '', time() - 3600, '/');
                    setcookie('new-user-email-password', '', time() - 3600, '/');
                    $this->customerSession->setCustomerAsLoggedIn($validationUserByEmail);
                    return '<h2 class="login-successful">Login Successful</h2><img class="success_image" src="https://golfoy.com/media/sales/download.gif"><h3 class="signup-line">You are successfully logged in</h3>';
