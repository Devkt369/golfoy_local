                                </div>
                                <div class='sign-up-content'>
                                    <form action='' method='post' id='forgot_password_otp_form'>
                                        <div class='input_field_box'>
                                            <input type='number' oninput='javascript: if (this.value.length > 6) this.value = this.value.slice(0, 6);' class='otp_input_field'/>
                                            <input type='number' class='hide' />
                                            <input type='number' class='hide' />
                                            <input type='number' class='hide' />
                                            <input type='number' class='hide' />
                                            <input type='number' class='hide' />
                                        </div>
                                        <input type='hidden' value='forgot_password_validation'>
                                        <div id='resend_otp_forgot'>Resend OTP</div>
                                        <button type='submit' class='button-submit' id='submitotp'>Verify OTP</button>
                                    </form>
                                </div>
                            </div>
                        </div>";
                return $html;
            } elseif (strpos($check, 'invalid_phone_number') !== false) {
                $html = '<button class="revert-back" id="back-to-use_email">Back</button>
                            <div class="sign-up-forms-details">
                                <div class="login-heading">
                                <img src="https://golfoy.com/media/logo/stores/1/Golfoy.png" title="Golfoy.com: India Online Golf Shop" alt="Golfoy.com India Online Golf Shop" width="403" height="103">         

                                <p>Please enter your registered mobile number.</p>
                                    <p class="error">Enter valid mobile number.</p>
                                </div>
                                <div class="mobile-number-login-create">
                                    <form action="" method="post" id="forgot-password">
                                        <div class="mobile-number-login">+91</div>
                                        <input type="text" inputmode="numeric" maxlength="10"  class="new-mobile-number" name="mobileNumber" placeholder="Enter Mobile Number" autocomplete="off" id="forgot-password-mobile" required>
                                        <input type="hidden" name="pagetype" value="forgot_password_otp" class="new-number-pagetype">
                                        <button type="submit" id="number_input">Send OTP</button>
                                    </form>    
                                </div>
                            </div>';
                return $html;
            } else {
                // <input type='number' oninput='javascript: if (this.value.length > 6) this.value = this.value.slice(0, 6);' name='otp' class='otp-input' id='otpvalidation' placeholder='Enter OTP' inputmode='numeric' autocomplete='one-time-code' required>
                $html = "<button class='revert-back' id='back-to-forgot_password'>Back</button>
                        <div class='sign-up-forms-details'> 
                            <div class='enter_otpsignonform'>
                                <div class='login-heading'>
                                    <h3>Almost There</h3>
                                    <p>Hi " . $customerEmail['0']['email'] . "</p>
                                    <p>Please enter the 6 digit OTP that we just sent on +91-" . $formData . "</p>
                                </div>
                                <div class='sign-up-content'>
                                    <form action='' method='post' id='forgot_password_otp_form'>
                                        <div class='input_field_box'>
                                            <input type='number' oninput='javascript: if (this.value.length > 6) this.value = this.value.slice(0, 6);' class='otp_input_field'/>
                                            <input type='number' class='hide' />
                                            <input type='number' class='hide' />
                                            <input type='number' class='hide' />
                                            <input type='number' class='hide' />
                                            <input type='number' class='hide' />
                                        </div>
                                        <input type='hidden' value='forgot_password_validation'>
