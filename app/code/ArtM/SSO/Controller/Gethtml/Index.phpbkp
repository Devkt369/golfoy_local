<?php

namespace ArtM\SSO\Controller\Gethtml;

use Magento\Framework\App\Action\Action;
use Magento\Framework\App\Action\Context;
use Magento\Framework\View\Result\PageFactory;
use Magento\Framework\Controller\Result\JsonFactory;
use Magento\Customer\Model\Customer;
use Magento\Customer\Model\Session;
use ArtM\SSO\Helper\Data;
use Magento\Store\Model\StoreManagerInterface;

class Index extends Action
{
    protected $resultPageFactory;

    /**
     * @var Customer
     */
    protected $customerModel;

    /**
     * @var StoreManagerInterface
     */
    protected $storeManager;
    /**
     * constructor.
     * @param StoreManagerInterface $storeManager
     */


    /**
     * @var Session
     */
    protected $customerSession;

    public function __construct(
        Context $context,
        Data $data,
        Customer $customerModel,
        PageFactory $resultPageFactory,
        Session $customerSession,
        JsonFactory $jsonResultFactory,
        StoreManagerInterface $storeManager
    ) {
        $this->_data = $data;
        $this->resultPageFactory = $resultPageFactory;
        $this->jsonResultFactory = $jsonResultFactory;
        $this->customerModel = $customerModel;
        $this->customerSession = $customerSession;
        $this->storeManager = $storeManager;
        parent::__construct($context);
    }

    public function execute()
    {
        $pagetype = ($this->getRequest()->getParam('pagetype') == '') ? ' ' : $this->getRequest()->getParam('pagetype');
        $formData = ($this->getRequest()->getParam('formData') == '') ? ' ' : $this->getRequest()->getParam('formData');

        //        $pagetype = $this->getRequest()->getParam('pagetype');
        switch ($pagetype) {
            case "signon":
                $html_to_return = $this->signon();
                break;
            case "enter_email":
                $html_to_return = $this->enter_email();
                break;
            case "enter_password":
                $html_to_return = $this->enter_password($formData);
                break;
            case "validate_password":
                $html_to_return = $this->validate_password($formData);
                break;
            case "enter_otp":
                $html_to_return = $this->enter_otp($formData);
                break;
            case "enter_phone":
                $html_to_return = $this->enter_phone();
                break;
            case "create_email":
                $html_to_return = $this->create_email($formData);
                break;
            case "enter_number":
                $html_to_return = $this->enter_number();
                break;
            case "add_phonenumber":
                $html_to_return = $this->add_phonenumber();
                break;
            case "enter_golfoy":
                $html_to_return = $this->enter_golfoy($formData);
                break;
            case "enter_otp_registration":
                $html_to_return = $this->enter_otp_registration($formData);
                break;
            case "add_phonenumber_otp":
                $html_to_return = $this->add_phonenumber_otp($formData);
                break;
            case "add_phonenumber_validation":
                $html_to_return = $this->add_phonenumber_validation($formData);
                break;
            case "registration_otp_validation":
                $html_to_return = $this->registration_otp_validation($formData);
                break;
            case "valid_otp":
                $html_to_return = $this->valid_otp($formData);
                break;
            case "forgot_password":
                $html_to_return = $this->forgot_password();
                break;
            case "forgot_password_otp":
                $html_to_return = $this->forgot_password_otp($formData);
                break;
            case "forgot_password_validation":
                $html_to_return = $this->forgot_password_validation($formData);
                break;
            case "set_new_password":
                $html_to_return = $this->set_new_password($formData);
                break;
            default:
                $html_to_return = '';
        }

        // Prepare JSON response
        $result = $this->jsonResultFactory->create();

        /* $result->setData([
            'content' => $html_to_return,
        ]);*/

        $html_to_return = trim($html_to_return);

        $result->setHeader('Content-Type', 'text/html');

        $data = array(
            'content' => $html_to_return,
        );

        return $result->setData($data);
    }


    public function signon()
    {
        $html = '<div class="sign-up-forms-details">
                    <form name="login-number" id="login-number" action="#">
                        <div class="sign-up-content">
                            <div class="login-heading">
                            <img src="https://golfoy.com/media/logo/stores/1/Golfoy.png" title="Golfoy.com: India Online Golf Shop" alt="Golfoy.com India Online Golf Shop" width="403" height="103">
                                <p class="normal-login-popup">Please enter your mobile number to <br> Sign In / Sign Up</p>
                            </div>
                            <div class="input_form_div">
                                <div class="form-group">
                                    <div class="mobile-number-login__dateSlct">+91</div>
                                    <input type="text" inputmode="numeric" 
                                    oninput="javascript: if (this.value.length > 10) this.value = this.value.slice(0, 10);"
                                        maxlength="10" class="mobile-number-login__form_control" name="mobileNumber"
                                        placeholder="Enter Mobile Number" autocomplete="off" id="mobileNumber" value="">
                                </div>
                            </div>
                            <h2 class="use-email" id="use_email">Sign in using E-mail</h2>
                            <div class="terms-condition-content">
                                <p>On Clicking Continue, I agree to <a href="https://golfoy.com/terms-and-conditions" class="acnhor_page">Terms of Service</a><a href="https://golfoy.com/privacy-policy-cookie-restriction-mode"
                                class="acnhor_page"> & Privacy Policy </a>
                                </p>
                            </div>
                            <div class="submit_form_button">
                                <button class="sbmt_btn" type="">continue</button>
                            </div>
                            
                        </div>
                    </form>
                </div>';
        return $html;
    }

    public function enter_email()
    {
        $html = "<button class='revert-back' id='back-to-use_number'>Back</button>
                <div class='sign-up-forms-details'>
                    <div class='sign-up-content'>
                        <div class='login-heading'>
                        <img src='https://golfoy.com/media/logo/stores/1/Golfoy.png' title='Golfoy.com: India Online Golf Shop' alt='Golfoy.com India Online Golf Shop' width='403' height='103'>         
                        </div>
                        <div class='enter_email'> 
                            <form action='' method='post'  id='enter_email'>
                            <div class='form-group'>
                                <input type='email' name='email' class='email-input' placeholder='Enter email' required>
                                <lable for='email' class='email-label'>E-mail Address</lable>
