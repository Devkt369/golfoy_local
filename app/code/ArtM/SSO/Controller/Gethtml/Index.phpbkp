                                                    oninput="javascript: if (this.value.length > 10) this.value = this.value.slice(0, 10);"
                                                        maxlength="10" class="mobile-number-login__form_control" name="mobileNumber"
                                                        placeholder="Enter Mobile Number" autocomplete="off" id="mobileNumber" value="">
                
                                                </div>
                                            </div>
                                            <div class="terms-condition-content">
                                            <p>On Clicking Continue, I agree to <a href="https://golfoy.com/terms-and-conditions" class="acnhor_page">Terms of Service </a>& <a href="https://golfoy.com/privacy-policy-cookie-restriction-mode"
                                            class="acnhor_page">Privacy Policy </a>
                                        </div>
                                            </div>
                                            <div class="submit_form_button">
                                                <button class="sbmt_btn" type="">continue</button>
                                            </div>
                                            
                                            <h2 class="use-email" id="use_email">Sign in using E-mail</h2>
                                        </div>
                                    </form>
                                </div>';
                        return $html;
                    }
                } elseif ($errorMessage == 'OTP_NOT_VALIDE' || $errorMessage == 'OTP_EXPIRED') {
                    // <input type='text' name='otp' oninput='javascript: if (this.value.length > 6) this.value = this.value.slice(0, 6);' class='otp-input' id='otpvalidation' placeholder='Enter OTP' inputmode='numeric' autocomplete='one-time-code' required>
                    $html = "<div class='enter_otpsignonform'>
                                    <div class='login-heading'>
                                        <h3>Almost There</h3>
                                        <p>Please enter the 6 digit OTP that we just sent on +91- " . $userId . "</p>
                                        <p class='error'>OTP not valid</p>
                                    </div>
                                    <form action='' method='post' id='otp_validation_form'>
                                        <div class='input_field_box'>
                                            <input type='number' oninput='javascript: if (this.value.length > 6) this.value = this.value.slice(0, 6);' class='otp_input_field'/>
                                            <input type='number' class='hide' />
                                            <input type='number' class='hide' />
                                            <input type='number' class='hide' />
                                            <input type='number' class='hide' />
                                            <input type='number' class='hide' />
                                        </div>
                                        <input type='hidden' name='pagetype' value='registration_otp_validation'>
                                        <div class='edit-button'>
                                        <div id='edit_number_create'>Edit Number</div>
                                        <div id='resend_otp_create'>Resend OTP</div>
                                        </div>
                                        <button type='submit' class='button-submit' id='submit_otp'>Verify OTP</button>
                                    </form>
                                    
                                </div>";
                    return $html;
                } elseif ($errorMessage == 'false') {
                    return $this->enter_golfoy($user_email);
                } else {
                    $dummyData = '';
                    return $this->create_email($dummyData);
                }
            }
        } else {
            $html = "<button class='revert-back' id='back-to-use_number'>Back</button>
                    <div class='sign-up-forms-details'>
                        <div class='sign-up-content'>
                            <div class='login-heading'>
                            <img src='https://golfoy.com/media/logo/stores/1/Golfoy.png' title='Golfoy.com: India Online Golf Shop' alt='Golfoy.com India Online Golf Shop' width='403' height='103'>         

                                <p class='error'>Something went wrong at the my side Please enter details again</p>              
                            </div>
