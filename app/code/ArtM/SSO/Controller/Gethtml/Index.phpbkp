                </div>";
        return $html;
    }

    public function enter_password($formData)
    {

        setcookie('new-user-email', '', time() - 3600, '/');
        // setcookie('new-user-email', $formData, time() + 300, '/');

        $isEmailRegister = $this->_data->isEmailRegistered($formData);
        if ($isEmailRegister == true) {
            $passwordData = $_COOKIE['new-user-email-password'];
            return $this->validate_password($passwordData);

            // $html = "<div class='sign-up-forms-details'>
            //             <div class='sign-up-content'>
            //                 <div class='enter_password'>
            //                     <form action='' method='post'  id='enter_password'>
            //                         <input type='password' name='password' class='password-input' placeholder='Password' required>
            //                         <input type='hidden' name='pagetype' value='enter_password'>
            //                         <button type='submit' class='button-submit' id='validate-password'>Verify Password</button>
            //                     </form>
            //                 </div>
            //             </div>    
            //         </div>";
            // return $html;
        } else {

            return $this->enter_number();
        }
    }

