<div class="artm-mass-upload-dashboard">
    <?php if ($showToggle): ?>
    <div id="artm-config-toggle-bar">
        <span class="artm-config-toggle-label"><?= $block->escapeHtml(__('Show Configuration Tab:')) ?></span>
        <button type="button" id="artm-config-toggle-btn" class="is-off">NO</button>
    </div>
    <?php endif; ?>
    <div id="mass-upload-root">
        <?= $block->getChildHtml('artm.massproducts.dashboard.tabs') ?>
    </div>
</div>
<script>
require(['jquery'], function ($) {
    'use strict';

    var STORAGE_KEY = 'artm_show_configuration_tab';
    var $root = $('#mass-upload-root');
    var $toggleBtn = $('#artm-config-toggle-btn');

    /**
     * Find the Configuration tab element. Magento may render tabs in several ways
     * (ui-tabs-nav, .tabs, .admin__page-nav, etc.) so we try multiple strategies.
     */
    function findConfigTab() {
        // Strategy 1: any <li> that text-matches "Configuration"
        var $li = $root.find('li').filter(function () {
            var t = $(this).children('a, span').first().text().trim().toLowerCase();
            if (!t) { t = $(this).text().trim().toLowerCase(); }
            return t === 'configuration';
        });
        if ($li.length) { return $li; }
        // Strategy 2: any <a> matching, return its parent <li>
        var $a = $root.find('a').filter(function () {
            return $(this).text().trim().toLowerCase() === 'configuration';
        });
        if ($a.length) { return $a.closest('li'); }
        return $();
    }

    function getPref() {
        try {
            var v = localStorage.getItem(STORAGE_KEY);
            return v === null ? false : v === '1';  // default: hidden
        } catch (e) { return false; }
    }

    function setPref(val) {
        try { localStorage.setItem(STORAGE_KEY, val ? '1' : '0'); } catch (e) {}
    }

    function applyVisibility(visible) {
        var $li = findConfigTab();
        if ($li.length) {
            if (visible) {
                $li.removeClass('artm-config-tab-hidden').show();
            } else {
                $li.addClass('artm-config-tab-hidden');
                // If currently active, switch to first visible tab
                var isActive = $li.hasClass('ui-tabs-active') || $li.hasClass('ui-state-active') || $li.hasClass('active');
                if (isActive) {
                    var $first = $root.find('li').not('.artm-config-tab-hidden').first();
                    $first.find('a').first().trigger('click');
                }
            }
        }
        updateToggleButton(visible);
    }

    function updateToggleButton(visible) {
        if (!$toggleBtn.length) { return; }
        $toggleBtn.removeClass('is-on is-off').addClass(visible ? 'is-on' : 'is-off');
        $toggleBtn.text(visible ? 'YES' : 'NO');
    }

    // Wire up button click (works whether tabs are rendered yet or not)
    $toggleBtn.on('click', function () {
        var next = !getPref();
        setPref(next);
        applyVisibility(next);
    });

    // Apply initial state — keep retrying until tabs render
    var attempts = 0;
    var poll = setInterval(function () {
        attempts++;
        var $li = findConfigTab();
        if ($li.length || attempts > 60) {
            clearInterval(poll);
            applyVisibility(getPref());
        }
    }, 100);

    // Also apply on initial DOM ready
    $(function () { applyVisibility(getPref()); });
});
</script>
