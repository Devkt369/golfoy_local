                <div class="artm-sst-title">Groups</div>
                <div class="artm-sst-subtitle">Hover a card for edit, attributes, copy token, or delete.</div>
            </div>
            <div class="artm-sst-body">
                <div class="artm-sst-top-row">
                    <input type="text" class="admin__control-text artm-sst-search" data-role="sst-group-search" placeholder="Search groups&hellip;" />
                    <div class="artm-sst-add-row">
                        <input type="text" class="admin__control-text" data-role="sst-new-group-name" placeholder="New group name" />
                        <button type="button" class="action-secondary" data-role="sst-add-group-btn"><span>+ Add</span></button>
                    </div>
                </div>
                <div class="artm-sst-msg" data-role="sst-msg">Select attribute set to load groups.</div>
                <div class="artm-sst-groups" data-role="sst-groups-list"></div>
            </div>
        </section>

