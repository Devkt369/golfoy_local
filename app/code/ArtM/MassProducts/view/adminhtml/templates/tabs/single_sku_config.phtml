    data-sets-url="<?= $block->escapeUrl($setsUrl) ?>"
    data-attributes-url="<?= $block->escapeUrl($attributesUrl) ?>"
    data-save-url="<?= $block->escapeUrl($saveUrl) ?>"
    data-groups-url="<?= $block->escapeUrl($groupsUrl) ?>"
    data-groups-save-url="<?= $block->escapeUrl($groupsSaveUrl) ?>">

    <style>
