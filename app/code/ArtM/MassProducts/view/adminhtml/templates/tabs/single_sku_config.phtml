    </style>

    <div class="artm-skcfg-layout">
        <section class="artm-skcfg-panel">
            <div class="artm-skcfg-head">
                <div class="artm-skcfg-title">Right Panel: Group Mapping (Fast Version)</div>
                <div class="artm-skcfg-subtitle">Enable/disable + group + sort order (no drag-drop in phase 1).</div>
            </div>
            <div class="artm-skcfg-body">
                <div class="artm-skcfg-toolbar">
                    <select class="admin__control-select" data-role="attribute-set"></select>
                    <select class="admin__control-select" data-role="quick-group-filter">
                        <option value="">All Groups</option>
                    </select>
                    <input type="text" class="admin__control-text" data-role="new-group-name" placeholder="New custom group" />
                    <button type="button" class="action-secondary" data-role="add-group-btn"><span>Add Group</span></button>
                    <div class="artm-skcfg-message" data-role="message">Select an attribute set to configure layout.</div>
                    <button type="button" class="action-primary" data-role="save-layout-btn"><span>Save Configuration</span></button>
                </div>

                <div class="artm-skcfg-grid-wrap">
                    <table class="artm-skcfg-grid" data-role="layout-grid">
                        <thead>
                        <tr>
                            <th>Attribute</th>
                            <th>Required</th>
                            <th>System</th>
                            <th>Visible Front</th>
                            <th>Enabled</th>
                            <th>Group</th>
                            <th>Sort</th>
                        </tr>
                        </thead>
                        <tbody data-role="layout-grid-body">
                        <tr><td colspan="7" class="artm-skcfg-empty">No attributes loaded.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
