		$root.find('[data-role="bulk-attr-check"]').prop('checked', false);
		bulkGridOriginalData = {};
		bulkGridData = {};
		bulkGridChanges = {};
		bulkHeaderCopyValues = {};
	}

	function setSelectedBulkAttributes(values) {
		selectedBulkAttributes = Array.isArray(values) ? values.slice(0) : [];
	}

	function collectSelectedBulkAttributes() {
		var attrs = [];
		$root.find('[data-role="bulk-attr-check"]').each(function () {
			if ($(this).is(':checked')) {
				attrs.push(String($(this).val() || ''));
			}
		});
