				}
			}
			return (topRowHtml.length ? '<div class="artm-layout-default-row">' + topRowHtml.join('') + '</div>' : '') + html.join('');
		}

		return (topRowHtml.length ? '<div class="artm-layout-default-row">' + topRowHtml.join('') + '</div>' : '')
			+ '<div class="artm-layout-groups">' + html.join('') + '</div>';
