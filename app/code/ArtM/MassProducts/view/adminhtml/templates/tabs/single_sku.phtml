		if (remainder.length) {
			var otherGroupHtml = '<div class="artm-layout-group artm-layout-group--col-1" style="width:100%;order:1000;">'
				+ '<div class="artm-layout-group-title"><span>Other Attributes</span><span class="artm-layout-group-title-meta">Sort: 1000 | Width: 1</span></div>'
				+ '<div class="artm-layout-group-body">' + remainder.join('') + '</div>'
				+ '</div>';
			html.push(otherGroupHtml);
		}

		if (!html.length) {
			for (i = 0; i < defaultOrder.length; i++) {
				var code2 = normalizeAttrCode(defaultOrder[i]);
				if (code2 && renderedFieldMap[code2] && !used[code2]) {
