		}
	});

	$attrsContainer.off('click.artmPreviewLoadAllChildren', '[data-role="preview-load-all-children"]').on('click.artmPreviewLoadAllChildren', '[data-role="preview-load-all-children"]', function () {
		var skusRaw = String($(this).attr('data-skus') || '[]');
		var skus = [];
		try {
			skus = JSON.parse(skusRaw);
		} catch (e) {
			skus = [];
		}
		loadSkuBatch(Array.isArray(skus) ? skus : []);
	});

	$attrsContainer.off('click.artmPreviewCopyAllChildren', '[data-role="preview-copy-all-children"]').on('click.artmPreviewCopyAllChildren', '[data-role="preview-copy-all-children"]', function () {
		var skusRaw = String($(this).attr('data-skus') || '[]');
		var skus = [];
		try {
			skus = JSON.parse(skusRaw);
		} catch (e) {
			skus = [];
		}
		skus = Array.isArray(skus) ? skus : [];
		if (!skus.length) {
			return;
		}
		if (navigator && navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
			navigator.clipboard.writeText(skus.join(', '));
		}
	});

	$saveBtn.off('click.artmSingleSkuSave').on('click.artmSingleSkuSave', function () {
		var sku = normalizeSku(activeSku);
		var changedAttributes;
		var message = '';

		if (!sku) {
			showLoadMessage('Select a product first.', 'error');
			return;
		}

		persistActiveDraftState();
		changedAttributes = collectChangedAttributes();

		if ($.isEmptyObject(changedAttributes)) {
			showLoadMessage('No changes to save.', 'error');
			return;
		}

		clearLoadMessage();
		$saveBtn.prop('disabled', true);
		setLoading(true);

		setSkuSidebarState(sku, 'processing', 'Processing');
		saveProductChanges(sku, changedAttributes).done(function (response) {
			message = response && response.message ? String(response.message) : 'Product updated';
			applyChangesToLocalCaches(sku, changedAttributes);
			clearDraftForSku(sku);
			markActiveFormAsSaved(changedAttributes);
			setSkuSidebarState(sku, 'saved', 'Saved', 5000);
			showLoadMessage(message, 'success');
		}).fail(function (xhr) {
			message = 'Unable to save product.';
			if (xhr && xhr.responseJSON && xhr.responseJSON.message) {
				message = String(xhr.responseJSON.message);
			}
			// Detect form key expiration and suggest page refresh
			if (message.toLowerCase().indexOf('form key') !== -1 || message.toLowerCase().indexOf('csrf') !== -1) {
				message = message + ' Please refresh the page.';
			}
			setSkuSidebarState(sku, 'error', 'Failed');
			showLoadMessage(message, 'error');
		}).always(function () {
			$saveBtn.prop('disabled', false);
			setLoading(false);
			updateSaveVisibility();
			updateSaveAllVisibility();
		});
	});

	$saveAllBtn.off('click.artmSingleSkuSaveAll').on('click.artmSingleSkuSaveAll', function () {
		runSaveAllDrafts();
	});

	$sidebarSaveAllBtn.off('click.artmSingleSkuSaveAll').on('click.artmSingleSkuSaveAll', function () {
		runSaveAllDrafts();
	});

	$storeSwitcher.off('change.artmStoreSwitcher').on('change.artmStoreSwitcher', function () {
		var nextStoreId = parseInt($(this).val(), 10);
		if (isNaN(nextStoreId) || nextStoreId < 0) {
			nextStoreId = 0;
		}

		persistActiveDraftState();
		currentStoreId = nextStoreId;
		productResponseCache = {};
		persistStoreSelection(nextStoreId).always(function () {
			refreshActiveProductForStoreChange();
		});
	});

	renderLoadedProductsList();
	updateBulkButtonVisibility();
	updateSaveVisibility();
	updateSaveAllVisibility();
	updateSelectAllCheckboxState();
	loadStoreContext();
});
</script>
