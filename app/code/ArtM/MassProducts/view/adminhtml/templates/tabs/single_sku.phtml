		if (step === 1) {
			$bulkStep1Wrap.css('display', 'flex');
			$bulkGridWrap.hide();
			$bulkActions.hide();
		} else {
			$bulkStep1Wrap.hide();
			$bulkGridWrap.css('display', 'flex');
		}
