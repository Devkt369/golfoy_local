	function applyChangedAttributesToLocalProduct(product, changedAttributes) {
		var msiSources;
		var sourceCode;
		var i;
		if (!product || !changedAttributes || typeof changedAttributes !== 'object') {
			return;
		}
		if (!product.attributes || typeof product.attributes !== 'object') {
			product.attributes = {};
		}
		msiSources = Array.isArray(product.msi_sources) ? product.msi_sources : [];
		$.each(changedAttributes, function (code, value) {
			var attrCode = String(code || '');
			if (!attrCode) {
				return;
			}
			if (isMsiAttributeCode(attrCode)) {
				sourceCode = attrCode.replace(/^msi_qty__/, '');
				for (i = 0; i < msiSources.length; i++) {
					if (String(msiSources[i] && msiSources[i].source_code || '') === sourceCode) {
						msiSources[i].qty = String(value == null ? '' : value);
						return;
					}
				}
				msiSources.push({ source_code: sourceCode, source_name: sourceCode, qty: String(value == null ? '' : value) });
				return;
			}
			product.attributes[attrCode] = String(value == null ? '' : value);
		});
		product.msi_sources = msiSources;
