					if (!code || !renderedFieldMap[code]) {
						continue;
					}
					groupCodesByName[groupKey].push(code);
					groupedCodes[code] = true;
					bodyHtml.push(renderedFieldMap[code]);
				}

				if (groupKey === mainGroupKey) {
