		used = groupedCodes;

		var remainder = [];
		for (i = 0; i < defaultOrder.length; i++) {
			var fallbackCode = normalizeAttrCode(defaultOrder[i]);
			if (!fallbackCode || used[fallbackCode] || !renderedFieldMap[fallbackCode]) {
				continue;
