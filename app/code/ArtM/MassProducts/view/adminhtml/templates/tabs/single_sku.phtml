			if (isNaN(leftSort)) {
				leftSort = 1000;
			}
			if (isNaN(rightSort)) {
				rightSort = 1000;
			}
			if (leftSort <= 0) {
				leftSort = 1000;
			}
			if (rightSort <= 0) {
				rightSort = 1000;
			}
			if (leftSort !== rightSort) {
				return leftSort - rightSort;
			}
			return String(left && left.group_name || '').localeCompare(String(right && right.group_name || ''));
		});

		if (sortedLayoutGroups.length) {
			for (i = 0; i < sortedLayoutGroups.length; i++) {
				var group = sortedLayoutGroups[i] || {};
