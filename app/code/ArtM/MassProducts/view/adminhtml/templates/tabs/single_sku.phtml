	var singleSkuTemplateLoadUrl = '<?= $block->escapeJs($block->getUrl('massproducts/singleskulayout/templateload')) ?>';
	function getFormKey() {
		var metaKey = $('meta[name="form-key"]').attr('content');
		return metaKey ? String(metaKey) : String(window.FORM_KEY || '');
	}
	var restApiUrl = '/rest/V1/artm/product/load';
	var debounceMs = 600;
	var debounceTimer = null;
	var lastRequestedSku = '';
	var pendingLoadCount = 0;
	var loadedProducts = [];
	var expandedParents = {};
	var activeSku = '';
	var selectedSkus = [];
	var selectedBulkAttributes = [];
	var loadedProductDataBySku = {};
	var productResponseCache = {};
	var attributeSetConfigMap = {};
	var bulkGridOriginalData = {};
	var bulkGridData = {};
	var bulkGridChanges = {};
	var bulkHeaderCopyValues = {};
	var bulkAttributeMetaByCode = {};
	var bulkAttributeApplicabilityBySku = {};
	var currentStoreId = 0;
	var skuDraftsBySku = {};
	var skuSidebarStateBySku = {};
	var skuStateTimersBySku = {};
	var singleSkuLayoutGroupsBySet = {};
	var singleSkuLayoutPendingBySet = {};
	var singleSkuTemplateBySet = {};
	var singleSkuTemplatePendingBySet = {};
	var previewParentByChildSku = {};
	var previewParentPendingByChildSku = {};

	function normalizeSku(value) {
		return String(value || '').trim();
	}

	function getSkuKey(sku) {
		return normalizeSkuKey(sku);
	}

	function clearSkuStateTimer(sku) {
		var key = getSkuKey(sku);
		if (!key) {
			return;
		}
		if (skuStateTimersBySku[key]) {
			clearTimeout(skuStateTimersBySku[key]);
			delete skuStateTimersBySku[key];
		}
	}

	function setSkuSidebarState(sku, state, label, resetAfterMs) {
		var key = getSkuKey(sku);
		if (!key) {
			return;
		}
		clearSkuStateTimer(sku);
		skuSidebarStateBySku[key] = {
			state: String(state || 'loaded'),
			label: String(label || 'Loaded')
		};
		if (resetAfterMs && resetAfterMs > 0) {
			skuStateTimersBySku[key] = setTimeout(function () {
				delete skuSidebarStateBySku[key];
				renderLoadedProductsList();
			}, resetAfterMs);
		}
		renderLoadedProductsList();
	}

	function hasDraftForSku(sku) {
		var key = getSkuKey(sku);
		return !!(key && skuDraftsBySku[key] && !$.isEmptyObject(skuDraftsBySku[key]));
	}

	function countDraftSkus() {
		var count = 0;
		var staleKeys = [];
		$.each(skuDraftsBySku, function (key, map) {
			if (!key || !map || $.isEmptyObject(map)) {
				return;
			}
			if (!findSkuByKey(String(key || ''))) {
				staleKeys.push(String(key || ''));
				return;
			}
			if (key && map && !$.isEmptyObject(map)) {
				count += 1;
			}
		});
		$.each(staleKeys, function (_, staleKey) {
			delete skuDraftsBySku[staleKey];
		});
		return count;
	}

	function updateSaveAllVisibility() {
		var total = countDraftSkus();
		if (total > 0) {
			$saveAllWrap.show();
			$sidebarSaveAllWrap.show();
			$saveAllBtn.prop('disabled', false);
			$sidebarSaveAllBtn.prop('disabled', false);
			$saveAllBtn.find('span').text('Save All (' + total + ')');
			$sidebarSaveAllBtn.find('span').text('Save All Changed (' + total + ')');
			return;
		}
		$saveAllWrap.hide();
		$sidebarSaveAllWrap.hide();
		$saveAllBtn.prop('disabled', true);
		$sidebarSaveAllBtn.prop('disabled', true);
		$saveAllBtn.find('span').text('Save All');
		$sidebarSaveAllBtn.find('span').text('Save All Changed');
	}

	function persistActiveDraftState() {
		var sku = normalizeSku(activeSku);
		var key;
		var changed;
		if (!sku || !$attrsContainer.children().length) {
			return;
		}
		key = getSkuKey(sku);
		if (!key) {
			return;
		}
		changed = collectChangedAttributes();
		if ($.isEmptyObject(changed)) {
			delete skuDraftsBySku[key];
			if (!skuSidebarStateBySku[key] || skuSidebarStateBySku[key].state === 'edited' || skuSidebarStateBySku[key].state === 'changed') {
				delete skuSidebarStateBySku[key];
			}
			updateSaveAllVisibility();
			renderLoadedProductsList();
			return;
		}
		skuDraftsBySku[key] = $.extend({}, changed);
		if (!skuSidebarStateBySku[key] || skuSidebarStateBySku[key].state === 'loaded' || skuSidebarStateBySku[key].state === 'edited' || skuSidebarStateBySku[key].state === 'changed') {
			skuSidebarStateBySku[key] = { state: 'edited', label: 'Edited' };
		}
		updateSaveAllVisibility();
		renderLoadedProductsList();
	}

	function applyDraftToRenderedProduct(sku) {
		var key = getSkuKey(sku);
		var draft = key && skuDraftsBySku[key] ? skuDraftsBySku[key] : null;
		var qtyDraftMap = {};
		var $group;
		if (!draft || $.isEmptyObject(draft)) {
			return;
		}

		$attrsContainer.find('[data-role="attr-field"]').removeClass('artm-field-changed');

		$.each(draft, function (code, value) {
			var attrCode = String(code || '');
			var nextValue = String(value == null ? '' : value);
			var $field;
			var $editorInput;
			if (!attrCode) {
				return;
			}
			if (isMsiAttributeCode(attrCode)) {
				qtyDraftMap[attrCode.replace(/^msi_qty__/, '')] = normalizeQtyValue(nextValue);
				return;
			}
			$field = $attrsContainer.find('[data-role="attr-field"][data-key="' + attrCode.replace(/"/g, '\\"') + '"]');
			if (!$field.length) {
				return;
			}
			$field.attr('data-current', nextValue).addClass('artm-field-changed');
			$editorInput = $field.find('[data-role="attr-editor"]');
			if ($editorInput.is('select')) {
				$editorInput.val(nextValue);
				if (String($editorInput.val() || '') !== nextValue) {
					$editorInput.find('option').each(function () {
						if (String($(this).text() || '') === nextValue) {
							$(this).prop('selected', true);
							return false;
						}
						return true;
					});
				}
				$field.find('[data-role="attr-value"]').text($editorInput.find('option:selected').text() || nextValue);
				return;
			}
			$editorInput.val(nextValue);
			$field.find('[data-role="attr-value"]').text(nextValue);
		});

		$group = $attrsContainer.find('[data-role="qty-group"]');
		if ($group.length) {
			var $list = $group.find('[data-role="qty-group-list"]');
			$.each(qtyDraftMap, function (sourceCode, qtyValue) {
				var $row = $list.find('[data-role="qty-source-row"][data-source-code="' + String(sourceCode).replace(/"/g, '\\"') + '"]');
				if ($row.length) {
					$row.attr('data-current', qtyValue).addClass('artm-is-changed');
					$row.find('[data-role="qty-source-input"]').val(qtyValue);
					return;
				}
				$list.append('<div class="artm-qty-source-row artm-is-changed" data-role="qty-source-row" data-source-code="' + escapeHtml(sourceCode) + '" data-source-name="' + escapeHtml(sourceCode) + '" data-original="__new__" data-current="' + escapeHtml(qtyValue) + '">'
					+ '<span class="artm-qty-source-name">' + escapeHtml(sourceCode) + '</span>'
					+ '<input type="number" step="0.0001" class="admin__control-text artm-qty-source-input" data-role="qty-source-input" value="' + escapeHtml(qtyValue) + '" />'
					+ '</div>');
			});
			refreshSingleQtyAddOptions($group);
		}
	}

	function getSkuSidebarStatus(sku) {
		var key = getSkuKey(sku);
		var explicitState = key ? skuSidebarStateBySku[key] : null;
		if (explicitState && explicitState.state && explicitState.state !== 'loaded') {
			return explicitState;
		}
		if (hasDraftForSku(sku)) {
			return { state: 'edited', label: 'Edited' };
		}
		return { state: 'loaded', label: 'Loaded' };
	}

	function setLoading(isLoading) {
		if (isLoading) {
			pendingLoadCount += 1;
			$loader.show();
			$layout.addClass('artm-is-busy');
			return;
		}
		pendingLoadCount = Math.max(0, pendingLoadCount - 1);
		if (!pendingLoadCount) {
			$loader.hide();
			$layout.removeClass('artm-is-busy');
		}
	}

	function showLoadMessage(message, type) {
		var msgType = type === 'success' ? 'is-success' : 'is-error';
		$loadMessage
			.removeClass('is-success is-error')
			.addClass(msgType)
			.text(String(message || ''))
			.show();
	}

	function clearLoadMessage() {
		$loadMessage.removeClass('is-success is-error').hide().text('');
	}

	function renderStoreSwitcher(options, selectedStoreId) {
		var html = '';
		var items = Array.isArray(options) && options.length ? options : [{ value: 0, label: 'All Store Views', disabled: false }];
		var i;
		var item;
		var value;
		var selected = parseInt(selectedStoreId, 10);

		if (isNaN(selected) || selected < 0) {
			selected = 0;
		}

		for (i = 0; i < items.length; i++) {
			item = items[i] || {};
			value = item.value === '' ? '' : String(parseInt(item.value, 10) || 0);
			html += '<option value="' + escapeHtml(value) + '"' + (item.disabled ? ' disabled="disabled"' : '') + (value !== '' && parseInt(value, 10) === selected ? ' selected="selected"' : '') + '>' + escapeHtml(item.label || '') + '</option>';
		}

		$storeSwitcher.html(html);
		currentStoreId = selected;
	}

	function refreshActiveProductForStoreChange() {
		if (!activeSku || pendingLoadCount > 0) {
			return;
		}
		executeSearch(activeSku, {
			forceReload: true,
			fromSidebar: true,
			keepInputValue: true,
			suppressErrorMessage: true
		});
	}

	function loadStoreContext() {
		if (!storeContextUrl) {
			renderStoreSwitcher([], 0);
			return $.Deferred().resolve().promise();
		}

		$storeSwitcherWrap.addClass('artm-is-busy');
		return $.ajax({
			url: storeContextUrl,
			method: 'GET',
			dataType: 'json',
			cache: false,
			data: {
				form_key: getFormKey(),
				isAjax: 1,
				_: Date.now()
			}
		}).done(function (response) {
			if (!response || response.success === false) {
				renderStoreSwitcher([], 0);
				return;
			}
			renderStoreSwitcher(response.options || [], response.selected_store_id);
		}).fail(function () {
			renderStoreSwitcher([], 0);
		}).always(function () {
			$storeSwitcherWrap.removeClass('artm-is-busy');
		});
	}

	function persistStoreSelection(storeId) {
		if (!storeContextUrl) {
			return $.Deferred().resolve().promise();
		}

		return $.ajax({
			url: storeContextUrl,
			method: 'POST',
			dataType: 'json',
			cache: false,
			headers: {
				'X-Form-Key': getFormKey()
			},
			data: {
				store_id: storeId,
				form_key: getFormKey(),
				isAjax: 1,
				_: Date.now()
			}
		});
	}

	function hasSelectedSku(sku) {
		var key = normalizeSkuKey(sku);
		var i;
		for (i = 0; i < selectedSkus.length; i++) {
			if (normalizeSkuKey(selectedSkus[i]) === key) {
				return true;
			}
		}
		return false;
	}

	function updateSelectAllCheckboxState() {
		var visibleCheckboxes = $loadedProductsList.find('[data-role="loaded-product-check"]');
		var checkedCheckboxes = visibleCheckboxes.filter(':checked');
		var totalVisible = visibleCheckboxes.length;
		var totalChecked = checkedCheckboxes.length;

		if (totalVisible === 0) {
			$selectAllCheck.prop('checked', false).prop('indeterminate', false);
			return;
		}

		if (totalChecked === totalVisible) {
			$selectAllCheck.prop('checked', true).prop('indeterminate', false);
		} else if (totalChecked > 0) {
			$selectAllCheck.prop('checked', false).prop('indeterminate', true);
		} else {
			$selectAllCheck.prop('checked', false).prop('indeterminate', false);
		}
	}

	function setBulkStep(step) {
		$bulkStepsBar.find('[data-role="bulk-step-tab"]').each(function () {
			var tabStep = parseInt($(this).attr('data-step'), 10);
			$(this).toggleClass('artm-bulk-step-tab--active', tabStep === step);
			// Step 1 tab is clickable only when we're on step 2
			$(this).toggleClass('artm-bulk-step-tab--clickable', tabStep === 1 && step === 2);
