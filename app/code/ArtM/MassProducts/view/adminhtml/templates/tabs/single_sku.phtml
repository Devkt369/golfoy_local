	}

	function isMsiAttributeCode(code) {
		return String(code || '').indexOf('msi_qty__') === 0;
	}

	function isQtyGroupCode(code) {
		return String(code || '') === '__qty_group__';
	}

	function normalizeQtyValue(value) {
		var v = String(value == null ? '' : value).trim();
		if (v === '') {
			return '0';
		}
		return v;
	}

	function getProductMsiSourceOptions(product) {
		var options = product && Array.isArray(product.msi_source_options) ? product.msi_source_options : [];
		if (options.length) {
			return options;
		}
		return product && Array.isArray(product.msi_sources) ? product.msi_sources : [];
	}

	function buildQtySourceMapFromList(list) {
		var map = {};
		var i;
		var item;
		var code;
		var qtyValue;
		for (i = 0; i < list.length; i++) {
			item = list[i] || {};
			code = String(item.source_code || '').trim();
			if (!code) {
				continue;
			}
			qtyValue = item.qty;
			if (qtyValue == null && item.quantity != null) {
				qtyValue = item.quantity;
			}
			map[code] = normalizeQtyValue(qtyValue);
		}
		return map;
	}

	function getQtyDiffAttributes(originalList, currentList) {
		var originalMap = buildQtySourceMapFromList(Array.isArray(originalList) ? originalList : []);
		var currentMap = buildQtySourceMapFromList(Array.isArray(currentList) ? currentList : []);
		var diff = {};
		$.each(currentMap, function (sourceCode, qtyValue) {
			if (!Object.prototype.hasOwnProperty.call(originalMap, sourceCode) || String(originalMap[sourceCode]) !== String(qtyValue)) {
				diff['msi_qty__' + sourceCode] = String(qtyValue);
			}
		});
		return diff;
	}

	function cloneQtySources(list) {
		var out = [];
		var seen = {};
		$.each(Array.isArray(list) ? list : [], function (_, source) {
			var code = String(source && source.source_code ? source.source_code : '').trim();
			var qtyValue;
			if (!code) {
				return;
			}
			if (seen[code]) {
				return;
			}
			seen[code] = true;
			qtyValue = source && source.qty != null ? source.qty : null;
			if (qtyValue == null && source && source.quantity != null) {
				qtyValue = source.quantity;
			}
			out.push({
				source_code: code,
				source_name: String(source && source.source_name ? source.source_name : code),
				qty: normalizeQtyValue(qtyValue)
			});
		});
		return out;
	}

	function getAttributeSetGroupLabel(product) {
		var setName = String(product && (product.attribute_set_name || product.set_name) ? (product.attribute_set_name || product.set_name) : '');
		var setId = String(product && product.attribute_set_id != null ? product.attribute_set_id : '');
		if (setName) {
			return setName;
		}
		if (setId) {
			return 'Attribute Set ' + setId;
		}
		return 'Attribute Set';
	}

	function getAttributeLabelForCode(product, code) {
		var metaList = product && Array.isArray(product.attribute_meta) ? product.attribute_meta : [];
		var i;
		for (i = 0; i < metaList.length; i++) {
			if (String(metaList[i] && metaList[i].attribute_code || '') === String(code || '')) {
				return String(metaList[i] && metaList[i].label ? metaList[i].label : toTitle(code));
			}
		}
		return toTitle(code);
	}

	function buildBulkAttributeCandidates() {
		var byCode = {};
		var order = [];
		var setGroups = {};
		var setOrder = [];
		var codeSeenBySet = {};
		var productCodeSeen = {};
		var globalCountByCode = {};
		var selectedProducts = [];
		var groups = [];
		var i;
		var sku;
		var product;
		var attrs;
		var metaList;
		var msiSources;
		var totalProducts;

		bulkAttributeMetaByCode = {};
		bulkAttributeApplicabilityBySku = {};

		function getOrCreateSetGroup(setKey, title) {
			if (!setGroups[setKey]) {
				setGroups[setKey] = {
					key: setKey,
					title: title,
					items: []
				};
				setOrder.push(setKey);
				codeSeenBySet[setKey] = {};
			}
			return setGroups[setKey];
		}

		function addCandidate(code, label, inputType, options) {
			var attrCode = String(code || '');
			var normalizedOptions = Array.isArray(options) ? options : [];
			if (!attrCode) {
				return;
			}
			if (!byCode[attrCode]) {
				byCode[attrCode] = {
					code: attrCode,
					label: String(label || toTitle(attrCode)),
					inputType: String(inputType || 'text').toLowerCase(),
					options: normalizedOptions
				};
				bulkAttributeMetaByCode[attrCode] = byCode[attrCode];
				order.push(attrCode);
				return;
			}

			if (!byCode[attrCode].label && label) {
				byCode[attrCode].label = String(label);
			}
			if ((!byCode[attrCode].options || !byCode[attrCode].options.length) && normalizedOptions.length) {
				byCode[attrCode].options = normalizedOptions;
			}
			if ((!byCode[attrCode].inputType || byCode[attrCode].inputType === 'text') && inputType) {
				byCode[attrCode].inputType = String(inputType).toLowerCase();
			}
		}

		function markApplicableForSku(targetSku, code) {
			var skuKey = String(targetSku || '');
			var attrCode = String(code || '');
			if (!skuKey || !attrCode) {
				return;
			}
			if (!bulkAttributeApplicabilityBySku[skuKey]) {
				bulkAttributeApplicabilityBySku[skuKey] = {};
			}
			bulkAttributeApplicabilityBySku[skuKey][attrCode] = true;
		}

		for (i = 0; i < selectedSkus.length; i++) {
			sku = String(selectedSkus[i] || '');
			if (!sku) {
				continue;
			}

			product = getProductDataBySku(sku) || {};
			selectedProducts.push({ sku: sku, product: product });
			productCodeSeen[sku] = {};
			attrs = product && product.attributes && typeof product.attributes === 'object' ? product.attributes : {};
			metaList = product && Array.isArray(product.attribute_meta) ? product.attribute_meta : [];
			msiSources = Array.isArray(product.msi_sources) ? product.msi_sources : [];

			// Keep the exact configuration order from attribute assignment/sorting via attribute_meta.
			$.each(metaList, function (_, meta) {
				var code = String(meta && meta.attribute_code ? meta.attribute_code : '');
				var label = String(meta && meta.label ? meta.label : toTitle(code));
				var inputType = String(meta && meta.frontend_input ? meta.frontend_input : 'text');
				var options = Array.isArray(meta && meta.options) ? meta.options : [];
				if (!code || code === 'qty' || !Object.prototype.hasOwnProperty.call(attrs, code)) {
					return;
				}
				addCandidate(code, label, inputType, options);
				markApplicableForSku(sku, code);
				if (!productCodeSeen[sku][code]) {
					productCodeSeen[sku][code] = true;
					globalCountByCode[code] = (globalCountByCode[code] || 0) + 1;
				}
			});

			$.each(attrs, function (code) {
				var attrCode = String(code || '');
				if (attrCode === 'qty') {
					return;
				}
				addCandidate(attrCode, getAttributeLabelForCode(product, attrCode), 'text', []);
				markApplicableForSku(sku, attrCode);
				if (!productCodeSeen[sku][attrCode]) {
					productCodeSeen[sku][attrCode] = true;
					globalCountByCode[attrCode] = (globalCountByCode[attrCode] || 0) + 1;
				}
			});

			$.each(msiSources, function (_, source) {
				var sourceCode = String(source && source.source_code ? source.source_code : '');
				if (!sourceCode) {
					return;
				}
				addCandidate('__qty_group__', 'Qty', 'number', []);
				markApplicableForSku(sku, '__qty_group__');
				if (!productCodeSeen[sku]['__qty_group__']) {
					productCodeSeen[sku]['__qty_group__'] = true;
					globalCountByCode['__qty_group__'] = (globalCountByCode['__qty_group__'] || 0) + 1;
				}
			});

			addCandidate('__qty_group__', 'Qty', 'number', []);
			markApplicableForSku(sku, '__qty_group__');
			if (!productCodeSeen[sku]['__qty_group__']) {
				productCodeSeen[sku]['__qty_group__'] = true;
				globalCountByCode['__qty_group__'] = (globalCountByCode['__qty_group__'] || 0) + 1;
			}
		}

		totalProducts = selectedProducts.length;

		if (!totalProducts) {
			return [];
		}

		for (i = 0; i < selectedProducts.length; i++) {
			var setKey = String(selectedProducts[i].product && selectedProducts[i].product.attribute_set_id != null ? selectedProducts[i].product.attribute_set_id : 'unknown');
			var setTitle = getAttributeSetGroupLabel(selectedProducts[i].product);
			var setGroup = getOrCreateSetGroup(setKey, setTitle);
			var currentSku = String(selectedProducts[i].sku || '');
			var j;

			for (j = 0; j < order.length; j++) {
				var code = String(order[j] || '');
				if (!code || !bulkAttributeApplicabilityBySku[currentSku] || !bulkAttributeApplicabilityBySku[currentSku][code]) {
					continue;
				}
				if ((globalCountByCode[code] || 0) >= totalProducts) {
					continue;
				}
				if (codeSeenBySet[setKey][code]) {
					continue;
				}
				codeSeenBySet[setKey][code] = true;
				setGroup.items.push(byCode[code]);
			}
		}

		groups.push({
			title: 'Global',
			items: []
		});

		for (i = 0; i < order.length; i++) {
			var globalCode = String(order[i] || '');
			if (!globalCode) {
				continue;
			}
			if ((globalCountByCode[globalCode] || 0) >= totalProducts) {
				groups[0].items.push(byCode[globalCode]);
			}
		}

		if (!groups[0].items.length) {
			groups.shift();
		}

		for (i = 0; i < setOrder.length; i++) {
			if (setGroups[setOrder[i]] && setGroups[setOrder[i]].items.length) {
				groups.push(setGroups[setOrder[i]]);
			}
		}

		return groups;
	}

	function renderBulkAttributeList() {
		var groups = buildBulkAttributeCandidates();
		var html = [];
		var selectedMap = {};
		var i;
		var g;
		var items;

		for (i = 0; i < selectedBulkAttributes.length; i++) {
			selectedMap[String(selectedBulkAttributes[i] || '')] = true;
		}

		if (!groups.length) {
			$bulkAttrList.html('<div class="artm-editor-placeholder">No attributes available for selected products</div>');
			return;
		}

		for (g = 0; g < groups.length; g++) {
			items = groups[g].items || [];
			if (!items.length) {
				continue;
			}
			html.push('<div class="artm-bulk-attr-group">');
			html.push('<div class="artm-bulk-attr-group-title">' + escapeHtml(groups[g].title || '') + '</div>');
			for (i = 0; i < items.length; i++) {
				html.push(
					'<label class="artm-bulk-attr-item">'
					+ '<input type="checkbox" data-role="bulk-attr-check" value="' + escapeHtml(items[i].code) + '"' + (selectedMap[items[i].code] ? ' checked="checked"' : '') + ' />'
					+ '<span>' + escapeHtml(items[i].label) + '</span>'
					+ '</label>'
				);
			}
			html.push('</div>');
		}

		$bulkAttrList.html(html.join(''));
	}

	function getProductDataBySku(sku) {
		var key = normalizeSkuKey(sku);
		var found = null;
		$.each(loadedProductDataBySku, function (mapKey, mapVal) {
			if (normalizeSkuKey(mapKey) === key) {
				found = mapVal;
				return false;
			}
		});
		return found;
	}

	function getCachedProductResponse(sku) {
		var key = normalizeSkuKey(sku);
		return key && productResponseCache[key] ? productResponseCache[key] : null;
	}

	function setProductDataBySku(sku, data) {
		if (!sku) {
			return;
		}
		loadedProductDataBySku[String(sku)] = data || {};
	}

	function cacheProductResponse(product) {
		var key;
		if (!product || !product.sku) {
			return;
		}
		key = normalizeSkuKey(product.sku);
		if (!key) {
			return;
		}
		productResponseCache[key] = product;
	}

	function filterAttributesBySetConfig(attrs, setId, configMap) {
		var setKey = String(setId || '');
		var allowedCodes;
		var filtered;
		var i;

		if (!setKey || !configMap || !configMap[setKey]) {
			return attrs;
		}
		allowedCodes = configMap[setKey];
		if (!Array.isArray(allowedCodes) || allowedCodes.length === 0) {
			return attrs;
		}
		filtered = {};
		for (i = 0; i < allowedCodes.length; i++) {
			if (attrs.hasOwnProperty(allowedCodes[i])) {
				filtered[allowedCodes[i]] = attrs[allowedCodes[i]];
			}
		}
		return filtered;
	}

	function normalizeApiProductResponse(response) {
		var normalized = response || {};
		var children = Array.isArray(normalized.children) ? normalized.children : [];
		var i;

		// Merge attribute_set_config map into local cache for future filtering
		if (normalized.attribute_set_config && typeof normalized.attribute_set_config === 'object') {
			$.extend(attributeSetConfigMap, normalized.attribute_set_config);
		}

		normalized.type = String(normalized.type || normalized.type_id || 'simple');
		normalized.status = String(normalized.status || 'Draft');
		normalized.attribute_meta = Array.isArray(normalized.attribute_meta) ? normalized.attribute_meta : [];
		normalized.msi_sources = cloneQtySources(Array.isArray(normalized.msi_sources) ? normalized.msi_sources : []);
		normalized.msi_source_options = Array.isArray(normalized.msi_source_options) ? normalized.msi_source_options : [];
		normalized.children = children;

		// Filter attributes for this product based on its attribute_set_id
		normalized.attributes = filterAttributesBySetConfig(
			normalized.attributes || {},
			normalized.attribute_set_id,
			attributeSetConfigMap
		);

		for (i = 0; i < children.length; i++) {
			children[i].type = String(children[i].type || children[i].type_id || 'simple');
			children[i].status = String(children[i].status || 'Draft');
			children[i].attribute_meta = Array.isArray(children[i].attribute_meta) ? children[i].attribute_meta : [];
			children[i].msi_sources = cloneQtySources(Array.isArray(children[i].msi_sources) ? children[i].msi_sources : []);
			children[i].msi_source_options = Array.isArray(children[i].msi_source_options) ? children[i].msi_source_options : normalized.msi_source_options;
			children[i].children = Array.isArray(children[i].children) ? children[i].children : [];

			// Filter child attributes using child's own attribute_set_id
			children[i].attributes = filterAttributesBySetConfig(
				children[i].attributes || {},
				children[i].attribute_set_id || normalized.attribute_set_id,
				attributeSetConfigMap
			);
		}

		return normalized;
	}

	function syncLoadedProductData(product) {
		var children;
		var i;

		if (!product || !product.sku) {
			return;
		}

		setProductDataBySku(product.sku, product);
		children = Array.isArray(product.children) ? product.children : [];
		for (i = 0; i < children.length; i++) {
			setProductDataBySku(children[i].sku, children[i]);
		}
	}

	function findLoadedConfigurableParentProduct(childSku) {
		var target = normalizeSkuKey(childSku);
		var i;
		var c;
		var children;
		for (i = 0; i < loadedProducts.length; i++) {
			if (String(loadedProducts[i] && loadedProducts[i].type || '').toLowerCase() !== 'configurable') {
				continue;
			}
			children = Array.isArray(loadedProducts[i].children) ? loadedProducts[i].children : [];
			for (c = 0; c < children.length; c++) {
				if (normalizeSkuKey(children[c] && children[c].sku || '') === target) {
					return loadedProducts[i];
				}
			}
		}
		return null;
	}

	function ensurePreviewParentLoaded(product) {
		var childSku = String(product && product.sku || '');
		var childKey = normalizeSkuKey(childSku);
		var parentId = parseInt(product && product.parent_id ? product.parent_id : 0, 10) || 0;
		if (!childKey || parentId <= 0 || previewParentByChildSku[childKey] || previewParentPendingByChildSku[childKey]) {
			return;
		}

		previewParentPendingByChildSku[childKey] = true;
		requestProductFromAdminApiByType(String(parentId), 'id').done(function (response) {
			var normalizedParent = normalizeApiProductResponse(response);
			if (normalizedParent && String(normalizedParent.type || '').toLowerCase() === 'configurable' && normalizedParent.sku) {
				previewParentByChildSku[childKey] = normalizedParent;
				if (Array.isArray(normalizedParent.children)) {
					$.each(normalizedParent.children, function (_, child) {
						var cKey = normalizeSkuKey(child && child.sku ? child.sku : '');
						if (cKey) {
							previewParentByChildSku[cKey] = normalizedParent;
						}
					});
				}
			}
		}).always(function () {
			delete previewParentPendingByChildSku[childKey];
			if (normalizeSkuKey(activeSku) === childKey) {
				renderProduct(product);
			}
		});
	}

	function getBulkCellValue(sku, attrCode) {
		var product = getProductDataBySku(sku) || {};
		var attrs = product.attributes || {};
		var msiSources = Array.isArray(product.msi_sources) ? product.msi_sources : [];
		var sourceCode;
		var i;
		var val = attrs[attrCode];

		if (isQtyGroupCode(attrCode)) {
			return cloneQtySources(msiSources);
		}

		if (isMsiAttributeCode(attrCode)) {
			sourceCode = String(attrCode).replace(/^msi_qty__/, '');
			for (i = 0; i < msiSources.length; i++) {
				if (String(msiSources[i] && msiSources[i].source_code || '') === sourceCode) {
					return String(msiSources[i] && msiSources[i].qty != null ? msiSources[i].qty : '');
				}
			}
			return '';
		}

		if (val == null) {
			return '';
		}
		return String(val);
	}

	function hasBulkAttributeForSku(sku, attrCode) {
		var skuKey = String(sku || '');
		var code = String(attrCode || '');
		return !!(bulkAttributeApplicabilityBySku[skuKey] && bulkAttributeApplicabilityBySku[skuKey][code]);
	}

	function initBulkGridData() {
		var s;
		var a;
		var sku;
		var attr;
		var val;

		bulkGridOriginalData = {};
		bulkGridData = {};
		bulkGridChanges = {};
		bulkHeaderCopyValues = {};

		for (s = 0; s < selectedSkus.length; s++) {
			sku = String(selectedSkus[s] || '');
			if (!sku) {
				continue;
			}

			bulkGridOriginalData[sku] = {};
			bulkGridData[sku] = {};

			for (a = 0; a < selectedBulkAttributes.length; a++) {
				attr = String(selectedBulkAttributes[a] || '');
				if (!attr) {
					continue;
				}
				val = getBulkCellValue(sku, attr);
				if (isQtyGroupCode(attr)) {
					bulkGridOriginalData[sku][attr] = cloneQtySources(val);
					bulkGridData[sku][attr] = cloneQtySources(val);
					continue;
				}
				bulkGridOriginalData[sku][attr] = val;
				bulkGridData[sku][attr] = val;
			}
		}
	}

	function getBulkQtySourcesForSku(sku) {
		if (!bulkGridData[sku]) {
			bulkGridData[sku] = {};
		}
		if (!Array.isArray(bulkGridData[sku].__qty_group__)) {
			bulkGridData[sku].__qty_group__ = [];
		}
		return bulkGridData[sku].__qty_group__;
	}

	function buildBulkQtyGroupCellControl(sku) {
		var sources = cloneQtySources(getBulkQtySourcesForSku(sku));
		var product = getProductDataBySku(sku) || {};
		var options = getProductMsiSourceOptions(product);
		var existing = {};
		var html = [];
		var i;

		html.push('<div class="artm-qty-group artm-bulk-qty-cell">');
		html.push('<div class="artm-qty-group-list">');
		for (i = 0; i < sources.length; i++) {
			existing[String(sources[i].source_code || '')] = true;
			html.push('<div class="artm-qty-source-row" data-role="bulk-qty-source-row" data-sku="' + escapeHtml(sku) + '" data-source-code="' + escapeHtml(sources[i].source_code || '') + '">');
			html.push('<span class="artm-qty-source-name">' + escapeHtml(sources[i].source_name || sources[i].source_code || '') + '</span>');
			html.push('<input type="number" step="0.0001" class="admin__control-text artm-qty-source-input" data-role="bulk-qty-input" data-sku="' + escapeHtml(sku) + '" data-source-code="' + escapeHtml(sources[i].source_code || '') + '" value="' + escapeHtml(normalizeQtyValue(sources[i].qty)) + '" />');
			html.push('</div>');
		}
		html.push('</div>');

		html.push('<div class="artm-qty-add-row">');
		html.push('<select class="admin__control-select artm-qty-add-source" data-role="bulk-qty-add-source" data-sku="' + escapeHtml(sku) + '">');
		html.push('<option value="">Add source...</option>');
		for (i = 0; i < options.length; i++) {
			var code = String(options[i] && options[i].source_code ? options[i].source_code : '').trim();
			if (!code || existing[code]) {
				continue;
			}
			html.push('<option value="' + escapeHtml(code) + '">' + escapeHtml(String(options[i] && options[i].source_name ? options[i].source_name : code)) + '</option>');
		}
		html.push('</select>');
		html.push('<input type="number" step="0.0001" class="admin__control-text artm-qty-add-value" data-role="bulk-qty-add-value" data-sku="' + escapeHtml(sku) + '" value="" placeholder="Qty" />');
		html.push('<button type="button" class="action-secondary" data-role="bulk-qty-add-btn" data-sku="' + escapeHtml(sku) + '">Add</button>');
		html.push('</div>');
		html.push('</div>');

		return html.join('');
	}

	function setBulkQtySourceValue(sku, sourceCode, qtyValue, sourceName) {
		var code = String(sourceCode || '').trim();
		var name = String(sourceName || code);
		var qty = normalizeQtyValue(qtyValue);
		var list;
		var i;
		if (!code) {
			return;
		}
		list = getBulkQtySourcesForSku(sku);
		for (i = 0; i < list.length; i++) {
			if (String(list[i].source_code || '') === code) {
				list[i].qty = qty;
				updateBulkCellChangedState(sku, '__qty_group__');
				refreshBulkRowStatusByChanges(sku);
				return;
			}
		}
		list.push({ source_code: code, source_name: name, qty: qty });
		updateBulkCellChangedState(sku, '__qty_group__');
		refreshBulkRowStatusByChanges(sku);
	}

	function buildBulkCopySourceControl(attr) {
		var meta = bulkAttributeMetaByCode[attr] || {};
		var options = Array.isArray(meta.options) ? meta.options : [];
		var inputType = String(meta.inputType || '').toLowerCase();
		var current = String(bulkHeaderCopyValues[attr] == null ? '' : bulkHeaderCopyValues[attr]);
		var html;
		var i;

		if (isQtyGroupCode(attr)) {
			return '';
		}

		if ((inputType === 'select' || inputType === 'boolean') && options.length) {
			html = '<select class="admin__control-select artm-bulk-copy-source" data-role="bulk-copy-source" data-attr="' + escapeHtml(attr) + '">';
			html += '<option value="">Select value</option>';
			for (i = 0; i < options.length; i++) {
				var ov = String(options[i] && options[i].value != null ? options[i].value : '');
				var ol = String(options[i] && options[i].label != null ? options[i].label : ov);
				var selected = (ov === current || ol === current) ? ' selected="selected"' : '';
				html += '<option value="' + escapeHtml(ov) + '"' + selected + '>' + escapeHtml(ol) + '</option>';
			}
			html += '</select>';
			return html;
		}

		if (inputType === 'price' || inputType === 'weight' || inputType === 'number' || String(attr || '') === 'price' || String(attr || '') === 'qty' || isMsiAttributeCode(attr)) {
			return '<input type="number" step="0.0001" class="admin__control-text artm-bulk-copy-source" data-role="bulk-copy-source" data-attr="' + escapeHtml(attr) + '" value="' + escapeHtml(current) + '" placeholder="Value to copy" />';
		}

		return '<input type="text" class="admin__control-text artm-bulk-copy-source" data-role="bulk-copy-source" data-attr="' + escapeHtml(attr) + '" value="' + escapeHtml(current) + '" placeholder="Value to copy" />';
	}

	function buildBulkGridCellControl(sku, attr, value) {
		var meta = bulkAttributeMetaByCode[attr] || {};
		var inputType = String(meta.inputType || 'text').toLowerCase();
		var options = Array.isArray(meta.options) ? meta.options : [];
		var safeValue = String(value == null ? '' : value);
		var applicable = hasBulkAttributeForSku(sku, attr);
		var disabledAttr = applicable ? '' : ' disabled="disabled"';
		var i;
		var html;

		if (!applicable) {
			return '<input type="text" class="admin__control-text artm-bulk-grid-input" data-role="bulk-grid-input" data-sku="' + escapeHtml(sku) + '" data-attr="' + escapeHtml(attr) + '" value=""' + disabledAttr + ' />';
		}

		if (isQtyGroupCode(attr)) {
			return buildBulkQtyGroupCellControl(sku);
		}

		if ((inputType === 'select' || inputType === 'boolean') && options.length) {
			html = '<select class="admin__control-select artm-bulk-grid-input" data-role="bulk-grid-input" data-sku="' + escapeHtml(sku) + '" data-attr="' + escapeHtml(attr) + '">';
			html += '<option value="">-- Select --</option>';
			for (i = 0; i < options.length; i++) {
				var ov = String(options[i] && options[i].value != null ? options[i].value : '');
				var ol = String(options[i] && options[i].label != null ? options[i].label : ov);
				var selected = (safeValue === ov || safeValue === ol) ? ' selected="selected"' : '';
				html += '<option value="' + escapeHtml(ov) + '"' + selected + '>' + escapeHtml(ol) + '</option>';
			}
			html += '</select>';
			return html;
		}

		if (inputType === 'price' || inputType === 'weight' || inputType === 'number' || String(attr || '') === 'price' || String(attr || '') === 'qty' || isMsiAttributeCode(attr)) {
			return '<input type="number" step="0.0001" class="admin__control-text artm-bulk-grid-input" data-role="bulk-grid-input" data-sku="' + escapeHtml(sku) + '" data-attr="' + escapeHtml(attr) + '" value="' + escapeHtml(safeValue) + '" />';
		}

		return '<input type="text" class="admin__control-text artm-bulk-grid-input" data-role="bulk-grid-input" data-sku="' + escapeHtml(sku) + '" data-attr="' + escapeHtml(attr) + '" value="' + escapeHtml(safeValue) + '" />';
	}

	function renderBulkGrid() {
		var html = '';
		var s;
		var a;
		var sku;
		var attr;
		var value;

		if (!selectedBulkAttributes.length || selectedSkus.length < 1) {
			$bulkGridWrap.hide();
			$bulkGridContainer.empty();
			return;
		}

		html += '<table class="artm-bulk-grid-table">';
		html += '<thead><tr><th>SKU</th>';
		for (a = 0; a < selectedBulkAttributes.length; a++) {
			attr = String(selectedBulkAttributes[a] || '');
			var meta = bulkAttributeMetaByCode[attr] || {};
			var headerLabel = String(meta.label || attr);
			if (!isQtyGroupCode(attr)) {
				headerLabel += ' (' + String(attr) + ')';
			}
			html += '<th><span class="artm-bulk-head">'
				+ '<span class="artm-bulk-head-top">'
				+ '<span>' + escapeHtml(headerLabel) + '</span>'
				+ (isQtyGroupCode(attr) ? '' : '<button type="button" class="artm-bulk-copy-col" data-role="bulk-copy-col" data-attr="' + escapeHtml(attr) + '" title="Copy source value to all">Copy</button>')
				+ '</span>'
				+ buildBulkCopySourceControl(attr)
				+ '</span></th>';
		}
		html += '<th>Status</th></tr></thead><tbody>';

		for (s = 0; s < selectedSkus.length; s++) {
			sku = String(selectedSkus[s] || '');
			if (!sku) {
				continue;
