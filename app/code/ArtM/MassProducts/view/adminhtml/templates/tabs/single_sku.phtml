	var $layout = $root.find('[data-role="single-sku-layout"]');
	var $loadMessage = $root.find('[data-role="single-sku-load-message"]');
	var $saveBtn = $root.find('[data-role="single-sku-save-btn"]');
	var $saveAllWrap = $root.find('[data-role="single-sku-save-all-wrap"]');
	var $saveAllBtn = $root.find('[data-role="single-sku-save-all-btn"]');
	var $sidebarSaveAllWrap = $root.find('[data-role="single-sku-saveall-wrap"]');
	var $sidebarSaveAllBtn = $root.find('[data-role="single-sku-saveall-btn"]');
