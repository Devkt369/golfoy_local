			html += '<tr class="artm-bulk-row--no-edits" data-role="bulk-grid-row" data-sku="' + escapeHtml(sku) + '">';
			html += '<td><span class="artm-bulk-grid-sku">' + escapeHtml(sku) + '</span></td>';
			for (a = 0; a < selectedBulkAttributes.length; a++) {
				attr = String(selectedBulkAttributes[a] || '');
				if (isQtyGroupCode(attr)) {
					value = hasBulkAttributeForSku(sku, attr) && bulkGridData[sku] ? (bulkGridData[sku][attr] || []) : [];
				} else {
					value = hasBulkAttributeForSku(sku, attr) && bulkGridData[sku] && bulkGridData[sku][attr] != null ? String(bulkGridData[sku][attr]) : '';
				}
				html += '<td data-role="bulk-grid-cell" data-sku="' + escapeHtml(sku) + '" data-attr="' + escapeHtml(attr) + '">'
					+ buildBulkGridCellControl(sku, attr, value)
					+ '</td>';
			}
			html += '<td class="artm-bulk-row-status"><span class="artm-bulk-row-status-badge" data-role="bulk-row-status-badge" data-sku="' + escapeHtml(sku) + '">No edits</span></td>';
			html += '</tr>';
		}

		html += '</tbody></table>';
		$bulkGridContainer.html(html);
		$bulkUpdateSummary.text('Review values and click Update All.');
	}

	function updateBulkCellChangedState(sku, attr) {
		var current;
		var original;
		var changeKey = sku + '::' + attr;
		var $cell = $bulkGridContainer.find('[data-role="bulk-grid-cell"][data-sku="' + sku.replace(/"/g, '\\"') + '"][data-attr="' + attr.replace(/"/g, '\\"') + '"]');

		if (isQtyGroupCode(attr)) {
			current = JSON.stringify(buildQtySourceMapFromList(bulkGridData[sku] && bulkGridData[sku][attr] ? bulkGridData[sku][attr] : []));
			original = JSON.stringify(buildQtySourceMapFromList(bulkGridOriginalData[sku] && bulkGridOriginalData[sku][attr] ? bulkGridOriginalData[sku][attr] : []));
		} else {
			current = (bulkGridData[sku] && bulkGridData[sku][attr] != null) ? String(bulkGridData[sku][attr]) : '';
			original = (bulkGridOriginalData[sku] && bulkGridOriginalData[sku][attr] != null) ? String(bulkGridOriginalData[sku][attr]) : '';
		}

		if (current !== original) {
			bulkGridChanges[changeKey] = current;
			$cell.addClass('artm-bulk-grid-cell-changed');
			return;
		}

		delete bulkGridChanges[changeKey];
		$cell.removeClass('artm-bulk-grid-cell-changed');
	}

	function setBulkCellValue(sku, attr, value) {
		if (!bulkGridData[sku]) {
			bulkGridData[sku] = {};
		}
		if (isQtyGroupCode(attr)) {
			bulkGridData[sku][attr] = cloneQtySources(Array.isArray(value) ? value : []);
		} else {
			bulkGridData[sku][attr] = String(value == null ? '' : value);
		}
		updateBulkCellChangedState(sku, attr);
		refreshBulkRowStatusByChanges(sku);
	}

	function setBulkRowStatus(sku, state, label) {
		var normalizedState = String(state || 'no-edits');
		var text = String(label || 'No edits');
		var skuSelector = String(sku || '').replace(/"/g, '\\"');
		var $row = $bulkGridContainer.find('[data-role="bulk-grid-row"][data-sku="' + skuSelector + '"]');
		var $badge = $bulkGridContainer.find('[data-role="bulk-row-status-badge"][data-sku="' + skuSelector + '"]');

		$row.removeClass('artm-bulk-row--no-edits artm-bulk-row--changed artm-bulk-row--waiting artm-bulk-row--processing artm-bulk-row--updated artm-bulk-row--failed')
			.addClass('artm-bulk-row--' + normalizedState);
		$badge.text(text);
	}

	function refreshBulkRowStatusByChanges(sku) {
		var changed = collectChangedAttributesForSku(sku);
		if ($.isEmptyObject(changed)) {
			setBulkRowStatus(sku, 'no-edits', 'No edits');
			return;
		}
		setBulkRowStatus(sku, 'changed', 'Changed');
	}

	function collectChangedAttributesForSku(sku) {
		var changed = {};
		var i;
		var attr;
		var current;
		var original;

		for (i = 0; i < selectedBulkAttributes.length; i++) {
			attr = String(selectedBulkAttributes[i] || '');
			if (!attr || !hasBulkAttributeForSku(sku, attr)) {
				continue;
			}
			if (isQtyGroupCode(attr)) {
				$.extend(changed, getQtyDiffAttributes(
					bulkGridOriginalData[sku] && bulkGridOriginalData[sku][attr] ? bulkGridOriginalData[sku][attr] : [],
					bulkGridData[sku] && bulkGridData[sku][attr] ? bulkGridData[sku][attr] : []
				));
				continue;
			}
			current = bulkGridData[sku] && bulkGridData[sku][attr] != null ? String(bulkGridData[sku][attr]) : '';
			original = bulkGridOriginalData[sku] && bulkGridOriginalData[sku][attr] != null ? String(bulkGridOriginalData[sku][attr]) : '';
			if (current !== original) {
				changed[attr] = current;
			}
		}

		return changed;
	}

	function applyBulkChangesToLocalCache(sku, changedAttributes) {
		var product = getProductDataBySku(sku);
		var msiSources;
		var sourceCode;
		var i;

		if (!product || !changedAttributes || typeof changedAttributes !== 'object') {
			return;
		}

		if (!product.attributes || typeof product.attributes !== 'object') {
			product.attributes = {};
		}

		msiSources = Array.isArray(product.msi_sources) ? product.msi_sources : [];

		$.each(changedAttributes, function (code, value) {
			var attrCode = String(code || '');
			if (!attrCode) {
				return;
			}
			if (isMsiAttributeCode(attrCode)) {
				sourceCode = attrCode.replace(/^msi_qty__/, '');
				for (i = 0; i < msiSources.length; i++) {
					if (String(msiSources[i] && msiSources[i].source_code || '') === sourceCode) {
						msiSources[i].qty = value;
						return;
					}
				}
				msiSources.push({
					source_code: sourceCode,
					source_name: sourceCode,
					qty: value
				});
				return;
			}
			product.attributes[attrCode] = value;
		});
	}

	function runBulkUpdateAll() {
		var queue = [];
		var i;
		var sku;
		var changed;
		var doneCount = 0;
		var successCount = 0;
		var failedCount = 0;
		var deferred = $.Deferred();

		for (i = 0; i < selectedSkus.length; i++) {
			sku = String(selectedSkus[i] || '');
			if (!sku) {
				continue;
			}
			setBulkRowStatus(sku, 'no-edits', 'No edits');
			changed = collectChangedAttributesForSku(sku);
			if (!$.isEmptyObject(changed)) {
				setBulkRowStatus(sku, 'waiting', 'Waiting');
				queue.push({ sku: sku, attributes: changed });
			}
		}

		if (!queue.length) {
			$bulkUpdateSummary.text('No row changes to update.');
			deferred.resolve();
			return deferred.promise();
		}

		function processNext(index) {
			var row;
			if (index >= queue.length) {
				$bulkUpdateSummary.text('Updated ' + successCount + ' row(s), failed ' + failedCount + ' row(s).');
				deferred.resolve();
				return;
			}

			row = queue[index];
			setBulkRowStatus(row.sku, 'processing', 'Processing...');

			saveProductChanges(row.sku, row.attributes).done(function () {
				var attrCode;
				var attrValue;
				successCount += 1;
				for (attrCode in row.attributes) {
					if (!Object.prototype.hasOwnProperty.call(row.attributes, attrCode)) {
						continue;
					}
					attrValue = String(row.attributes[attrCode] == null ? '' : row.attributes[attrCode]);
					if (!bulkGridOriginalData[row.sku]) {
						bulkGridOriginalData[row.sku] = {};
					}
					bulkGridOriginalData[row.sku][attrCode] = attrValue;
					setBulkCellValue(row.sku, attrCode, attrValue);
				}
				applyBulkChangesToLocalCache(row.sku, row.attributes);
				setBulkRowStatus(row.sku, 'updated', 'Updated');
			}).fail(function (xhr) {
				var msg = 'Failed';
				failedCount += 1;
				if (xhr && xhr.responseJSON && xhr.responseJSON.message) {
					msg = String(xhr.responseJSON.message);
				}
				// Detect form key expiration and suggest page refresh
				if (msg.toLowerCase().indexOf('form key') !== -1 || msg.toLowerCase().indexOf('csrf') !== -1) {
					msg = msg + ' Please refresh the page.';
				}
				setBulkRowStatus(row.sku, 'failed', msg);
			}).always(function () {
				doneCount += 1;
				$bulkUpdateSummary.text('Processing ' + doneCount + '/' + queue.length + '...');
				processNext(index + 1);
			});
		}

		processNext(0);
		return deferred.promise();
	}

	function setSkuSelectedState(sku, shouldSelect) {
		var key = normalizeSkuKey(sku);
		var i;
		if (!key) {
			return;
		}

		if (shouldSelect) {
			if (!hasSelectedSku(sku)) {
				selectedSkus.push(sku);
			}
			updateBulkButtonVisibility();
			return;
		}

		for (i = selectedSkus.length - 1; i >= 0; i--) {
			if (normalizeSkuKey(selectedSkus[i]) === key) {
				selectedSkus.splice(i, 1);
			}
		}
		updateBulkButtonVisibility();
	}

	function requestProductFromRestApi(sku) {
		return $.ajax({
			url: restApiUrl,
			method: 'POST',
			contentType: 'application/json',
			dataType: 'json',
			data: JSON.stringify({
				identifier: sku,
				type: 'sku'
			})
		});
	}

	function requestProductFromAdminApiByType(identifier, identifierType) {
		var formKey = getFormKey();

		if (!adminApiUrl) {
			return $.Deferred().reject({ responseJSON: { message: 'Product not found' } }).promise();
		}

		return $.ajax({
			url: adminApiUrl,
			method: 'POST',
			dataType: 'json',
			cache: false,
			headers: {
				'X-Form-Key': formKey
			},
			data: {
				identifier: identifier,
				type: identifierType,
				store_id: currentStoreId,
				form_key: formKey,
				_: Date.now()
			}
		});
	}

	function requestProductFromAdminApi(sku) {
		return requestProductFromAdminApiByType(sku, 'sku');
	}

	function loadProductBySku(sku, options) {
		var opts = options || {};
		var cached = getCachedProductResponse(sku);
		var deferred = $.Deferred();

		if (opts.forceReload) {
			// Clear JS cache so stale data from a previous admin edit is not used
			var clearKey = normalizeSkuKey(sku);
			if (clearKey && productResponseCache[clearKey]) {
				delete productResponseCache[clearKey];
			}
			cached = null;
		}

		if (cached && !opts.forceReload) {
			deferred.resolve(cached);
			return deferred.promise();
		}

		requestProductFromAdminApi(sku).done(function (response) {
			deferred.resolve(normalizeApiProductResponse(response));
		}).fail(function (xhr) {
			deferred.reject(xhr);
		});

		return deferred.promise();
	}

	function escapeHtml(value) {
		return String(value == null ? '' : value)
			.replace(/&/g, '&amp;')
			.replace(/</g, '&lt;')
			.replace(/>/g, '&gt;')
			.replace(/"/g, '&quot;')
			.replace(/'/g, '&#039;');
	}

	function toTitle(text) {
		var normalized = String(text || '').replace(/_/g, ' ');
		return normalized.charAt(0).toUpperCase() + normalized.slice(1);
	}

	function updateSaveVisibility() {
		var hasFieldChanges = $attrsContainer.find('.artm-attr-field.artm-field-changed').length > 0;
		var hasQtyChanges = $attrsContainer.find('[data-role="qty-source-row"].artm-is-changed').length > 0;
		if (hasFieldChanges || hasQtyChanges) {
			$saveWrap.show();
			$saveBtn.prop('disabled', false);
			return;
		}
		$saveWrap.hide();
		$saveBtn.prop('disabled', true);
		persistActiveDraftState();
	}

	function collectChangedAttributes() {
		var data = {};
		$attrsContainer.find('.artm-attr-field.artm-field-changed').each(function () {
			var $field = $(this);
			var key = String($field.attr('data-key') || '');
			var value = String($field.attr('data-current') || '');
			if (!key) {
				return;
			}
			data[key] = value;
		});

		$attrsContainer.find('[data-role="qty-source-row"]').each(function () {
			var $row = $(this);
			var sourceCode = String($row.attr('data-source-code') || '');
			var current = normalizeQtyValue($row.attr('data-current'));
			var original = normalizeQtyValue($row.attr('data-original'));
			if (!sourceCode) {
				return;
			}
			if (current !== original) {
				data['msi_qty__' + sourceCode] = current;
			}
		});

		return data;
	}

	function saveProductChanges(sku, attributes) {
		var saveUrl;
		var formKey = getFormKey();

		if (!adminSaveUrl) {
			return $.Deferred().reject({ responseJSON: { message: 'Save URL is not available.' } }).promise();
		}
		saveUrl = adminSaveUrl + (adminSaveUrl.indexOf('?') === -1 ? '?' : '&') + 'isAjax=1&_t=' + Date.now();

		var deferred = $.Deferred();

		$.ajax({
			url: saveUrl,
			method: 'POST',
			dataType: 'json',
			cache: false,
			headers: {
				'X-Form-Key': formKey
			},
			data: {
				sku: sku,
				attributes: attributes,
				store_id: currentStoreId,
				form_key: formKey,
				isAjax: 1
			}
		}).done(function (response) {
			if (response && response.success === false) {
				deferred.reject({ responseJSON: response });
			} else {
				deferred.resolve(response);
			}
		}).fail(function (xhr) {
			deferred.reject(xhr);
		});
		return deferred.promise();
	}

	function normalizeSkuKey(sku) {
		return String(sku || '').toLowerCase();
	}

	function findLoadedProductIndex(sku) {
		var key = normalizeSkuKey(sku);
		var i;
		for (i = 0; i < loadedProducts.length; i++) {
			if (normalizeSkuKey(loadedProducts[i].sku) === key) {
				return i;
			}
		}
		return -1;
	}

	function findSkuByKey(key) {
		var match = '';
		if (!key) {
			return '';
		}
		$.each(Object.keys(loadedProductDataBySku), function (_, mapKey) {
			if (normalizeSkuKey(mapKey) === key) {
				match = String(mapKey || '');
				return false;
			}
			return true;
		});
		if (match) {
			return match;
		}
		return '';
	}

	function isSkuChildOfLoadedConfigurable(sku) {
		var key = normalizeSkuKey(sku);
		var i;
		var c;
		var children;
		if (!key) {
			return false;
		}
		for (i = 0; i < loadedProducts.length; i++) {
			if (String(loadedProducts[i] && loadedProducts[i].type || '').toLowerCase() !== 'configurable') {
				continue;
			}
			children = Array.isArray(loadedProducts[i].children) ? loadedProducts[i].children : [];
			for (c = 0; c < children.length; c++) {
				if (normalizeSkuKey(children[c] && children[c].sku || '') === key) {
					return true;
				}
			}
		}
		return false;
	}

	function findLoadedConfigurableParentIndexForProduct(product) {
		var parentId = parseInt(product && product.parent_id ? product.parent_id : 0, 10) || 0;
		var childKey = normalizeSkuKey(product && product.sku ? product.sku : '');
		var i;
		var c;
		var parent;
		var children;

		if (!childKey) {
			return -1;
		}

		for (i = 0; i < loadedProducts.length; i++) {
			parent = loadedProducts[i] || {};
			if (String(parent.type || '').toLowerCase() !== 'configurable') {
				continue;
			}

			if (parentId > 0 && (parseInt(parent.id || 0, 10) || 0) === parentId) {
				return i;
			}

			children = Array.isArray(parent.children) ? parent.children : [];
			for (c = 0; c < children.length; c++) {
				if (normalizeSkuKey(children[c] && children[c].sku || '') === childKey) {
					return i;
				}
			}
		}

		return -1;
	}

	function upsertChildIntoLoadedParent(parentIndex, product) {
		var parent;
		var parentData;
		var parentKey;
		var childSku;
		var childKey;
		var children;
		var i;
		var childType;
		var childStatus;
		if (parentIndex < 0 || !product || !product.sku) {
			return;
		}

		parent = loadedProducts[parentIndex];
		if (!parent || String(parent.type || '').toLowerCase() !== 'configurable') {
			return;
		}

		parentKey = normalizeSkuKey(parent.sku);
		childSku = String(product.sku || '');
		childKey = normalizeSkuKey(childSku);
		childType = String(product.type || product.type_id || 'simple').toLowerCase();
		childStatus = String(product.status || 'Draft');
		children = Array.isArray(parent.children) ? parent.children : [];
		parentData = getProductDataBySku(parent.sku) || null;

		for (i = 0; i < children.length; i++) {
			if (normalizeSkuKey(children[i] && children[i].sku || '') === childKey) {
				children[i] = $.extend({}, children[i], product, {
					sku: childSku,
					type: childType,
					status: childStatus
				});
				parent.children = children;
				if (parentData) {
					parentData.children = children;
					setProductDataBySku(parent.sku, parentData);
				}
				expandedParents[parentKey] = true;
				return;
			}
		}

		children.push({
			sku: childSku,
			type: childType,
			status: childStatus,
			id: product.id || null,
			parent_id: product.parent_id || null
		});
		parent.children = children;
		if (parentData) {
			parentData.children = children;
			setProductDataBySku(parent.sku, parentData);
		}
		expandedParents[parentKey] = true;
	}

	function pruneTopLevelChildren(children, parentSku) {
		var childMap = {};
		var parentKey = normalizeSkuKey(parentSku);
		var i;
		var skuKey;
		$.each(Array.isArray(children) ? children : [], function (_, child) {
			var childSku = String(child && child.sku ? child.sku : '');
			if (!childSku) {
				return;
			}
			childMap[normalizeSkuKey(childSku)] = true;
		});

		for (i = loadedProducts.length - 1; i >= 0; i--) {
			skuKey = normalizeSkuKey(loadedProducts[i] && loadedProducts[i].sku || '');
			if (!skuKey || skuKey === parentKey) {
				continue;
			}
			if (childMap[skuKey]) {
				loadedProducts.splice(i, 1);
			}
		}
	}

	function buildSidebarItemHtml(item) {
		var isActive = normalizeSkuKey(item.sku) === normalizeSkuKey(activeSku);
		var isConfigurable = String(item.type || '').toLowerCase() === 'configurable';
		var isExpanded = !!expandedParents[normalizeSkuKey(item.sku)];
		var children = Array.isArray(item.children) ? item.children : [];
		var statusMeta = getSkuSidebarStatus(item.sku);
		var statusState = String(statusMeta && statusMeta.state ? statusMeta.state : 'loaded');
		var statusLabel = String(statusMeta && statusMeta.label ? statusMeta.label : 'Loaded');
		var productData = getProductDataBySku(item.sku) || {};
		var fullTitle = String(item.sku || '');
		if (productData && productData.name) {
			fullTitle += ' - ' + String(productData.name);
		}
		var hasDraft = hasDraftForSku(item.sku);
		var html = '';
		var toggleHtml = '<span style="display:inline-block;width:16px;"></span>';
		var parentCls = 'artm-loaded-group' + (isActive ? ' artm-is-active' : '');
		var parentChecked = hasSelectedSku(item.sku) ? ' checked="checked"' : '';
		var i;

		if (isConfigurable) {
			toggleHtml = '<button type="button" class="artm-loaded-parent-toggle' + (isExpanded ? '' : ' artm-collapsed') + '" data-role="loaded-parent-toggle" data-sku="' + escapeHtml(item.sku) + '">&#9662;</button>';
		}

			html += '<div class="' + parentCls + '" data-role="loaded-product-item" data-sku="' + escapeHtml(item.sku) + '" title="' + escapeHtml(fullTitle) + '">' 
			+ '<div class="artm-loaded-mainline">'
			+ '<input type="checkbox" data-role="loaded-product-check" data-sku="' + escapeHtml(item.sku) + '"' + parentChecked + ' />'
			+ toggleHtml
			+ '<span class="artm-loaded-sku" title="' + escapeHtml(fullTitle) + '">' + escapeHtml(item.sku) + '</span>'
			+ '<span class="artm-status-badge artm-status-' + escapeHtml(statusState) + '">' + escapeHtml(statusLabel) + '</span>'
			+ '</div>'
			+ '<div class="artm-loaded-actionsline">'
			+ '<button type="button" class="artm-loaded-save" data-role="loaded-product-save" data-sku="' + escapeHtml(item.sku) + '" title="Save unsaved changes"' + (hasDraft ? '' : ' disabled="disabled"') + '>&#128190;</button>'
			+ '<button type="button" class="artm-loaded-reload" data-role="loaded-product-reload" data-sku="' + escapeHtml(item.sku) + '" title="Reload fresh data">↻</button>'
			+ '<button type="button" class="artm-loaded-remove" data-role="loaded-product-remove" data-sku="' + escapeHtml(item.sku) + '" title="Remove">✕</button>'
			+ '<button type="button" class="artm-loaded-status-icon" data-role="loaded-status-icon" title="' + escapeHtml(statusLabel) + '">●</button>'
			+ '</div>'
			+ '</div>';

		if (isConfigurable && isExpanded && children.length) {
			for (i = 0; i < children.length; i++) {
				var childSku = String(children[i].sku || '');
				var childChecked = hasSelectedSku(childSku) ? ' checked="checked"' : '';
				var childData = getProductDataBySku(childSku) || {};
				var childTitle = String(childSku || '');
				var childStatus = getSkuSidebarStatus(childSku);
				var childState = String(childStatus.state || 'loaded');
				var childLabel = String(childStatus.label || 'Loaded');
				if (childData && childData.name) {
					childTitle += ' - ' + String(childData.name);
				}
				var childIsActive = normalizeSkuKey(childSku) === normalizeSkuKey(activeSku);
				html += '<div class="artm-loaded-item artm-is-child' + (childIsActive ? ' artm-is-active' : '') + '" data-role="loaded-product-item" data-sku="' + escapeHtml(children[i].sku || '') + '" data-parent-sku="' + escapeHtml(item.sku) + '" title="' + escapeHtml(childTitle) + '">' 
					+ '<div class="artm-loaded-mainline">'
					+ '<input type="checkbox" data-role="loaded-product-check" data-sku="' + escapeHtml(childSku) + '"' + childChecked + ' />'
					+ '<span class="artm-loaded-sku" title="' + escapeHtml(childTitle) + '">' + escapeHtml(children[i].sku || '') + '</span>'
					+ '<span class="artm-status-badge artm-status-' + escapeHtml(childState) + '">' + escapeHtml(childLabel) + '</span>'
					+ '</div>'
					+ '<div class="artm-loaded-actionsline">'
					+ '<button type="button" class="artm-loaded-save" data-role="loaded-product-save" data-sku="' + escapeHtml(childSku) + '" title="Save unsaved changes"' + (hasDraftForSku(childSku) ? '' : ' disabled="disabled"') + '>&#128190;</button>'
					+ '<button type="button" class="artm-loaded-reload" data-role="loaded-product-reload" data-sku="' + escapeHtml(childSku) + '" title="Reload fresh data">↻</button>'
					+ '<button type="button" class="artm-loaded-remove" data-role="loaded-product-remove" data-sku="' + escapeHtml(childSku) + '" title="Remove">✕</button>'
					+ '<button type="button" class="artm-loaded-status-icon" data-role="loaded-status-icon" title="' + escapeHtml(childLabel) + '">●</button>'
					+ '</div>'
					+ '</div>';
			}
		}

		return html;
	}

	function renderLoadedProductsList() {
		var filter = normalizeSkuKey($loadedProductsFilter.val());
		var html = '';
		var visibleCount = 0;
		var i;

		$loadedProductsList.find('[data-role="loaded-product-item"]').remove();

		for (i = 0; i < loadedProducts.length; i++) {
			if (filter && normalizeSkuKey(loadedProducts[i].sku).indexOf(filter) === -1) {
				continue;
			}
			html += buildSidebarItemHtml(loadedProducts[i]);
			visibleCount += 1;
		}

		if (html) {
			$loadedProductsList.append(html);
		}

		if (visibleCount) {
			$loadedProductsEmpty.hide();
			updateBulkButtonVisibility();
			updateSelectAllCheckboxState();
			return;
		}

		$loadedProductsEmpty.show();
		updateBulkButtonVisibility();
		updateSelectAllCheckboxState();
	}

	function addLoadedProduct(product) {
		var idx;
		var parentIndex;
		var productType;
		var productChildren;
		if (!product || !product.sku) {
			return;
		}

		productType = String(product.type || product.type_id || 'simple').toLowerCase();
		productChildren = Array.isArray(product.children) ? product.children : [];
		parentIndex = -1;

		if (productType !== 'configurable') {
			parentIndex = findLoadedConfigurableParentIndexForProduct(product);
			if (parentIndex !== -1 || isSkuChildOfLoadedConfigurable(product.sku)) {
				if (parentIndex === -1) {
					parentIndex = findLoadedConfigurableParentIndexForProduct({ sku: product.sku });
				}
				upsertChildIntoLoadedParent(parentIndex, product);
				idx = findLoadedProductIndex(product.sku);
				if (idx !== -1) {
					loadedProducts.splice(idx, 1);
				}
				renderLoadedProductsList();
				return;
			}
		}

		idx = findLoadedProductIndex(product.sku);
		if (idx !== -1) {
			loadedProducts[idx].id = product.id || loadedProducts[idx].id || null;
			loadedProducts[idx].parent_id = product.parent_id || loadedProducts[idx].parent_id || null;
			loadedProducts[idx].type = productType;
			loadedProducts[idx].status = product.status || loadedProducts[idx].status || 'Loaded';
			loadedProducts[idx].children = productChildren;
			if (productType === 'configurable') {
				expandedParents[normalizeSkuKey(product.sku)] = true;
				pruneTopLevelChildren(productChildren, product.sku);
			}
			renderLoadedProductsList();
			return;
		}

		loadedProducts.push({
			id: product.id || null,
			sku: product.sku,
			type: productType,
			status: product.status || 'Draft',
			parent_id: product.parent_id || null,
			children: productChildren
		});

		if (productType === 'configurable') {
			expandedParents[normalizeSkuKey(product.sku)] = true;
			pruneTopLevelChildren(productChildren, product.sku);
		}

		renderLoadedProductsList();
	}

	function removeLoadedProductBySku(sku) {
		var key = normalizeSkuKey(sku);
		var i;
		var p;
		var children;
		var c;
		var removed = false;

		if (!key) {
			return;
		}

		for (i = loadedProducts.length - 1; i >= 0; i--) {
			p = loadedProducts[i];
			if (normalizeSkuKey(p.sku) === key) {
				loadedProducts.splice(i, 1);
				removed = true;
				continue;
			}

			children = Array.isArray(p.children) ? p.children : [];
			for (c = children.length - 1; c >= 0; c--) {
				if (normalizeSkuKey(children[c].sku) === key) {
					children.splice(c, 1);
					removed = true;
				}
			}
		}

		if (!removed) {
			return;
		}

		setSkuSelectedState(sku, false);
		if (normalizeSkuKey(activeSku) === key) {
			activeSku = '';
		}

		$.each(Object.keys(loadedProductDataBySku), function (_, mapKey) {
			if (normalizeSkuKey(mapKey) === key) {
				delete loadedProductDataBySku[mapKey];
			}
		});
		delete skuDraftsBySku[key];
		delete skuSidebarStateBySku[key];
		clearSkuStateTimer(sku);
		updateSaveAllVisibility();

		renderLoadedProductsList();
	}

	function setFieldChangedState($field) {
		var original = String($field.attr('data-original') || '');
		var current = String($field.attr('data-current') || '');

		if (original !== current) {
			$field.addClass('artm-field-changed');
		} else {
			$field.removeClass('artm-field-changed');
		}

		updateSaveVisibility();
	}

	function commitFieldEdit($field, value, displayValue) {
		var nextVal = String(value == null ? '' : value);
		var displayVal = String(displayValue == null ? nextVal : displayValue);
		$field.attr('data-current', nextVal);
		$field.find('[data-role="attr-value"]').text(displayVal);
		setFieldChangedState($field);
	}

	function buildEditorControl(meta, currentValue, currentLabel) {
		var fieldMeta = meta || {};
		var safeValue = String(currentValue == null ? '' : currentValue);
		var safeLabel = String(currentLabel == null ? '' : currentLabel);
		var inputType = String(fieldMeta.inputType || 'text').toLowerCase();
		var options = Array.isArray(fieldMeta.options) ? fieldMeta.options : [];
		var opts;

		if ((inputType === 'select' || inputType === 'boolean') && options.length) {
			opts = ['<option value="">-- Select --</option>'];
			$.each(options, function (_, opt) {
				var ov = String(opt && opt.value != null ? opt.value : '');
				var ol = String(opt && opt.label != null ? opt.label : ov);
				var selected = (safeValue === ov || safeValue === ol || safeLabel === ol) ? ' selected="selected"' : '';
				opts.push('<option value="' + escapeHtml(ov) + '"' + selected + '>' + escapeHtml(ol) + '</option>');
			});
			return '<select class="admin__control-select artm-attr-editor" data-role="attr-editor">' + opts.join('') + '</select>';
		}

		if (inputType === 'price' || inputType === 'weight' || String(fieldMeta.code || '') === 'price' || String(fieldMeta.code || '') === 'qty') {
			return '<input type="number" step="0.0001" class="admin__control-text artm-attr-editor" data-role="attr-editor" value="' + escapeHtml(safeValue) + '" />';
		}

		if (inputType === 'textarea') {
			return '<textarea class="admin__control-textarea artm-attr-editor" data-role="attr-editor">' + escapeHtml(safeValue) + '</textarea>';
		}

		if (inputType === 'date') {
			return '<input type="date" class="admin__control-text artm-attr-editor" data-role="attr-editor" value="' + escapeHtml(safeValue) + '" />';
		}

		return '<input type="text" class="admin__control-text artm-attr-editor" data-role="attr-editor" value="' + escapeHtml(safeValue) + '" />';
	}

	function refreshSingleQtyAddOptions($group) {
		var optionsRaw = String($group.attr('data-source-options') || '[]');
		var options;
