		if (selectedSkus.length > 1) {
			$bulkWrap.show();
			return;
		}
		$bulkWrap.hide();
		$bulkStep1Wrap.hide();
		$bulkGridWrap.hide();
		$bulkGridContainer.empty();
		$bulkActions.hide();
		$bulkUpdateSummary.text('');
		$bulkModal.hide();
