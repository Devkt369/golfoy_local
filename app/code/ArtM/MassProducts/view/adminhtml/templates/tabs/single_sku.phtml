				var $row = $attrsContainer.find('[data-role="qty-source-row"][data-source-code="' + sourceCode.replace(/"/g, '\\"') + '"]');
				if ($row.length) {
					$row.attr('data-original', $row.attr('data-current') || '').removeClass('artm-is-changed');
				}
				return;
			}
			var $field = $attrsContainer.find('[data-role="attr-field"][data-key="' + attrCode.replace(/"/g, '\\"') + '"]');
			if ($field.length) {
				$field.attr('data-original', $field.attr('data-current') || '').removeClass('artm-field-changed');
			}
		});
		updateSaveVisibility();
	}

	function saveSkuDraft(sku, options) {
		var opts = options || {};
		var cleanSku = normalizeSku(sku);
		var key = getSkuKey(cleanSku);
		var deferred = $.Deferred();
		var changed;
		if (!cleanSku || !key) {
			deferred.reject({ responseJSON: { message: 'Invalid SKU' } });
			return deferred.promise();
		}
		if (normalizeSkuKey(activeSku) === key) {
			persistActiveDraftState();
		}
		changed = skuDraftsBySku[key] ? $.extend({}, skuDraftsBySku[key]) : {};
		if ($.isEmptyObject(changed)) {
			deferred.resolve({ skipped: true, message: 'No changes' });
			return deferred.promise();
		}

		setSkuSidebarState(cleanSku, 'processing', 'Processing');
		saveProductChanges(cleanSku, changed).done(function (response) {
			applyChangesToLocalCaches(cleanSku, changed);
			clearDraftForSku(cleanSku);
			setSkuSidebarState(cleanSku, 'saved', 'Saved', 5000);
			if (!opts.skipActiveRefresh && normalizeSkuKey(activeSku) === key) {
				markActiveFormAsSaved(changed);
			}
			deferred.resolve(response || {});
		}).fail(function (xhr) {
			setSkuSidebarState(cleanSku, 'error', 'Failed');
			deferred.reject(xhr);
		}).always(function () {
			renderLoadedProductsList();
		});

		return deferred.promise();
	}

	function runSaveAllDrafts() {
		var queue = [];
		var queuedMap = {};
		var deferred = $.Deferred();
		var doneCount = 0;
		var successCount = 0;
		var failedCount = 0;

		persistActiveDraftState();

		$.each(skuDraftsBySku, function (draftKey, attrs) {
			var normalizedKey = normalizeSkuKey(draftKey);
			var sku;
			if (!normalizedKey || !attrs || $.isEmptyObject(attrs) || queuedMap[normalizedKey]) {
				return;
			}
			sku = findSkuByKey(normalizedKey);
			if (!sku) {
				return;
			}
			queuedMap[normalizedKey] = true;
			queue.push(sku);
			setSkuSidebarState(sku, 'waiting', 'Waiting');
		});

		if (!queue.length) {
			showLoadMessage('No edited SKU to save.', 'error');
			deferred.resolve();
			return deferred.promise();
		}

		$saveAllBtn.prop('disabled', true);
		$sidebarSaveAllBtn.prop('disabled', true);
		$saveBtn.prop('disabled', true);

		function next(index) {
			var sku;
			if (index >= queue.length) {
				$saveAllBtn.prop('disabled', false);
				$sidebarSaveAllBtn.prop('disabled', false);
				$saveBtn.prop('disabled', false);
				if (failedCount) {
					showLoadMessage('Save All complete. Saved ' + successCount + ', failed ' + failedCount + '.', 'error');
				} else {
					showLoadMessage('Save All complete. Saved ' + successCount + ' SKU(s).', 'success');
				}
				deferred.resolve();
				return;
			}

			sku = queue[index];
			saveSkuDraft(sku, { skipActiveRefresh: false }).done(function () {
				successCount += 1;
			}).fail(function () {
				failedCount += 1;
			}).always(function () {
				doneCount += 1;
				showLoadMessage('Saving ' + doneCount + '/' + queue.length + '...', failedCount ? 'error' : 'success');
				next(index + 1);
			});
		}

		next(0);
		return deferred.promise();
	}

	function executeSearch(sku, options) {
		var cleanSku = normalizeSku(sku);
		var opts = options || {};
		var forceReload = !!opts.forceReload;
		var fromSidebar = !!opts.fromSidebar;
		var suppressErrorMessage = !!opts.suppressErrorMessage;
		var deferred = $.Deferred();
		var cached;

		if (!cleanSku) {
			setLoading(false);
			deferred.reject();
			return deferred.promise();
		}

		cached = getCachedProductResponse(cleanSku);
		if (cached && !forceReload) {
			handleLoadedProduct(cached, {
				fromSidebar: fromSidebar,
				keepInputValue: !!opts.keepInputValue
			});
			deferred.resolve(cached);
			return deferred.promise();
		}

		if (!forceReload && cleanSku.toLowerCase() === lastRequestedSku.toLowerCase()) {
			deferred.resolve(getCachedProductResponse(cleanSku) || null);
			return deferred.promise();
		}

		clearLoadMessage();
		setLoading(true);
		loadProductBySku(cleanSku, { forceReload: forceReload }).done(function (product) {
			handleLoadedProduct(product, {
				fromSidebar: fromSidebar,
				keepInputValue: !!opts.keepInputValue
			});
			deferred.resolve(product);
		}).fail(function (xhr) {
			var message = 'Product not found';
			if (xhr && xhr.responseJSON && xhr.responseJSON.message) {
				message = String(xhr.responseJSON.message);
			}
			// Detect form key expiration and suggest page refresh
			if (message.toLowerCase().indexOf('form key') !== -1 || message.toLowerCase().indexOf('csrf') !== -1) {
				message = message + ' Please refresh the page.';
			}
			if (!suppressErrorMessage) {
				showLoadMessage(message, 'error');
			}
			deferred.reject();
		}).always(function () {
			setLoading(false);
		});

		return deferred.promise();
	}

	function parseSkuBatch(rawText) {
		var source = String(rawText == null ? '' : rawText);
		var tokens = source.split(/[\s,;|]+/g);
		var out = [];
		var seen = {};
		var i;
		var val;
		var key;

		for (i = 0; i < tokens.length; i++) {
			val = normalizeSku(tokens[i]);
			if (!val) {
				continue;
			}
			key = normalizeSkuKey(val);
			if (seen[key]) {
				continue;
			}
			seen[key] = true;
			out.push(val);
		}

		return out;
	}

	function loadSkuBatch(skus) {
		var list = Array.isArray(skus) ? skus : [];
		var index = 0;
		var loadedCount = 0;
		var notFound = [];
		var currentSku = '';

		function next() {
			if (index >= list.length) {
				$input.val('');
				$input.trigger('focus');
				if (notFound.length) {
					showLoadMessage('Loaded ' + loadedCount + ' SKU(s). Not found: ' + notFound.join(', '), 'error');
				} else if (loadedCount > 0) {
					showLoadMessage('Loaded ' + loadedCount + ' SKU(s).', 'success');
				}
				return;
			}

			currentSku = String(list[index] || '');
			executeSearch(currentSku, {
				forceReload: false,
				fromSidebar: false,
				keepInputValue: true,
				suppressErrorMessage: true
			}).done(function () {
				loadedCount += 1;
			}).fail(function () {
				notFound.push(currentSku);
			}).always(function () {
				index += 1;
				next();
			});
		}

		if (!list.length) {
			return;
		}

		if (debounceTimer) {
			clearTimeout(debounceTimer);
			debounceTimer = null;
		}

		clearLoadMessage();

		next();
	}

	function scheduleSearch(sku) {
		if (debounceTimer) {
			clearTimeout(debounceTimer);
			debounceTimer = null;
		}

		debounceTimer = setTimeout(function () {
			executeSearch(sku);
		}, debounceMs);
	}

