    $order_id     = $templateData['order_id'];
    $starImgUrl   = $templateData['starImgUrl'];

    // 1. Unified structure tracking variables
    $isItemReviewed = false;
    $savedRatingScore = null; // Stays null for Scenario A, gets integer values for Scenario B

    if (method_exists($block, 'getAlreadyReviewedProductIds')) {
        // Safe check block check configuration wrapper context
        $alreadyReviewedIds = $block->getAlreadyReviewedProductIds($order_id);
    } else {
        $objectManager = \Magento\Framework\App\ObjectManager::getInstance();
        $reviewRow = $objectManager->create(\ArtM\Review\Model\Getreviewedorder::class)
            ->getCollection()
            ->addFieldToFilter('order_id', $order_id)
            ->getFirstItem();

        if ($reviewRow && $reviewRow->getId()) {
            $orderItemReviewField = $reviewRow->getOrderItemReview();

            // Check Scenario B first: Does it contain data with colon pairs?
            if (!empty($orderItemReviewField) && strpos($orderItemReviewField, ':') !== false) {
                foreach (explode(',', $orderItemReviewField) as $pair) {
                    if (strpos($pair, ':') !== false) {
                        list($reviewedProductId, $savedStarRating) = explode(':', $pair);

                        // Look for a match against the current product loop item
                        if (trim($reviewedProductId) == trim($prd_id_arr[0])) {
                            $isItemReviewed = true;
                            $savedRatingScore = (int)trim($savedStarRating);
                            break;
                        }
                    }
                }
            }

            // Check Scenario A fallback: Check legacy simple string table entries values
            if (!$isItemReviewed && $reviewRow->getReviewGiven() == "Yes") {
                $legacyProductIds = explode(',', $reviewRow->getProductIds());
                if (in_array((string)$prd_id_arr[0], $legacyProductIds)) {
                    $isItemReviewed = true;
                }
            }
        }
    }
