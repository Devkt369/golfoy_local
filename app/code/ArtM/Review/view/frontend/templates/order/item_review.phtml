<script type="text/javascript">
    require(['jquery'], function($) {

        // 1. Block default browser window behavior for dragging files onto the page
        $("html").on("dragover dragenter drop", function(e) {
            e.preventDefault();
            e.stopImmediatePropagation();
        });

        // 2. Drag Enter Visual indicator tracking
        $(".review_popup_form").on("dragenter", ".review-drag-area", function(e) {
            e.stopImmediatePropagation();
            e.preventDefault();
            $(this).css('border-color', '#ffbc0b');
        });

        // 3. Drag Over context verification
        $(".review_popup_form").on("dragover", ".review-drag-area", function(e) {
            e.stopImmediatePropagation();
            e.preventDefault();
        });

        // 4. Handle Drag Drop Action
        $(".review_popup_form").on("drop", ".review-drag-area", function(e) {
            e.stopImmediatePropagation();
            e.preventDefault();

            var currentForm = $(this).closest('.review_popup_form');
            var dragArea = $(this);
            dragArea.css('border-color', 'lightgray');

            var file = e.originalEvent.dataTransfer.files;
            var ins = file.length;
            var ln = currentForm.find(".review-resultimg").length;

            var tc = parseInt(ln) + parseInt(ins);

            if (tc > 10) {
                currentForm.find(".media_field-error").show();
            } else {
                currentForm.find(".media_field-error").hide();
                for (var x = 0; x < ins; x++) {
                    var fdata = new FormData();
                    fdata.append("files[]", file[x]);
                    uploadlogofunc(fdata, currentForm, dragArea);
                }
            }

            // CRITICAL FIX: Flush the drag data cache to reset the tracking engine state
            if (e.originalEvent.dataTransfer) {
                e.originalEvent.dataTransfer.clearData();
            }
        });

        // 5. Consolidated Upload core processing function
        function uploadlogofunc(fdata, currentForm, dragArea) {
            if (fdata != null && fdata != '') {
                $.ajax({
                    url: "/reviewpopup/index/ajaxupload",
                    type: "POST",
                    cache: false,
                    contentType: false,
                    processData: false,
                    data: fdata,
                    dataType: 'json',
                    showLoader: true,
                    success: function(res) {
                        if (res.path) {
                            var htmlstr = '<div class="review-resultimg" style="display:inline-block; margin-right:10px; position:relative;">';
                            htmlstr += '<img src="/media/review_images' + res.path + '" style="width:60px; height:60px; border:1px solid #ccc; border-radius:5px;">';
                            htmlstr += '<div class="review-img-cross" rel="' + res.path + '" style="position:absolute; top:-5px; right:-5px; background:red; color:white; border-radius:50%; width:16px; height:16px; text-align:center; font-size:11px; cursor:pointer; line-height:15px;">&#10006;</div>';
                            htmlstr += '<input type="hidden" name="review_media_files[]" value="' + res.path + '">';
                            htmlstr += '</div>';

                            $(htmlstr).insertBefore(dragArea);
                        }
                    }
                });
            }
        }

        // 6. Click action on the drag-drop container box triggers hidden file input
        $(".review_popup_form").on("click", ".review-drag-area", function(e) {
            e.stopImmediatePropagation();
            $(this).closest('.review-field-media').find('.review_media').trigger('click');
        });

        // 7. Click action to delete/remove an uploaded preview asset image item row
        $(".review_popup_form").on("click", ".review-img-cross", function(e) {
            e.stopPropagation();
            e.stopImmediatePropagation();

            var currentForm = $(this).closest('.review_popup_form');
            var el = $(this).parent(".review-resultimg");
            var rel = $(this).attr('rel');
            var path = 'review_images' + rel;

            $.ajax({
                url: "/reviewpopup/index/deleteajaxupload",
                type: "POST",
                data: {
                    path: path
                },
                dataType: 'json',
                showLoader: true,
                success: function(res) {
                    el.remove();
                    currentForm.find(".media_field-error").hide();
                }
            });
        });

        // 8. Handle Standard File Input Selection Changes
        $(document).on('change', '.review_media', function() {
            var fileInputInstance = $(this);
            var currentForm = fileInputInstance.closest('.review_popup_form');
            var dragArea = currentForm.find('.review-drag-area');
            var files = fileInputInstance[0].files;
            var ins = files.length;

            var ln = currentForm.find(".review-resultimg").length;
            var tc = parseInt(ln) + parseInt(ins);

            if (tc > 10) {
                fileInputInstance.val('');
                currentForm.find(".media_field-error").show();
            } else {
                currentForm.find(".media_field-error").hide();
                for (var x = 0; x < ins; x++) {
                    var fdata = new FormData();
                    fdata.append("files[]", files[x]);
                    uploadlogofunc(fdata, currentForm, dragArea);
                }

                // CRITICAL FIX: Reset the element value to empty string "" 
                // This forces the 'change' event to fire even if you select the exact same file 5 times in a row!
                fileInputInstance.val('');
            }
        });

    });
</script>