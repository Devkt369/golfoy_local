    <script type="text/javascript">
        require(['jquery'], function($) {
            var itemId = '<?= $orderItem->getId() ?>';
            var form = $('#review_popup_form_' + itemId);

            // 1. HOVER SELECTION TRAIL EFFECTS
            form.find('.rating_smiley_svg').on('mouseenter', function() {
                var currentRow = $(this).closest('.rating_image_block');
                var hoveredValue = parseInt($(this).attr('rating_value'));
                currentRow.find('.rating_smiley_svg').removeClass('is-hovered');
                currentRow.find('.rating_smiley_svg').each(function() {
                    if (parseInt($(this).attr('rating_value')) <= hoveredValue) {
                        $(this).addClass('is-hovered');
                    }
                });
            });

            form.find('.rating_image_block').on('mouseleave', function() {
                $(this).find('.rating_smiley_svg').removeClass('is-hovered');
            });

            // 2. CLICK SELECTION SYSTEM WITH DYNAMIC REVEAL
            form.find('.rating_smiley_svg').on('click', function() {
                var currentRow = $(this).closest('.rating_image_block');
                var clickedValue = parseInt($(this).attr('rating_value'));

                // Update your hidden input field for Magento payload mapping
                $('#stars_' + itemId).val(clickedValue);

                // Remove old active selections in this block row
                currentRow.find('.rating_smiley_svg').removeClass('active');

                // Permanently illuminate all stars up to the clicked value
                currentRow.find('.rating_smiley_svg').each(function() {
                    var starValue = parseInt($(this).attr('rating_value'));
                    if (starValue <= clickedValue) {
                        $(this).addClass('active');
                    }
                });

                // ── REVEAL TOGGLE LOGIC FOR CONTENT & SUBMIT FOOTER ──
                var productContainer = $(this).closest('.name_review_popup');
                var mediaField = productContainer.find('.review-field-media');
                var commentField = productContainer.find('.write_comment_block');

                // Find the submit button region relative to the current active form instance container
                var activeForm = $(this).closest('.review_popup_form');
                var submitButtonBlock = activeForm.find('.submit_review_popup_form_block');

                if (clickedValue > 0) {
                    // Smoothly display and slide down all review inputs
                    mediaField.slideDown(250).css('opacity', '1');
                    commentField
                        .css('display', 'flex')
                        .hide()
                        .slideDown(250)
                        .css('opacity', '1');

                    // Also reveal the submit review action row block container
                    submitButtonBlock.slideDown(250).css('opacity', '1');
                } else {
                    // Fallback hide rules if rating is broken or cleared
                    mediaField.slideUp(200).css('opacity', '0');
                    commentField
                        .slideUp(200, function () {
                            $(this).css('opacity', '0');
                        });
                    submitButtonBlock.slideUp(200).css('opacity', '0');
                }
            });

            // 3. COMMENT VALUE ASSIGNMENT
            form.find('.custom_comment').on('input', function() {
                $('#comment_input_' + itemId).val($(this).val());
            });

            // 4. AJAX SUBMIT TO ORDERITEMINDEX ENDPOINT
            // 4. AJAX SUBMIT TO ORDERITEMINDEX ENDPOINT
            form.find('.execute-review-submit').on('click', function(e) {
                e.preventDefault();
                e.stopImmediatePropagation();

                var statusBox = $('#status_' + itemId);
                var starVal = $('#stars_' + itemId).val();
                var prdId = form.find('.product_id_rating_input').val();
                var commentVal = $('#comment_input_' + itemId).val() || 'No feedback provided';
                if (starVal < 1) {
                    alert("Please rate the product.");
                    return;
                }
                // ── NEW LOGIC: Collect all uploaded image paths inside this specific form row ──
                var uploadedImagesArr = [];
                form.find('input[name="review_media_files[]"]').each(function() {
                    var pathValue = $(this).val();
                    if (pathValue) {
                        // Trim forward slashes if your controller expects pure filenames, 
                        // or leave it as is if it matches your legacy format behavior.
                        uploadedImagesArr.push(pathValue);
                    }
                });

                // If no images are uploaded, fall back to your controller's '|empty|' string flag
                var imageVal = (uploadedImagesArr.length > 0) ? uploadedImagesArr.join(',') : '|empty|';

                // Matches pattern expected by Controller explode sequences: star<><>prodId<><>comment<><>images
                var structuralPayload = starVal + '<><>' + prdId + '<><>' + commentVal + '<><>' + imageVal;

                statusBox.text('Submitting...').css('color', '#333');

                $.ajax({
                    url: '/reviewpopup/submit/orderitemindex/',
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        number_of_products: form.find('#number_of_products').val(),
                        customer_id: form.find('#customer_id').val(),
                        order_id: form.find('#order_id').val(),
                        submitted_data: structuralPayload,
                        single_item_id: prdId
                    },
                    success: function(response) {
                        if (response.html === 'review_submitted') {
                            statusBox.text('Review submitted successfully!').css('color', 'green');
                            form.find('input, textarea, button').attr('disabled', 'disabled');
                            setTimeout(function() {
                                location.reload();
                            }, 1000);
                        } else {
                            statusBox.text('Error submitting review.').css('color', 'red');
                        }
                    },
                    error: function() {
                        statusBox.text('Server Error. Please try again.').css('color', 'red');
                    }
                });
            });
        });
    </script>
<?php endif; ?>

