<script>
    require(['jquery'], function(jQuery) {
        jQuery(document).ready(function() {

            jQuery('div#popupreviewmodel button.close').on('click', function() {
                jQuery('div#popupreviewmodel').modal('hide');
            });

            //set cookie for closing sign up popup starts
            function setreviewpopupCookie(cname, cvalue, exdays) {
                //        alert('setting up cookie');
                var d = new Date();
                d.setTime(d.getTime() + (exdays * 24 * 60 * 60 * 1000));
                var expires = "expires=" + d.toGMTString();
                document.cookie = cname + "=" + cvalue + ";" + expires + ";path=/";
            }

            function getreviewpopupCookie(cname) {
                //        alert('getting cookie');
                var name = cname + "=";
                var decodedCookie = decodeURIComponent(document.cookie);
                var ca = decodedCookie.split(';');
                for (var i = 0; i < ca.length; i++) {
                    var c = ca[i];
                    while (c.charAt(0) == ' ') {
                        c = c.substring(1);
                    }
                    if (c.indexOf(name) == 0) {
                        return c.substring(name.length, c.length);
                    }
                }
                return "";
            }
            //alert('here');
            //if popup button exists, then click it
            setTimeout(function() {
                //            alert('settime');
                if (jQuery("#open_review_popup").length) {

                    if (jQuery("#customer_id").length) {
                        var customer_id = jQuery('#customer_id').val();
                    } else {
                        var customer_id = '';
                    }
                    var reviewpopupclose = getreviewpopupCookie("reviewpopupclose" + customer_id);
                    if (reviewpopupclose != "show_no") {
                        jQuery("#open_review_popup").click();
                        //setreviewpopupCookie("reviewpopupclose"+customer_id, 'show_no', 1);
                    } else {
                        //                    alert('do not click');
                    }

                }
            }, 1000);



            jQuery('.write_comment_text').click(function() {
                jQuery(this).parent('.write_comment_button').siblings('.write_comment_textarea').slideDown();
                jQuery(this).hide();
            });

            //change there
            jQuery('.rating_smiley').click(function() {
                var rating_value = jQuery(this).attr('rating_value');
                //            jQuery(this).parent('div').siblings('div').children('.rating_smiley').removeClass('selected');

                jQuery(this).parent('div').siblings('div').each(function() {
                    jQuery(this).children('.rating_smiley').removeClass('selected');
                    jQuery(this).children('.rating_smiley').removeClass('clicked');
                    if (parseInt(jQuery(this).children('.rating_smiley').attr('rating_value')) < parseInt(rating_value)) {
                        jQuery(this).children('.rating_smiley').addClass('selected clicked');
                    }
                });
                //change there
                jQuery(this).addClass('selected clicked');
                jQuery(this).parent('div').parent('div.rating_image_block').parent('div.rating_image_review_popup').parent('div.name_review_popup').parent('.product_name').siblings('.star_rating_input').val(rating_value);


                //jQuery(this).parents('div.name_review_popup').siblings('.star_rating_input').val(rating_value);

            });
            /******************************************* */



            jQuery('.rating_smiley').hover(function() {
                var rating_value = jQuery(this).attr('rating_value');
                jQuery(this).addClass('selected');
                jQuery(this).parent('div').siblings('div').each(function() {
                    // jQuery(this).children('.rating_smiley').removeClass('selected');
                    if (parseInt(jQuery(this).children('.rating_smiley').attr('rating_value')) < parseInt(rating_value)) {
                        jQuery(this).children('.rating_smiley').addClass('selected');
                    }
                })
            }, function() {
                //jQuery('.rating_smiley:not(.clicked)').removeClass('selected');
                var rating_value = jQuery(this).attr('rating_value');
                if (!jQuery(this).hasClass('clicked')) {
                    jQuery(this).removeClass('selected');
                }
                jQuery(this).parent('div').siblings('div').each(function() {
                    // jQuery(this).children('.rating_smiley').removeClass('selected');
                    if (parseInt(jQuery(this).children('.rating_smiley').attr('rating_value')) < parseInt(rating_value)) {
                        if (!jQuery(this).children('.rating_smiley').hasClass('clicked')) {
                            jQuery(this).children('.rating_smiley').removeClass('selected');
                        }
                    }
                })
            });

            /****************************************************** */

            function validate_and_fill_value_review_form() {

                var flag = 1;

                jQuery('.item_review_popup').each(function() {
                    if (jQuery(this).find('.custom_comment').val().trim() != '') {
                        jQuery(this).find('.comment_rating_input').val(jQuery(this).find('.custom_comment').val());
                    }
                });

                //check if required value is empty
                jQuery('.required_field_custom_form').each(function() {
                    if (jQuery(this).val().trim() == '') {
                        flag = 0;
                    }
                });


                if (flag == 1) {
                    return true;
                } else {
                    return false;
                }
            }



            jQuery("#review_images").submit(function() {
                if (jQuery('#review_images').valid()) {

                    var formData = new FormData(this);
                    var file_obj = document.getElementById("filepath");
                    formData.append('filepath', file_obj.files[0]);

                    var url = "<?php echo $block->getBaseUrl() . 'userform/index/ajaxsave/' ?>";
                    jQuery.ajax({
                        url: url,
                        type: "POST",
                        dataType: "JSON",
                        contentType: false,
                        enctype: 'multipart/form-data',
                        processData: false,
                        //data: {fname:event_fname,lname:event_lname,address:event_address,city:event_city,mobilenumber:event_mobilenumber,filename:event_filename},
                        data: formData,
                        showLoader: true,
                        cache: false,
                        success: function(response) {
                            //console.log(response.output);
                            //jQuery('.page.messages').html(response);
                            if (response == "1") {
                                //alert("Saved!");
                                jQuery(".page.messages").html('<div role="alert" class="messages"><div class="message-success success message" data-ui-id="message-success"><div >You saved the data.</div></div></div>');
                                jQuery('#fname').val('');
                                jQuery('#lname').val('');
                                jQuery('#address').val('');
                                jQuery('#city').val('');
                                jQuery('#mobilenumber').val('');
                            } else {
                                //alert("Not Saved!");
                                jQuery(".page.messages").html('<div role="alert" class="messages"><div class="alert danger alert-danger" data-ui-id="message-danger"><div >Data could not saved ! .</div></div></div>');
                            }
                            jQuery(".page.messages").delay(200).fadeIn().delay(4000).fadeOut();
                        }
                    });
                    return false;
                }

            });



            jQuery('#review_popup_form').submit(function(e) {
                //return;
                e.preventDefault();
                var validation_success = validate_and_fill_value_review_form();
                //            alert("validation_success" + validation_success);

                if (validation_success == true) {
                    jQuery('.submit_review_popup_form_button').html('Submitted');
                    var number_of_products = jQuery('#number_of_products').val();
                    var customer_id = jQuery('#customer_id').val();
                    var order_id = jQuery('#order_id').val();
                    var submitted_data = '';
                    var error_message = '';

                    jQuery('.item_review_popup').each(function() {
                        var star_rating_input = jQuery(this).children('.star_rating_input').val();
                        var product_id_rating_input = jQuery(this).children('.product_id_rating_input').val();
                        var comment_rating_input = jQuery(this).children('.comment_rating_input').val();
                        if (comment_rating_input == '') {
                            comment_rating_input = '|empty|';
                        }
                        var commaSeparatedValues = '|empty|';
                        if (jQuery(this).find('input[name="review_media_files[]"]').length) {
                            var mediaInputs = jQuery(this).find('input[name="review_media_files[]"]');
                            var mediaValues = [];
                            mediaInputs.each(function() {
                                mediaValues.push(jQuery(this).val());
                            });
                            commaSeparatedValues = mediaValues.join(',');
                        }

                        var single_prd_data = star_rating_input + "<><>" + product_id_rating_input + "<><>" + comment_rating_input + "<><>" + commaSeparatedValues;
                        if (submitted_data == '') {
                            submitted_data = single_prd_data;
                        } else {
                            submitted_data = submitted_data + "<><><>" + single_prd_data;
                        }
                    });



                    if (error_message == '') {
                        //no error, now send sms
                        var url = jQuery('#base_url').val() + "reviewpopup/submit/index";

                        jQuery.ajax({
                            url: url,
                            type: "POST",
                            data: {
                                number_of_products: number_of_products,
                                customer_id: customer_id,
                                submitted_data: submitted_data,
                                order_id: order_id
                            },
                            success: function(response) {
                                jQuery('.submit_review_popup_form_button').html('Submitted');
                                jQuery('.submit_review_popup_form_status_text').html('<div class="success">Thank you for submitting review</div>');
                                jQuery('#popupreviewmodel').hide();
                                var data = {
                                    reason: 'submitted',
                                    timestamp: new Date().getTime()
                                };
                                localStorage.setItem('artm_review_popup_closed', JSON.stringify(data));
                            },
                            error: function(jqXHR, textStatus, errorThrown) {
                                jQuery('.submit_review_popup_form_button').html('Error');
                                console.log(textStatus, errorThrown);
                            }
                        });
                    }
                } else {
                    alert('Please choose rating');
                }

            });
            //---------------------------------------
            jQuery("html").on("dragover", function(e) {
                e.preventDefault();
                e.stopPropagation();

            });

            jQuery("html").on("drop", function(e) {
                e.preventDefault();
                e.stopPropagation();
            });

            // Drag enter        
            jQuery("#popupreviewmodel").on("dragenter", ".review-drag-area", function(e) {
                e.stopPropagation();
                e.preventDefault();
            });

            // Drag over         
            jQuery("#popupreviewmodel").on("dragover", ".review-drag-area", function(e) {
                e.stopPropagation();
                e.preventDefault();
            });

            // Drop         
            jQuery("#popupreviewmodel").on("drop", ".review-drag-area", function(e) {
                e.stopPropagation();
                e.preventDefault();
                var parentdivid = jQuery(this).parents(".review-field-media").attr('id');
                var file = e.originalEvent.dataTransfer.files;
                var ins = file.length;
                var ln = jQuery("#" + parentdivid).find(".review-resultimg").length;
                var tc = 0;
                if (ln) {
                    tc = parseInt(ln) + parseInt(tc);
                }
                if (ins) {
                    tc = parseInt(ins) + parseInt(tc);
                }
                if (tc > 10) {
                    jQuery("#" + parentdivid).find(".media_field-error").show();
                } else {
                    jQuery("#" + parentdivid).find(".media_field-error").hide();
                    for (var x = 0; x < ins; x++) {
                        var fdata = new FormData();
                        fdata.append("files[]", file[x]);
                        uploadlogofunc(fdata, parentdivid);
                    }
                }
            });

            function uploadlogofunc(fdata, parentdivid) {
                if (fdata != null && fdata != '') {
                    jQuery.ajax({
                        url: "/reviewimages/index/ajaxupload",
                        type: "POST",
                        cache: false,
                        contentType: false,
                        processData: false,
                        data: fdata,
                        dataType: 'json',
                        showLoader: true,
                        success: function(res) {
                            if (res.path) {
                                $htmlstr = '<div class ="review-resultimg" ><img src = "/media/review_images' + res.path + '"><div class="review-img-cross" rel = "' + res.path + '">&#10006;</div>';
                                $htmlstr = $htmlstr + '<input type="hidden" name = "review_media_files[]" value ="' + res.path + '"></div>';
                                //jQuery($htmlstr).insertBefore(".review-drag-area"); 
                                var dragarea = jQuery("#" + parentdivid).find(".review-drag-area");
                                jQuery($htmlstr).insertAfter(dragarea);

                            }
                        }
                    });
                }
            }
            jQuery("#popupreviewmodel").on("click", ".review-dragdrop", function() {
                // jQuery("#review_media").trigger('click');
                var rel = jQuery(this).attr('rel');
                jQuery("#" + rel + "_review_media").trigger('click');
            });
            jQuery("#popupreviewmodel").on("click", ".review-img-cross", function() {
                var parentdivid = jQuery(this).parents(".review-field-media").attr('id');
                var el = jQuery(this).parent(".review-resultimg");
                var rel = jQuery(this).attr('rel');
                var path = 'review_images' + rel;
                jQuery.ajax({
                    url: "/reviewimages/index/deleteajaxupload",
                    type: "POST",
                    data: 'path=' + path,
                    dataType: 'json',
                    showLoader: true,
                    success: function(res) {
                        el.remove();
                        jQuery("#" + parentdivid).find(".media_field-error").hide();
                    }
                });
            })
            jQuery(document).on('change', '.review_media', function() {
                var currentid = jQuery(this).attr("id");
                var parentdivid = jQuery(this).parents(".review-field-media").attr('id');
                var files = jQuery(this)[0].files;
                var ins = files.length;
                var tc = 0;
                var ln = jQuery("#" + parentdivid).find(".review-resultimg").length;
                if (ln) {
                    tc = parseInt(ln) + parseInt(tc);
                }
                if (ins) {
                    tc = parseInt(ins) + parseInt(tc);
                }
                if (tc > 10) {
                    jQuery(this).val('');
                    jQuery("#" + parentdivid).find(".media_field-error").show();
                } else {
                    for (var x = 0; x < ins; x++) {
                        var fdata = new FormData();
                        fdata.append("files[]", document.getElementById(currentid).files[x]);
                        uploadlogofunc(fdata, parentdivid);
                    }
                    jQuery("#" + parentdivid).find(".media_field-error").hide();
                }
            });
            //------------------------------------
        });
    });
</script>
<script>
    require(['jquery'], function($) {
        function toggleBodyClass() {
            if ($('#popupreviewmodel').css('display') === 'block') {
                $('body').addClass('review-popup-open');
            } else {
                $('body').removeClass('review-popup-open');
            }
        }

        // Run on page load
        toggleBodyClass();

        // Watch for changes (important for modal open/close)
        const observer = new MutationObserver(toggleBodyClass);

        observer.observe(document.getElementById('popupreviewmodel'), {
            attributes: true,
            attributeFilter: ['style', 'class']
        });
    });
</script>