<script>
    document.addEventListener('DOMContentLoaded', function() {
        var ratingSmileys = document.querySelectorAll('#popupreviewmodel .rating_smiley');

        ratingSmileys.forEach(function(star) {
            star.addEventListener('click', function(e) {
                e.stopPropagation();
                var ratingId = this.getAttribute('data-rating-id');
                var clickedValue = parseInt(this.getAttribute('rating_value'));
                var allStars = document.querySelectorAll('#popupreviewmodel .rating_smiley[data-rating-id="' + ratingId + '"]');

                // Find current rating (highest active star)
                var currentRating = 0;
                allStars.forEach(function(s) {
                    if (s.classList.contains('active')) {
                        var val = parseInt(s.getAttribute('rating_value'));
                        if (val > currentRating) currentRating = val;
                    }
                });

                // Find the hidden input within the same product block
                var itemBlock = star.closest('.item_review_popup');
                var starInput = itemBlock ? itemBlock.querySelector('.star_rating_input') : null;

                if (clickedValue === currentRating) {
                    // Same star clicked again — reset all
                    allStars.forEach(function(s) {
                        s.classList.remove('active');
                    });
                    if (starInput) starInput.value = '';
                } else {
                    // Fill all stars up to and including the clicked star
                    allStars.forEach(function(s) {
                        var val = parseInt(s.getAttribute('rating_value'));
                        if (val <= clickedValue) {
                            s.classList.add('active');
                        } else {
                            s.classList.remove('active');
                        }
                    });
                    if (starInput) starInput.value = clickedValue;
                }
            });
        });
    });
</script>
