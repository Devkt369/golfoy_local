<?xml version="1.0" ?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">recommended_sort_manual_index.recommended_sort_manual_index_data_source</item>
            <item name="deps" xsi:type="string">recommended_sort_manual_index.recommended_sort_manual_index_data_source</item>
        </item>
        <item name="spinner" xsi:type="string">columns</item>
    </argument>
    <dataSource name="recommended_sort_manual_index_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider</argument>
            <argument name="name" xsi:type="string">recommended_sort_manual_index_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">id</argument>
            <argument name="requestFieldName" xsi:type="string">id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="component" xsi:type="string">Magento_Ui/js/grid/provider</item>
                    <item name="update_url" xsi:type="url" path="mui/index/render" />
                    <item name="storageConfig" xsi:type="array">
                        <item name="indexField" xsi:type="string">id</item>
                    </item>
                </item>
            </argument>
        </argument>
    </dataSource>
    <listing>
        <listingToolbar>
            <bookmark name="bookmarks" />
            <columnsControls name="columns_controls" />
            <massaction name="listing_massaction">
                <argument name="data" xsi:type="array">
                    <item name="data" xsi:type="array">
                        <item name="selectProvider" xsi:type="string">recommended_sort_manual_index.recommended_sort_manual_index.columns.ids</item>
                        <item name="displayArea" xsi:type="string">bottom</item>
                        <item name="component" xsi:type="string">Magento_Ui/js/grid/tree-massactions</item>
                        <item name="indexField" xsi:type="string">entity_id</item>
                    </item>
                </argument>
                <action name="DeleteOrder">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="type" xsi:type="string">DeleteOrder"</item>
                            <item name="label" xsi:type="string" translate="true">DeleteOrder</item>
                            <item name="url" xsi:type="url" path="artm_recommendedsort/manual/massdelete" />
                            <item name="confirm" xsi:type="array">
                                <item name="title" xsi:type="string" translate="true">Delete Order</item>
                                <item name="message" xsi:type="string" translate="true">Are you sure you want to delete selected order?</item>
                            </item>
                        </item>
                    </argument>
                </action>
            </massaction>
            <filters>
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="applied" xsi:type="array">
                            <item name="is_approved" xsi:type="string">1</item>
                        </item>
                    </item>
                </argument>
            </filters>
            <paging name="listing_paging" />
        </listingToolbar>
    </listing>

    <columns name="columns">
        <selectionsColumn name="ids">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="indexField" xsi:type="string">id</item>
                </item>
            </argument>
        </selectionsColumn>
        <column name="product_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Product Id</label>
            </settings>
        </column>
        <column name="category_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Category Id</label>
            </settings>
        </column>
        <column name="points">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Points</label>
            </settings>
        </column>
        <column name="type_of_update">
            <settings>
                <filter>text</filter>
                <label translate="true">Observer</label>
            </settings>
        </column>
        <column name="time">
            <settings>
                <filter>dateRange</filter>
                <label translate="true">Time</label>
            </settings>
        </column>
        
        <actionsColumn name="actions" class="ArtM\RecommendedSort\Ui\Component\Listing\Column\DeleteActions">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="indexField" xsi:type="string">id</item>
                </item>
            </argument>
        </actionsColumn>

    </columns>

</listing>
