            $(document).on('click', '.recalculate-product', function() {
                var $button = $(this); // The button that was clicked
                var productId = $button.data('id');
                var category_id = $button.attr('rel');
                $button.prop('disabled', true).text('Recalculating...');
                $.ajax({
                    url: '<?php echo $this->getUrl('artm_recommendedsort/index/recalculate', ['_secure' => true]); ?>',
                    type: 'POST',
                    data: {
                        product_id: productId,
                        category_id: category_id
                    },
                    showLoader: true,
                    success: function(response) {
                        console.log("response", response);
                        if (response.message === 'index_all') {
                            $button.prop('disabled', false).text('Recalculate');
                            return;
                        }
                        var htmlContent = '<div class="data-list">';
                        response.data.forEach(function(item, index) {
                            var radioId = 'data-item-' + item.id;
                            htmlContent += '<div class="data-item" style="margin-bottom:10px;">';
                            htmlContent += '<input type="radio" id="' + radioId + '" data-category-id="' + response.category_id + '" name="data_selection" value="' + JSON.parse(item.filters) + '" data-product-id="' + productId + '"';
                            htmlContent += '<label for="' + radioId + '">';
                            htmlContent += 'ID: ' + item.id + ' | Filters: ' + JSON.parse(item.filters);
                            htmlContent += '</label>';
                            htmlContent += '</div>';
                        });
                        htmlContent += '</div>';
                        popup.html(htmlContent);

                        popup.modal('openModal');
                        $button.prop('disabled', false).text('Recalculate');
                    },
                    error: function(xhr, status, error) {
                        console.error('An error occurred during recalculation:', error);
                        alert('An error occurred. Please try again.' + productId);
                    }
                });
            });

            $(document).on('change', "input#show_all", function() {
                if (!$(this).is(':checked')) {
                    $(".product-info-details").text("");
                }
            });

            $(document).on('click', 'table.product-data-table tr', function() {
                if (!$("#show_all").is(':checked')) {
                    return;
                }
                var productId = $(this).find('td:eq(1)').text();

                if (productId) {

                    $.ajax({
                        url: '<?php echo $this->getUrl('artm_recommendedsort/background/getproductdata', ['_secure' => true]); ?>',
                        type: 'POST',
                        data: {
                            product_id: productId
                        },
                        showLoader: true,
                        success: function(response) {
                            renderProductInfo(response.data);
                        },

                        error: function(xhr, status, error) {
                            console.error('An error occurred:', error);
                        }
                    });
                } else {
                    console.log("The second cell is empty or could not be found.");
                }
            });


            function renderProductInfo(productData) {
                if (!productData || typeof productData !== 'object') return;

                const parent = $(`
                    <div class="custom-product-block">
                        <h2>(${productData.product_id})</h2>
                        <h2>${productData.name}</h2>
                        <div class="main-product-info">
                            <img src="${productData.image}" alt="${productData.name}" class="main-product-img" />
                            <div class="main-product-meta">
                                <div class="rating">${productData.rating_html || 'No ratings yet'}</div>
                                <div class="price-html">
                                    <div class="regular_price">${productData.regular_price}</div>
                                    <div class="price">${productData.price_html}</div>
                                </div>
                                ${productData.percent_off > 0 ? `<div class="off">(${productData.percent_off}% OFF)</div>` : ''}
                                <div class="variant-sources">
                                    ${(productData.sources ?? []).map(source => `
                                        <span class="source-item ${source.qty > 0 ? 'in-stock' : 'out-of-stock'}">
                                            ${source.source_code}: ${source.qty}
                                        </span>
                                    `).join('')}
                                </div>
                                <div class="timestamps">
                                    <small><strong>Created:</strong> ${productData.created_at}</small><br/>
                                    <small><strong>Updated:</strong> ${productData.updated_at}</small>
                                    <small><strong>Is Featured:</strong> ${productData.isfeatured  > 0 ? 'Yes' : 'No'}</small>
                                </div>
                            </div>
                        </div>

                        ${Array.isArray(productData.children) && productData.children.length ? `
                            <h3>Variants</h3>
                            <div class="variant-wrapper">
                                ${productData.children.map(child => `
                                    <div class="variant-item">
                                        <div class="variant-name">${child.name}</div>
                                        <div class="price-html">
                                            <div class="variant-regular_price">${child.regular_price}</div>
                                            <div class="variant-price">${child.price_html}</div>
                                        </div>    
                                        ${child.percent_off > 0 ? `<div class="variant-off">(${child.percent_off}% OFF)</div>` : ''}
                                        <div class="variant-sources">
                                            ${child.sources.map(source => `
                                                <span class="source-item ${source.qty > 0 ? 'in-stock' : 'out-of-stock'}">
                                                    ${source.source_code}: ${source.qty}
                                                </span>
                                            `).join('')}
                                        </div>
                                    </div>
                                `).join('')}
                            </div>
                        ` : ''}
                    </div>
                `);

                // Append to .product-info-details
                $(".product-info-details").text("");
                $('.product-info-details').append(parent);
            }

            // Expand/Collapse Toggle
            $('.toggle-btn').on('click', function() {
                const $childUl = $(this).siblings('ul.children');

                // Clear existing content inside the toggle button
                $(this).empty();

                if ($childUl.is(':visible')) {
                    $childUl.slideUp();
                    $(this)
                        .removeClass('open')
                        .addClass('closed')
                        .append('<div class="close-arrow-icon"></div>'); // Insert close icon inside
                } else {
                    $childUl.slideDown();
                    $(this)
                        .removeClass('closed')
                        .addClass('open')
                        .append('<div class="open-arrow-icon"></div>'); // Insert open icon inside
                }
            });

            //here adding div
            $('li.category-item.singlecat-item').each(function() {
                // Check if it doesn't already exist to avoid duplication
                if ($(this).find('.icon-subMenu').length === 0) {
                    $(this).append('<div class="icon-subMenu"></div>');
                }
            });

            $('.category-item.active').each(function() {
                const $item = $(this);
                const $childrenUl = $item.children('ul.children');

                if ($childrenUl.length) {
                    $childrenUl.show(); // Or use .slideDown() if you want animation

                    // Replace the content of .toggle-btn with open-arrow-icon div
                    $item.children('.toggle-btn')
                        .empty() // Clear existing [+]/[−] or anything else
                        .removeClass('closed')
                        .addClass('open')
                        .append('<div class="open-arrow-icon"></div>');
                }
                jQuery('li.category-item.active.extra-level .open-arrow-icon').trigger('click');
            });

            $('#select_all').on('change', function() {
                var isChecked = $(this).is(':checked');

                $('.filter-group input[type="checkbox"]').each(function() {
                    if (!$(this).is(':disabled')) {
                        $(this).prop('checked', isChecked);
                    }
                });
            });

            // Category Search
            $('#categorySearch').on('keyup', function() {
                const searchTerm = $(this).val().toLowerCase();

                $('.left-column li.category-item').each(function() {
                    const text = $(this).text().toLowerCase();

                    if (text.indexOf(searchTerm) > -1) {
                        $(this).show();
                        $(this).parents('ul').show();
                        $(this).parents('li').find('> .toggle-btn').text('[−]');
                    } else {
                        $(this).hide();
                    }
                });
            });

        });
    });
</script>

