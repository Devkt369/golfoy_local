                var dataToSend = {
                    filters: selectedNames,
                    cat_ids: catIds,
                    // form_key: window.FORM_KEY 
                };

                // Perform the AJAX request
                $.ajax({
                    url: '<?php echo $this->getUrl('artm_recommendedsort/index/updatedata', ['_secure' => true]); ?>',
                    type: 'GET',
                    data: dataToSend,
                    showLoader: true,
                    success: function(response) {
                        // Handle the response (you can manipulate the DOM or show a message)
                        console.log('Set batch Response:', response);
                        // popup.modal('openModal');
                        alert('Sorting job has been created successfully.');
                    },
                    error: function(xhr, status, error) {
                        // Handle errors
                        console.error('Error:', error);
