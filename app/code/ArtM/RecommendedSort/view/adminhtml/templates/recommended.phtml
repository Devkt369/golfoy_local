<?php
$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$helper = $objectManager->get(\ArtM\RecommendedSort\Helper\Data::class);
$tree = $helper->getCategoryTree();

if ($tree !== null) {
    function printCategoryTree($node, $level = 0)
    {
        if (!$node || !is_array($node)) return;

        $hasChildren = !empty($node['children']);
        $liClass = $level <= 0 ? ' class="category-item active"' : ' class="category-item active extra-level"';

        echo '<li' . $liClass . ' data-id="' . $node['id'] . '">';

        if ($hasChildren) {
            echo '<span class="toggle-btn"><span class="tags"></span></span> ';
        } else {
            echo '<span class="no-toggle"></span>';
        }

        echo "<input type='checkbox' cat_id='" . $node['id'] . "' />";

        if (!empty($node['thumbnail'])) {
            echo '<img src="' . htmlspecialchars($node['thumbnail']) . '" alt="" style="width:24px; height:24px; margin-right:5px; vertical-align:middle;" />';
        }

        if (!empty($node['url'])) {
            echo '<a href="' . htmlspecialchars($node['url']) . '" target="_blank">' . htmlspecialchars($node['name']) . '</a>';
        } else {
            echo "<span class='category-name'>" . htmlspecialchars($node['name']) . "</span>";
        }

        if ($hasChildren) {
            echo '<ul class="children sub-children" >';
            foreach ($node['children'] as $childNode) {
                if ($childNode) {
                    printCategoryTree($childNode, $level + 1);
                }
            }
            echo '</ul>';
        }

        echo '</li>';
    }
}

