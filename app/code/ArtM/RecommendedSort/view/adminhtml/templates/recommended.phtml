                }
            }]
        }, popup);

        $(document).ready(function() {

            const productsPerPage = 10;

            function renderTable(products, page = 1, categoryId) {
                const startIndex = (page - 1) * productsPerPage;
                const endIndex = startIndex + productsPerPage;
                const paginated = products.slice(startIndex, endIndex);

                let html = '<table class="table table-bordered table-striped product-data-table sortingOrderTable">';
                html += '<thead class="table-dark">';
                html += '<tr>';
                html += '<th>Serial No</th>';
                html += '<th class="pid sortable">Product Id</th>';
                html += '<th>Image</th>';
                html += '<th class="pname sortable">Name</th>';
                html += '<th class="spoint sortable">Sorting Point</th>';
                html += '<th>Points</th>';
                html += '<th class="tpoints sortable">Total Points</th>';
                html += '<th>Availability</th>';
                html += '<th>Action</th>';
                html += '</tr></thead><tbody>';

                let serial = startIndex + 1;

                paginated.forEach(function(product) {
                    html += '<tr>';
                    html += '<td>' + serial++ + '</td>';
                    html += '<td>' + (product.id ?? '-') + '</td>';
                    html += '<td>' +
                        (product.image ?
                            '<img src="' + product.image + '" alt="' + product.name + '" class="img-thumbnail" style="width: 80px;">' :
                            '<span class="text-muted">No Image</span>') +
                        '</td>';
                    html += '<td class="productName">' + (product.name ?? '-') + '</td>';
                    html += '<td>' + (product.sorting_point ?? '-') + '</td>';
                    html += '<td class="valuesCol">' +
                        `
                            <div class="rating-points"><span class="title">Rating: </span><span class="priceValues">${product.rating ?? '-'}</span></div>
                            <div class="size-roll-per"><span class="title">(Per) Size Roll: </span><span class="priceValues">${product.size_roll_points_percentage ?? '-'}</span></div>
                            <div class="discount-poitns"><span class="title">Discount: </span><span class="priceValues">${product.high_discount_points ?? '-'}</span></div>
                            <div class="create-date-points"><span class="title">Created Date: </span><span class="priceValues">${product.created_date_points ?? '-'}</span></div>
                            <div class="latest-points"><span class="title">Latest Updated: </span><span class="priceValues">${product.latest_updated_points ?? '-'}</span></div>
                            <div class="size-role-value"><span class="title">Size Roll HTML: </span><span class="priceValues">${product.available_size_roll_value ?? '-'}</span></div>
                            <div class="is-feature"><span class="title">Is Feature: </span><span class="priceValues">${product.is_feature ?? '-'}</span></div>
                        `
                    '</td>';
                    html += '<td>' + (product.total_points ?? '-') + '</td>';
                    html += '<td class="availability-row">' +
                        '<div class="availRow">' +
                        '<span class="availLabel">CGC:</span> ' +
                        '<span class="availValue cgcValue">' + (product.availability_cgc ?? '-') + '</span>' +
                        '</div>' +
                        '<div class="availRow">' +
                        '<span class="availLabel">Golfoy:</span> ' +
                        '<span class="availValue golfoyValue">' + (product.availability_golfoy ?? '-') + '</span>' +
                        '</div>' +
                        '<div class="availRow">' +
                        '<span class="availLabel">Other:</span> ' +
                        '<span class="availValue otherValue">' + (product.availability_other ?? '-') + '</span>' +
                        '</div>';


                    '</td>';
                    html += '<td class="actionRow"><form class="update-points-form"><input type="number" class="product-checkbox" data-id="' + (product.id ?? '') + '" rel="' + categoryId + '"><button type="submit">Update</button></form><button class="recalculate-product" rel="' + categoryId + '" data-id="' + (product.id ?? '') + '">Recalculate</button></td>';
                    html += '</tr>';
                });

                html += '</tbody></table>';
                return html;
            }


            function renderPagination(products, currentPage) {
                const totalPages = Math.ceil(products.length / productsPerPage);
                if (totalPages <= 1) return '';

                let paginationHtml = '<nav><ul class="pagination">';

                for (let i = 1; i <= totalPages; i++) {
                    paginationHtml += '<li class="page-item ' + (i === currentPage ? 'active' : '') + '">';
                    paginationHtml += '<button class="page-link page-btn" data-page="' + i + '">' + i + '</button>';
                    paginationHtml += '</li>';
                }

                paginationHtml += '</ul></nav>';
                return paginationHtml;
            }

            $('li.category-item span.category-name').on('click', function(e) {
                e.preventDefault();
                $('li.category-item span.category-name').removeClass('active');
                $(this).addClass('active');
                const categoryText = $(this).text();
                const categoryId = $(this).parents('li.category-item').data('id');
                const $container = $('.right-column');
                const currentCategoryId = jQuery('form.update-points-form input.product-checkbox').attr('rel');

                if (currentCategoryId == categoryId) {
                    return;
                }

                if (!categoryId) {
                    alert('Category ID not found.');
                    return;
                }

                $.ajax({
                    url: '<?php echo $this->getUrl('artm_recommendedsort/index/getproducts', ['_secure' => true]); ?>',
                    type: 'GET',
                    data: {
                        category_id: categoryId,
                        form_key: window.FORM_KEY
                    },
                    showLoader: true,
                    success: function(response) {
                        if (response.error) {
                            alert(response.message || 'An error occurred.');
                            return;
                        }
                        const productData = response.products || [];
                        if (productData.length === 0) {
                            $container.html('<div class="alert alert-warning">No products found.</div>');
                            return;
                        }

                        productData.sort((a, b) => b.sorting_point - a.sorting_point);
                        let currentPage = 1;

                        let filteredProducts = productData;

                        function renderAll(inputValue = '') {
                            const totalRecords = filteredProducts.length;
                            const start = (currentPage - 1) * productsPerPage + 1;
                            const end = Math.min(start + productsPerPage - 1, totalRecords);

                            const summary = `
                                <div class="mb-2">
                                    <div class="section-title">${categoryText}</div>
                                    <div class="showingNo">Showing ${start}–${end} of ${totalRecords} records</div>
                                </div>
                            `;

                            const searchForm = `
                                    <div class="mb-3 d-flex gap-2 productsSearch">
                                        <input type="text" id="productSearchInput" class="form-control" value="${inputValue}" placeholder="Search by Product ID or Name">
                                        <button id="searchButton" class="btn btn-primary">Search</button>
                                        <button id="resetButton" class="btn btn-primary">Reset</button>
                                    </div>
                                `;

                            const tableHtml = renderTable(filteredProducts, currentPage, categoryId);
                            const paginationHtml = renderPagination(filteredProducts, currentPage);

                            $container.html(summary + searchForm + tableHtml + paginationHtml);
                        }
                        renderAll();
                        filteredProducts = [...productData];


                        let sortField = 'sorting_point'; // default sort
                        let sortDirection = 'desc';

                        function sortProducts(field, direction) {
                            filteredProducts.sort((a, b) => {
                                let valA = a[field] ?? 0;
                                let valB = b[field] ?? 0;

                                // Try to parse numeric if possible
                                if (!isNaN(valA)) valA = parseFloat(valA);
                                if (!isNaN(valB)) valB = parseFloat(valB);

                                // For string comparison, fallback to lowercase
                                if (typeof valA === 'string') valA = valA.toLowerCase();
                                if (typeof valB === 'string') valB = valB.toLowerCase();

                                if (valA < valB) return direction === 'asc' ? -1 : 1;
                                if (valA > valB) return direction === 'asc' ? 1 : -1;
                                return 0;
                            });
                        }

                        $container.off('click', '#searchButton').on('click', '#searchButton', function() {
                            const query = $('#productSearchInput').val().toLowerCase().trim();

                            filteredProducts = productData.filter(product => {
                                const name = (product.name || '').toLowerCase();
                                const id = String(product.id || '');
                                return name.includes(query) || id.includes(query);
                            });

                            currentPage = 1;
                            renderAll(query);
                        });

                        $container.off('click', '#resetButton').on('click', '#resetButton', function() {
                            const query = '';

                            filteredProducts = productData.filter(product => {
                                const name = (product.name || '').toLowerCase();
                                const id = String(product.id || '');
                                return name.includes(query) || id.includes(query);
                            });

                            currentPage = 1;
                            renderAll();
                        });

                        $container.off('click', 'th.sortable').on('click', 'th.sortable', function() {
                            const classList = $(this).attr('class').split(/\s+/);
                            let clickedField = null;

                            if (classList.includes('pid')) clickedField = 'id';
                            else if (classList.includes('pname')) clickedField = 'name';
                            else if (classList.includes('spoint')) clickedField = 'sorting_point';
                            else if (classList.includes('tpoints')) clickedField = 'total_points';
                            else if (classList.includes('sno')) clickedField = 'serial';

                            if (!clickedField) return;

                            // toggle sort direction if same field clicked again
                            if (sortField === clickedField) {
                                sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
                            } else {
                                sortField = clickedField;
                                sortDirection = 'asc';
                            }

                            if (clickedField === 'serial') {
                                // no sorting needed for serial, just reset to original order
                                filteredProducts = [...productData];
                            } else {
                                sortProducts(sortField, sortDirection);
                            }

                            currentPage = 1;
                            renderAll();
                        });

                        $container.off('keypress', '#productSearchInput').on('keypress', '#productSearchInput', function(e) {
                            if (e.which === 13) {
                                $('#searchButton').click();
                                $('#productSearchInput').focus();

                                const input = $('#productSearchInput')[0];
                                input.setSelectionRange(input.value.length, input.value.length);

                            }
                        });

                        $container.off('click', '.page-btn').on('click', '.page-btn', function() {
                            const newPage = parseInt($(this).data('page'));
                            if (!isNaN(newPage)) {
                                currentPage = newPage;
                                renderAll();
                            }
                        });

                    },
                    error: function() {
                        alert('AJAX error. Please try again.');
                    }
                });
            });

            $('input[type="checkbox"][cat_id]').on('change', function() {
                var parentCatId = $(this).attr('cat_id');
                var textInput = $('form#configuration_sorting input[type="text"]');
                var isChecked = $(this).prop('checked');
                var children = $(this).closest('li.category-item').find('.children input[type="checkbox"]');
                children.prop('checked', isChecked);
                updateCheckedCatIds(textInput);
            });

            function updateCheckedCatIds(textInput) {
                var selectedCategories = [];
                $('li.category-item input[type="checkbox"]:checked').each(function() {
                    selectedCategories.push($(this).attr("cat_id"));
                });
                textInput.val(selectedCategories.join(","));
            }




            $('#configuration_sorting').on('submit', function(event) {
