                          title="Recommended Sort" 
                          translate="title" 
                          sortOrder="60">
                    <resource id="ArtM_RecommendedSort::index" title="Index"/>
                    <resource id="ArtM_RecommendedSort::processlisting" title="Batch"/>
                    <resource id="ArtM_RecommendedSort::queuelisting" title="Queue"/>
