$product = $block->getProduct();
$productId = $product->getId();
$sku = $product->getSku();
$formKey = $block->getLayout()
    ->createBlock(\Magento\Framework\View\Element\FormKey::class)
    ->getFormKey();

// Try to get cached data first (server-side)
$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$helper = $objectManager->get('ArtM\EstimateDelivery\Helper\Data');
$cachedData = $helper->getCachedDeliveryData($productId);
$moduleEnabled = $helper->IsEnabled();
if (!$moduleEnabled) {
    // Get attribute text for select type attributes
    $dispatchText = $product->getAttributeText('dispatch');
    $shippingText = $product->getAttributeText('shippingdays');
    // Parse days from text (e.g., "2 days" → 2)
    $dispatchDays = is_string($dispatchText) ? (int)preg_replace('/[^0-9]/', '', $dispatchText) : (int)$dispatchText;
    $shippingDays = is_string($shippingText) ? (int)preg_replace('/[^0-9]/', '', $shippingText) : (int)$shippingText;
    $totalDays = $dispatchDays + $shippingDays;
    $date = new DateTime();
    $date->modify("+{$totalDays} days");
    $formattedDate = $date->format('F d, Y');
?>
    <div id="estimate-delivery-box">
        <div class="estimation_time">
            <span class="estimation_time_text">
                <span>Estimated delivery by </span>
                <span class="date"><?= $formattedDate ?></span>
            </span>
        </div>
    </div>
<?php
    return;
}

?>

<div id="estimate-delivery-box">
    <?php if ($cachedData): ?>
        <?php
        // Calculate delivery date from cached total_days
        $deliveryDate = new DateTime();
        $deliveryDate->modify("+{$cachedData['total_days']} days");
        $formattedDate = $deliveryDate->format('F d, Y');
        ?>
        <div class="estimation_time">
            <span class="estimation_time_text">
                <?php if ($cachedData['express_shipping']): ?>
                    <span class="express_icon">
                        <?= $expressDelivery ?>
                    </span>
                    <span class="deliver-title">
                        <span class="express-title">Express delivery </span>
                        <span>by </span>
                    </span>
                <?php else: ?>
                    <span class="express_icon">
                        <?= $standardDelivery ?>
                    </span>
                    <span class="deliver-title">
                        <span class="standard-title">Estimated delivery </span>
                        <span>by </span>
                    </span>
                <?php endif; ?>
                <span class="date"><?= $formattedDate ?></span>
            </span>
        </div>
    <?php else: ?>
        <div class="estimation_time">
            <span class="estimation_time_text">
                <span>Calculating delivery...</span>
            </span>
        </div>
    <?php endif; ?>
</div>

<script type="text/javascript">
    require(['jquery'], function($) {
        jQuery(document).ready(function($) {

            setTimeout(function() {
                <?php if (!$cachedData): ?>
                    // No cached data - populate cache in background
                    populateCache();
                <?php endif; ?>
            }, 100);

            function formatDate(dateStr) {
                const date = new Date(dateStr);
                return date.toLocaleDateString("en-US", {
                    month: "long",
                    day: "numeric",
                    year: "numeric"
                });
            }

            function populateCache() {
                $.ajax({
                    url: "/estimatedelivery/estimateDelivery/populateCache",
                    type: "POST",
                    dataType: "json",
                    data: {
                        product_id: <?= $productId ?>,
                        form_key: "<?= $formKey ?>"
                    },
                    success: function(response) {
                        if (response.success && response.data) {
                            updateDeliveryDisplay(response.data);
                        }
                    },
                    error: function() {
                        console.log('Failed to load delivery estimation');
                    }
                });
            }

            function updateDeliveryDisplay(data) {
                var standardIcon = <?php echo json_encode($standardDelivery); ?>;
                var expressIcon = <?php echo json_encode($expressDelivery); ?>;
                var container = $("#estimate-delivery-box");
                if (!container.length) return;

                // Calculate delivery date
                var deliveryDate = new Date();
                deliveryDate.setDate(deliveryDate.getDate() + data.total_days);
                var formattedDate = formatDate(deliveryDate);

                var html = '<div class="estimation_time"><span class="estimation_time_text">';

                if (data.express_shipping) {
                    html += '<span class="express_icon">';
                    html += expressIcon;
                    html += '</span>';
                    html += '<span><span class="express-title">Express delivery </span><span>by </span></span>';
                } else {
                    html += '<span class="express_icon">' + standardIcon + '</span>';
                    html += '<span><span class="standard-title">Estimated delivery </span><span>by </span></span>';
                }

                html += '<span class="date">' + formattedDate + '</span>';
                html += '</span></div>';

                container.html(html);
            }
        });
    });
</script>