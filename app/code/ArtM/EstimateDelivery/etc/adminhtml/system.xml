<?xml version="1.0"?>
<!--
/**
 * ArtM_EstimateDelivery module - system.xml
 * Magento 2 Admin Configuration
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="artm" translate="label" sortOrder="200">
            <label>Estimate Delivery</label>
        </tab>

        <section id="artm_estimatedelivery" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Estimate Delivery Configuration</label>
            <tab>artm</tab>
            <resource>ArtM_EstimateDelivery::config_artm_estimatedelivery</resource>

            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General Settings</label>
                
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Module Status</label>
                    <source_model>Magento\Config\Model\Config\Source\Enabledisable</source_model>
                    <comment>Enable or disable the Estimate Delivery module</comment>
                </field>
            </group>

            <group id="own_source" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Own Source</label>

                <field id="all_source" translate="label" type="multiselect" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Select Own Source</label>
                    <source_model>ArtM\EstimateDelivery\Model\Config\Source\AllSource</source_model>
                </field>

                <field id="delivery_time" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Delivery in days</label>
                </field>

                <field id="dispatch_time" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Dispatch in days</label>
                </field>
            </group>

            <group id="other_source" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Other Source</label>

                <field id="all_source" translate="label" type="multiselect" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Select Other Source</label>
                    <source_model>ArtM\EstimateDelivery\Model\Config\Source\AllSource</source_model>
                </field>

                <field id="delivery_time" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Delivery in days</label>
                </field>

                <field id="dispatch_time" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Dispatch in days</label>
                </field>
            </group>

            <group id="custom_source" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Custom Source</label>

                <field id="all_source" translate="label" type="multiselect" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Select Custom Source</label>
                    <source_model>ArtM\EstimateDelivery\Model\Config\Source\AllSource</source_model>
                </field>

                <field id="delivery_time" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Delivery in days</label>
                </field>

                <field id="dispatch_time" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Dispatch in days</label>
                </field>
            </group>

        </section>
    </system>
</config>