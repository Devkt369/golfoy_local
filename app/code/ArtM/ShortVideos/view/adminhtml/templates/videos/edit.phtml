<script>
    function handleVideoTypeChange(type) {
        const urlField = document.getElementById('url_field');
        const uploadField = document.getElementById('upload_field');
        const videoUrlInput = document.getElementById('video_url');
        const urlNote = document.getElementById('url_note');
        
        if (type === 'upload') {
            urlField.style.display = 'none';
            uploadField.style.display = 'block';
            videoUrlInput.removeAttribute('required');
        } else if (type === 'instagram' || type === 'youtube') {
            urlField.style.display = 'block';
            uploadField.style.display = 'none';
            videoUrlInput.setAttribute('required', 'required');
            
            if (type === 'instagram') {
                urlNote.textContent = '<?= __('Enter Instagram Reel URL (e.g., https://www.instagram.com/reel/...)') ?>';
            } else if (type === 'youtube') {
                urlNote.textContent = '<?= __('Enter YouTube Short URL (e.g., https://youtube.com/shorts/...)') ?>';
            }
        } else {
            urlField.style.display = 'none';
            uploadField.style.display = 'none';
            videoUrlInput.removeAttribute('required');
        }
    }

    function selectLinkType(type) {
        const urlSection = document.getElementById('url_field_section');
        const productSection = document.getElementById('product_field_section');
        const isProductLinkInput = document.getElementById('is_product_link');
        const productIdInput = document.getElementById('product_id');
        const swatches = document.querySelectorAll('.link-type-swatch');
        
        // Update swatch active states
        swatches.forEach(swatch => swatch.classList.remove('active'));
        
        if (type === 'url') {
            document.getElementById('link_type_url').checked = true;
            document.querySelector('.link-type-swatch:has(#link_type_url)').classList.add('active');
            urlSection.style.display = 'block';
            productSection.style.display = 'none';
            isProductLinkInput.value = '0';
            // Disable product_id to prevent validation error
            productIdInput.disabled = true;
            productIdInput.value = '';
        } else if (type === 'product') {
            document.getElementById('link_type_product').checked = true;
            document.querySelector('.link-type-swatch:has(#link_type_product)').classList.add('active');
            urlSection.style.display = 'none';
            productSection.style.display = 'block';
            isProductLinkInput.value = '1';
            // Enable product_id for input
            productIdInput.disabled = false;
        }
    }

    function toggleThumbnailType(type) {
        const urlField = document.getElementById('thumbnail_url_field');
        const uploadField = document.getElementById('thumbnail_upload_field');
        
        if (type === 'url') {
            urlField.style.display = 'block';
            uploadField.style.display = 'none';
        } else {
            urlField.style.display = 'none';
            uploadField.style.display = 'block';
        }
    }

    function previewThumbnail(input) {
        const preview = document.getElementById('thumbnail_preview');
        const img = preview.querySelector('img');
        
        if (input.files && input.files[0]) {
            const file = input.files[0];
            
            // Validate file size (2MB)
            if (file.size > 2 * 1024 * 1024) {
                alert('<?= __('File size must be less than 2MB') ?>');
                input.value = '';
                return;
            }
            
            // Validate file type
            if (!file.type.match('image.*')) {
                alert('<?= __('Please select an image file') ?>');
                input.value = '';
                return;
            }
            
            const reader = new FileReader();
            reader.onload = function(e) {
                img.src = e.target.result;
                preview.style.display = 'block';
            };
            reader.readAsDataURL(file);
        }
    }

    function removeThumbnail() {
        const preview = document.getElementById('thumbnail_preview');
        const uploadInput = document.getElementById('thumbnail_upload');
        const img = preview.querySelector('img');
        
        img.src = '';
        preview.style.display = 'none';
        uploadInput.value = '';
    }

    document.addEventListener('DOMContentLoaded', function() {
        const categories = <?= $categoriesJson ?>;
        const categoryInput = document.getElementById('category');
        
        if (categoryInput && categories.length > 0) {
            console.log('Available categories:', categories);
        }
    });
</script>
