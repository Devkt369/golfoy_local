<script>
    function deleteVideo(videoId) {
        if (confirm('<?= __('Are you sure you want to delete this video?') ?>')) {
            window.location.href = '<?= $block->getUrl('shortvideos/video/delete') ?>?id=' + videoId;
        }
    }

    function toggleAllCheckboxes(source) {
        const isChecked = source.checked;
        const checkboxes = document.querySelectorAll('.video-checkbox');
        
        checkboxes.forEach(checkbox => {
            checkbox.checked = isChecked;
        });
        
        // Sync both "select all" checkboxes
        const selectAll = document.getElementById('selectAll');
        const selectAllHeader = document.getElementById('selectAllHeader');
        
        if (selectAll) {
            selectAll.checked = isChecked;
        }
        if (selectAllHeader) {
            selectAllHeader.checked = isChecked;
        }
    }

    function getSelectedVideoIds() {
        const checkboxes = document.querySelectorAll('.video-checkbox:checked');
        return Array.from(checkboxes).map(cb => cb.value);
    }

    function handleBulkAction() {
        const action = document.getElementById('bulkAction').value;
        const selectedIds = getSelectedVideoIds();

        if (!action) {
            return;
        }

        if (selectedIds.length === 0) {
            alert('<?= __('Please select at least one video.') ?>');
            document.getElementById('bulkAction').value = '';
            return;
        }

        let confirmMessage = '';
        let url = '';

        switch(action) {
            case 'delete':
                confirmMessage = '<?= __('Are you sure you want to delete %1 selected video(s)?') ?>'.replace('%1', selectedIds.length);
                url = '<?= $block->getUrl('shortvideos/video/bulkdelete') ?>';
                break;
            case 'enable':
                confirmMessage = '<?= __('Are you sure you want to enable %1 selected video(s)?') ?>'.replace('%1', selectedIds.length);
                url = '<?= $block->getUrl('shortvideos/video/bulkstatus') ?>';
                break;
            case 'disable':
                confirmMessage = '<?= __('Are you sure you want to disable %1 selected video(s)?') ?>'.replace('%1', selectedIds.length);
                url = '<?= $block->getUrl('shortvideos/video/bulkstatus') ?>';
                break;
        }

        if (confirm(confirmMessage)) {
            // Get form key from existing page
            let formKeyValue = '';
            const formKeyInput = document.querySelector('input[name="form_key"]');
            if (formKeyInput) {
                formKeyValue = formKeyInput.value;
            } else {
                // Try to get from cookie
                const match = document.cookie.match(/form_key=([^;]+)/);
                if (match) {
                    formKeyValue = match[1];
                }
            }

            // Create form and submit
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = url;

            // Add form key
            if (formKeyValue) {
                const formKey = document.createElement('input');
                formKey.type = 'hidden';
                formKey.name = 'form_key';
                formKey.value = formKeyValue;
                form.appendChild(formKey);
            }

            // Add video IDs
            selectedIds.forEach(id => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'video_ids[]';
                input.value = id;
                form.appendChild(input);
            });

            // Add status for enable/disable
            if (action === 'enable' || action === 'disable') {
                const statusInput = document.createElement('input');
                statusInput.type = 'hidden';
                statusInput.name = 'status';
                statusInput.value = action === 'enable' ? '1' : '0';
                form.appendChild(statusInput);
            }

            document.body.appendChild(form);
            form.submit();
        } else {
            document.getElementById('bulkAction').value = '';
        }
    }

    function changePerPage(perPage) {
        const url = new URL(window.location.href);
        url.searchParams.set('per_page', perPage);
        url.searchParams.set('page', '1');
        window.location.href = url.toString();
    }

    function resetFilters() {
        const url = new URL(window.location.href);
        const perPage = url.searchParams.get('per_page') || '10';
        window.location.href = '<?= $block->getUrl('shortvideos/index/index') ?>?per_page=' + perPage;
    }

    // Auto-update "select all" when individual checkboxes change
    document.addEventListener('DOMContentLoaded', function() {
        const videoCheckboxes = document.querySelectorAll('.video-checkbox');
        const selectAll = document.getElementById('selectAll');
        const selectAllHeader = document.getElementById('selectAllHeader');
        
        videoCheckboxes.forEach(checkbox => {
            checkbox.addEventListener('change', function() {
                // Check if all checkboxes are checked
                const allChecked = Array.from(videoCheckboxes).every(cb => cb.checked);
                const noneChecked = Array.from(videoCheckboxes).every(cb => !cb.checked);
                
                // Update both select all checkboxes
                if (selectAll) {
                    selectAll.checked = allChecked;
                    selectAll.indeterminate = !allChecked && !noneChecked;
                }
                if (selectAllHeader) {
                    selectAllHeader.checked = allChecked;
                    selectAllHeader.indeterminate = !allChecked && !noneChecked;
                }
            });
        });
        
        // Initialize PHP code display with proper escaping
        const phpCodeElement = document.getElementById('generatedPhpCode');
        if (phpCodeElement) {
            const defaultCode = phpCodeElement.getAttribute('data-code');
            if (defaultCode) {
                phpCodeElement.innerHTML = defaultCode.replace(/</g, '&lt;').replace(/>/g, '&gt;');
            }
        }
    });

    // Shortcode Generator Functions
    let selectedCategories = [];
    let selectedVideos = [];

    function openShortcodePopup() {
        document.getElementById('shortcodePopup').style.display = 'flex';
        selectedCategories = [];
        selectedVideos = [];
        
        // Reset all swatches first
        document.querySelectorAll('.swatch-item').forEach(item => item.classList.remove('selected'));
        
        // Check if any videos are checked in the main grid
        const checkedVideos = document.querySelectorAll('.video-checkbox:checked');
        
        if (checkedVideos.length > 0) {
            // Get the video IDs from checked rows
            const preselectedVideoIds = [];
            checkedVideos.forEach(checkbox => {
                const videoId = checkbox.value;
                if (videoId) {
                    preselectedVideoIds.push(videoId);
                }
            });
            
            if (preselectedVideoIds.length > 0) {
                // Switch to "Specific Videos" radio option
                document.querySelector('input[name="display_type"][value="videos"]').checked = true;
                toggleDisplayType();
                
                // Select the corresponding video swatches
                preselectedVideoIds.forEach(videoId => {
                    const swatch = document.querySelector(`.video-swatch[data-value="${videoId}"]`);
                    if (swatch) {
                        swatch.classList.add('selected');
                        selectedVideos.push(videoId);
                    }
                });
            }
        } else {
            // Default to categories view if no videos selected
            document.querySelector('input[name="display_type"][value="categories"]').checked = true;
            toggleDisplayType();
        }
        
        updateShortcode();
    }

    function closeShortcodePopup() {
        document.getElementById('shortcodePopup').style.display = 'none';
    }

    function toggleDisplayType() {
        const displayType = document.querySelector('input[name="display_type"]:checked').value;
        const categoryPanel = document.getElementById('categorySelection');
        const videoPanel = document.getElementById('videoSelection');

        if (displayType === 'categories') {
            categoryPanel.style.display = 'block';
            videoPanel.style.display = 'none';
            selectedVideos = [];
            // Reset video swatches
            document.querySelectorAll('#videoSelection .swatch-item').forEach(item => {
                item.classList.remove('selected');
            });
        } else {
            categoryPanel.style.display = 'none';
            videoPanel.style.display = 'block';
            selectedCategories = [];
            // Reset category swatches
            document.querySelectorAll('#categorySelection .swatch-item').forEach(item => {
                item.classList.remove('selected');
            });
        }
        updateShortcode();
    }

    function toggleSwatch(element, type) {
        const value = element.getAttribute('data-value');
        
        if (type === 'category') {
            if (element.classList.contains('selected')) {
                element.classList.remove('selected');
                selectedCategories = selectedCategories.filter(cat => cat !== value);
            } else {
                element.classList.add('selected');
                selectedCategories.push(value);
            }
        } else if (type === 'video') {
            if (element.classList.contains('selected')) {
                element.classList.remove('selected');
                selectedVideos = selectedVideos.filter(vid => vid !== value);
            } else {
                element.classList.add('selected');
                selectedVideos.push(value);
            }
        }
        
        updateShortcode();
    }

    function updateShortcode() {
        const displayType = document.querySelector('input[name="display_type"]:checked').value;
        const limit = document.getElementById('shortcode_limit').value.trim() || '10';
        const title = document.getElementById('shortcode_title').value.trim();
        const showDesc = document.getElementById('shortcode_show_desc').checked ? '1' : '0';
        const productPage = document.getElementById('shortcode_product_page').checked ? '1' : '0';
        const sortBy = document.getElementById('shortcode_sort').value;
        const sliderTitleOnly = document.getElementById('shortcode_slider_title_only').checked ? '1' : '0';

        let shortcode = '[artm_videos';
        
        // Add limit (always present)
        shortcode += ' limit="' + limit + '"';
        
        // Add display type specific parameters
        if (displayType === 'categories' && selectedCategories.length > 0) {
            shortcode += ' categories="' + selectedCategories.join(',') + '"';
        } else if (displayType === 'videos' && selectedVideos.length > 0) {
            shortcode += ' videos="' + selectedVideos.join(',') + '"';
        }
        
        // Add title if provided
        if (title) {
            shortcode += ' title="' + title + '"';
        }
        
        // Add sort if not default
        if (sortBy !== 'sort_order') {
            shortcode += ' sort="' + sortBy + '"';
        }
        
        // Add show description if checked
        if (showDesc === '1') {
            shortcode += ' show_description="1"';
        }
        
        // Add slider_title_only if checked
        if (sliderTitleOnly === '1') {
            shortcode += ' slider_title_only="1"';
        }
        
        // Add product page if checked
        if (productPage === '1') {
            shortcode += ' product_page="1"';
        }
        
        shortcode += ']';
        
        document.getElementById('generatedShortcode').textContent = shortcode;
        
        // Generate PHP code - use template literals to avoid escaping issues
        const phpCode = `<?= $this->helper('ArtM\\ShortVideos\\Helper\\Data')->processShortcode('${shortcode}') ?>`;
        // Use innerHTML with HTML entities for proper display
        document.getElementById('generatedPhpCode').innerHTML = phpCode.replace(/</g, '&lt;').replace(/>/g, '&gt;');
        // Store the actual code for copying
        document.getElementById('generatedPhpCode').setAttribute('data-code', phpCode);
    }

    function filterVideos(searchTerm) {
        searchTerm = searchTerm.toLowerCase().trim();
        const videoSwatches = document.querySelectorAll('#videoSwatchContainer .video-swatch');
        let visibleCount = 0;

        videoSwatches.forEach(function(swatch) {
            const searchData = swatch.getAttribute('data-search');
            if (searchData.includes(searchTerm)) {
                swatch.style.display = 'flex';
                visibleCount++;
            } else {
                swatch.style.display = 'none';
            }
        });

        // Show "no results" message if nothing found
        const container = document.getElementById('videoSwatchContainer');
        let noResultsMsg = container.querySelector('.no-results-msg');
        
        if (visibleCount === 0 && searchTerm !== '') {
            if (!noResultsMsg) {
                noResultsMsg = document.createElement('p');
                noResultsMsg.className = 'no-results-msg no-items';
                noResultsMsg.textContent = '<?= __('No videos found matching your search') ?>';
                container.appendChild(noResultsMsg);
            }
            noResultsMsg.style.display = 'block';
        } else {
            if (noResultsMsg) {
                noResultsMsg.style.display = 'none';
            }
        }
    }

    function copyShortcode() {
        const shortcode = document.getElementById('generatedShortcode').textContent;
        navigator.clipboard.writeText(shortcode).then(function() {
            const btn = event.target;
            const originalText = btn.innerHTML;
            btn.innerHTML = '✅ Copied!';
            btn.style.background = '#27ae60';
            setTimeout(function() {
                btn.innerHTML = originalText;
                btn.style.background = '';
            }, 2000);
        });
    }

    function copyPhpCode() {
        const codeElement = document.getElementById('generatedPhpCode');
        let phpCode = codeElement.getAttribute('data-code') || codeElement.textContent;
        
        // Decode HTML entities for proper copying
        const textarea = document.createElement('textarea');
        textarea.innerHTML = phpCode;
        phpCode = textarea.value;
        
        navigator.clipboard.writeText(phpCode).then(function() {
            const btn = event.target;
            const originalText = btn.innerHTML;
            btn.innerHTML = '✅ Copied!';
            btn.style.background = '#27ae60';
            setTimeout(function() {
                btn.innerHTML = originalText;
                btn.style.background = '';
            }, 2000);
        });
    }

    // Close popup when clicking outside
    window.onclick = function(event) {
        const popup = document.getElementById('shortcodePopup');
        if (event.target === popup) {
            closeShortcodePopup();
        }
    }
</script>

