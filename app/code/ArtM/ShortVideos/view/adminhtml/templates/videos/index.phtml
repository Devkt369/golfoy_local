$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$request = $objectManager->get('Magento\Framework\App\RequestInterface');

// Get filter parameters
$filterTitle = $request->getParam('filter_title', '');
$filterType = $request->getParam('filter_type', '');
$filterCategory = $request->getParam('filter_category', '');
$filterStatus = $request->getParam('filter_status', '');

// Get pagination parameters
$currentPage = (int)$request->getParam('page', 1);
$perPage = (int)$request->getParam('per_page', 10);
if (!in_array($perPage, [10, 25, 50, 100])) {
    $perPage = 10;
}

// Build collection with filters
$videoCollection = $objectManager->create('ArtM\ShortVideos\Model\ResourceModel\Video\Collection');

if ($filterTitle) {
    $videoCollection->addFieldToFilter('title', ['like' => '%' . $filterTitle . '%']);
}
if ($filterType) {
    $videoCollection->addFieldToFilter('video_type', $filterType);
}
if ($filterCategory) {
    $videoCollection->addFieldToFilter('category', ['like' => '%' . $filterCategory . '%']);
}
if ($filterStatus !== '') {
    $videoCollection->addFieldToFilter('status', $filterStatus);
}

$videoCollection->setOrder('sort_order', 'ASC');

// Get total count before pagination
$totalVideos = $videoCollection->getSize();
$totalPages = ceil($totalVideos / $perPage);

// Apply pagination
$videoCollection->setPageSize($perPage);
$videoCollection->setCurPage($currentPage);

$videos = $videoCollection->getItems();

// Get all categories for filter dropdown
$allCategories = $objectManager->create('ArtM\ShortVideos\Model\ResourceModel\Video\Collection')->getAllCategories();

// Get all videos for shortcode popup
$allVideosCollection = $objectManager->create('ArtM\ShortVideos\Model\ResourceModel\Video\Collection');
$allVideosCollection->addFieldToFilter('status', 1); // Only enabled videos
$allVideosCollection->setOrder('title', 'ASC');
$allVideos = $allVideosCollection->getItems();
