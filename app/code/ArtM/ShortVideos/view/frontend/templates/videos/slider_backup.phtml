<!-- React Integration Helper -->
<script>
// Global function for React to initialize sliders after content load
window.initArtmVideoSlider = window.initArtmVideoSlider || function(sliderId) {
    const slider = document.getElementById(sliderId || '<?= $sliderId ?>');
    if (slider && slider.dataset.initialized !== 'true') {
        const event = new Event('artm-slider-init');
        slider.dispatchEvent(event);
    }
};

// Initialize all sliders on page
window.initAllArtmVideoSliders = function() {
    document.querySelectorAll('.artm-video-slider-wrapper[id]').forEach(function(wrapper) {
        if (wrapper.dataset.initialized !== 'true') {
            window.initArtmVideoSlider(wrapper.id);
        }
    });
};
</script>

