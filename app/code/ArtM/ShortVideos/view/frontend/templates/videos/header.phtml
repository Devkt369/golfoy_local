            $(document).on("click", ".filter_toggler", function() {
                $("#narrow-by-list").toggleClass("opened_mobile");
                $("body").toggleClass("filter-active_mobile");
            });

            setInterval(() => {
                const REQUIRED_ARIA_VALUE = "option-label-shirt_size-184";
                $('.swatch-option').each(function() {
                    const $option = $(this);
                    const ariaValue = $option.attr('aria-describedby');
                    const $quantitySpan = $option.find('.swatch-qty');
                    if ($quantitySpan.length === 0) {
                        return;
                    }
                    if (ariaValue === REQUIRED_ARIA_VALUE) {
                        $quantitySpan.show();
                    } else {
                        $quantitySpan.hide();
                    }
                });
            }, 500);

