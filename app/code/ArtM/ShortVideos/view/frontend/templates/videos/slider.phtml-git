            <!-- Custom Fullscreen Popup for Slider (not product page) -->
            <div class="artm-popup-fullscreen">
                <div id="artm-slider-popup" class="artm-video-fullscreen" style="display: none;" tabindex="-1">
                    <button class="artm-video-fullscreen-close" onclick="artmCloseSliderPopup(event)">
                        ×
