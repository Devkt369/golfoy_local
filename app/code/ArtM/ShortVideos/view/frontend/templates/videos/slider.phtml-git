        color: #e60023;
        font-weight: 700;
        font-size: 14px;
    }

    .artm-video-slider {
        overflow-x: scroll;
        overflow-y: hidden;
        scroll-behavior: smooth;
        white-space: nowrap;
        display: flex;
        gap: 15px;
        padding: 10px 0;
        scrollbar-width: none;
        /* Firefox */
        -ms-overflow-style: none;
        /* IE/Edge */
    }

    .artm-video-slider::-webkit-scrollbar {
        display: none;
        /* Chrome/Safari */
    }

    .artm-video-card {
        display: flex;
        flex-direction: column;
        width: 200px;
        min-width: 200px;
        height: 450px;
        background: white;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        vertical-align: top;
    }

    .artm-video-card:hover {
        transform: translateY(-8px);
    }

    .artm-video-embed {
        position: relative;
        width: 200px;
        height: 356px;
        flex-shrink: 0;
        background: transparent;
        overflow: hidden;
    }

    .artm-video-embed video {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .youtube-wrapper,
    .instagram-wrapper {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }

    .youtube-wrapper iframe,
    .instagram-wrapper iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .hover-blocker,
    .instagram-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 60px;
        background: transparent;
        z-index: 10;
        pointer-events: auto;
    }

    .artm-video-link-wrapper {
        display: inline-block;
        text-decoration: none;
        color: inherit;
        width: 200px;
        min-width: 200px;
        height: 450px;
    }

    .artm-video-link-wrapper .artm-video-card {
        cursor: pointer;
    }

    .artm-video-link-wrapper:hover .artm-video-card {
        transform: translateY(-8px);
    }

    .artm-video-info {
        padding: 12px 15px 12px 0px !important;
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 94px;
    }

    .artm-video-info h3 {
        font-size: 11px;
        font-weight: 600 !important;
        color: #2c3e50;
        margin: 0 0 6px 0;
        white-space: normal;
        line-height: 1.3;
        max-height: none;
