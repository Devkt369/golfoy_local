            <script>
                // Custom popup logic for slider
                function artmOpenCustomPopup(el) {
                    var data = el.getAttribute('data-videodata');
                    if (!data) return;
                    var video = JSON.parse(data);
                    var popup = document.getElementById('artm-slider-popup');
                    var player = document.getElementById('artm-slider-popup-player');
                    if (!popup || !player) return;
                    // Build video embed
                    var html = '';
                    if (video.type === 'upload') {
                        html += '<div class="video-players-block"><video class="video-players" autoplay muted loop playsinline controls><source src="' + video.url + '" type="video/mp4"></video></div>';
                    } else if (video.type === 'youtube') {
                        html += '<iframe class="youtube-video" width="100%" height="400" src="' + video.url + '?autoplay=1&mute=1&loop=1&playlist=" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>';
                    } else if (video.type === 'instagram') {
                        html += '<iframe class="instagram-video" width="100%" height="400" src="' + video.url + '" frameborder="0" scrolling="no" allowtransparency="true" allowfullscreen allow="autoplay"></iframe>';
                    }
                    // Add details below
                    html += '<div class="artm-popup-details">';
                    if (video.product) {
                        // Product: link name/desc, add View Product button with video param
                        html += '<a href="' + video.link + '" target="_blank" class="video-link-tag">';
                        html += '<h3 class="video-product-name">' + video.product.name + '</h3>';
                        html += '</a>';
                        if (video.product.price && video.product.regular_price && video.product.price !== video.product.regular_price) {
                            html += '<div class="video-regular-price-tag"><span class="video-reg-price">' + video.product.regular_price + '</span><span class="video-pro-price">' + video.product.price + '</span></div>';
                        } else if (video.product.price) {
                            html += '<div class="video-product-price">' + video.product.price + '</div>';
                        }
                        // Add ?video=video_id param to product link
                        var productUrl = video.link;
                        if (productUrl.indexOf('?') === -1) {
                            productUrl += '?video=' + encodeURIComponent(video.id);
                        } else {
                            productUrl += '&video=' + encodeURIComponent(video.id);
                        }
                        html += '<div><a href="' + productUrl + '" target="_blank" class="artm-popup-redirect-btn">View Product</a></div>';
                    } else {
                        // Not product: link title/desc
                        html += '<a href="' + video.link + '" target="_blank" style="text-decoration:none;color:inherit;">';
                        html += '<h3 class="video-title">' + (video.title || '') + '</h3>';
                        if (video.description) {
                            html += '<div class="video-desc">' + video.description + '</div>';
                        }
                        html += '</a>';
                    }
                    html += '</div>';
                    player.innerHTML = html;
                    // Show popup
                    popup.style.display = 'flex';
                    // Focus for accessibility
                    popup.focus();
                }

                function artmCloseSliderPopup(e) {
                    var popup = document.getElementById('artm-slider-popup');
                    if (popup) popup.style.display = 'none';
                }
            </script>
        </div>

        <button class="artm-slider-arrow artm-slider-right" onclick="artmSlideRight('<?= $sliderId ?>')">›</button>
    </div>
</div>


<script>
    // Global slider functions - works with React
    function artmSlideLeft(sliderId) {
        const slider = document.getElementById(sliderId);
        if (!slider) return;

        const scrollAmount = slider.clientWidth * 0.8;
        slider.scrollLeft = Math.max(0, slider.scrollLeft - scrollAmount);
    }

    function artmSlideRight(sliderId) {
        const slider = document.getElementById(sliderId);
        if (!slider) return;

        const scrollAmount = slider.clientWidth * 0.8;
        const maxScroll = slider.scrollWidth - slider.clientWidth;
        slider.scrollLeft = Math.min(maxScroll, slider.scrollLeft + scrollAmount);

        // Hide arrow on mobile after click
        if (window.innerWidth <= 768) {
            const wrapper = slider.closest('.artm-slider-container');
            const rightArrow = wrapper.querySelector('.artm-slider-right');
            if (rightArrow) {
                rightArrow.classList.add('hidden');
            }
        }
    }

    // Initialize slider when loaded
    (function() {
        const sliderId = '<?= $sliderId ?>';

        function initSlider() {
            const slider = document.getElementById(sliderId);
            if (!slider || slider.dataset.artmInit) return;

            slider.dataset.artmInit = 'true';

            // Hide arrow on mobile after swipe/scroll
            if (window.innerWidth <= 768) {
                slider.addEventListener('scroll', function() {
                    const wrapper = slider.closest('.artm-slider-container');
                    const rightArrow = wrapper.querySelector('.artm-slider-right');
                    if (rightArrow && slider.scrollLeft > 0) {
                        rightArrow.classList.add('hidden');
                    }
                }, {
                    once: true
                });

                // Also hide on touch move
                slider.addEventListener('touchmove', function() {
                    const wrapper = slider.closest('.artm-slider-container');
                    const rightArrow = wrapper.querySelector('.artm-slider-right');
                    if (rightArrow) {
                        setTimeout(function() {
                            if (slider.scrollLeft > 0) {
                                rightArrow.classList.add('hidden');
                            }
                        }, 100);
                    }
                }, {
                    once: true
                });
            }

            console.log('ArtM Video Slider initialized:', sliderId);
        }

        // Try to initialize immediately
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initSlider);
        } else {
            initSlider();
        }

        // Watch for React content changes
        if (window.MutationObserver) {
            const observer = new MutationObserver(function() {
                initSlider();
            });

            if (document.body) {
                observer.observe(document.body, {
                    childList: true,
                    subtree: true
                });
            }
        }
    })();
</script>

