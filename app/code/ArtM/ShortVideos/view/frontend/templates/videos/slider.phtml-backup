    <button class="artm-video-fullscreen-close">×</button>
    <div class="artm-video-fullscreen-player" id="artm-video-fullscreen-player">
        <!-- Video will be injected here -->
    </div>
</div>

<style>
/* Video Popup - Bottom Right Corner */
.artm-video-popup {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 9999;
    animation: slideInRight 0.4s ease-out;
}

@keyframes slideInRight {
    from {
        transform: translateX(400px);
        opacity: 0;
    }
    to {
        transform: translateX(0);
        opacity: 1;
    }
}

.artm-video-popup-content {
    position: relative;
    width: 200px;
    height: 356px;
    background: #000;
    overflow: hidden;
}

.artm-video-popup-close {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 30px;
    height: 30px;
    background: rgba(0, 0, 0, 0.8);
    color: white;
    border: none;
    border-radius: 50%;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s;
}

.artm-video-popup-close:hover {
    background: rgba(255, 0, 0, 0.8);
    transform: rotate(90deg);
}

.artm-video-popup-player {
    width: 100%;
    height: 100%;
    cursor: pointer;
}

.artm-video-popup-player video,
.artm-video-popup-player iframe {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/* Fullscreen Video Overlay */
.artm-video-fullscreen {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.95);
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: fadeIn 0.3s ease-out;
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

.artm-video-fullscreen-close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 50px;
    height: 50px;
    background: rgba(255, 255, 255, 0.2);
    color: white;
    border: 2px solid white;
    border-radius: 50%;
    font-size: 32px;
    line-height: 1;
    cursor: pointer;
    z-index: 10001;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s;
}
.artm-video-embed {
    border-radius: 5px;
}
.artm-video-fullscreen-close:hover {
    background: rgba(255, 0, 0, 0.8);
    border-color: #ff0000;
    transform: rotate(90deg);
}

.artm-video-fullscreen-player {
    width: 90%;
    max-width: 500px;
    height: 90vh;
    max-height: 888px;
    background: #000;
    overflow: hidden;
    position: relative;
}

.artm-video-fullscreen-player video,
.artm-video-fullscreen-player iframe {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

/* Mobile Responsive */
@media (max-width: 768px) {
    .artm-video-popup {
        bottom: 10px;
        right: 10px;
    }
    
    .artm-video-popup-content {
        width: 150px;
        height: 267px;
    }
    
    .artm-video-fullscreen-player {
        width: 95%;
        height: 95vh;
    }
}
</style>

<script>
// Video Popup Functions
window.artmVideoData = null;

function artmShowVideoPopup(videoData) {
    window.artmVideoData = videoData;
    const popup = document.getElementById('artm-video-popup');
    const player = document.getElementById('artm-video-popup-player');
    
    if (!popup || !player) return;
    
    // Clear previous content
    player.innerHTML = '';
    
    // Create video element based on type
    if (videoData.type === 'upload') {
        player.innerHTML = `<video autoplay muted loop playsinline>
            <source src="${videoData.url}" type="video/mp4">
        </video>`;
    } else if (videoData.type === 'youtube') {
        const videoId = videoData.url.match(/embed\/([^\/\?]+)/)?.[1] || '';
        player.innerHTML = `<iframe width="200" height="356" src="${videoData.url}?autoplay=1&mute=1&loop=1&playlist=${videoId}&controls=0&modestbranding=1&rel=0&showinfo=0" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
    } else if (videoData.type === 'instagram') {
        player.innerHTML = `<iframe width="200" height="356" src="${videoData.url}" frameborder="0" scrolling="no" allowtransparency="true" allowfullscreen allow="autoplay"></iframe>`;
    }
    
    popup.style.display = 'block';
}

function artmCloseVideoPopup() {
    const popup = document.getElementById('artm-video-popup');
    if (popup) {
        popup.style.display = 'none';
    }
}

function artmExpandVideoPopup() {
    if (!window.artmVideoData) return;
    
    artmCloseVideoPopup();
    
    const fullscreen = document.getElementById('artm-video-fullscreen');
    const player = document.getElementById('artm-video-fullscreen-player');
    
    if (!fullscreen || !player) return;
    
    // Clear previous content
    player.innerHTML = '';
    
    const videoData = window.artmVideoData;
    
    // Create fullscreen video element
    if (videoData.type === 'upload') {
        player.innerHTML = `<video autoplay muted loop playsinline controls>
            <source src="${videoData.url}" type="video/mp4">
        </video>`;
    } else if (videoData.type === 'youtube') {
        const videoId = videoData.url.match(/embed\/([^\/\?]+)/)?.[1] || '';
        player.innerHTML = `<iframe width="500" height="888" src="${videoData.url}?autoplay=1&mute=1&loop=1&playlist=${videoId}&controls=1&modestbranding=1&rel=0" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
    } else if (videoData.type === 'instagram') {
        player.innerHTML = `<iframe width="500" height="888" src="${videoData.url}" frameborder="0" scrolling="no" allowtransparency="true" allowfullscreen allow="autoplay"></iframe>`;
    }
    
    fullscreen.style.display = 'flex';
}

function artmCloseFullscreen(event) {
    // Only close if clicking the overlay, not the video itself
    if (event && event.target.closest('.artm-video-fullscreen-player')) {
        return;
    }
    
    const fullscreen = document.getElementById('artm-video-fullscreen');
    if (fullscreen) {
        fullscreen.style.display = 'none';
    }
}

// Check URL for video parameter on product page
(function() {
    function checkVideoParameter() {
        const urlParams = new URLSearchParams(window.location.search);
        const videoId = urlParams.get('video');
        
        if (!videoId) return;
        
        // Fetch video data from server
        fetch(`<?= $block->getUrl('shortvideos/video/get') ?>?video_id=${videoId}`)
            .then(response => response.json())
            .then(data => {
                if (data.success && data.video) {
                    artmShowVideoPopup({
                        type: data.video.video_type,
                        url: data.video.video_url
                    });
                }
            })
            .catch(error => {
                console.error('Error loading video:', error);
            });
    }
    
    // Check on page load
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', checkVideoParameter);
    } else {
        checkVideoParameter();
    }
})();
</script>
