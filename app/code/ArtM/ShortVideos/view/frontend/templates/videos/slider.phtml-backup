<?php
/**
 * ArtM ShortVideos Frontend Slider Template (Simplified for React)
 *
 * @category  ArtM
 * @package   ArtM_ShortVideos
 * @author    ArtM
 * @copyright Copyright (c) 2025 ArtM
 * @var $block \ArtM\ShortVideos\Block\Videos
 */

try {
    $videos = $block->getVideos();
    $sliderId = $block->getSliderId();
    $title = $block->getSectionTitle();
    $showDescription = $block->shouldShowDescription();
    $productPageEnabled = $block->isProductPageEnabled();

    if ($videos->getSize() == 0) {
        echo '<!-- No videos found -->';
        return;
    }
} catch (\Exception $e) {
    echo '<!-- Error loading videos: ' . $e->getMessage() . ' -->';
    return;
}
?>

<div class="artm-video-slider-wrapper" id="<?= $sliderId ?>-wrapper" data-slider-id="<?= $sliderId ?>">
    <?php if ($title): ?>
        <div class="slider-new-title">
            <h2 class="center_heading"><?= $block->escapeHtml($title) ?></h2>
        </div>
    <?php endif; ?>
    
    <div class="artm-slider-container">
        <button class="artm-slider-arrow artm-slider-left" onclick="artmSlideLeft('<?= $sliderId ?>')">‹</button>
        
        <div class="artm-video-slider" id="<?= $sliderId ?>">
            <?php foreach ($videos as $video): ?>
                <?php 
                try {
                    $linkUrl = method_exists($block, 'getVideoLinkUrl') ? $block->getVideoLinkUrl($video) : null;
                    $product = null;
                    if ($video->getIsProductLink() && $video->getProductId() && method_exists($block, 'getProduct')) {
                        $product = $block->getProduct($video->getProductId());
                    }
                } catch (\Exception $e) {
                    $linkUrl = null;
                    $product = null;
                }
                ?>
                <?php if ($linkUrl): ?>
                    <a href="<?= $block->escapeUrl($linkUrl) ?>" class="artm-video-link-wrapper" <?= $video->getLinkUrl() && !$video->getIsProductLink() ? 'target="_blank"' : '' ?>>
                <?php endif; ?>
                
                <div class="artm-video-card">
                    <div class="artm-video-embed">
                        <?php if ($video->getVideoType() === 'upload'): ?>
                            <video autoplay muted loop playsinline>
                                <source src="<?= $block->escapeUrl($video->getVideoUrl()) ?>" type="video/mp4">
                            </video>
                        <?php elseif ($video->getVideoType() === 'youtube'): ?>
                            <?php 
                            $embedUrl = $block->getVideoEmbedUrl($video);
                            preg_match('/embed\/([^\/\?]+)/', $embedUrl, $matches);
                            $videoId = $matches[1] ?? '';
                            ?>
                            <div class="youtube-wrapper">
                                <iframe width="280" height="498" src="<?= $embedUrl ?>?autoplay=1&mute=1&loop=1&playlist=<?= $videoId ?>&controls=0&modestbranding=1&rel=0&showinfo=0&iv_load_policy=3&fs=0&disablekb=1&cc_load_policy=0&autohide=1" frameborder="0" title="" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="pointer-events: none;"></iframe>
                                <div class="hover-blocker"></div>
                            </div>
                        <?php else: ?>
                            <div class="instagram-wrapper">
                                <iframe width="280" height="498" src="<?= $block->getVideoEmbedUrl($video) ?>" frameborder="0" scrolling="no" allowtransparency="true" allowfullscreen allow="autoplay" style="background: white; box-shadow: none; display: block; margin: 0px; padding: 0px; border: none;"></iframe>
                                <div class="instagram-overlay"></div>
                            </div>
                        <?php endif; ?>
                    </div>
                    
                    <?php if ($showDescription): ?>
                        <div class="artm-video-info">
                            <?php if ($product): ?>
                                <h3><?= $block->escapeHtml($product->getName()) ?></h3>
                                <p class="artm-product-price">
                                    <?php 
                                    try {
                                        $finalPrice = $product->getFinalPrice();
                                        $regularPrice = $product->getPrice();
                                        if ($finalPrice < $regularPrice): ?>
                                            <span class="old-price"><?= method_exists($block, 'formatPrice') ? $block->formatPrice($regularPrice) : '$' . number_format($regularPrice, 2) ?></span>
                                            <span class="special-price"><?= method_exists($block, 'formatPrice') ? $block->formatPrice($finalPrice) : '$' . number_format($finalPrice, 2) ?></span>
                                        <?php else: ?>
                                            <span class="price"><?= method_exists($block, 'formatPrice') ? $block->formatPrice($finalPrice) : '$' . number_format($finalPrice, 2) ?></span>
                                        <?php endif;
                                    } catch (\Exception $e) {
                                        echo '<span class="price">Price not available</span>';
                                    }
                                    ?>
                                </p>
                            <?php else: ?>
                                <h3><?= $block->escapeHtml($video->getTitle()) ?></h3>
                                <?php if ($video->getDescription()): ?>
                                    <p><?= $block->escapeHtml($video->getDescription()) ?></p>
                                <?php endif; ?>
                            <?php endif; ?>
                        </div>
                    <?php endif; ?>
                </div>
                
                <?php if ($linkUrl): ?>
                    </a>
                <?php endif; ?>
            <?php endforeach; ?>
        </div>
        
        <button class="artm-slider-arrow artm-slider-right" onclick="artmSlideRight('<?= $sliderId ?>')">›</button>
    </div>
</div>

