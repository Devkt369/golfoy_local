<script>
    document.getElementById('artm-video-fullscreen').addEventListener('click', artmCloseFullscreen);

    document.getElementById('artm-video-fullscreen-player').addEventListener('click', (e) => {
        e.stopPropagation();
    });
// Global functions for video popup
function artmShowVideoPopup(videoData) {
    console.log('artmShowVideoPopup called with:', videoData);
    if (!videoData || (!videoData.url && !videoData.video_url)) {
        console.error('No video URL provided');
        return;
    }
    
    const popup = document.getElementById('artm-video-popup');
    const player = document.getElementById('artm-video-popup-player');
    
    if (!popup || !player) {
        console.error('Popup elements not found');
        return;
    }
    
    let videoUrl = videoData.url || videoData.video_url;
    const videoType = videoData.type || videoData.video_type || 'upload';
    
    let videoHTML = '';
    if (videoType === 'upload') {
        videoHTML = `<video controls autoplay muted loop playsinline><source src="${videoUrl}" type="video/mp4"></video>`;
    } else {
        // Add autoplay, mute, and loop parameters to YouTube/Instagram URLs
        if (videoUrl.includes('youtube.com') || videoUrl.includes('youtu.be')) {
            // Extract video ID for playlist parameter (required for loop)
            let videoId = '';
            const match = videoUrl.match(/embed\/([^\/\?]+)/);
            if (match) {
                videoId = match[1];
            }
            videoUrl = videoUrl + (videoUrl.includes('?') ? '&' : '?') + 'autoplay=1&mute=1&loop=1&playlist=' + videoId + '&controls=0';
        } else if (videoUrl.includes('instagram.com')) {
            videoUrl = videoUrl + (videoUrl.includes('?') ? '&' : '?') + 'autoplay=1';
        }
        videoHTML = `<iframe src="${videoUrl}" frameborder="0" allow="autoplay; encrypted-media; accelerometer; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
    }
    
    player.innerHTML = videoHTML;
    popup.style.display = 'block';
}

function artmCloseVideoPopup() {
    const popup = document.getElementById('artm-video-popup');
    const player = document.getElementById('artm-video-popup-player');
    
    if (popup) popup.style.display = 'none';
    if (player) player.innerHTML = '';
}

function artmExpandVideoPopup(event) {
    // Prevent triggering if clicking on close button
    if (event && event.target.classList.contains('artm-video-popup-close')) {
        return;
    }
    
    const popup = document.getElementById('artm-video-popup');
    const player = document.getElementById('artm-video-popup-player');
    const fullscreen = document.getElementById('artm-video-fullscreen');
    const fullscreenPlayer = document.getElementById('artm-video-fullscreen-player');
    
    if (!popup || !player || !fullscreen || !fullscreenPlayer) return;
    
    // Detect header height
    const header = document.querySelector('header') || document.querySelector('.page-header') || document.querySelector('.header');
    const headerHeight = header ? header.offsetHeight : 100;
    
    // Set CSS variable for header height
    document.documentElement.style.setProperty('--header-height', headerHeight + 'px');
    
    const videoHTML = player.innerHTML;
    fullscreenPlayer.innerHTML = videoHTML;
    
    // Enable controls for YouTube videos in fullscreen
    const iframe = fullscreenPlayer.querySelector('iframe');
    if (iframe && iframe.src.includes('youtube.com')) {
        let src = iframe.src;
        // Replace controls=0 with controls=1
        src = src.replace('controls=0', 'controls=1');
        // Add controls=1 if not present
        if (!src.includes('controls=')) {
            src += (src.includes('?') ? '&' : '?') + 'controls=1';
        }
        iframe.src = src;
        iframe.style.pointerEvents = 'auto';
    }
    
    fullscreen.style.display = 'flex';
    
    // Ensure fullscreen is properly positioned below header
    fullscreen.style.position = 'fixed';
    fullscreen.style.top = headerHeight + 'px';
    fullscreen.style.left = '0';
    fullscreen.style.width = '100%';
    fullscreen.style.height = 'calc(100vh - ' + headerHeight + 'px)';
    fullscreen.style.zIndex = '999';
}

function artmCloseFullscreen() {
    const fullscreen = document.getElementById('artm-video-fullscreen');
    const fullscreenPlayer = document.getElementById('artm-video-fullscreen-player');
    
    if (fullscreen) fullscreen.style.display = 'none';
    if (fullscreenPlayer) fullscreenPlayer.innerHTML = '';
}

// Check URL for video parameter on product page
(function() {
    function checkVideoParameter() {
        const urlParams = new URLSearchParams(window.location.search);
        const videoId = urlParams.get('video');
        
        if (!videoId) return;
        
        // Fetch video data from server
        console.log('Fetching video ID:', videoId);
        fetch('<?= $block->getUrl('shortvideos/video/get') ?>?video_id=' + videoId)
            .then(response => response.json())
            .then(data => {
                console.log('Video API response:', data);
                if (data.success && data.video) {
                    // Ensure proper video data structure
                    const videoData = {
                        type: data.video.video_type || 'upload',
                        video_type: data.video.video_type || 'upload',
                        url: data.video.video_url || data.video.url,
                        video_url: data.video.video_url || data.video.url
                    };
                    console.log('Opening popup with video data:', videoData);
                    artmShowVideoPopup(videoData);
                } else {
                    console.error('Video fetch failed:', data.message);
                }
            })
            .catch(error => {
                console.error('Error loading video:', error);
            });
    }
    
    // Check on page load
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', checkVideoParameter);
    } else {
        checkVideoParameter();
    }
})();
</script>
