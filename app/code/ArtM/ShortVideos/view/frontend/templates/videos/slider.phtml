<script>
    // Global slider functions - works with React
    function artmSlideLeft(sliderId) {
        const slider = document.getElementById(sliderId);
        if (!slider) return;

        const scrollAmount = slider.clientWidth * 0.8;
        slider.scrollLeft = Math.max(0, slider.scrollLeft - scrollAmount);
    }

    function artmSlideRight(sliderId) {
        const slider = document.getElementById(sliderId);
        if (!slider) return;

        const scrollAmount = slider.clientWidth * 0.8;
        const maxScroll = slider.scrollWidth - slider.clientWidth;
        slider.scrollLeft = Math.min(maxScroll, slider.scrollLeft + scrollAmount);

        // Hide arrow on mobile after click
        if (window.innerWidth <= 768) {
            const wrapper = slider.closest('.artm-slider-container');
            const rightArrow = wrapper.querySelector('.artm-slider-right');
            if (rightArrow) {
                rightArrow.classList.add('hidden');
            }
        }
    }

    // Initialize slider when loaded
    (function() {
        const sliderId = '<?= $sliderId ?>';

        function initSlider() {
            const slider = document.getElementById(sliderId);
            if (!slider || slider.dataset.artmInit) return;

            slider.dataset.artmInit = 'true';

            // Hide arrow on mobile after swipe/scroll
            if (window.innerWidth <= 768) {
                slider.addEventListener('scroll', function() {
                    const wrapper = slider.closest('.artm-slider-container');
                    const rightArrow = wrapper.querySelector('.artm-slider-right');
                    if (rightArrow && slider.scrollLeft > 0) {
                        rightArrow.classList.add('hidden');
                    }
                }, {
                    once: true
                });

                // Also hide on touch move
                slider.addEventListener('touchmove', function() {
                    const wrapper = slider.closest('.artm-slider-container');
                    const rightArrow = wrapper.querySelector('.artm-slider-right');
                    if (rightArrow) {
                        setTimeout(function() {
                            if (slider.scrollLeft > 0) {
                                rightArrow.classList.add('hidden');
                            }
                        }, 100);
                    }
                }, {
                    once: true
                });
            }

            console.log('ArtM Video Slider initialized:', sliderId);
        }

        // Try to initialize immediately
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initSlider);
        } else {
            initSlider();
        }

        // Watch for React content changes
        if (window.MutationObserver) {
            const observer = new MutationObserver(function() {
                initSlider();
            });

            if (document.body) {
                observer.observe(document.body, {
                    childList: true,
                    subtree: true
                });
            }
        }
    })();
</script>

