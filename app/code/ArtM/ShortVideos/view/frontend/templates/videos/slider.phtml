<script>
    (function() {

        // Run script only on desktop + tablet (NOT mobile)
        function isLargeScreen() {
            return window.innerWidth >= 600; // ✨ tablet + desktop
        }

        // For each .artm-video-fullscreen-player container, match video height to details height
        function syncForContainer(container) {

            // skip for mobile
            if (!isLargeScreen()) return;

            const details = container.querySelector('.artm-popup-details');
            const video = container.querySelector('video.video-players');
            const videoBlock = container.querySelector('.video-players-block');

            if (!details) return;

            function apply() {
                // Clear on mobile
                if (!isLargeScreen()) {
                    if (videoBlock) videoBlock.style.height = '';
                    if (video) video.style.height = '';
                    return;
                }

                const h = details.offsetHeight;
                if (videoBlock) videoBlock.style.height = h + 'px';
                if (video) video.style.height = h + 'px';
            }

            apply();

            // Observe height changes of details
            if (window.ResizeObserver) {
                const ro = new ResizeObserver(apply);
                ro.observe(details);
                container.__ro = ro;
            } else {
                const mo = new MutationObserver(apply);
                mo.observe(details, {
                    childList: true,
                    subtree: true,
                    characterData: true,
                    attributes: true
                });
                container.__mo = mo;
            }

            window.addEventListener('resize', apply);
        }

        function initAll() {
            if (!isLargeScreen()) return;

            const containers = document.querySelectorAll('.artm-video-fullscreen-player');
            containers.forEach(container => syncForContainer(container));
        }

        // Detect dynamically added popups
        const containerObserver = new MutationObserver((mutations) => {
            if (!isLargeScreen()) return;

            for (const m of mutations) {
                if (m.addedNodes.length) {
                    m.addedNodes.forEach(node => {
                        if (node.nodeType === 1) {
                            if (node.matches && node.matches('.artm-video-fullscreen-player')) {
                                syncForContainer(node);
                            } else {
                                const nested = node.querySelector && node.querySelector('.artm-video-fullscreen-player');
                                if (nested) syncForContainer(nested);
                            }
                        }
                    });
                }
            }
        });

        containerObserver.observe(document.body, {
            childList: true,
            subtree: true
        });

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initAll);
        } else {
            initAll();
        }

        window.addEventListener('load', initAll);

    })();
</script>