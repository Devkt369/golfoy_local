<script>
    function syncVideoBlockHeight() {
        const player = document.querySelector('.video-players'); // your video iframe/video
        const block = document.querySelector('.video-players-block'); // div where height must apply

        if (!player || !block) return;

        // Wait for iframe/video to load height properly
        const update = () => {
            const height = player.clientHeight;
            if (height > 0) {
                block.style.height = height + 'px';
            }
        };

        // Update now
        update();

        // Update on window resize
        window.addEventListener('resize', update);

        // Update on orientation change
        window.addEventListener('orientationchange', update);
    }

    // Run when DOM is ready
    document.addEventListener('DOMContentLoaded', syncVideoBlockHeight);
</script>

