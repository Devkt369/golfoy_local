<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="artm_short_videos" resource="default" engine="innodb" comment="ArtM Short Videos Table">
        <column xsi:type="int" name="video_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Video ID"/>
        <column xsi:type="varchar" name="title" nullable="false" length="255" comment="Video Title"/>
        <column xsi:type="text" name="description" nullable="true" comment="Video Description"/>
        <column xsi:type="varchar" name="video_url" nullable="true" length="500" comment="Video URL"/>
        <column xsi:type="varchar" name="video_type" nullable="false" length="50" comment="Video Type (instagram, youtube, upload)"/>
        <column xsi:type="varchar" name="category" nullable="true" length="255" comment="Video Category"/>
        <column xsi:type="varchar" name="thumbnail_url" nullable="true" length="500" comment="Video Thumbnail URL"/>
        <column xsi:type="varchar" name="link_url" nullable="true" length="500" comment="Link URL on Video Click"/>
        <column xsi:type="smallint" name="is_product_link" padding="6" unsigned="false" nullable="false" default="0" comment="Is Product Link (1=Yes, 0=No)"/>
        <column xsi:type="int" name="product_id" padding="10" unsigned="true" nullable="true" comment="Product ID if Product Link"/>
        <column xsi:type="smallint" name="show_product_popup" padding="6" unsigned="false" nullable="false" default="0" comment="Show Video Popup on Product Page (1=Yes, 0=No)"/>
        <column xsi:type="smallint" name="status" padding="6" unsigned="false" nullable="false" default="1" comment="Status (1=Active, 0=Inactive)"/>
        <column xsi:type="int" name="sort_order" padding="11" unsigned="false" nullable="false" default="0" comment="Sort Order"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="video_id"/>
        </constraint>
        <index referenceId="ARTM_SHORT_VIDEOS_CATEGORY" indexType="btree">
            <column name="category"/>
        </index>
        <index referenceId="ARTM_SHORT_VIDEOS_STATUS" indexType="btree">
            <column name="status"/>
        </index>
    </table>
</schema>
