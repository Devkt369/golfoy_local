<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
	<system>
		<tab id="artm" translate="label" sortOrder="999">
			<label>artm</label>
		</tab>
		<section id="layout" sortOrder="50" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
			<label>Layout</label>
			<tab>artm</tab>
			<resource>ArtM_Review::config_artm_review</resource>
			<group id="general" sortOrder="10" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
				<label>general</label>
				<field id="products_no_index" type="text" sortOrder="10" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
					<label>Product ids with no-indexing (also excluded in sitemap)</label>
					<comment/>
				</field>
				<field id="cms_no_index" type="text" sortOrder="10" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
					<label>Cms page ids with no-indexing (also excluded in sitemap)</label>
					<comment/>
				</field>
				<field id="category_no_index" type="text" sortOrder="10" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
					<label>Category page ids with no-indexing (also excluded in sitemap)</label>
					<comment/>
				</field>
			</group>			
		</section>
	</system>
</config>
