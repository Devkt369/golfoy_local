<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="artm_adminai_sales_aggregate_sync"
             instance="ArtM\AdminAI\Cron\SalesAggregateSyncCron"
             method="execute">
            <schedule>*/15 * * * *</schedule>
        </job>
        <job name="artm_adminai_product_analytics_sync"
             instance="ArtM\AdminAI\Cron\ProductAnalyticsSyncCron"
             method="execute">
            <schedule>*/20 * * * *</schedule>
        </job>
        <job name="artm_adminai_customer_analytics_sync"
             instance="ArtM\AdminAI\Cron\CustomerAnalyticsSyncCron"
             method="execute">
            <schedule>*/30 * * * *</schedule>
        </job>
        <job name="artm_adminai_customer_segmentation_sync"
             instance="ArtM\AdminAI\Cron\CustomerSegmentationCron"
             method="execute">
            <schedule>0 * * * *</schedule>
        </job>
    </group>
</config>
