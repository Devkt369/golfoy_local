<?php
/** @var \ArtM\AdminAI\Block\Adminhtml\Chat $block */
$supportedIntents = $block->getSupportedIntents();
$intentGroups = [];

$preferredGroupOrder = ['Catalog', 'Sales', 'Reviews', 'Customer', 'Other'];

foreach ($supportedIntents as $intent) {
    $group = $intent['group'] ?? 'Catalog';
    if (!isset($intentGroups[$group])) {
        $intentGroups[$group] = [];
    }
    $intentGroups[$group][] = $intent;
}

uksort($intentGroups, static function ($a, $b) use ($preferredGroupOrder) {
    $aIndex = array_search($a, $preferredGroupOrder, true);
    $bIndex = array_search($b, $preferredGroupOrder, true);

    if ($aIndex === false && $bIndex === false) {
        return strcmp($a, $b);
    }
    if ($aIndex === false) {
        return 1;
    }
    if ($bIndex === false) {
        return -1;
    }

    return $aIndex <=> $bIndex;
});
?>
