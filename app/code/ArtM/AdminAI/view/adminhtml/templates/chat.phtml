<script>
require(['jquery'], function ($) {
    'use strict';
    $('#adminai-expand-btn').on('click', function () {
        var $wrap = $(this).closest('.adminai-wrap');
        var expanded = $wrap.toggleClass('is-fullscreen').hasClass('is-fullscreen');
        $('body').toggleClass('adminai-fullscreen-open', expanded);
        $(this).find('.adminai-expand-icon').html(expanded ? '&#x2715;' : '&#x26F6;');
        $(this).find('.adminai-expand-label').text(expanded ? 'Collapse' : 'Expand');
        $(this).attr('title', expanded ? 'Collapse' : 'Expand to full screen');
    });
});
</script>