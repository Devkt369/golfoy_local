<script type="text/javascript">
require(['jquery', 'mage/translate'], function ($, $t) {
    'use strict';

    var $container = $('#adminai-allchats-container');
    if (!$container.length) { return; }

    var urls = {
        sessions: $container.data('sessions-url'),
        messages: $container.data('messages-url')
    };

    var allSessions = [];
    var activeSessionId = 0;

    var $sessionList = $container.find('.adminai-ac-session-list');
    var $messages    = $container.find('.adminai-ac-messages');
    var $headerTitle = $container.find('.adminai-ac-messages-header-title');
    var $headerUser  = $container.find('.adminai-ac-messages-header-user');
    var $search      = $container.find('.adminai-ac-search');

    function escapeHtml(text) {
        return $('<div/>').text(String(text || '')).html();
    }

    function formatDate(dateStr) {
        return String(dateStr || '').replace('T', ' ').substring(0, 16);
    }

    function renderSessions() {
        var term = $.trim($search.val()).toLowerCase();
        $sessionList.empty();

        var filtered = allSessions;
        if (term) {
            filtered = $.grep(allSessions, function (s) {
                return (s.title || '').toLowerCase().indexOf(term) !== -1
                    || (s.admin_username || '').toLowerCase().indexOf(term) !== -1
                    || (s.admin_name || '').toLowerCase().indexOf(term) !== -1;
            });
        }

        if (!filtered.length) {
            $sessionList.append('<li class="adminai-ac-session-item"><em>' + $t(term ? 'No matching chats.' : 'No chats yet.') + '</em></li>');
            return;
        }

        $.each(filtered, function (_, s) {
            var activeClass = Number(s.session_id) === Number(activeSessionId) ? ' is-active' : '';
            var userLabel = s.admin_name ? escapeHtml(s.admin_name) + ' (' + escapeHtml(s.admin_username) + ')' : (s.admin_username ? escapeHtml(s.admin_username) : '<em>Unknown</em>');
            $sessionList.append(
                '<li class="adminai-ac-session-item' + activeClass + '" data-session-id="' + s.session_id + '">' +
                '<div class="adminai-ac-session-title">' + escapeHtml(s.title || ('Chat #' + s.session_id)) + '</div>' +
                '<div class="adminai-ac-session-user">' + userLabel + '</div>' +
                '<div class="adminai-ac-session-date">' + escapeHtml(formatDate(s.updated_at || s.created_at)) + '</div>' +
                '<div class="adminai-ac-session-preview">' + escapeHtml(s.last_message || '') + '</div>' +
                '</li>'
            );
        });
    }

    function loadSessions() {
        $.ajax({
            url: urls.sessions,
            type: 'GET',
            dataType: 'json'
        }).done(function (response) {
            allSessions = response && response.sessions ? response.sessions : [];
            renderSessions();
        }).fail(function () {
            $sessionList.html('<li class="adminai-ac-session-item"><em>' + $t('Failed to load sessions.') + '</em></li>');
        });
    }

    function loadMessages(sessionId) {
        $messages.html('<p class="adminai-ac-empty">' + $t('Loading...') + '</p>');

        $.ajax({
            url: urls.messages,
            type: 'GET',
            dataType: 'json',
            data: { session_id: sessionId }
        }).done(function (response) {
            $messages.empty();
            var msgs = response && response.messages ? response.messages : [];
            if (!msgs.length) {
                $messages.html('<p class="adminai-ac-empty">' + $t('No messages in this chat.') + '</p>');
                return;
            }
            $.each(msgs, function (_, m) {
                var senderClass = m.role === 'user' ? 'adminai-ac-message-user' : 'adminai-ac-message-assistant';
                var senderLabel = m.role === 'user' ? $t('User') : $t('AI Assistant');
                $messages.append(
                    '<div class="adminai-ac-message ' + senderClass + '">' +
                    '<strong>' + senderLabel + '</strong>' +
                    '<div class="adminai-ac-message-content">' + escapeHtml(m.content || '') + '</div>' +
                    '</div>'
                );
            });
            $messages.scrollTop($messages[0].scrollHeight);
        }).fail(function () {
            $messages.html('<p class="adminai-ac-empty">' + $t('Failed to load messages.') + '</p>');
        });
    }

    function setActiveSession(sessionId) {
        activeSessionId = Number(sessionId);
        renderSessions();

        var session = null;
        $.each(allSessions, function (_, s) {
            if (Number(s.session_id) === activeSessionId) { session = s; return false; }
        });

        if (session) {
            $headerTitle.text(session.title || ('Chat #' + session.session_id));
            var userLabel = session.admin_name
                ? session.admin_name + ' (' + session.admin_username + ')'
                : (session.admin_username || 'Unknown user');
            $headerUser.text(userLabel);
        }

        loadMessages(activeSessionId);
    }

    $search.on('input', function () { renderSessions(); });

    $container.on('click', '.adminai-ac-session-item', function () {
        var sid = Number($(this).data('session-id') || 0);
        if (sid) { setActiveSession(sid); }
    });

    loadSessions();
});
</script>
