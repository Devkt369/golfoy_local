    <script>
        function validateForm() {
            var selectedMonth = document.forms["f1"]["month"].value;
            var selectedDay = document.forms["f1"]["day"].value;
            var selectedYear = document.forms["f1"]["year"].value;

            // Check if February is selected and the year is a leap year
            if (selectedMonth === "02" && selectedDay === "29" && !isLeapYear(selectedYear)) {
                alert("The selected year is not a leap year. Please choose a valid date.");
                return false;
            }
            return true;
        }

        function isLeapYear(year) {
            return (year % 4 === 0 && year % 100 !== 0) || (year % 400 === 0);
        }

        function updateDays() {
            var selectedMonth = parseInt(document.forms["f1"]["month"].value);
            var selectedYear = parseInt(document.forms["f1"]["year"].value);
            var currentYear = new Date().getFullYear();
            var currentMonth = new Date().getMonth() + 1; // Adding 1 because getMonth() returns zero-based index
            var currentDay = new Date().getDate();

            // If the selected year is the current year, limit the months based on the current month
            if (selectedYear === currentYear) {
                var maxMonth = currentMonth;
            } else {
                var maxMonth = 12;
            }

            // If the selected month is greater than the maximum month allowed, reset it
            if (selectedMonth > maxMonth) {
                document.forms["f1"]["month"].value = maxMonth;
                selectedMonth = maxMonth;
            }

            // Get the maximum number of days for the selected month and year
            var maxDaysInMonth = new Date(selectedYear, selectedMonth, 0).getDate();

            // Clear previous options
            var daySelect = document.forms["f1"]["day"];
            daySelect.innerHTML = "";

            // Add new options
            for (var i = 1; i <= maxDaysInMonth; i++) {
                var option = document.createElement("option");
                option.value = ("0" + i).slice(-2); // Pad single digit numbers with leading zero
                option.text = ("0" + i).slice(-2); // Pad single digit numbers with leading zero
                daySelect.appendChild(option);
            }

            // If the selected year is the current year, limit the days based on the current day
            if (selectedYear === currentYear && selectedMonth === currentMonth) {
                var maxDay = currentDay;
                // If the selected day is greater than the maximum day allowed, reset it
                if (parseInt(document.forms["f1"]["day"].value) > maxDay) {
                    document.forms["f1"]["day"].value = maxDay;
                }
            }
        }
    </script>
