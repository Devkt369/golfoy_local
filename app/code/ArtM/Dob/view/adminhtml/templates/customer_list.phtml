function date_compare($element1, $element2)
{
    $datetime1 = strtotime($element1[3]);
    $datetime2 = strtotime($element2[3]);

    $monthDay1 = date('md', $datetime1);
    $monthDay2 = date('md', $datetime2);

    if ($monthDay1 == $monthDay2) {
        return 0;
    }

    return ($monthDay1 < $monthDay2) ? -1 : 1;
}

