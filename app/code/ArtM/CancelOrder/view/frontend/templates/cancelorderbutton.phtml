                    if (val != '') {
                        val = val.trim();
                        var length = val.length;
                        if (length < 11) {
                            jQuery.ajax({
                                url: "https://ifsc.razorpay.com/" + val,
                                type: "GET",
                                success: function(response) {
                                    ifscelmt.val('1');
