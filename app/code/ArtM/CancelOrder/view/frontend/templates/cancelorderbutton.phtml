                    // hide payment reverse method as well for return only
                    jQuery('.mode_of_return').addClass('hide');

                    //hide reason and photo section
                    jQuery('.input_fields.reason_and_photo').addClass('hide');


                    //hide agreement line
                    jQuery('.agree_statement').addClass('hide');

                    //uncheck return conset checkbox
                    if (jQuery('#return_consent').is(':checked')) {
                        jQuery('#return_consent').click();
                    }

                    //hide submit button
                    jQuery('input#crosubmit').addClass('hide');
                    jQuery('.error_return').addClass('hide');
                });


            });
        });
