                jQuery('.return_replace_button').click(function() {

                    var prd_checkbox = jQuery(this).attr('prd_checkbox');
                    var product_to_return_or_replace = jQuery('#' + prd_checkbox + '').val();

                    //check the checkbox of respective product
                    if (!jQuery('#' + prd_checkbox + '').is(':checked')) {
                        jQuery('#' + prd_checkbox + '').click();
