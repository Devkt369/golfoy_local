                        var refundAcc = jQuery("input[name='bankrefund']:checked").val();
                        var isreturnable = jQuery('#isreturnable').val();
                        if (refundAcc == 0 && isreturnable == '1') {
                            if (jQuery("#refund_bank_accnumber").val() == '' ||
                                jQuery("#refund_bank_confirmaccnumber").val() == '') {
                                jQuery("#refund_bank_accnumber").addClass('customError');
                                empty = true;
                            } else {
                                jQuery("#refund_bank_accnumber").removeClass('customError');
                            }

                            if (jQuery("#refund_bank_ifsccode").val() == '') {
                                jQuery("#refund_bank_ifsccode").addClass('customError');
                                empty = true;
                            } else {
                                jQuery("#refund_bank_ifsccode").removeClass('customError');
                            }


                            if (jQuery("#refund_bank_accnumber").val() !=
                                jQuery("#refund_bank_confirmaccnumber").val()) {
                                jQuery("#refund_bank_confirmaccnumber").addClass('customError');
                                error.push({
                                    'm': 'Account number does not match.'
                                });
                            } else {
                                jQuery("#refund_bank_confirmaccnumber").removeClass('customError');
                            }

                            var ifscelmtval = jQuery("#ifscverify").val();
                            if (ifscelmtval != '1') {
                                jQuery("#ifscverify").addClass('customError');
                                error.push({
                                    'v': 'ifsc code is not valid.'
                                });
                                'Account number does not match'
                            } else {
                                jQuery("#ifscverify").removeClass('customError');
                            }
                        }
                    }

                    if (jQuery("input[name='refund_type']:checked").val() == 'refund_upi') {
                        // Check if "Add New" is selected (value 0) or if no account selected (should not happen if checked by default but logic safety)
                        // Actually, if radios share name 'upi_refund_account_id', we just check the value
                        var selectedUpiAccount = jQuery("input[name='upi_refund_account_id']:checked").val();

                        if (selectedUpiAccount == '0') {
                            if (jQuery("#refund_upi_id").val() == '') {
                                jQuery("#refund_upi_id").addClass('customError');
                                empty = true;
                            } else {
                                // Simple regex for UPI ID validation (vpa)
                                var upiRegex = /^[\w.-]+@[\w.-]+$/;
                                if (!upiRegex.test(jQuery("#refund_upi_id").val())) {
                                    jQuery("#refund_upi_id").addClass('customError');
                                    error.push({
                                        'u': 'Please enter a valid UPI ID.'
                                    });
                                } else {
                                    jQuery("#refund_upi_id").removeClass('customError');
                                }
                            }
                        } else if (selectedUpiAccount === undefined) {
                            // If user hasn't selected any account (e.g. if they uncheck or something, though radio logic prevents easy uncheck without checking another)
                            // But since we have "Add New" with ID 0, one must be checked.
                            // If none checked, we might want to force check, but 'empty' check works.
                            // Add error if really nothing selected?
                            // Let's assume one is always checked by default if exists, or user must check.
                            if (jQuery("input[name='upi_refund_account_id']").length > 0) {
                                error.push({
                                    'u': 'Please select a UPI ID or add a new one.'
                                });
                            }
                        }
                    }

                    if (!jQuery('#return_consent').is(':checked')) {
                        jQuery("#return_consent").addClass('customError');
                        empty = true;
                    } else {
                        jQuery("#return_consent").removeClass('customError');
                    }

                    if (empty) {
                        error.push({
                            'e': 'Some required fields are empty.'
                        });
                    }

                    if (error.length == 0) {
                        jQuery('.error_return').html('');
                        jQuery('#crosubmit').prop("disabled", true);
                        jQuery('form#cancelcustomform').submit();
                    } else {
                        var errorstr = '';
                        jQuery.each(error, function(key, value) {
                            jQuery.each(value, function(k, v) {
                                errorstr = errorstr + v + '<br/>';
                            });
                        });
                        jQuery('.error_return').html(errorstr);
                        e.preventDefault();
                    }

