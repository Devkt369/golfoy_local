                });
                //--------------------refund type ---------------------------
                jQuery('input[name="refund_type"]').change(function() {
                    var selectedOption = jQuery(this).val();

                    if (selectedOption == "refund_bank") {
                        jQuery("#refund_bank_text").show();
                        jQuery("#refund_wallet_text").hide();
                        jQuery("#refund_source_text").hide();
                        jQuery("#refund_upi_text").hide();
                        jQuery("#refund_upi_content").hide();

                    } else if (selectedOption == "refund_source") {
                        jQuery("#refund_bank_text").hide();
                        jQuery("#refund_source_text").show();
                        jQuery("#refund_wallet_text").hide();
                        jQuery("#refund_upi_text").hide();
                    } else if (selectedOption == "refund_upi") {
                        jQuery("#refund_bank_text").hide();
                        jQuery("#refund_source_text").hide();
                        jQuery("#refund_wallet_text").hide();
                        // Show UPI content container
                        jQuery("#refund_upi_content").show();

                        // Check 'Add New' logic to show input if needed
                        var upiAcc = jQuery("input[name='upi_refund_account_id']:checked").val();
                        if (upiAcc == '0') {
                            jQuery("#refund_upi_text").show();
                        } else {
                            jQuery("#refund_upi_text").hide();
