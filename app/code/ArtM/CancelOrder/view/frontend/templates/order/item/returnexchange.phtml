     JAVASCRIPT
     ══════════════════════════════════════════════════════ -->
<script>
    require(['jquery'], function($) {

        /*
         * FIX: duplicate file-picker / double-event bug
         * ─────────────────────────────────────────────
         * This template renders once per order item, so on a multi-item page
         * there are N copies of this <script>.  Every copy was registering
         * the same delegated listeners on $(document), so with 3 items:
         *   • 3 × 'click .re-drag-inner'  → .trigger('click') fires 3× → picker opens 3×
         *   • 3 × 'change .review_media_input' → same file uploaded 3×
         *
         * Solution — two zones:
         *
         *  ZONE A  Item-specific listeners
         *          Bound to unique IDs (#firstreason_123, #crosubmit_123 …).
         *          Safe to re-register each render; use .off().on() to prevent
         *          double-bind if require() somehow executes twice for same item.
         *
         *  ZONE B  Shared / class-selector listeners
         *          Wrapped in  if (window._reSharedReady) return;
         *          Registered exactly once for the whole page.
         *          Derive the correct item scope at runtime from the event
         *          target (data-item attr, closest form id, etc.) so they
         *          work for every item without duplication.
         */

        /* ── Constants for this item ── */
        var itemId = "<?= $itemId ?>";

        /* ════════════════════════════════════════════════
           ZONE A — ITEM-SPECIFIC (safe to repeat, unique IDs)
           ════════════════════════════════════════════════ */

        function syncRefundHighlight() {
            $('#refund_box_' + itemId + ' .re-refund-option').each(function() {
                $(this).toggleClass('re-refund-selected',
                    $(this).find('input[type="radio"]').is(':checked'));
            });
        }

        /* Reason dropdown */
        $('#firstreason_' + itemId).off('change.re').on('change.re', function() {
            var val = $(this).val();
            if (val === 'show') {
                $('#inputField_' + itemId).show();
                $('#subfield_' + itemId).hide();
            } else if (val === '0') {
                $('#subfield_' + itemId).show();
                $('#inputField_' + itemId).hide();
            } else {
                $('#inputField_' + itemId).hide();
                $('#subfield_' + itemId).hide();
            }
        });

        /* IFSC live lookup */
        $('#refund_bank_ifsccode_' + itemId).off('keyup.re').on('keyup.re', function() {
            var val = $(this).val().toUpperCase();
            $(this).val(val);
            $('#ifscdetail_' + itemId).html('').removeClass('re-ifsc-valid re-ifsc-invalid');
            $('#ifscverify_' + itemId).val('0');
            if (val.length === 11) {
                $('#ifscdetail_' + itemId).html('<?= __('Verifying…') ?>');
                $.ajax({
                    url: 'https://ifsc.razorpay.com/' + val,
                    type: 'GET',
                    success: function(r) {
                        $('#ifscverify_' + itemId).val('1');
                        $('#refund_bank_name_' + itemId).val(r.BANK);
                        $('#refund_bank_branch_' + itemId).val(r.BRANCH);
                        $('#ifscdetail_' + itemId)
                            .addClass('re-ifsc-valid')
                            .html('&#10003; ' + r.BANK + ', ' + r.BRANCH);
                    },
                    error: function() {
                        $('#ifscdetail_' + itemId)
                            .addClass('re-ifsc-invalid')
                            .html('<?= __('Invalid IFSC code') ?>');
                    }
                });
            }
        });

        /* Submit validation */
        $('#crosubmit_' + itemId).off('click.re').on('click.re', function(e) {
            var $form = $('#cancelcustomform_' + itemId);
            var $err = $form.find('.error_return');
            $err.text('');

            var type = $('#return_cancel_status_' + itemId).val();

            if (type === 'return') {
                var refund = $form.find('input[name="refund_type"]:checked').val();

                if (refund === 'refund_bank') {
                    var $newFields = $('#new_bank_fields_' + itemId);
                    if ($newFields.is(':visible')) {
                        var acc1 = $('#refund_bank_accnumber_' + itemId).val();
                        var acc2 = $('#refund_bank_confirmaccnumber_' + itemId).val();
                        if (!acc1) {
                            $err.text('<?= __('Please enter account number.') ?>');
                            e.preventDefault();
                            return false;
                        }
                        if (acc1 !== acc2) {
                            $err.text('<?= __('Account numbers do not match.') ?>');
                            e.preventDefault();
                            return false;
                        }
                        if ($('#ifscverify_' + itemId).val() !== '1') {
                            $err.text('<?= __('Please enter a valid IFSC code.') ?>');
                            e.preventDefault();
                            return false;
                        }
                    }
                }

                if (refund === 'refund_upi') {
                    var upi = $('#refund_upi_id_' + itemId).val().trim();
                    var selectedUpiAcc = $form.find('input[name="upi_refund_account_id"]:checked').val();
                    if (selectedUpiAcc == '0' && (!upi || upi.indexOf('@') === -1)) {
                        $err.text('<?= __('Please enter a valid UPI ID.') ?>');
                        e.preventDefault();
                        return false;
                    }
                }
            }

            if (!$('#return_consent_' + itemId).is(':checked')) {
                $err.text('<?= __('Please confirm the product condition.') ?>');
                e.preventDefault();
                return false;
            }
        });

        /* Init highlight for this item */
        syncRefundHighlight();

        /* ════════════════════════════════════════════════
           ZONE B — SHARED  (registered once for whole page)
           ════════════════════════════════════════════════ */
        if (window._reSharedReady) return;
        window._reSharedReady = true;

        /* ── Shared helper: activates a tab by item ID ── */
        function activateTabForItem(iid) {
            var $active = $('.re-tab[data-item="' + iid + '"].active');
            if (!$active.length) $active = $('.re-tab[data-item="' + iid + '"]').first();
            if (!$active.length) return;
            applyTab(iid, $active.data('type'));
        }

        function applyTab(iid, type) {
            var infoSvg = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">' +
                '<circle cx="12" cy="12" r="10"/>' +
                '<line x1="12" y1="8" x2="12" y2="12"/>' +
                '<line x1="12" y1="16" x2="12.01" y2="16"/></svg>';
            $('.re-tab[data-item="' + iid + '"]').removeClass('active');
            $('.re-tab[data-item="' + iid + '"][data-type="' + type + '"]').addClass('active');
            $('#return_cancel_status_' + iid).val(type === 'replace' ? 'replacement' : 'return');
            if (type === 'replace') {
                $('#refund_box_' + iid).hide();
                $('#re_replace_info_' + iid).show();
                $('#re_note_' + iid).html(infoSvg + '<span><?= __('We will arrange a pickup and send a replacement.') ?></span>');
            } else {
                $('#refund_box_' + iid).show();
                $('#re_replace_info_' + iid).hide();
                $('#re_note_' + iid).html(infoSvg + '<span><?= __('Select your preferred refund method below.') ?></span>');
            }
        }

        /* Popup open — reads item ID from the data-popup attribute suffix */
        $(document).on('click.re', '.open-return-popup', function() {
            var pid = $(this).data('popup'); // "popup-return-123"
            var iid = pid.replace('popup-return-', ''); // "123"
            activateTabForItem(iid);
            $('#' + pid).show();
            $('body').addClass('re-popup-open');
        });

        /* Popup close — X button */
        $(document).on('click.re', '[data-popup-close]', function() {
            $('#' + $(this).data('popup-close')).hide();
            $('body').removeClass('re-popup-open');
        });

        /* Popup close — backdrop */
        $(document).on('click.re', '.re-overlay', function(e) {
            if ($(e.target).hasClass('re-overlay')) {
                $(this).hide();
                $('body').removeClass('re-popup-open');
            }
        });

        /* Tab click — item ID comes from data-item */
        $(document).on('click.re', '.re-tab', function() {
            applyTab($(this).data('item'), $(this).data('type'));
        });

        /* Refund type radio — derive item ID from the parent form's id */
        $(document).on('change.re', 'input[name="refund_type"]', function() {
            var iid = $(this).closest('form').attr('id').replace('cancelcustomform_', '');
            var val = $(this).val();
            $('#refund_bank_text_' + iid).hide();
            $('#refund_upi_content_' + iid).hide();
            if (val === 'refund_bank') $('#refund_bank_text_' + iid).show();
            if (val === 'refund_upi') $('#refund_upi_content_' + iid).show();
            /* sync highlight for this item */
            $('#refund_box_' + iid + ' .re-refund-option').each(function() {
                $(this).toggleClass('re-refund-selected',
                    $(this).find('input[type="radio"]').is(':checked'));
            });
        });

        /* UPI saved-account selector — item ID from data-item on the radio */
        $(document).on('change.re', 'input[name="upi_refund_account_id"]', function() {
            var iid = $(this).closest('form').attr('id').replace('cancelcustomform_', '');
            if ($(this).val() == '0') {
                $('#new_upi_fields_' + iid).show();
            } else {
                $('#new_upi_fields_' + iid).hide();
            }
        });

        /* Saved bank-account selector — already carries data-item */
        $(document).on('change.re', '.use-saved-bank', function() {
            var $t = $(this);
            var iid = $t.data('item');
            if ($t.val() === '0' || $t.data('accnum') === '') {
                $('#new_bank_fields_' + iid).show();
                $('#refund_bank_accnumber_' + iid).val('');
                $('#refund_bank_confirmaccnumber_' + iid).val('');
                $('#refund_bank_ifsccode_' + iid).val('');
                $('#ifscdetail_' + iid).html('');
                $('#ifscverify_' + iid).val('0');
                $('#refund_bank_name_' + iid).val('');
                $('#refund_bank_branch_' + iid).val('');
            } else {
                $('#new_bank_fields_' + iid).hide();
                $('#refund_bank_accnumber_' + iid).val($t.data('accnum'));
                $('#refund_bank_confirmaccnumber_' + iid).val($t.data('accnum'));
                $('#refund_bank_ifsccode_' + iid).val($t.data('ifsc'));
                $('#ifscverify_' + iid).val('1');
                $('#refund_bank_name_' + iid).val($t.data('bankname'));
                $('#refund_bank_branch_' + iid).val($t.data('branch'));
            }
        });

        /* ── FILE UPLOAD — the source of the original bug ──
         *
         * Previously registered inside require() with no guard → N copies on
         * document → one click on the drag area fired all N → file-picker
         * opened N times.
         *
         * Now inside the _reSharedReady guard → registered exactly once.
         * Each handler finds its scoped container via DOM traversal at
         * runtime, so it always targets the correct item.
         */
        $('html').on('dragover.re drop.re', function(e) {
            e.preventDefault();
            e.stopPropagation();
        });

        $(document).on('dragenter.re dragover.re', '.review-form-container .review-drag-area', function(e) {
            e.stopPropagation();
            e.preventDefault();
            $(this).addClass('re-drag-hover');
        });

        $(document).on('dragleave.re', '.review-form-container .review-drag-area', function() {
            $(this).removeClass('re-drag-hover');
        });

        $(document).on('drop.re', '.review-form-container .review-drag-area', function(e) {
            e.stopPropagation();
            e.preventDefault();
            $(this).removeClass('re-drag-hover');
            handleFiles(e.originalEvent.dataTransfer.files, $(this).closest('.review-form-container'));
        });

        /* KEY FIX ↓  one listener; scoped find targets only this item's input */
        $(document).on('click.re', '.re-drag-area .re-drag-inner', function() {
            $(this).closest('.re-drag-area').find('.review_media_input').trigger('click');
        });

        /* KEY FIX ↓  one listener; processes whichever item's input changed */
        $(document).on('change.re', '.review_media_input', function() {
            handleFiles($(this)[0].files, $(this).closest('.review-form-container'));
            $(this).val('');
        });

        $(document).on('click.re', '.review-form-container .review-img-cross', function() {
            var $el = $(this).parent('.review-resultimg');
            var container = $(this).closest('.review-form-container');
            /* Read order increment ID from the form, not from a PHP-inlined constant */
            var oid = container.closest('form').find('input[name="order_id"]').val() || '';
            $.ajax({
                url: '/cancelorder/index/deleteajaxupload',
                type: 'POST',
                data: {
                    path: 'return_image/' + oid + $(this).attr('rel')
                },
                dataType: 'json',
                success: function() {
                    $el.remove();
                    container.find('.media_field_error').hide();
                }
            });
        });

        function handleFiles(files, container) {
            var existing = container.find('.review-resultimg').length;
            if (existing + files.length > 5) {
                container.find('.media_field_error').show();
                return;
            }
            container.find('.media_field_error').hide();
            for (var i = 0; i < files.length; i++) {
                var fd = new FormData();
                fd.append('files[]', files[i]);
                uploadFile(fd, container);
            }
        }

        function uploadFile(fd, container) {
            /* Read order increment ID from the form's own hidden field */
            var oid = container.closest('form').find('input[name="order_id"]').val() || '';
            $.ajax({
                url: '/cancelorder/index/ajaxupload?orderid=' + oid,
                type: 'POST',
                cache: false,
                contentType: false,
                processData: false,
                data: fd,
                dataType: 'json',
                success: function(res) {
                    if (res.path) {
                        var html = '<div class="review-resultimg">' +
                            '<img src="/media/return_image/' + oid + res.path + '" alt="">' +
                            '<div class="review-img-cross" rel="' + res.path + '">&#10006;</div>' +
                            '<input type="hidden" name="review_media_files[]" value="' + res.path + '">' +
                            '</div>';
                        $(html).insertBefore(container.find('.re-drag-inner'));
                    }
                }
            });
        }

    }); /* end require */
</script>


