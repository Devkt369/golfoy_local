<?php

/**
 * Item Wise Return / Exchange Popup
 *
 * Data passed in:
 *   $block->getOrder()             → order object
 *   $block->getItem()              → order item object
 *   $block->getData('delivered_date') → e.g. "28 May 2026"
 *
 * Return vs Replacement is chosen by the customer inside the popup (tab toggle).
 * The chosen value is written to the hidden field [return_cancel_status] before submit.
 *
 * Refund modes:
 *   COD   → Golfoy Wallet | UPI | Bank Transfer  (bank shows saved accounts first)
 *   Other → Golfoy Wallet | Same payment method (label = readable method name)
 */

$order              = $block->getOrder();
$_item              = $block->getItem();
$_itemDeliveredDate = $block->getData('delivered_date'); // "28 May 2026"
// var_dump($_itemDeliveredDate);
if (!$_itemDeliveredDate) {
    return;
}

if (!$order || !$_item) {
    return;
}

$itemId    = $_item->getItemId();
$productId = $_item->getProductId();

/* ── Resolve simple product ID for configurable ── */
if ($_item->getProductType() == 'configurable') {
    foreach ($order->getAllItems() as $orderItem) {
        if ($orderItem->getParentItemId() == $_item->getItemId()) {
            $productId = $orderItem->getProductId();
            break;
        }
    }
}

/* ── Disable check (bundled / custom-option products) ── */
if (!$block->returnExchangedisable($_item)) {
    return;
}

/* ═══════════════════════════════════════════════════════════
   EXISTING REQUEST CHECK
   ═══════════════════════════════════════════════════════════ */
$existingRequest = $block->getReturnExchangeStatus($order->getId(), $productId);

if ($existingRequest) {
    $reqType    = ucfirst($existingRequest['status']);
    $reqCurrent = ucfirst(str_replace('_', ' ', $existingRequest['current_status']));
?>
    <div class="already-requested">
        <span class="req-type-badge req-type-<?= strtolower($existingRequest['status']) ?>">
            <?= __($reqType) ?>
        </span>
        <strong><?= __($reqCurrent) ?></strong>
    </div>
<?php
    return;
}

/* ═══════════════════════════════════════════════════════════
   PRODUCT POLICY ATTRIBUTES
   ═══════════════════════════════════════════════════════════ */
$_product          = $_item->getProduct();
$isReturnable      = (bool) $_product->getData('returnable');
$replacementPolicy = (int)  $_product->getData('replacement_policy');

$replacementDays = 0;
switch ($replacementPolicy) {
    case 1399:
        $replacementDays = 7;
        break;
    case 3690:
        $replacementDays = 30;
        break;
    default:
        $replacementDays = 0;
        break;
}
$returnWindowDays = $isReturnable ? 7 : 0;

/* ── Window calculator ── */
$deliveredDate = \DateTime::createFromFormat('d M Y', $_itemDeliveredDate)
    ?: new \DateTime($_itemDeliveredDate);

$calcWindow = function ($days) use ($deliveredDate) {
    if ($days <= 0 || !$deliveredDate) return false;
    $close = (clone $deliveredDate)->modify("+{$days} days");
    $diff  = (int)(new \DateTime('today'))->diff($close)->format('%r%a');
    return ['closes_on' => $close->format('d M Y'), 'days_left' => $diff, 'open' => $diff > 0]; // was >= 0
};

$returnWindow      = $calcWindow($returnWindowDays);
$replacementWindow = $calcWindow($replacementDays);

$returnOpen      = $returnWindow      && $returnWindow['open'];
$replacementOpen = $replacementWindow && $replacementWindow['open'];
$anyWindowOpen   = $returnOpen || $replacementOpen;

/* ═══════════════════════════════════════════════════════════
   PAYMENT METHOD
   ═══════════════════════════════════════════════════════════ */
$payment           = $order->getPayment();
$paymentmethodcode = $payment->getMethod();
$isCOD             = ($paymentmethodcode === 'cashondelivery');

$paymentMethodLabels = [
    'razorpay'          => 'Razorpay (Online)',
    'payu'              => 'PayU',
    'ccavenue'          => 'CCAvenue',
    'stripe_payments'   => 'Credit / Debit Card',
    'paypal_express'    => 'PayPal',
    'free'              => 'Free / Zero Value',
];
$paymentLabel = $paymentMethodLabels[$paymentmethodcode]
    ?? ucwords(str_replace(['_', 'payment', 'method'], [' ', '', ''], $paymentmethodcode));

/* ═══════════════════════════════════════════════════════════
   SESSION & SAVED BANK / UPI ACCOUNTS
   ═══════════════════════════════════════════════════════════ */
$customerId     = $order->getCustomerId();
$customerName   = $order->getCustomerName();
$customerEmail  = $order->getCustomerEmail();
$return_orderId = $order->getIncrementId();

$bankAccounts = [];
$upiAccounts  = [];

if ($customerId) {
    $bankAccounts = $block->getAccounts($customerId, 'refund_bank') ?: [];
    $upiAccounts  = $block->getAccounts($customerId, 'refund_upi')  ?: [];
}
