<?xml version="1.0" encoding="UTF-8"?>

<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">cancelorderrequest_cancelrequest_listing.cancelorderrequest_cancelrequest_listing_data_source</item>
            <item name="deps" xsi:type="string">cancelorderrequest_cancelrequest_listing.cancelorderrequest_cancelrequest_listing_data_source</item>
        </item>
        <!-- <item name="spinner" xsi:type="string" >cancelorderrequest_cancelrequest_columns</item> -->
    </argument>
    <settings>
      <!--   <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add New Block</label>
            </button>
        </buttons> -->
        <spinner>cancelorderrequest_cancelrequest_columns</spinner>
        <deps>
            <dep>cancelorderrequest_cancelrequest_listing.cancelorderrequest_cancelrequest_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="cancelorderrequest_cancelrequest_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>ArtM_CancelOrder::cancelorder</aclResource>
        <dataProvider class="Magento\Cms\Ui\Component\DataProvider" name="cancelorderrequest_cancelrequest_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters">
            <settings>
                <templates>
                    <filters>
                        <select>
                            <param name="template" xsi:type="string">ui/grid/filters/elements/ui-select</param>
                            <param name="component" xsi:type="string">Magento_Ui/js/form/element/ui-select</param>
                        </select>
                    </filters>
                </templates>
            </settings>
            <filterSelect name="store_id" provider="${ $.parentName }">
                <settings>
                    <captionValue>0</captionValue>
                    <options class="Magento\Cms\Ui\Component\Listing\Column\Cms\Options"/>
                    <label translate="true">Store View</label>
                    <dataScope>store_id</dataScope>
                    <imports>
                        <link name="visible">componentType = column, index = ${ $.index }:visible</link>
                    </imports>
                </settings>
            </filterSelect>
        </filters>
        <massaction name="listing_massaction">
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Are you sure you want to delete selected items?</message>
                        <title translate="true">Delete items</title>
                    </confirm>
                    <url path="cms/block/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
            <action name="edit">
                <settings>
                    <callback>
                        <target>editSelected</target>
                        <provider>cancelorderrequest_cancelrequest_listing.cancelorderrequest_cancelrequest_listing.cancelorderrequest_cancelrequest_columns_editor</provider>
                    </callback>
                    <type>edit</type>
                    <label translate="true">Edit</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="cancelorderrequest_cancelrequest_columns">
        <settings>
            <editorConfig>
                <param name="clientConfig" xsi:type="array">
                    <item name="saveUrl" xsi:type="url" path="cms/block/inlineEdit"/>
                    <item name="validateBeforeSave" xsi:type="boolean">false</item>
                </param>
                <param name="indexField" xsi:type="string">id</param>
                <param name="enabled" xsi:type="boolean">true</param>
                <param name="selectProvider" xsi:type="string">cancelorderrequest_cancelrequest_listing.cancelorderrequest_cancelrequest_listing.cancelorderrequest_cancelrequest_columns.ids</param>
            </editorConfig>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">cancelorderrequest_cancelrequest_listing.cancelorderrequest_cancelrequest_listing.cancelorderrequest_cancelrequest_columns_editor</item>
                    <item name="target" xsi:type="string">startEdit</item>
                    <item name="params" xsi:type="array">
                        <item name="0" xsi:type="string">${ $.$data.rowIndex }</item>
                        <item name="1" xsi:type="boolean">true</item>
                    </item>
                </param>
            </childDefaults>
        </settings>
        <selectionsColumn name="id">
            <settings>
                <indexField>id</indexField>
            </settings>
        </selectionsColumn>
        <column name="id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>
        <column name="order_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Order ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>
        <column name="order_state">
            <settings>
                <filter>text</filter>
                <editor>
                    <validation>
                        <rule name="required-entry" xsi:type="string">true</rule>
                    </validation>
                    <editorType>text</editorType>
                </editor>
                <label translate="true">Order State </label>
            </settings>
        </column>
        <column name="order_status">
            <settings>
                <filter>text</filter>
                <editor>
                    <validation>
                        <rule name="required-entry" xsi:type="string">true</rule>
                    </validation>
                    <editorType>text</editorType>
                </editor>
                <label translate="true">Order Status</label>
            </settings>
        </column>
         <column name="live_status" class="ArtM\CancelOrder\Ui\Component\Listing\Column\TheliveStatus">
            <settings>
                <filter>text</filter>
                <editor>
                    <validation>
                        <rule name="required-entry" xsi:type="string">true</rule>
                    </validation>
                    <editorType>text</editorType>
                </editor>
                <label translate="true">Live Order Status</label>
            </settings>
        </column>
         <!-- <column name="live_state">
            <settings>
                <filter>text</filter>
                <editor>
                    <validation>
                        <rule name="required-entry" xsi:type="string">true</rule>
                    </validation>
                    <editorType>text</editorType>
                </editor>
                <label translate="true">Live Order State</label>
            </settings>
        </column> -->
         <column name="return_cancel_status">
            <settings>
                <filter>text</filter>
                <editor>
                    <validation>
                        <rule name="required-entry" xsi:type="string">true</rule>
                    </validation>
                    <editorType>text</editorType>
                </editor>
                <label translate="true">Return Cancel Status</label>
            </settings>
        </column>
         <column name="return_reason">
            <settings>
                <filter>text</filter>
                <editor>
                    <validation>
                        <rule name="required-entry" xsi:type="string">true</rule>
                    </validation>
                    <editorType>text</editorType>
                </editor>
                <label translate="true">Reason to Return</label>
            </settings>
        </column>
        <column name="return_reason">
            <settings>
                <filter>text</filter>
                <editor>
                    <validation>
                        <rule name="required-entry" xsi:type="string">true</rule>
                    </validation>
                    <editorType>text</editorType>
                </editor>
                <label translate="true">Reason to Return</label>
            </settings>
        </column>
        <column name="customer_name">
            <settings>
                <filter>text</filter>
                <editor>
                    <validation>
                        <rule name="required-entry" xsi:type="string">true</rule>
                    </validation>
                    <editorType>text</editorType>
                </editor>
                <label translate="true">Customer Name</label>
            </settings>
        </column>
        
        <column name="customer_phone">
            <settings>
                <filter>text</filter>
                <editor>
                    <validation>
                        <rule name="required-entry" xsi:type="string">true</rule>
                    </validation>
                    <editorType>text</editorType>
                </editor>
                <label translate="true">Customer Phone</label>
            </settings>
        </column>
        <column name="customer_email">
            <settings>
                <filter>text</filter>
                <editor>
                    <validation>
                        <rule name="required-entry" xsi:type="string">true</rule>
                    </validation>
                    <editorType>text</editorType>
                </editor>
                <label translate="true">Customer Email</label>
            </settings>
        </column>
         <column name="product_ids">
            <settings>
                <filter>text</filter>
                <editor>
                    <validation>
                        <rule name="required-entry" xsi:type="string">true</rule>
                    </validation>
                    <editorType>text</editorType>
                </editor>
                <label translate="true">Product Ids</label>
            </settings>
        </column>
        
        
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Created</label>
            </settings>
        </column>
        <column name="liveaction" class="ArtM\CancelOrder\Ui\Component\Listing\Column\MemberAction">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="bodyTmpl" xsi:type="string">ui/grid/cells/html</item>
                    <item name="link" xsi:type="string" translate="true">link</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Open Order</label>
                <sortable>false</sortable>
            </settings>
        </column>
        
    </columns>
</listing>
