<script>
    require([
        'jquery'
    ], function($) {
        $(window).scroll(function() {
            $('.b_o_s').children('.pa_re').each(function() {
                var curr_div_top_height = $(this).offset().top;
                var curr_div_top_height_outer = $(this).outerHeight();
                var window_height = $(window).height();
                var scroll_top = $(window).scrollTop();
                if (scroll_top > (curr_div_top_height + curr_div_top_height_outer - window_height + 100)) {
                    $(this).addClass("opened");
                }
            });

        });
    });
</script>

<script>
    // JavaScript for the slider functionality on mobile
    if (window.innerWidth <= 767) {
        const slider = document.querySelector('.shoes_six_blocks');
        let translateValue = 0;

        function slide(direction) {
            const itemWidth = slider.clientWidth / 3;
            translateValue += direction * itemWidth;
            translateValue = Math.min(0, Math.max(-itemWidth * 2, translateValue)); // Limit translation
            slider.style.transform = `translateX(${translateValue}px)`;
        }

        document.querySelector('.shoes_blocks_div').addEventListener('mousedown', (e) => {
            let startX = e.clientX;
            const onMouseMove = (e) => {
                const deltaX = e.clientX - startX;
                if (Math.abs(deltaX) > 20) {
                    slide(deltaX > 0 ? -1 : 1);
                    startX = e.clientX;
                }
            };
            const onMouseUp = () => {
                document.removeEventListener('mousemove', onMouseMove);
                document.removeEventListener('mouseup', onMouseUp);
            };

            document.addEventListener('mousemove', onMouseMove);
            document.addEventListener('mouseup', onMouseUp);
        });
    }
</script>

<script>
    require([
        'jquery'
    ], function($) {
        toggleEditor('form1', 'result1');
        toggleEditor('form2', 'result2');
        toggleEditor('form3', 'result3');
        toggleEditor('form31', 'result31');
        toggleEditor('form4', 'result4');
        toggleEditor('form5', 'result5');
        toggleEditor('form51', 'result51');
        toggleEditor('form6', 'result6');
        toggleEditor('form7', 'result7');
        toggleEditor('form8', 'result8');
        toggleEditor('form9', 'result9');
        toggleEditor('form01', 'result01');
        toggleEditor('form011', 'result011');
        toggleEditor('form02', 'result02');
        toggleEditor('form03', 'result03');
        toggleEditor('form04', 'result04');


        function toggleEditor(formId, resultId) {
            var form = $('#' + formId);
            var textarea = form.find('textarea');
            var resultContainer = $('#' + resultId);

            if (textarea.is(':visible')) {
                // Switch to HTML code view
                resultContainer.html(textarea.val());
                textarea.show();
                resultContainer.show();
            } else {
                // Switch to WYSIWYG editor
                textarea.val(resultContainer.html());
                textarea.show();
                resultContainer.show();
            }
        }
    });
</script>

<script>
    function copyCode(textareaId) {
        var textarea = document.getElementById(textareaId);
        textarea.select();
        document.execCommand('copy');
        alert('Code copied to clipboard!');
    }
</script>