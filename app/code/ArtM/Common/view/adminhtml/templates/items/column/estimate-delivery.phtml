 
<?php 
 if ($_item = $block->getItem()):
    $_product = $_item->getProduct();
    $order = $_item->getOrder();
    if($_product){
        $shippingDays = $_product->getAttributeText('shippingdays');
        $dispatch = $_product->getAttributeText('dispatch');
        $estimationAfter = (int)$shippingDays + (int)$dispatch;
        $capturedDate = $order->getCreatedAt();
        $date = new DateTime($capturedDate);
        $date->modify("+{$estimationAfter} days");
        $formattedDate = $date->format('l, jS F Y');
    
        echo "<div style='font-weight: 600;'>Estimated delivery by <span style='color: #e60023;'>".htmlspecialchars($formattedDate, ENT_QUOTES, 'UTF-8')."</span></div>";
    }
    endif;
?>