<?php

namespace ArtM\Common\Controller\Customer;

use Magento\Framework\App\Action\Action;
use Magento\Framework\App\Action\Context;
use Magento\Framework\Controller\Result\JsonFactory;
use Magento\Customer\Model\Session as CustomerSession;
use Mageplaza\RewardPoints\Helper\Account as AccountHelper;

class Data extends Action
{
    protected $resultJsonFactory;
    protected $customerSession;
    protected $accountHelper;

    public function __construct(
        Context $context,
        JsonFactory $resultJsonFactory,
        CustomerSession $customerSession,
        AccountHelper $accountHelper
    ) {
        parent::__construct($context);
        $this->resultJsonFactory = $resultJsonFactory;
        $this->customerSession  = $customerSession;
        $this->accountHelper    = $accountHelper;
    }

    public function execute()
    {
        $result = $this->resultJsonFactory->create();
        $request = $this->getRequest();

        $needAccount = (bool) $request->getParam('account', false);
        $needLoggedIn = (bool) $request->getParam('logged_in', false);
        $needPoints  = (bool) $request->getParam('points', false);
        //  if params is not set, it will return all data
        if (!$needAccount && !$needLoggedIn && !$needPoints) {
            $needAccount = true;
            $needLoggedIn = true;
            $needPoints = true;
        }

        if ($needLoggedIn && !$this->customerSession->isLoggedIn()) {
            return $result->setData([
                'logged_in' => false
            ]);
        }

        if($needLoggedIn){
            $response = [
                'logged_in' => $this->customerSession->isLoggedIn()
            ];
        }

        if ($needAccount) {
            $customer = $this->customerSession->getCustomer();
            $response['name'] = $customer->getFirstname();
        }

        if ($needPoints) {
            $customerId = $this->customerSession->getCustomerId();
            $account = $this->accountHelper->getByCustomerId($customerId);
            $response['balance'] = (int) $account->getBalance();
        }

        return $result->setData($response);
    }
}
