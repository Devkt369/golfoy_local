<?php
namespace ArtM\Common\Controller\Index;

use ArtM\Common\Block\Productpriceblock;
use Magento\Catalog\Model\ResourceModel\Product\CollectionFactory as ProductCollectionFactory;

use Magento\Framework\App\Action\Action;
use Magento\Framework\App\Action\Context;

use Magento\Framework\Controller\ResultFactory;
use Magento\Framework\App\RequestInterface;
use Magento\Framework\App\Request\Http as HttpRequest;
use Magento\Framework\Controller\Result\JsonFactory;
use Magento\Framework\App\CsrfAwareActionInterface;
use Magento\Framework\App\Request\InvalidRequestException;
use Magento\Framework\App\Config\ScopeConfigInterface;
use Magento\InventoryApi\Api\GetSourceItemsBySkuInterface;

class BulkProductData extends Action implements CsrfAwareActionInterface
{
    /** @var JsonFactory */
    protected $resultJsonFactory;
    /** @var ScopeConfigInterface */
    protected $scopeConfig;
    /** @var GetSourceItemsBySkuInterface */
    protected $getSourceItemsBySku;

    protected $productPriceBlock;
    protected $productCollectionFactory;

    public function __construct(
        Context $context,
        JsonFactory $resultJsonFactory,
        ScopeConfigInterface $scopeConfig,
        GetSourceItemsBySkuInterface $getSourceItemsBySku,
        ProductCollectionFactory $productCollectionFactory,
        Productpriceblock $productPriceBlock
    ) {
        $this->resultJsonFactory = $resultJsonFactory;
        $this->scopeConfig = $scopeConfig;
        $this->getSourceItemsBySku = $getSourceItemsBySku;
        $this->productCollectionFactory = $productCollectionFactory;
        $this->productPriceBlock = $productPriceBlock;
        parent::__construct($context);
    }

    public function execute()
    {
        /** @var HttpRequest $request */
        $request = $this->getRequest();
        $resultJson = $this->resultJsonFactory->create();

        if ($request->getMethod() !== 'POST') {
            return $resultJson->setData(['error' => 'Invalid request method']);
        }

        $data = json_decode($request->getContent(), true);
        if (!is_array($data)) {
            return $resultJson->setData(['error' => 'Invalid JSON payload']);
        }

        $skus = isset($data['skus']) ? $data['skus'] : [];
        $productIds = isset($data['product_ids']) ? $data['product_ids'] : [];
        $getFeaturedAttrs = isset($data['get_featured_attrs']) ? $data['get_featured_attrs'] : false;
        $featuredAttrsConfig = isset($data['featured_attrs_config']) ? $data['featured_attrs_config'] : '';

        $customOptions = [];
        $expressDelivery = [];
        $sizes = [];
        $featuredAttrs = [];

        // Batch load all products by IDs and SKUs
        $allProductIds = array_unique(array_merge($productIds, []));
        $skuToId = [];
        
        // Parse featured attributes config
        $featuredAttrsMapping = [];
        if ($getFeaturedAttrs && $featuredAttrsConfig) {
            $pairs = explode('|', $featuredAttrsConfig);
            foreach ($pairs as $pair) {
                $parts = explode(':', $pair);
                if (count($parts) === 2) {
                    $featuredAttrsMapping[trim($parts[0])] = trim($parts[1]);
                }
            }
        }
        if (!empty($skus)) {
            $productCollection = $this->productCollectionFactory->create();
            $productCollection->addAttributeToSelect(['can_print'])
                ->addAttributeToSelect('sku')
                ->addAttributeToSelect('custom_options')
                ->addAttributeToSelect('attribute_set_id');
            
            // Add featured attributes to selection if needed
            if ($getFeaturedAttrs && !empty($featuredAttrsMapping)) {
                foreach ($featuredAttrsMapping as $attrSetName => $attrCode) {
                    $productCollection->addAttributeToSelect($attrCode);
                }
            }
            
            $productCollection->addAttributeToSelect('*')
                ->addFieldToFilter('sku', ['in' => $skus]);
            foreach ($productCollection as $product) {
                $skuToId[$product->getSku()] = $product->getId();
                if (!in_array($product->getId(), $allProductIds)) {
                    $allProductIds[] = $product->getId();
                }
            }
        }
        if (!empty($productIds)) {
            $productCollection = $this->productCollectionFactory->create();
            $productCollection->addAttributeToSelect(['can_print'])
                ->addAttributeToSelect('sku')
                ->addAttributeToSelect('custom_options')
                ->addAttributeToSelect('attribute_set_id');
            
            // Add featured attributes to selection if needed  
            if ($getFeaturedAttrs && !empty($featuredAttrsMapping)) {
                foreach ($featuredAttrsMapping as $attrSetName => $attrCode) {
                    $productCollection->addAttributeToSelect($attrCode);
                }
            }
            
            $productCollection->addAttributeToSelect('*')
                ->addFieldToFilter('entity_id', ['in' => $productIds]);
            foreach ($productCollection as $product) {
                $skuToId[$product->getSku()] = $product->getId();
            }
        }

        // Load all products in one go
        $allProducts = [];
        $attributeSetRepository = null;
        if (!empty($allProductIds)) {
            $productCollection = $this->productCollectionFactory->create();
            $productCollection->addAttributeToSelect(['can_print'])
                ->addAttributeToSelect('sku')
                ->addAttributeToSelect('custom_options')
                ->addAttributeToSelect('attribute_set_id');
            
            // Add featured attributes to selection if needed
            if ($getFeaturedAttrs && !empty($featuredAttrsMapping)) {
                foreach ($featuredAttrsMapping as $attrSetName => $attrCode) {
                    $productCollection->addAttributeToSelect($attrCode);
                }
                // Get attribute set repository for name mapping
                $objectManager = \Magento\Framework\App\ObjectManager::getInstance();
                $attributeSetRepository = $objectManager->get(\Magento\Eav\Api\AttributeSetRepositoryInterface::class);
            }
            
            $productCollection->addAttributeToSelect('*')
                ->addFieldToFilter('entity_id', ['in' => $allProductIds]);
            foreach ($productCollection as $product) {
                $allProducts[$product->getId()] = $product;
            }
        }

        // Process customOptions and sizes in one loop
        $objectManager = \Magento\Framework\App\ObjectManager::getInstance();
        $productRepository = $objectManager->get(\Magento\Catalog\Api\ProductRepositoryInterface::class);
        foreach ($allProductIds as $productId) {
            $hasOptions = false;
            $allFree = true;
            $totalOptions = 0;
            $sizesValue = '';
            if (isset($allProducts[$productId])) {
                $product = $allProducts[$productId];
                $canPrint = $product->getData('can_print');
                // Reload product fully for options
                try {
                    $fullProduct = $productRepository->getById($productId);
                } catch (\Exception $e) {
                    $fullProduct = $product;
                }
                if ($canPrint) {
                    $options = $fullProduct->getOptions();
                    if (is_array($options) && count($options) > 0) {
                        $hasOptions = true;
                        $totalOptions = count($options);
                        foreach ($options as $option) {
                            $price = (float)$option->getPrice();
                            if ($price > 0) {
                                $allFree = false;
                                break;
                            }
                        }
                    }
                } else {
                    $hasOptions = false;
                    $allFree = false;
                    $totalOptions = 0;
                }
                // Sizes
                $sizeData = $this->productPriceBlock->getSizerollfromDb($productId);
                $sizesValue = isset($sizeData['available_size_roll_value']) ? $sizeData['available_size_roll_value'] : '';
                
                // Featured attributes
                if ($getFeaturedAttrs && !empty($featuredAttrsMapping) && $attributeSetRepository) {
                    try {
                        $attributeSet = $attributeSetRepository->get($product->getAttributeSetId());
                        $attributeSetName = strtolower($attributeSet->getAttributeSetName());
                        
                        if (isset($featuredAttrsMapping[$attributeSetName])) {
                            $attrCode = $featuredAttrsMapping[$attributeSetName];
                            $attrValue = $product->getAttributeText($attrCode);
                            if (!$attrValue) {
                                $attrValue = $product->getData($attrCode);
                            }
                            
                            if ($attrValue && $attrValue !== '0' && $attrValue !== 0 && !empty($attrValue)) {
                                // Get attribute label
                                $attr = $product->getResource()->getAttribute($attrCode);
                                $attrLabel = $attr ? $attr->getStoreLabel() : ucfirst(str_replace('_', ' ', $attrCode));
                                
                                $featuredAttrs[$productId] = [
                                    'attrName' => $attrCode,
                                    'attrLabel' => $attrLabel,
                                    'attrValue' => $attrValue,
                                    'attributeSetName' => $attributeSetName
                                ];
                            }
                        }
                    } catch (\Exception $e) {
                        // Skip if attribute set not found
                    }
                }
            }
            $customOptions[$productId] = [
                'hasOptions' => $hasOptions,
                'allFree' => $allFree,
                'totalOptions' => $totalOptions
            ];
            // Map sizes to SKU if possible
            foreach ($skuToId as $sku => $id) {
                if ($id == $productId) {
                    $sizes[$sku] = $sizesValue;
                }
            }
        }

        // Express Delivery logic from EstimateDelivery
        $ownSources = $this->scopeConfig->getValue(
            'artm_estimatedelivery/own_source/all_source',
            \Magento\Store\Model\ScopeInterface::SCOPE_STORE
        );
        $ownSourcesArr = $ownSources ? array_map('trim', explode(',', $ownSources)) : [];

        if (!empty($skus)) {
            foreach ($skus as $sku) {
                $isExpress = false;
                try {
                    $sourceItems = $this->getSourceItemsBySku->execute($sku);
                    foreach ($sourceItems as $item) {
                        if (in_array($item->getSourceCode(), $ownSourcesArr) && $item->getQuantity() > 0) {
                            $isExpress = true;
                            break;
                        }
                    }
                } catch (\Exception $e) {
                    $isExpress = false;
                }
                $expressDelivery[$sku] = $isExpress;
            }
        }

        $response = [
            'customOptions' => $customOptions,
            'expressDelivery' => $expressDelivery,
            'sizes' => $sizes
        ];
        
        // Add featured attributes to response if requested
        if ($getFeaturedAttrs) {
            $response['featuredAttrs'] = $featuredAttrs;
        }

        return $resultJson->setData($response);
    }

    public function createCsrfValidationException(RequestInterface $request): ?InvalidRequestException
    {
        return null;
    }

    public function validateForCsrf(RequestInterface $request): ?bool
    {
        return true;
    }
}
