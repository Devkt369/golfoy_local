<script type="text/javascript">
    require(['jquery', 'bootstrap'], function(jQuery) {
        jQuery(document).on("click", ".attribute-set-button", function() {
            var rel = jQuery(this).attr("rel");
            var type = jQuery(this).attr("type");
            var el = jQuery(this);
            el.text('Processing');
            el.removeClass('btn-primary').addClass('btn-info');
            jQuery.ajax({
                url: "/recommendedfilter/reindex/ajaxcron",
                type: "POST",
                data: {
                    rel: rel,
                    type: type
                },
                dataType: 'json',
                showLoader: true,
                success: function(res) {
                    if (res.result) {
                        el.text('Complete');
                        el.removeClass('btn-info').addClass('btn-success');
                    } else {
                        el.text('Processing');
                        el.removeClass('btn-info').addClass('btn-danger');
                    }
                }
            });
        });
        jQuery(document).on("click", "#setsortingpoints", function() {           
            var el = jQuery(this);
            el.text('Processing');
            el.removeClass('btn-primary').addClass('btn-info');
            jQuery.ajax({
                url: "/recommendedfilter/reindex/ajaxsetpts",
                dataType: 'json',
                showLoader: true,
                success: function(res) {
                    if (res.result) {
                        el.text('Complete');
                        el.removeClass('btn-info').addClass('btn-success');
                    } else {
                        el.text('Processing');
                        el.removeClass('btn-info').addClass('btn-danger');
                    }
                }
            });
        });
        jQuery(document).on("click", "#updation", function() {           
            var el = jQuery(this);
            el.text('Processing');
            el.removeClass('btn-primary').addClass('btn-info');
            jQuery.ajax({
                url: "/recommendedfilter/reindex/updatepoints",
                dataType: 'json',
                showLoader: true,
                success: function(res) {
                    if (res.result) {
                        el.text('Complete');
                        el.removeClass('btn-info').addClass('btn-success');
                    } else {
                        el.text('Processing');
                        el.removeClass('btn-info').addClass('btn-danger');
                    }
                }
            });
        });
    });
</script>