if(isset($_GET['pin']) && $_GET['pin'] == 'Gol_Artamis_Dev1'){

$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$helper = $this->helper('ArtM\RecommendedFilter\Helper\Data');
$attributeSetCollection = $objectManager->create('Magento\Eav\Model\ResourceModel\Entity\Attribute\Set\CollectionFactory')->create();
$attributeSetCollection->addFieldToFilter('entity_type_id', 4);
$attributeSetCollection->setOrder('attribute_set_name', 'ASC');
echo "<div class=\"crone_form\">";
foreach ($attributeSetCollection as $attributeSet) {
    $lastCron = $helper->CronLogStatus($attributeSet->getAttributeSetId());
    $btnclss = 'btn-primary';
    $btntxt = 'Run Cron';
    $lastupdated = "";
    
    if (!empty($lastCron)) {

        if ($lastCron['status'] == 'processing') {
            $btnclss = 'btn-danger';
            $btntxt = 'Processing';
        } elseif ($lastCron['status'] == 'compelete') {
            $btnclss = 'btn-success';
            $btntxt = 'Compelete';
        }
        $lastupdated = $lastCron['cron_last_updated_date_time'];
    }
    if($lastupdated !=''){
        $objdate = new DateTime($lastupdated);
        $objdate->setTimezone(new DateTimeZone('Asia/Kolkata')); 
        $lastupdateddate = $objdate->format('M d, Y, h:i:s A');
        $lastupdateddate = "updated: ".$lastupdateddate;

    }else{
        $lastupdateddate ='';
    }
    

    // print_r($attributeSet->getData());attribute_set_id
    echo "<div class=\"attribute-set-container\">";
    echo "<span class=\"attribute-set-name\">" . $attributeSet->getAttributeSetName() . "</span>";
    echo "<div class='updated_date'>" . $lastupdateddate . "</div>";
    echo "<button class=\"attribute-set-button $btnclss\" type = 'partial' rel = '" . $attributeSet->getAttributeSetId() . "'>$btntxt</button>";
    if(isset($lastCron['status'])) { 
        if($lastCron['status'] == 'compelete') {  
        echo "&nbsp; <button class=\"attribute-set-button btn-primary\" type = 'full' rel = '" . $attributeSet->getAttributeSetId() . "'> Re-run </button>";
        }      
    }
    echo "</div>";
}

echo '<button class= "btn-primary" style="float:right;" id ="setsortingpoints"> Set sortingpoints</button>';
echo '<button class= "btn-primary" style="float:right; margin-right:15px;" id ="updation"> Update Points</button>';
echo "</div>";


}else{ ?>
    <script> window.location.href = '<?php echo $this->getUrl(); ?>';</script>
  <?php  echo "<h2><center>Unauthorized</center></h2>";
}
