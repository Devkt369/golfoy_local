<?xml version="1.0"?>
 
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="ArtM\RecommendedFilter\Logger\Handler">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </type>
    <type name="ArtM\RecommendedFilter\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">RecommendedFilter</argument>
            <argument name="handlers"  xsi:type="array">
                <item name="system" xsi:type="object">ArtM\RecommendedFilter\Logger\Handler</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                 <item name="recommend_sorting_data_source" xsi:type="string">ArtM\RecommendedFilter\Model\ResourceModel\ArtmSortingProducts\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
    <virtualType name="ArtM\RecommendedFilter\Model\ResourceModel\ArtmSortingProducts\Grid\Collection" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">artm_sorting_products</argument>
            <argument name="resourceModel" xsi:type="string">ArtM\RecommendedFilter\Model\ResourceModel\ArtmSortingProducts</argument>
        </arguments>
    </virtualType>
    <!-- <type name="Magento\Catalog\Block\Adminhtml\Category\Tab\Product">
        <plugin name="custom_category_product_grid" type="ArtM\RecommendedFilter\Plugin\CategoryProductGridPlugin"/>
    </type> -->
</config>