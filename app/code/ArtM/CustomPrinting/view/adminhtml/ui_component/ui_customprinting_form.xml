<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">ui_customprinting_form.ui_customprinting_form_data_source_customprinting</item>
            <item name="deps" xsi:type="string">ui_customprinting_form.ui_customprinting_form_data_source_customprinting</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Form Information</item>
        <item name="config" xsi:type="array">
            <item name="dataScope" xsi:type="string">data</item>
            <item name="namespace" xsi:type="string">ui_customprinting_form</item>
        </item>
        <item name="spinner" xsi:type="string">general_information</item>
        <item name="buttons" xsi:type="array">
            <item name="back" xsi:type="string">ArtM\CustomPrinting\Block\Adminhtml\Button\Back</item>
            <item name="reset" xsi:type="string">ArtM\CustomPrinting\Block\Adminhtml\Button\Reset</item>
            <item name="delete" xsi:type="string">ArtM\CustomPrinting\Block\Adminhtml\Button\Delete</item>
            <item name="save" xsi:type="string">ArtM\CustomPrinting\Block\Adminhtml\Button\Save</item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <dataSource name="ui_customprinting_form_data_source_customprinting">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">ArtM\CustomPrinting\Model\Grid\DataProvider</argument>
            <argument name="name" xsi:type="string">ui_customprinting_form_data_source_customprinting</argument>
            <argument name="primaryFieldName" xsi:type="string">id</argument>
            <argument name="requestFieldName" xsi:type="string">id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="submit_url" xsi:type="url" path="*/*/save" />
                </item>
            </argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
    </dataSource>
    <fieldset name="general_information">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="collapsible" xsi:type="boolean">false</item>
                <item name="label" xsi:type="string" translate="true">General Information</item>
                <item name="sortOrder" xsi:type="number">10</item>
            </item>
        </argument>        
        <field name="attributeset">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Attributeset name</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">attributeset</item>
                    <item name="dataScope" xsi:type="string">attributeset</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field> 
        <field name="printtype">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Print Type</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="source" xsi:type="string">printtype</item>
                    <item name="dataScope" xsi:type="string">printtype</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                    <item name="options" xsi:type="array">                       
                        <item name="0" xsi:type="array">
                            <item name="label" xsi:type="string">Text</item>
                            <item name="value" xsi:type="string">text</item>
                        </item>
                        <item name="1" xsi:type="array">
                            <item name="label" xsi:type="string">Logo</item>
                            <item name="value" xsi:type="string">logo</item>
                        </item>
                        <item name="2" xsi:type="array">
                            <item name="label" xsi:type="string">Both</item>
                            <item name="value" xsi:type="string">both</item>
                        </item>
                    </item>
                </item>
            </argument>
          
        </field> 
        <field name="textlabel">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Text Label</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">textlabel</item>
                    <item name="dataScope" xsi:type="string">textlabel</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>  
        <field name="logolabel">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Logo Label</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">logolabel</item>
                    <item name="dataScope" xsi:type="string">logolabel</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field> 
    </fieldset>
</form>