<script type="text/javascript">
    require([ 'jquery', 'jquery/ui'], function($){ $(document).ready(function($) {  
        var fdata = '';
        $(".dragdrop").click(function(){
            $("#print_file").trigger('click');
        }); 
       
          $("html").on("dragover", function(e) {
              e.preventDefault();
              e.stopPropagation();
             // $(".dragdrop").text("Drag here");
          });
    
          $("html").on("drop", function(e) { e.preventDefault(); e.stopPropagation(); });
    
          // Drag enter
          $('.drag-area').on('dragenter', function (e) {
              e.stopPropagation();
              e.preventDefault();
             // $(".dragdrop").text("Drop");
          });
    
          // Drag over
          $('.drag-area').on('dragover', function (e) {
              e.stopPropagation();
              e.preventDefault();
             // $(".dragdrop").text("Drop");
          });
    
          // Drop
          $('.drag-area').on('drop', function (e) {
              e.stopPropagation();
              e.preventDefault();
              var file = e.originalEvent.dataTransfer.files;
             // $(".dragdrop").text(file[0].name);
              var fd = new FormData();
              fd.append('file', file[0]);
              fdata = fd;
             // $("#print_file").val('').trigger('change'); 
              uploadlogofunc(fdata);      
          }); 
          $("#print_file").change(function(){
            var opimgval = $(this).val();
            if(opimgval != ''){ 
              var file_data = $('#print_file').prop('files')[0];  
              var form_data = new FormData();                  
              form_data.append('file', file_data);
              fdata = form_data;
              uploadlogofunc(fdata);     
              }else{
                
              }
          });
          $('body').on('click', '#copybtn', function() {
            var copyText = document.getElementById("logopath");
            if(copyText.value != ''){
              copyText.select();
              copyText.setSelectionRange(0, 99999); 
              navigator.clipboard.writeText(copyText.value);
              $("#copybtn").next('span').html('copied.');
              setTimeout(function() {
                 $(this).next('span').html('');      
              }, 10000);
            }

          });
          $("#pos-wrapper").on("click", ".img-cross", function(){ 
            var rel = $(this).attr('rel');
                deletelogofunc();
          });
          function uploadlogofunc(fdata) { 
           if(fdata != null && fdata != ''){
            $.ajax({
                url: "/customprinting/index/ajaxupload",
                type: "POST",
                cache: false,
                contentType: false,
                processData: false,
                data: fdata,      
                dataType: 'json',
                showLoader: true,
                success:function(res){
                  if(res.path){
                    $htmlstr = '';
                    if(res.path.split(".").pop() != 'pdf'){
                      $htmlstr = $htmlstr +  '<div class ="resultimg image" ><img src = "/media/'+res.path+'"><div class="img-cross" rel = "'+res.path+'">&#10006;</div></div>';
                    }else{
                        $htmlstr = $htmlstr +  '<div class ="resultimg image" style="position:relative;text-align:center;font-weight:bold;">PDF<div class="img-cross" rel = "'+res.path+'">&#10006;</div></div>';
                    }
                    $("#logopath").val(res.path)
                    $("#drag-area").append($htmlstr);                  
                    $("#drag-area").css('border','none');
                    $("p.dragdrop").hide();
                    $("#logopathdiv").show();
                    toappend = '<div class="message message-success success"><p>Image uploaded.</p></div>';
                    $("#pos-wrapper").append(toappend);                 
                  }
                  if(res.error){   
                    var toappend = '<div class="message message-error error">';
                    $.each(res.error,function(index, value){
                      toappend = toappend + '<p>'+ value +'</p>';
                    });
                    toappend = toappend + "</div>";
                    $("#pos-wrapper").append(toappend);
                  }
                  
                }
            });  
          }
          }; 
          function deletelogofunc() { 
            if($("#pos-wrapper").find(".img-cross").length){
                el = $("#pos-wrapper").find(".resultimg");
                path = $("#pos-wrapper").find(".img-cross").attr('rel');
                $.ajax({
                    url: "/customprinting/index/deleteajaxupload",
                    type: "POST",
                    data: 'path='+path,      
                    dataType: 'json',
                    showLoader: true,
                    success:function(res){
                        el.remove();
                        $("#logopath").val('');
                        $("#logopathdiv").hide();
                        $("#copybtn").next('span').html('');
                        $("#pos-wrapper").find('div.message').remove();  
                        $("#print_file").val('');  
                        $("#print_text").val('');  
                        $("p.dragdrop").show();
                        $(".drag-area").css('border','3px dashed lightgray'); 
                        $(".input-text.product-custom-option.inputprinting").val('').trigger('change'); 
                    }
                });  
            }           
          }
      });
    });  
</script>
	
