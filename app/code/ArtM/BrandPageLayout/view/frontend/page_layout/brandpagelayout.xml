<?xml version="1.0"?>
<layout xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="1column"/>
    <referenceContainer name="content">
            <container name="div.brand.page" htmlTag="div" htmlClass="brandpage" after="main">
                 <referenceBlock name="category.products" remove="true" />
                 <referenceBlock name="breadcrumbs" remove="true" />
                  <referenceBlock name="catalog.leftnav" remove="true" />
            </container>
    </referenceContainer>
</layout>
