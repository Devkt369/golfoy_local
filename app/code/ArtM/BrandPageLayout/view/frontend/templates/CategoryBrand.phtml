// Function to remove brand name from product name
function removeBrandName($productName, $brandValue = '')
{
    $brandLabel = '';
    $eavConfig = \Magento\Framework\App\ObjectManager::getInstance()->get('Magento\Eav\Model\Config');
    $attribute = $eavConfig->getAttribute('catalog_product', 'brand');
    $options = $attribute->getSource()->getAllOptions(false);

    foreach ($options as $option) {
        if ($option['value'] == $brandValue) {
            $brandLabel = $option['label'];
            break;
        }
    }
    return str_ireplace($brandLabel, '', $productName);
}


