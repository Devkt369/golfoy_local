<script>
    require(['jquery'], function(jQuery) {
        jQuery(document).ready(function() {

            // Automatically open produc_name_sec on mobile screens
            if (jQuery(window).width() < 990) {
                jQuery('.produc_name_sec').show();
                jQuery('.subcat_name .toggle-button').hide();
            }

            // Toggle on click for desktop screens
            jQuery('.subcat_name').click(function() {
                if (jQuery(window).width() >= 990) { // Only toggle for screens 990px and above
                    var toggleButton = jQuery(this).find('.toggle-button');
                    var productSection = jQuery(this).siblings('.produc_name_sec');

                    jQuery(this).toggleClass('active');

                    productSection.slideToggle(function() {
                        if (toggleButton.text() === '+') {
                            toggleButton.text('\u2212');
                        } else {
                            toggleButton.text('+');
                        }
                    });
                }
            });

        });
    });
</script>


<script>
    require(['jquery', 'bootstrap'], function($) {
        $(document).ready(function() {
            var touchStartX = 0;
            var touchEndX = 0;

            // Register touchstart event to record the starting X-coordinate
            $('#myCarousel').on('touchstart', function(e) {
                touchStartX = e.originalEvent.touches[0].pageX;
            });

            // Register touchmove event to record the ending X-coordinate
            $('#myCarousel').on('touchmove', function(e) {
                touchEndX = e.originalEvent.touches[0].pageX;
            });

            // Determine the swipe direction and slide accordingly
            $('#myCarousel').on('touchend', function() {
                var deltaX = touchEndX - touchStartX;

                if (deltaX > 50) {
                    $('#myCarousel').carousel('prev');
                } else if (deltaX < -50) {
                    $('#myCarousel').carousel('next');
                }
            });
        });
    });

    // ---Slider for brand page-----///
    require(['jquery', 'bootstrap'], function($) {
        $(document).ready(function() {
            $('.brandcarasoul .right').on('click', function(e) {
                e.preventDefault();
                $('.brandcarasoul').carousel('next');
            });

            $('.brandcarasoul .left').on('click', function(e) {
                e.preventDefault();
                $('.brandcarasoul').carousel('prev');
            });

            // Make indicator clickable
            $('.carousel-indicators li').on('click', function(e) {
                e.preventDefault();
                var slideIndex = $(this).data('slide-to');
                $('.brandcarasoul').carousel(slideIndex);
            });

        });
    });
</script>
