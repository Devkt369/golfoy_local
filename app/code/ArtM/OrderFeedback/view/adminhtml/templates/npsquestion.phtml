<?php

// Use the Object Manager to get the resource connection
$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$resource = $objectManager->get('Magento\Framework\App\ResourceConnection');
$connection = $resource->getConnection();


$result = $this->getRequest()->getParams();
$startDate = '';
$endDate = '';

$tableName = $resource->getTableName('artm_survey_results');
if(isset($result['time_period'])){
    $timePeriod = $result['time_period'];
}else{
    $timePeriod = "reset";
}
    
    
if ($timePeriod === 'reset') {
    // If 'reset', both dates should be empty
    $startDate = '';
    $endDate = '';
} elseif ($timePeriod === 'custom') {
    $timePeriod = isset($result['time_period']) ? $result['time_period'] : '';

    $startDate = isset($result['start_date']) ? $result['start_date'] : '';
    $endDate = isset($result['end_date']) ? $result['end_date'] : '';
} else {
    // If a specific number of days is selected
    $n = (int)$timePeriod;
    $currentDate = new \DateTime();
    $startDateObj = clone $currentDate;
    $startDateObj->modify("-$n days");

    // Format dates as 'Y-m-d'
    $startDate = $startDateObj->format('Y-m-d');
    $endDate = $currentDate->format('Y-m-d');
}
$endDateforinput = $endDate;


// Initialize the base query
$sql = "SELECT survey_results FROM $tableName";

// Check if both start and end dates are provided
if (!empty($startDate) && !empty($endDate)) {
    // Sanitize dates to prevent SQL injection
    $startDate = htmlspecialchars($startDate);
    $endDate = htmlspecialchars($endDate);
    
    // Convert endDate to DateTime object and set the time to the end of the day
    try {
        $endDateTime = new DateTime($endDate);
        $endDateTime->setTime(23, 59, 59);
        $endDate = $endDateTime->format('Y-m-d H:i:s');
    } catch (Exception $e) {
        echo "Error: " . $e->getMessage();
        return;
    }
    
    // Append the WHERE clause
    $sql .= " WHERE craeted_at >= '$startDate' AND craeted_at <= '$endDate'";
}

$nps_month_sql = "
SELECT
    DATE_FORMAT(craeted_at, '%Y-%m') AS month,
    SUM(
        CASE 
            WHEN q1_value IN ('9', '10') THEN 1
            ELSE 0 
        END
    ) AS promoters,
    SUM(
        CASE 
            WHEN q1_value IN ('7', '8') THEN 1
            ELSE 0 
        END
    ) AS passives,
    SUM(
        CASE 
            WHEN q1_value IN ('0', '1', '2', '3', '4', '5', '6') THEN 1
            ELSE 0 
        END
    ) AS detractors,
    COUNT(*) AS totalResponses,
    CASE 
        WHEN COUNT(*) > 0 THEN
            (SUM(CASE WHEN q1_value IN ('9', '10') THEN 1 ELSE 0 END) / COUNT(*) * 100) -
            (SUM(CASE WHEN q1_value IN ('0', '1', '2', '3', '4', '5', '6') THEN 1 ELSE 0 END) / COUNT(*) * 100)
        ELSE
            0
    END AS nps
FROM (
    SELECT
        craeted_at,
        SUBSTRING_INDEX(SUBSTRING_INDEX(survey_results, '\"q1\":\"', -1), '\"', 1) AS q1_value
    FROM artm_survey_results
) AS q1_extracted
GROUP BY month
ORDER BY month;
";


// Execute the query (assuming $connection is your database connection object)
try {
    $result = $connection->fetchAll($sql);
} catch (\Exception $e) {
    // Handle exception
    echo "SQL Error: " . $e->getMessage();
}

// Execute the query (assuming $connection is your database connection object)
try {
    $nps_month_result = $connection->fetchAll($nps_month_sql);
} catch (\Exception $e) {
    // Handle exception
    echo "Monthly SQL Error: " . $e->getMessage();
}

$months = array_column($nps_month_result, 'month');
$npsValues = array_column($nps_month_result, 'nps');


//print_r($nps_month_result);

    
$results = $connection->fetchAll($sql);

$question_codes = array(
    'q1' => 'How likely are you to recommend the company to a friend?',
    'q2' => 'How would you rate your overall satisfaction with the service you received last time?',
    'q3' => 'How would you rate the quality of the product?',
    'q4' => 'How would you rate the value for money (ROI) of their product/service?',
    'q5' => 'How would you rate the quality of customer service?',
    'q6' => 'q6'
);
// Define possible options for each question
$possibleOptions = [
    'q1' => array_fill_keys(range(0, 10), 0),
    'q2' => [
        'very dissatisfied' => 0,
        'dissatisfied' => 0,
        'neither satisfied nor dissatisfied' => 0,
        'satisfied' => 0,
        'very satisfied' => 0,
    ],
    'q3' => [
        'poor' => 0,
        'below' => 0,
        'average' => 0,
        'good' => 0,
        'excellent' => 0,
    ],
    'q4' => array_fill_keys(range(0, 10), 0),
    'q5' => array_fill_keys(range(0, 10), 0),
    'q6' => [
        'yes' => 0,
        'no' => 0,
    ],
];
foreach ($possibleOptions as $question => &$options) {
    $options['skip'] = 0;
}

// Initialize an array to hold the counts
$questionCounts = [];
//print_r($results);
if( empty($results) ){
    $results[0] = array('survey_results' => '{"q1":""}{"q2":""}{"q3":""}{"q4":""}{"q5":""}{"q6":""}' );
}
// Process each survey result
foreach ($results as $result) {
    // Explode the string by separating each JSON object
    preg_match_all('/\{.*?\}/', $result['survey_results'], $matches);

    // Iterate through each match
    foreach ($matches[0] as $jsonString) {
        // Decode each JSON string into an associative array
        $surveyData = json_decode($jsonString, true);

        // Iterate through each question and its response
        foreach ($surveyData as $question => $response) {
            if($question == 'q6'){
                continue;
            }
            // Initialize the question in the counts array if not already done
            if (!isset($questionCounts[$question])) {
                $questionCounts[$question] = $possibleOptions[$question];
            }

            // Increment the count for the response
            if (isset($questionCounts[$question][$response])) {
                $questionCounts[$question][$response]++;
            }
        }
    }
}

// Get the maximum count value for scaling the range inputs
$maxValue = 0;
foreach ($questionCounts as $counts) {
    foreach ($counts as $value) {
        if ($value > $maxValue) {
            $maxValue = $value;
        }
    }
}


// Extract q1 responses
$q1Responses = $questionCounts['q1'];
$q1Responses['skip'] = 0;
// Calculate total responses
$totalResponses = array_sum($q1Responses);

// Calculate number of promoters, passives, and detractors
$promoters = array_sum(array_slice($q1Responses, 9, 2)); // Scores 9-10
$passives = array_sum(array_slice($q1Responses, 7, 2)); // Scores 7-8
$detractors = array_sum(array_slice($q1Responses, 0, 7)); // Scores 0-6

// Calculate percentages
if($totalResponses > 0){
    
    $promoterPercentage = ($promoters / $totalResponses) * 100;
    $detractorPercentage = ($detractors / $totalResponses) * 100;

    // Calculate NPS
    $nps = $promoterPercentage - $detractorPercentage;
}else{
    
    $promoterPercentage = 0;
    $detractorPercentage = 0;

    // Calculate NPS
    $nps = 0;
}

