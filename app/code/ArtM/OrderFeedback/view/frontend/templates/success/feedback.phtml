    <script>
        require(['jquery'], function (jQuery) {
            jQuery(document).ready(function () {
                jQuery('.smiley_img_Sec img').click(function () {
                    jQuery('.order_rating').val( jQuery(this).attr("rating") );
//                    alert('f');
                    
                    
                    var $this = jQuery(this); // cache jQuery object for performance
                    var isColored = $this.css('filter') === 'none'; // check if image is already colored
                    
                    jQuery('.smiley_img_Sec').removeClass('selected');
                    jQuery(this).parent().addClass('selected');
                    
                    jQuery('.smiley_img_Sec img').css('filter', 'grayscale(100%)');
                    $this.css('filter', 'none'); // toggle image color
//                    $this.css('filter', isColored ? 'grayscale(100%)' : 'none'); // toggle image color
                    
                    if (isColored) {
//                        jQuery('.input_form_sec').slideUp(); // hide the textarea
                    } else {
                        jQuery('.input_form_sec').slideDown(); // show the textarea
                    }
                    
                    var margin_above_smileys = jQuery('.feedback_section_block').offset().top;
                    var window_width = jQuery(window).outerHeight();
                    var smiley_div_height = jQuery('.feedback_section_block').outerHeight() + 270;
                    var scroll_up_to = margin_above_smileys - (window_width - smiley_div_height);
                    
                    if(scroll_up_to > 0){
                        scroll_up_to = 270;
                    }
                    console.log(scroll_up_to);
                        jQuery('html, body').animate({
                            scrollTop: scroll_up_to
                        }, 800);
                });
                
                var maxLength = jQuery('#orderfeedback-textarea').attr('maxlength');
                jQuery('.max_word_limit span').text(maxLength);
                jQuery('#orderfeedback-textarea').keyup(function() {
                    var textlen = maxLength - jQuery(this).val().length;
                    jQuery('.max_word_limit span').text(textlen);
                });

                jQuery(document).on('keyup', '#delivery-note #inputField', function() {
                    var textlen = jQuery(this).val().length;
                    if (textlen > 0) {
                        jQuery('button#delivery-notes').css({
                            'color': 'black',
                            'background': '#e60023'
                        });
                    } else {
                        jQuery('button#delivery-notes').css({
                            'color': 'grey',
                            'background': '#e3e3e3'
                        });
                    }
                });

                jQuery('#delivery-notes').click(function(e) {
                    e.preventDefault();
                    
                    var orderid = jQuery(this).attr('rel'); // Assuming 'rel' contains the order ID
                    var deliveryNote = jQuery('#delivery-note #inputField').val();
                    var url = "<?php echo $base_url; ?>orderfeedback/submit/index";
                                        
                    if (deliveryNote.length > 0) {
                        jQuery.ajax({
                            url: url,
                            type: 'POST',
                            dataType: 'json',
                            data: {
                                deliveryNote: deliveryNote,
                                orderid: orderid
                            },
                            complete: function(response) {
                                jQuery('textarea#inputField').hide();
                                jQuery('div.deliver-note-form').html("<div class='thankyou_feedback_text'>Thank you for your feedback.</div>");
                            }
                        });
                    } else {
                        // alert('input first');
                    }
                });
                
                
                
                jQuery('#submit_orderfeedback').click(function(e){
                    jQuery(this).css("opacity" , ".4");
                    
                    var error_message = '' ;
                    var order_id = jQuery('#order_id').val();
                    var rating = jQuery('#order_rating').val();
                    var review = jQuery('#orderfeedback-textarea').val();
                    if(rating == ''){
                        error_message = "Rating is empty";
                    }
                    
                    
                    if(error_message == '' ){
                        //no error, now send sms
                        var url = "<?php echo $base_url; ?>orderfeedback/submit/index";
//                        var url = "https://mage.golfoy.com/orderfeedback/submit/index?rating=3&review=review_test&orderid=1000072101";
//                        orderfeedback/submit/index
                        
                        jQuery.ajax({
                            url: url,
                            type: 'POST',
                            dataType: 'json',
                            data: {
                                rating: rating,
                                review: review,
                                orderid: order_id
                            },
                            complete: function(response) {
                                console.log('Success.');
                                jQuery('.feedback_section').hide();
                                jQuery('.smiley_gallery').hide();
                                jQuery('.input_form_sec').html("<div class='thankyou_feedback_text'>Thank you for your valuable feedback.</div>");
                                
                                 jQuery('html, body').animate({
                                    scrollTop: 0
                                }, 800);
                            }
                        });
                    }
                });
            });
        });
    </script>
    


   
<script type="text/javascript">
    require(['jquery'], function(jQuery) {
        jQuery(document).ready(function() {
            var steps = jQuery(".steps");
            console.dir(steps);

            setTimeout(function() {
                steps.each(function(index) {
                    var _t = jQuery(this);
                    setTimeout(function() {
                        _t.addClass('done');
                    }, 1250 * index * 1.5);
                });
            }, 500);
        });
    });
</script>

