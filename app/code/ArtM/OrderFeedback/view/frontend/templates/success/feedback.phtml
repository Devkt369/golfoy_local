$orderCurrency      = $order->getBaseCurrencyCode();
$orderGrandTotal    = $order->getBaseGrandTotal();
$orderShippingTotal = $order->getBaseShippingAmount();
$orderTax           = $order->getBaseTaxAmount();
$orderItems         = $order->getAllVisibleItems();

$orderGrandTotal = number_format($orderGrandTotal, 2, '.', '');
$orderTax = number_format($orderTax, 2, '.', '');
$orderShippingTotal = number_format($orderShippingTotal, 2, '.', '');
$couponCode = $order->getCouponCode() ?: '';
?>

<script>
    window.dataLayer = window.dataLayer || [];
    dataLayer.push({ ecommerce: null });
    dataLayer.push({
        event: "purchase",
        "ecommerce": {
            "transaction_id": "<?php echo $order->getIncrementId(); ?>",
            "value": "<?php echo $orderGrandTotal; ?>",
            "tax": "<?php echo $orderTax; ?>",
            "shipping": "<?php echo $orderShippingTotal; ?>",
            "currency": "INR",
            "coupon": "<?php echo $couponCode; ?>",
            "items": [
                <?php 
                $productData = [];
                foreach ($orderItems as $item) {
                    if ($item->getParentItemId()) continue; 
                    $productData[] = [
                        "item_name"     => $item->getName(),
                        "item_id"       => $item->getSku(),
                        "price"         => number_format($item->getBasePrice(), 2, ".", ""),
                        "affiliation"   => "Golfoy.com",
                        "quantity"      => (int)$item->getQtyOrdered(), 
                    ];
                }
                echo json_encode($productData, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
                ?>
            ]
        }
    });
</script>
