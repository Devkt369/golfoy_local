<script>
require(['jquery'], function($) {
    $(document).ready(function() {
        let currentStep = 1;
        const totalSteps = 6;

        function updateProgress() {
            const percentage = (currentStep / totalSteps) * 100;
            $('.progress-survey').css('width', percentage + '%');
            $('.progress-text').text(currentStep + '/' + totalSteps);
        }

        function goToNextStep() {
            if (currentStep < totalSteps) {
                currentStep++;
                updateProgress();
                $('.question').removeClass('active').hide();
                $('.question[data-step="' + currentStep + '"]').show().addClass('active');
            }
        }

        $('.options input').on('click', function() {
            const question = $(this).attr('name');
            const answer = $(this).val();
            const selectedValues = {
                [question]: answer
            };
            sendSurveyData(selectedValues);
            goToNextStep();
        });


        $('.skip').on('click', function() {
            var questionContainer = $(this).closest(".question");
            var inputName = questionContainer.find("input[type='radio']:first").attr("name");
            const selectedValues = {
                            [inputName]: 'skip'
                        };
            // console.log('selectedValues' , selectedValues);
            sendSurveyData(selectedValues);
            goToNextStep();
        });

        // Initialize the first question
        $('.question[data-step="1"]').show().addClass('active');
        updateProgress();

        // Function to send survey data via AJAX
        function sendSurveyData(data) {

            var staticData = {
                customer_id: '<?php echo $block->getCustomerId(); ?>',

                 order_id: '<?php echo $block->getOrder()->getId(); ?>',
            };
