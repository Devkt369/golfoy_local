<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="artm_querychatbox" resource="default" engine="innodb" comment="Query Chatbox Table">
        <column xsi:type="int" name="id" padding="10" unsigned="false" nullable="false" identity="true" comment="ID"/>
        <column name="name" xsi:type="varchar" length="20" nullable="false" comment="Name"/>
        <column name="email" xsi:type="varchar" length="50" nullable="false" comment="Email"/>
        <column name="phone_number" xsi:type="varchar" length="15" nullable="false" comment="Phone Number"/>
        <column name="query_type" xsi:type="varchar" length="50" nullable="false" comment="Query Type"/>
        <column name="query" xsi:type="text" nullable="false" comment="Query"/>
        <column name="response_result" xsi:type="text" nullable="true" comment="Response Result"/>
        <column name="query_assign" xsi:type="varchar" length="50" nullable="true" comment="Query Assign"/>
        <column name="status" xsi:type="varchar" length="20" nullable="false" comment="Status"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
    </table>

</schema>
