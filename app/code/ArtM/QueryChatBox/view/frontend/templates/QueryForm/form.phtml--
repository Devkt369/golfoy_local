// print_r($block->getCustomerDetails());
$customerDetails = $block->getCustomerDetails();
$imageURL = $block->getImageUrl('chatbox.png');
$flag = true;
$blockStatus = '';
$chatBoxOpenSelector = '';
if (!$customerDetails) {
    $flag = false;
    $cemail = '';
    $cname = '';
    $cnumber = '';
    $cid = '';
} else {
    $cemail = $customerDetails['0'];
    $cname = $customerDetails['1'];
    $cnumber = $customerDetails['2'];
    $cid = $customerDetails['3'];
}

$blockStatus = $block->isBlockUser($cemail);

$queryType = explode('||', $block->getQueryTypeConfig('querychat/query/question_area'));
$chatBoxOpenSelector = $block->getQueryTypeConfig('querychat/query/query_chat_box_open');
$htmlOutput = '';

foreach ($queryType as $index => $query) {
    $htmlOutput .= '<div class="checkboxes">';
    $htmlOutput .= '<label><input type="checkbox" id="checkbox' . ($index + 1) . '" name="query_type[]" value="' . $block->escapeHtml($query) . '">' . $block->escapeHtml($query) . '</label>';
    $htmlOutput .= '</div>';
}
?>

