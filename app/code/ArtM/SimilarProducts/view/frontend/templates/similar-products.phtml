<?php
$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$storeManager = $objectManager->get('\Magento\Store\Model\StoreManagerInterface');
$baseUrl = $storeManager->getStore()->getBaseUrl(\Magento\Framework\UrlInterface::URL_TYPE_WEB);
$baseUrl = 'https://golfoy.com/';
$relatedProducts = $block->getRelatedProducts();
$similarAttribute = $block->getSimilarAttributeLabel();
$similarProductHtml = '';
if ($similarAttribute && !empty($relatedProducts)) {
    $similarAttributeValue = $similarAttribute->getValue();
    list($heading, $attributeCode) = explode('-', $similarAttributeValue);

    $similarProductHtml .= '<div class="related-product-container"><h2 class="similar-product-heading">' . $heading . '</h2>';
    $similarProductHtml .= '<div class="similar-products">';

    foreach ($relatedProducts as $relatedProduct) {
        $relatedProductId = $relatedProduct->getId();

        $relatedProductData = $block->getProductById($relatedProductId);
        if ($relatedProductData) {

            $imageUrl = $baseUrl . 'media/catalog/product' . $relatedProductData->getThumbnail();
            // $imageUrl = $block->getProductImage($relatedProductData , 'product_thumbnail_image' , '100' , '100')->getUrl();


            $productUrl = $block->getProductUrl($relatedProductData);

            $similarProductHtml .= '<div class="related-product">';
            $similarProductHtml .= '<a href="' . $productUrl . '">';
            $similarProductHtml .= '<img src="' . $imageUrl . '" alt="' . $relatedProductData->getName() . '"/>';
            $similarProductHtml .= '<div class="prd-name">' . $relatedProductData->getName() . '</div>';
            $similarProductHtml .= '</a>';
            $similarProductHtml .= '<div class="attribute-value">' . $relatedProductData->getAttributeText($attributeCode) . '</div>';
            $similarProductHtml .= '</div>';
        }
    }
    $similarProductHtml .= '</div></div>';
