        function CheckIfBrandPage(url) {
            console.log("in function CheckIfBrandPage, URL is", url);
            if (!url) return Promise.resolve(false); // Always return a Promise

            const urlPath = url.replace(/^\//, '').replace('.html', '');
            const fragmentId = url.includes('#') ? url.split('#')[1] : null;
            const isNumericId = /^\d+$/.test(fragmentId);
            const idFromFragment = isNumericId ? fragmentId : null;

            let query = '';

            if (idFromFragment) {
                query = `{
                    category(id: ${idFromFragment}) {
                        page_layout
                    }
                }`;
            } else {
                query = `{
                    categoryList(filters: { url_path: { eq: "${urlPath}" } }) {
                        page_layout
                    }
                }`;
            }

            //console.log(query);

            return fetch('/graphql', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ query })
            })
            .then(response => response.json())
            .then(data => {
                //console.log(data);
                let layout = null;

                if (idFromFragment && data?.data?.category) {
                    layout = data.data.category.page_layout;
                } else if (!idFromFragment && data?.data?.categoryList?.[0]) {
                    layout = data.data.categoryList[0].page_layout;
                }

                return layout === 'brandpagelayout';
            })
            .catch(error => {
                console.error('❌ Error in CheckIfBrandPage:', error);
                return false;
            });
        }

