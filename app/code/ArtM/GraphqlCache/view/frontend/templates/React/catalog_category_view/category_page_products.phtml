                },
                    React.createElement("i", {
                        className: "fa fa-pencil-square-o",
                        "aria-hidden": "true"
                    }),
                    ` ${label}`
                );
            };

            
            const SizeSelector = () => {
              const { useState, useEffect, useRef } = React;

              const getCookie = (name) => {
                const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
                if (match) {
                  try {
                    return JSON.parse(decodeURIComponent(match[2]));
                  } catch {
                    return null;
                  }
                }
                return null;
              };

              const setCookie = (name, value, days) => {
                const expires = new Date(Date.now() + days * 864e5).toUTCString();
                document.cookie = `${name}=${encodeURIComponent(value)}; expires=${expires}; path=/`;
              };

              const deleteCookie = (name) => {
                document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;`;
              };

              let initialSize = getCookie('chosenShoeSize');
              if (typeof initialSize === 'string' || !initialSize?.label) initialSize = null;

              const [chosenSize, setChosenSize] = useState(initialSize);
              const [popupVisible, setPopupVisible] = useState(false);
              const [sizes, setSizes] = useState([]);
              const [loading, setLoading] = useState(false);
              const [error, setError] = useState(null);
              const cachedSizes = useRef(null);

              const openPopup = () => {
                setPopupVisible(true);

                const CACHE_KEY = 'shoeSizeOptionsCache';
                const CACHE_DURATION_MS = 3600 * 1000;
                const now = Date.now();
                const cachedData = localStorage.getItem(CACHE_KEY);

                if (cachedData) {
                  try {
                    const parsed = JSON.parse(cachedData);
                    if (now - parsed.timestamp < CACHE_DURATION_MS) {
                      cachedSizes.current = parsed.data;
                      setSizes(parsed.data);
                      return;
                    } else {
                      localStorage.removeItem(CACHE_KEY);
                    }
                  } catch {
                    localStorage.removeItem(CACHE_KEY);
                  }
                }

                setLoading(true);
                setError(null);
                const query = `
                {
                  products(filter: {}) {
                    aggregations {
                      attribute_code
                      options {
                        label
                        value
                      }
                    }
                  }
                }
                `;

                fetch('/graphql', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ query }),
                })
                  .then((res) => res.json())
                  .then((result) => {
                    try {
                      const aggs = result.data.products.aggregations || [];
                      const shoeSizeAgg = aggs.find((agg) => agg.attribute_code === 'shoe_size');
                      if (shoeSizeAgg && shoeSizeAgg.options) {
                        cachedSizes.current = shoeSizeAgg.options;
                        setSizes(shoeSizeAgg.options);
                        localStorage.setItem(
                          CACHE_KEY,
                          JSON.stringify({ timestamp: now, data: shoeSizeAgg.options })
                        );
                      } else {
                        setError('No shoe sizes found.');
                      }
                    } catch {
                      setError('Error parsing sizes.');
                    }
                    setLoading(false);
                  })
                  .catch(() => {
                    setError('Failed to fetch shoe sizes.');
                    setLoading(false);
                  });
              };

              const chooseSize = (size) => {
                const selected = { label: size.label, value: size.value };
                setCookie('chosenShoeSize', JSON.stringify(selected), 1);
                setChosenSize(selected);
                setPopupVisible(false);
                window._prevChosenSizeCookie = JSON.stringify(selected);
                if (typeof fetchFilters === 'function') {
                  fetchFilters();
                }
              };

              const removeSize = () => {
                deleteCookie('chosenShoeSize');
                setChosenSize(null);
                window._prevChosenSizeCookie = null;
                if (typeof fetchFilters === 'function') {
//                  fetchFilters();
