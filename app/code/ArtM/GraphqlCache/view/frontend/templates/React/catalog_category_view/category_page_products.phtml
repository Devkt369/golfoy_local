            function handleFilterChange(event, attributeCode) {
                setCurrentPage(1);

                const { value, checked } = event.target;
                const parentElement = event.target.closest('.swatch-option-label'); // Find parent

                if (parentElement) {
                    if (checked) {
                        parentElement.classList.add('active-filter');
                    } else {
                        parentElement.classList.remove('active-filter');
                    }
                }
               // console.log("setFilters 1");
                setFilters(prevFilters => {
                    let newFilters = { ...prevFilters };

                    if (!newFilters[attributeCode]) {
                        newFilters[attributeCode] = [];
                    }

                    if (checked) {
                        newFilters[attributeCode].push(value);
                    } else {
                        newFilters[attributeCode] = newFilters[attributeCode].filter(v => v !== value);
                        if (newFilters[attributeCode].length === 0) {
                            delete newFilters[attributeCode];
                        }
                    }

                    return newFilters;
                });
            }


            function removeFilter(attributeCode, value) {

               // console.log("setFilters 2");

                setFilters(prevFilters => {
                    let newFilters = {
                        ...prevFilters
                    };
                    newFilters[attributeCode] = newFilters[attributeCode].filter(v => v !== value);
                    if (newFilters[attributeCode].length === 0) {
                        delete newFilters[attributeCode];
                    }
                    return newFilters;
                });
            }

