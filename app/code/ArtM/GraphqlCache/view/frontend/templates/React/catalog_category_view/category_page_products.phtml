                                }else{
                                    
                                    //console.log("script 1 - function was not found");
                                }
                                //  else {
                                //     console.warn('callBrandpage not ready, retrying...');
                                //     let retryCount = 0;
                                //     const retry = setInterval(() => {
                                //         if (typeof window.callBrandpage === 'function') {
                                //             clearInterval(retry);
                                //             window.callBrandpage(url);
                                //         }
                                //         retryCount++;
                                //         if (retryCount > 10) clearInterval(retry); // Max 10 tries
                                //     }, 100);
                                // }

                                return; // Stop further code
                            } else {
                            }
                        });






                        // console.log("reached here to render content");
                        fetchBreadcrumbs(url).then(renderBreadcrumbs)
                        document.body.classList.add("page-layout-2columns-left");
                        document.body.classList.add("catalog-category-view");
                        document.body.classList.add("full_width");

                        //console.log("✅ Detected CATEGORY page, rendering ProductList.");

                        ReactDOM.render(
                            React.createElement(ProductList, { url: url }),
                            document.querySelector("#maincontent")
                        );


                        if (!isFirstLoad) history.pushState(null, "", url);

                    }else{

                        document.body.classList.remove("catalog-category-view");
                        document.body.classList.remove("page-layout-2columns-left");
                        document.body.classList.remove("full_width");
                        document.body.classList.remove("cms-home");
                    }

                    if (route.type === "CMS_PAGE") {

                        document.body.classList.add("loading");
                        fetchBreadcrumbs(url).then(renderBreadcrumbs);

                        fetchCmsPageContent(url).then(content => {
                            //console.log("✅ Detected CMS_PAGE, rendering CmsPage.");
                            ReactDOM.render(React.createElement(CmsPage, { content }), document.querySelector("#maincontent"));
                            document.body.classList.remove("loading");
                            if (!isFirstLoad) history.pushState(null, "", url);
                        });
                    } 

                //console.log("scrolling to top before");
                 const nextBaseUrl = new URL(url, window.location.origin).origin + new URL(url, window.location.origin).pathname;

                    if (prevBaseUrl !== nextBaseUrl) {
                        //console.log("scrolling to top before");
                        window.scrollTo({
                            top: 0,
                            behavior: "smooth"
                        });
                        //console.log("scrolling to top after");
                    }
                //console.log("scrolling to top after");
                
                }else {
                    
                    document.body.classList.remove("loading");
                    //console.log("⚠️ Other page type detected. Allowing normal navigation.");
                    if (!isFirstLoad) {
                        window.location.href = url; // Redirect only when clicked
                    }
                }
            });

            //console.log(`end renderContentForUrl (Time: ${performance.now() - startTime} ms)`);
        }
        function handleNavigation(event) {
            const clickedLi = event.target.closest("li.level0.category-item.level-top.parent.ui-menu-item");

            if (window.innerWidth < 768 && clickedLi) {
                const childUl = clickedLi.querySelector("ul");
                const childa = clickedLi.querySelector("a");

                /*if (childUl) {
                    console.log("entered");
                    if (childUl.classList.contains("collapsed")) {
                        childUl.classList.remove("collapsed");
                        childUl.classList.add("expanded");
                        childa.classList.remove("collapsed");
                        childa.classList.add("expanded");
                    } else if (childUl.classList.contains("expanded")) {
                        childUl.classList.remove("expanded");
                        childUl.classList.add("collapsed");
                        childa.classList.remove("expanded");
                        childa.classList.add("collapsed");
                    } else {
                        childUl.classList.add("expanded");
                        childa.classList.add("expanded");
                    }
                }else{

                console.log("exit");
}*/

                // Check if the clicked anchor is anywhere inside the <ul>
                const clickedAnchor = event.target.closest("li.level0.category-item.level-top.parent.ui-menu-item ul a.ui-menu-item");

                if (clickedAnchor) {
                    // Trigger the toggle nav button
                    const toggleNavButton = document.querySelector('span[data-action="toggle-nav"]');
                    if (toggleNavButton) {
                        toggleNavButton.click();
                    }
                }

//                return;
            }

            const startTime = performance.now(); // Start timing when function is called
            //console.log(`Start handleNavigation (Time: 0 ms)`);

            const target = event.target.closest("li.ui-menu-item.all-category,li.ui-menu-item.all-category a, a.react-comp, a.ui-menu-item-wrapper, a.logo"); 

            if (!target) return; // Ignore clicks outside <a> or without the class

            event.preventDefault(); // Prevent default navigation

            const relHref = target.getAttribute("rel-href");
            const targetUrl = (relHref || target.getAttribute("href")).replace(window.location.origin, "");


            if (!targetUrl.startsWith("/") || targetUrl === window.location.pathname) {
                return; // Ignore external links or same-page clicks
            }

            fetchPageType(targetUrl).then(route => {
                const fetchTime = performance.now() - startTime; // Time taken for fetchPageType()
                //console.log(`fetchPageType completed (Time: ${fetchTime.toFixed(2)} ms)`);

                if (!route || (route.type !== "CATEGORY" && route.type !== "CMS_PAGE")) {
                    window.location.href = targetUrl; // Normal redirect if not CATEGORY or CMS
                } else {
                    const renderStartTime = performance.now(); // Start render timing
                    //console.log(`Start renderContentForUrl (Time: ${fetchTime.toFixed(2)} ms)`);

                    
                    //console.log("calling renderContentForUrl - URL is " , targetUrl);

                    renderContentForUrl(targetUrl, false); // Load dynamically

                    const renderEndTime = performance.now();
                    //console.log(`End renderContentForUrl (Time: ${(renderEndTime - startTime).toFixed(2)} ms)`);
                }
            }).catch(error => {
                console.error("Error fetching page type:", error);
            });

            //console.log(`End handleNavigation (Time: ${(performance.now() - startTime).toFixed(2)} ms)`);
        }



        // Initial page load check
        const currentUrl = window.location.pathname.replace(window.location.origin, "");
        //console.log("🔄 Checking current page type on load:", currentUrl);
        renderContentForUrl(currentUrl, true);

        // Listen for navigation clicks
        document.addEventListener("click", handleNavigation);

        // Handle browser back/forward navigation
        window.addEventListener("popstate", () => {
            //console.log("🔄 Browser navigation detected, reloading content for:", window.location.pathname);
            renderContentForUrl(window.location.pathname, true);
        });
});
