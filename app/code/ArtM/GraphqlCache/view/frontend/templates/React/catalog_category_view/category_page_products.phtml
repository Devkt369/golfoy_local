                let cachedMetaTitle = sessionStorage.getItem(`metaTitle_${cacheKey}`);
                let cachedCategoryName = sessionStorage.getItem(`categoryName_${cacheKey}`);
                let cachedCategoryImage = sessionStorage.getItem(`categoryImage_${cacheKey}`);

                // If meta title is cached, set it as the page title
                if (cachedMetaTitle) {
                    document.title = cachedMetaTitle;
                }

                // Function to update the body class
                function updateBodyClass(isPlayersBag) {
                    if (isPlayersBag) {
                        document.body.classList.add("page-layout-playersbag");
                    } else {
                        document.body.classList.remove("page-layout-playersbag");
                    }
                }

                // ✅ If cached data exists, use it
                /*if (cachedCategoryId && cachedMetaTitle && cachedCategoryName) {
                    console.log(`✅ Returning cached Category ID: ${cachedCategoryId}`);

                    let isPlayersBag = cachedCategoryName === "Choose by players";
                    updateBodyClass(isPlayersBag);

                    if (isPlayersBag) {
                        console.log("🎯 Cached category is 'Choose by players' - Fetching players category data.");
                        fetchPlayersCategoryData(cachedCategoryId, cachedCategoryImage);
                    }

                    return cachedCategoryId;
                }*/

                try {
                    let query = '';
                    if (idFromFragment) {
                        query = `{
                            category(id: ${idFromFragment}) {
                                id
                                meta_title
                                description
                                subcategoriesontop
                                categoryheading
                                name
                                breadcrumbs {
                                    category_name
                                }
                            }
                        }`;
                    } else {
                        query = `{
                            categoryList(filters: { url_path: { eq: "${urlPath}" } }) {
                                id
                                meta_title
                                image
                                description  
                                subcategoriesontop
                                categoryheading
                                name
                                breadcrumbs {
                                    category_name
                                }
                            }
                        }`;
                    }
//                    console.log(query);
                    
                    let response = await fetch('/graphql', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ query })
                    });
                    
                    let data = await response.json();
//                    console.log(data);

                    if (data.errors || (idFromFragment && !data?.data?.category) || (!idFromFragment && !data?.data?.categoryList?.length)) {
                        console.error('❌ GraphQL error or category not found:', data.errors);
                        updateBodyClass(false);
                        return cachedCategoryId || "1";
                    }
                                        
                    let category = idFromFragment ? data.data.category : data.data.categoryList[0];
                    let categoryId = category.id || cachedCategoryId || "1";
                    let metaTitle = category.meta_title || category.name ;
                    let categoryName = category.breadcrumbs?.length ? category.breadcrumbs[category.breadcrumbs.length - 1].category_name : "Unknown Category";
                    let categoryImage = category.description || "";
                                        
                    //changing heading of category page
                    const headingEl = document.querySelector('.category-view > .category_top_block > .category_name');
                    if (headingEl) {
                        headingEl.textContent = category.categoryheading || category.name;
                        headingEl.classList.remove('flickering');
                    }
                                        
                    const shouldShowSubcats = category.subcategoriesontop === 1 || category.subcategoriesontop === true;
                    const div = document.getElementById("subcategories_and_data");
                    
                    // Only update state if not skipping
                    if (!skipStateUpdate) {
                        if (div) {
                            div.style.display = shouldShowSubcats ? "block" : "none";
                        }
                        setSubcategoriesontop(shouldShowSubcats);
                    }

                    let isPlayersBag = categoryName === "Choose by players";
                    updateBodyClass(isPlayersBag);
                    if (isPlayersBag) {
                        console.log("🎯 Category is 'Choose by players' - Fetching players category data.");
                        fetchPlayersCategoryData(categoryId, categoryImage);
                    }

                    // Cache the data
                    sessionStorage.setItem(cacheKey, categoryId);
                    sessionStorage.setItem(`metaTitle_${cacheKey}`, metaTitle);
                    sessionStorage.setItem(`categoryName_${cacheKey}`, categoryName);
                    sessionStorage.setItem(`categoryImage_${cacheKey}`, categoryImage);

                    document.title = metaTitle;
                    return categoryId;

                } catch (error) {
                    console.error('❌ Error fetching category data:', error);
                    updateBodyClass(false);
                    return cachedCategoryId || "1";
                }
            }


            function fetchPlayersCategoryData(categoryId, imageUrl) {
                console.log(`📸 Fetching player category data for Category ID: ${categoryId} with image: ${imageUrl}`);

                let subcategoriesContainer = document.getElementById("main_category_image");

                // Extract actual image path from <p> tags if present
                let parser = new DOMParser();
                let doc = parser.parseFromString(imageUrl, "text/html");
                let extractedUrl = doc.body.textContent.trim(); // Removes <p> tags and trims extra spaces

                // Get the current base URL dynamically
                let baseUrl = window.location.origin;

                // Build the full image URL dynamically
                let fullImageUrl = `${baseUrl}/media/${extractedUrl}`;

                if (subcategoriesContainer) {
                    subcategoriesContainer.innerHTML = `<img src="${fullImageUrl}" alt="Category Image" style="width: 100%; height: auto; margin-bottom: 20px;">`;
                } else {
                    console.error("❌ #subcategories_and_data container not found!");
                }
            }





            /*function Pagination({ totalPages, currentPage, handlePageChange }) {
                return React.createElement('div', { className: 'toolbar-bottom' },
                    React.createElement('div', { className: 'pages' },
                        React.createElement('ul', { className: 'items pages-items' },
                            Array.from({ length: totalPages }, (_, i) => i + 1).map((page) =>
                                React.createElement('li', {
                                    key: page,
                                    className: `item ${page === currentPage ? 'current' : ''}`
                                },
                                    React.createElement('a', {
                                        className: `page ${page === currentPage ? 'current' : ''}`,
                                        onClick: () => handlePageChange(page)
                                    }, page)
                                )
                            )
                        )
                    )
                );
            }*/
            
            async function getAttributeLabel(attributeCode, attributeValue) {
                // Check cache first
                if (attributeLabels[attributeCode]?.[attributeValue]) {
                    return attributeLabels[attributeCode][attributeValue];
                }

                // If not in cache and value is numeric, fetch from GraphQL
                if (attributeValue && !isNaN(attributeValue)) {
                    const cacheKey = `${attributeCode}_${attributeValue}`;
                    
                    // Check memory cache
                    if (attributeCache.has(cacheKey)) {
                        return attributeCache.get(cacheKey);
                    }

                    // Check if already fetching this attribute code
                    if (pendingQueries.has(attributeCode)) {
                        return pendingQueries.get(attributeCode).then(() => {
                            return attributeCache.get(cacheKey) || attributeValue;
                        });
                    }
                    
                    // Start fetching
                    const fetchPromise = (async () => {
                        try {
                            const query = `{
                                customAttributeMetadata(attributes: [{attribute_code: "${attributeCode}", entity_type: "catalog_product"}]) {
                                    items {
                                        attribute_code
                                        attribute_options {
                                            value
                                            label
                                        }
                                    }
                                }
                            }`;

                            const response = await fetch('/graphql', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ query })
                            });

                            const data = await response.json();
                            const attributeData = data?.data?.customAttributeMetadata?.items?.[0];
                            
                            if (attributeData?.attribute_options) {
                                // Cache all options at once
                                attributeData.attribute_options.forEach(opt => {
                                    const key = `${attributeCode}_${opt.value}`;
                                    attributeCache.set(key, opt.label);
                                });
                            }
                        } catch (error) {
                            console.error(`Error fetching ${attributeCode}:`, error);
                        } finally {
                            pendingQueries.delete(attributeCode);
                        }
                    })();
                    
                    pendingQueries.set(attributeCode, fetchPromise);
                    await fetchPromise;
                    
                    return attributeCache.get(cacheKey) || attributeValue;
                }

                return attributeValue;
            }
            
            // ✅ Component for displaying attribute labels
            const ProductAttribute = ({
                attributeCode,
                attributeValue
            }) => {

                const [label, setLabel] = useState(null);
                const [isLoading, setIsLoading] = useState(true);
                
                useEffect(() => {
                    if (!attributeValue) {
                        setIsLoading(false);
                        setLabel(null);
                        return;
                    }
                    
                    setIsLoading(true);
                    getAttributeLabel(attributeCode, attributeValue).then((fetchedLabel) => {
                        // Only show label if it's not a number (i.e., we got the actual label)
                        if (fetchedLabel && isNaN(fetchedLabel)) {
                            setLabel(fetchedLabel);
                        } else {
                            setLabel(null); // Hide if it's still a number
                        }
                        setIsLoading(false);
                    }).catch(error => {
                        setIsLoading(false);
                        setLabel(null);
                    });
                }, [attributeCode, attributeValue]);

                // Don't render if loading or no valid label
                if (isLoading || !label) return null;

                return React.createElement("div", {
                    className: `attribute_${attributeCode} ${attributeCode}_name`
                }, label);
            };
            const CleanedProductname = ({
                attributeCode,
                attributeValue,
                productname
            }) => {
                const [label, setLabel] = useState("Loading...");
                const [cleanedName, setCleanedName] = useState(productname);

                useEffect(() => {
                    getAttributeLabel(attributeCode, attributeValue).then((brandLabel) => {
                        setLabel(brandLabel);

                        // Remove brand label from product name if it exists
                        if (brandLabel) {
                            const regex = new RegExp(`^${brandLabel}\\s*`, 'i'); // Case-insensitive match
                            setCleanedName(productname.replace(regex, "").trim());
                        }
                    });
                }, [attributeCode, attributeValue, productname]);

                return React.createElement("div", {
                    className: `attribute_${attributeCode} cleaned_product_name`
                }, cleanedName);
            };
        
        
            const DeferredComponent = ({ children }) => {
                const [shouldRender, setShouldRender] = useState(false);

                useEffect(() => {
                    // Use requestIdleCallback if available, otherwise fallback to setTimeout
                    const load = () => setShouldRender(true);
                    if ('requestIdleCallback' in window) {
                        requestIdleCallback(load);
                    } else {
                        setTimeout(load, 100); // Fallback: slight delay
                    }
                }, []);

                return shouldRender ? children : null;
            };

        
        
            const SizeRollComponent = ({ productId, className }) => {
                const [sizeRoll, setSizeRoll] = useState(null);

                useEffect(() => {
                    const fetchSizeRoll = async () => {
                        try {
                            const response = await fetch("/graphql", { // Direct Magento GraphQL endpoint
                                method: "POST",
                                headers: {
                                    "Content-Type": "application/json"
                                },
                                body: JSON.stringify({
                                    query: `
                                        {
                                            getAvailableSizeRollValue(productId: ${productId}) {
                                                available_size_roll_value
                                            }
                                        }
                                    `
                                })
                            });

                            const result = await response.json();
                            if (result.data?.getAvailableSizeRollValue?.available_size_roll_value) {
                                setSizeRoll(result.data.getAvailableSizeRollValue.available_size_roll_value);
                            }
                        } catch (error) {
                            console.error("Error fetching size roll:", error);
                        }
                    };

                    fetchSizeRoll();
                }, [productId]);

                if (!sizeRoll) return null; // Do not render anything if size is not available

                // Format the size roll value (replace "to" with a styled span)
                const formattedSizeRoll = sizeRoll.replace(/\bto\b/g, '<span style="font-size: 10px; text-transform: lowercase;">to</span>');

                return React.createElement(
                    "div",
                    { className: `sizerolldiv_container ${className || ""}`, id: `ajax-sizeroll-${productId}` },
                    React.createElement("div", { className: "sizerolldiv_label" },
                        "Sizes: ",
                        React.createElement("span", { className: "sizerolldiv", dangerouslySetInnerHTML: { __html: formattedSizeRoll } })
                    )
                );
            };


           const AttributeValueComponent = ({ product, className }) => {
            //for size roll
            // console.log(`AttributeValueComponent called for Product ID: ${product.id}, Attribute Set ID: ${product.attribute_set_id}`);

            // Attribute mapping based on attribute_set_id
            const attributeMapping = {
                9: "feel",                  // Ball Attribute Set ID → feel
                12: "driver_flight_bias",    // Drivers Attribute Set ID → driver_flight_bias
                38: "balance_putter"         // Putter Attribute Set ID → balance_putter
            };

            // Get the attribute code from the mapping
            const attributeCode = attributeMapping[product.attribute_set_id];

            if (!attributeCode) {
                // console.warn(`No attribute mapping found for attribute_set_id: ${product.attribute_set_id}`);
                return null; 
            }

            // Get the attribute value dynamically
            const attributeValue = product[attributeCode];

            if (!attributeValue) {
//                console.warn(`No value found for attribute "${attributeCode}" in product ID ${product.id}`);
                return null;
            }

            return React.createElement(
                "div",
                { className: `catalog_attributes_value ${className}` },
                React.createElement(
                    "div",
                    { className: "attr_label_and_value" },
                    React.createElement("div", { className: "attr_label" }, attributeCode.charAt(0).toUpperCase() + attributeCode.slice(1)), // Label capitalized
                    " : ",
                    React.createElement("div", { className: "attr_value" },
                        React.createElement(ProductAttribute, {
                            attributeCode: attributeCode,
                            attributeValue: attributeValue,
                        })
                    )
                ),
                React.createElement("br")
            );
        };





            // ✅ Component for Express Delivery
            const ExpressDelivery = ({
                attributeCode,
                attributeValue
            }) => {
                const [label, setLabel] = useState(null);
                useEffect(() => {
                    const fetchLabel = async () => {
                        const result = await getAttributeLabel(attributeCode, attributeValue);
                        setLabel(result);
                    };
                    fetchLabel();
                }, [attributeCode, attributeValue]);
                if (label === "Yes") {
                    return React.createElement("div", {
                        className: "express_icon"
                    }, React.createElement("img", {
                        src: "https://golfoy.com/media/Express-Delivery.svg",
                        alt: "Express Delivery",
                        style: {
                            width: "130px"
                        }
                    }), React.createElement("div", {
                        className: 'hide express_text'
                    }, "Express Delivery"));
                }
                return null; // Don't render anything if label is not "Yes"
            };
            const formatPrice = (value) => {
                return value.toLocaleString("en-IN"); // Formats as Indian number system (e.g., 1,23,456)
            };

            async function fetchProducts() {
//                console.log("called fetchProducts");
                
                if (isFetchingRef.current) {
                    console.log("⏭️ Skipping duplicate fetchProducts call");
                    return;
                }
                
                isFetchingRef.current = true;
                setFetchingProducts(true);
                setLoading(true);

                const startTime = performance.now();
                
                // Get category ID - use cached or fetch
                let catId = categoryIdRef.current;
                if (!catId) {
                    // Fast path: check for category ID in hash first
                    const fragmentId = window.location.hash?.replace('#', '');
                    const isNumericId = /^\d+$/.test(fragmentId);
                    if (isNumericId) {
                        catId = fragmentId;
                        categoryIdRef.current = catId;
                        setCategoryId(catId);
                        // Fetch metadata in background (skip state updates to avoid interference)
                        getCategoryIdFromURL(true).then(id => {
                            if (id !== catId) {
                                categoryIdRef.current = id;
                                setCategoryId(id);
                            }
                        }).catch(err => console.error('Background category fetch error:', err));
                    } else {
                        catId = await getCategoryIdFromURL();
                        if (!categoryIdRef.current) {
                            categoryIdRef.current = catId;
                            setCategoryId(catId);
                        }
                    }
                }

                let filterConditions = Object.keys(filters)
                    .map(filterKey => {
                        let values = filters[filterKey].map(v => `\"${v}\"`).join(',');
                        return `${filterKey}: { in: [${values}] }`;
                    })
                    .join(',');

                let categoryFilter = `category_id: { eq: \"${catId}\" }`;
                let filtersQuery = filterConditions ? `, ${filterConditions}` : '';

                let query = `{
                    products(
                        filter: { ${categoryFilter}${filtersQuery} },
                        sort: { ${sortBy}: ${sortOrder} },
                        currentPage: ${currentPage},
                        pageSize: ${itemsPerPage}
                    ) {
                        items {
                            id
                            sku
                            name
                            url_key
                            brand
                            express_shipping
                            can_print
                            newarrivals
                            review_count
                            attribute_set_id
                            feel
                            rating_summary
                            waterproof
                            waterrepel
                            bestseller
                            clearance_sale
                            attribute_set_id
                            similar_attribute_label
                            color
                            used_clubs_grade
                            related_products {
                                id
                                color
                                image {
                                    url
                                    label
                                }
                              }
                            image {
                                url
                                label
                            }
                            price_range {
                                minimum_price {
                                    regular_price { value currency }
                                    final_price { value currency }
                                    discount { amount_off percent_off }
                                }
                                maximum_price {
                                    regular_price { value currency }
                                    final_price { value currency }
                                }
                            }
                            price_tiers {
                                quantity
                                final_price { value currency }
                            }
                        }
                        total_count
                        page_info { total_pages }
                    }
                }`;

                console.log(`fetchProducts GraphQL starting (Time: ${performance.now() - startTime} ms)`);

                fetch('/graphql', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ query })
                })
                .then(response => response.json())
                .then(async data => {
                    console.log(`✅ Data received. Updating UI... (Time: ${performance.now() - startTime} ms)`);
                    const products = data.data.products.items;
                    
                    // Batch prefetch all unique attribute values
                    const uniqueBrands = [...new Set(products.map(p => p.brand).filter(b => b && !isNaN(b)))];
                    if (uniqueBrands.length > 0 && !attributeCache.has(`brand_${uniqueBrands[0]}`)) {
                        getAttributeLabel('brand', uniqueBrands[0]); // Triggers batch fetch for all brand options
                    }
                    
                    setProducts(products);
                    setTotalPages(data.data.products.page_info.total_pages);
                    setTotalProducts(data.data.products.total_count);
                    setPage_size(itemsPerPage);
                    setTotal_count(data.data.products.total_count);

                    setLoading(false);
                })
                .catch(error => {
                    console.error('Error fetching products:', error);
                    setLoading(false);
                })
                .finally(() => {
                    setFetchingProducts(false);
                    isFetchingRef.current = false;
                });
            }



            const fetchFilters = async () => {
              fetchCategoryHierarchy();

              try {
                setFilterload(true);
                const catId = categoryIdRef.current || await getCategoryIdFromURL();
                if (!categoryIdRef.current) {
                    categoryIdRef.current = catId;
                    setCategoryId(catId);
                }
                if (!catId) {
                  console.error("❌ Category ID is null or undefined!");
                  setFilterload(false);
                  return;
                }

                const query = `{
                  products(filter: { category_id: { eq: "${catId}" } }) {
                    aggregations(filter: { category: { includeDirectChildrenOnly: true } }) {
                      attribute_code
                      label
                      options {
                        label
                        value
                        count
                        swatch_data {
                          value
                          type
                        }
                      }
                    }
                  }
                }`;

                const response = await fetch('/graphql', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ query }),
                });

                const data = await response.json();
                const filters = data.data.products.aggregations;

                setAvailableFilters(filters);
                setAttributeLabels(createLabelMap(filters));

                // 🍪 Parse chosen size from cookie
                const cookieMatch = document.cookie.match(/(?:^|; )chosenShoeSize=([^;]*)/);
                let chosenShoeSize = null;
                if (cookieMatch) {
                  try {
                    chosenShoeSize = JSON.parse(decodeURIComponent(cookieMatch[1]));
                  } catch {}
                }

                const chosenSizeDiv = document.getElementById('choosen_sizes');
                const shoeSizeAttr = filters.find(f => f.attribute_code === 'shoe_size');

                // Handle #choosen_sizes visibility & message
                const pathname = window.location.pathname.split('?')[0].split('#')[0];



                if (chosenSizeDiv) {
                    if (!pathname.endsWith('/shoes.html')) {
                        chosenSizeDiv.classList.add('hide');
                    }else{
                      if (!shoeSizeAttr) {
                            chosenSizeDiv.classList.add('hide');
                      } else {
                            chosenSizeDiv.classList.remove('hide');

                        const infoText = chosenSizeDiv.querySelector('p');
                        if (infoText && chosenShoeSize?.value) {
                          const chosenValue = String(chosenShoeSize.value).trim();

                          const found = shoeSizeAttr.options.some(opt => {
                            const optValue = String(opt.value).trim();
                            return optValue === chosenValue;
                          });

                          console.log("✅ Found size match by value:", found);

                          setTimeout(() => {
                            infoText.textContent = found
                              ? `Your chosen size is`
                              : `Cannot find size.`;

                            console.log("✅ Forced override after delay");
                          }, 100);
                        }
                      }
                    }
                }

                // ✅ Only apply the cookie-filtered size if we're on shoes.html
                if (shoeSizeAttr && window.location.pathname.endsWith('/shoes.html')) {
                  setFilters(prev => {
                    const newFilters = { ...prev };
                    if (chosenShoeSize?.value) {
                      const match = shoeSizeAttr.options.find(opt => opt.value === chosenShoeSize.value);
                      if (match) {
                        newFilters.shoe_size = [chosenShoeSize.value];
                      } else {
                        delete newFilters.shoe_size;
                      }
                    } else {
                      delete newFilters.shoe_size;
                    }
                    return newFilters;
                  });
                }

              } catch (error) {
                console.error("❌ Error fetching filters:", error);
              } finally {
                setFilterload(false);
              }
            };



            useEffect(() => {
              const interval = setInterval(() => {
                const currentCookie = document.cookie.match(/(?:^|; )chosenShoeSize=([^;]*)/);
                const stored = currentCookie ? decodeURIComponent(currentCookie[1]) : null;
                if (stored !== window._prevChosenSizeCookie) {
                  window._prevChosenSizeCookie = stored;
                  fetchFilters(); // Trigger filter refresh on cookie change
                }
              }, 1000); // poll every second

              return () => clearInterval(interval);
            }, []);





            const createLabelMap = (filters) => {
                const labelMap = {};

                filters.forEach(filter => {
                    labelMap[filter.attribute_code] = {};

                    filter.options.forEach(option => {
                        labelMap[filter.attribute_code][option.value] = option.label;
                    });
                });

                return labelMap;
            };

            async function fetchCategoryHierarchy() {

                const useCache = true; // 🔁 Toggle this to enable/disable caching
                const categoryUrlKey = window.location.pathname.replace(/^\//, '').replace('.html', '');
                const fragmentId = window.location.hash.replace('#', '');
                const isNumericId = /^\d+$/.test(fragmentId);
                const idFromFragment = isNumericId ? fragmentId : null;

                showLoadingEffect();

                try {
                    let query = '';
                    if (idFromFragment) {
                        query = `{
                            category(id: ${idFromFragment}) {
                                id
                                subcategoriesontop
                                categoryheading
                                name
                                children {
                                    id
                                    name
                                    url_path
                                    children {
                                        id
                                        name
                                        url_path
                                        products(pageSize: 1) {
                                            items {
                                                small_image {
                                                    url
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }`;
                    } else {
                        query = `{
                            categoryList(filters: { url_path: { eq: "${categoryUrlKey}" } }) {
                                id
                                subcategoriesontop
                                categoryheading
                                name
                                children {
                                    id
                                    name
                                    url_path
                                    children {
                                        id
                                        name
                                        url_path
                                        products(pageSize: 1) {
                                            items {
                                                small_image {
                                                    url
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }`;
                    }

                    const cacheKey = `categoryHierarchyCache_${btoa(query)}`;
                    let data = null;

                    if (useCache && localStorage.getItem(cacheKey)) {
                        data = JSON.parse(localStorage.getItem(cacheKey));
                    } else {
                       // console.log("🌐 Fetching category hierarchy from API");
                        const response = await fetch('/graphql', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ query })
                        });

                        data = await response.json();
                        if (useCache) {
                            localStorage.setItem(cacheKey, JSON.stringify(data));
                           // console.log("✅ Cached category hierarchy");
                        }
                    }

                    const categoryData = idFromFragment ? data.data.category : data.data.categoryList?.[0];

                    if (!categoryData) {
                        console.warn("⚠️ No category data found.");
                        clearCategoryHierarchy();
                        return;
                    }

                    if (categoryData.subcategoriesontop === 1 || categoryData.subcategoriesontop === true) {
                        renderCategoryHierarchy(categoryData);
                    } else {
                        clearCategoryHierarchy();
                    }

                } catch (error) {
                    console.error("❌ Error fetching category hierarchy:", error);
                    clearCategoryHierarchy();
                }
            }



            function renderCategoryHierarchy(categoryData) {

                if (!categoryData) {

                    clearCategoryHierarchy();
                    return;
                }


                let subcategories = [];
                let firstSubcategory = categoryData.children?.[0];

                if (!firstSubcategory) {

                } 

                if (firstSubcategory && firstSubcategory.children && firstSubcategory.children.length > 0) {

                    subcategories = firstSubcategory.children
                        .map((subcategory, index) => {
                            const productImage = subcategory.products?.items?.[0]?.small_image?.url;
                            const subcategoryUrl = `/${subcategory.url_path}.html`;

                            if (!productImage) {

                                return null;
                            }


                            return React.createElement("div", {
                                className: "subcategory_top_category col-md-2 col-sm-4 col-xs-6 blocks_inside_js",
                                key: subcategory.id
                            },
                                React.createElement("a", { className: "link react-comp", href: subcategoryUrl },
                                    React.createElement("div", { className: "image_prd_of_cat" },
                                        React.createElement("img", {
                                            width: 90,
