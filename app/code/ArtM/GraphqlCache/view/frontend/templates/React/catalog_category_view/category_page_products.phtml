            useEffect,
            useRef
        } = React;
        const attributeCache = new Map(); // Global cache for attributes
        const pendingQueries = new Map(); // Track pending GraphQL queries to avoid duplicates
        
        function ProductList( {url} ) {
            const [products, setProducts] = useState([]);
            const [filters, setFilters] = useState({});
            const [availableFilters, setAvailableFilters] = useState([]);
            const [loading, setLoading] = useState(true);
            const [filterload, setFilterload] = useState(true);
            const [sortBy, setSortBy] = useState("position")
            const [sortOrder, setSortOrder] = useState("ASC")
            const [currentPage, setCurrentPage] = React.useState(1); // Default to page 1
            const [totalPages, setTotalPages] = useState(1)
            const [totalProducts, setTotalProducts] = useState(0)
            const [itemsPerPage, setItemsPerPage] = React.useState(24);
            const [productCountElement, setProductCountElement] = React.useState(null);
            const [category_description, setCategory_description] = React.useState([]);
            
            const [page_size, setPage_size] = useState( itemsPerPage )
            const [total_count, setTotal_count] = useState(1)
            const maxVisiblePages = 5
            const [visiblePages, setVisiblePages] = React.useState([]);
            const [isFetchingFilters, setIsFetchingFilters] = useState(false);
            const [selectedSort, setSelectedSort] = useState("position");
            const [attributeLabels, setAttributeLabels] = useState({}); // Store labels separately
            const [showOptions, setShowOptions] = React.useState(false);

            const [fetchingProducts, setFetchingProducts] = useState(false); // Track if filters are ready
            const [subcategoriesontop, setSubcategoriesontop] = useState(false); // Track if filters are ready
            const [brandpage, setBrandpage] = useState(false); // Track if filters are ready
            const [categoryId, setCategoryId] = useState(null); // Cache category ID
            const isFetchingRef = useRef(false); // Prevent duplicate fetches
            const categoryIdRef = useRef(null); // Cache category ID across renders
            
            const SWATCH_BASE_PATH = `${window.location.origin}/media/attribute/swatch/swatch_image/30x20`;


            
            const activeFilters = ["Brand", "Shirt Size", "SIZE"];
            window.getCategoryIdFromURL = async function (skipStateUpdate = false) {
               //console.log("called getCategoryIdFromURL ");
