      function fetchPageType(url) {
        const startTime = performance.now(); // Start timing

        if (url === '/') {
            url = "/homepage-desktop";
            document.body.classList.add("homepage");
            document.body.classList.add("cms-home");
        }else{
            document.body.classList.remove("homepage");
            document.body.classList.remove("cms-home");
        }

//        console.log("URL changed to " , url);

        const cacheKey = `pageType_${url}`;
        const cachedData = localStorage.getItem(cacheKey);

        /*if (cachedData) {
            console.log(`🗄️ Using cached data for: ${url} (Time: ${(performance.now() - startTime).toFixed(2)} ms)`);
            return Promise.resolve(JSON.parse(cachedData));
        }*/

//        console.log(`🔍 Fetching page type for: ${url} (Time: 0 ms)`);

           const query = `{
                route(url: "${url}") {
                    type
                    relative_url
                }
            }`;

            //console.log('📤 Sending GraphQL Query:', query);

            return fetch('/graphql', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ query })
            })
            .then(response => response.json())
            .then(data => {
                const fetchTime = performance.now() - startTime;

                //console.log(`📥 Received GraphQL response (Time: ${fetchTime.toFixed(2)} ms):`, data);

                return data.data?.route || null;
            })
            .catch(error => {
                console.error(`❌ Error fetching page type (Time: ${(performance.now() - startTime).toFixed(2)} ms):`, error);
                return null;
            });


    }


