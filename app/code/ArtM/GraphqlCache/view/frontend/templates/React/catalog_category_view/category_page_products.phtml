                            React.createElement(
                                'a',
                                {
                                    className: 'action previous',
                                    onClick: (e) => {
                                        e.preventDefault();
                                        handlePageChange(currentPage - 1);
                                    }
                                },
                                React.createElement('span', null, 'Previous')
                            )
                        ),

                    // Page Numbers
                    visiblePages.map((page) =>
                        React.createElement(
                            'li',
                            { className: `item ${page === currentPage ? 'current' : ''}`, key: page },
                            page === currentPage
                                ? React.createElement(
                                      'strong',
                                      { className: 'page' },
                                      React.createElement('span', null, page)
                                  )
                                : React.createElement(
                                      'a',
                                      {
                                          className: 'page',
                                          onClick: (e) => {
                                              e.preventDefault();
                                              handlePageChange(page);
                                          }
                                      },
                                      React.createElement('span', null, page)
                                  )
                        )
                    ),

                    // Next Button
                    currentPage < totalPages &&
                        React.createElement(
                            'li',
                            { className: 'item pages-item-next' },
                            React.createElement(
                                'a',
                                {
                                    className: 'action next',
                                    onClick: (e) => {
                                        e.preventDefault();
                                        handlePageChange(currentPage + 1);
                                    }
                                },
                                React.createElement('span', null, 'Next')
                            )
                        )
                )
                    
                    
                    
                    
                    
                ),
                // Limiter Section
                React.createElement(
                    'div',
                    { className: 'field limiter' },
                    React.createElement(
                        'label',
                        { className: 'label', htmlFor: 'limiter' },
                        React.createElement('span', null, 'Show')
                    ),
                    React.createElement(
                        'div',
                        { className: 'control' },
                        React.createElement(
                            'select',
                            {
                                id: 'limiter',
                                className: 'limiter-options',
                                onChange: handleLimitChange // Added event handler
                            },
                            [24, 36, 48, 60, 90, 120].map((value) =>
                                React.createElement(
                                    'option',
                                    { value: value, key: value, selected: value === itemsPerPage },
                                    value
                                )
                            )
                        )
                    ),
                    React.createElement('span', { className: 'limiter-text' }, 'per page')
                ),
                    React.createElement('div', { className: 'category-description' }, "category_description")
            )
                
                )))
            );
        }
















function fetchBreadcrumbs(url) {
    //console.log("🔍 Starting fetchBreadcrumbs for:", url);

    return fetch('/graphql', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            query: `{
                route(url: "${url}") {
                    ... on CategoryInterface {
                        id
                        name
                        description
                        breadcrumbs {
                            category_id
                            category_name
                            category_url_path
                        }
                        topproducts
                    }
                }
            }`
        })
    })
    .then(response => response.json())
    .then(data => {
//        console.log("📥 Category route response:", data);

        let route = data.data?.route;
        if (!route) {
            //console.warn("⚠️ No route found for URL:", url);
            return [];
        }

        let breadcrumbs = route.breadcrumbs || [];
        let currentPageName = route.name || document.title.split(" - ")[0] || "Current Page";
        let description = route.description || "";
        const DescriptionContainer = document.querySelector(".category-description");

        // Handle [top_products]
        if (description.includes('[top_products]') && route.topproducts) {
            const rawIds = route.topproducts;
            const productIds = rawIds.split(',').map(id => parseInt(id.trim(), 10));

            //console.log("🧩 Found [top_products] with IDs:", productIds);
            let query = `{
                        topProducts(product_ids: [${productIds.join(',')}]) {
                            name
                            price
                            url
                        }
                    }`;
            //console.log(query);
            return fetch('/graphql', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    query: `{
                        topProducts(product_ids: [${productIds.join(',')}]) {
                            name
                            price
                            url
                        }
                    }`
                })
            })
            .then(res => res.json())
            .then(prodData => {
                //console.log("📦 Product data fetched:", prodData);

                const items = prodData?.data?.topProducts || [];

                if (items.length === 0) {
                    //console.warn("⚠️ No matching products found for IDs:", productIds);
                }

                const listHTML = `
                    <div class="">
                        <table><tbody>
                            <tr><th>Serial No.</th><th>Golf ${route.name}</th><th>Our Special Price</th></tr>
                            ${items.map((item, index) => `
                                <tr>
                                    <td> ${index + 1} </td>
                                    <td> <a href="${item.url}">${item.name}</a> </td>
                                    <td> ${item.price} </td>
                                </tr>
                            `).join('')}
                        </tbody></table>
                    </div>
                `;

                description = description.replace('[top_products]', listHTML);
                if (DescriptionContainer) {
                    DescriptionContainer.innerHTML = description;
                }

                breadcrumbs.unshift({ category_name: "Home", category_url_path: "/" });
                breadcrumbs.push({ category_name: currentPageName, category_url_path: url });

                return breadcrumbs;
            })
            .catch(error => {
                console.error("❌ Error fetching product list:", error);
                if (DescriptionContainer) {
                    DescriptionContainer.innerHTML = description.replace('[top_products]', '<p>Error loading top products.</p>');
                }
                return breadcrumbs;
            });
        }

        // No shortcode, just render
//        console.log("ℹ️ No [top_products] shortcode found. Rendering normal description.");
        if (DescriptionContainer) {
            DescriptionContainer.innerHTML = description;
        }

        breadcrumbs.unshift({ category_name: "Home", category_url_path: "/" });
        breadcrumbs.push({ category_name: currentPageName, category_url_path: url });

        return breadcrumbs;
    })
    .catch(error => {
        console.error("❌ Error in fetchBreadcrumbs:", error);
        return [];
    });
}














        function renderBreadcrumbs(breadcrumbs) {
            const breadcrumbsContainer = document.querySelector("#breadcrumbs");
            if (!breadcrumbsContainer) return;

            let breadcrumbHtml = `
                <div class="breadcrumbs">
                    <ul class="items">
                        ${breadcrumbs.map((crumb, index) =>
                            index === breadcrumbs.length - 1
                                ? `<li class="item"><strong>${crumb.category_name}</strong></li>` // Last item (current page)
                                : `<li class="item">
                                    <a class="react-comp" href="${crumb.category_url_path === '/' ? '/' : `/${crumb.category_url_path}.html`}" 
                                       title="${crumb.category_name}">
                                        ${crumb.category_name}
                                    </a>
                                   </li>`
                        ).join("")}
                    </ul>
                </div>
            `;


            breadcrumbsContainer.innerHTML = breadcrumbHtml;
        }

                            
                            
