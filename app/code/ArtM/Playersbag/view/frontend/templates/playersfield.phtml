<?php
/** @var $block \Magento\Catalog\Block\Product\View */
$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$product = $block->getProduct();
?>

<div class="choose_players">
    <?php if ($product): ?>
        <?php
        $categoryCollection = $product->getCategoryCollection();
        $targetSubcategoryName = 'Choose by players';
        $chosenSubcategoryIds = [];
        $allSubcategoryIds = [];
        $commonIds = [];
        foreach ($categoryCollection as $category) {
            foreach ($category->getChildrenCategories() as $subCategory) {
                if ($subCategory->getName() === $targetSubcategoryName) {
                    $chosenSubcategoryIds[] = $subCategory->getId();
                }
            }
        }
        if (!empty($chosenSubcategoryIds)) {
            foreach ($chosenSubcategoryIds as $chosenSubcategoryId) {
                $chosenCategory = $objectManager->create('\Magento\Catalog\Model\Category')->load($chosenSubcategoryId);
                foreach ($chosenCategory->getChildrenCategories() as $subCategory) {
                    $allSubcategoryIds[] = $subCategory->getId();
                }
            }
            $categoryIds = $categoryCollection->getAllIds();
            $commonIds = array_intersect($categoryIds, $allSubcategoryIds);
        }
        ?>

        <?php if (!empty($commonIds)): ?>
            <h3 class="choose_players_title">Player's choice</h3>
            <div class="players_div_sections">
                <div class="slider-container">
                    <div class="slider-wrapper">
                        <div class="slider">
                            <?php foreach ($commonIds as $commonId): ?>
                                <?php
                                $commonCategory = $objectManager->create('\Magento\Catalog\Model\Category')->load($commonId);
                                $imageUrl = $commonCategory->getImageUrl();
                                ?>
                                <div class="slider-item playersblock">
                                    <?php if ($imageUrl): ?>
                                        <a href="<?= $commonCategory->getUrl() ?>">
                                            <img src="https://golfoy.com/<?= $imageUrl ?>" alt="<?= $commonCategory->getName() ?>">
                                        </a>
                                    <?php else: ?>
                                        <span>No image available</span>
                                    <?php endif; ?>
                                    <div class="players_name"><a href="<?= $commonCategory->getUrl() ?>"><?= $commonCategory->getName() ?></a></div>
                                </div>
                            <?php endforeach; ?>
                        </div>
                    </div>
                </div>
            </div>
        <?php else: ?>
            <div class="not-found">No common categories found.<style>.choose_players {display: none;}</style></div>
        <?php endif; ?>

    <?php else: ?>
        <div>Product not found or not assigned to any category.</div>
    <?php endif; ?>
</div>

