
<?php
$category = $block->getCurrentCategory();

if ($category):
    if($category->getId() == 220){
        return;
    }

    $categoryName = $block->escapeHtml($category->getName());

    $mediaUrl = "https://golfoy.com/media/";

    // Remove domain if present
    $imagePath = strip_tags($category->getDescription());
    $imagePath = str_replace($block->getBaseUrl(), '', $imagePath);
    $imagePath = ltrim($imagePath, '/');

    // Ensure it starts with wysiwyg/
    if (strpos($imagePath, 'wysiwyg/') !== false) {
        $imageUrl = $mediaUrl . $imagePath;
    } else {
        $imageUrl = '';
    }
?>

    <div class="playerbag_img">
        <?php if ($imageUrl): ?>
            <img src="<?= $block->escapeUrl($imageUrl); ?>"
                alt="<?= $categoryName; ?>"
                loading="lazy"
                decoding="async">
        <?php endif; ?>

        <div class="players_name">
            <!-- <div class="category_name new_cat_name">
                <?= $categoryName; ?>
            </div> -->
        </div>
    </div>

<?php endif; ?>
