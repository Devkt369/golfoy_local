$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$category = $objectManager->create('Magento\Catalog\Model\Category')->load($categoryId);

if ($category->getId()) {
    $subcategories = $category->getChildrenCategories();

    if ($subcategories && count($subcategories) > 0) {
?>

        <div class="players-bag-container">
            <h1>players bag</h1>
            <div class="overlay"></div>

            <div class="wrapper">
                <?php foreach ($subcategories as $subcategory) {
                    $subcategory = $objectManager->create('Magento\Catalog\Model\Category')->load($subcategory->getId());
                    $imageUrl = $subcategory->getImageUrl();
                    $categoryName = $subcategory->getName();
                    $categoryUrl = $subcategory->getUrl();
                ?>

                    <div class="card">
                        <div class="glare-container">
                            <div class="glare"></div>
                            <div class="witb_product_section">
                                <a href="<?php echo $categoryUrl; ?>">
                                    <img src="<?php echo $imageUrl; ?>" alt="<?php echo $categoryName; ?>">
                                </a>
                                <h3><?php echo $categoryName; ?></h3>
                                <p><a href="<?php echo $categoryUrl; ?>">View Player's Bag</a></p>
                            </div>
                        </div>
                    </div>

                <?php } ?>
            </div>
        </div>
<?php
    } else {
        echo "No subcategories found.";
    }
} else {
    echo "Category not found.";
}
