<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="artm" translate="label" sortOrder="800">
            <label>ArtM</label>
        </tab>
        <section id="artm_livechat" translate="label" type="text" sortOrder="850" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Live Chat</label>
            <tab>artm</tab>
            <resource>ArtM_LiveChat::inbox</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="server_url" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Realtime Server URL</label>
                    <comment>Socket.IO server origin, for example http://localhost:3001.</comment>
                </field>
            </group>
        </section>
    </system>
</config>