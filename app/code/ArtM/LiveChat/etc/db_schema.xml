<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="artm_livechat_conversation" resource="default" engine="innodb" comment="ArtM Live Chat Conversation">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Conversation ID"/>
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="varchar" name="customer_name" nullable="false" length="255" comment="Customer Name"/>
        <column xsi:type="varchar" name="customer_email" nullable="false" length="255" comment="Customer Email"/>
        <column xsi:type="varchar" name="status" nullable="false" length="24" default="open" comment="Conversation Status"/>
        <column xsi:type="int" name="assigned_agent_id" padding="10" unsigned="true" nullable="true" comment="Assigned Agent ID"/>
        <column xsi:type="varchar" name="assigned_agent_name" nullable="true" length="255" comment="Assigned Agent Name"/>
        <column xsi:type="varchar" name="intake_category" nullable="true" length="32" comment="Customer Request Category"/>
        <column xsi:type="varchar" name="order_number" nullable="true" length="64" comment="Customer Order Number"/>
        <column xsi:type="varchar" name="issue_summary" nullable="true" length="255" comment="Customer Issue Summary"/>
        <column xsi:type="text" name="customer_message" nullable="true" comment="Customer Issue Description"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="ARTM_LIVECHAT_CUSTOMER_STATUS" indexType="btree">
            <column name="customer_id"/>
            <column name="status"/>
        </index>
        <index referenceId="ARTM_LIVECHAT_STATUS_UPDATED" indexType="btree">
            <column name="status"/>
            <column name="updated_at"/>
        </index>
        <index referenceId="ARTM_LIVECHAT_REQUEST_QUEUE" indexType="btree">
            <column name="status"/>
            <column name="assigned_agent_id"/>
            <column name="created_at"/>
        </index>
    </table>
    <table name="artm_livechat_message" resource="default" engine="innodb" comment="ArtM Live Chat Message">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Message ID"/>
        <column xsi:type="int" name="conversation_id" padding="10" unsigned="true" nullable="false" comment="Conversation ID"/>
        <column xsi:type="varchar" name="sender_type" nullable="false" length="16" comment="Sender Type"/>
        <column xsi:type="int" name="sender_id" padding="10" unsigned="true" nullable="false" comment="Sender ID"/>
        <column xsi:type="varchar" name="sender_name" nullable="false" length="255" comment="Sender Name"/>
        <column xsi:type="text" name="message" nullable="false" comment="Message"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ARTM_LIVECHAT_MSG_CONV_FK" table="artm_livechat_message" column="conversation_id" referenceTable="artm_livechat_conversation" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="ARTM_LIVECHAT_MSG_CONVERSATION" indexType="btree">
            <column name="conversation_id"/>
            <column name="entity_id"/>
        </index>
    </table>
</schema>