<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">

    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">artm_shipment_logs_listing.artm_shipment_logs_listing_data_source</item>
        </item>
    </argument>

    <settings>
        <spinner>artm_shipment_logs_columns</spinner>
        <deps>
            <dep>artm_shipment_logs_listing.artm_shipment_logs_listing_data_source</dep>
        </deps>
    </settings>

    <dataSource name="artm_shipment_logs_listing_data_source"
                component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">log_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>ArtM_ShipmentTracking::shipment_logs</aclResource>
        <dataProvider class="ArtM\ShipmentTracking\Ui\DataProvider\ShipmentLogDataProvider"
                      name="artm_shipment_logs_listing_data_source">
            <settings>
                <requestFieldName>log_id</requestFieldName>
                <primaryFieldName>log_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>

    <columns name="artm_shipment_logs_columns">
        <!-- <column name="log_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Log ID</label>
                <sorting>desc</sorting>
            </settings>
        </column> -->

        <column name="order_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Order ID</label>
            </settings>
        </column>

        <!-- <column name="shipment_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Shipment ID</label>
            </settings>
        </column> -->

        <!-- <column name="tracking_number">
            <settings>
                <filter>text</filter>
                <label translate="true">Tracking Number</label>
            </settings>
        </column> -->

        <!-- <column name="courier_name">
            <settings>
                <filter>text</filter>
                <label translate="true">Courier Name</label>
            </settings>
        </column> -->

        <column name="tracking_status">
            <settings>
                <filter>text</filter>
                <label translate="true">Tracking Status</label>
            </settings>
        </column>

        <!-- <column name="delivered_at"
                class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Delivered At</label>
            </settings>
        </column> -->

        <!-- <column name="last_checked_at"
                class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Last Checked</label>
            </settings>
        </column> -->

        <column name="marked_delivered_at"
                class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Order Marked Delivered At</label>
            </settings>
        </column>
    </columns>
</listing>
