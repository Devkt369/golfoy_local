<?php /** @var $block \Magento\Shipping\Block\Tracking\Link */ ?>
<?php $order = $block->getOrder() ?>
<a href="#"
    class="action track iframe-popup sss"
    title="<?= $block->escapeHtmlAttr($block->getLabel()) ?>"
    data-window-url="<?= $block->escapeUrl($block->getWindowUrl($order)) ?>">
    <span><?= $block->escapeHtml($block->getLabel()) ?></span>
</a>

<div id="track-order-modal" style="display:none;">
    <div class="track-order-loader" style="text-align:center; padding: 40px;">
        <img src="<?= $block->getViewFileUrl('images/loader-2.gif') ?>" alt="Loading tracking info..." />
        <p><?= $block->escapeHtml(__('Loading tracking info...')) ?></p>
    </div>
    <iframe id="track-order-iframe" src="" width="100%" height="500" frameborder="0" style="display:none;"></iframe>
</div>

<script>
    require([
        'jquery',
        'Magento_Ui/js/modal/modal'
    ], function($, modal) {
        $(document).ready(function() {
            var options = {
                type: 'popup',
                responsive: true,
                innerScroll: false,
                title: '<?= $block->escapeHtml($block->getLabel()) ?>',
                buttons: [],
                modalClass: 'track-order-popup',
                closed: function() {
                    $('#track-order-iframe').attr('src', '').hide();
                    $('.track-order-loader').show();
                }
            };

            var popup = modal(options, $('#track-order-modal'));

            $(document).on('click', '.iframe-popup', function(e) {
                e.preventDefault();
                var url = $(this).data('window-url');

                $('#track-order-modal').modal('openModal'); // Open modal immediately with loader
                $('.track-order-loader').show();
                $('#track-order-iframe').css('height', '420px').hide();

                $('#track-order-iframe').off('load').on('load', function() {
                    var $iframe = $(this);
                    var viewportHeight = window.innerHeight || document.documentElement.clientHeight;
                    var isMobile = window.matchMedia('(max-width: 767px)').matches;
                    var maxIframeHeight = Math.round(viewportHeight * (isMobile ? 0.86 : 0.65));
                    var minIframeHeight = 260;

                    try {
                        var doc = this.contentWindow.document;
                        var body = doc.body;
                        var html = doc.documentElement;
                        var contentHeight = Math.max(
                            body ? body.scrollHeight : 0,
                            body ? body.offsetHeight : 0,
                            html ? html.clientHeight : 0,
                            html ? html.scrollHeight : 0,
                            html ? html.offsetHeight : 0
                        );

                        var finalHeight = isMobile ?
                            Math.max(viewportHeight - 92, minIframeHeight) :
                            Math.min(Math.max(contentHeight, minIframeHeight), maxIframeHeight);
                        $iframe.css('height', finalHeight + 'px');
                    } catch (error) {
                        $iframe.css('height', maxIframeHeight + 'px');
                    }

                    $('.track-order-loader').hide();
                    $iframe.show(); // Show iframe only after content loaded
                }).attr('src', url);
            });
        });
    });
</script>

