<?php

$shipment = $block->getData('shipment');
$orderStatus = $shipment->getOrder()->getStatus();

if (!$shipment || $orderStatus === 'canceled' || $orderStatus === 'closed') {
    return;
}

$timeline = $block->getTimelineData($shipment);

if (!$timeline) {
    return;
}

if (empty($timeline['delivered_at'])) : ?>
    <div class="shipment-track-action">
        <a href="#"
            class="action primary iframe-popup"
            title="<?= $block->escapeHtml(__('Track Shipment')) ?>"
            data-window-url="<?= $block->escapeUrl(
                                    $this->helper(\Magento\Shipping\Helper\Data::class)
                                        ->getTrackingPopupUrlBySalesModel($shipment)
                                ) ?>">
            <span><?= $block->escapeHtml(__('Track Shipment')) ?></span>
        </a>
    </div>
    <?php return; ?>
<?php endif; ?>

<?php

$formatDate = function ($date) {
    return $date ? date('g:i A', strtotime($date)) : '';
};

$formatDay = function ($date) {
    return $date ? date('j M Y', strtotime($date)) : '';
};
?>

