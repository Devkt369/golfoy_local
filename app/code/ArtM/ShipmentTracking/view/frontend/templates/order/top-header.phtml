<?php

/** @var \Magento\Framework\View\Element\Template $block */

$order = $block->getLayout()
    ->getBlock('sales.order.info')
    ->getOrder();

$orderId = $order->getRealOrderId();
$orderDate = $block->formatDate($order->getCreatedAt(), \IntlDateFormatter::LONG);
$itemCount = (int)$order->getTotalItemCount();
$grandTotal = $order->formatPrice($order->getGrandTotal());
$status = strtoupper($order->getStatusLabel());

// Create a CSS-friendly class name for the status (e.g., 'partially-delivered')
$statusClass = strtolower(str_replace(' ', '-', $status));

$showForm = false;
$shippingAddress = $order->getShippingAddress() ?? "";
$phone = '';
if ($shippingAddress) {
    $phone = $shippingAddress->getTelephone();
}

// echo "<pre>";
// print_r($order->hasShipments());
// print_r($order->getData());
// print_r($order->getState());
// echo $status;
// print_r($order->getStatus());
// die;


foreach ($order->getAllVisibleItems() as $_item) {
    $productTypeId = $_item->getProduct()->getTypeId();
    if ($productTypeId !== 'giftvoucher') {
        $showForm = true;
        break;
    }
}

$removeButton = true;
if ($order->getStatus() == "cancelpending" || $order->getStatus() == "canceled" || $order->getStatus() == "closed") {
    $showForm = false;
}
?>

<div class="custom-order-header">
    <div class="order-left">
        <h1><?= __('Order #') . $orderId ?></h1>
        <span class="order-status mobile-status status-<?= $statusClass ?>">
            <?= $status ?>
        </span>

        <div class="order-meta">
            <span class="meta-date" data-date="<?= $block->escapeHtml($orderDate) ?>"><?= __('Placed on %1', $orderDate) ?></span>
            <span class="dot">•</span>
            <span class="meta-count"><?= $itemCount . ' ' . __('Items') ?></span>
            <span class="dot">•</span>
            <span class="meta-total"><?= $grandTotal ?></span>
            <span class="meta-status">
                <span class="order-status web-status status-<?= $statusClass ?>">
                    <?= $status ?>
                </span>
            </span>
        </div>
    </div>

    <div class="order-actions">

        <?php if ($showForm && !$order->hasShipments() && $order->getStatus() != "customization_pending") : ?>
            <form method="post" class="form cancelcustomform_form" action="<?= $this->getUrl('cancelorder/index/submit'); ?>">
                <input type="hidden" value="<?= $order->getCustomerFirstname() ?>" name="customer_name" />
                <input type="hidden" value="<?= $order->getCustomerEmail() ?>" name="customer_email" />
                <input type="hidden" value="<?= $order->getId() ?>" name="order_id" />
                <input type="hidden" value="<?= $order->getIncrementId() ?>" name="incremented_id" />
                <input type="hidden" value="<?= $order->getState() ?>" name="order_state" />
                <input type="hidden" value="<?= $order->getStatus() ?>" name="order_status" />
                <input type="hidden" value="cancel" name="return_cancel_status" />
                <input type="hidden" value="<?= $order->getCustomerId(); ?>" name="customer_id" />
                <input type="hidden" value="<?= $phone ?>" name="customer_phone" />
                <input name="form_key" type="hidden" value="<?php echo $block->getFormKey(); ?>" />

                <?php if ($order->getStatus() != "cancelpending") : ?>
                    <input type="submit" value="Cancel Order" class="ordercancel action secondary" />
                <?php endif ?>
            </form>
        <?php else: ?>
            <?php if ($order->getStatus() != "cancelpending" && $order->getStatus() != "canceled" && $order->getStatus() != "closed") : ?>
                <a class="action secondary shipment-track"
                    href="<?= $block->getUrl('sales/order/shipment/order_id', ['order_id' => $order->getId()]) ?>">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
