            <span class="pager-summary"><?= $block->escapeHtml(__('Page %1 of %2', $currentPage, $lastPage)) ?></span>
        </div>
    <?php endif; ?>
</div>

<script>
    require([], function () {
        var selectAll = document.getElementById('select_all');
        var selectAllHeader = document.getElementById('select_all_header');

        function syncAll(flag) {
            var boxes = document.querySelectorAll('.row-checkbox');
            boxes.forEach(function (box) {
                box.checked = flag;
            });
            if (selectAll) {
                selectAll.checked = flag;
            }
            if (selectAllHeader) {
                selectAllHeader.checked = flag;
            }
        }

        if (selectAll) {
            selectAll.addEventListener('change', function () {
                syncAll(this.checked);
            });
        }
        if (selectAllHeader) {
            selectAllHeader.addEventListener('change', function () {
                syncAll(this.checked);
            });
        }

        document.getElementById('apply_mass_action').addEventListener('click', function () {
            var action = document.getElementById('mass_action').value;
            if (!action) {
                alert('<?= $block->escapeJs(__('Please select a mass action.')) ?>');
                return;
            }

            var hasChecked = false;
            document.querySelectorAll('.row-checkbox').forEach(function (box) {
                if (box.checked) {
                    hasChecked = true;
                }
            });

            if (!hasChecked) {
                alert('<?= $block->escapeJs(__('Please select at least one question.')) ?>');
                return;
            }

            var form = document.getElementById('mass_action_form');
            if (action === 'delete') {
                if (!confirm('<?= $block->escapeJs(__('Delete selected questions?')) ?>')) {
                    return;
                }
                form.action = '<?= $block->escapeJs($block->getUrl('customersurvey/question/massDelete')) ?>';
            } else {
                form.action = '<?= $block->escapeJs($block->getUrl('customersurvey/question/massStatus')) ?>';
                var hidden = document.createElement('input');
                hidden.type = 'hidden';
                hidden.name = 'status';
                hidden.value = action === 'enable' ? '1' : '0';
                form.appendChild(hidden);
            }

            form.submit();
        });
    });
</script>
