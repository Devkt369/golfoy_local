<script>
    require([], function () {
        var optionBasedTypes = <?= /* @noEscape */ json_encode(array_values($optionBasedTypes)) ?>;
        var typeEl = document.getElementById('type');
        var panelEl = document.getElementById('option_panel');
        var checkboxRange = document.getElementById('checkbox_range');
        var optionRows = document.getElementById('option_rows');
        var addBtn = document.getElementById('add_option');
        var formEl = document.getElementById('question_form');
        var optionIndex = <?= (int)count($options) ?>;

        function toggleConditionalSections() {
            var selectedType = typeEl.value;
            panelEl.style.display = optionBasedTypes.indexOf(selectedType) !== -1 ? 'block' : 'none';
            checkboxRange.style.display = selectedType === 'checkbox' ? 'block' : 'none';
        }

        function optionRowTemplate(idx) {
            return '<tr>' +
                '<td><input type="text" name="options[' + idx + '][title]" class="admin__control-text"/></td>' +
                '<td><input type="text" name="options[' + idx + '][value]" class="admin__control-text"/></td>' +
                '<td>' +
                '<input type="hidden" name="options[' + idx + '][existing_image]" value=""/>' +
                '<input type="file" name="option_images[' + idx + ']" class="admin__control-file" accept="image/*"/>' +
                '</td>' +
                '<td><input type="number" name="options[' + idx + '][sort_order]" class="admin__control-text" value="0"/></td>' +
                '<td><button type="button" class="action-delete remove-option"><?= $block->escapeJs(__('Remove')) ?></button></td>' +
                '</tr>';
        }

        function bindRemoveOptionButtons() {
            var buttons = document.querySelectorAll('.remove-option');
            buttons.forEach(function (btn) {
                btn.onclick = function () {
                    this.closest('tr').remove();
                };
            });
        }

        addBtn.addEventListener('click', function () {
            optionRows.insertAdjacentHTML('beforeend', optionRowTemplate(optionIndex));
            optionIndex++;
            bindRemoveOptionButtons();
        });

        typeEl.addEventListener('change', toggleConditionalSections);

        formEl.addEventListener('submit', function (event) {
            if (typeEl.value === 'checkbox') {
                var minSelection = parseInt(document.getElementById('min_selection').value || '0', 10);
                var maxSelection = parseInt(document.getElementById('max_selection').value || '0', 10);

                if (minSelection < 0 || maxSelection < 0) {
                    alert('<?= $block->escapeJs(__('Min/Max selection cannot be negative.')) ?>');
                    event.preventDefault();
                    return;
                }

                if (minSelection > maxSelection) {
                    alert('<?= $block->escapeJs(__('Min selection cannot be greater than max selection.')) ?>');
                    event.preventDefault();
                    return;
                }
            }

            if (optionBasedTypes.indexOf(typeEl.value) !== -1) {
                var hasAnyOption = false;
                optionRows.querySelectorAll('tr').forEach(function (row) {
                    var titleInput = row.querySelector('input[name*="[title]"]');
                    var valueInput = row.querySelector('input[name*="[value]"]');
                    var hasTitle = titleInput && titleInput.value.trim() !== '';
                    var hasValue = valueInput && valueInput.value.trim() !== '';
                    if (hasTitle || hasValue) {
                        hasAnyOption = true;
                    }
                });

                if (!hasAnyOption) {
                    alert('<?= $block->escapeJs(__('Please add at least one option for this question type.')) ?>');
                    event.preventDefault();
                }
            }
        });

        bindRemoveOptionButtons();
        toggleConditionalSections();
    });
</script>
