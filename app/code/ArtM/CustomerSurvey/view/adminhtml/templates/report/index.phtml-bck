<?php

/** @var \ArtM\CustomerSurvey\Block\Adminhtml\Report\Index $block */
$listing = $block->getListingData();
$detail = $block->getDetailData();
$items = $listing['items'] ?? [];
$totals = $listing['totals'] ?? ['impressions' => 0, 'opens' => 0, 'responses' => 0];
$trend = $listing['trend'] ?? [];

$impressions = (int)($totals['impressions'] ?? 0);
$opens = (int)($totals['opens'] ?? 0);
$responses = (int)($totals['responses'] ?? 0);
$base = $impressions;
$completionRate = $base > 0 ? ($responses * 100) / $base : 0;
?>
<div class="customersurvey-report-wrap">
    <style>
