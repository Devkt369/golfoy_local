                grid-template-columns: 1fr;
            }
        }
    </style>

    <div class="customersurvey-head">
        <form method="get" action="<?= $block->escapeUrl($block->getUrl('customersurvey/report/index')) ?>" class="customersurvey-filters">
            <label>From</label>
            <input type="date" name="from_date" value="<?= $block->escapeHtmlAttr($block->getFromDate()) ?>" />
            <label>To</label>
            <input type="date" name="to_date" value="<?= $block->escapeHtmlAttr($block->getToDate()) ?>" />
            <label>Survey</label>
            <select name="survey_id">
                <option value="0">All</option>
                <?php foreach ($items as $item): ?>
                    <option value="<?= (int)$item['survey_id'] ?>" <?= ((int)$block->getSelectedSurveyId() === (int)$item['survey_id']) ? 'selected' : '' ?>>
                        <?= $block->escapeHtml((string)$item['name']) ?>
                    </option>
                <?php endforeach; ?>
            </select>
            <button type="submit" class="customersurvey-btn">Apply</button>
        </form>

        <div style="display:flex; gap:8px;">
            <a class="customersurvey-btn" href="<?= $block->escapeUrl($block->getExportCsvUrl()) ?>">Export CSV</a>
            <a class="customersurvey-btn alt" href="<?= $block->escapeUrl($block->getExportExcelUrl()) ?>">Export Excel</a>
        </div>
