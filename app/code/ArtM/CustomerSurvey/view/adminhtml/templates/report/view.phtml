$detail = $block->getDetailData();
$survey = $detail['survey'] ?? [];
$totals = $detail['totals'] ?? ['impressions' => 0, 'opens' => 0, 'responses' => 0];
$answerDistribution = $detail['answer_distribution'] ?? [];
$locationAnalytics = $detail['location_performance'] ?? [];
$deviceAnalytics = $detail['device_analytics'] ?? [];
$customerTypeAnalytics = $detail['customer_type_analytics'] ?? [];
$dateTrend = $detail['date_trend'] ?? [];
$questionAnswerSplit = $detail['question_answer_split'] ?? [];
$responseUsers = $detail['response_users'] ?? ['items' => [], 'total' => 0, 'page' => 1, 'page_size' => 20];

$opens = (int)($totals['opens'] ?? 0);
$responses = (int)($totals['responses'] ?? 0);
$impressions = (int)($totals['impressions'] ?? 0);
$base = $impressions;
$completionRate = $base > 0 ? ($responses * 100) / $base : 0;

$answerGrouped = [];
$answerChartData = [];
foreach ($answerDistribution as $row) {
    $questionId = (int)($row['question_id'] ?? 0);
    $q = (string)($row['question_title'] ?? '');
    if ($q === '') {
        $q = 'Question';
    }
    $groupKey = ($questionId > 0 ? $questionId : md5($q)) . '::' . $q;
    if (!isset($answerGrouped[$groupKey])) {
        $chartDomId = 'customersurvey-answer-pie-' . ($questionId > 0 ? (string)$questionId : substr(md5($groupKey), 0, 12));
        $answerGrouped[$groupKey] = [
            'question_id' => $questionId,
            'question_title' => $q,
            'chart_dom_id' => $chartDomId,
            'rows' => [],
        ];
        $answerChartData[$groupKey] = [
            'question_id' => $questionId,
            'question_title' => $q,
            'chart_dom_id' => $chartDomId,
            'labels' => [],
            'values' => [],
        ];
    }
    $optionLabel = (string)($row['option_title'] ?? 'Text');
    $answerGrouped[$groupKey]['rows'][] = [
        'option' => (string)($row['option_title'] ?? 'Text'),
        'type' => (string)($row['answer_type'] ?? ''),
        'count' => (int)($row['answer_count'] ?? 0),
    ];
    $answerChartData[$groupKey]['labels'][] = $optionLabel;
    $answerChartData[$groupKey]['values'][] = (int)($row['answer_count'] ?? 0);
}

$responseItems = $responseUsers['items'] ?? [];
$responseTotal = (int)($responseUsers['total'] ?? 0);
$responsePage = (int)($responseUsers['page'] ?? 1);
$responsePageSize = (int)($responseUsers['page_size'] ?? 20);
$responsePages = max(1, (int)ceil($responseTotal / max(1, $responsePageSize)));
