<script>
(function () {
    var dateTrend = <?= /* @noEscape */ json_encode($dateTrend) ?> || [];
    var answers = <?= /* @noEscape */ json_encode($answerDistribution) ?> || [];
    var questionSplit = <?= /* @noEscape */ json_encode($questionAnswerSplit) ?> || [];
    var answerCharts = <?= /* @noEscape */ json_encode(array_values($answerChartData)) ?> || [];
    var piePalette = ['#1668a8', '#2d9a5f', '#f0a202', '#d95d39', '#7b61ff', '#27a0b5', '#d64f7f', '#8a6d3b'];

    function prepCanvas(canvas) {
        if (!canvas) { return null; }
        var ratio = window.devicePixelRatio || 1;
        var width = canvas.clientWidth || 500;
        var height = 280;
        canvas.width = Math.floor(width * ratio);
        canvas.height = Math.floor(height * ratio);
        var ctx = canvas.getContext('2d');
        ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
        ctx.clearRect(0, 0, width, height);
        return { ctx: ctx, width: width, height: height };
    }

    function drawNoData(canvas) {
        var c = prepCanvas(canvas);
        if (!c) { return; }
        c.ctx.fillStyle = '#6b7f96';
        c.ctx.font = '13px Arial';
        c.ctx.fillText('No data available', 14, 26);
    }

    function drawLineChart(canvas, labels, lines) {
        if (!labels.length || !lines.length) { drawNoData(canvas); return; }
        var c = prepCanvas(canvas);
        if (!c) { return; }
        var ctx = c.ctx;
        var w = c.width;
        var h = c.height;
        var left = 52, right = 14, top = 22, bottom = 56;
        var plotW = w - left - right;
        var plotH = h - top - bottom;

        var allValues = [];
        lines.forEach(function (line) {
            (line.values || []).forEach(function (v) { allValues.push(Number(v || 0)); });
        });
        var maxVal = Math.max.apply(null, allValues.concat([1]));

        ctx.strokeStyle = '#c8d6e5';
        ctx.beginPath();
        ctx.moveTo(left, top);
        ctx.lineTo(left, h - bottom);
        ctx.lineTo(w - right, h - bottom);
        ctx.stroke();

        var ticks = 5;
        ctx.fillStyle = '#566b82';
        ctx.font = '11px Arial';
        for (var t = 0; t <= ticks; t++) {
            var v = Math.round((maxVal / ticks) * t);
            var yTick = h - bottom - ((v / maxVal) * (plotH - 6));
            ctx.fillText(String(v), 8, yTick + 4);
            ctx.strokeStyle = '#edf3f9';
            ctx.beginPath();
            ctx.moveTo(left, yTick);
            ctx.lineTo(w - right, yTick);
            ctx.stroke();
        }

        ctx.fillStyle = '#3f556d';
        ctx.fillText('Count', 8, top - 6);
        ctx.fillText('Date', Math.max(left, (w / 2) - 12), h - 12);

        var xStep = labels.length > 1 ? (plotW / (labels.length - 1)) : 0;
        var labelEvery = Math.max(1, Math.ceil(labels.length / 8));
        for (var lx = 0; lx < labels.length; lx += labelEvery) {
            var xPos = left + (xStep * lx);
            var labelText = String(labels[lx] || '');
            ctx.fillStyle = '#566b82';
            ctx.font = '10px Arial';
            ctx.fillText(labelText, xPos - 22, h - bottom + 16);
        }

        lines.forEach(function (line) {
            var vals = line.values || [];
            ctx.strokeStyle = line.color || '#1668a8';
            ctx.lineWidth = 2;
            ctx.beginPath();
            vals.forEach(function (v, i) {
                var x = left + (plotW * (vals.length === 1 ? 0 : (i / (vals.length - 1))));
                var y = h - bottom - ((Number(v || 0) / maxVal) * (plotH - 6));
                if (i === 0) { ctx.moveTo(x, y); } else { ctx.lineTo(x, y); }
            });
            ctx.stroke();

            ctx.fillStyle = line.color || '#1668a8';
            vals.forEach(function (v, i) {
                var px = left + (plotW * (vals.length === 1 ? 0 : (i / (vals.length - 1))));
                var py = h - bottom - ((Number(v || 0) / maxVal) * (plotH - 6));
                ctx.beginPath();
                ctx.arc(px, py, 3, 0, Math.PI * 2);
                ctx.fill();
            });
        });
    }

    function drawPieChart(canvas, labels, values, colors) {
        if (!labels.length) { drawNoData(canvas); return; }
        var c = prepCanvas(canvas);
        if (!c) { return; }
        var ctx = c.ctx;
        var w = c.width;
        var h = c.height;
        var total = values.reduce(function (sum, v) { return sum + Number(v || 0); }, 0);
        if (total <= 0) { drawNoData(canvas); return; }

        var cx = Math.min(115, w * 0.26);
        var cy = h * 0.5;
        var radius = Math.min(78, h * 0.28);
        var start = -Math.PI / 2;

        for (var i = 0; i < values.length; i++) {
            var part = Number(values[i] || 0);
            var sweep = (part / total) * Math.PI * 2;
            ctx.beginPath();
            ctx.moveTo(cx, cy);
            ctx.fillStyle = colors[i % colors.length];
            ctx.arc(cx, cy, radius, start, start + sweep, false);
            ctx.closePath();
            ctx.fill();
            start += sweep;
        }

        var lx = Math.max(cx + radius + 18, w * 0.47);
        var ly = Math.max(18, cy - radius);
        labels.forEach(function (label, idx) {
            ctx.fillStyle = colors[idx % colors.length];
            ctx.fillRect(lx, ly + (idx * 18), 10, 10);
            ctx.fillStyle = '#334a62';
            ctx.font = '12px Arial';
            ctx.fillText(String(label), lx + 14, ly + 9 + (idx * 18));
        });
    }

    drawLineChart(
        document.getElementById('customersurvey-detail-trend'),
        dateTrend.map(function (x) { return x.date; }),
        [
            { values: dateTrend.map(function (x) { return Number(x.impressions || 0); }), color: '#98b8d8' },
            { values: dateTrend.map(function (x) { return Number(x.opens || 0); }), color: '#2d9a5f' },
            { values: dateTrend.map(function (x) { return Number(x.responses || 0); }), color: '#1668a8' }
        ]
    );

    questionSplit.forEach(function (q) {
        var canvas = document.getElementById('customersurvey-question-pie-' + String(q.question_id));
        if (!canvas) {
            return;
        }
        drawPieChart(
            canvas,
            ['Answered', 'Not Answered'],
            [Number(q.answered || 0), Number(q.not_answered || 0)],
            ['#2d9a5f', '#d8e3ef']
        );
    });

    answerCharts.forEach(function (chart) {
        var rawLabels = Array.isArray(chart.labels) ? chart.labels : [];
        var values = Array.isArray(chart.values) ? chart.values.map(function (v) { return Number(v || 0); }) : [];
        var total = values.reduce(function (sum, value) { return sum + value; }, 0);
        var chartId = String(chart.chart_dom_id || '');
        var canvas = document.getElementById(chartId);
        if (!canvas) {
            return;
        }

        var labels = rawLabels.map(function (label, idx) {
            var value = values[idx] || 0;
            var pct = total > 0 ? ((value * 100) / total) : 0;
            return String(label) + ' (' + pct.toFixed(1) + '%)';
        });

        drawPieChart(canvas, labels, values, piePalette);
    });

    var modal = document.getElementById('customersurvey-device-modal');
    var modalBody = document.getElementById('customersurvey-device-body');
    var closeBtn = document.getElementById('customersurvey-device-close');

    document.querySelectorAll('.js-device-details').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var details = {};
            try {
                details = JSON.parse(btn.getAttribute('data-details') || '{}');
            } catch (e) {
                details = {};
            }
            modalBody.innerHTML = '' +
                '<table class="customersurvey-grid">' +
                '<tr><th>IP Address</th><td>' + String(details.ip_address || '-') + '</td></tr>' +
                '<tr><th>Device</th><td>' + String(details.device || '-') + '</td></tr>' +
                '<tr><th>Browser</th><td>' + String(details.browser || '-') + '</td></tr>' +
                '</table>';
            modal.classList.add('is-open');
            modal.setAttribute('aria-hidden', 'false');
        });
    });

    function closeModal() {
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
    }

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', function (e) {
        if (e.target === modal) {
            closeModal();
        }
    });
})();
</script>
