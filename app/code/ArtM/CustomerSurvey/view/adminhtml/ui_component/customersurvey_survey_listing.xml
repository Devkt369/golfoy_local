<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">customersurvey_survey_listing.customersurvey_survey_listing_data_source</item>
            <item name="deps" xsi:type="string">customersurvey_survey_listing.customersurvey_survey_listing_data_source</item>
        </item>
        <item name="spinner" xsi:type="string">survey_columns</item>
        <item name="buttons" xsi:type="array">
            <item name="add" xsi:type="array">
                <item name="name" xsi:type="string">add</item>
                <item name="label" xsi:type="string" translate="true">Add New Survey Journey</item>
                <item name="class" xsi:type="string">primary</item>
                <item name="url" xsi:type="string">*/*/new</item>
            </item>
        </item>
    </argument>

    <dataSource name="customersurvey_survey_listing_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider</argument>
            <argument name="name" xsi:type="string">customersurvey_survey_listing_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">survey_id</argument>
            <argument name="requestFieldName" xsi:type="string">survey_id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="component" xsi:type="string">Magento_Ui/js/grid/provider</item>
                    <item name="update_url" xsi:type="url" path="mui/index/render"/>
                    <item name="storageConfig" xsi:type="array">
                        <item name="indexField" xsi:type="string">survey_id</item>
                    </item>
                </item>
            </argument>
        </argument>
    </dataSource>

    <listingToolbar name="listing_top">
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <settings>
                <selectProvider>customersurvey_survey_listing.customersurvey_survey_listing.survey_columns.ids</selectProvider>
                <indexField>survey_id</indexField>
            </settings>
            <action name="delete">
                <settings>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                    <url path="customersurvey/survey/massDelete"/>
                    <confirm>
                        <title translate="true">Delete Survey Journeys</title>
                        <message translate="true">Are you sure you want to delete selected survey journeys?</message>
                    </confirm>
                </settings>
            </action>
            <action name="set_draft">
                <settings>
                    <type>set_draft</type>
                    <label translate="true">Set Draft</label>
                    <url path="customersurvey/survey/massStatus">
                        <param name="status">draft</param>
                    </url>
                </settings>
            </action>
            <action name="set_active">
                <settings>
                    <type>set_active</type>
                    <label translate="true">Set Active</label>
                    <url path="customersurvey/survey/massStatus">
                        <param name="status">active</param>
                    </url>
                </settings>
            </action>
            <action name="set_disabled">
                <settings>
                    <type>set_disabled</type>
                    <label translate="true">Set Disabled</label>
                    <url path="customersurvey/survey/massStatus">
                        <param name="status">disabled</param>
                    </url>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>

    <columns name="survey_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>survey_id</indexField>
            </settings>
        </selectionsColumn>

        <column name="survey_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <sorting>desc</sorting>
                <label translate="true">ID</label>
            </settings>
        </column>

        <column name="name" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Name</label>
            </settings>
        </column>

        <column name="status" component="Magento_Ui/js/grid/columns/select" sortOrder="30">
            <settings>
                <filter>select</filter>
                <options class="ArtM\CustomerSurvey\Model\Source\SurveyStatus"/>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>

        <column name="priority" sortOrder="40">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Priority</label>
            </settings>
        </column>

        <column name="timeline" sortOrder="50">
            <settings>
                <filter>false</filter>
                <label translate="true">Timeline</label>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
            </settings>
        </column>

        <column name="question_count" sortOrder="60">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Number of Questions</label>
            </settings>
        </column>

        <column name="location_count" sortOrder="70">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Number of Locations</label>
            </settings>
        </column>

        <column name="updated_at" class="Magento\Ui\Component\Listing\Columns\Date" sortOrder="80">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Updated At</label>
            </settings>
        </column>

        <actionsColumn name="actions" class="ArtM\CustomerSurvey\Ui\Component\Listing\Column\SurveyActions" sortOrder="100">
            <settings>
                <indexField>survey_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
