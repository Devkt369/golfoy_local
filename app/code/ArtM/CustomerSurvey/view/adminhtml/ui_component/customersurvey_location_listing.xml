<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">customersurvey_location_listing.customersurvey_location_listing_data_source</item>
            <item name="deps" xsi:type="string">customersurvey_location_listing.customersurvey_location_listing_data_source</item>
        </item>
        <item name="spinner" xsi:type="string">locations_columns</item>
        <item name="buttons" xsi:type="array">
            <item name="add" xsi:type="array">
                <item name="name" xsi:type="string">add</item>
                <item name="label" xsi:type="string" translate="true">Add New Location</item>
                <item name="class" xsi:type="string">primary</item>
                <item name="url" xsi:type="string">*/*/new</item>
            </item>
        </item>
    </argument>

    <dataSource name="customersurvey_location_listing_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider</argument>
            <argument name="name" xsi:type="string">customersurvey_location_listing_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">location_id</argument>
            <argument name="requestFieldName" xsi:type="string">location_id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="component" xsi:type="string">Magento_Ui/js/grid/provider</item>
                    <item name="update_url" xsi:type="url" path="mui/index/render"/>
                    <item name="storageConfig" xsi:type="array">
                        <item name="indexField" xsi:type="string">location_id</item>
                    </item>
                </item>
            </argument>
        </argument>
    </dataSource>

    <listingToolbar name="listing_top">
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <settings>
                <selectProvider>customersurvey_location_listing.customersurvey_location_listing.locations_columns.ids</selectProvider>
                <indexField>location_id</indexField>
            </settings>
            <action name="delete">
                <settings>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                    <url path="customersurvey/location/massDelete"/>
                    <confirm>
                        <title translate="true">Delete Locations</title>
                        <message translate="true">Are you sure you want to delete selected locations?</message>
                    </confirm>
                </settings>
            </action>
            <action name="enable">
                <settings>
                    <type>enable</type>
                    <label translate="true">Enable</label>
                    <url path="customersurvey/location/massStatus">
                        <param name="status">1</param>
                    </url>
                </settings>
            </action>
            <action name="disable">
                <settings>
                    <type>disable</type>
                    <label translate="true">Disable</label>
                    <url path="customersurvey/location/massStatus">
                        <param name="status">0</param>
                    </url>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>

    <columns name="locations_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>location_id</indexField>
            </settings>
        </selectionsColumn>

        <column name="location_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <sorting>desc</sorting>
                <label translate="true">ID</label>
            </settings>
        </column>

        <column name="name" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Name</label>
            </settings>
        </column>

        <column name="page_type" sortOrder="30">
            <settings>
                <filter>select</filter>
                <options class="ArtM\CustomerSurvey\Model\Source\PageType"/>
                <dataType>select</dataType>
                <label translate="true">Page Type</label>
            </settings>
        </column>

        <column name="css_selector" sortOrder="40">
            <settings>
                <filter>text</filter>
                <label translate="true">CSS Selector</label>
            </settings>
        </column>

        <column name="position" sortOrder="50">
            <settings>
                <filter>select</filter>
                <options class="ArtM\CustomerSurvey\Model\Source\Position"/>
                <dataType>select</dataType>
                <label translate="true">Position</label>
            </settings>
        </column>

        <column name="status" component="Magento_Ui/js/grid/columns/select" sortOrder="60">
            <settings>
                <filter>select</filter>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>

        <column name="updated_at" class="Magento\Ui\Component\Listing\Columns\Date" sortOrder="70">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Updated At</label>
            </settings>
        </column>

        <actionsColumn name="actions" class="ArtM\CustomerSurvey\Ui\Component\Listing\Column\LocationActions" sortOrder="100">
            <settings>
                <indexField>location_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
