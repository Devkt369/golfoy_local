<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="artm_customersurvey_aggregate_analytics"
             instance="ArtM\CustomerSurvey\Cron\AggregateAnalytics"
             method="execute">
            <schedule>15 * * * *</schedule>
        </job>
        <job name="artm_customersurvey_cleanup_analytics"
             instance="ArtM\CustomerSurvey\Cron\CleanupAnalytics"
             method="execute">
            <schedule>30 2 * * *</schedule>
        </job>
    </group>
</config>
