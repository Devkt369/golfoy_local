<script type="text/javascript">
    require(['jquery'],function(jQuery){
        jQuery(document).ready(function() {
            setCustomTooltipPosition();
                jQuery('span.tooltiptexts').attr('scrolling_c' , 'no' );
            jQuery(window).scroll(function(){
                setCustomTooltipPosition();
                jQuery('span.tooltiptexts').attr('scrolling_c' , 'yes' );
                
            });
            function setCustomTooltipPosition(){
                jQuery('span.tooltiptexts').each(function(){
                    var left_scroll = jQuery(this).offset().left;
                    jQuery(this).attr('left' , left_scroll);
                    
                    var window_width = jQuery(window).width();
                    var tooltip_width = jQuery(this).width();
                    
                    jQuery(this).attr('ats' , left_scroll +" - "+ window_width + " - " + tooltip_width);
                    
                    
                    if( (window_width - tooltip_width) < left_scroll){
                        jQuery(this).attr('on_right' , 'yes' + (window_width - tooltip_width) < left_scroll);
                        var should_left_step1 = window_width - left_scroll;
                        var should_left_step2 = tooltip_width - should_left_step1;
                        
//                        jQuery(this).css('left' , (left_scroll - should_left_step2));
                        
                        
                        jQuery(this).css('right' , 0);
                    }else{
                        jQuery(this).attr('on_right' , 'no' + (window_width - tooltip_width) < left_scroll);
                    }
                    if( left_scroll < 10){
                        jQuery(this).css('left' , 0);
                        
                    }
                    
                });
            }
        });
    });
</script>



<?php $objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$helper = $objectManager->get('\ArtM\ProductFeatures\Helper\Data');
$viewModel = $block->getData('viewModel');
$product = $viewModel->getProduct();
$attrs = $viewModel->getFeaturedAttr();

$blockhtml= $this->getLayout()
->createBlock('Magento\Cms\Block\Block')
->setBlockId('product_feature_data')
->toHtml();

$multiselectarray = [];
$selectarray = [];
$boolarray = [];
foreach ($attrs as $attr){
    $attr = trim($attr);
    if($attr !='' && $product->hasData($attr)){
        $attrdata = $viewModel->getAttrdata($attr);
        $type = $attrdata['type'];
        $label = $attrdata['label'];
        $selOption = $product->getAttributeText($attr);
        if($selOption != '' ){
            $tmparray = ['label' => $label, 'attr' => $attr, 'selOption' => $selOption, 'blockhtml' => $blockhtml];
            if($type == 'multiselect'){           
                $multiselectarray[] = $tmparray;
            }elseif($type == 'boolean'){
                $boolarray[] =  $tmparray;
            }else{
                $selectarray[] =  $tmparray;
            }
        }
    }
}
echo '<div class="features-attr-div row col-lg-12 col-md-12 col-sm-12 col-xs-12">';
if (count($selectarray) > 1 || count($boolarray) > 1 || count($multiselectarray) > 1) {
    echo '<div class="features_title"><p>THE FINER DETAILS</p></div>';
} else {
    echo '<div class="features_title" style="display: none;"><p>THE FINER DETAILS</p></div>';
}

foreach ($selectarray as $V) {
    echo '<div class="feature-attr-item col-lg-2 col-md-2 col-sm-4 col-xs-6">';
    echo $helper->getSelecthtml($V['label'], $V['attr'], $V['selOption'], $V['blockhtml']);
    echo "</div>";
}
foreach ($boolarray as $V) {
    if (strtolower($V['selOption']) != 'no') {
        echo '<div class="feature-attr-item col-lg-2 col-md-2 col-sm-4 col-xs-6">';
        echo $helper->getBoolhtml($V['label'], $V['attr'], $V['selOption'], $V['blockhtml']);
        echo "</div>";
    }
}
foreach ($multiselectarray as $V) {
    echo $helper->getMultiselecthtml($V['label'], $V['attr'], $V['selOption'], $V['blockhtml']);
}

echo "</div>";

