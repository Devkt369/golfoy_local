$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$resource = $objectManager->get('Magento\\Framework\\App\\ResourceConnection');
$connection = $resource->getConnection();

// Pagination logic
$productTable = $resource->getTableName('artm_pricecompare_product');
$perPage = isset($_GET['per_page']) ? (int)$_GET['per_page'] : 50;
if (!in_array($perPage, [50, 100, 200])) $perPage = 50;
$page = isset($_GET['page']) ? (int)$_GET['page'] : 1;
if ($page < 1) $page = 1;
$totalProducts = (int)$connection->fetchOne("SELECT COUNT(*) FROM $productTable");
$totalPages = max(1, ceil($totalProducts / $perPage));
$offset = ($page - 1) * $perPage;

$productRows = $connection->fetchAll("SELECT * FROM $productTable ORDER BY name ASC LIMIT $perPage OFFSET $offset");
// Fetch all categories
$catTable = $resource->getTableName('artm_pricecompare_category');
$categoryMap = [];
foreach ($connection->fetchAll("SELECT category_id, name FROM $catTable") as $row) {
	$categoryMap[$row['category_id']] = $row['name'];
}

// Fetch all websites
$websiteTable = $resource->getTableName('artm_pricecompare_website');
$websites = $connection->fetchAll("SELECT * FROM $websiteTable ORDER BY name ASC");
$websiteMap = [];
foreach ($websites as $w) {
	$websiteMap[$w['website_id']] = $w;
}

// Fetch all attribute selectors
$attrTable = $resource->getTableName('artm_pricecompare_attribute_selector');
$attrRows = $connection->fetchAll("SELECT * FROM $attrTable ORDER BY website_id, attribute_name ASC");

// Group attributes by product and website
$attrMap = [];
foreach ($attrRows as $row) {
	$attrMap[$row['website_id']][$row['attribute_name']] = $row['selector'];
}

