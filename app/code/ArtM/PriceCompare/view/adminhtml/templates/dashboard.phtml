<script>
// Select all products checkbox
document.addEventListener('DOMContentLoaded', function() {
	var formKey = '<?= $block->getFormKey() ?>';
	var selectAll = document.getElementById('select-all-products');
	if (selectAll) {
		selectAll.addEventListener('change', function() {
			var checkboxes = document.querySelectorAll('.select-product');
			checkboxes.forEach(function(cb) { cb.checked = selectAll.checked; });
		});
	}
	// Sync All button
	document.getElementById('sync-all-btn').addEventListener('click', function() {
		var ids = Array.from(document.querySelectorAll('.select-product:checked')).map(cb => cb.value);
		if (ids.length === 0) { alert('Select at least one product to sync.'); return; }
		// TODO: Implement bulk sync logic here
		alert('Syncing products: ' + ids.join(', '));
	});
	// Sync Now buttons
	document.querySelectorAll('.sync-now-btn').forEach(function(btn) {
		btn.addEventListener('click', function() {
			var pid = btn.getAttribute('data-product-id');
			var row = btn.closest('tr');
			var actionCell = btn.closest('td');
			var rowSpan = actionCell ? parseInt(actionCell.getAttribute('rowspan') || '1', 10) : 1;
			var productRows = [row];
			var nextRow = row;
			for (var i = 1; i < rowSpan; i++) {
				nextRow = nextRow ? nextRow.nextElementSibling : null;
				if (!nextRow) {
					break;
				}
				productRows.push(nextRow);
			}

			var websiteIds = <?php echo json_encode(array_column($websites, 'website_id')); ?>;
			var originalText = btn.textContent;
			btn.textContent = 'Syncing...';
			btn.disabled = true;

			function syncNext(index) {
				if (index >= websiteIds.length) {
					btn.textContent = originalText;
					btn.disabled = false;
					return;
				}
				var websiteId = websiteIds[index];
				var websiteCells = productRows.map(function(r) {
					return r.querySelector('[data-website-id="' + websiteId + '"]');
				}).filter(function(c) {
					return !!c;
				});

				if (!websiteCells.length) { syncNext(index + 1); return; }

				var requestCell = websiteCells.find(function(c) {
					return c.getAttribute('data-selectors') && c.getAttribute('data-url');
				}) || websiteCells[0];

				var selectors = requestCell.getAttribute('data-selectors');
				var url = requestCell.getAttribute('data-url');
				if (!selectors || !url) { syncNext(index + 1); return; }
				fetch('<?= $block->getUrl("*/*/ajaxSyncProduct") ?>', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/x-www-form-urlencoded',
						'X-Requested-With': 'XMLHttpRequest',
					},
					body: 'form_key=' + encodeURIComponent(formKey) +
						  '&product_id=' + encodeURIComponent(pid) +
						  '&website_id=' + encodeURIComponent(websiteId) +
						  '&selectors=' + encodeURIComponent(selectors) +
						  '&url=' + encodeURIComponent(url)
				})
				.then(r => r.json())
				.then(function(resp) {
					if (resp.success) {
						var values = resp.value || {};
						if (typeof values === 'object') {
							websiteCells.forEach(function(cell) {
								cell.querySelectorAll('.fetched-value').forEach(function(span) {
									var attrName = span.getAttribute('data-attr-name');
									var newVal = values[attrName];
									var oldVal = span.textContent;
									if (Array.isArray(newVal) || newVal === undefined || newVal === null || newVal === '' || newVal === 'null') {
										if (oldVal && oldVal !== '(not synced)' && oldVal.indexOf(' - old') === -1) {
											span.textContent = oldVal + ' - old';
										} else if (!oldVal || oldVal === '(not synced)') {
											span.textContent = '(not synced)';
										}
									} else {
										span.textContent = newVal;
									}
								});
							});
						}
						websiteCells.forEach(function(cell) {
							cell.style.background = '#eaffea';
							setTimeout(function(){ cell.style.background = ''; }, 1200);
						});
					} else {
						alert('Sync error: ' + (resp.error || 'Unknown error'));
					}
				})
				.finally(function() {
					syncNext(index + 1);
				});
			}
			syncNext(0);
		});
	});
});
</script>
</table>