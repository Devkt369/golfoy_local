    <script type="text/javascript">
    // Use correct URLs for each AJAX endpoint
    var ajaxWebsitesUrl = '<?= $block->getUrl("pricecompare/ajax/websites") ?>';
    var ajaxListdataUrl = '<?= $block->getUrl("pricecompare/ajax/listdata") ?>';
    var ajaxBrandUrl = '<?= $block->getUrl("pricecompare/ajax/brand") ?>';
    var ajaxCategoryUrl = '<?= $block->getUrl("pricecompare/ajax/category") ?>';
    require(['jquery'], function($) {
        $(function() {
            // Debug: Print AJAX URLs for manual testing
            console.log('Websites AJAX: GET', ajaxWebsitesUrl);
            // Populate websites
            $.ajax({
                url: ajaxWebsitesUrl,
                type: 'GET',
                dataType: 'json',
                showLoader: true,
                success: function(resp) {
                    console.log('Websites AJAX response:', resp);
                    if(resp.success && resp.websites) {
                        var select = $('#websites');
                        select.empty();
                        $.each(resp.websites, function(i, w) {
                            select.append('<option value="'+w.website_id+'">'+w.name+'</option>');
                        });
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Websites AJAX error:', status, error, xhr.responseText);
                }
            });
            // Debug: Print Brands AJAX request for manual testing
            console.log('Brands AJAX: GET', ajaxListdataUrl, {type: 'brand'});
            // Populate brands
            $.ajax({
                url: ajaxListdataUrl,
                type: 'GET',
                data: {type: 'brand'},
                dataType: 'json',
                showLoader: true,
                success: function(resp) {
                    console.log('Brands AJAX response:', resp);
                    if(resp.success && resp.items) {
                        var select = $('#brand');
                        select.empty();
                        $.each(resp.items, function(i, item) {
                            select.append('<option value="'+item.brand_id+'">'+item.name+'</option>');
                        });
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Brands AJAX error:', status, error, xhr.responseText);
                }
            });
            // Debug: Print Categories AJAX request for manual testing
            console.log('Categories AJAX: GET', ajaxListdataUrl, {type: 'category'});
            // Populate categories
            $.ajax({
                url: ajaxListdataUrl,
                type: 'GET',
                data: {type: 'category'},
                dataType: 'json',
                showLoader: true,
                success: function(resp) {
                    console.log('Categories AJAX response:', resp);
                    if(resp.success && resp.items) {
                        var select = $('#category');
                        select.empty();
                        $.each(resp.items, function(i, item) {
                            select.append('<option value="'+item.category_id+'">'+item.name+'</option>');
                        });
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Categories AJAX error:', status, error, xhr.responseText);
                }
            });
        });
    });
    </script>
