    <tbody>
        <?php
        $objectManager = \Magento\Framework\App\ObjectManager::getInstance();
        $productCollection = $objectManager->create('ArtM\\PriceCompare\\Model\\ResourceModel\\Product\\Collection');
        // Preload brand, category, and website names
        $brandMap = [];
        $categoryMap = [];
        $websiteMap = [];
        $resource = $objectManager->get('Magento\\Framework\\App\\ResourceConnection');
        $connection = $resource->getConnection();
        foreach ($connection->fetchAll('SELECT brand_id, name FROM ' . $resource->getTableName('artm_pricecompare_brand')) as $row) {
            $brandMap[$row['brand_id']] = $row['name'];
        }
        foreach ($connection->fetchAll('SELECT category_id, name FROM ' . $resource->getTableName('artm_pricecompare_category')) as $row) {
            $categoryMap[$row['category_id']] = $row['name'];
        }
        foreach ($connection->fetchAll('SELECT website_id, name FROM ' . $resource->getTableName('artm_pricecompare_website')) as $row) {
            $websiteMap[$row['website_id']] = $row['name'];
        }
        foreach ($productCollection as $product): ?>
        <tr>
            
            <td><?= $product->getId() ?></td>
            <td><?php if ($product->getImage()): ?><img src="<?= $block->getBaseUrl(['_type' => \Magento\Framework\UrlInterface::URL_TYPE_MEDIA]) ."media/". $product->getImage() ?>" width="50" /><?php endif; ?></td>
            <td><?= $product->getName() ?></td>
            <td><?= $product->getSku() ?></td>
            
            <td><?= isset($brandMap[$product->getBrandId()]) ? $brandMap[$product->getBrandId()] : $product->getBrandId() ?></td>
            <td><?= isset($categoryMap[$product->getCategoryId()]) ? $categoryMap[$product->getCategoryId()] : $product->getCategoryId() ?></td>
            <td>
                <?php
                $table = $resource->getTableName('artm_pricecompare_product_website');
                $websiteIds = $connection->fetchCol('SELECT website_id FROM ' . $table . ' WHERE product_id = ?', [$product->getId()]);
                $websiteNames = [];
                foreach ($websiteIds as $wid) {
                    $websiteNames[] = isset($websiteMap[$wid]) ? $websiteMap[$wid] : $wid;
                }
                echo implode(', ', $websiteNames);
                ?>
            </td>
            <td><?= $product->getCustomSelector() ?></td>
            <td>
                <a href="#" class="action-edit">Edit</a> |
                <a href="#" class="action-delete">Delete</a>
            </td>
        </tr>
        <?php endforeach; ?>
    </tbody>
</table>