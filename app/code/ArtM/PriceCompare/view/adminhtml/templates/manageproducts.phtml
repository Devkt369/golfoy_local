<h1>Products</h1>
<table class="admin__table-primary">
	<thead>
		<tr>
			<th>ID</th>
			<th>Name</th>
			<th>SKU</th>
			<th>Image</th>
			<th>Brand</th>
			<th>Category</th>
			<th>Websites</th>
			<th>Actions</th>
		</tr>
	</thead>
	<tbody>
		<?php
		$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
		$collection = $objectManager->create('ArtM\\PriceCompare\\Model\\ResourceModel\\Product\\Collection');
		foreach ($collection as $product): ?>
		<tr>
			<td><?= $product->getId() ?></td>
			<td><?= $product->getName() ?></td>
			<td><?= $product->getSku() ?></td>
			<td><?php if ($product->getImage()): ?><img src="<?= $block->getBaseUrl(['_type' => \Magento\Framework\UrlInterface::URL_TYPE_MEDIA]) . $product->getImage() ?>" width="50"/><?php endif; ?></td>
			<td><?= $product->getBrandId() ?></td>
			<td><?= $product->getCategoryId() ?></td>
			<td>
				<?php
				$resource = $objectManager->get('Magento\\Framework\\App\\ResourceConnection');
				$connection = $resource->getConnection();
				$table = $resource->getTableName('artm_pricecompare_product_website');
				$websites = $connection->fetchCol('SELECT website_id FROM ' . $table . ' WHERE product_id = ?', [$product->getId()]);
				echo implode(',', $websites);
				?>
			</td>
			<td>
				<a href="#" class="action-edit">Edit</a> |
				<a href="#" class="action-delete">Delete</a>
			</td>
		</tr>
		<?php endforeach; ?>
	</tbody>
</table>
<br />
<?php include($block->getTemplateFile('ArtM_PriceCompare::product_form.phtml')); ?>