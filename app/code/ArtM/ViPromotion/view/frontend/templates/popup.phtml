<div id="vipromotion-popup-overlay" class="vipromotion-popup-overlay" style="display:none;">
    <div class="vipromotion-popup-container">
        <button class="vipromotion-popup-close" id="vipromotion-popup-close">&times;</button>
        <div id="vipromotion-popup-content"></div>
    </div>
</div>

<script>
    require(['jquery', 'domReady!'], function($) {

        function initPopup(data) {
            // console.log('From Event FULL:', JSON.stringify(data, null, 2));

            // ❌ If not eligible → stop
            if (!data || !data.success || !data.show_popup) {
                return;
            }

            var today = new Date().toISOString().split('T')[0];
            var storageKey = 'vipromotion_popup_' + today;

            // Already closed today
            if (localStorage.getItem(storageKey) === 'closed') {
                return;
            }

            // ✅ Set content
            $('#vipromotion-popup-content').html(data.popup_content);

            // Show popup
            setTimeout(function() {
                $('#vipromotion-popup-overlay').fadeIn(300);
            }, 1000);

            function closePopup() {
                $('#vipromotion-popup-overlay').fadeOut(300);
                localStorage.setItem(storageKey, 'closed');
            }

            // Close handlers
            $('#vipromotion-popup-close').on('click', closePopup);

            $('#vipromotion-popup-overlay').on('click', function(e) {
                if (e.target === this) closePopup();
            });

            $(document).on('keyup', function(e) {
                if (e.keyCode === 27) closePopup();
            });
        }

        // ✅ CASE 1: Data already available
        if (window.vipcustomerData) {
            initPopup(window.vipcustomerData);
        }

        $(document).on('vipcustomerDataLoaded', function(e, data) {
            initPopup(data);
            // console.log('From Event:', data);
        });


    });
</script>


