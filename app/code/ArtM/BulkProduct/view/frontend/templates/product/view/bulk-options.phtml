    <script>
        function increaseQty(productId) {
            var input = document.getElementById('qty_' + productId);
            var currentVal = parseInt(input.value) || 0;
            var maxQty = parseInt(input.getAttribute('data-max-qty')) || 999;

            if (currentVal < maxQty) {
                input.value = currentVal + 1;
                validateAndUpdate(input);
            }
        }

        function decreaseQty(productId) {
            var input = document.getElementById('qty_' + productId);
            var currentVal = parseInt(input.value) || 0;

            if (currentVal > 0) {
                input.value = currentVal - 1;
                validateAndUpdate(input);
            }
        }

        function validateAndUpdate(input) {
            var qty = parseInt(input.value) || 0;
            var maxQty = parseInt(input.getAttribute('data-max-qty')) || 999;
            var productId = input.getAttribute('data-product-id');
            var errorDiv = document.getElementById('error_' + productId);

            // Clear previous error
            errorDiv.style.display = 'none';

            // Validate quantity
            if (qty > maxQty) {
                input.value = maxQty;
                errorDiv.textContent = 'Maximum available quantity is ' + maxQty + '. Quantity adjusted.';
                errorDiv.style.display = 'block';

                setTimeout(function() {
                    errorDiv.style.display = 'none';
                }, 3000);
            } else if (qty < 0) {
                input.value = 0;
            }

            // Update button states
            updateButtons(productId);
            updateTotals();
        }

        function updateButtons(productId) {
            var input = document.getElementById('qty_' + productId);
            var currentVal = parseInt(input.value) || 0;
            var maxQty = parseInt(input.getAttribute('data-max-qty')) || 999;

            var minusBtn = input.parentNode.querySelector('.qty-minus');
            var plusBtn = input.parentNode.querySelector('.qty-plus');

            minusBtn.disabled = currentVal <= 0;
            plusBtn.disabled = currentVal >= maxQty;
        }

        function updateTotals() {
            var totalQty = 0;
            var totalPrice = 0;

            var inputs = document.querySelectorAll('.bulk-quantity-input');
            inputs.forEach(function(input) {
                var qty = parseInt(input.value) || 0;
                var price = parseFloat(input.getAttribute('data-price')) || 0;

                totalQty += qty;
                totalPrice += (qty * price);
            });

            document.getElementById('bulk-total-qty').textContent = totalQty;
            document.getElementById('bulk-total-price').textContent = '₹' + totalPrice.toFixed(2);

            // Enable/disable add to cart button
            var addToCartBtn = document.getElementById('bulk-add-to-cart-btn');
            addToCartBtn.disabled = totalQty === 0;
        }

        // Initialize button states on load
        document.addEventListener('DOMContentLoaded', function() {
            var inputs = document.querySelectorAll('.bulk-quantity-input');
            inputs.forEach(function(input) {
                var productId = input.getAttribute('data-product-id');
                updateButtons(productId);
            });
            updateTotals();
        });

        // Clear all function
        function clearAllQuantities() {
            var inputs = document.querySelectorAll('.bulk-quantity-input');
            inputs.forEach(function(input) {
                input.value = 0;
                var productId = input.getAttribute('data-product-id');
                document.getElementById('error_' + productId).style.display = 'none';
                updateButtons(productId);
            });
            updateTotals();
        }
    </script>

