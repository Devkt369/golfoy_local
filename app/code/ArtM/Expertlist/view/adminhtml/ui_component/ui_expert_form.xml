<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">ui_expert_form.artm_expertlist_form_data_source</item>
            <item name="deps" xsi:type="string">ui_expert_form.artm_expertlist_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Form Information</item>
        <item name="config" xsi:type="array">
            <item name="dataScope" xsi:type="string">data</item>
            <item name="namespace" xsi:type="string">ui_expert_form</item>
        </item>
        <item name="buttons" xsi:type="array">
            <item name="back" xsi:type="string">ArtM\Expertlist\Block\Adminhtml\Button\Back</item>
            <item name="reset" xsi:type="string">ArtM\Expertlist\Block\Adminhtml\Button\Reset</item>
            <item name="delete" xsi:type="string">ArtM\Expertlist\Block\Adminhtml\Button\Delete</item>
            <item name="save" xsi:type="string">ArtM\Expertlist\Block\Adminhtml\Button\Save</item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <dataSource name="artm_expertlist_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">ArtM\Expertlist\Model\Grid\DataProvider</argument>
            <argument name="name" xsi:type="string">artm_expertlist_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">id</argument>
            <argument name="requestFieldName" xsi:type="string">id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="submit_url" xsi:type="url" path="*/*/save" />
                </item>
            </argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
    </dataSource>
    <fieldset name="general_information">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="collapsible" xsi:type="boolean">false</item>
                <item name="label" xsi:type="string" translate="true">General Information</item>
                <item name="sortOrder" xsi:type="number">10</item>
            </item>
        </argument>
        <field name="expert_name">
            <argument name="data" xsi:type="array">
                <item name="submit_url" xsi:type="url" path="artm_expertlist/ExpertData/index" />
                <item name="component" xsi:type="string">
                    ArtM_Expertlist/js/form/element/expert-selector</item>
                <item name="options" xsi:type="object">
                    ArtM\Expertlist\Model\Config\Source\ExpertNames</item>
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Expert name</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="source" xsi:type="string">expert_name</item>
                    <item name="dataScope" xsi:type="string">expert_name</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="designation">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Designation</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">designation</item>
                    <item name="dataScope" xsi:type="string">designation</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>

        <field name="role">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Role</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">role</item>
                    <item name="dataScope" xsi:type="string">role</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="image_url">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Image Url</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">image_url</item>
                    <item name="dataScope" xsi:type="string">image_url</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="expert_email">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Expert E-mail</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">expert_email</item>
                    <item name="dataScope" xsi:type="string">expert_email</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
    </fieldset>
</form>