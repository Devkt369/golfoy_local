<?php

/** @var $block ArtM\Forms\Block\Adminhtml\Submissions */
$formIdentifiers = $block->getIdentifiersWithNames();
$formStats = $block->getFormSubmissionStats();
$selectedIdentifier = isset($_GET['form_identifier']) ? $_GET['form_identifier'] : ($formIdentifiers[0]['identifier'] ?? null);
$formFieldNames = $selectedIdentifier ? $block->getFormFields($selectedIdentifier) : [];
// Pagination, sorting, filters
$page = isset($_GET['page']) ? max(1, (int)$_GET['page']) : 1;
$pageSize = isset($_GET['page_size']) ? max(1, (int)$_GET['page_size']) : 20;
$sortField = $_GET['sort_field'] ?? 'created_at';
$sortDir = strtoupper($_GET['sort_dir'] ?? 'DESC');
if (!in_array($sortDir, ['ASC', 'DESC'])) $sortDir = 'DESC';
$filters = [];
foreach ($formFieldNames as $key) {
  $filters[$key] = $_GET['filter_' . $key] ?? '';
}
$params = [
  'page' => $page,
  'page_size' => $pageSize,
  'sort_field' => $sortField,
  'sort_dir' => $sortDir,
  'filters' => $filters,
];
$submissions = $selectedIdentifier ? $block->getSubmissions($selectedIdentifier, $params) : [];
$totalCount = $selectedIdentifier ? $block->getTotalSubmissionsCount($selectedIdentifier, $params) : 0;
$totalPages = $pageSize > 0 ? ceil($totalCount / $pageSize) : 1;
function is_file_or_image($val)
{
  if (!is_string($val)) return false;
  return preg_match('/\.(jpg|jpeg|png|gif|webp|pdf|docx?|xlsx?|csv|zip|txt)$/i', $val);
}
function build_query($params, $overrides = [])
{
  $merged = array_merge($params, $overrides);
  return http_build_query($merged);
}
