    <script>
      (function() {
        var dropdownBtn = document.getElementById('customDropdownBtn');
        var dropdownList = document.getElementById('customDropdownList');
        var dropdownLabel = document.getElementById('customDropdownLabel');
        var dropdownBadge = document.getElementById('customDropdownBadge');
        var hiddenInput = document.getElementById('form_identifier');
        var items = dropdownList.querySelectorAll('.custom-dropdown-item');
        var selectedValue = hiddenInput.value;

        function updateSelectedDisplay() {
          var found = false;
          items.forEach(function(item) {
            if (item.getAttribute('data-value') === selectedValue) {
              var label = item.querySelector('span').innerText;
              var badge = item.querySelector('.custom-badge');
              dropdownLabel.textContent = label;
              dropdownBadge.innerHTML = badge ? badge.outerHTML : '';
              item.classList.add('active');
              found = true;
            } else {
              item.classList.remove('active');
            }
          });
          if (!found) {
            dropdownLabel.textContent = 'Select a form...';
            dropdownBadge.innerHTML = '';
            items[0].classList.add('active');
          }
        }
        updateSelectedDisplay();
        dropdownBtn.onclick = function(e) {
          e.preventDefault();
          dropdownList.style.display = dropdownList.style.display === 'block' ? 'none' : 'block';
        };
        items.forEach(function(item) {
          item.onclick = function() {
            hiddenInput.value = item.getAttribute('data-value');
            selectedValue = item.getAttribute('data-value');
            updateSelectedDisplay();
            dropdownList.style.display = 'none';
            if (selectedValue) dropdownBtn.form.submit();
          };
        });
        document.addEventListener('click', function(e) {
          if (!dropdownBtn.contains(e.target) && !dropdownList.contains(e.target)) {
            dropdownList.style.display = 'none';
          }
        });
      })();
    </script>
  </form>
