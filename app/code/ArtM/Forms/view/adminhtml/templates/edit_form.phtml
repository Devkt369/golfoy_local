	<script>
	var fieldTypesWithOptions = ['select','multiselect','swatch','radio'];
	var formFields = <?= json_encode($formFields) ?>;
	// Sort by sort_order (numeric, blanks last)
	formFields.sort(function(a, b) {
		var aOrder = (a.sort_order === undefined || a.sort_order === null || a.sort_order === '' || isNaN(a.sort_order)) ? Infinity : parseInt(a.sort_order);
		var bOrder = (b.sort_order === undefined || b.sort_order === null || b.sort_order === '' || isNaN(b.sort_order)) ? Infinity : parseInt(b.sort_order);
		return aOrder - bOrder;
	});

	function renderOptionsCell(options, fieldIndex, type) {
		if (!fieldTypesWithOptions.includes(type)) return '';
		options = options || [];
		var html = '<table style="width:100%;"><thead><tr><th>Label</th><th>Value</th><th>Action</th></tr></thead><tbody id="options-body-'+fieldIndex+'">';
		for (var i=0; i<options.length; i++) {
			html += '<tr>' +
				'<td><input type="text" name="form_fields['+fieldIndex+'][options]['+i+'][label]" value="'+(options[i].label||'')+'" required></td>' +
				'<td><input type="text" name="form_fields['+fieldIndex+'][options]['+i+'][value]" value="'+(options[i].value||'')+'" required></td>' +
				'<td><button type="button" onclick="removeOption('+fieldIndex+','+i+')">Remove</button></td>' +
			'</tr>';
		}
		html += '</tbody></table>';
		html += '<button type="button" onclick="addOption('+fieldIndex+')">Add Value</button>';
		return html;
	}

	function renderFormFields() {
		var tbody = document.getElementById('form-fields-body');
		tbody.innerHTML = '';
		for (var i=0; i<formFields.length; i++) {
			var f = formFields[i];
			var row = document.createElement('tr');
			var extraSettings = '';
			   if (['text','email','phone'].includes(f.type)) {
				   var maxLen = (typeof f.max_length !== 'undefined' && f.max_length !== null && f.max_length !== '') ? f.max_length : 50;
				   extraSettings += '<div style="margin-top:4px;font-size:0.95em;color:#888;">Max Length: <input type="number" min="1" name="form_fields['+i+'][max_length]" value="'+maxLen+'" style="width:70px;" /></div>';
			   }
			   if (f.type === 'textarea') {
				   var maxLen = (typeof f.max_length !== 'undefined' && f.max_length !== null && f.max_length !== '') ? f.max_length : 500;
				   extraSettings += '<div style="margin-top:4px;font-size:0.95em;color:#888;">Max Length: <input type="number" min="1" name="form_fields['+i+'][max_length]" value="'+maxLen+'" style="width:70px;" /></div>';
			   }
			   if (f.type === 'file' || f.type === 'image') {
				   var mbValue = (typeof f.max_file_size !== 'undefined' && f.max_file_size !== null && f.max_file_size !== '') ? (parseInt(f.max_file_size, 10) > 1000 ? Math.round(parseInt(f.max_file_size, 10) / 1024 / 1024) : parseInt(f.max_file_size, 10)) : 5;
				   var maxCount = (typeof f.max_file_count !== 'undefined' && f.max_file_count !== null && f.max_file_count !== '') ? f.max_file_count : 5;
				   extraSettings += '<div style="margin-top:4px;font-size:0.95em;color:#888;">Max File Size (MB): <input type="number" min="1" step="1" name="form_fields['+i+'][max_file_size]" value="'+mbValue+'" style="width:70px;" /> &nbsp; Max Files: <input type="number" min="1" name="form_fields['+i+'][max_file_count]" value="'+maxCount+'" style="width:60px;" /></div>';
			   }
			   if (f.type === 'date') {
				   extraSettings += '<div style="margin-top:4px;font-size:0.95em;color:#888;">'
					   + '<label style="font-weight:400;font-size:0.97em;"><input type="checkbox" name="form_fields['+i+'][past_only]" value="1"'+(f.past_only?' checked':'')+'> Past date only</label>'
					   + '&nbsp; '
					   + '<label style="font-weight:400;font-size:0.97em;"><input type="checkbox" name="form_fields['+i+'][future_only]" value="1"'+(f.future_only?' checked':'')+'> Future date only</label>'
					   + '</div>';
			   }
			row.innerHTML =
				'<td><input type="text" name="form_fields['+i+'][name]" value="'+(typeof f.name !== 'undefined' ? f.name : '')+'" required></td>'+ 
				'<td><input type="text" name="form_fields['+i+'][label]" value="'+(typeof f.label !== 'undefined' ? f.label : '')+'" required></td>'+ 
				'<td>'+ 
					'<select name="form_fields['+i+'][type]" onchange="changeType('+i+',this.value)">' +
						getTypeOptions(f.type) +
					'</select>'+ 
					((f.type==='file'||f.type==='image') ? '<br><label style="font-weight:400;font-size:0.95em;"><input type="checkbox" name="form_fields['+i+'][multiple]" value="1"'+(f.multiple?' checked':'')+'> Allow multiple</label>' : '')+
					extraSettings+
				'</td>'+ 
				'<td><input type="checkbox" name="form_fields['+i+'][is_required]" value="1"'+(f.is_required?' checked':'')+'></td>'+ 
				'<td><input type="number" name="form_fields['+i+'][sort_order]" value="'+(f.sort_order||'')+'"></td>'+ 
				'<td>'+renderOptionsCell(f.options,i,f.type)+'</td>'+ 
				'<td><input type="text" name="form_fields['+i+'][show_if]" value="'+(f.show_if||'')+'" placeholder="field=value or field!=value" style="width:120px;font-size:0.97em;" /></td>'+
				'<td><button type="button" onclick="removeFormField('+i+')">Remove</button></td>';
			tbody.appendChild(row);
		}
	}

	function getTypeOptions(selected) {
	var types = ['text','textarea','email','phone','select','multiselect','date','file','image','swatch','checkbox','radio','price','button'];
		var html = '';
		for (var t of types) {
			html += '<option value="'+t+'"'+(selected==t?' selected':'')+'>'+t.charAt(0).toUpperCase()+t.slice(1)+'</option>';
		}
		return html;
	}

	function addFormField() {
		// Save current input values before adding a new field
		var tbody = document.getElementById('form-fields-body');
		var rows = tbody.getElementsByTagName('tr');
		// console.log(rows);return;
		for (var i = 0; i < rows.length; i++) {
			var inputs = rows[i].querySelectorAll('input, select, textarea');
			for (var j = 0; j < inputs.length; j++) {
				var input = inputs[j];
				var nameMatch = input.name.match(/form_fields\[(\d+)\]\[([^\]]+)\](?:\[(\d+)\]\[([^\]]+)\])?/);
				if (nameMatch) {
					var idx = parseInt(nameMatch[1]);
					var key = nameMatch[2];
					if (typeof formFields[idx] !== 'object') continue;
					if (nameMatch[3] !== undefined && nameMatch[4] !== undefined) {
						// Nested option
						var optIdx = parseInt(nameMatch[3]);
						var optKey = nameMatch[4];
						if (!formFields[idx].options) formFields[idx].options = [];
						if (!formFields[idx].options[optIdx]) formFields[idx].options[optIdx] = {};
						formFields[idx].options[optIdx][optKey] = input.type === 'checkbox' ? input.checked : input.value;
					} else {
						formFields[idx][key] = input.type === 'checkbox' ? input.checked : input.value;
					}
				}
			}
		}
	   formFields.push({
		   name:'',
		   label:'',
		   type:'text',
		   is_required:false,
		   sort_order:'',
		   options:[],
		   multiple:false,
		   max_length:50,
		   max_file_size:5,
		   max_file_count:5,
		   past_only:false,
		   future_only:false
	   });
		renderFormFields();
	}
	function removeFormField(idx) {
		// Save all current input values before removing a field
		var tbody = document.getElementById('form-fields-body');
		var rows = tbody.getElementsByTagName('tr');
		for (var i = 0; i < rows.length; i++) {
			var inputs = rows[i].querySelectorAll('input, select, textarea');
			for (var j = 0; j < inputs.length; j++) {
				var input = inputs[j];
				var nameMatch = input.name.match(/form_fields\[(\d+)\]\[([^\]]+)\](?:\[(\d+)\]\[([^\]]+)\])?/);
				if (nameMatch) {
					var idx2 = parseInt(nameMatch[1]);
					var key = nameMatch[2];
					if (typeof formFields[idx2] !== 'object') continue;
					if (nameMatch[3] !== undefined && nameMatch[4] !== undefined) {
						// Nested option
						var optIdx = parseInt(nameMatch[3]);
						var optKey = nameMatch[4];
						if (!formFields[idx2].options) formFields[idx2].options = [];
						if (!formFields[idx2].options[optIdx]) formFields[idx2].options[optIdx] = {};
						formFields[idx2].options[optIdx][optKey] = input.type === 'checkbox' ? input.checked : input.value;
					} else {
						formFields[idx2][key] = input.type === 'checkbox' ? input.checked : input.value;
					}
				}
			}
		}
		formFields.splice(idx,1);
		renderFormFields();
	}
	function changeType(idx, type) {
		// Save all rows' input values before changing type
		var tbody = document.getElementById('form-fields-body');
		var rows = tbody.getElementsByTagName('tr');
		for (var i = 0; i < rows.length; i++) {
			var inputs = rows[i].querySelectorAll('input, select, textarea');
			for (var j = 0; j < inputs.length; j++) {
				var input = inputs[j];
				var nameMatch = input.name.match(/form_fields\[(\d+)\]\[([^\]]+)\](?:\[(\d+)\]\[([^\]]+)\])?/);
				if (nameMatch) {
					var idx2 = parseInt(nameMatch[1]);
					var key = nameMatch[2];
					if (typeof formFields[idx2] !== 'object') continue;
					if (nameMatch[3] !== undefined && nameMatch[4] !== undefined) {
						// Nested option
						var optIdx = parseInt(nameMatch[3]);
						var optKey = nameMatch[4];
						if (!formFields[idx2].options) formFields[idx2].options = [];
						if (!formFields[idx2].options[optIdx]) formFields[idx2].options[optIdx] = {};
						formFields[idx2].options[optIdx][optKey] = input.type === 'checkbox' ? input.checked : input.value;
					} else {
						// Always use .value, not .defaultValue
						formFields[idx2][key] = input.type === 'checkbox' ? input.checked : input.value;
					}
				}
			}
		}
		if (fieldTypesWithOptions.includes(type)) {
			if (!formFields[idx].options) formFields[idx].options = [];
		} else {
			formFields[idx].options = undefined;
		}
		formFields[idx].type = type;
		// Reset multiple if not file/image
		if (type !== 'file' && type !== 'image') formFields[idx].multiple = false;
		renderFormFields();
		// Add multiple:false by default
		if ((formFields[idx].type==='file'||formFields[idx].type==='image') && typeof formFields[idx].multiple==='undefined') formFields[idx].multiple = false;
	}
	function addOption(fieldIdx) {
		// Save all current input values before adding a new option
		var tbody = document.getElementById('form-fields-body');
		var rows = tbody.getElementsByTagName('tr');
		for (var i = 0; i < rows.length; i++) {
			var inputs = rows[i].querySelectorAll('input, select, textarea');
			for (var j = 0; j < inputs.length; j++) {
				var input = inputs[j];
				var nameMatch = input.name.match(/form_fields\[(\d+)\]\[([^\]]+)\](?:\[(\d+)\]\[([^\]]+)\])?/);
				if (nameMatch) {
					var idx = parseInt(nameMatch[1]);
					var key = nameMatch[2];
					if (typeof formFields[idx] !== 'object') continue;
					if (nameMatch[3] !== undefined && nameMatch[4] !== undefined) {
						// Nested option
						var optIdx = parseInt(nameMatch[3]);
						var optKey = nameMatch[4];
						if (!formFields[idx].options) formFields[idx].options = [];
						if (!formFields[idx].options[optIdx]) formFields[idx].options[optIdx] = {};
						formFields[idx].options[optIdx][optKey] = input.type === 'checkbox' ? input.checked : input.value;
					} else {
						formFields[idx][key] = input.type === 'checkbox' ? input.checked : input.value;
					}
				}
			}
		}
		if (!formFields[fieldIdx].options) formFields[fieldIdx].options = [];
		formFields[fieldIdx].options.push({label:'',value:''});
		renderFormFields();
	}
	function removeOption(fieldIdx, optIdx) {
		// Save all current input values before removing an option
		var tbody = document.getElementById('form-fields-body');
		var rows = tbody.getElementsByTagName('tr');
		for (var i = 0; i < rows.length; i++) {
			var inputs = rows[i].querySelectorAll('input, select, textarea');
			for (var j = 0; j < inputs.length; j++) {
				var input = inputs[j];
				var nameMatch = input.name.match(/form_fields\[(\d+)\]\[([^\]]+)\](?:\[(\d+)\]\[([^\]]+)\])?/);
				if (nameMatch) {
					var idx2 = parseInt(nameMatch[1]);
					var key = nameMatch[2];
					if (typeof formFields[idx2] !== 'object') continue;
					if (nameMatch[3] !== undefined && nameMatch[4] !== undefined) {
						// Nested option
						var optIdx2 = parseInt(nameMatch[3]);
						var optKey = nameMatch[4];
						if (!formFields[idx2].options) formFields[idx2].options = [];
						if (!formFields[idx2].options[optIdx2]) formFields[idx2].options[optIdx2] = {};
						formFields[idx2].options[optIdx2][optKey] = input.type === 'checkbox' ? input.checked : input.value;
					} else {
						formFields[idx2][key] = input.type === 'checkbox' ? input.checked : input.value;
					}
				}
			}
		}
		formFields[fieldIdx].options.splice(optIdx,1);
		renderFormFields();
	}
	// Patch: Convert max_file_size from MB to bytes before saving
	function saveAllFieldInputs() {
		var tbody = document.getElementById('form-fields-body');
		var rows = tbody.getElementsByTagName('tr');
		for (var i = 0; i < rows.length; i++) {
			var inputs = rows[i].querySelectorAll('input, select, textarea');
			for (var j = 0; j < inputs.length; j++) {
				var input = inputs[j];
				var nameMatch = input.name.match(/form_fields\[(\d+)\]\[([^\]]+)\](?:\[(\d+)\]\[([^\]]+)\])?/);
				if (nameMatch) {
					var idx = parseInt(nameMatch[1]);
					var key = nameMatch[2];
					if (typeof formFields[idx] !== 'object') continue;
					if (nameMatch[3] !== undefined && nameMatch[4] !== undefined) {
						// Nested option
						var optIdx = parseInt(nameMatch[3]);
						var optKey = nameMatch[4];
						if (!formFields[idx].options) formFields[idx].options = [];
						if (!formFields[idx].options[optIdx]) formFields[idx].options[optIdx] = {};
						formFields[idx].options[optIdx][optKey] = input.type === 'checkbox' ? input.checked : input.value;
					} else {
						if (key === 'max_file_size') {
							formFields[idx][key] = parseInt(input.value, 10) * 1024 * 1024;
						} else {
							formFields[idx][key] = input.type === 'checkbox' ? input.checked : input.value;
						}
					}
				}
			}
		}
	}
	// Patch: Call saveAllFieldInputs before submit
	var editForm = document.getElementById('edit_form');
	if (editForm) {
		editForm.addEventListener('submit', function() {
			saveAllFieldInputs();
		});
	}
	// Patch: Call saveAllFieldInputs before add/remove/change field
	var _addFormField = addFormField;
	addFormField = function() { saveAllFieldInputs(); _addFormField(); };
	var _removeFormField = removeFormField;
	removeFormField = function(idx) { saveAllFieldInputs(); _removeFormField(idx); };
	var _changeType = changeType;
	changeType = function(idx, type) { saveAllFieldInputs(); _changeType(idx, type); };
	var _addOption = addOption;
	addOption = function(fieldIdx) { saveAllFieldInputs(); _addOption(fieldIdx); };
	var _removeOption = removeOption;
	removeOption = function(fieldIdx, optIdx) { saveAllFieldInputs(); _removeOption(fieldIdx, optIdx); };
	// Initial render
	renderFormFields();
	</script>