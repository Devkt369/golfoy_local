<?php
/** @var \Magento\Backend\Block\Template $block */
$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$resource = $objectManager->get('Magento\\Framework\\App\\ResourceConnection');
$connection = $resource->getConnection();
$tableName = $resource->getTableName('artm_forms');

// Filters
$filters = [
	'id' => isset($_GET['id']) ? trim($_GET['id']) : '',
	'form_name' => isset($_GET['form_name']) ? trim($_GET['form_name']) : '',
	'form_identifier' => isset($_GET['form_identifier']) ? trim($_GET['form_identifier']) : '',
];

// Pagination
$page = isset($_GET['page']) ? max(1, (int)$_GET['page']) : 1;
$pageSize = 20;
$offset = ($page - 1) * $pageSize;

// Build WHERE
$where = [];
$bind = [];
if ($filters['id'] !== '') {
	$where[] = 'id = :id';
	$bind['id'] = $filters['id'];
}
if ($filters['form_name'] !== '') {
	$where[] = 'form_name LIKE :form_name';
	$bind['form_name'] = '%' . $filters['form_name'] . '%';
}
if ($filters['form_identifier'] !== '') {
	$where[] = 'form_identifier LIKE :form_identifier';
	$bind['form_identifier'] = '%' . $filters['form_identifier'] . '%';
}
$whereSql = $where ? ('WHERE ' . implode(' AND ', $where)) : '';

// Get total count
$countSql = "SELECT COUNT(*) FROM $tableName $whereSql";
$total = $connection->fetchOne($countSql, $bind);

// Get paginated rows
$sql = "SELECT * FROM $tableName $whereSql ORDER BY id DESC LIMIT $pageSize OFFSET $offset";
$rows = $connection->fetchAll($sql, $bind);

// Build base URL for pagination/filters
$baseUrl = $block->getUrl('*/*/');
$query = $_GET;
?>
<style>
.admin__data-grid-table { width: 100%; border-collapse: collapse; }
.admin__data-grid-table th, .admin__data-grid-table td { border: 1px solid #ccc; padding: 8px; }
.admin__data-grid-table th { background: #f8f8f8; }
.admin__action-dropdown { white-space: nowrap; }
.admin__form-inline input { width: 100%; box-sizing: border-box; }
.pagination { margin: 16px 0; }
.pagination a, .pagination span { margin: 0 2px; padding: 4px 8px; border: 1px solid #ccc; background: #fff; text-decoration: none; }
.pagination .current { background: #e3e3e3; font-weight: bold; }
</style>
<form method="get" class="admin__form-inline" style="margin-bottom:10px;">
	<table class="admin__data-grid-table">
		<thead>
			<tr>
				<th><input type="text" name="id" value="<?= htmlspecialchars($filters['id']) ?>" placeholder="ID" style="width:60px;" /></th>
				<th><input type="text" name="form_name" value="<?= htmlspecialchars($filters['form_name']) ?>" placeholder="Form Name" /></th>
				<th><input type="text" name="form_identifier" value="<?= htmlspecialchars($filters['form_identifier']) ?>" placeholder="Form Identifier" /></th>
				<th colspan="3"></th>
				<th><button type="submit" class="action-default scalable">Filter</button></th>
			</tr>
			<tr>
				<th>ID</th>
				<th>Form Name</th>
				<th>Form Identifier</th>
				<th>Form Description</th>
				<th>Created At</th>
				<th>Updated At</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			<?php if ($rows): ?>
				<?php foreach ($rows as $row): ?>
					<tr>
						<td><?= htmlspecialchars($row['id']) ?></td>
						<td><?= htmlspecialchars($row['form_name']) ?></td>
						<td><?= htmlspecialchars($row['form_identifier']) ?></td>
						<td><?= htmlspecialchars($row['form_description']) ?></td>
						<td><?= htmlspecialchars($row['created_at']) ?></td>
						<td><?= htmlspecialchars($row['updated_at']) ?></td>
						<td class="admin__action-dropdown">
							<a href="<?= $block->getUrl('*/*/edit', ['id' => $row['id']]) ?>" class="action-default">Edit</a>
						</td>
					</tr>
				<?php endforeach; ?>
			<?php else: ?>
				<tr><td colspan="7">No records found.</td></tr>
			<?php endif; ?>
		</tbody>
	</table>
</form>
<?php
// Pagination links
$totalPages = ceil($total / $pageSize);
if ($totalPages > 1):
	echo '<div class="pagination">';
	for ($i = 1; $i <= $totalPages; $i++) {
		$query['page'] = $i;
		$url = $baseUrl . '?' . http_build_query($query);
		if ($i == $page) {
			echo '<span class="current">' . $i . '</span>';
		} else {
			echo '<a href="' . $url . '">' . $i . '</a>';
		}
	}
	echo '</div>';
endif;
?>