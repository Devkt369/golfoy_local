$formFields = $form->getData('form_fields') ? json_decode($form->getData('form_fields'), true) : [];
// Sort fields by sort_order, blank sort_order last
usort($formFields, function ($a, $b) {
    $aSort = isset($a['sort_order']) && $a['sort_order'] !== '' ? (int)$a['sort_order'] : PHP_INT_MAX;
    $bSort = isset($b['sort_order']) && $b['sort_order'] !== '' ? (int)$b['sort_order'] : PHP_INT_MAX;
    return $aSort - $bSort;
});

