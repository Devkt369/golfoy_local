/** @var $block ArtM\Forms\Block\Form */
$form = $block->getFormByIdentifier($block->getData('identifier'));

$debugMode = (int)$block->getRequest()->getParam('artm_form_debug', 0) === 1;
$debugInfo = [];
if ($debugMode) {
    $requestedIdentifier = (string)$block->getData('identifier');
    $requestIdentifier = (string)$block->getRequest()->getParam('identifier', '');
    $requestFormIdentifier = (string)$block->getRequest()->getParam('form_identifier', '');
    $requestUri = (string)$block->getRequest()->getRequestUri();

    $debugInfo[] = 'Requested block identifier: ' . ($requestedIdentifier !== '' ? $requestedIdentifier : '(empty)');
    $debugInfo[] = 'Request param identifier: ' . ($requestIdentifier !== '' ? $requestIdentifier : '(empty)');
    $debugInfo[] = 'Request param form_identifier: ' . ($requestFormIdentifier !== '' ? $requestFormIdentifier : '(empty)');
    $debugInfo[] = 'Request URI: ' . $requestUri;

    try {
        $collection = \Magento\Framework\App\ObjectManager::getInstance()
            ->get(\ArtM\Forms\Model\FormsFactory::class)
            ->create()
            ->getCollection();
        $collection->getSelect()->reset(\Zend_Db_Select::COLUMNS)->columns(['form_identifier', 'id'])->limit(20);

        $identifiers = [];
        foreach ($collection as $item) {
            $identifiers[] = (string)$item->getData('form_identifier') . ' (id: ' . (int)$item->getId() . ')';
        }
        $debugInfo[] = 'Available forms (first 20): ' . (!empty($identifiers) ? implode(', ', $identifiers) : '(none found)');
    } catch (\Throwable $e) {
        $debugInfo[] = 'Failed to load forms list: ' . $e->getMessage();
    }
}

if (!$form) {
    echo '<div class="message-error">Form not found.</div>';
    if ($debugMode) {
        echo '<pre style="background:#111;color:#d8ffd8;padding:12px;border-radius:8px;white-space:pre-wrap;word-break:break-word;margin:12px 0;">'
            . 'ARTM FORMS DEBUG' . "\n"
            . implode("\n", array_map('htmlspecialchars', $debugInfo))
            . "\n\nHow to use:\n"
            . '1) Ensure CMS token uses existing identifier: {{artm_form identifier="<value>"}}' . "\n"
            . '2) Or call page with ?identifier=<value> for quick test.' . "\n"
            . '3) Remove artm_form_debug=1 after testing.'
            . '</pre>';
    }
    return;
}

$captchaEnabled = (int)$form->getData('form_captcha_enabled');
