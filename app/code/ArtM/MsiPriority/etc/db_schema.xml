<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="vin_inventory_archived_order" resource="default" engine="innodb" comment="Archived Orders">
        <column name="id" xsi:type="int" nullable="false" identity="true" unsigned="true" comment="ID"/>
        <column name="increment_id" xsi:type="varchar" nullable="false" length="20" comment="Increment ID"/>
        <column name="order_id" xsi:type="int" nullable="false" unsigned="true" comment="Order ID"/>
        <column name="create_date" xsi:type="datetime" nullable="true" comment="Created At"/>
        <column name="order_status" xsi:type="varchar" nullable="false" length="30" comment="Order Status"/>
        
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
    </table>

</schema>
