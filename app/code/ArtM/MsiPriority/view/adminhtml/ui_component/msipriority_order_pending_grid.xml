<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">msipriority_order_pending_grid.pos_order_grid_listing_data_source</item>
            <item name="deps" xsi:type="string">msipriority_order_pending_grid.pos_order_grid_listing_data_source</item>
        </item>
        <item name="spinner" xsi:type="string">pos_order_listing</item>
    </argument>
    <dataSource name="pos_order_grid_listing_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">ArtM\MsiPriority\Ui\DataProvider\PosOrder\ListingDataProvider</argument>
            <argument name="name" xsi:type="string">pos_order_grid_listing_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">entity_id</argument>
            <argument name="requestFieldName" xsi:type="string">entity_id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="update_url" xsi:type="url" path="mui/index/render" />
                    <item name="storageConfig" xsi:type="array">
                        <item name="indexField" xsi:type="string">entity_id</item>
                    </item>
                </item>
            </argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/grid/provider</item>
            </item>
        </argument>
    </dataSource>
    <listingToolbar name="listing_top">
        <bookmark name="bookmarks" />
        <columnsControls name="columns_controls" />
        <massaction name="listing_massaction">
            <argument name="data" xsi:type="array">
                <item name="data" xsi:type="array">
                    <item name="selectProvider" xsi:type="string">msipriority_order_pending_grid.msipriority_order_pending_grid.pos_order_listing.ids</item>
                    <item name="displayArea" xsi:type="string">bottom</item>
                    <item name="component" xsi:type="string">Magento_Ui/js/grid/tree-massactions</item>
                    <item name="indexField" xsi:type="string">entity_id</item>
                </item>
            </argument>
            <action name="SyncOrder">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="type" xsi:type="string">SyncOrder</item>
                        <item name="label" xsi:type="string" translate="true">SyncOrder</item>
                        <item name="url" xsi:type="url" path="msipriority/order/massactions" />
                        <item name="confirm" xsi:type="array">
                            <item name="title" xsi:type="string" translate="true">Sync Order</item>
                            <item name="message" xsi:type="string" translate="true">Are you sure you want to sync selected order?</item>
                        </item>
                    </item>
                </argument>
            </action>
            <action name="Archive">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="type" xsi:type="string">Archive</item>
                        <item name="label" xsi:type="string" translate="true">Archive</item>
                        <item name="url" xsi:type="url" path="msipriority/archiveorder/massactionsaddtoarchive" />
                        <item name="confirm" xsi:type="array">
                            <item name="title" xsi:type="string" translate="true">Archive</item>
                            <item name="message" xsi:type="string" translate="true">Are you sure you want to archive selected order?</item>
                        </item>
                    </item>
                </argument>
            </action>
        </massaction>
        <filters name="listing_filters">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="templates" xsi:type="array">
                        <item name="filters" xsi:type="array">
                            <item name="select" xsi:type="array">
                                <item name="component" xsi:type="string">Magento_Ui/js/form/element/ui-select</item>
                                <item name="template" xsi:type="string">ui/grid/filters/elements/ui-select</item>
                            </item>
                        </item>
                    </item>
                </item>
            </argument>
        </filters>
        <paging name="listing_paging" />
    </listingToolbar>
    <columns name="pos_order_listing">
        <selectionsColumn name="ids">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="indexField" xsi:type="string">entity_id</item>
                </item>
            </argument>
        </selectionsColumn>
        <!-- <column name="entity_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Order ID</label>
                <resizeDefaultWidth>25</resizeDefaultWidth>
            </settings>
        </column> -->
        <column name="increment_id">
            <settings>
                <filter>text</filter>
                <label translate="true">Increment ID</label>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <label translate="true">Created At</label>
                <dataType>date</dataType>
                <resizeDefaultWidth>50</resizeDefaultWidth>
            </settings>
        </column>
        <!-- <column name="created_at">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">dateRange</item>
                    <item name="editor" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Created At</item>
                    <item name="sortOrder" xsi:type="number">60</item>
                </item>
            </argument>
        </column> -->
        <column name="status" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <filter>select</filter>
                <options class="Magento\Sales\Ui\Component\Listing\Column\Status\Options"/>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="ArtM\MsiPriority\Ui\Component\PosOrder\Listing\Column\Actions">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="indexField" xsi:type="string">entity_id</item>
                </item>
            </argument>
        </actionsColumn>
    </columns>
</listing>
