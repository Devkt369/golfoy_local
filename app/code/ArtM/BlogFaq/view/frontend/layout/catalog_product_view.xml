<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="product.info.details">
            <block class="ArtM\BlogFaq\Block\Product\Faq" name="product.blogfaq" template="ArtM_BlogFaq::details/faq.phtml" group="detailed_info" after="product.info.description" >
                <arguments>
                    <argument name="title" translate="true" xsi:type="string">FAQs</argument>
                    <argument name="sort_order" xsi:type="string">10</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>