<?php
$product = $block->getProduct();
if (!$product) {
    return;
}

$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$blogHelper = $objectManager->get(\ArtM\BlogEsg\Helper\Data::class);

/** Attribute set name */
$attributeSetName = '';
$eavConfig = $objectManager->get(\Magento\Eav\Model\Config::class);
$entityType = $eavConfig->getEntityType(\Magento\Catalog\Model\Product::ENTITY);
$attributeSet = $entityType->getAttributeSetCollection()
    ->getItemById($product->getAttributeSetId());

if ($attributeSet) {
    $attributeSetName = (string)$attributeSet->getAttributeSetName();
}

/** Blog data */
$blogData = $blogHelper->getrow(strtolower($attributeSetName));
$upperText = $blogData[0]['uppertext'] ?? '';
?>

