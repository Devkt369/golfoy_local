<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:framework/ObjectManager/etc/config.xsd">

   <type name="Magento\Framework\App\FrontControllerInterface">
        <plugin name="force_login_plugin" type="ArtM\PartnersAuthentication\Plugin\ForceLogin" sortOrder="10"/>
	</type>

    <virtualType name="ContactUsGridDataSource" type="ArtM\PartnersAuthentication\Model\ResourceModel\ContactUs\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">artm_dealer_contact_us</argument>
            <argument name="resourceModel" xsi:type="string">ArtM\PartnersAuthentication\Model\ResourceModel\ContactUs</argument>
        </arguments>
    </virtualType>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="contact_us_grid_listing_data_source" xsi:type="string">ContactUsGridDataSource</item>
            </argument>
        </arguments>
    </type>

    <preference for="Magento\Contact\Controller\Index\Post" type="ArtM\PartnersAuthentication\Controller\Index\Post" />

</config>