<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Db/schema.xsd">

    <table name="artm_dealer_contact_us" resource="default" engine="innodb" comment="Dealer Contact Us Submissions">
        <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true"
                comment="Submission ID"/>
        <column xsi:type="varchar" name="name" length="255" nullable="false" comment="Customer Name"/>
        <column xsi:type="varchar" name="email" length="255" nullable="false" comment="Customer Email"/>
        <column xsi:type="varchar" name="telephone" length="50" nullable="true" comment="Customer Telephone"/>
        <column xsi:type="varchar" name="company_name" length="255" nullable="true" comment="Company Name"/>
        <column xsi:type="varchar" name="query_type" length="20" nullable="true" comment="Company Name"/>
        <column xsi:type="text" name="comment" nullable="false" comment="Message/Comment"/>
        <column xsi:type="boolean" name="has_account" nullable="false" default="false" comment="Does the user have an account"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Creation Time"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Modification Time"/>
        
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
    </table>

</schema>