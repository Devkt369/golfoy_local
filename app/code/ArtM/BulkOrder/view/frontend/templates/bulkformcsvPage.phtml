<?php

/** @var \Magento\Framework\View\Element\Template $block */
$formAction = $block->escapeUrl($block->getUrl('request_bulk_purchase/upload/index'));
$formKey = $block->getFormKey();
$templateUrl = $block->escapeUrl($block->getViewFileUrl('ArtM_BulkOrder::template/bulk_order_template.csv'));
?>

<div class="bulk-order-container">
    <div class="bulk-order-upload">
        <h2>Upload a Bulk Order</h2>

        <div class="bulk-step">
            <strong>Step 1: Prepare your order</strong>
            <p>Download the CSV template, add your SKUs and quantities, then save the file.</p>
            <a class="action primary bulk-download-template" href="<?= $templateUrl ?>" download="bulk_order_template.csv">
                <span>Download Template</span>
            </a>
        </div>

        <div class="bulk-step">
            <strong>Step 2: Upload your order</strong>
            <p>Drag your saved order file to the box below or click to select the file.</p>

            <form id="bulkOrderForm" action="<?= $formAction ?>" enctype="multipart/form-data" method="post" onsubmit="return false;">
                <input name="form_key" type="hidden" value="<?= $formKey ?>">

                <div id="drop-area" class="bulk-drop-area">
                    <p><strong>Drag your order here to upload it</strong></p>
                    <p>or <u>click</u> to select a file</p>
                </div>

                <input id="bulk_file" type="file" name="bulk_file" accept=".csv" style="display: none;">

                <div id="file-info" class="file-info-container"></div>

                <button type="submit" class="action primary bulk-upload-btn">
                    <span>Upload File</span>
                </button>
            </form>

            <div id="uploadResult"></div>
        </div>
    </div>
</div>

<script>
    require(['jquery'], function($) {
        $(document).ready(function() {

            // --- Helper Function to Display File Details ---
            function displayFileInfo(file) {
                $('.file-not-upload, .bulk-order-error').remove();

                const $fileInfo = $('#file-info');
                const $fileInput = $('#bulk_file');

                if (!file) {
                    $fileInfo.html('');
                    return;
                }

                if (file.type !== 'text/csv' && !file.name.toLowerCase().endsWith('.csv')) {
                    const errorHtml = `<div class="bulk-order-error" style="color:red;">Invalid file type. Please upload a .csv file.</div>`;
                    $fileInput.val('');
                    $fileInfo.html('');
                    $('#bulkOrderForm .bulk-upload-btn').after(errorHtml);
                    return;
                }

                const fileName = file.name;
                const fileSize = (file.size / 1024).toFixed(2);

                $fileInfo.html(
                    '<p>File selected: <strong>' + fileName + '</strong> (' + fileSize + ' KB)</p>' +
                    '<button type="button" id="clear-file" class="action-secondary"><span>Remove File</span></button>'
                );
            }

            // --- Event Delegation for Dynamic Elements ---

            // Handle CLICK on the drop area
            $(document).on('click', '#drop-area', function() {
                $('#bulk_file').click();
            });

            // Handle DRAGOVER on the drop area

            function initDragDrop() {
                var $dropArea = jQuery('#drop-area');
                var $fileInput = jQuery('#bulk_file');

                // prevent browser default behavior
                jQuery(document).on('dragover drop', function(e) {
                    e.preventDefault();
                });

                $dropArea
                    .off() // avoid duplicate binding
                    .on('dragover', function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        jQuery(this).addClass('drag-over');
                    })
                    .on('dragleave', function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        jQuery(this).removeClass('drag-over');
                    })
                    .on('drop', function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        jQuery(this).removeClass('drag-over');

                        var files = e.originalEvent.dataTransfer.files;
                        if (files.length == 1) {
                            $fileInput[0].files = files;
                            displayFileInfo(files[0]);
                        } else {
                            alert('Please upload only one file at a time.');
                        }
                    })

                $fileInput.on('change', function() {
                    if (this.files.length > 0) {
                        displayFileInfo(this.files[0]);
                    }
                });
            }

            setTimeout(initDragDrop, 2000);

            // Handle file selection via the file input's CHANGE event
            $(document).on('change', '#bulk_file', function() {
                if (this.files.length > 0) {
                    displayFileInfo(this.files[0]);
                }
            });

            // Handle CLICK on the "Remove File" button
            $(document).on('click', '#clear-file', function() {
                $('#bulk_file').val('');
                displayFileInfo(null);
            });

            // Handle form SUBMIT event
            $(document).on('submit', '#bulkOrderForm', function(e) {
                e.preventDefault();
                $('.file-not-upload, .bulk-order-error').remove();

                const $form = $(this);
                const $fileInput = $('#bulk_file');
                const $dropArea = $('#drop-area');
                const $container = $('.bulk-order-container');

                if (!$fileInput[0].files.length) {
                    $dropArea.before("<div class='file-not-upload' style='color:red;'>Please select a file to upload.</div>");
                    $dropArea.addClass('required');
                    setTimeout(() => $dropArea.removeClass('required'), 500);
                    return;
                }

                const formData = new FormData(this);
                $form.find('.bulk-upload-btn').prop('disabled', true);

                $.ajax({
                    url: $form.attr('action'),
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    showLoader: true,
                    success: function(response) {
                        if (response.success) {
                            const successMessage = response.message || 'Your file has been uploaded successfully.';
                            const successHtml = `
                            <div class="bulk-order-upload" style="text-align: center; padding: 40px 20px;">
                                <h3 style="color:green;">Thank You!</h3>
                                <p>${successMessage}</p>
                            </div>`;
                            $form.find('.bulk-upload-btn').after(`
                                <div class="bulk-upload-message" style="color:green; margin-top:10px;">
                                    ${successMessage}
                                </div>
                            `);
                            setTimeout(function() {
                                window.location.reload();
                            }, 1000);
                        } else {
                            const errorMessage = response.error || 'Something went wrong.';
                            const errorHtml = `<div class="bulk-order-error"><span style="color:red;">Upload Failed: ${errorMessage}</span></div>`;
                            $form.find('.bulk-upload-btn').after(errorHtml);
                        }
                    },
                    error: function(xhr) {
                        let errorMessage = 'An unknown error occurred. Please try again.';
                        if (xhr.responseJSON && xhr.responseJSON.error) {
                            errorMessage = xhr.responseJSON.error;
                        }
                        const errorHtml = `
                        <div class="bulk-order-upload" style="text-align: center; padding: 40px 20px;">
                            <h3 style="color:red;">Upload Failed</h3>
                            <p>${errorMessage}</p>
                        </div>`;
                        $form.find('.bulk-upload-btn').after(`
                            <div class="bulk-upload-message" style="color:red; margin-top:10px;">
                                ${errorMessage}
                            </div>
                        `);
                        setTimeout(function() {
                            window.location.reload();
                        }, 2000);
                    }
                });
                $form.find('.bulk-upload-btn').prop('enable', true);
            });
        });
    });
</script>


