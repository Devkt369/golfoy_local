<?php
namespace ArtM\Delhiveryqc\Helper;

use Magento\Framework\Json\Helper\Data as JsonHelper;

class Data extends \Magento\Framework\App\Helper\AbstractHelper
{
    private $attributeSetRepository;
    private $searchCriteriaBuilder;
    private $OrderData;
	private $ProductData;
    protected $jsonHelper;
    protected $OrderQcComment;
    
    public function __construct(
        \Magento\Framework\App\Helper\Context $context,
		\Magento\Store\Model\StoreManagerInterface $storeManager,
        \Magento\Directory\Model\CountryFactory $countryFactory,
        \Magento\Eav\Api\AttributeSetRepositoryInterface $attributeSet,
        \Magento\Catalog\Api\ProductRepositoryInterface $productRepository,
        \ArtM\CancelOrder\Model\CancelOrderCustomFactory $CancelOrderCustom,
        \ArtM\Delhiveryqc\Model\QuestionQcFactory $QuestionQc,
        \ArtM\Delhiveryqc\Model\ProductQcFactory $ProductData,  
        \ArtM\Delhiveryqc\Model\OrderQcCommentFactory $OrderQcComment,
        \ArtM\Delhiveryqc\Model\SettingsQcFactory $SettingsData,   
        \Magento\Framework\HTTP\Client\Curl $curl,
        JsonHelper $jsonHelper,
        \ArtM\Delhiveryqc\Model\OrderQcFactory $OrderData
        
    )
    
    {
		$this->storeManager = $storeManager;
        $this->_countryFactory = $countryFactory;
        $this->attributeSet = $attributeSet;
        $this->productRepository = $productRepository;
        $this->CancelOrderCustom = $CancelOrderCustom;
        $this->QuestionQc = $QuestionQc;
        $this->OrderQc = $OrderData;
        $this->ProductQc = $ProductData;
        $this->SettingsData = $SettingsData;
        $this->curl = $curl;
        $this->jsonHelper = $jsonHelper;
        $this->OrderQcComment = $OrderQcComment;
        
		parent::__construct($context);
    }
    
    
    public function CanShow($order_id , $prd_id){
        $return_data = array();
        
         $IsAlreadySubmitted = $this->IsAlreadySubmitted( $order_id , $prd_id );
        if( $IsAlreadySubmitted == true ){
            $return_data['message'] = 'Row Already Existed';
            return $return_data;
        }
        
        $return_data['message'] = '';
        return $return_data;
    }
    
    
    
