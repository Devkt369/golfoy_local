    .single_prd legend.admin__legend {
        margin-bottom: 5px;
        margin-top: 20px;
    }
    .single_prd table td input, .single_prd table td textarea, .single_prd table td select {
        width: 100%;
    }
    td.question_orderdetails div:after {
        height: 20px;
        width: 20px;
        border: 1px solid #676767;
        display: inline-block;
        content: ' ';
    }
    td.question_orderdetails.active_row div:after {
