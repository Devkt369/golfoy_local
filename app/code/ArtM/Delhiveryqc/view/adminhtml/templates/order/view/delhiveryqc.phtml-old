<script type="text/javascript">
    require(['jquery'], function(jQuery) {
        jQuery('.prd_add_to_qc input[type="checkbox"]').click(function() {
            jQuery('#delhiveryqc_submition').children('.products_details').html('');
              
            var checkboxContainer = jQuery(this).closest('.single_prd');
            var i = 1;
            var button_value = 0;
            var prd_decription = '';
            var qty_to_qc = 0;
            var price = 0;
            
            
            jQuery('.single_prd').each(function() {
                var checkbox = jQuery(this).find('.add_button').find('input[type="checkbox"]');
                
                if (checkbox.is(':checked')) {
//                    jQuery(this).siblings('.all_info_to_submit').children('input').attr('disable');
                    
                    var curr_table_id = jQuery(checkbox).attr('question_table');
                    
                    var data = '';
                    jQuery("#"+curr_table_id+" ").find('tr.question_orderdetails_row.active_row').each(function(){
                        data = data + "{";
                        
                            data = data + '"question":"' + jQuery(this).find('input[name="question"]').val() + '",';
                            data = data + '"options":"' + jQuery(this).find('input[name="options"]').val() + '",';
                            data = data + '"value":"' + jQuery(this).find('input[name="value"]').val() + '",';
                            data = data + '"required":"' + jQuery(this).find('select[name="required"]').val() + '",';
                            data = data + '"type":"' + jQuery(this).find('select[name="type"]').val() + '"';
                        
                        data = data + "}";
//                        alert(data);
                    });
//                    alert(data);
                        jQuery(checkbox).siblings('.all_info_to_submit').children('.question_data').val( data );
//                    jQuery(checkbox).addclass('hbvfeew');
                    
                    
                    var html ='';
                    
                    jQuery(checkbox).siblings('.all_info_to_submit').children('input').each(function(){
                        var name = jQuery(this).attr('name');
                        var value = jQuery(this).attr('value');
                        var value = jQuery(this).val();
                        
                        if(name == 'question_data'){
                            value = data;
                        }
                        
                        html = html + "<div class='single_prd_details'>";
//                        product-"+ i + " " 
                        html = html + "<div>" + name + "</div><input type='text' name='product["+i+"]["+name+"]' value='"+value+"' /><br>";
                        html = html + "</div>";
                        
                        if(name == 'name'){
                            prd_decription = prd_decription + value + ' | ';
                        }
                        if(name == 'qty_to_qc'){
                            
                            qty_to_qc = parseInt(qty_to_qc) + parseInt( jQuery(this).val() );
//                            qty_to_qc = parseInt(qty_to_qc) + parseInt(value);
                        }
                        if(name == 'price'){
                            price = parseInt(price) + ( parseInt(value) * parseInt(qty_to_qc) );
                        }
                        
                    });   
                    
                    jQuery('#delhiveryqc_submition').children('.products_details').append("<div class='products_details_single_prd'>" + html + "</div>");
                    i++;
                    
                    button_value = 1;
                    
                    jQuery(checkbox).siblings().addClass('non-pointer_row');
                    jQuery(checkbox).parent().parent().parent().siblings().addClass('non-pointer_row');
                    
                    
                }else{
                    jQuery(checkbox).siblings().removeClass('non-pointer_row');
                    jQuery(checkbox).parent().parent().parent().siblings().removeClass('non-pointer_row');
                }
            });
            if( button_value == 0){
                var text = "Please Choose Products";
                jQuery('#submit_qc_button').addClass("disable");
                
            }else if( button_value == 1){
                var text = 'Submit QC';
                jQuery('#submit_qc_button').removeClass("disable");
            }
            jQuery('#submit_qc_button').text( text );
            jQuery('#order_details_prd_description').val( prd_decription );
            jQuery('#order_details_prd_qty').val( qty_to_qc );
            jQuery('#order_details_prd_amount').val( price );
            
            
            
        });
        jQuery('.question_orderdetails').click(function(){
            jQuery(this).parent('tr').toggleClass('active_row');
            jQuery(this).toggleClass('active_row');
        });
    });

</script>