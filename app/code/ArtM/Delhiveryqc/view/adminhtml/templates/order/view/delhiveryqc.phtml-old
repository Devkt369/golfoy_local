    }
    .single_prd table th h6 {
        margin-bottom: 0px;
        font-size: 10px;
        font-weight: 500;
    }

    .single_prd table th {
        vertical-align: baseline;
    }
    .add_button > div {
        width: 100%;
        text-align: right;
    }
    
</style>
