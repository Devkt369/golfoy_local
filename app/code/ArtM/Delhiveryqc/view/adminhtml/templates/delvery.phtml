$pagesize = 10;
$currpage = isset($_GET['currpage']) ? $_GET['currpage'] : 1;
$searchOrder = isset($_GET['searchOrder']) ? $_GET['searchOrder'] : '';

$orders = $block->getDelhiveryQcOrders($pagesize, $currpage);
$orders->setOrder('id', 'DESC');

if (!empty($searchOrder)) {
    $orders->addFieldToFilter('order', $searchOrder);
}


$collectionsize = $orders->getSize();

$paginationsize = (int)($collectionsize / $pagesize);
$paginationsizerem = $collectionsize % $pagesize;
if ($paginationsizerem > 0) {
    $paginationsize = $paginationsize + 1;
}

echo "<div class='search_section'>";
echo "<label for='searchOrder'>Search by Order ID:</label>";
echo "<input type='text' id='searchOrder' name='searchOrder' value='" . htmlentities($searchOrder) . "' placeholder='Enter Order ID'>";
echo "<button onclick='searchByOrderId()' class='search_button'>Search</button>";
echo "</div>";

echo "<div class='pagination_section pg_sec'>";
echo "<div class='pagination pg_sec'>";

$startpage = max(1, $currpage - 4);
$endpage = min($startpage + 5, $paginationsize);

if ($currpage > 1) {
    $prevpage = $currpage - 1;
    echo "<a class='pagination-button prev' href='?currpage=" . $prevpage . "'>&lt;</a>";
}

for ($i = $startpage; $i <= $endpage; $i++) {
    if ($i == $currpage) {
        echo "<span class='pagination-button active'>" . $i . "</span>";
    } else {
        echo "<a class='pagination-button' href='?currpage=" . $i . "'>" . $i . "</a>";
    }
}

if ($currpage < $paginationsize) {
    $nextpage = $currpage + 1;
    echo "<a class='pagination-button next' href='?currpage=" . $nextpage . "'>&gt;</a>";
}

echo "</div>";

echo "<div class='page-input'>";
echo "<input type='text' id='pageInput' placeholder='Enter page number'>";
echo "<button onclick='goToPage()' class='go_page'>Go</button>";
echo "</div>";

// Display the total number of pages
echo "<div class='total-pages'>Total Pages: " . $paginationsize . "</div>";

echo "</div>";


echo "<script>
function goToPage() {
    var pageInput = document.getElementById('pageInput');
    var pageNumber = parseInt(pageInput.value);
    if (!isNaN(pageNumber) && pageNumber >= 1 && pageNumber <= $paginationsize) {
        window.location.href = '?currpage=' + pageNumber;
    }
}
</script>";

//search by order id script
echo "<script>
function searchByOrderId() {
    var searchInput = document.getElementById('searchOrder');
    var orderId = searchInput.value.trim();
    if (orderId !== '') {
        window.location.href = '?searchOrder=' + encodeURIComponent(orderId);
    }
}
</script>";


