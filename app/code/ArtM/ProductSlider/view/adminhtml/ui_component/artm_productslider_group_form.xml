<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">artm_productslider_group_form.artm_productslider_group_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Slider Group</item>
    </argument>

    <settings>
        <namespace>artm_productslider_group_form</namespace>
        <dataScope>group</dataScope>
        <deps>
            <dep>artm_productslider_group_form.artm_productslider_group_form_data_source</dep>
        </deps>
        <buttons>
            <button name="back" class="ArtM\ProductSlider\Block\Adminhtml\Group\Edit\BackButton"/>
            <button name="delete" class="ArtM\ProductSlider\Block\Adminhtml\Group\Edit\DeleteButton"/>
            <button name="save" class="ArtM\ProductSlider\Block\Adminhtml\Group\Edit\SaveButton"/>
            <button name="save_and_continue" class="ArtM\ProductSlider\Block\Adminhtml\Group\Edit\SaveAndContinueButton"/>
        </buttons>
    </settings>

    <dataSource name="artm_productslider_group_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="*/*/save"/>
        </settings>
        <dataProvider class="ArtM\ProductSlider\Ui\DataProvider\SliderGroup\FormDataProvider"
                      name="artm_productslider_group_form_data_source">
            <settings>
                <requestFieldName>group_id</requestFieldName>
                <primaryFieldName>group_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <fieldset name="general" sortOrder="10">
        <settings>
            <label translate="true">General</label>
        </settings>
        <field name="group_id" formElement="input" sortOrder="10">
            <settings>
                <visible>false</visible>
                <dataType>number</dataType>
                <dataScope>group_id</dataScope>
            </settings>
        </field>
        <field name="name" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Name</label>
                <dataScope>name</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="identifier" formElement="input" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Identifier</label>
                <dataScope>identifier</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="validate-identifier" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="status" formElement="select" sortOrder="40">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Status</label>
                <dataScope>status</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="ArtM\ProductSlider\Model\Source\Status"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="sort_order" formElement="input" sortOrder="50">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Sort Order</label>
                <dataScope>sort_order</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="validate-number" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="description" formElement="textarea" sortOrder="60">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Description</label>
                <dataScope>description</dataScope>
            </settings>
        </field>
    </fieldset>

    <fieldset name="tabs" sortOrder="20">
        <settings>
            <label translate="true">Tabs</label>
        </settings>
        <field name="tabs_json" formElement="textarea" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Tabs JSON</label>
                <dataScope>tabs_json</dataScope>
                <notice translate="true">Define group tabs structure in JSON format.</notice>
            </settings>
        </field>
    </fieldset>

    <fieldset name="preview" sortOrder="30">
        <settings>
            <label translate="true">Preview</label>
        </settings>
        <field name="preview_hint" formElement="textarea" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Preview</label>
                <dataScope>preview_hint</dataScope>
                <disabled>true</disabled>
                <notice translate="true">Frontend preview is intentionally excluded in this module phase.</notice>
            </settings>
        </field>
    </fieldset>
</form>
