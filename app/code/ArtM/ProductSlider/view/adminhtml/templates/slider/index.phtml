<script>
(function () {
    var modal = document.getElementById('artm-ps-embed-modal');
    var title = document.getElementById('artm-ps-embed-title');
    var staticArea = document.getElementById('artm-ps-embed-static');
    var phtmlArea = document.getElementById('artm-ps-embed-phtml');
    var closeBtn = document.getElementById('artm-ps-embed-close');
    if (!modal || !staticArea || !phtmlArea || !closeBtn) {
        return;
    }

    function openModal(embedType, identifier) {
        var safeIdentifier = String(identifier || '').trim();
        if (!safeIdentifier) {
            return;
        }

        var blockClass = embedType === 'group'
            ? 'ArtM\\ProductSlider\\Block\\Group'
            : 'ArtM\\ProductSlider\\Block\\Slider';
        var template = embedType === 'group'
            ? 'ArtM_ProductSlider::group/view.phtml'
            : 'ArtM_ProductSlider::slider/view.phtml';
        var label = embedType === 'group' ? 'Slider Group' : 'Slider';

        title.textContent = label + ' Embed Code: ' + safeIdentifier;
        staticArea.value = '{{block class="' + blockClass + '" identifier="' + safeIdentifier + '" template="' + template + '"}}';
        phtmlArea.value = "<" + "?php echo $block->getLayout()->createBlock(" + blockClass + "::class)->setData('identifier', '" + safeIdentifier + "')->setTemplate('" + template + "')->toHtml(); ?" + ">";
        modal.style.display = 'block';
    }

    function closeModal() {
        modal.style.display = 'none';
    }

    document.querySelectorAll('.artm-ps-embed-link').forEach(function (el) {
        el.addEventListener('click', function () {
            openModal(el.getAttribute('data-embed-type') || 'slider', el.getAttribute('data-embed-identifier') || '');
        });
    });

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', function (e) {
        if (e.target === modal) {
            closeModal();
        }
    });

    document.querySelectorAll('.artm-ps-copy').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var targetId = btn.getAttribute('data-target');
            var target = targetId ? document.getElementById(targetId) : null;
            if (!target) {
                return;
            }

            target.focus();
            target.select();
            try {
                document.execCommand('copy');
            } catch (e) {
            }
        });
    });
})();
</script>
