                    <select name="slider[card_components][]" id="card_components" multiple size="10" style="display:none" aria-hidden="true"><?php foreach (array_merge($cardComponentOptions, $productAttributeOptions) as $option): ?><option value="<?= $block->escapeHtmlAttr((string)$option['value']) ?>" <?= in_array((string)$option['value'], $selectedCardComponents, true) ? 'selected' : '' ?>><?= $block->escapeHtml((string)$option['label']) ?></option><?php endforeach; ?></select>
                    <script type="application/json" id="card_components_saved_order"><?= /* @noEscape */ json_encode(array_values($selectedCardComponents)) ?></script>
                    <p data-dep="card-custom-attributes"><label><?= $block->escapeHtml(__('Custom Attributes')) ?></label><input type="text" name="slider[custom_attributes]" value="<?= $block->escapeHtmlAttr(implode(',', $selectedCustomAttributes)) ?>" placeholder="Material,Gender,Fragrance Type" /></p>
                    <p>
                        <label>
                            <input type="checkbox" name="slider[remove_brand_from_name]" value="1" <?= ((int)$data['remove_brand_from_name'] === 1) ? 'checked' : '' ?> />
                            <?= $block->escapeHtml(__('Remove brand name from product name')) ?>
                        </label>
                    </p>
                    <p><label><?= $block->escapeHtml(__('Hover Image')) ?></label><select name="slider[hover_image_enabled]"><?php foreach ($block->getYesNoOptions() as $option): ?><option value="<?= $block->escapeHtmlAttr((string)$option['value']) ?>" <?= ((string)$data['hover_image_enabled'] === (string)$option['value']) ? 'selected' : '' ?>><?= $block->escapeHtml((string)$option['label']) ?></option><?php endforeach; ?></select></p>
                    <p><label><?= $block->escapeHtml(__('Image Role')) ?></label><select name="slider[image_role]"><?php foreach ($block->getImageRoleOptions() as $option): ?><option value="<?= $block->escapeHtmlAttr((string)$option['value']) ?>" <?= ((string)$data['image_role'] === (string)$option['value']) ? 'selected' : '' ?>><?= $block->escapeHtml((string)$option['label']) ?></option><?php endforeach; ?></select></p>
                </div>
            </div>

            <h3 id="tab-preview"><?= $block->escapeHtml(__('Preview')) ?></h3>
            <div class="artm-ps-grid-form">
                <div class="artm-ps-card">
                    <p><strong><?= $block->escapeHtml(__('Source Type')) ?>:</strong> <span id="preview_source_type"></span></p>
                    <p><strong><?= $block->escapeHtml(__('Products Loaded (Limit)')) ?>:</strong> <span id="preview_product_limit"></span></p>
                    <p><strong><?= $block->escapeHtml(__('Current Sorting')) ?>:</strong> <span id="preview_sorting"></span></p>
                    <p><strong><?= $block->escapeHtml(__('Display Type')) ?>:</strong> <span id="preview_display_type"></span></p>
                    <p><strong><?= $block->escapeHtml(__('Autoplay')) ?>:</strong> <span id="preview_autoplay"></span></p>
                    <p><strong><?= $block->escapeHtml(__('Configured Source Count')) ?>:</strong> <span id="preview_source_count"></span></p>
                    <p><strong><?= $block->escapeHtml(__('Total Products Found')) ?>:</strong> <span id="preview_total_found">0</span></p>
                    <p class="artm-ps-note" id="preview_hint"><?= $block->escapeHtml(__('Live preview summary is based on current form values. Product rendering preview is available after frontend integration.')) ?></p>
                    <div class="artm-ps-picker-grid-wrap">
                        <table class="artm-ps-table" id="preview_products_table">
                            <thead>
                                <tr>
                                    <th><?= $block->escapeHtml(__('Image')) ?></th>
                                    <th><?= $block->escapeHtml(__('SKU')) ?></th>
                                    <th><?= $block->escapeHtml(__('Name')) ?></th>
                                    <th><?= $block->escapeHtml(__('Price')) ?></th>
                                    <th><?= $block->escapeHtml(__('Stock')) ?></th>
                                    <th><?= $block->escapeHtml(__('Category')) ?></th>
                                    <th><?= $block->escapeHtml(__('Position')) ?></th>
                                </tr>
                            </thead>
                            <tbody id="preview_products_body"></tbody>
                        </table>
                    </div>
                    <p class="artm-ps-note" id="preview_products_status"></p>
                    <p><label><?= $block->escapeHtml(__('Preview Notes')) ?></label><textarea name="slider[preview_notes]" rows="4"><?= $block->escapeHtml((string)$data['preview_notes']) ?></textarea></p>
                </div>
            </div>

        </form>
    </div>
</div>

<script>
(function () {
    var form = document.getElementById('artm-slider-form');
    if (!form) { return; }

    var sourceType = document.getElementById('source_type');
    var displayType = document.getElementById('display_type');
    var sortingType = document.getElementById('sorting_type');
    var autoplay = document.getElementById('autoplay');
    var buttonLinkType = document.getElementById('button_link_type');
    var cardComponents = document.getElementById('card_components');
    var cardComponentAddSelect = document.getElementById('card_component_add_select');
    var cardComponentPriority = document.getElementById('card_component_priority');
    var cardComponentAddBtn = document.getElementById('card_component_add_btn');
    var cardComponentOrderList = document.getElementById('card_component_order_list');
    var cardComponentsSavedOrderEl = document.getElementById('card_components_saved_order');
    var hiddenButtonLink = document.getElementById('button_link_hidden');
    var buttonManual = document.getElementById('button_link_manual');
    var buttonCategory = document.getElementById('button_link_category');
    var previewSourceType = document.getElementById('preview_source_type');
    var previewProductLimit = document.getElementById('preview_product_limit');
    var previewSorting = document.getElementById('preview_sorting');
    var previewDisplayType = document.getElementById('preview_display_type');
    var previewAutoplay = document.getElementById('preview_autoplay');
    var previewSourceCount = document.getElementById('preview_source_count');
    var previewHint = document.getElementById('preview_hint');
    var previewTotalFound = document.getElementById('preview_total_found');
    var previewProductsBody = document.getElementById('preview_products_body');
    var sourceProductIdsField = document.getElementById('source_product_ids');
    var mixedProductIdsField = document.getElementById('mixed_product_ids');
    var manualSortProductIdsField = document.getElementById('manual_sort_product_ids');
    var pickerQuery = document.getElementById('products_picker_q');
    var pickerSearch = document.getElementById('products_picker_search');
    var pickerGridBody = document.getElementById('products_picker_grid_body');
    var pickerStatus = document.getElementById('products_picker_status');
    var previewStatus = document.getElementById('preview_products_status');
    var selectedProductsOrder = document.getElementById('selected_products_order');
    var productSearchUrls = [
        '<?= $block->escapeJs($block->getUrl('artm_productslider/slider/productSearch')) ?>',
        '<?= $block->escapeJs($block->getUrl('artm_productslider/slider/product_search')) ?>'
    ];
    var previewProductsUrls = [
        '<?= $block->escapeJs($block->getUrl('artm_productslider/slider/previewProducts')) ?>',
        '<?= $block->escapeJs($block->getUrl('artm_productslider/slider/preview_products')) ?>'
    ];

    function setText(el, text) {
        if (el) { el.textContent = text || ''; }
    }

    function requestJson(url, options, onSuccess, onError) {
        if (typeof window.fetch === 'function') {
            fetch(url, options)
                .then(function (r) {
                    if (!r.ok) {
                        throw new Error('HTTP ' + r.status);
                    }
                    return r.text();
                })
                .then(function (txt) {
                    var json;
                    try {
                        json = JSON.parse(txt);
                    } catch (e) {
                        throw new Error('Invalid JSON response');
                    }
                    onSuccess(json);
                })
                .catch(function (e) {
                    onError(e);
                });
            return;
        }

        try {
            var xhr = new XMLHttpRequest();
            xhr.open((options && options.method) || 'GET', url, true);
            xhr.withCredentials = true;
            xhr.onreadystatechange = function () {
                if (xhr.readyState !== 4) {
                    return;
                }
                if (xhr.status < 200 || xhr.status >= 300) {
                    onError(new Error('HTTP ' + xhr.status));
                    return;
                }
                try {
                    onSuccess(JSON.parse(xhr.responseText));
                } catch (e) {
                    onError(new Error('Invalid JSON response'));
                }
            };
            xhr.send((options && options.body) || null);
        } catch (e) {
            onError(e);
        }
    }

    function parseCsv(value) {
        if (!value) { return []; }
        var out = [];
        value.split(',').forEach(function (v) {
            var n = parseInt(String(v).trim(), 10);
            if (!isNaN(n) && n > 0 && out.indexOf(n) === -1) {
                out.push(n);
            }
        });
        return out;
    }

    function csv(ids) {
        return ids.join(',');
    }

    function getActiveProductIdsField() {
        var source = sourceType ? sourceType.value : 'category';
        if (source === 'mixed') {
            return mixedProductIdsField;
        }
        return sourceProductIdsField;
    }

    function hydrateSelectedFromActiveField() {
        var activeField = getActiveProductIdsField();
        selectedSourceIds = parseCsv(activeField ? activeField.value : '');
    }

    var selectedSourceIds = [];
    var manualOrderIds = parseCsv(manualSortProductIdsField ? manualSortProductIdsField.value : '');
    hydrateSelectedFromActiveField();

    function syncIdsToFields() {
        var activeField = getActiveProductIdsField();
        if (activeField) {
            activeField.value = csv(selectedSourceIds);
        }

        var sorting = sortingType ? sortingType.value : '';
        if (sorting === 'manual') {
            manualOrderIds = selectedSourceIds.slice();
        } else {
            manualOrderIds = manualOrderIds.filter(function (id) { return selectedSourceIds.indexOf(id) !== -1; });
        }

        if (manualSortProductIdsField) {
            manualSortProductIdsField.value = csv(manualOrderIds);
        }
    }

    function renderSelectedOrderList() {
        if (!selectedProductsOrder) { return; }
        selectedProductsOrder.innerHTML = '';
        selectedSourceIds.forEach(function (id) {
            var li = document.createElement('li');
            li.draggable = true;
            li.dataset.id = String(id);
            li.textContent = '#' + id;
            selectedProductsOrder.appendChild(li);
        });
        bindSelectedOrderDnD();
    }

    function bindSelectedOrderDnD() {
        if (!selectedProductsOrder) { return; }
        var dragging = null;
        selectedProductsOrder.querySelectorAll('li').forEach(function (li) {
            li.addEventListener('dragstart', function () { dragging = li; li.classList.add('dragging'); });
            li.addEventListener('dragend', function () { li.classList.remove('dragging'); dragging = null; syncFromSelectedList(); });
            li.addEventListener('dragover', function (e) {
                e.preventDefault();
                if (!dragging || dragging === li) { return; }
                var box = li.getBoundingClientRect();
                if (e.clientY < box.top + box.height / 2) {
                    selectedProductsOrder.insertBefore(dragging, li);
                } else {
                    selectedProductsOrder.insertBefore(dragging, li.nextSibling);
                }
            });
        });
    }

    function syncFromSelectedList() {
        var ids = [];
        selectedProductsOrder.querySelectorAll('li').forEach(function (li) {
            ids.push(parseInt(li.dataset.id, 10));
        });
        selectedSourceIds = ids.filter(function (v) { return !isNaN(v) && v > 0; });
        syncIdsToFields();
        updatePreview();
    }

    function getCardComponentOption(value) {
        if (!cardComponents) { return null; }
        var found = null;
        Array.from(cardComponents.options).forEach(function (opt) {
            if (opt.value === value) { found = opt; }
        });
        return found;
    }

    function getSelectedCardComponents() {
        if (!cardComponents) { return []; }
        return Array.from(cardComponents.options).filter(function (opt) { return opt.selected; });
    }

    function renderCardComponentList() {
        if (!cardComponentOrderList) { return; }
        cardComponentOrderList.innerHTML = '';
        getSelectedCardComponents().forEach(function (opt, index) {
            var li = document.createElement('li');
            li.draggable = true;
            li.dataset.value = opt.value;

            var badge = document.createElement('span');
            badge.className = 'artm-ps-component-list__priority';
            badge.textContent = String(index + 1);

            var label = document.createElement('span');
            label.className = 'artm-ps-component-list__label';
            label.textContent = opt.textContent;

            var removeBtn = document.createElement('button');
            removeBtn.type = 'button';
            removeBtn.className = 'artm-ps-component-list__remove';
            removeBtn.setAttribute('aria-label', 'Remove');
            removeBtn.textContent = '×';
            removeBtn.addEventListener('click', function () {
                opt.selected = false;
                renderCardComponentList();
                refresh();
            });

            li.appendChild(badge);
            li.appendChild(label);
            li.appendChild(removeBtn);
            cardComponentOrderList.appendChild(li);
        });
        bindCardComponentDnD();
    }

    function bindCardComponentDnD() {
        if (!cardComponentOrderList) { return; }
        var dragging = null;
        cardComponentOrderList.querySelectorAll('li').forEach(function (li) {
            li.addEventListener('dragstart', function () { dragging = li; li.classList.add('dragging'); });
            li.addEventListener('dragend', function () {
                li.classList.remove('dragging');
                dragging = null;
                syncCardComponentOrderFromList();
            });
            li.addEventListener('dragover', function (e) {
                e.preventDefault();
                if (!dragging || dragging === li) { return; }
                var box = li.getBoundingClientRect();
                if (e.clientY < box.top + box.height / 2) {
                    cardComponentOrderList.insertBefore(dragging, li);
                } else {
                    cardComponentOrderList.insertBefore(dragging, li.nextSibling);
                }
            });
        });
    }

    function syncCardComponentOrderFromList() {
        if (!cardComponentOrderList || !cardComponents) { return; }
        var order = Array.from(cardComponentOrderList.querySelectorAll('li')).map(function (li) {
            return li.dataset.value;
        });
        reorderCardComponentSelect(order);
        renderCardComponentList();
        refresh();
    }

    function reorderCardComponentSelect(orderedValues) {
        if (!cardComponents) { return; }
        orderedValues.forEach(function (value) {
            var opt = getCardComponentOption(value);
            if (opt) {
                cardComponents.appendChild(opt);
            }
        });
    }

    function addCardComponent(value, priority) {
        var opt = getCardComponentOption(value);
        if (!opt) { return; }
        opt.selected = true;

        var order = getSelectedCardComponents().map(function (o) { return o.value; });
        order = order.filter(function (v) { return v !== value; });
        var targetIndex = Math.max(1, priority || (order.length + 1)) - 1;
        targetIndex = Math.min(targetIndex, order.length);
        order.splice(targetIndex, 0, value);

        reorderCardComponentSelect(order);
        renderCardComponentList();
        refresh();

        if (cardComponentPriority) {
            cardComponentPriority.value = String(order.length + 1);
        }
    }

    if (cardComponentAddBtn) {
        cardComponentAddBtn.addEventListener('click', function () {
            if (!cardComponentAddSelect || !cardComponentAddSelect.value) { return; }
            var priority = cardComponentPriority ? parseInt(cardComponentPriority.value, 10) : 0;
            addCardComponent(cardComponentAddSelect.value, priority);
        });
    }

    (function initCardComponentOrder() {
        if (!cardComponents || !cardComponentsSavedOrderEl) { return; }
        var savedOrder = [];
        try {
            savedOrder = JSON.parse(cardComponentsSavedOrderEl.textContent || '[]');
        } catch (e) {
            savedOrder = [];
        }
        if (Array.isArray(savedOrder) && savedOrder.length) {
            reorderCardComponentSelect(savedOrder);
        }
        if (cardComponentPriority) {
            cardComponentPriority.value = String(getSelectedCardComponents().length + 1);
        }
    })();

    function renderPickerRows(rows) {
        if (!pickerGridBody) { return; }
        pickerGridBody.innerHTML = '';
        rows.forEach(function (row) {
            var tr = document.createElement('tr');
            var checked = selectedSourceIds.indexOf(row.id) !== -1;
            tr.innerHTML = '' +
                '<td><input type="checkbox" data-id="' + row.id + '" ' + (checked ? 'checked' : '') + ' /></td>' +
                '<td>' + (row.image ? '<img src="' + row.image + '" alt="" width="40" />' : '-') + '</td>' +
                '<td>' + row.sku + '</td>' +
                '<td>' + row.name + '</td>' +
                '<td>' + Number(row.price).toFixed(2) + '</td>' +
                '<td>' + row.stock + '</td>';
            pickerGridBody.appendChild(tr);
        });

        pickerGridBody.querySelectorAll('input[type="checkbox"]').forEach(function (cb) {
            cb.addEventListener('change', function () {
                var id = parseInt(cb.getAttribute('data-id') || '0', 10);
                if (!id) { return; }
                if (cb.checked) {
                    if (selectedSourceIds.indexOf(id) === -1) {
                        selectedSourceIds.push(id);
                    }
                } else {
                    selectedSourceIds = selectedSourceIds.filter(function (v) { return v !== id; });
                }
                syncIdsToFields();
                renderSelectedOrderList();
                updatePreview();
            });
        });
    }

    function loadPickerProducts(attempt) {
        var tryIndex = typeof attempt === 'number' ? attempt : 0;
        var productSearchUrl = productSearchUrls[tryIndex] || '';
        if (!productSearchUrl) {
            setText(pickerStatus, 'Unable to load products (endpoint unavailable).');
            return;
        }
        var q = pickerQuery ? pickerQuery.value.trim() : '';
        var url = productSearchUrl + '?q=' + encodeURIComponent(q) + '&page=1&page_size=20&selected=' + encodeURIComponent(csv(selectedSourceIds));
        setText(pickerStatus, 'Loading products...');
        requestJson(url, { credentials: 'same-origin' }, function (json) {
            if (!json || !json.success || !json.data) {
                throw new Error((json && json.message) ? json.message : 'Unexpected response');
            }
            renderPickerRows(json.data.items || []);
            setText(pickerStatus, 'Loaded ' + ((json.data.items || []).length) + ' products. Tick checkboxes to select.');
        }, function (e) {
            if (tryIndex + 1 < productSearchUrls.length) {
                loadPickerProducts(tryIndex + 1);
                return;
            }
            if (pickerGridBody) {
                pickerGridBody.innerHTML = '';
            }
            setText(pickerStatus, 'Product search failed: ' + (e && e.message ? e.message : 'Request error'));
        });
    }

    function loadPreviewProducts(attempt) {
        var tryIndex = typeof attempt === 'number' ? attempt : 0;
        var previewProductsUrl = previewProductsUrls[tryIndex] || '';
        if (!previewProductsUrl || !previewProductsBody) {
            setText(previewStatus, 'Preview endpoint unavailable.');
            return;
        }
        var fd = new FormData(form);
        setText(previewStatus, 'Refreshing preview...');
        requestJson(previewProductsUrl, {
            method: 'POST',
            body: fd,
            credentials: 'same-origin'
        }, function (json) {
            if (!json || !json.success || !json.data) {
                throw new Error((json && json.message) ? json.message : 'Unexpected response');
            }
            var data = json.data;
            if (previewTotalFound) {
                previewTotalFound.textContent = String(data.total_found || 0);
            }
            previewProductsBody.innerHTML = '';
            (data.items || []).forEach(function (row) {
                var tr = document.createElement('tr');
                tr.innerHTML = '' +
                    '<td>' + (row.image ? '<img src="' + row.image + '" alt="" width="40" />' : '-') + '</td>' +
                    '<td>' + row.sku + '</td>' +
                    '<td>' + row.name + '</td>' +
                    '<td>' + Number(row.price).toFixed(2) + '</td>' +
                    '<td>' + row.stock + '</td>' +
                    '<td>' + row.category + '</td>' +
                    '<td>' + row.position + '</td>';
                previewProductsBody.appendChild(tr);
            });
            setText(previewStatus, 'Preview loaded: ' + ((data.items || []).length) + ' rows.');
        }, function (e) {
            if (tryIndex + 1 < previewProductsUrls.length) {
                loadPreviewProducts(tryIndex + 1);
                return;
            }
            if (previewProductsBody) {
                previewProductsBody.innerHTML = '';
            }
            setText(previewStatus, 'Preview failed: ' + (e && e.message ? e.message : 'Request error'));
        });
    }

    function getField(name) {
        return form.querySelector('[name="' + name + '"]');
    }

    function getCsvCount(value) {
        if (!value) { return 0; }
        return value.split(',').map(function (v) { return v.trim(); }).filter(function (v) { return v !== ''; }).length;
    }

    function getSelectText(el) {
        if (!el || !el.options || el.selectedIndex < 0) {
            return '-';
        }
        return (el.options[el.selectedIndex].text || '-').trim();
    }

    function updatePreview() {
        var source = sourceType ? sourceType.value : '';
        var sourceLabel = getSelectText(sourceType);
        var sortingLabel = getSelectText(sortingType);
        var displayLabel = getSelectText(displayType);
        var autoplayValue = autoplay ? autoplay.value : '0';
        var productLimitField = getField('slider[product_limit]');
        var productLimit = productLimitField ? (productLimitField.value || '0') : '0';

        var configuredCount = 0;
        if (source === 'products') {
            var sourceProducts = getField('slider[source_product_ids]');
            configuredCount = getCsvCount(sourceProducts ? sourceProducts.value : '');
        } else if (source === 'category') {
            var categoryIds = getField('slider[category_ids]');
            configuredCount = getCsvCount(categoryIds ? categoryIds.value : '');
        } else if (source === 'mixed') {
            var mixedCategories = getField('slider[mixed_category_ids]');
            var mixedProducts = getField('slider[mixed_product_ids]');
            configuredCount = getCsvCount(mixedCategories ? mixedCategories.value : '') + getCsvCount(mixedProducts ? mixedProducts.value : '');
        }

        if (previewSourceType) { previewSourceType.textContent = sourceLabel; }
        if (previewProductLimit) { previewProductLimit.textContent = productLimit; }
        if (previewSorting) { previewSorting.textContent = sortingLabel; }
        if (previewDisplayType) { previewDisplayType.textContent = displayLabel; }
        if (previewAutoplay) {
            if (autoplayValue === '1') {
                var delayField = getField('slider[autoplay_delay]');
                var speedField = getField('slider[autoplay_speed]');
                var delay = delayField ? delayField.value : '3000';
                var speed = speedField ? speedField.value : '300';
                previewAutoplay.textContent = 'On (Delay: ' + delay + 'ms, Speed: ' + speed + 'ms)';
            } else {
                previewAutoplay.textContent = 'Off';
            }
        }
        if (previewSourceCount) {
            previewSourceCount.textContent = configuredCount > 0 ? String(configuredCount) : '-';
        }
        if (previewHint) {
            if (configuredCount > 0) {
                previewHint.textContent = 'Preview estimate: up to ' + Math.min(configuredCount, parseInt(productLimit, 10) || 0) + ' products can be shown after filters and sorting.';
            } else {
                previewHint.textContent = 'Add source IDs to see a better preview estimate.';
            }
        }

        loadPreviewProducts();
    }

    function toggle(selector, show) {
        form.querySelectorAll(selector).forEach(function (el) {
            el.style.display = show ? '' : 'none';
            el.querySelectorAll('input, select, textarea').forEach(function (field) {
                if (field.id === 'button_link_manual' || field.id === 'button_link_category') {
                    return;
                }
                field.disabled = !show;
            });
        });
    }

    function syncButtonLinkValue() {
        if (!hiddenButtonLink) { return; }
        if (buttonLinkType && buttonLinkType.value === 'category') {
            hiddenButtonLink.value = buttonCategory ? buttonCategory.value : '';
        } else {
            hiddenButtonLink.value = buttonManual ? buttonManual.value : '';
        }
    }

    function refresh() {
        var source = sourceType ? sourceType.value : '';
        toggle('[data-dep="source-category"]', source === 'category');
        toggle('[data-dep="source-products"]', source === 'products' || source === 'mixed');
        toggle('[data-dep="source-mixed"]', source === 'mixed');

        var display = displayType ? displayType.value : '';
        toggle('[data-dep="display-slider"]', display === 'slider');
        toggle('[data-dep="display-grid"]', display === 'grid');

        var sorting = sortingType ? sortingType.value : '';
        toggle('[data-dep="sorting-manual"]', sorting === 'manual');
        toggle('[data-dep="sorting-custom"]', sorting === 'custom_attribute');

        var ap = autoplay ? autoplay.value : '0';
        toggle('[data-dep="autoplay-on"]', ap === '1');

        var linkType = buttonLinkType ? buttonLinkType.value : 'manual';
        toggle('[data-dep="button-link-manual"]', linkType === 'manual');
        toggle('[data-dep="button-link-category"]', linkType === 'category');

        var customEnabled = false;
        if (cardComponents) {
            Array.from(cardComponents.options).forEach(function (opt) {
                if (opt.selected && opt.value === 'custom_attributes') {
                    customEnabled = true;
                }
            });
        }
        toggle('[data-dep="card-custom-attributes"]', customEnabled);

        syncButtonLinkValue();
        updatePreview();
    }

    [sourceType, displayType, sortingType, autoplay, buttonLinkType, cardComponents, buttonManual, buttonCategory].forEach(function (el) {
        if (!el) { return; }
        el.addEventListener('change', refresh);
        el.addEventListener('input', refresh);
    });

    if (sourceType) {
        sourceType.addEventListener('change', function () {
            hydrateSelectedFromActiveField();
            renderSelectedOrderList();
            loadPickerProducts();
            updatePreview();
        });
    }

    if (pickerSearch) {
        pickerSearch.addEventListener('click', loadPickerProducts);
    }
    if (pickerQuery) {
        pickerQuery.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                loadPickerProducts();
            }
        });
    }

    if (sourceProductIdsField) {
        sourceProductIdsField.addEventListener('change', function () {
            if (sourceType && sourceType.value !== 'products') {
                return;
            }
            selectedSourceIds = parseCsv(sourceProductIdsField.value);
            syncIdsToFields();
            renderSelectedOrderList();
            loadPickerProducts();
        });
        sourceProductIdsField.addEventListener('input', function () {
            if (sourceType && sourceType.value !== 'products') {
                return;
            }
            selectedSourceIds = parseCsv(sourceProductIdsField.value);
            syncIdsToFields();
            renderSelectedOrderList();
        });
    }

    if (mixedProductIdsField) {
        mixedProductIdsField.addEventListener('change', function () {
            if (sourceType && sourceType.value !== 'mixed') {
                return;
            }
            selectedSourceIds = parseCsv(mixedProductIdsField.value);
            syncIdsToFields();
            renderSelectedOrderList();
            loadPickerProducts();
        });
        mixedProductIdsField.addEventListener('input', function () {
            if (sourceType && sourceType.value !== 'mixed') {
                return;
            }
            selectedSourceIds = parseCsv(mixedProductIdsField.value);
            syncIdsToFields();
            renderSelectedOrderList();
        });
    }

    form.querySelectorAll('input, select, textarea').forEach(function (el) {
        el.addEventListener('change', updatePreview);
        el.addEventListener('input', updatePreview);
    });

    form.addEventListener('submit', syncButtonLinkValue);
    syncIdsToFields();
    renderSelectedOrderList();
    renderCardComponentList();
    loadPickerProducts();
    refresh();
})();
</script>
