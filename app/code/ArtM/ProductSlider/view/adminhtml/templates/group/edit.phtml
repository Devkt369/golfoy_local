$selectedCustomerGroups = $block->getSelectedValues('customer_group_ids');
$tabs = isset($data['tabs']) && is_array($data['tabs']) ? $data['tabs'] : [];
?>
<div class="admin__page-section artm-ps-page">
    <div class="admin__page-section-title artm-ps-header">
        <span class="title"><?= $block->escapeHtml($block->isEdit() ? __('Edit Slider Group') : __('New Slider Group')) ?></span>
    </div>
    <div class="admin__page-section-content artm-ps-content">
        <div class="artm-ps-toolbar">
