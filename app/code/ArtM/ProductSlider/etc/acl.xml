<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="ArtM_ProductSlider::productslider" title="Product Sliders" sortOrder="200">
                    <resource id="ArtM_ProductSlider::manage_sliders" title="Manage Sliders" sortOrder="10">
                        <resource id="ArtM_ProductSlider::slider_save" title="Save Slider" sortOrder="10"/>
                        <resource id="ArtM_ProductSlider::slider_delete" title="Delete Slider" sortOrder="20"/>
                        <resource id="ArtM_ProductSlider::slider_mass" title="Slider Mass Actions" sortOrder="30"/>
                        <resource id="ArtM_ProductSlider::slider_duplicate" title="Duplicate Slider" sortOrder="40"/>
                    </resource>
                    <resource id="ArtM_ProductSlider::manage_slider_groups" title="Manage Slider Groups" sortOrder="20">
                        <resource id="ArtM_ProductSlider::group_save" title="Save Slider Group" sortOrder="10"/>
                        <resource id="ArtM_ProductSlider::group_delete" title="Delete Slider Group" sortOrder="20"/>
                        <resource id="ArtM_ProductSlider::group_mass" title="Slider Group Mass Actions" sortOrder="30"/>
                    </resource>
                    <resource id="ArtM_ProductSlider::settings" title="Settings" sortOrder="30"/>
                    <resource id="ArtM_ProductSlider::config" title="Configuration" sortOrder="40"/>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
