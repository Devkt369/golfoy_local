<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="artm_tradein" resource="default">
        <column name="purchase_date" xsi:type="datetime" nullable="true" comment="Purchase Date"/>
        <column name="invoice_file" xsi:type="varchar" length="100" nullable="true" comment="Invoice File"/>
        <column name="purchased_from" xsi:type="varchar" length="10" nullable="true" comment="Purchased From"/>
        <column name="seller_name" xsi:type="varchar" length="30" nullable="true" comment="Seller Name"/>
        <column name="order_id" xsi:type="varchar" length="30" nullable="true" comment="Order ID"/>
    </table>
</schema>