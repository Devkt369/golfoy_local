        const signonPopup = document.getElementById("signon_button");

        if (socialLoginBtn && signonPopup) {
            socialLoginBtn.addEventListener("click", function(e) {
                e.preventDefault();
                signonPopup.style.display = "block";
            });
        }
    });
</script>

<script>
    require([
        'jquery',
        'jquery/ui',
        "mage/calendar"
    ], function(jQuery, calendar) {
        jQuery(document).ready(function() {

            jQuery('#purchase_date').calendar({
                changeMonth: true,
                changeYear: true,
                showButtonPanel: true,
                currentText: 'Go Today',
                closeText: 'Close',
                showWeek: true,
                dateFormat: 'dd-mm-yy',
            });


            jQuery('#invoice_upload').on('change', function() {
                var fileInput = this;
                if (fileInput.files.length === 0) {
                    return; // no file selected
                }

                var formData = new FormData();
                formData.append('invoice_upload', fileInput.files[0]);


                var allowedExtensions = ['pdf', 'jpg', 'jpeg', 'png'];
                var file = fileInput.files[0];
                var fileName = file.name;
                var fileExtension = fileName.split('.').pop().toLowerCase();

                if (!allowedExtensions.includes(fileExtension)) {
                    jQuery("div#upload_status").after("<div class='error-message'>Invalid file type. Allowed types are: PDF, JPG, JPEG, PNG</div>");
                    fileInput.value = '';
                    return;
                }

                jQuery.ajax({
                    url: '<?= $block->getUrl("tradein/index/upload") ?>', // adjust URL accordingly
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    showLoader: true,
                    success: function(response) {
                        console.log('Upload successful:', response);
                        if (response.success) {
                            jQuery('#invoice_upload_hidden').val(response.url);
                            jQuery('#uploaded_invoice_preview')
                                .attr('src', response.file.toLowerCase().endsWith('.pdf') ? 'https://golfoy.com/media/customprint/pdf.svg' : response.url)
                                .attr('rel', response.url);
                            jQuery('.uploaded-preview').append("<div class='uploaded-file-name'>" + fileName + "</div>");
                            jQuery('#upload_status').show();
                            jQuery('img#uploaded_invoice_preview').show();
                            jQuery('button#remove_uploaded_file').show();
                            jQuery('#invoice_upload').hide();
                        } else {
                            jQuery("div#upload_status").after("<div class='error-message'>Upload failed: " + response.message + "</div>");
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Upload failed:', error);
                    }
                });
            });

            jQuery('#remove_uploaded_file').on('click', function() {
                const fileUrl = jQuery('#invoice_upload_hidden').val();
                const fileName = fileUrl.split('/').pop();
                jQuery('.uploaded-file-name').remove();
                jQuery.ajax({
                    url: '/tradein/index/delete',
                    type: 'POST',
                    data: {
                        filename: fileName
                    },
                    dataType: 'json',
                    showLoader: true,
                    success: function(response) {
                        // jQuery('#upload_status').text('');
                        jQuery('#invoice_upload_hidden').val('');
                        jQuery('#uploaded_invoice_preview').attr('src', '').hide();
                        jQuery('#invoice_upload').val('').show();
                        jQuery('#remove_uploaded_file').hide();
                    },
                    error: function(xhr, status, error) {
                        console.error('Delete error:', error);
                    }
                });
            });

            jQuery('.authorization-link.signin_signout.tradeinform_login_link a.social-login-btn').on('click', function(e) {
                e.preventDefault();
                jQuery('.hidden-sm.hidden-xs.authorization-link.signin_signout.sso').click();
            });
        });
    });
</script>