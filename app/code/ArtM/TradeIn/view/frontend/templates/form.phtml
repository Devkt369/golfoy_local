<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Generic button group handler
        function setupButtonGroup(groupId, callback) {
            const group = document.getElementById(groupId);
            const buttons = group.querySelectorAll('.value_button');

            buttons.forEach(button => {
                button.addEventListener('click', () => {
                    buttons.forEach(btn => btn.classList.remove('active'));
                    button.classList.add('active');
                    callback(button.getAttribute('data-value'));
                });
            });
        }

        // Invoice Availability
        setupButtonGroup('invoice_available_group', function(value) {
            const wrapper = document.getElementById('invoice_upload_wrapper');
            wrapper.classList.toggle('hidden', value !== 'yes');
            if (value !== 'yes') {
                document.getElementById('remove_uploaded_file').click();
            }
        });

        // Purchased From
        setupButtonGroup('purchased_from_group', function(value) {
            const golfoyInput = document.getElementById('golfoy_order_id');
            const otherInput = document.getElementById('other_seller_name');
            golfoyInput.classList.add('hidden');
            otherInput.classList.add('hidden');
            golfoyInput.querySelector('input').value = '';
            otherInput.querySelector('input').value = '';
            document.querySelector('input[name="purchased_from"]').value = value;
            if (value === 'golfoy') {
                golfoyInput.classList.remove('hidden');
            } else if (value === 'other') {
                otherInput.classList.remove('hidden');
            }
        });
    });

    var acc = document.getElementsByClassName("accordion");
    var i;

    for (i = 0; i < acc.length; i++) {
        acc[i].addEventListener("click", function() {
            this.classList.toggle("active");
            var panel = this.nextElementSibling;
            if (panel.style.display === "block") {
                panel.style.display = "none";
            } else {
                panel.style.display = "block";
            }
        });
    }
</script>
