<script>
    function handleOptionChange(selectElement) {
        const inputContainer = selectElement.parentElement.querySelector('#other-input-container');

        if (selectElement.value === 'other') {
            inputContainer.style.display = 'block';
        } else {
            inputContainer.style.display = 'none';
        }
    }
    require(['jquery'], function(jQuery) {
        jQuery(document).ready(function() {
            jQuery('.submit_tradein_row').click(function() {
                var curr_button = jQuery(this);


                var row = curr_button.closest('tr');

                var selectedOption = row.find('.tradein-select').val();
                var paymentComment = (selectedOption === 'other') ?
                    row.find('.other-input').val().trim() :
                    "Gift card";

                var refId = row.find('.ref-input').val().trim();
                var amount = row.find('.amount-input').val().trim();

                if (refId === '' || amount === '' || paymentComment === '') {
                    const refInput = row.find('.ref-input');
                    const amountInput = row.find('.amount-input');
                    const otherInput = row.find('.other-input');

                    if (refId === '') {
                        refInput.css('border', '2px solid red');
                    } else {
                        refInput.css('border', '');
                    }
                    if (amount === '') {
                        amountInput.css('border', '2px solid red');
                    } else {
                        amountInput.css('border', '');
                    }
                    if (otherInput === '') {
                        otherInput.css('border', '2px solid red');
                    } else {
                        otherInput.css('border', '');
                    }
                    return;
                }

                curr_button.text('Updating');
                var row_id = curr_button.attr('data-id');
                var domain = window.location.hostname;
                var url = "<?php echo $this->getBaseUrl(); ?>" + "tradein/index/adminajax";

                jQuery.ajax({
                    url: url,
                    type: "POST",
                    data: {
                        id: row_id,
                        payment_comment: paymentComment,
                        ref_id: refId,
                        amount: amount
                    },
                    dataType: 'json',
                    showLoader: true,
                    success: function(res) {
                        // row.find('.tradein-select').remove();
                        // row.find('div#other-input-container').remove();
                        row.find('.ref-input').attr('disabled', 'disabled');
                        row.find('.amount-input').attr('disabled', 'disabled');
                        row.find('.tradein-select').attr('disabled', 'disabled');
                        row.find('.other-input').attr('disabled', 'disabled');
                        curr_button.text('Updated');
                        // setTimeout(function(){
                        //     curr_button.text('Update Again');
                        // } , 1000);
                    },
                    error: function(xhr, status, error) {},
                    complete: function() {}
                });

            });

            jQuery('.update-status').click(function() {
                var curr_button = jQuery(this);
                curr_button.text('Updating');
                var row = curr_button.closest('tr');

                var data_target_row = jQuery(this).attr('data-target-row');
                var status = jQuery('tr.' + data_target_row + '').find('.status_tradein_admin').val().toLowerCase();

                var row_id = jQuery(this).attr('data-id');


                var domain = window.location.hostname;
                var url = "<?php echo $this->getBaseUrl(); ?>" + "tradein/index/updatestatus";

                jQuery.ajax({
                    url: url,
                    type: "POST",
                    data: 'status=' + status + '&id=' + row_id,
                    dataType: 'json',
                    showLoader: true,
                    success: function(res) {
                        curr_button.text('Updated');
                        setTimeout(function() {
                            curr_button.text('Update Again');
                        }, 1000);
                    },
                    error: function(xhr, status, error) {},
                    complete: function() {}
                });

            });
