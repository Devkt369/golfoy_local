<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">artm_tradein_listing_working.artm_tradein_listing_working_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>artm_tradein_listing_working_columns</spinner>
        <deps>
            <dep>artm_tradein_listing_working.artm_tradein_listing_working_data_source</dep>
        </deps>
    </settings>
    <dataSource name="artm_tradein_listing_working_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">tradein_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <dataProvider class="ArtM\TradeIn\Ui\DataProvider\TradeInDataProvider" name="artm_tradein_listing_working_data_source">
            <settings>
                <requestFieldName>tradein_id</requestFieldName>
                <primaryFieldName>tradein_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="artm_tradein_listing_working_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>tradein_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="tradein_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Trade ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>
        <column name="ad_id">
            <settings>
                <filter>text</filter>
                <label translate="true">Ad ID</label>
            </settings>
        </column>
        <column name="email">
            <settings>
                <filter>text</filter>
                <label translate="true">Email</label>
            </settings>
        </column>
        <column name="equipment">
            <settings>
                <filter>text</filter>
                <label translate="true">Equipment</label>
            </settings>
        </column>
        <column name="brand">
            <settings>
                <filter>text</filter>
                <label translate="true">Brand</label>
            </settings>
        </column>
        <column name="model">
            <settings>
                <filter>text</filter>
                <label translate="true">Model</label>
            </settings>
        </column>
        <column name="name">
            <settings>
                <filter>text</filter>
                <label translate="true">Name</label>
            </settings>
        </column>
        <column name="contact_number">
            <settings>
                <filter>text</filter>
                <label translate="true">Contact Number</label>
            </settings>
        </column>
        <column name="status">
            <settings>
                <filter>text</filter>
                <label translate="true">Status</label>
            </settings>
        </column>
    </columns>
</listing>
