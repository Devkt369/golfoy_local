    public function totalSoldSpecific($attset, $attrtype, $label, $array=[], $brandselected =''){

        $attrsetcond = $this->getAttrsetCond($attset);
        $attrkey     = key($attrtype);
        $attrvalue   = current($attrtype);
        if(!empty($array)){
            $keylabels = $keydata = [];
            foreach($array as $k=> $v){

                if($brandselected != ''){

                    $sql = "SELECT 
                SUM(oi.qty_ordered) AS total_qty_ordered
                FROM 
                    sales_order AS o 
                JOIN 
                    sales_order_item AS oi ON oi.order_id = o.entity_id 
                JOIN 
                    catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                LEFT JOIN 
                    catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133 
               JOIN 
                    catalog_product_entity_int AS cpevbag ON cpevbag.entity_id = oi.product_id AND cpevbag.attribute_id = $attrkey AND cpevbag.value = $attrvalue
                WHERE 
                    o.state IN ('complete','processing')
                    /*AND oi.parent_item_id IS NULL*/
                    AND o.store_id = 1
                    AND oi.product_type = 'simple' AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                    AND cpei.value = $brandselected                   
                    AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'";


                }else{                

                    $sql = "SELECT 
                    SUM(oi.qty_ordered) AS total_qty_ordered
                    FROM 
                        sales_order AS o 
                    JOIN 
                        sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN 
                        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                    JOIN 
                        catalog_product_entity_int AS cpevbag ON cpevbag.entity_id = oi.product_id AND cpevbag.attribute_id = $attrkey AND cpevbag.value = $attrvalue
                    WHERE 
                        o.state IN ('complete','processing')
                        AND o.store_id = 1
                        /*AND oi.parent_item_id IS NULL*/
                        AND oi.product_type = 'simple' AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled                   
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'";

                }


                $result = $this->resource->getConnection()->fetchAll($sql);
                
               
               // echo "<h4> $label ($k) : </h4>";
                if (!empty($result)) { 
                   
                    foreach ($result as $item) { 
                        $total = floatval($item['total_qty_ordered']); 
                        $keylabels[] = $k;
                        $keydata[] = $total;
                    }
                    
                }
                
            }
            echo "<div class= 'container row'><div class = col-m-12> <h4> $label  </h4>";
            echo "<table class='admin__table-primary analysis-data'><tr>";
                foreach($keylabels as  $value){
                    echo "<th> $value </th>";
                }
                echo "<tr></tr>";
                foreach($keydata as  $value){
                    echo "<td> $value </td>";
                }
            echo "</tr></table></div></div>";

        }else{

            if($brandselected != ''){
                $sql = "SELECT 
                SUM(oi.qty_ordered) AS total_qty_ordered
                FROM 
                    sales_order AS o 
                JOIN 
                    sales_order_item AS oi ON oi.order_id = o.entity_id 
                JOIN 
                    catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                LEFT JOIN 
                    catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133 
                JOIN 
                    catalog_product_entity_int AS cpevbag ON cpevbag.entity_id = oi.product_id AND cpevbag.attribute_id = $attrkey AND cpevbag.value = $attrvalue
                WHERE 
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    /*AND oi.parent_item_id IS NULL*/
                    AND cpei.value = $brandselected         
                    AND oi.product_type = 'simple' AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled";

            }else{
                $sql = "SELECT 
                SUM(oi.qty_ordered) AS total_qty_ordered
                FROM 
                    sales_order AS o 
                JOIN 
                    sales_order_item AS oi ON oi.order_id = o.entity_id 
                JOIN 
                    catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                JOIN 
                    catalog_product_entity_int AS cpevbag ON cpevbag.entity_id = oi.product_id AND cpevbag.attribute_id = $attrkey AND cpevbag.value = $attrvalue
                WHERE 
                    o.state IN ('complete','processing')
                    /*AND oi.parent_item_id IS NULL*/
                    AND oi.product_type = 'simple' AND o.store_id = 1 AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled";
            }
            
            $result = $this->resource->getConnection()->fetchAll($sql);
            
            echo "<div class= 'container row'><div class = col-m-12>";
            //echo "<h4> $label </h4>";
            if (!empty($result)) { 
              
                foreach ($result as $item) { 
                    $total = floatval($item['total_qty_ordered']);  
                    echo "<h4> $label : $total </h4>"; 
                }
                
            }
            echo "</div></div>";
        }

    }



