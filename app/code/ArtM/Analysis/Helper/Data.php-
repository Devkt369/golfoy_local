public function topAttrSoldColor($attset, $attr, $label, $array=[], $brandselected =''){        
        
    $attrsetcond = $this->getAttrsetCond($attset);
    $attr = (int) $attr;

    if(!empty($array)){
        foreach($array as $k=> $v){

            if($brandselected != ''){
                $sql = "SELECT 
                eavov.value AS option_label,
                SUM(oi.qty_ordered) AS total_qty_ordered,
                oi.item_id,
                oi.parent_item_id
                FROM 
                    sales_order AS o 
                JOIN 
                    sales_order_item AS oi ON oi.order_id = o.entity_id 
                JOIN 
                    catalog_product_entity_int AS cpev ON cpev.entity_id = oi.product_id AND cpev.attribute_id = $attr
                JOIN
                    eav_attribute_option_value AS eavov ON eavov.option_id = cpev.value AND eavov.store_id = 0
                JOIN
                    catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                LEFT JOIN 
                    catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133 
                WHERE
                    o.state IN ('complete','processing') 
                    AND o.store_id = 1
                    AND cpei.value = $brandselected
                    AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                    AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                GROUP BY
                    eavov.value, oi.item_id, oi.parent_item_id";
            }else{
                $sql = "SELECT 
                  eavov.value AS option_label,
                SUM(oi.qty_ordered) AS total_qty_ordered,
                oi.item_id,
                oi.parent_item_id
                FROM 
                    sales_order AS o 
                JOIN 
                    sales_order_item AS oi ON oi.order_id = o.entity_id 
                JOIN 
                    catalog_product_entity_int AS cpev ON cpev.entity_id = oi.product_id AND cpev.attribute_id = $attr
                JOIN
                    eav_attribute_option_value AS eavov ON eavov.option_id = cpev.value AND eavov.store_id = 0
                JOIN
                    catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                WHERE
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                    AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
               GROUP BY
                    eavov.value, oi.item_id, oi.parent_item_id";

            }

            $records = $this->resource->getConnection()->fetchAll($sql);
            $filteredRecords = [];
            foreach ($records as $record) {
                $isDuplicate = false;
                foreach ($records as $otherRecord) {
                    if ($record['item_id'] === $otherRecord['parent_item_id']) {
                        $isDuplicate = true;
                        break;
                    }
                }
                if (!$isDuplicate) {
                    $filteredRecords[] = $record;
                }
            }

            $result = [];
            foreach ($filteredRecords as $record) {
                $optionLabel = $record['option_label'];
                $qtyOrdered = $record['total_qty_ordered'];
                
                if (!isset($result[$optionLabel])) {                  
                    $result[$optionLabel] = $qtyOrdered;
                } else {                   
                    $result[$optionLabel] += $qtyOrdered;
                }
            }
            
            arsort($result);
            $result = array_slice($result, 0, 15, true);

            echo "<div class = col-m-12>";
            echo "<h4 class='newblk'> $label ($k) </h4>";
            if (!empty($result)) { 
                echo "<table class='admin__table-primary analysis-data'><tr><th>".$this->data['attrLabels'][$attr]."</th><th>Qty ordered</th></tr>";
                foreach ($result as $itemkey => $item) {   
                    $total = floatval($item);             
                    echo "<tr><td>$itemkey</td><td>$total</td></tr>";
                }
                echo "</table>";
            }
            echo "</div>";
        }
    }else{
        if($brandselected != ''){
            $sql = "SELECT 
            eavov.value AS option_label,
                SUM(oi.qty_ordered) AS total_qty_ordered,
                oi.item_id,
                oi.parent_item_id
            FROM 
                sales_order AS o 
            JOIN 
                sales_order_item AS oi ON oi.order_id = o.entity_id 
            JOIN 
                catalog_product_entity_int AS cpev ON cpev.entity_id = oi.product_id AND cpev.attribute_id = $attr
            JOIN
                eav_attribute_option_value AS eavov ON eavov.option_id = cpev.value AND eavov.store_id = 0
            JOIN
                catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
            LEFT JOIN 
                catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133 
            WHERE
                o.state IN ('complete','processing') 
                AND o.store_id = 1
                AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                AND cpei.value = $brandselected
                GROUP BY
                    eavov.value, oi.item_id, oi.parent_item_id";

        }else{

            $sql = "SELECT 
            eavov.value AS option_label,
                SUM(oi.qty_ordered) AS total_qty_ordered,
                oi.item_id,
                oi.parent_item_id
            FROM 
                sales_order AS o 
            JOIN 
                sales_order_item AS oi ON oi.order_id = o.entity_id 
            JOIN 
                catalog_product_entity_int AS cpev ON cpev.entity_id = oi.product_id AND cpev.attribute_id = $attr
            JOIN
                eav_attribute_option_value AS eavov ON eavov.option_id = cpev.value AND eavov.store_id = 0
            JOIN
                catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
            WHERE
                o.state IN ('complete','processing')  
                AND o.store_id = 1
                AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled             
                GROUP BY
                    eavov.value, oi.item_id, oi.parent_item_id";

        }
       
        $records = $this->resource->getConnection()->fetchAll($sql);
        $filteredRecords = [];
        foreach ($records as $record) {
            $isDuplicate = false;
            foreach ($records as $otherRecord) {
                if ($record['item_id'] === $otherRecord['parent_item_id']) {
                    $isDuplicate = true;
                    break;
                }
            }
            if (!$isDuplicate) {
                $filteredRecords[] = $record;
            }
        }

        $result = [];
        foreach ($filteredRecords as $record) {
            $optionLabel = $record['option_label'];
            $qtyOrdered = $record['total_qty_ordered'];
            
            if (!isset($result[$optionLabel])) {                  
                $result[$optionLabel] = $qtyOrdered;
            } else {                   
                $result[$optionLabel] += $qtyOrdered;
            }
        }
        
        arsort($result);
        $result = array_slice($result, 0, 15, true);

        echo "<div class = col-m-12>";
        echo "<h4 class='newblk'> $label </h4>";
        if (!empty($result)) { 
            echo "<table class='admin__table-primary analysis-data'><tr><th>".$this->data['attrLabels'][$attr]."</th><th>Qty ordered</th></tr>";
            foreach ($result as $itemkey => $item) {   
                $total = floatval($item);             
                echo "<tr><td>$itemkey</td><td>$total</td></tr>";
            }
            echo "</table>";
        }
        echo "</div>";
    }
}

public function topAttrSoldArrayColor($attset, $attr, $brandselected ='',){        
    
    $attrsetcond = $this->getAttrsetCond($attset);
   
    $attr = (int) $attr;

        $return = [];

