                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                    GROUP BY 
                        price_range
                    ORDER BY price_range";

                }
                
                $result = $this->resource->getConnection()->fetchAll($sql);
                
              
                if (!empty($result)) { 
                    $datalabels[] = $k;
                    $tmparr = ['0-499'=>0, '500-999'=>0, '1000-1499'=>0,'1500-above'=>0];
                 
                    foreach ($result as $item) { 
                        $total = floatval($item['total_ordered']);   
                        $tmparr[$item['price_range']] = $total;  
                    }
                    $datarange['0-499'][] = $tmparr['0-499'];
                    $datarange['500-999'][] = $tmparr['500-999'];
                    $datarange['1000-1499'][] = $tmparr['1000-1499'];
                    $datarange['1500-above'][] = $tmparr['1500-above'];                    
                }
                
            }
           echo "<div class= 'container row'><div class = col-m-12> <h4> $label  </h4>";
            echo "<table class='admin__table-primary analysis-data'><tr>";
           
                foreach( $datalabels as  $value){
                    echo "<th> $value </th>";
                }
                echo "<tr></tr>";
                foreach($datarange['0-499'] as  $value){
                    echo "<td> $value </td>";
                }
                echo "<tr></tr>";
                foreach($datarange['500-999'] as  $value){
                    echo "<td> $value </td>";
                }
                echo "<tr></tr>";
                foreach($datarange['1000-1499'] as  $value){
                    echo "<td> $value </td>";
                }
                echo "<tr></tr>";
                foreach($datarange['1500-above'] as  $value){
                    echo "<td> $value </td>";
                }
            echo "</tr></table></div></div>";
        }else{   
            
            if($brandselected != ''){
                 
                $sql = " SELECT 
                CASE 
                WHEN price_incl_tax >= 0 AND price_incl_tax < 500 THEN '0-499' 
                    WHEN price_incl_tax >= 500 AND price_incl_tax < 1000 THEN '500-999'
                    WHEN price_incl_tax >= 1000 AND price_incl_tax < 1500 THEN '1000-1499'
                    ELSE '1500-above' 
                END AS price_range,
                SUM(oi.qty_ordered) AS total_ordered
                FROM 
                    sales_order AS o 
                    JOIN sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                    LEFT JOIN 
                    catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133
                WHERE 
                    o.state IN ('complete','processing') 
                    AND o.store_id = 1
                    AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                    AND cpei.value = $brandselected
                    AND oi.price_incl_tax IS NOT NULL
                GROUP BY 
                    price_range
                ORDER BY price_range";
            }else{
                $sql = " SELECT 
                CASE 
                WHEN price_incl_tax >= 0 AND price_incl_tax < 500 THEN '0-499' 
                    WHEN price_incl_tax >= 500 AND price_incl_tax < 1000 THEN '500-999'
                    WHEN price_incl_tax >= 1000 AND price_incl_tax < 1500 THEN '1000-1499'
                    ELSE '1500-above'    
                END AS price_range,
                SUM(oi.qty_ordered) AS total_ordered
                FROM 
                    sales_order AS o 
                    JOIN sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                WHERE 
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                    AND oi.price_incl_tax IS NOT NULL
                GROUP BY 
                    price_range
                ORDER BY price_range";

            }
            
            $result = $this->resource->getConnection()->fetchAll($sql);
            
            echo "<div class = col-m-12>";
            echo "<h4 class='newblk'> $label </h4>";
            if (!empty($result)) { 
                echo "<table class='admin__table-primary analysis-data'><tr><th>Price Range</th><th>Qty ordered</th></tr>";
                foreach ($result as $item) {   
                    $total = floatval($item['total_ordered']);             
                    echo "<tr><td>$item[price_range]</td><td>$total</td></tr>";
                }
                echo "</table>";
            }
            echo "</div>";
        }
    }

    public function PRangeAttrGripGraph($attset, $interval, $brandselected =''){
        
        if(is_array($attset)){
            $graphid = $attset[0];
        }else{
            $graphid = $attset;
        }
        $attrsetcond = $this->getAttrsetCond($attset);
        
        $labels = [];
        $gData  = [];
      
        $daterange = $this->getDaterange();
        $array = $daterange[$interval];
        if(!empty($array)){
            foreach($array as $k=> $v){
               
                if($brandselected != ''){
                    $sql = " SELECT 
                    CASE 
                    WHEN price_incl_tax >= 0 AND price_incl_tax < 500 THEN '0-499' 
                    WHEN price_incl_tax >= 500 AND price_incl_tax < 1000 THEN '500-999'
                    WHEN price_incl_tax >= 1000 AND price_incl_tax < 1500 THEN '1000-1499'
                    ELSE '1500-above' 
                    END AS price_range,
                    SUM(oi.qty_ordered) AS total_ordered
                    FROM 
                        sales_order AS o 
                        JOIN sales_order_item AS oi ON oi.order_id = o.entity_id 
                        JOIN catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                        LEFT JOIN 
                        catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133
                    WHERE 
                        o.state IN ('complete','processing')
                        AND o.store_id = 1
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND cpei.value = $brandselected
                        AND oi.price_incl_tax IS NOT NULL
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                    GROUP BY 
                        price_range
                    ORDER BY price_range";

                }else{
                    $sql = " SELECT 
                    CASE 
                    WHEN price_incl_tax >= 0 AND price_incl_tax < 500 THEN '0-499' 
                    WHEN price_incl_tax >= 500 AND price_incl_tax < 1000 THEN '500-999'
                    WHEN price_incl_tax >= 1000 AND price_incl_tax < 1500 THEN '1000-1499'
                    ELSE '1500-above' 
                    END AS price_range,
                    SUM(oi.qty_ordered) AS total_ordered
                    FROM 
                        sales_order AS o 
                        JOIN sales_order_item AS oi ON oi.order_id = o.entity_id 
                        JOIN catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                    WHERE 
                        o.state IN ('complete','processing') 
                        AND o.store_id = 1
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND oi.price_incl_tax IS NOT NULL
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                    GROUP BY 
                        price_range
                    ORDER BY price_range";

                }
                
                $result = $this->resource->getConnection()->fetchAll($sql);
                if (!empty($result)) { 
                    $labels[] = $k;    
                    $tmparr = ['0-499'=>0, '500-999'=>0, '1000-1499'=>0,'1500-above'=>0];
                         
                    foreach($result as $item) {   
                        $total = floatval($item['total_ordered']); 
                        $range = $item['price_range'];
                        $tmparr[$range] = $total;
                    }
                    foreach($tmparr as  $r => $tmp) { 
                        $gData[$r][]  = $tmp ; 
                    }
                }
               
            }

        }
        if($interval == 'monthly'){
            echo "<div class = col-m-12>";
        }else{
            echo "<div class = col-m-6>";
        }
        
        $labelsjsonenc = json_encode($labels);
        $labelsjsonvalue = htmlspecialchars($labelsjsonenc, ENT_QUOTES, 'UTF-8');
       
        
        $colors= ['#4BC0C0','#ff6361','#003f5c','#8B4513','#663046'];
        $datasets = [];
        $i = 0;
        foreach($gData as $k => $v){
            $datasets[] =   [
                'label' => $k ,
                'data' => $v,
                'borderColor' => $colors[$i],
                'fill' => false,
                'tension' => 0.1
            ];
            $i++;
        } 
        $datasetsjsonenc = json_encode($datasets);
        $datasetsjsonvalue = htmlspecialchars($datasetsjsonenc, ENT_QUOTES, 'UTF-8');

        
        echo '<canvas class ="drawChartline" data-label = "'.$labelsjsonvalue.'" data-dataset = "'.$datasetsjsonvalue.'"  id="chart-prage-'.$graphid.'-'.$interval.'"></canvas>';
        echo "</div>";

    }



