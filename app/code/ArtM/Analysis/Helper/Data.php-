                    WHEN price_incl_tax >= 1000 AND price_incl_tax < 1500 THEN '1000-1499'
                    WHEN price_incl_tax >= 1500 AND price_incl_tax < 2000 THEN '1500-1999'
                    ELSE '2000-above' 
