                'data' => $v,
                'borderColor' => $colors[$i],
                'fill' => false,
                'tension' => 0.1
            ];
            $i++;
        } 
        $datasetsjsonenc = json_encode($datasets);
        $datasetsjsonvalue = htmlspecialchars($datasetsjsonenc, ENT_QUOTES, 'UTF-8');

        
        echo '<canvas class ="drawChartline" data-label = "'.$labelsjsonvalue.'" data-dataset = "'.$datasetsjsonvalue.'"  id="chart-prange'.$graphid.'-'.$interval.'"></canvas>';
        echo "</div>";

    }


    /////////////////////////////////////////////
    public function getCustomprint($attset, $label,  $array=[], $brandselected =''){
        
        $attrsetcond = $this->getAttrsetCond($attset);

        if(!empty($array)){
            
            $keylabels[] = '';
            $dataClearance[] = '<strong>Custom print</strong>';
            $dataNormal[] = '<strong>Regular</strong>';
            foreach($array as $k=> $v){

                if($brandselected != ''){
                    $sql = "SELECT
                    SUM(CASE WHEN (oi.product_options LIKE '%customprint%' OR (oi.product_options LIKE '%print%' AND oi.product_options LIKE '%text%' AND oi.product_options REGEXP 'print.{3,}text')) THEN oi.qty_ordered ELSE 0 END) AS cprint,
                    SUM(CASE WHEN (oi.product_options LIKE '%customprint%' OR (oi.product_options LIKE '%print%' AND oi.product_options LIKE '%text%' AND oi.product_options REGEXP 'print.{3,}text')) THEN 0 ELSE oi.qty_ordered END) AS normal
                    FROM
                        sales_order AS o
                    JOIN
                        sales_order_item AS oi ON oi.order_id = o.entity_id
                    JOIN
                        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                    LEFT JOIN 
                        catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133 
                    WHERE
                        o.state IN ('complete','processing')
                        AND /*oi.product_type = 'simple' */ oi.parent_item_id IS NULL
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND cpei.value = $brandselected
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'";
                    
                }else{
                    $sql = "SELECT
                    SUM(CASE WHEN (oi.product_options LIKE '%customprint%' OR (oi.product_options LIKE '%print%' AND oi.product_options LIKE '%text%' AND oi.product_options REGEXP 'print.{3,}text')) THEN oi.qty_ordered ELSE 0 END) AS cprint,
                    SUM(CASE WHEN (oi.product_options LIKE '%customprint%' OR (oi.product_options LIKE '%print%' AND oi.product_options LIKE '%text%' AND oi.product_options REGEXP 'print.{3,}text')) THEN 0 ELSE oi.qty_ordered END) AS normal
                    FROM
                        sales_order AS o
                    JOIN
                        sales_order_item AS oi ON oi.order_id = o.entity_id
                    JOIN
                        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond                
                    WHERE
                        o.state IN ('complete','processing')
                        AND /*oi.product_type = 'simple' */ oi.parent_item_id IS NULL   
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled             
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'";

                }

                $result = $this->resource->getConnection()->fetchAll($sql);
               
                if (!empty($result)) {                    
                    foreach ($result as $item) {   
                        $totalClearnce   = floatval($item['cprint']);    
                        $totalNormal     = floatval($item['normal']);          
                        $keylabels[]     = $k;
                        $dataNormal[]    = $totalNormal;
                        $dataClearance[] = $totalClearnce;
                    }                   
                }
                
            }
            echo "<div class= 'container row'><div class = col-m-12> <h4> $label  </h4>";
            echo "<table class='admin__table-primary analysis-data'><tr>";
                foreach($keylabels as  $value){
                    echo "<th> $value </th>";
                }
                echo "<tr></tr>";
                foreach($dataNormal as  $value){
                    echo "<td> $value </td>";
                }
                echo "<tr></tr>";
                foreach($dataClearance as  $value){
                    echo "<td> $value </td>";
                }
            echo "</tr></table></div></div>";
        }else{



            if($brandselected != ''){
                $sql = "SELECT
                    SUM(CASE WHEN (oi.product_options LIKE '%customprint%' OR (oi.product_options LIKE '%print%' AND oi.product_options LIKE '%text%' AND oi.product_options REGEXP 'print.{3,}text')) THEN oi.qty_ordered ELSE 0 END) AS cprint,
                    SUM(CASE WHEN (oi.product_options LIKE '%customprint%' OR (oi.product_options LIKE '%print%' AND oi.product_options LIKE '%text%' AND oi.product_options REGEXP 'print.{3,}text')) THEN 0 ELSE oi.qty_ordered END) AS normal
                FROM
                    sales_order AS o
                JOIN
                    sales_order_item AS oi ON oi.order_id = o.entity_id
                JOIN
                    catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                LEFT JOIN 
                    catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133 
                WHERE
                    o.state IN ('complete','processing')
                    AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                    AND /*oi.product_type = 'simple' */ oi.parent_item_id IS NULL
                    AND cpei.value = $brandselected";

            }else{
                $sql = "SELECT
                SUM(CASE WHEN (oi.product_options LIKE '%customprint%' OR (oi.product_options LIKE '%print%' AND oi.product_options LIKE '%text%' AND oi.product_options REGEXP 'print.{3,}text')) THEN oi.qty_ordered ELSE 0 END) AS cprint,
                SUM(CASE WHEN (oi.product_options LIKE '%customprint%' OR (oi.product_options LIKE '%print%' AND oi.product_options LIKE '%text%' AND oi.product_options REGEXP 'print.{3,}text')) THEN 0 ELSE oi.qty_ordered END) AS normal
                FROM
                    sales_order AS o
                JOIN
                    sales_order_item AS oi ON oi.order_id = o.entity_id
                JOIN
                    catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond                
                WHERE
                    o.state IN ('complete','processing')
                    AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                    AND /*oi.product_type = 'simple' */ oi.parent_item_id IS NULL ";

            }
            
            $result = $this->resource->getConnection()->fetchAll($sql);
            
            echo "<div class = col-m-12>";
            echo "<h4 class='newblk'> $label </h4>";
            if (!empty($result)) { 
                echo "<table class='admin__table-primary analysis-data'><tr><th> Sale Type </th><th>Qty ordered</th></tr>";
                    foreach ($result as $item) {   
                        $totalClearnce = floatval($item['cprint']);    
                        $totalNormal = floatval($item['normal']);           
                        echo "<tr><td>Custom Print</td><td>$totalClearnce</td></tr>";
                        echo "<tr><td>Normal</td><td>$totalNormal</td></tr>";
                    }
                    echo "</table>";
            }
            echo "</div>";
        }

    }

    public function CustomprintGraph($attset, $interval, $brandselected =''){
        
        if(is_array($attset)){
