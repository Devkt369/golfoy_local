            }
            echo "</div>";
        }
    }


    public function PRangeAttrGraph($attset, $interval, $brandselected =''){
        
        if(is_array($attset)){
            $graphid = $attset[0];
        }else{
            $graphid = $attset;
        }
        $attrsetcond = $this->getAttrsetCond($attset);
        
        $labels = [];
        $gData  = [];
      
        $daterange = $this->getDaterange();
        $array = $daterange[$interval];
        if(!empty($array)){
            foreach($array as $k=> $v){
               
                if($brandselected != ''){
                    $sql = " SELECT 
                    CASE 
                    WHEN price_incl_tax >= 0 AND price_incl_tax < 10000 THEN '0-9999' 
                    WHEN price_incl_tax >= 10000 AND price_incl_tax < 15000 THEN '10000-14999'
                    WHEN price_incl_tax >= 15000 AND price_incl_tax < 20000 THEN '15000-19999'
                    ELSE '20000-above' 
                    END AS price_range,
                    SUM(oi.qty_ordered) AS total_ordered
                    FROM 
                        sales_order AS o 
                        JOIN sales_order_item AS oi ON oi.order_id = o.entity_id 
                        JOIN catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                        LEFT JOIN 
                            catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133
                    WHERE 
                        o.state IN ('complete','processing')
                        AND o.store_id = 1
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND oi.price_incl_tax IS NOT NULL
                        AND cpei.value = $brandselected
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                    GROUP BY 
                        price_range
                    ORDER BY price_range";

                }else{
                    $sql = " SELECT 
                    CASE 
                    WHEN price_incl_tax >= 0 AND price_incl_tax < 10000 THEN '0-9999' 
                    WHEN price_incl_tax >= 10000 AND price_incl_tax < 15000 THEN '10000-14999'
                    WHEN price_incl_tax >= 15000 AND price_incl_tax < 20000 THEN '15000-19999'
                    ELSE '20000-above' 
                    END AS price_range,
                    SUM(oi.qty_ordered) AS total_ordered
                    FROM 
                        sales_order AS o 
                        JOIN sales_order_item AS oi ON oi.order_id = o.entity_id 
                        JOIN catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                    WHERE 
                        o.state IN ('complete','processing')
                        AND o.store_id = 1
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND oi.price_incl_tax IS NOT NULL
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                    GROUP BY 
                        price_range
                    ORDER BY price_range";

                }
                
                $result = $this->resource->getConnection()->fetchAll($sql);
                if (!empty($result)) { 
                    $labels[] = $k;    
                    $tmparr = ['0-9999'=> 0,'10000-14999'=> 0,'15000-19999'=> 0,'20000-above'=> 0]; 
                         
                    foreach($result as $item) {   
                        $total = floatval($item['total_ordered']); 
                        $range = $item['price_range'];
                        $tmparr[$range] = $total;
                    }
                    foreach($tmparr as  $r => $tmp) { 
                        $gData[$r][]  = $tmp ; 
                    }
                }
               
            }

        }
        if($interval == 'monthly'){
            echo "<div class = col-m-12>";
        }else{
            echo "<div class = col-m-6>";
        }
        
        $labelsjsonenc = json_encode($labels);
        $labelsjsonvalue = htmlspecialchars($labelsjsonenc, ENT_QUOTES, 'UTF-8');
       
        
        $colors= ['#4BC0C0','#ff6361','#003f5c','#8B4513','#663046'];
        $datasets = [];
        $i = 0;
        foreach($gData as $k => $v){
            $datasets[] =   [
                'label' => $k ,
                'data' => $v,
                'borderColor' => $colors[$i],
                'fill' => false,
                'tension' => 0.1
            ];
            $i++;
        } 
        $datasetsjsonenc = json_encode($datasets);
        $datasetsjsonvalue = htmlspecialchars($datasetsjsonenc, ENT_QUOTES, 'UTF-8');

        
        echo '<canvas class ="drawChartline" data-label = "'.$labelsjsonvalue.'" data-dataset = "'.$datasetsjsonvalue.'"  id="chart-prange'.$graphid.'-'.$interval.'"></canvas>';
        echo "</div>";

    }




    public function topAttrSoldComp($attset, $attr, $label, $array=[], $brandselected ='', $prodtype = 'simple'){        
        
        $attrsetcond = $this->getAttrsetCond($attset);
        $prodtypeCond = $this->getprodtypeCond($prodtype);
        $attr = (int) $attr;

        if(!empty($array)){
            switch($attr) {
                case '241':
                    $datalabels = [];
                    $datalabels[] = '';
                    $datalbl = [];
                    $datalbl['Yes']      = [];
                    $datalbl['Yes'][]      ='<strong>Yes</strong>';
                    $datalbl['No'] = [];
                    $datalbl['No'][]      ='<strong>No</strong>';
                    foreach($array as $k=> $v){

                        if($brandselected != ''){
                            $sql = "SELECT 
                            eavov.value AS option_label,
                            SUM(oi.qty_ordered) AS total_qty_ordered
                            FROM 
                                sales_order AS o 
                            JOIN 
                                sales_order_item AS oi ON oi.order_id = o.entity_id 
                            JOIN 
                                catalog_product_entity_int AS cpev ON cpev.entity_id = oi.product_id AND cpev.attribute_id = $attr
                            JOIN
                                eav_attribute_option_value AS eavov ON eavov.option_id = cpev.value AND eavov.store_id = 0
                            JOIN
                                catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                            LEFT JOIN 
                                 catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133 
                            WHERE
                                o.state IN ('complete','processing')
                                AND o.store_id = 1
                                AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                                $prodtypeCond
                                AND cpei.value = $brandselected
                                AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                            GROUP BY
                                eavov.value HAVING SUM(oi.qty_ordered) > 0
                            ORDER BY
                                option_label DESC LIMIT 15";

                        }else{
                            $sql = "SELECT 
                            eavov.value AS option_label,
                            SUM(oi.qty_ordered) AS total_qty_ordered
                            FROM 
                                sales_order AS o 
                            JOIN 
                                sales_order_item AS oi ON oi.order_id = o.entity_id 
                            JOIN 
                                catalog_product_entity_int AS cpev ON cpev.entity_id = oi.product_id AND cpev.attribute_id = $attr
                            JOIN
                                eav_attribute_option_value AS eavov ON eavov.option_id = cpev.value AND eavov.store_id = 0
                            JOIN
                                catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                            WHERE
                                o.state IN ('complete','processing')
                                AND o.store_id = 1
                                $prodtypeCond
                                AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                                AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                            GROUP BY
                                eavov.value HAVING SUM(oi.qty_ordered) > 0
                            ORDER BY
                                option_label DESC LIMIT 15";
      
                        }
                        
                        $result = $this->resource->getConnection()->fetchAll($sql);
                        
                      
                        if (!empty($result)) { 
        
                            $datalabels[] = $k;
                            $tmparr = ['Yes'=> 0,'No'=> 0]; 
                         
                            foreach ($result as $item) {   
                                $total = floatval($item['total_qty_ordered']);  
                                $tmparr[$item['option_label']] = $total;  
                            }
                           
                            $datalbl['Yes'][] = $tmparr['Yes'];
                            $datalbl['No'][] = $tmparr['No'];
                           
                        }
                        
                    }
                    echo "<div class= 'container row'><div class = col-m-12> <h4> $label  </h4>";
                    echo "<table class='admin__table-primary analysis-data'><tr>";
                
                    foreach( $datalabels as  $value){
                        echo "<th> $value </th>";
                    }
                    echo "<tr></tr>";
                    foreach($datalbl['Yes'] as  $value){
                        echo "<td> $value </td>";
                    }
                    echo "<tr></tr>";
                    foreach($datalbl['No'] as  $value){
                        echo "<td> $value </td>";
                    }                   
                    echo "</tr></table></div></div>";
                    
                break;
                case '176':
                    $datalabels = [];
                    $datalabels[] = '';
                    $datalbl = [];
                    $datalbl['Spiked']      = [];
                    $datalbl['Spiked'][]      ='<strong>Spiked</strong>';
                    $datalbl['Spikeless']      = [];
                    $datalbl['Spikeless'][]      ='<strong>Spikeless</strong>';
                    $datalbl['Hybrid'] = [];
                    $datalbl['Hybrid'][]      ='<strong>Hybrid</strong>';
                    foreach($array as $k=> $v){

                        if($brandselected != ''){
                            $sql = "SELECT 
                            eavov.value AS option_label,
                            SUM(oi.qty_ordered) AS total_qty_ordered
                            FROM 
                                sales_order AS o 
                            JOIN 
                                sales_order_item AS oi ON oi.order_id = o.entity_id 
                            JOIN 
                                catalog_product_entity_int AS cpev ON cpev.entity_id = oi.product_id AND cpev.attribute_id = $attr
                            JOIN
                                eav_attribute_option_value AS eavov ON eavov.option_id = cpev.value AND eavov.store_id = 0
                            JOIN
                                catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                            LEFT JOIN 
                                catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133
                            WHERE
                                o.state IN ('complete','processing')
                                AND o.store_id = 1
                                $prodtypeCond
                                AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                                AND cpei.value = $brandselected
                                AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                            GROUP BY
                                eavov.value HAVING SUM(oi.qty_ordered) > 0
                            ORDER BY
                                option_label DESC LIMIT 15";

                        }else{
                            $sql = "SELECT 
                            eavov.value AS option_label,
                            SUM(oi.qty_ordered) AS total_qty_ordered
                            FROM 
                                sales_order AS o 
                            JOIN 
                                sales_order_item AS oi ON oi.order_id = o.entity_id 
                            JOIN 
                                catalog_product_entity_int AS cpev ON cpev.entity_id = oi.product_id AND cpev.attribute_id = $attr
                            JOIN
                                eav_attribute_option_value AS eavov ON eavov.option_id = cpev.value AND eavov.store_id = 0
                            JOIN
                                catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                            WHERE
                                o.state IN ('complete','processing') 
                                AND o.store_id = 1
                                $prodtypeCond
                                AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                                AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                            GROUP BY
                                eavov.value HAVING SUM(oi.qty_ordered) > 0
                            ORDER BY
                                option_label DESC LIMIT 15";

                        }
                        
                        $result = $this->resource->getConnection()->fetchAll($sql);
                        
                      
                        if (!empty($result)) { 
        
                            $datalabels[] = $k;
                            $tmparr = ['Spiked'=>0, 'Spikeless'=>0,'Hybrid'=>0];
                         
                            foreach ($result as $item) {   
                                $total = floatval($item['total_qty_ordered']);  
                                $tmparr[$item['option_label']] = $total;  
                            }
                           
                            $datalbl['Spiked'][] = $tmparr['Spiked'];
                            $datalbl['Spikeless'][] = $tmparr['Spikeless'];
                            $datalbl['Hybrid'][] = $tmparr['Hybrid'];
                           
                        }
                        
                    }
                    echo "<div class= 'container row'><div class = col-m-12> <h4> $label  </h4>";
                    echo "<table class='admin__table-primary analysis-data'><tr>";
                
                    foreach( $datalabels as  $value){
                        echo "<th> $value </th>";
                    }
                    echo "<tr></tr>";
                    foreach($datalbl['Spiked'] as  $value){
                        echo "<td> $value </td>";
                    }
                    echo "<tr></tr>";
                    foreach($datalbl['Spikeless'] as  $value){
                        echo "<td> $value </td>";
                    }
                    echo "<tr></tr>";
                    foreach($datalbl['Hybrid'] as  $value){
                        echo "<td> $value </td>";
                    }                   
                    echo "</tr></table></div></div>";
                break;
               default:
                    
                break;
            }
            
           
        }else{

            if($brandselected != ''){
                $sql = "SELECT 
                eavov.value AS option_label,
                SUM(oi.qty_ordered) AS total_qty_ordered
                FROM 
                    sales_order AS o 
                JOIN 
                    sales_order_item AS oi ON oi.order_id = o.entity_id 
                JOIN 
                    catalog_product_entity_int AS cpev ON cpev.entity_id = oi.product_id AND cpev.attribute_id = $attr
                JOIN
                    eav_attribute_option_value AS eavov ON eavov.option_id = cpev.value AND eavov.store_id = 0
                JOIN
                    catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                LEFT JOIN 
                    catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133 
                WHERE
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    $prodtypeCond
                    AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                    AND cpei.value = $brandselected
                GROUP BY
                    eavov.value HAVING SUM(oi.qty_ordered) > 0
                ORDER BY
                    option_label DESC LIMIT 15";

            }else{
                $sql = "SELECT 
                eavov.value AS option_label,
                SUM(oi.qty_ordered) AS total_qty_ordered
                FROM 
                    sales_order AS o 
                JOIN 
                    sales_order_item AS oi ON oi.order_id = o.entity_id 
                JOIN 
                    catalog_product_entity_int AS cpev ON cpev.entity_id = oi.product_id AND cpev.attribute_id = $attr
                JOIN
