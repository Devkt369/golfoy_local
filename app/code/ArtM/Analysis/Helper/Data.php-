    public function totalSoldCat($catids, $label, $array=[], $brandselected =''){

        
        $catidsstr = implode(',', $catids);

        if(!empty($array)){
            $keylabels = $keydata = [];
            foreach($array as $k=> $v){

                if($brandselected != ''){

                    $sql = "SELECT 
                SUM(oi.qty_ordered) AS total_qty_ordered
                FROM 
                    sales_order AS o 
                JOIN 
                    sales_order_item AS oi ON oi.order_id = o.entity_id 
                JOIN
                    catalog_category_product AS ccp ON ccp.product_id = oi.product_id
                JOIN
                    catalog_category_entity_varchar AS ccev ON ccev.entity_id = ccp.category_id AND ccev.attribute_id = 41
                JOIN 
                    catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id
                LEFT JOIN 
                    catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133 
                WHERE 
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    AND ccp.category_id IN ($catidsstr)
                    AND oi.parent_item_id IS NULL
                    /* AND oi.product_type = 'simple'*/ AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                    AND cpei.value = $brandselected                   
                    AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'";


                }else{                

                    $sql = "SELECT 
                    SUM(oi.qty_ordered) AS total_qty_ordered
                    FROM 
                        sales_order AS o 
                    JOIN 
                        sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN
                        catalog_category_product AS ccp ON ccp.product_id = oi.product_id
                    JOIN
                        catalog_category_entity_varchar AS ccev ON ccev.entity_id = ccp.category_id AND ccev.attribute_id = 41
                    WHERE 
                        o.state IN ('complete','processing')
                        AND o.store_id = 1
                        AND ccp.category_id IN ($catidsstr)
                        AND oi.parent_item_id IS NULL
                    /* AND oi.product_type = 'simple'*/ AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'";

                }


                $result = $this->resource->getConnection()->fetchAll($sql);
                
               
               // echo "<h4> $label ($k) : </h4>";
                if (!empty($result)) { 
                   
                    foreach ($result as $item) { 
                        $total = floatval($item['total_qty_ordered']); 
                        $keylabels[] = $k;
                        $keydata[] = $total;
                    }
                    
                }
                
            }
            echo "<div class= 'container row'><div class = col-m-12> <h4> $label  </h4>";
            echo "<table class='admin__table-primary analysis-data'><tr>";
                foreach($keylabels as  $value){
                    echo "<th> $value </th>";
                }
                echo "<tr></tr>";
                foreach($keydata as  $value){
                    echo "<td> $value </td>";
                }
            echo "</tr></table></div></div>";

        }else{

            if($brandselected != ''){
                $sql = "SELECT 
                SUM(oi.qty_ordered) AS total_qty_ordered
                FROM 
                    sales_order AS o 
                JOIN 
                    sales_order_item AS oi ON oi.order_id = o.entity_id
                JOIN
                    catalog_category_product AS ccp ON ccp.product_id = oi.product_id
                JOIN
                    catalog_category_entity_varchar AS ccev ON ccev.entity_id = ccp.category_id AND ccev.attribute_id = 41                    
                JOIN 
                    catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id
                LEFT JOIN 
                    catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133 
                WHERE 
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    AND ccp.category_id IN ($catidsstr)
                    AND oi.parent_item_id IS NULL
                    AND cpei.value = $brandselected         
                    /*AND oi.product_type = 'simple'*/ AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled";

            }else{
                $sql = "SELECT 
                SUM(oi.qty_ordered) AS total_qty_ordered
                FROM 
                    sales_order AS o 
                JOIN 
                    sales_order_item AS oi ON oi.order_id = o.entity_id 
                JOIN
                    catalog_category_product AS ccp ON ccp.product_id = oi.product_id
                JOIN
                    catalog_category_entity_varchar AS ccev ON ccev.entity_id = ccp.category_id AND ccev.attribute_id = 41
                WHERE 
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    AND ccp.category_id IN ($catidsstr)
                    AND oi.parent_item_id IS NULL
                    /*AND oi.product_type = 'simple'*/ AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled";
            }
            
            $result = $this->resource->getConnection()->fetchAll($sql);
            
            echo "<div class= 'container row'><div class = col-m-12>";
            //echo "<h4> $label </h4>";
            if (!empty($result)) { 
              
                foreach ($result as $item) { 
                    $total = floatval($item['total_qty_ordered']);  
                    echo "<h4> $label : $total </h4>"; 
                }
                
            }
            echo "</div></div>";
        }

    }
    
    public function totalCatGraph($catids, $interval, $brandselected =''){
        
        $catidsstr = implode(',', $catids);
        
        $labels = [];
        $gData  = [];
      
        $daterange = $this->getDaterange();
        $array = $daterange[$interval];
        if(!empty($array)){
            foreach($array as $k=> $v){
               
                if($brandselected != ''){
                    $sql = "SELECT 
                    SUM(oi.qty_ordered) AS total_qty_ordered
                    FROM 
                        sales_order AS o 
                    JOIN 
                        sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN
                        catalog_category_product AS ccp ON ccp.product_id = oi.product_id
                    JOIN
                        catalog_category_entity_varchar AS ccev ON ccev.entity_id = ccp.category_id AND ccev.attribute_id = 41
                    JOIN 
                        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id
                    LEFT JOIN 
                    catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133 
                    WHERE 
                        o.state IN ('complete','processing')
                        AND o.store_id = 1
                        AND ccp.category_id IN ($catidsstr)
                        AND oi.parent_item_id IS NULL
                       /* AND oi.product_type = 'simple'*/ AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND cpei.value = $brandselected
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'";
                }else{
                    $sql = "SELECT 
                    SUM(oi.qty_ordered) AS total_qty_ordered
                    FROM 
                        sales_order AS o 
                    JOIN 
                        sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN
                        catalog_category_product AS ccp ON ccp.product_id = oi.product_id
                    JOIN
                    catalog_category_entity_varchar AS ccev ON ccev.entity_id = ccp.category_id AND ccev.attribute_id = 41
                    WHERE 
                        o.state IN ('complete','processing')
                        AND o.store_id = 1
                        AND ccp.category_id IN ($catidsstr)
                       AND oi.parent_item_id IS NULL
                        /* AND oi.product_type = 'simple'*/ AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'";
                }   
                $result = $this->resource->getConnection()->fetchAll($sql);
                if (!empty($result)) { 
                    $labels[] = $k; 
                         
                    foreach($result as $item) {   
                        $total = floatval($item['total_qty_ordered']); 
                        $gData['Quantity'][] = $total;
                    }
                }
               
            }

        }
        if($interval == 'monthly'){
            echo "<div class = col-m-12>";
        }else{
            echo "<div class = col-m-6>";
        }
        
        $labelsjsonenc = json_encode($labels);
        $labelsjsonvalue = htmlspecialchars($labelsjsonenc, ENT_QUOTES, 'UTF-8');
       
        
        $colors= ['#66CCCC'];
        $datasets = [];
        $i = 0;
        foreach($gData as $k => $v){
            $datasets[] =   [
                'label' => $k ,
                'data' => $v,
                'borderColor' => $colors[$i],
                'fill' => false,
                'tension' => 0.1
            ];
            $i++;
        } 
        $datasetsjsonenc = json_encode($datasets);
        $datasetsjsonvalue = htmlspecialchars($datasetsjsonenc, ENT_QUOTES, 'UTF-8');

        
        echo '<canvas class ="drawChartline" data-label = "'.$labelsjsonvalue.'" data-dataset = "'.$datasetsjsonvalue.'"  id="chart-total-'.$catids[0].'-'.$interval.'"></canvas>';
        echo "</div>";

    }


    public function topSoldCat($catids, $label, $array=[], $brandselected ='', $prodtype = 'simple'){
        
        $catidsstr = implode(',', $catids);
        $prodtypeCond = $this->getprodtypeCond($prodtype);

        if(!empty($array)){
            foreach($array as $k=> $v){

                if($brandselected != ''){
                    $sql = "SELECT 
                    cpe.sku AS product_sku,
                    cpev.value AS product_name,
                    SUM(oi.qty_ordered) AS total_qty_ordered
                    FROM 
                        sales_order AS o 
                    JOIN 
                        sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN 
                        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id
                    JOIN
                        catalog_category_product AS ccp ON ccp.product_id = oi.product_id
                    JOIN
                        catalog_category_entity_varchar AS ccev ON ccev.entity_id = ccp.category_id AND ccev.attribute_id = 41
                    LEFT JOIN 
                        catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133 
                    JOIN 
                        catalog_product_entity_varchar AS cpev ON cpev.entity_id = cpe.entity_id AND cpev.attribute_id = 71
                    WHERE 
                        o.state IN ('complete','processing')
                        AND o.store_id = 1
                        AND ccp.category_id IN ($catidsstr)
                        $prodtypeCond
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND cpei.value = $brandselected
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                    GROUP BY
                        cpev.value,
                        cpe.sku
                    ORDER BY 
                        total_qty_ordered DESC LIMIT 15";

                }else{
                    $sql = "SELECT 
                cpe.sku AS product_sku,
                cpev.value AS product_name,
                SUM(oi.qty_ordered) AS total_qty_ordered
                FROM 
                    sales_order AS o 
                JOIN 
                    sales_order_item AS oi ON oi.order_id = o.entity_id 
                JOIN 
                    catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id
                JOIN
                    catalog_category_product AS ccp ON ccp.product_id = oi.product_id
                JOIN
                    catalog_category_entity_varchar AS ccev ON ccev.entity_id = ccp.category_id AND ccev.attribute_id = 41
                JOIN 
                    catalog_product_entity_varchar AS cpev ON cpev.entity_id = cpe.entity_id AND cpev.attribute_id = 71
                WHERE 
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    AND ccp.category_id IN ($catidsstr)
                    $prodtypeCond
                    AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                    AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                GROUP BY
                    cpev.value,
                    cpe.sku
                ORDER BY 
                    total_qty_ordered DESC LIMIT 15";

                }
                
                $result = $this->resource->getConnection()->fetchAll($sql);
                
                echo "<div class= 'container row'><div class = col-m-12>";
                echo "<h4> $label ($k) </h4>";
                if (!empty($result)) { 
                    echo "<table class='admin__table-primary analysis-data'><tr><th>Product Name</th><th>Qty ordered</th></tr>";
                    foreach ($result as $item) { 
                        $total = floatval($item['total_qty_ordered']);                  
                        echo "<tr><td>$item[product_name]</td><td>$total</td></tr>";
                    }
                    echo "</table>";
                }
                echo "</div></div>";
            }
        }else{
            if($brandselected != ''){
                $sql = "SELECT 
                cpe.sku AS product_sku,
                cpev.value AS product_name,
                SUM(oi.qty_ordered) AS total_qty_ordered
                FROM 
                    sales_order AS o 
                JOIN 
                    sales_order_item AS oi ON oi.order_id = o.entity_id 
                JOIN 
                    catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id
                JOIN
                    catalog_category_product AS ccp ON ccp.product_id = oi.product_id
                JOIN
                    catalog_category_entity_varchar AS ccev ON ccev.entity_id = ccp.category_id AND ccev.attribute_id = 41
                LEFT JOIN 
                    catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133 
                JOIN 
                    catalog_product_entity_varchar AS cpev ON cpev.entity_id = cpe.entity_id AND cpev.attribute_id = 71
                WHERE 
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    AND ccp.category_id IN ($catidsstr)
                    $prodtypeCond
                    AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                    AND cpei.value = $brandselected
                GROUP BY
                    cpev.value,
                    cpe.sku
                ORDER BY 
                    total_qty_ordered DESC LIMIT 15";

            }else{            
                $sql = "SELECT 
                cpe.sku AS product_sku,
                cpev.value AS product_name,
                SUM(oi.qty_ordered) AS total_qty_ordered
                FROM 
                    sales_order AS o 
                JOIN 
                    sales_order_item AS oi ON oi.order_id = o.entity_id  
                JOIN 
                    catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id
                JOIN
                    catalog_category_product AS ccp ON ccp.product_id = oi.product_id
                JOIN
                    catalog_category_entity_varchar AS ccev ON ccev.entity_id = ccp.category_id AND ccev.attribute_id = 41
                JOIN 
                    catalog_product_entity_varchar AS cpev ON cpev.entity_id = cpe.entity_id AND cpev.attribute_id = 71
                WHERE 
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    AND ccp.category_id IN ($catidsstr)
                    $prodtypeCond
                    AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                GROUP BY
                    cpev.value,
                    cpe.sku
                ORDER BY 
                    total_qty_ordered DESC LIMIT 15";
            }
            $result = $this->resource->getConnection()->fetchAll($sql);
            
            echo "<div style='margin-top:50px;' class = col-m-12>";
            echo "<h4> $label </h4>";


            //export data---------------------------
            echo "<div class = 'analyse-export'>";
           
            $ftype = 'topSoldCat';
            if($prodtype == 'simple'){$ftype = 'topSoldCatSimple';}
            ?>
            Start date: <input type="date"  name="st_date" class="admin__control-date st_date"/>
            &nbsp; End date: <input type="date"  name="end_date" class="admin__control-date end_date"/>
            &nbsp; Limit: <input type="text" class="limitvalue" name= "limitvalue" type="text" style="width:100px;" />
            <input type= "hidden" class="ftype" name = "ftype" value ="<?php echo $ftype; ?>" />
            <input type= "hidden" class="brandattr" name = "brandattr" value ="<?php echo $brandselected; ?>" />
            <input type= "hidden" class="attrset" name = "attrset" value ="<?php echo $catidsstr; ?>" />
            <button class="analyse-export-btn"> Create csv</button>
            <div class= "csvfilename" style="display:inline;"> </div>
            <?php            
            echo "</div>";    
            //-----------------------------------------  
            
            
            //echo "<h4> $label </h4>";
            if (!empty($result)) { 
                echo "<table class='admin__table-primary analysis-data'><tr><th>Product Name</th><th>Qty ordered</th></tr>";
                foreach ($result as $item) { 
                    $total = floatval($item['total_qty_ordered']);                  
                    echo "<tr><td>$item[product_name]</td><td>$total</td></tr>";
                }
                echo "</table>";
            }
            echo "</div>";
        }

    }


    public function topAttrSoldCat($catids, $attr, $label, $array=[], $brandselected ='', $prodtype = 'simple'){        
        
        $catidsstr = implode(',', $catids);
        $prodtypeCond = $this->getprodtypeCond($prodtype);
        $attr = (int) $attr;

        if(!empty($array)){
            foreach($array as $k=> $v){

                if($brandselected != ''){
                    $sql = "SELECT 
                    eavov.value AS option_label,
                    SUM(oi.qty_ordered) AS total_qty_ordered
                    FROM 
                        sales_order AS o 
                    JOIN 
                        sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN 
                        catalog_product_entity_int AS cpev ON cpev.entity_id = oi.product_id AND cpev.attribute_id = $attr
                    JOIN
                        eav_attribute_option_value AS eavov ON eavov.option_id = cpev.value AND eavov.store_id = 0
                    JOIN
                        catalog_category_product AS ccp ON ccp.product_id = oi.product_id
                    JOIN
                        catalog_category_entity_varchar AS ccev ON ccev.entity_id = ccp.category_id AND ccev.attribute_id = 41
                    JOIN
                        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id
                    LEFT JOIN 
                        catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133 
                    WHERE
                        o.state IN ('complete','processing')
                        AND o.store_id = 1
                        AND ccp.category_id IN ($catidsstr)
                        $prodtypeCond
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND cpei.value = $brandselected
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                    GROUP BY
                        eavov.value HAVING SUM(oi.qty_ordered) > 0
                    ORDER BY
                        total_qty_ordered DESC LIMIT 15";
                }else{
                    $sql = "SELECT 
                    eavov.value AS option_label,
                    SUM(oi.qty_ordered) AS total_qty_ordered
                    FROM 
                        sales_order AS o 
                    JOIN 
                        sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN 
                        catalog_product_entity_int AS cpev ON cpev.entity_id = oi.product_id AND cpev.attribute_id = $attr
                    JOIN
                        eav_attribute_option_value AS eavov ON eavov.option_id = cpev.value AND eavov.store_id = 0
                    JOIN
                        catalog_category_product AS ccp ON ccp.product_id = oi.product_id
                    JOIN
                    catalog_category_entity_varchar AS ccev ON ccev.entity_id = ccp.category_id AND ccev.attribute_id = 41
                    WHERE
                        o.state IN ('complete','processing')
                        AND o.store_id = 1
                        AND ccp.category_id IN ($catidsstr)
                        $prodtypeCond
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                    GROUP BY
                        eavov.value HAVING SUM(oi.qty_ordered) > 0
                    ORDER BY
                        total_qty_ordered DESC LIMIT 15";

                }

                $result = $this->resource->getConnection()->fetchAll($sql);
                
                echo "<div class = col-m-12>";
                echo "<h4 class='newblk'> $label ($k) </h4>";
                if (!empty($result)) { 
                    echo "<table class='admin__table-primary analysis-data'><tr><th>".$this->data['attrLabels'][$attr]."</th><th>Qty ordered</th></tr>";
                    foreach ($result as $item) {   
                        $total = floatval($item['total_qty_ordered']);             
                        echo "<tr><td>$item[option_label]</td><td>$total</td></tr>";
                    }
                    echo "</table>";
                }
                echo "</div>";
            }
        }else{
            if($brandselected != ''){
                $sql = "SELECT 
                eavov.value AS option_label,
                SUM(oi.qty_ordered) AS total_qty_ordered
                FROM 
                    sales_order AS o 
                JOIN 
                    sales_order_item AS oi ON oi.order_id = o.entity_id 
                JOIN 
                    catalog_product_entity_int AS cpev ON cpev.entity_id = oi.product_id AND cpev.attribute_id = $attr
                JOIN
                    eav_attribute_option_value AS eavov ON eavov.option_id = cpev.value AND eavov.store_id = 0
                JOIN
                    catalog_category_product AS ccp ON ccp.product_id = oi.product_id
                JOIN
                    catalog_category_entity_varchar AS ccev ON ccev.entity_id = ccp.category_id AND ccev.attribute_id = 41
                JOIN
                    catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id
                LEFT JOIN 
                    catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133 
                WHERE
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    AND ccp.category_id IN ($catidsstr)
                    $prodtypeCond
                    AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                    AND cpei.value = $brandselected
                GROUP BY
                    eavov.value HAVING SUM(oi.qty_ordered) > 0
                ORDER BY
                    total_qty_ordered DESC LIMIT 15";

            }else{

                $sql = "SELECT 
                eavov.value AS option_label,
                SUM(oi.qty_ordered) AS total_qty_ordered
                FROM 
                    sales_order AS o 
                JOIN 
                    sales_order_item AS oi ON oi.order_id = o.entity_id 
                JOIN 
                    catalog_product_entity_int AS cpev ON cpev.entity_id = oi.product_id AND cpev.attribute_id = $attr
                JOIN
                    eav_attribute_option_value AS eavov ON eavov.option_id = cpev.value AND eavov.store_id = 0
                JOIN
                    catalog_category_product AS ccp ON ccp.product_id = oi.product_id
                JOIN
                    catalog_category_entity_varchar AS ccev ON ccev.entity_id = ccp.category_id AND ccev.attribute_id = 41
                WHERE
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    AND ccp.category_id IN ($catidsstr)
                    $prodtypeCond
                    AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                GROUP BY
                    eavov.value HAVING SUM(oi.qty_ordered) > 0
                ORDER BY
                    total_qty_ordered DESC LIMIT 15";

            }
            $result = $this->resource->getConnection()->fetchAll($sql);
            
            echo "<div class = col-m-12>";
            echo "<h4 class='newblk'> $label </h4>";
            if (!empty($result)) { 
                echo "<table class='admin__table-primary analysis-data'><tr><th>".$this->data['attrLabels'][$attr]."</th><th>Qty ordered</th></tr>";
                foreach ($result as $item) {   
                    $total = floatval($item['total_qty_ordered']);             
                    echo "<tr><td>$item[option_label]</td><td>$total</td></tr>";
                }
                echo "</table>";
            }
            echo "</div>";
        }
    }

    public function topAttrSoldArrayCat($catids, $attr, $brandselected ='', $prodtype = 'simple'){        
        
        $catidsstr = implode(',', $catids);
        $prodtypeCond = $this->getprodtypeCond($prodtype);
        $attr = (int) $attr;

            $return = [];

            if($brandselected != ''){
                $sql = "SELECT 
                eavov.value AS option_label,
                SUM(oi.qty_ordered) AS total_qty_ordered
                FROM 
                    sales_order AS o 
                JOIN 
                    sales_order_item AS oi ON oi.order_id = o.entity_id 
                JOIN 
                    catalog_product_entity_int AS cpev ON cpev.entity_id = oi.product_id AND cpev.attribute_id = $attr
                JOIN
                    eav_attribute_option_value AS eavov ON eavov.option_id = cpev.value AND eavov.store_id = 0
                JOIN
                    catalog_category_product AS ccp ON ccp.product_id = oi.product_id
                JOIN
                    catalog_category_entity_varchar AS ccev ON ccev.entity_id = ccp.category_id AND ccev.attribute_id = 41
                JOIN
                    catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id
                LEFT JOIN 
                    catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133
                WHERE
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    AND ccp.category_id IN ($catidsstr)
                    $prodtypeCond
                    AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                    AND cpei.value = $brandselected
                GROUP BY
                    eavov.value HAVING SUM(oi.qty_ordered) > 0
                ORDER BY
                    total_qty_ordered DESC LIMIT 5";
            }else{
                $sql = "SELECT 
                eavov.value AS option_label,
                SUM(oi.qty_ordered) AS total_qty_ordered
                FROM 
                    sales_order AS o 
                JOIN 
                    sales_order_item AS oi ON oi.order_id = o.entity_id 
                JOIN 
                    catalog_product_entity_int AS cpev ON cpev.entity_id = oi.product_id AND cpev.attribute_id = $attr
                JOIN
                    eav_attribute_option_value AS eavov ON eavov.option_id = cpev.value AND eavov.store_id = 0
                JOIN
                    catalog_category_product AS ccp ON ccp.product_id = oi.product_id
                JOIN
                    catalog_category_entity_varchar AS ccev ON ccev.entity_id = ccp.category_id AND ccev.attribute_id = 41
                JOIN
                    catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id
                WHERE
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    AND ccp.category_id IN ($catidsstr)
                    $prodtypeCond
                    AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                GROUP BY
                    eavov.value HAVING SUM(oi.qty_ordered) > 0
                ORDER BY
                    total_qty_ordered DESC LIMIT 5";
            }
            
            $result = $this->resource->getConnection()->fetchAll($sql);
            
           
            if (!empty($result)) { 
              
                foreach ($result as $item) {   
                    $return[$item['option_label']] = 0;
                }
                
            }
            return $return;
    }


    public function topAttrArrayGraphCat($catids, $attr, $labelarray, $interval, $brandselected ='', $prodtype = 'simple'){
        
        $catidsstr = implode(',', $catids);
        $prodtypeCond = $this->getprodtypeCond($prodtype);
        $labels = [];
        $gData  = [];
      
        $daterange = $this->getDaterange();
        $array = $daterange[$interval];
        if(!empty($array)){
            foreach($array as $k=> $v){
               
                if($brandselected != ''){
                    $sql = "SELECT 
                    eavov.value AS option_label,
                    SUM(oi.qty_ordered) AS total_qty_ordered
                    FROM 
                        sales_order AS o 
                    JOIN 
                        sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN 
                        catalog_product_entity_int AS cpev ON cpev.entity_id = oi.product_id AND cpev.attribute_id = $attr
                    JOIN
                        eav_attribute_option_value AS eavov ON eavov.option_id = cpev.value AND eavov.store_id = 0
                    JOIN
                        catalog_category_product AS ccp ON ccp.product_id = oi.product_id
                    JOIN
                        catalog_category_entity_varchar AS ccev ON ccev.entity_id = ccp.category_id AND ccev.attribute_id = 41
                    JOIN
                        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id
                    LEFT JOIN 
                        catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133
                    WHERE
                        o.state IN ('complete','processing')
                        AND o.store_id = 1
                        AND ccp.category_id IN ($catidsstr)
                        $prodtypeCond
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND cpei.value = $brandselected
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                    GROUP BY
                        eavov.value HAVING SUM(oi.qty_ordered) > 0
                    ORDER BY
                        total_qty_ordered DESC LIMIT 15";

                }else{
                    $sql = "SELECT 
                    eavov.value AS option_label,
                    SUM(oi.qty_ordered) AS total_qty_ordered
                    FROM 
                        sales_order AS o 
                    JOIN 
                        sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN 
                        catalog_product_entity_int AS cpev ON cpev.entity_id = oi.product_id AND cpev.attribute_id = $attr
                    JOIN
                        eav_attribute_option_value AS eavov ON eavov.option_id = cpev.value AND eavov.store_id = 0
                    JOIN
                        catalog_category_product AS ccp ON ccp.product_id = oi.product_id
                    JOIN
                        catalog_category_entity_varchar AS ccev ON ccev.entity_id = ccp.category_id AND ccev.attribute_id = 41
                    WHERE
                        o.state IN ('complete','processing')
                        AND o.store_id = 1
                        AND ccp.category_id IN ($catidsstr)
                        $prodtypeCond
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                    GROUP BY
                        eavov.value HAVING SUM(oi.qty_ordered) > 0
                    ORDER BY
                        total_qty_ordered DESC LIMIT 15";

                }
                
                $result = $this->resource->getConnection()->fetchAll($sql);
                if (!empty($result)) { 
                    $labels[] = $k;
                    //$tmparr = ['0-9999'=> 0,'10000-19999'=> 0,'20000-above'=> 0]; 
                    $tmparr  = $labelarray;
                    foreach($result as $item) {   
                        $total = floatval($item['total_qty_ordered']); 
                        $oplabel = $item['option_label'];
                        if(isset($tmparr[$oplabel])){
                            $tmparr[$oplabel] = $total;
                        }
                        
                    }                    
                    foreach($tmparr as  $r => $tmp) { 
                        $gData[$r][]  = $tmp ; 
                    }
                }
               
            }

        }
        
        echo "<div class = col-m-12>";
        
        
        $labelsjsonenc = json_encode($labels);
        $labelsjsonvalue = htmlspecialchars($labelsjsonenc, ENT_QUOTES, 'UTF-8');
       
        
        $colors= ['#4BC0C0','#ff6361','#003f5c','#8B4513','#663046','#1F456E','#564C4D','#7A4988','#13388E', 
        '#2F4F4F', '#524F81','#444C38', '#D06002','#FF9ABA','#FC4C4E','#9E4244', '#F3E5AB'];
        $datasets = [];
        $i = 0;
        foreach($gData as $k => $v){
            $datasets[] =   [
                'label' => $k ,
                'data' => $v,
                'borderColor' => $colors[$i],
                'fill' => false,
                'tension' => 0.1
            ];
            $i++;
        } 
        $datasetsjsonenc = json_encode($datasets);
        $datasetsjsonvalue = htmlspecialchars($datasetsjsonenc, ENT_QUOTES, 'UTF-8');

        
        echo '<canvas class ="drawChartline" data-label = "'.$labelsjsonvalue.'" data-dataset = "'.$datasetsjsonvalue.'"  id="chart-top'.$attr.'-'.$interval.'"></canvas>';
        echo "</div>";

    }

    public function PRangeAttrSoldTraining($catids, $label, $array=[], $brandselected =''){        
        
        $catidsstr = implode(',', $catids);

        if(!empty($array)){           
            $datalabels = [];
            $datalabels[] = '';
            $datarange = [];
            $datarange['0-9999']      = [];
            $datarange['0-9999'][]      ='<strong>0-9999</strong>';
            $datarange['10000-19999'] = [];
            $datarange['10000-19999'][]      ='<strong>10000-19999</strong>';         
            $datarange['20000-above'] = [];
            $datarange['20000-above'][]      ='<strong>20000-above</strong>';

            foreach($array as $k=> $v){

                if($brandselected != ''){
                    $sql = " SELECT 
                    CASE 
                    WHEN price_incl_tax >= 0 AND price_incl_tax <10000 THEN '0-9999' 
                    WHEN price_incl_tax >= 10000 AND price_incl_tax < 20000 THEN '10000-19999'                    
                    ELSE '20000-above' 
                    END AS price_range,
                    SUM(oi.qty_ordered) AS total_ordered
                    FROM 
                        sales_order AS o 
                        JOIN sales_order_item AS oi ON oi.order_id = o.entity_id 
                        JOIN
                            catalog_category_product AS ccp ON ccp.product_id = oi.product_id
                        JOIN
                            catalog_category_entity_varchar AS ccev ON ccev.entity_id = ccp.category_id AND ccev.attribute_id = 41
                        JOIN catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id
                        LEFT JOIN 
                        catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133
                    WHERE 
                        o.state IN ('complete','processing') 
                        AND o.store_id = 1
                        AND ccp.category_id IN ($catidsstr)
                        AND oi.price_incl_tax IS NOT NULL
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND cpei.value = $brandselected
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                    GROUP BY 
                        price_range
                    ORDER BY price_range";

                }else{
                    $sql = " SELECT 
                    CASE 
                    WHEN price_incl_tax >= 0 AND price_incl_tax <10000 THEN '0-9999' 
                    WHEN price_incl_tax >= 10000 AND price_incl_tax < 20000 THEN '10000-19999'                    
                    ELSE '20000-above' 
                    END AS price_range,
                    SUM(oi.qty_ordered) AS total_ordered
                    FROM 
                        sales_order AS o 
                        JOIN sales_order_item AS oi ON oi.order_id = o.entity_id 
                        JOIN
                            catalog_category_product AS ccp ON ccp.product_id = oi.product_id
                        JOIN
                            catalog_category_entity_varchar AS ccev ON ccev.entity_id = ccp.category_id AND ccev.attribute_id = 41
                    WHERE 
                        o.state IN ('complete','processing')
                        AND o.store_id = 1
                        AND ccp.category_id IN ($catidsstr)
                        AND oi.price_incl_tax IS NOT NULL
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                    GROUP BY 
                        price_range
                    ORDER BY price_range";

                }
                
                $result = $this->resource->getConnection()->fetchAll($sql);
                
              
                if (!empty($result)) { 
                    $datalabels[] = $k;
                    $tmparr = ['0-9999'=>0, '10000-19999'=>0, '20000-above'=>0];
                 
                    foreach ($result as $item) { 
                        $total = floatval($item['total_ordered']);   
                        $tmparr[$item['price_range']] = $total;  
                    }
                    $datarange['0-9999'][] = $tmparr['0-9999'];
                    $datarange['10000-19999'][] = $tmparr['10000-19999'];
                    $datarange['20000-above'][] = $tmparr['20000-above'];                    
                }
                
            }
           echo "<div class= 'container row'><div class = col-m-12> <h4> $label  </h4>";
            echo "<table class='admin__table-primary analysis-data'><tr>";
           
                foreach( $datalabels as  $value){
                    echo "<th> $value </th>";
                }
                echo "<tr></tr>";
                foreach($datarange['0-9999'] as  $value){
                    echo "<td> $value </td>";
                }
                echo "<tr></tr>";
                foreach($datarange['10000-19999'] as  $value){
                    echo "<td> $value </td>";
                }
               
                echo "<tr></tr>";
                foreach($datarange['20000-above'] as  $value){
                    echo "<td> $value </td>";
                }
            echo "</tr></table></div></div>";
        }else{   
            
            if($brandselected != ''){
                 
                $sql = " SELECT 
                CASE
                WHEN price_incl_tax >= 0 AND price_incl_tax <10000 THEN '0-9999' 
                    WHEN price_incl_tax >= 10000 AND price_incl_tax < 20000 THEN '10000-19999'                    
                    ELSE '20000-above' 
                END AS price_range,
                SUM(oi.qty_ordered) AS total_ordered
                FROM 
                    sales_order AS o 
                    JOIN sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN
                        catalog_category_product AS ccp ON ccp.product_id = oi.product_id
                    JOIN
                        catalog_category_entity_varchar AS ccev ON ccev.entity_id = ccp.category_id AND ccev.attribute_id = 41
                    JOIN catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id
                    LEFT JOIN 
                    catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133
                WHERE 
                    o.state IN ('complete','processing') 
                    AND o.store_id = 1
                    AND ccp.category_id IN ($catidsstr)
                    AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                    AND cpei.value = $brandselected
                    AND oi.price_incl_tax IS NOT NULL
                GROUP BY 
                    price_range
                ORDER BY price_range";
            }else{
                $sql = " SELECT 
                CASE 
                WHEN price_incl_tax >= 0 AND price_incl_tax <10000 THEN '0-9999' 
                    WHEN price_incl_tax >= 10000 AND price_incl_tax < 20000 THEN '10000-19999'                    
                    ELSE '20000-above' 
                END AS price_range,
                SUM(oi.qty_ordered) AS total_ordered
                FROM 
                    sales_order AS o 
                    JOIN sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN
                        catalog_category_product AS ccp ON ccp.product_id = oi.product_id
                    JOIN
                        catalog_category_entity_varchar AS ccev ON ccev.entity_id = ccp.category_id AND ccev.attribute_id = 41
                WHERE 
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    AND ccp.category_id IN ($catidsstr)
                    AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                    AND oi.price_incl_tax IS NOT NULL
                GROUP BY 
                    price_range
                ORDER BY price_range";

            }
            
            $result = $this->resource->getConnection()->fetchAll($sql);
            
            echo "<div class = col-m-12>";
            echo "<h4 class='newblk'> $label </h4>";
            if (!empty($result)) { 
                echo "<table class='admin__table-primary analysis-data'><tr><th>Price Range</th><th>Qty ordered</th></tr>";
                foreach ($result as $item) {   
                    $total = floatval($item['total_ordered']);             
                    echo "<tr><td>$item[price_range]</td><td>$total</td></tr>";
                }
                echo "</table>";
            }
            echo "</div>";
        }
    }

    public function PRangeAttrTrainingGraph($catids, $interval, $brandselected =''){
        
        $catidsstr = implode(',', $catids);
        
        $labels = [];
        $gData  = [];
      
        $daterange = $this->getDaterange();
        $array = $daterange[$interval];
        if(!empty($array)){
            foreach($array as $k=> $v){
               
                if($brandselected != ''){
                    $sql = " SELECT 
                    CASE 
                    WHEN price_incl_tax >= 0 AND price_incl_tax <10000 THEN '0-9999' 
                    WHEN price_incl_tax >= 10000 AND price_incl_tax < 20000 THEN '10000-19999'                    
                    ELSE '20000-above' 
                    END AS price_range,
                    SUM(oi.qty_ordered) AS total_ordered
                    FROM 
                        sales_order AS o 
                        JOIN sales_order_item AS oi ON oi.order_id = o.entity_id 
                        JOIN
                            catalog_category_product AS ccp ON ccp.product_id = oi.product_id
                        JOIN
                            catalog_category_entity_varchar AS ccev ON ccev.entity_id = ccp.category_id AND ccev.attribute_id = 41
                        JOIN catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id
                        LEFT JOIN 
                        catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133
                    WHERE 
                        o.state IN ('complete','processing')
                        AND o.store_id = 1
                        AND ccp.category_id IN ($catidsstr)
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND cpei.value = $brandselected
                        AND oi.price_incl_tax IS NOT NULL
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                    GROUP BY 
                        price_range
                    ORDER BY price_range";

                }else{
                    $sql = " SELECT 
                    CASE 
                    WHEN price_incl_tax >= 0 AND price_incl_tax <10000 THEN '0-9999' 
                    WHEN price_incl_tax >= 10000 AND price_incl_tax < 20000 THEN '10000-19999'                    
                    ELSE '20000-above' 
                    END AS price_range,
                    SUM(oi.qty_ordered) AS total_ordered
                    FROM 
                        sales_order AS o 
                        JOIN sales_order_item AS oi ON oi.order_id = o.entity_id 
                        JOIN
                            catalog_category_product AS ccp ON ccp.product_id = oi.product_id
                        JOIN
                            catalog_category_entity_varchar AS ccev ON ccev.entity_id = ccp.category_id AND ccev.attribute_id = 41
                    WHERE 
                        o.state IN ('complete','processing') 
                        AND o.store_id = 1
                        AND ccp.category_id IN ($catidsstr)
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND oi.price_incl_tax IS NOT NULL
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                    GROUP BY 
                        price_range
                    ORDER BY price_range";

                }
                
                $result = $this->resource->getConnection()->fetchAll($sql);
                if (!empty($result)) { 
                    $labels[] = $k;    
                    $tmparr = ['0-9999'=>0, '10000-19999'=>0, '20000-above'=>0];
                         
                    foreach($result as $item) {   
                        $total = floatval($item['total_ordered']); 
                        $range = $item['price_range'];
                        $tmparr[$range] = $total;
                    }
                    foreach($tmparr as  $r => $tmp) { 
                        $gData[$r][]  = $tmp ; 
                    }
                }
               
            }

        }
        if($interval == 'monthly'){
            echo "<div class = col-m-12>";
        }else{
            echo "<div class = col-m-6>";
        }
        
        $labelsjsonenc = json_encode($labels);
        $labelsjsonvalue = htmlspecialchars($labelsjsonenc, ENT_QUOTES, 'UTF-8');
       
        
        $colors= ['#4BC0C0','#ff6361','#003f5c','#8B4513','#663046'];
        $datasets = [];
        $i = 0;
        foreach($gData as $k => $v){
            $datasets[] =   [
                'label' => $k ,
                'data' => $v,
                'borderColor' => $colors[$i],
                'fill' => false,
                'tension' => 0.1
            ];
            $i++;
        } 
        $datasetsjsonenc = json_encode($datasets);
        $datasetsjsonvalue = htmlspecialchars($datasetsjsonenc, ENT_QUOTES, 'UTF-8');

        
        echo '<canvas class ="drawChartline" data-label = "'.$labelsjsonvalue.'" data-dataset = "'.$datasetsjsonvalue.'"  id="chart-prage-'.$catids[0].'-'.$interval.'"></canvas>';
        echo "</div>";

    }


