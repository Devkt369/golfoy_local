    public function MonthlysalesReward(){

        $sql = "SELECT
        CASE WHEN o.pos_id IS NULL THEN 'website' ELSE CONCAT('POS ', o.pos_id) END AS source,
        aset.attribute_set_name,
        SUM(IFNULL(NULLIF(oi.mp_reward_earn, 0), 0)) AS earn,
        SUM(IFNULL(NULLIF(oi.mp_reward_spent, 0), 0)) AS spent
    FROM
        sales_order_item AS oi
    JOIN
        sales_order AS o ON oi.order_id = o.entity_id        
    JOIN
        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id
    JOIN
        eav_attribute_set AS aset ON aset.attribute_set_id = cpe.attribute_set_id
    WHERE
        o.state IN ('complete', 'processing')
        AND (IFNULL(NULLIF(oi.mp_reward_earn, 0), 0) > 0
            OR IFNULL(NULLIF(oi.mp_reward_spent, 0), 0) > 0)
        AND oi.parent_item_id IS NULL 
        AND oi.qty_ordered > (oi.qty_refunded + oi.qty_canceled)
        AND o.store_id = 1
        AND (
                    (o.pos_id IS NULL AND oi.row_total > 20)
                    OR (o.pos_id IS NOT NULL AND 1)
                )
            AND o.created_at >= DATE_FORMAT(NOW() - INTERVAL 1 MONTH, '%Y-%m-01 00:00:00')
            AND o.created_at <= DATE_FORMAT(CONCAT(LAST_DAY(NOW() - INTERVAL 1 MONTH), ' 23:59:59'), '%Y-%m-%d %H:%i:%s')        
    GROUP BY
        source, aset.attribute_set_name
    ORDER BY
        source DESC, aset.attribute_set_name ASC";

        
        $result = $this->resource->getConnection()->fetchAll($sql);
        
        $content = [];
        if (!empty($result)) { 
            $content[] = ["Source" , "Attr set name", "Reward points Earned", "Reward points Spent"];
           
            foreach ($result as $item) {               
                $content[] = [$item['source'], $item['attribute_set_name'], $item['earn'], $item['spent']];
            }
            
        }
        $directory     = $this->filesystem->getDirectoryWrite(AppDirectoryList::VAR_DIR);
        $foldername    = "wmsales";
        if (!$directory->isDirectory($foldername)) {
            $directory->create($foldername);}  

        date_default_timezone_set('Asia/Kolkata');   
        $currentDate = new \DateTime();
        $previousMonth = $currentDate->modify('-1 month')->format('M_Y');

        $fileName      = $previousMonth.'_Reward_Summary.csv'; 
        $filePath      = $foldername.'/' . $fileName;
        $file          = $directory->openFile($filePath, 'w+');
        
        foreach($content as $cdata){            
            $file->writeCsv($cdata);
        }
        $file->close();
        return $fileName;

    }



    public function MonthlysalesCoupon(){

        $sql = "SELECT
        CASE WHEN o.pos_id IS NULL THEN 'website' ELSE CONCAT('POS ', o.pos_id) END AS source,
        aset.attribute_set_name,
        CASE WHEN SUM(oi.discount_amount <> 0) OR SUM(oi.base_discount_amount <> 0) THEN o.coupon_code ELSE '' END AS coupon_code,
        SUM(IFNULL(NULLIF(oi.discount_amount, 0), 0)) AS coupon_discount
    FROM
        sales_order_item AS oi
    JOIN
        sales_order AS o ON oi.order_id = o.entity_id        
    JOIN
        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id
    JOIN
        eav_attribute_set AS aset ON aset.attribute_set_id = cpe.attribute_set_id
    WHERE
        o.state IN ('complete', 'processing')
        AND IFNULL(NULLIF(oi.discount_amount, 0), 0) > 0
        AND oi.parent_item_id IS NULL 
        AND oi.qty_ordered > (oi.qty_refunded + oi.qty_canceled)
        AND (
                    (o.pos_id IS NULL AND oi.row_total > 20)
                    OR (o.pos_id IS NOT NULL AND 1)
                )
        AND o.created_at >= DATE_FORMAT(NOW() - INTERVAL 1 MONTH, '%Y-%m-01 00:00:00')
        AND o.created_at <= DATE_FORMAT(CONCAT(LAST_DAY(NOW() - INTERVAL 1 MONTH), ' 23:59:59'), '%Y-%m-%d %H:%i:%s')        
        AND o.store_id = 1
    GROUP BY
        source, aset.attribute_set_name, o.coupon_code
    ORDER BY
        source DESC, aset.attribute_set_name ASC";

        
        $result = $this->resource->getConnection()->fetchAll($sql);
        
        $content = [];
        if (!empty($result)) { 
            $content[] = ["Source", "Attr Set Name", "Coupon code", "Total Discount"];
           
            foreach ($result as $item) {               
                $content[] = [$item['source'], $item['attribute_set_name'], $item['coupon_code'], $item['coupon_discount']];
            }
            
        }
        $directory     = $this->filesystem->getDirectoryWrite(AppDirectoryList::VAR_DIR);
        $foldername    = "wmsales";
        if (!$directory->isDirectory($foldername)) {
            $directory->create($foldername);}  

        date_default_timezone_set('Asia/Kolkata');   
        $currentDate = new \DateTime();
        $previousMonth = $currentDate->modify('-1 month')->format('M_Y');

        $fileName      = $previousMonth.'_Coupon_Summary.csv'; 
        $filePath      = $foldername.'/' . $fileName;
        $file          = $directory->openFile($filePath, 'w+');
        
        foreach($content as $cdata){            
            $file->writeCsv($cdata);
        }
        $file->close();
        return $fileName;

    }


    public function MonthlysalesCP(){

        $sql = "SELECT
        CASE WHEN o.pos_id IS NULL THEN 'website' ELSE CONCAT('POS ', o.pos_id) END AS source,
        aset.attribute_set_name,
        SUM(CASE WHEN (oi.product_options LIKE '%customprint%' OR (oi.product_options LIKE '%print%' AND oi.product_options LIKE '%text%' AND oi.product_options REGEXP 'print.{3,}text')) THEN oi.qty_ordered ELSE 0 END) AS total_cprintqty
    FROM
        sales_order_item AS oi
    JOIN
        sales_order AS o ON oi.order_id = o.entity_id
    JOIN
        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id
    JOIN
        eav_attribute_set AS aset ON aset.attribute_set_id = cpe.attribute_set_id
    WHERE
        o.state IN ('complete', 'processing')
        AND (CASE WHEN (oi.product_options LIKE '%customprint%' OR (oi.product_options LIKE '%print%' AND oi.product_options LIKE '%text%' AND oi.product_options REGEXP 'print.{3,}text')) THEN oi.qty_ordered ELSE 0 END > 0)
        AND oi.parent_item_id IS NULL 
        AND oi.qty_ordered > (oi.qty_refunded + oi.qty_canceled)
        AND o.created_at >= DATE_FORMAT(NOW() - INTERVAL 1 MONTH, '%Y-%m-01 00:00:00')
        AND o.store_id = 1
        AND o.created_at <= DATE_FORMAT(CONCAT(LAST_DAY(NOW() - INTERVAL 1 MONTH), ' 23:59:59'), '%Y-%m-%d %H:%i:%s')        
        AND (
                    (o.pos_id IS NULL AND oi.row_total > 20)
                    OR (o.pos_id IS NOT NULL AND 1)
                )
    GROUP BY
        source, aset.attribute_set_name
    ORDER BY
        source DESC, aset.attribute_set_name ASC";

        
        $result = $this->resource->getConnection()->fetchAll($sql);
        
        $content = [];
        if (!empty($result)) { 
            $content[] = ["Source" , "Attr Set Name", "Total Customprint Qty"];
           
            foreach ($result as $item) {               
                $content[] = [$item['source'], $item['attribute_set_name'], $item['total_cprintqty']];
            }
            
        }
        $directory     = $this->filesystem->getDirectoryWrite(AppDirectoryList::VAR_DIR);
        $foldername    = "wmsales";
        if (!$directory->isDirectory($foldername)) {
            $directory->create($foldername);}  

        date_default_timezone_set('Asia/Kolkata');   
        $currentDate = new \DateTime();
        $previousMonth = $currentDate->modify('-1 month')->format('M_Y');

        $fileName      = $previousMonth.'_Customisation_Summary.csv'; 
        $filePath      = $foldername.'/' . $fileName;
        $file          = $directory->openFile($filePath, 'w+');
        
        foreach($content as $cdata){            
            $file->writeCsv($cdata);
        }
        $file->close();
        return $fileName;

    }

    public function MonthlysalesClearance(){

        $sql = "SELECT 
        CASE WHEN o.pos_id IS NULL THEN 'website' ELSE CONCAT('POS ', o.pos_id) END AS source,
        aset.attribute_set_name,                    
        SUM(CASE WHEN oi.on_clearance = 0 THEN oi.qty_ordered ELSE 0 END) as normal,
        SUM(CASE WHEN oi.on_clearance = 1 THEN oi.qty_ordered ELSE 0 END) as clearance
        FROM 
            sales_order AS o 
        JOIN 
            sales_order_item AS oi ON oi.order_id = o.entity_id  
        JOIN
            catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id
        JOIN
            eav_attribute_set AS aset ON aset.attribute_set_id = cpe.attribute_set_id
        WHERE
            o.state IN ('complete','processing')
            AND oi.parent_item_id IS NULL
            AND oi.qty_ordered > (oi.qty_refunded + oi.qty_canceled)
            AND o.created_at >= DATE_FORMAT(NOW() - INTERVAL 1 MONTH, '%Y-%m-01 00:00:00')
            AND o.created_at <= DATE_FORMAT(CONCAT(LAST_DAY(NOW() - INTERVAL 1 MONTH), ' 23:59:59'), '%Y-%m-%d %H:%i:%s')  
            AND (
                (o.pos_id IS NULL AND oi.row_total > 20)
                OR (o.pos_id IS NOT NULL AND 1)
            )
            AND o.store_id = 1
            GROUP BY
                source, aset.attribute_set_name
            ORDER BY
                source DESC, aset.attribute_set_name ASC";

        
        $result = $this->resource->getConnection()->fetchAll($sql);
        
        $content = [];
        if (!empty($result)) { 
            $content[] = ["Source" , "Attr Set Name", "Normal Qty", "Clearance Qty"];
           
            foreach ($result as $item) {               
                $content[] = [$item['source'], $item['attribute_set_name'], $item['normal'], $item['clearance']];
            }
            
        }
        $directory     = $this->filesystem->getDirectoryWrite(AppDirectoryList::VAR_DIR);
        $foldername    = "wmsales";
        if (!$directory->isDirectory($foldername)) {
            $directory->create($foldername);}  

        date_default_timezone_set('Asia/Kolkata');   
        $currentDate = new \DateTime();
        $previousMonth = $currentDate->modify('-1 month')->format('M_Y');

        $fileName      = $previousMonth.'_Clearance_Summary.csv'; 
        $filePath      = $foldername.'/' . $fileName;
        $file          = $directory->openFile($filePath, 'w+');
        
        foreach($content as $cdata){            
            $file->writeCsv($cdata);
        }
        $file->close();
        return $fileName;

    }

    public function MonthlyCustomers(){

        $rdata = ['new'=>0,'old'=>0,'guest'=>0];
        
        
        $sql = "SELECT count(subtotal) AS total FROM (SELECT
        count(c.email) AS subtotal
    FROM
        customer_entity AS c
    INNER JOIN (
        SELECT
            customer_id,
            MIN(created_at) AS created_at
        FROM
            sales_order
        WHERE
            state <> 'canceled'
        GROUP BY
            customer_id
    ) AS o ON c.entity_id = o.customer_id
    WHERE
        o.created_at >= DATE_FORMAT(NOW() - INTERVAL 1 MONTH, '%Y-%m-01 00:00:00')
        AND o.created_at <= DATE_FORMAT(CONCAT(LAST_DAY(NOW() - INTERVAL 1 MONTH), ' 23:59:59'), '%Y-%m-%d %H:%i:%s')        
    GROUP BY
        c.email) as subq";

        $result = $this->resource->getConnection()->fetchAll($sql);
        $rdata['new'] = $result[0]['total'];


        $sql = "SELECT count(subtotal) AS total FROM (SELECT
        count(c.email) as subtotal
    FROM
        customer_entity AS c
    INNER JOIN (
        SELECT
            customer_id,
            MIN(created_at) AS created_at
        FROM
            sales_order
        WHERE
            state = 'complete'
           
        GROUP BY
            customer_id
    ) AS previous_orders ON c.entity_id = previous_orders.customer_id
    INNER JOIN sales_order AS o ON c.entity_id = o.customer_id
    WHERE
        o.created_at >= DATE_FORMAT(NOW() - INTERVAL 1 MONTH, '%Y-%m-01 00:00:00')
        AND o.created_at <= DATE_FORMAT(CONCAT(LAST_DAY(NOW() - INTERVAL 1 MONTH), ' 23:59:59'), '%Y-%m-%d %H:%i:%s')        
        AND o.state <> 'canceled'
        AND o.store_id = 1
        AND previous_orders.created_at < DATE_FORMAT(NOW() - INTERVAL 1 MONTH, '%Y-%m-01 00:00:00')
    GROUP BY
        c.email) AS subq";

        $result = $this->resource->getConnection()->fetchAll($sql);
        $rdata['old'] = $result[0]['total'];

        

        $sql = "SELECT COUNT(o.customer_email) AS total
        FROM sales_order AS o
        WHERE o.customer_id IS NULL
          AND o.state <> 'canceled' 
          AND  o.created_at >= DATE_FORMAT(NOW() - INTERVAL 1 MONTH, '%Y-%m-01 00:00:00')
          AND o.store_id = 1
        AND o.created_at <= DATE_FORMAT(CONCAT(LAST_DAY(NOW() - INTERVAL 1 MONTH), ' 23:59:59'), '%Y-%m-%d %H:%i:%s')";

        $result = $this->resource->getConnection()->fetchAll($sql);
        $rdata['guest'] = $result[0]['total'];



        $content = [];
        $content[] = ["New Customers" , "Repeated Customers", "Guest Users"];
        $content[] = [$rdata['new'] , $rdata['old'], $rdata['guest']];  
           
        $directory     = $this->filesystem->getDirectoryWrite(AppDirectoryList::VAR_DIR);
        $foldername    = "wmsales";
        if (!$directory->isDirectory($foldername)) {
            $directory->create($foldername);}  

        date_default_timezone_set('Asia/Kolkata');   
        $currentDate = new \DateTime();
        $previousMonth = $currentDate->modify('-1 month')->format('M_Y');

        $fileName      = $previousMonth.'_Customer_Data.csv'; 
        $filePath      = $foldername.'/' . $fileName;
        $file          = $directory->openFile($filePath, 'w+');
        
        foreach($content as $cdata){            
            $file->writeCsv($cdata);
        }
        $file->close();
        return $fileName;

    }

    public function MonthlysalesAttr(){

        $sql = "SELECT 
        parentaset.attribute_set_name AS parent_attribute_set_name,
        aset.attribute_set_name,
        parent.product_id AS parent_product_id,
        oi.product_id,
        parent.name AS parent_product_name,
        oi.name AS product_name,
        parent.price AS parentprice,
        oi.price,
        oi.qty_ordered - oi.qty_refunded - oi.qty_canceled  AS tqty,
        CASE  
        WHEN oi.parent_item_id IS NULL THEN oi.row_total_incl_tax - oi.tax_amount - IFNULL(NULLIF(oi.mp_reward_discount, 0), 0) - IFNULL(NULLIF(oi.discount_amount, 0), 0) - IFNULL(NULLIF(oi.discount_refunded, 0), 0) - oi.amount_refunded
        ELSE parent.row_total_incl_tax - parent.tax_amount - IFNULL(NULLIF(parent.mp_reward_discount, 0), 0) - IFNULL(NULLIF(parent.discount_amount, 0), 0) - IFNULL(NULLIF(parent.discount_refunded, 0), 0) - parent.amount_refunded 
        END AS final_price, 
        parentbrand.value AS parent_brand,
        brand.value AS brand,
        parentcolor.value AS parent_color,
        color.value AS color,
        spike.value AS spiked,
        waterproof.value AS waterproof,
        shoewidth.value AS shoe_width,
        outershoemat.value AS shoe_material,
        apparelmat.value AS apparel_material,
        pgender.value AS player_gender,
        glovemat.value AS glove_material,
        shoesize.value AS shoe_size,
        tshirtsize.value AS tshirt_size,
        glovesize.value AS glove_size,
        glovehand.value AS glove_hand,
        gripsize.value AS grip_size,
        griptype.value AS grip_type,
        loftsize.value AS loft_size,
        flex.value AS flex,
        shaft.value AS shaft,
        shaftgram.value AS shaft_gram,
        clubhead.value AS club_head,
        waistsize.value AS waist_size,
        lngth.value AS putter_length,
        bagtype.value AS bag_type,
        trolleytype.value AS trolley_type,
        oi.on_clearance,
        CASE WHEN (oi.product_options LIKE '%customprint%' OR (oi.product_options LIKE '%print%' AND oi.product_options LIKE '%text%' AND oi.product_options REGEXP 'print.{3,}text')) THEN 'Yes' ELSE 'No' END AS custom_print,
        CASE WHEN o.pos_id IS NULL THEN 'website' ELSE CONCAT('POS ', o.pos_id) END AS source
    FROM 
        sales_order AS o 
    JOIN 
        sales_order_item AS oi ON oi.order_id = o.entity_id 
    JOIN
        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id
    LEFT JOIN
        eav_attribute_set AS aset ON aset.attribute_set_id = cpe.attribute_set_id
    LEFT JOIN 
        catalog_product_entity_int AS cpei_brand ON cpei_brand.entity_id = oi.product_id AND cpei_brand.attribute_id = 133
    LEFT JOIN 
        catalog_product_entity_int AS cpei_color ON cpei_color.entity_id = oi.product_id AND cpei_color.attribute_id = 92
    LEFT JOIN 
        catalog_product_entity_int AS cpei_shoesize ON cpei_shoesize.entity_id = oi.product_id AND cpei_shoesize.attribute_id = 175
    LEFT JOIN 
        catalog_product_entity_int AS cpei_tshirtsize ON cpei_tshirtsize.entity_id = oi.product_id AND cpei_tshirtsize.attribute_id = 184
    LEFT JOIN 
        catalog_product_entity_int AS cpei_glovesize ON cpei_glovesize.entity_id = oi.product_id AND cpei_glovesize.attribute_id = 145
    LEFT JOIN 
        catalog_product_entity_int AS cpei_glovehand ON cpei_glovehand.entity_id = oi.product_id AND cpei_glovehand.attribute_id = 144
    LEFT JOIN 
        catalog_product_entity_int AS cpei_gripsize ON cpei_gripsize.entity_id = oi.product_id AND cpei_gripsize.attribute_id = 137
    LEFT JOIN 
        catalog_product_entity_int AS cpei_griptype ON cpei_griptype.entity_id = oi.product_id AND cpei_griptype.attribute_id = 264
    LEFT JOIN 
        catalog_product_entity_int AS cpei_loftsize ON cpei_loftsize.entity_id = oi.product_id AND cpei_loftsize.attribute_id = 183
    LEFT JOIN 
        catalog_product_entity_int AS cpei_flex ON cpei_flex.entity_id = oi.product_id AND cpei_flex.attribute_id = 179
    LEFT JOIN 
        catalog_product_entity_int AS cpei_shaft ON cpei_shaft.entity_id = oi.product_id AND cpei_shaft.attribute_id = 180
    LEFT JOIN 
        catalog_product_entity_int AS cpei_shaftgram ON cpei_shaftgram.entity_id = oi.product_id AND cpei_shaftgram.attribute_id = 181
    LEFT JOIN 
        catalog_product_entity_int AS cpei_clubhead ON cpei_clubhead.entity_id = oi.product_id AND cpei_clubhead.attribute_id = 195
    LEFT JOIN 
        catalog_product_entity_int AS cpei_waistsize ON cpei_waistsize.entity_id = oi.product_id AND cpei_waistsize.attribute_id = 186
    LEFT JOIN 
        catalog_product_entity_int AS cpei_lngth ON cpei_lngth.entity_id = oi.product_id AND cpei_lngth.attribute_id = 196
    LEFT JOIN 
        catalog_product_entity_int AS cpei_bagtype ON cpei_bagtype.entity_id = oi.product_id AND cpei_bagtype.attribute_id = 147
    LEFT JOIN 
        catalog_product_entity_int AS cpei_trolleytype ON cpei_trolleytype.entity_id = oi.product_id AND cpei_trolleytype.attribute_id = 177
    LEFT JOIN 
        eav_attribute_option_value AS brand ON brand.option_id = cpei_brand.value AND brand.store_id = 0
    LEFT JOIN 
        eav_attribute_option_value AS color ON color.option_id = cpei_color.value AND color.store_id = 0
    LEFT JOIN 
        eav_attribute_option_value AS shoesize ON shoesize.option_id = cpei_shoesize.value AND shoesize.store_id = 0
    LEFT JOIN 
        eav_attribute_option_value AS tshirtsize ON tshirtsize.option_id = cpei_tshirtsize.value AND tshirtsize.store_id = 0
    LEFT JOIN 
        eav_attribute_option_value AS glovesize ON glovesize.option_id = cpei_glovesize.value AND glovesize.store_id = 0
    LEFT JOIN 
        eav_attribute_option_value AS glovehand ON glovehand.option_id = cpei_glovehand.value AND glovehand.store_id = 0
    LEFT JOIN 
        eav_attribute_option_value AS gripsize ON gripsize.option_id = cpei_gripsize.value AND gripsize.store_id = 0
    LEFT JOIN 
        eav_attribute_option_value AS griptype ON griptype.option_id = cpei_griptype.value AND griptype.store_id = 0
    LEFT JOIN 
        eav_attribute_option_value AS loftsize ON loftsize.option_id = cpei_loftsize.value AND loftsize.store_id = 0
    LEFT JOIN 
        eav_attribute_option_value AS flex ON flex.option_id = cpei_flex.value AND flex.store_id = 0
    LEFT JOIN 
        eav_attribute_option_value AS shaft ON shaft.option_id = cpei_shaft.value AND shaft.store_id = 0
    LEFT JOIN 
        eav_attribute_option_value AS shaftgram ON shaftgram.option_id = cpei_shaftgram.value AND shaftgram.store_id = 0
    LEFT JOIN 
        eav_attribute_option_value AS clubhead ON clubhead.option_id = cpei_clubhead.value AND clubhead.store_id = 0
    LEFT JOIN 
        eav_attribute_option_value AS waistsize ON waistsize.option_id = cpei_waistsize.value AND waistsize.store_id = 0
    LEFT JOIN 
        eav_attribute_option_value AS bagtype ON bagtype.option_id = cpei_bagtype.value AND bagtype.store_id = 0
    LEFT JOIN 
        eav_attribute_option_value AS lngth ON lngth.option_id = cpei_lngth.value AND lngth.store_id = 0
    LEFT JOIN 
        eav_attribute_option_value AS trolleytype ON trolleytype.option_id = cpei_trolleytype.value AND trolleytype.store_id = 0
    LEFT JOIN
        sales_order_item AS parent ON oi.parent_item_id = parent.item_id
    LEFT JOIN
        catalog_product_entity AS parent_cpe ON parent_cpe.entity_id = parent.product_id
    LEFT JOIN
        eav_attribute_set AS parentaset ON parentaset.attribute_set_id = parent_cpe.attribute_set_id
    LEFT JOIN 
        catalog_product_entity_int AS parent_cpei_brand ON parent_cpei_brand.entity_id = parent.product_id AND parent_cpei_brand.attribute_id = 133
    LEFT JOIN 
        catalog_product_entity_int AS parent_cpei_color ON parent_cpei_color.entity_id = parent.product_id AND parent_cpei_color.attribute_id = 92
    LEFT JOIN 
        catalog_product_entity_int AS cpei_spike ON cpei_spike.entity_id = parent.product_id AND cpei_spike.attribute_id = 176
    LEFT JOIN 
        catalog_product_entity_int AS cpei_apparelmat ON cpei_apparelmat.entity_id = parent.product_id AND cpei_apparelmat.attribute_id = 188
    LEFT JOIN 
        catalog_product_entity_int AS cpei_waterproof ON cpei_waterproof.entity_id = parent.product_id AND cpei_waterproof.attribute_id = 241
    LEFT JOIN 
        catalog_product_entity_int AS cpei_pgender ON cpei_pgender.entity_id = parent.product_id AND cpei_pgender.attribute_id = 268
    LEFT JOIN 
        catalog_product_entity_int AS cpei_glovemat ON cpei_glovemat.entity_id = parent.product_id AND cpei_glovemat.attribute_id = 269
    LEFT JOIN 
        catalog_product_entity_int AS cpei_outershoemat ON cpei_outershoemat.entity_id = parent.product_id AND cpei_outershoemat.attribute_id = 270
    LEFT JOIN 
        catalog_product_entity_int AS cpei_shoewidth ON cpei_shoewidth.entity_id = parent.product_id AND cpei_shoewidth.attribute_id = 271
    LEFT JOIN 
        eav_attribute_option_value AS parentbrand ON parentbrand.option_id = parent_cpei_brand.value AND parentbrand.store_id = 0
    LEFT JOIN 
        eav_attribute_option_value AS parentcolor ON parentcolor.option_id = parent_cpei_color.value AND parentcolor.store_id = 0
    LEFT JOIN 
        eav_attribute_option_value AS spike ON spike.option_id = cpei_spike.value AND spike.store_id = 0
    LEFT JOIN 
        eav_attribute_option_value AS apparelmat ON apparelmat.option_id = cpei_apparelmat.value AND apparelmat.store_id = 0
    LEFT JOIN 
        eav_attribute_option_value AS waterproof ON waterproof.option_id = cpei_waterproof.value AND waterproof.store_id = 0
    LEFT JOIN 
        eav_attribute_option_value AS pgender ON pgender.option_id = cpei_pgender.value AND pgender.store_id = 0
    LEFT JOIN 
        eav_attribute_option_value AS glovemat ON glovemat.option_id = cpei_glovemat.value AND glovemat.store_id = 0
    LEFT JOIN 
        eav_attribute_option_value AS outershoemat ON outershoemat.option_id = cpei_outershoemat.value AND outershoemat.store_id = 0
    LEFT JOIN 
        eav_attribute_option_value AS shoewidth ON shoewidth.option_id = cpei_shoewidth.value AND shoewidth.store_id = 0
    WHERE 
        o.state IN ('complete', 'processing')
        AND o.store_id = 1
        AND oi.product_type = 'simple'
        AND oi.qty_ordered > (oi.qty_refunded + oi.qty_canceled)
        AND (
            (
                oi.parent_item_id IS NULL
                AND (
                    (o.pos_id IS NULL AND oi.row_total > 20)
                    OR (o.pos_id IS NOT NULL AND 1)
                )
            )
            OR (
                oi.parent_item_id IS NOT NULL
                AND (
                    (o.pos_id IS NULL AND parent.row_total > 20)
                    OR (o.pos_id IS NOT NULL AND 1)
                )
            )
        )
        AND o.created_at >= DATE_FORMAT(NOW() - INTERVAL 1 MONTH, '%Y-%m-01 00:00:00')
        AND o.created_at <= DATE_FORMAT(CONCAT(LAST_DAY(NOW() - INTERVAL 1 MONTH), ' 23:59:59'), '%Y-%m-%d %H:%i:%s')
        ";

        $result = $this->resource->getConnection()->fetchAll($sql);
        
        $content = [];
        if (!empty($result)) { 
            $content[] = ["parent_attribute_set_name" , "attribute_set_name", "parent_product_name",
            "product_name", "parentprice", "price", "qty", "final_price",
            "parent_brand", "brand", "parent_color",  "color", "spiked", "waterproof", "shoe_width",
            "shoe_material", "apparel_material", "player_gender", "glove_material", 
            "shoe_size","tshirt_size", "glove_size", "glove_hand",
            "grip_size", "grip_type", "loft_size", "flex", 
            "shaft", "shaft_gram", "club_head","waist_size", "putter_length", 
            "bag_type","trolley_type","on_clearance","custom_print","source"];
           
            foreach ($result as $item) {               
                $content[] = [$item['parent_attribute_set_name'], $item['attribute_set_name'],
                $item['parent_product_name'], $item['product_name'],
                $item['parentprice'], $item['price'], $item['tqty'], $item['final_price'],
                $item['parent_brand'], $item['brand'], $item['parent_color'], $item['color'],
                $item['spiked'], $item['waterproof'], $item['shoe_width'],$item['shoe_material'],
                $item['apparel_material'], $item['player_gender'], $item['glove_material'],$item['shoe_size'],
                $item['tshirt_size'], $item['glove_size'], $item['glove_hand'], $item['grip_size'],
                $item['grip_type'], $item['loft_size'], $item['flex'], $item['shaft'], 
                $item['shaft_gram'],$item['club_head'], $item['waist_size'], $item['putter_length'],
                $item['bag_type'],$item['trolley_type'],$item['on_clearance'],$item['custom_print'],$item['source']
                ];
            }
            
        }
        $directory     = $this->filesystem->getDirectoryWrite(AppDirectoryList::VAR_DIR);
        $foldername    = "wmsales";
        if (!$directory->isDirectory($foldername)) {
            $directory->create($foldername);}  

        date_default_timezone_set('Asia/Kolkata');   
        $currentDate = new \DateTime();
        $previousMonth = $currentDate->modify('-1 month')->format('M_Y');

        $fileName      = $previousMonth.'_Raw_Orders.csv'; 
        $filePath      = $foldername.'/' . $fileName;
        $file          = $directory->openFile($filePath, 'w+');
        
        foreach($content as $cdata){            
            $file->writeCsv($cdata);
        }
        $file->close();
        return $fileName;

    }

    

    ////////////////////// Customers
    public function totalCustomersAlltype(){
        $data = [];

        $sql = "SELECT COUNT(*) AS total FROM customer_grid_flat";
        $result = $this->resource->getConnection()->fetchAll($sql);
        if (!empty($result)) { 
            $data['total'] = floatval($result[0]['total']); 
        }


        $sql = "SELECT count(*) as total FROM(
            SELECT c.entity_id AS customer_id, c.email, COUNT(o.entity_id) AS order_count
            FROM customer_entity AS c
            LEFT JOIN sales_order AS o ON o.customer_id = c.entity_id AND o.state IN ('complete', 'new', 'processing', 'replacement_request')
            AND o.store_id = 1
            GROUP BY c.entity_id
            HAVING order_count = 0
        ) as subquery";
        $result = $this->resource->getConnection()->fetchAll($sql);
        if (!empty($result)) { 
            $data['zero'] = floatval($result[0]['total']); 
        }

        $sql = "SELECT COUNT(*) AS total
                FROM (
                    SELECT COUNT(DISTINCT orders.customer_id)
                    FROM sales_order AS orders
                    INNER JOIN customer_grid_flat AS customers ON customers.entity_id = orders.customer_id
                    WHERE orders.state IN ('complete', 'new','processing', 'replacement_request')
                    AND orders.store_id = 1
                    GROUP BY orders.customer_id
                    HAVING COUNT(*) = 1
                ) AS subquery";
        $result = $this->resource->getConnection()->fetchAll($sql);
        if (!empty($result)) { 
            $data['once'] = floatval($result[0]['total']); 
        }

        $sql = "SELECT COUNT(*) AS total
        FROM (
            SELECT COUNT(DISTINCT orders.customer_id)
            FROM sales_order AS orders
            INNER JOIN customer_grid_flat AS customers ON customers.entity_id = orders.customer_id
            WHERE orders.state IN ('complete', 'new','processing', 'replacement_request')
            AND orders.store_id = 1
            GROUP BY orders.customer_id
            HAVING COUNT(*) > 1
        ) AS subquery";
        $result = $this->resource->getConnection()->fetchAll($sql);
        if (!empty($result)) { 
            $data['repeated'] = floatval($result[0]['total']); 
        }
        
       
        return $data;
       
    }
    
    public function totalCustomersAll($label, $array=[]){        

        if(!empty($array)){
            $datalabels = [];
            $datalabels[] = '';
            $datalbl = [];
            $datalbl['total']      = [];
            $datalbl['total'][]      ='<strong>Total</strong>';
            $datalbl['zero'] = [];
            $datalbl['zero'][]      ='<strong>Not ordered</strong>';
            $datalbl['once'] = [];
            $datalbl['once'][]      ='<strong>Ordered once</strong>';
            $datalbl['repeated'] = [];
            $datalbl['repeated'][]      ='<strong>Ordered repeatedly</strong>';

            foreach($array as $k=> $v){

                $datalabels[] = $k;
                $sql = "SELECT COUNT(*) AS total FROM customer_grid_flat WHERE created_at BETWEEN '".$v['start']."' AND '".$v['end']."'";
                $result = $this->resource->getConnection()->fetchAll($sql);              
                if (!empty($result)) { 
                    $total = floatval($result[0]['total']); 
                    $datalbl['total'][] =$total;                    
                }


                $sql = "SELECT count(*) as total FROM(
                    SELECT c.entity_id AS customer_id, c.email, COUNT(o.entity_id) AS order_count
                    FROM customer_entity AS c
                    LEFT JOIN sales_order AS o ON o.customer_id = c.entity_id AND o.store_id = 1 AND o.state IN ('complete', 'new', 'processing', 'replacement_request')
                    WHERE c.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                    GROUP BY c.entity_id
                    HAVING order_count = 0
                ) as subquery";
                $result = $this->resource->getConnection()->fetchAll($sql);
                if (!empty($result)) { 
                    $total = floatval($result[0]['total']); 
                    $datalbl['zero'][] =$total;                    
                }

                $sql = "SELECT COUNT(*) AS total
                FROM (
                    SELECT COUNT(DISTINCT orders.customer_id)
                    FROM sales_order AS orders
                    INNER JOIN customer_grid_flat AS customers ON customers.entity_id = orders.customer_id
                    WHERE orders.state IN ('complete', 'new','processing', 'replacement_request')
                    AND orders.store_id = 1
                    AND customers.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                    GROUP BY orders.customer_id
                    HAVING COUNT(*) = 1
                   ) AS subquery";
                $result = $this->resource->getConnection()->fetchAll($sql);
                if (!empty($result)) { 
                    $total = floatval($result[0]['total']); 
                    $datalbl['once'][] =$total;                    
                }


                $sql = "SELECT COUNT(*) AS total
                FROM (
                    SELECT COUNT(DISTINCT orders.customer_id)
                    FROM sales_order AS orders
                    INNER JOIN customer_grid_flat AS customers ON customers.entity_id = orders.customer_id
                    WHERE orders.state IN ('complete', 'new','processing', 'replacement_request')
                    AND orders.store_id = 1
                    AND customers.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                    GROUP BY orders.customer_id
                    HAVING COUNT(*) > 1
                   ) AS subquery";
                $result = $this->resource->getConnection()->fetchAll($sql);
                if (!empty($result)) { 
                    $total = floatval($result[0]['total']); 
                    $datalbl['repeated'][] = $total;                    
                }

                
            }
           echo "<div class= 'container row'><div class = col-m-12> <h4> $label  </h4>";
            echo "<table class='admin__table-primary analysis-data'><tr>";
           
                foreach( $datalabels as  $value){
                    echo "<th> $value </th>";
                }
                echo "<tr></tr>";
                foreach($datalbl['total'] as  $value){
                    echo "<td> $value </td>";
                }
                echo "<tr></tr>";
                foreach($datalbl['zero'] as  $value){
                    echo "<td> $value </td>";
                }
                echo "<tr></tr>";
                foreach($datalbl['once'] as  $value){
                    echo "<td> $value </td>";
                }
                echo "<tr></tr>";
                foreach($datalbl['repeated'] as  $value){
                    echo "<td> $value </td>";
                }
                
            echo "</tr></table></div></div>";

        }

    }

    /**
     * Get All source list
     *
     * @return SourceInterface[]|false
     */
    public function getSourceName(){
        $sources = null;
        $sourceName = [];
        $searchCriteria = $this->searchCriteriaBuilder->create();
        $sourceData = $this->sourceRepository->getList($searchCriteria);
        if ($sourceData->getTotalCount()) {
            $sources = $sourceData->getItems();
            foreach ($sources as $source) {
                $sourceName[$source->getSourceCode()] = $source->getName();
            }
            $sourceName[] = 'Default Stock';
            return $sourceName;
        }else{
            return false;
        }
        return false;
    }

    public function getFilesInDirectory()
    {
        $salesDirectory = $this->directoryList->getPath(\Magento\Framework\App\Filesystem\DirectoryList::VAR_DIR) . '/sales';
        $items = scandir($salesDirectory);
        $items = array_diff($items, ['.', '..']);
        $files = array_filter($items, function ($item) use ($salesDirectory) {
            return is_file($salesDirectory . '/' . $item);
        });
        return $files;
    }

    public function getProductIdBySku($sku)
    {
        try {
            // Load the product by SKU
            $product = $this->productRepository->get($sku);
            
            // Get the product ID
            $productId = $product->getId();

            return $productId;
        } catch (NoSuchEntityException $e) {
            // Handle the case where the product with the given SKU does not exist
            return null;
        } catch (\Exception $e) {
            // Handle other exceptions
            return null;
        }
    }
    public function getOrderProducts($order_id){
        $shipmentAll = '';
        $invoiceAll = '';
        $i = 0;
        $product_data = array();
        $invoice = '';
        $shipment = '';
        $order = $this->orderRepository->get($order_id);
        
        $orderIncId = $order->getIncrementId(); 
        $orderItems = $order->getAllItems();

        $invoices = $this->getAllInvoiceIds($order);
        $in = 0;
        foreach ($invoices as $invoice) {
            if($in == 1){
                $invoiceAll .= ' , '.$invoice;
            }else{
                $invoiceAll = $invoice;
            }
            $in++;
        }

        $shipments = $this->getAllShipmentIds($order);
        $sh=0;
        foreach ($shipments as $shipment) {
            if($sh == 1){
                $shipmentAll .= ' , '.$shipment;
            }else{
                $shipmentAll = $shipment;
            }
            $sh++;
        }

        foreach ($orderItems as $item) {
            $data = $item->getProductOptions();
            $productId = $item->getProductId();
              
            $prd_data = $data['info_buyRequest'];

            $single_prd = array();
            if( (int)$item->getPrice() != 0 ){
                $single_prd['prd_id'] = $prd_data['product'] ?? '';
                $single_prd['sku'] = $item->getSku();
                $single_prd['name'] = $item->getName();
                $single_prd['qtyordered'] = $item->getQtyOrdered();
                $single_prd['price'] = $item->getPrice();
                $single_prd['rowtotal'] = $item->getRowTotal();
                $single_prd['simple_prd_id'] = $this->getProductIdBySku( $single_prd['sku'] );
                
                $stock_info = array();
                $stock_info = $this->getSourceQty( $item->getSku() );

                $source_list =  $this->getSourceName();   

                $product_data_single = array();
                array_push($product_data_single, $orderIncId);
                array_push($product_data_single, $order->getCreatedAt());
                array_push($product_data_single, $order->getState());
                array_push($product_data_single, $order->getStatus());
                array_push($product_data_single, $this->getCreditMemoId($order));
                array_push($product_data_single, $single_prd['qtyordered']);
                array_push($product_data_single, $single_prd['prd_id']);
                array_push($product_data_single, $single_prd['sku']);
                array_push($product_data_single, $single_prd['name']);
                array_push($product_data_single, $invoiceAll);
                array_push($product_data_single, $shipmentAll);
                
                $matchedSources = [];
                foreach ($source_list as $sourceCode => $sourceName) {
                    $matchedSources[$sourceName] = null;
                }

                foreach ($stock_info as $info) {
                    $sourceCode = $info['source_code'];
                    $sku = $info['sku'];
                    $quantity = $info['quantity'];

                    if (isset($source_list[$sourceCode])) {
                        $sourceName = $source_list[$sourceCode];
                        $matchedSources[$sourceName] += $quantity;
                    }
                }
                $product_data[] = array_merge($product_data_single , $matchedSources);
                $stock_data = array();
                $i++;                
            }
        }
        return $product_data;
    }

    /**
     * Get all invoice IDs for an order.
     *
     * @param \Magento\Sales\Model\Order $order
     * @return array
     */
    protected function getAllInvoiceIds($order)
    {
        $invoiceIds = [];
        foreach ($order->getInvoiceCollection() as $invoice) {
            $invoiceIds[] = $invoice->getIncrementId();
        }
        return $invoiceIds;
    }

    /**
     * Get all shipment IDs for an order.
     *
     * @param \Magento\Sales\Model\Order $order
     * @return array
     */
    protected function getAllShipmentIds($order)
    {
        $shipmentIds = [];
        foreach ($order->getShipmentsCollection() as $shipment) {
            $shipmentIds[] = $shipment->getIncrementId();
        }
        return $shipmentIds;
    }


    /**
     * Get the ID of the first credit memo associated with the order.
     *
     * @param \Magento\Sales\Model\Order $order
     * @return int|null
     */
    protected function getCreditMemoId($order)
    {
        $creditMemo = $order->getCreditmemosCollection()->getFirstItem();
        if ($creditMemo->getIncrementId()) {
            return $creditMemo->getIncrementId();
        }
        return null;
    }
    
    public function getSalesDate($startDate , $endDate){
        $i = 0;
        $order_all = [];
        $order_data = [];
        if($startDate > 0 && $endDate > 0){
            
            $order_Status_to_skip = ['canceled'];
            
            $searchCriteria = $this->searchCriteriaBuilder
                ->addFilter('store_id', 1, 'eq')
                ->addFilter('created_at', $startDate, 'gteq')
                ->addFilter('created_at', $endDate, 'lteq')
                ->create();

            $orders = $this->orderRepository->getList($searchCriteria)->getItems();
                
                if ($orders) {
                    
                    echo "Order IDs between $startDate and $endDate:<br>";
                   
                    foreach ($orders as $order) {
                        
                        $foundorderstatus = array_search($order->getStatus(), $order_Status_to_skip);
                        if ($foundorderstatus !== false) {
                            continue;
                        }
                        
                        $order_data['order_id'] = $order->getIncrementId();
                        $order_data['order_status'] = $order->getStatus();
                        
                        $ordered_products[] = $this->getOrderProducts( $order->getId() );
                        
                        $order_all[] = $order_data;
                        
                    }

                    $directory     = $this->filesystem->getDirectoryWrite(AppDirectoryList::VAR_DIR);
                    $foldername    = "sales";
                    if (!$directory->isDirectory($foldername)) {
                        $directory->create($foldername);
                    }  

                    date_default_timezone_set('Asia/Kolkata');   
                    $timestamp     = time(); 
                    $datestr       = date('Ymd_His', $timestamp); 

                    $fileName      = 'export_sales_'.$datestr.'.csv'; 
                    $filePath      = $foldername.'/' . $fileName;
                    $file          = $directory->openFile($filePath, 'w+');
                    // $data = ["Order", "Product Id", "Product Sku", "Product Name","Panchkula Office","Bhaseen Sports Pvt Ltd","Callaway Golf India Pvt Ltd","Chandigarh Golf Club","Custom Order","Default Warehouse ","Golfoy Warehouse ","Golfking Corporation","Brightex Synergizer India Pvt Ltd","J&B Golf","Kudu Fabrics","Karma","Returns Rack (G5)","Trinity Golf India Pvt. Ltd.","US Kids Golf India Pvt Ltd","Zaverchand Sports Private Limited","CGC","Stock Available","Experience studio"];
                    $data = ["Order","Order Date","State","Status","credit_memo_id","Ordered Qty","Product Id","Product Sku","Product Name","Invoices","Shipment"];
                    $source_list =  $this->getSourceName();  
                    $product_data = array_merge($data , $source_list);                  
                    
                    
                    $file->writeCsv($product_data);
                    $data = '';
                    foreach($ordered_products as $data){    
                        foreach($data as $value){
                            $file->writeCsv($value);
                        }                        
                    }
                    $file->close();

                } else {
                    echo "No orders found between $startDate and $endDate.";
                }
            return $order_all;
        }else{
            return false;
        }
    }

    public function getSalesOrderCronStatus(){
        $config_path = 'analysis/analysis/analysis_order_cron';
        return $this->scopeConfig->getValue(
            $config_path,
            \Magento\Store\Model\ScopeInterface::SCOPE_STORE
        );
    }
    public function getSourceQty($sku){
        $sourceStock = [];
        $searchCriteria = $this->searchCriteriaBuilder->addFilter('sku', $sku)->create();
        $sourceItemData = $this->sourceItems->getList($searchCriteria);
        if ($sourceItemData->getItems()) {
            foreach ($sourceItemData->getItems() as $sourceItem) {
                $sourceStock[] = $sourceItem->getData();
            }
            return $sourceStock;
        }
    }
}  