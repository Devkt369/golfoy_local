    ///////////////////////////////////////////

    public function prepareCsv($data)
        {               

            $limitcond = '';
            if(isset($data['limit'])){
                $limitcond = " LIMIT $data[limit]";
            }
            
            $attrsetcond = $this->getAttrsetCond($data['attrset']);

            if($data['ftype'] == 'topSold' || $data['ftype'] == 'topSoldSimple'){

                $productypecond = " AND oi.parent_item_id IS NULL";
                if($data['ftype'] == 'topSoldSimple'){
                    $productypecond = " AND oi.product_type = 'simple'";
                }
                $datecond = "";
                if(isset($data['stdate'])){
                    $datecond = " AND o.created_at BETWEEN '".$data['stdate']."' AND '".$data['enddate']."'";
                }
                if(isset($data['brandattr'])){
                    $brandselected = $data['brandattr'];
                    $sql = "SELECT 
                    cpe.sku AS product_sku,
                    cpev.value AS product_name,
                    SUM(oi.qty_ordered) AS total_qty_ordered
                    FROM 
                        sales_order AS o 
                    JOIN 
                        sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN 
                        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                    LEFT JOIN 
                        catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133 
                    JOIN 
                        catalog_product_entity_varchar AS cpev ON cpev.entity_id = cpe.entity_id AND cpev.attribute_id = 71
                    WHERE 
                        o.state IN ('complete','processing')
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        $productypecond
                        AND cpei.value = $brandselected
                        
                        $datecond
                        AND o.store_id = 1
                    GROUP BY
                        cpev.value,
                        cpe.sku
                    ORDER BY 
                        total_qty_ordered DESC $limitcond";

                }else{
                    $sql = "SELECT 
                    cpe.sku AS product_sku,
                    cpev.value AS product_name,
                    SUM(oi.qty_ordered) AS total_qty_ordered
                    FROM 
                        sales_order AS o 
                    JOIN 
                        sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN 
                        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                    JOIN 
                        catalog_product_entity_varchar AS cpev ON cpev.entity_id = cpe.entity_id AND cpev.attribute_id = 71
                    WHERE 
                        o.state IN ('complete','processing')
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND o.store_id = 1
                        $productypecond
                        $datecond
                    GROUP BY
                        cpev.value,
                        cpe.sku
                    ORDER BY 
                        total_qty_ordered DESC $limitcond";
                }
                

                    $result = $this->resource->getConnection()->fetchAll($sql);
                
                    $content = [];
                    if (!empty($result)) { 
                        $content[] = ["SKU", "Product Name", "Quantity"];
                       
                        foreach ($result as $item) { 
                            $total = floatval($item['total_qty_ordered']); 
                            $content[] = [$item['product_sku'], $item['product_name'], $total];
                        }
                        
                    }
                    $directory     = $this->filesystem->getDirectoryWrite(AppDirectoryList::VAR_DIR);
                    $foldername    = "analyse";
                    if (!$directory->isDirectory($foldername)) {
                        $directory->create($foldername);}  

                    date_default_timezone_set('Asia/Kolkata');   
                    $timestamp     = time(); 
                    $datestr       = date('Ymd_His', $timestamp); 

                    $fileName      = 'sales_'.$datestr.'.csv'; 
                    $filePath      = $foldername.'/' . $fileName;
                    $file          = $directory->openFile($filePath, 'w+');
                    
                    foreach($content as $cdata){            
                        $file->writeCsv($cdata);
                    }
                    $file->close();
                    return $fileName;

            }
            if($data['ftype'] == 'topSoldCat' || $data['ftype'] == 'topSoldCatSimple'){

                $catidsstr = implode(',', $data['attrset']);

                $productypecond = " AND oi.parent_item_id IS NULL";
                if($data['ftype'] == 'topSoldCatSimple'){
                    $productypecond = " AND oi.product_type = 'simple'";
                }
                $datecond = "";
                if(isset($data['stdate'])){
                    $datecond = " AND o.created_at BETWEEN '".$data['stdate']."' AND '".$data['enddate']."'";
                }
                if(isset($data['brandattr'])){
                    $brandselected = $data['brandattr'];
                    $sql = "SELECT 
                    cpe.sku AS product_sku,
                    cpev.value AS product_name,
                    SUM(oi.qty_ordered) AS total_qty_ordered
                    FROM 
                        sales_order AS o 
                    JOIN 
                        sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN 
                        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id
                    JOIN
                        catalog_category_product AS ccp ON ccp.product_id = oi.product_id
                    JOIN
                        catalog_category_entity_varchar AS ccev ON ccev.entity_id = ccp.category_id AND ccev.attribute_id = 41
                    LEFT JOIN 
                        catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133 
                    JOIN 
                        catalog_product_entity_varchar AS cpev ON cpev.entity_id = cpe.entity_id AND cpev.attribute_id = 71
                    WHERE 
                        o.state IN ('complete','processing')
                        AND ccp.category_id IN ($catidsstr)                        
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        $productypecond
                        AND cpei.value = $brandselected
                        
                        $datecond
                    GROUP BY
                        cpev.value,
                        cpe.sku
                    ORDER BY 
                        total_qty_ordered DESC $limitcond";

                }else{
                    $sql = "SELECT 
                    cpe.sku AS product_sku,
                    cpev.value AS product_name,
                    SUM(oi.qty_ordered) AS total_qty_ordered
                    FROM 
                        sales_order AS o 
                    JOIN 
                        sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN
                        catalog_category_product AS ccp ON ccp.product_id = oi.product_id
                    JOIN 
                        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id
                    JOIN
                        catalog_category_entity_varchar AS ccev ON ccev.entity_id = ccp.category_id AND ccev.attribute_id = 41
                    JOIN 
                        catalog_product_entity_varchar AS cpev ON cpev.entity_id = cpe.entity_id AND cpev.attribute_id = 71
                    WHERE 
                        o.state IN ('complete','processing')
                        AND ccp.category_id IN ($catidsstr)   
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        $productypecond
                        $datecond
                    GROUP BY
                        cpev.value,
                        cpe.sku
                    ORDER BY 
                        total_qty_ordered DESC $limitcond";
                }
                

                    $result = $this->resource->getConnection()->fetchAll($sql);
                
                    $content = [];
                    if (!empty($result)) { 
                        $content[] = ["SKU", "Product Name", "Quantity"];
                       
                        foreach ($result as $item) { 
                            $total = floatval($item['total_qty_ordered']); 
                            $content[] = [$item['product_sku'], $item['product_name'], $total];
                        }
                        
                    }
                    $directory     = $this->filesystem->getDirectoryWrite(AppDirectoryList::VAR_DIR);
                    $foldername    = "analyse";
                    if (!$directory->isDirectory($foldername)) {
                        $directory->create($foldername);}  

                    date_default_timezone_set('Asia/Kolkata');   
                    $timestamp     = time(); 
                    $datestr       = date('Ymd_His', $timestamp); 

                    $fileName      = 'sales_'.$datestr.'.csv'; 
                    $filePath      = $foldername.'/' . $fileName;
                    $file          = $directory->openFile($filePath, 'w+');
                    
                    foreach($content as $cdata){            
                        $file->writeCsv($cdata);
                    }
                    $file->close();
                    return $fileName;

            }
              

    }
    
    
    public function Weeklysales(){

        $sql = "SELECT
        aset.attribute_set_name,
        oi.name AS product_name,
        oi.price AS price,
        SUM(oi.qty_ordered - oi.qty_refunded - oi.qty_canceled) AS tqty,
        SUM(oi.row_total_incl_tax - oi.tax_amount - IFNULL(NULLIF(oi.mp_reward_discount, 0), 0) - IFNULL(NULLIF(oi.discount_amount, 0), 0) - IFNULL(NULLIF(oi.discount_refunded, 0), 0) - oi.amount_refunded) AS tamount,
        CASE WHEN o.pos_id IS NULL THEN 'website' ELSE CONCAT('POS ', o.pos_id) END AS source
    FROM
        sales_order_item AS oi
    JOIN
        sales_order AS o ON oi.order_id = o.entity_id    
    JOIN
        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id
    JOIN
        eav_attribute_set AS aset ON aset.attribute_set_id = cpe.attribute_set_id
    WHERE
        o.state IN ('complete', 'processing')
        AND oi.parent_item_id IS NULL
        AND oi.qty_ordered > (oi.qty_refunded + oi.qty_canceled)
        AND o.store_id = 1
        AND (
                    (o.pos_id IS NULL AND oi.row_total > 20)
                    OR (o.pos_id IS NOT NULL AND 1)
                )      
        AND o.created_at >= DATE_FORMAT(ADDDATE(NOW(), INTERVAL -((DAYOFWEEK(NOW()) + 5) % 7) - 7 DAY), '%Y-%m-%d 00:00:00')
        AND o.created_at <= DATE_FORMAT(ADDDATE(ADDDATE(NOW(), INTERVAL -((DAYOFWEEK(NOW()) + 5) % 7) - 7 DAY), INTERVAL 6 DAY), '%Y-%m-%d 23:59:59')       
    GROUP BY 
        attribute_set_name, product_name, source, price
    ORDER BY
        aset.attribute_set_name ASC, product_name ASC";

        
        $result = $this->resource->getConnection()->fetchAll($sql);
        
        $content = [];
        if (!empty($result)) { 
            $content[] = ["Attr Set Name" , "Product Name",  "Item Price (Exc Tax)", "Qty", "Total (Exc Tax)", "Source"];
           
            foreach ($result as $item) {               
                $content[] = [$item['attribute_set_name'], $item['product_name'], $item['price'], $item['tqty'], $item['tamount'], $item['source']];
            }
            
        }
        $directory     = $this->filesystem->getDirectoryWrite(AppDirectoryList::VAR_DIR);
        $foldername    = "wmsales";
        if (!$directory->isDirectory($foldername)) {
            $directory->create($foldername);}  

        date_default_timezone_set('Asia/Kolkata');   
        $currentDate = new \DateTime();
        $currentDate->modify('last week Monday');
        $oneWeekAgoFormatted = $currentDate->format('j-M');        
        
        $currentDate->add(new \DateInterval('P6D'));
        $yesterdayFormatted = $currentDate->format('j-M');

        $fileName      = 'Weekly_Summary_'.$oneWeekAgoFormatted.'_to_'. $yesterdayFormatted.'.csv'; 
        $filePath      = $foldername.'/' . $fileName;
        $file          = $directory->openFile($filePath, 'w+');
        
        foreach($content as $cdata){            
            $file->writeCsv($cdata);
        }
        $file->close();
        return $fileName;

    }

    public function Monthlysales(){

        $sql = "SELECT
        CASE WHEN o.pos_id IS NULL THEN 'website' ELSE CONCAT('POS ', o.pos_id) END AS source,
        aset.attribute_set_name,
        SUM(oi.qty_ordered - oi.qty_refunded - oi.qty_canceled) AS tqty,
        SUM(oi.row_total_incl_tax - oi.tax_amount - IFNULL(NULLIF(oi.mp_reward_discount, 0), 0) - IFNULL(NULLIF(oi.discount_amount, 0), 0) - IFNULL(NULLIF(oi.discount_refunded, 0), 0) - oi.amount_refunded) AS tamount
        FROM
            sales_order_item AS oi
        JOIN
            sales_order AS o ON oi.order_id = o.entity_id        
        JOIN
            catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id
        JOIN
            eav_attribute_set AS aset ON aset.attribute_set_id = cpe.attribute_set_id
        WHERE
        o.state IN ('complete','processing')
            AND oi.parent_item_id IS NULL
            AND oi.qty_ordered > (oi.qty_refunded + oi.qty_canceled)
            AND o.created_at >= DATE_FORMAT(NOW() - INTERVAL 1 MONTH, '%Y-%m-01 00:00:00')
            AND o.created_at <= DATE_FORMAT(CONCAT(LAST_DAY(NOW() - INTERVAL 1 MONTH), ' 23:59:59'), '%Y-%m-%d %H:%i:%s')           
            AND (
                    (o.pos_id IS NULL AND oi.row_total > 20)
                    OR (o.pos_id IS NOT NULL AND 1)
                )
            AND o.store_id = 1
        GROUP BY
            source, aset.attribute_set_name
        ORDER BY
            source DESC, aset.attribute_set_name ASC";

        
        $result = $this->resource->getConnection()->fetchAll($sql);
        
        $content = [];
        if (!empty($result)) { 
            $content[] = ["Source" , "Attr Set Name", "Qty", "Total (Exc Tax)"];
           
            foreach ($result as $item) {               
                $content[] = [$item['source'], $item['attribute_set_name'], $item['tqty'], $item['tamount']];
            }
            
        }
        $directory     = $this->filesystem->getDirectoryWrite(AppDirectoryList::VAR_DIR);
        $foldername    = "wmsales";
        if (!$directory->isDirectory($foldername)) {
            $directory->create($foldername);}  

        date_default_timezone_set('Asia/Kolkata');   
        $currentDate = new \DateTime();
        $previousMonth = $currentDate->modify('-1 month')->format('M_Y');

        $fileName      = $previousMonth.'_Sales_Report.csv'; 
        $filePath      = $foldername.'/' . $fileName;
        $file          = $directory->openFile($filePath, 'w+');
        
        foreach($content as $cdata){            
            $file->writeCsv($cdata);
        }
        $file->close();
        return $fileName;

    }
    
    
    public function MonthlysalesOrder(){

        $sql = "SELECT
        CASE WHEN o.pos_id IS NULL THEN 'website' ELSE CONCAT('POS ', o.pos_id) END AS source,
        COUNT(CASE WHEN o.subtotal_refunded IS NULL THEN 1 END) as total,
        SUM(CASE WHEN o.subtotal_refunded IS NULL THEN o.grand_total - o.tax_amount END) AS amount,
        COUNT(CASE WHEN o.subtotal_refunded IS NOT NULL THEN 1 END) as partial_total,
        SUM(CASE WHEN o.subtotal_refunded IS NOT NULL THEN 
           CASE WHEN o.pos_id IS NULL THEN o.grand_total - IFNULL(NULLIF(o.total_refunded, 0), 0) - o.tax_amount + IFNULL(NULLIF(o.tax_refunded, 0), 0) 
            ELSE  o.base_subtotal_incl_tax - IFNULL(NULLIF(o.total_refunded, 0), 0) END
            END) AS partial_amount
    FROM
        sales_order AS o  
    WHERE
        o.state IN ('complete','processing')
        AND o.created_at >= DATE_FORMAT(NOW() - INTERVAL 1 MONTH, '%Y-%m-01 00:00:00')
        AND o.created_at <= DATE_FORMAT(CONCAT(LAST_DAY(NOW() - INTERVAL 1 MONTH), ' 23:59:59'), '%Y-%m-%d %H:%i:%s')           
        AND (
            (o.pos_id IS NULL AND o.grand_total > 20)
            OR (o.pos_id IS NOT NULL AND 1)
        )
        AND o.store_id = 1
    GROUP BY
        source";

        
        $result = $this->resource->getConnection()->fetchAll($sql);
        
        $content = [];
        if (!empty($result)) { 
            $content[] = ["Source" , "Orders Count", "Total Invoiced Value", "Partial orders count", "Partial Invoiced Value"];
           
            foreach ($result as $item) {               
                $content[] = [$item['source'], $item['total'], $item['amount'], $item['partial_total'], $item['partial_amount']];
            }
            
        }
        $directory     = $this->filesystem->getDirectoryWrite(AppDirectoryList::VAR_DIR);
        $foldername    = "wmsales";
        if (!$directory->isDirectory($foldername)) {
            $directory->create($foldername);}  

        date_default_timezone_set('Asia/Kolkata');   
        $currentDate = new \DateTime();
        $previousMonth = $currentDate->modify('-1 month')->format('M_Y');

        $fileName      = $previousMonth.'_Order_Report.csv'; 
        $filePath      = $foldername.'/' . $fileName;
        $file          = $directory->openFile($filePath, 'w+');
        
        foreach($content as $cdata){            
            $file->writeCsv($cdata);
        }
        $file->close();
        return $fileName;

    }

    public function MonthlysalesOrderReturned(){

        $sql = "SELECT 
        oi.name AS name,
        oi.qty_refunded AS qty,
        oi.row_total_incl_tax  -IFNULL(NULLIF(oi.mp_reward_discount, 0), 0) - IFNULL(NULLIF(oi.discount_amount, 0), 0) AS tamount
    FROM
        sales_order AS o
    JOIN
        sales_order_item AS oi ON oi.order_id = o.entity_id
    WHERE
        oi.qty_refunded > 0
        AND oi.parent_item_id IS NULL
        AND o.created_at >= DATE_FORMAT(NOW() - INTERVAL 1 MONTH, '%Y-%m-01 00:00:00')
        AND o.store_id = 1
        AND o.created_at <= DATE_FORMAT(CONCAT(LAST_DAY(NOW() - INTERVAL 1 MONTH), ' 23:59:59'), '%Y-%m-%d %H:%i:%s')           
                AND (
                        (o.pos_id IS NULL AND o.grand_total > 20)
                        OR (o.pos_id IS NOT NULL AND 1)
                    )";

        
        $result = $this->resource->getConnection()->fetchAll($sql);
        
        $content = [];
