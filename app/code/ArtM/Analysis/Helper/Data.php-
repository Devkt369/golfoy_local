    public function getDaterange(){
        //$this->dateTime->gmtDate('Y-m-d H:i:s', strtotime('-24 hours'));
       // $start = $this->dateTime->gmtDate('Y-m-d H:i:s', strtotime('2021-01-01 00:00:00'));
       // $end   = $this->dateTime->gmtDate('Y-m-d H:i:s');
        $return     = [];   
        $start      = new \DateTime('2022-10-01 00:00:00');
        $starty     = new \DateTime('2020-01-01 00:00:00');
        $startq     = new \DateTime('2022-01-01 00:00:00');
        $end        = new \DateTime();

         // Annual intervals
        $interval = new \DateInterval('P1Y');
        $daterange = new \DatePeriod($starty, $interval, $end);
        
        $return['yearly'] = []; 
        foreach ($daterange as $date) {
            $k = $date->format("Y");
            $year_start = $date->format("Y-01-01 00:00:00");
            $year_end = $date->format("Y-12-31 23:59:59");
            if ($year_end > $end->format("Y-m-d h:i:s")) {
                $year_end = $end->format("Y-m-d h:i:s");
            }
            $return['yearly'][$k] = ['start'=>$year_start, 'end'=>$year_end]; 
        }
        $return['yearly'] = array_slice($return['yearly'], -3, null, true);
        
        // Monthly intervals
        $interval = new \DateInterval('P1M');
        $daterange = new \DatePeriod($start, $interval, $end);

        foreach ($daterange as $date) {
            $k = $date->format("Y-m");
            $startOfMonth = $date->format('Y-m-01 00:00:00');
            $endOfMonth = $date->format('Y-m-t 23:59:59');
            if ($endOfMonth > $end->format("Y-m-d h:i:s")) {
                $endOfMonth = $end->format("Y-m-d h:i:s");
            }
            $return['monthly'][$k] = ['start'=>$startOfMonth, 'end'=>$endOfMonth]; 
        }
        $return['monthly'] = array_slice($return['monthly'], -6, null, true);

        // Quarterly intervals
        $interval = new \DateInterval('P3M');
        $daterange = new \DatePeriod($startq, $interval, $end);
       
        foreach ($daterange as $date) {
            $k = $date->format("Y-m");
            $k = str_replace("-01", " Jan-Mar", $k);
            $k = str_replace("-04", " Apr-Jun", $k);
            $k = str_replace("-07", " Jul-Sep", $k);
            $k = str_replace("-10", " Oct-Dec", $k);
            $startQrtr = $date->format('Y-m-01 00:00:00');
            $obj = clone $date;
            $endObj = $obj->add(new \DateInterval('P2M'));            
            $endQrtr = $endObj->format('Y-m-t 23:59:59');
            if ($endQrtr > $end->format("Y-m-d h:i:s")) {
                $endQrtr = $end->format("Y-m-d h:i:s");
            }
            $return['quarterly'][$k] = ['start'=>$startQrtr, 'end'=>$endQrtr]; 
        }
        $return['quarterly'] = array_slice($return['quarterly'], -6, null, true);

        return $return;        
    }

    public function getDaterangeCurr(){
        //$this->dateTime->gmtDate('Y-m-d H:i:s', strtotime('-24 hours'));
       // $start = $this->dateTime->gmtDate('Y-m-d H:i:s', strtotime('2021-01-01 00:00:00'));
       // $end   = $this->dateTime->gmtDate('Y-m-d H:i:s');
        $return     = [];   
      
        $end        = new \DateTime();

         // Annual intervals
       
        $return['yearly'] = []; 
       
            $k = $end->format("Y");
            $year_start = $end->format("Y-01-01 00:00:00");
            $year_end = $end->format("Y-12-31 23:59:59");
            
            $return['yearly'][$k] = ['start'=>$year_start, 'end'=>$year_end]; 
      
        $return['yearly'] = array_slice($return['yearly'], -3, null, true);


        
        // Monthly intervals
       
            $k = $end->format("Y-m");
            $startOfMonth = $end->format('Y-m-01 00:00:00');
            $endOfMonth = $end->format('Y-m-t 23:59:59');
           
            $return['monthly'][$k] = ['start'=>$startOfMonth, 'end'=>$endOfMonth]; 



        // Quarterly intervals
           // echo $qrtr = ceil(date('n', strtotime($end->format("Y-m-d"))) / 3);
            $month = (ceil(date('n', strtotime($end->format("Y-m-d"))) / 3) - 1) * 3 + 1;
           $month = str_pad($month, 2, '0', STR_PAD_LEFT);
          // echo "-----------------------------------------";
           $yyyy = $end->format("Y");
            //$k = $end->format("Y-m");
            $k = $yyyy."-". $month;
            $k = str_replace("-01", " Jan-Mar", $k);
            $k = str_replace("-04", " Apr-Jun", $k);
            $k = str_replace("-07", " Jul-Sep", $k);
            $k = str_replace("-10", " Oct-Dec", $k);
            $startQrtr = $end->format("Y-$month-01 00:00:00");
            $obj = clone $end;
            $endObj = $obj->add(new \DateInterval('P2M'));            
            $endQrtr = $end->format('Y-m-t 23:59:59');
           
            $return['quarterly'][$k] = ['start'=>$startQrtr, 'end'=>$endQrtr]; 
       
       

        return $return;        
    }



    public function getAttrsetCond($attset){
        if(is_array($attset)){
            $attrsetcond = "AND (";
            $i = 0;
            foreach($attset as $v){
                $v = (int) $v;

                if($i > 0)
                $attrsetcond .= " OR ";

                $attrsetcond .= "cpe.attribute_set_id = $v";
                $i++;
            }
            $attrsetcond .= ")";
        }else{
            $attset = (int) $attset;
            $attrsetcond = "AND cpe.attribute_set_id = $attset";
        }
        return $attrsetcond;
    }

    public function getprodtypeCond($prodtype){
        $prodtypeCond =  " AND oi.product_type = 'simple'";
        if($prodtype == 'conf'){
            $prodtypeCond =  " AND oi.parent_item_id IS NULL";
        }
        return $prodtypeCond;
    }

    public function getAttributeArrayOptions($attset, $attr){
        $return = [''=> 'All Brands'];
        $attrsetcond = $this->getAttrsetCond($attset);
        $sql = "SELECT DISTINCT
            option_value_table.option_id AS option_value,
            option_label_table.value AS option_label
            FROM
                catalog_product_entity_int AS entity_int_table
            INNER JOIN
                eav_attribute_option_value AS option_label_table ON entity_int_table.value = option_label_table.option_id
            INNER JOIN
                eav_attribute_option AS option_value_table ON option_label_table.option_id = option_value_table.option_id
            INNER JOIN
                eav_attribute AS attribute_table ON attribute_table.attribute_id = entity_int_table.attribute_id
            INNER JOIN
                catalog_product_entity AS cpe ON cpe.entity_id = entity_int_table.entity_id
            WHERE
                attribute_table.attribute_id = $attr 
                $attrsetcond 
            ORDER BY `option_label` ASC";
        $result = $this->resource->getConnection()->fetchAll($sql);
        if (!empty($result)) {                    
            foreach ($result as $item) { 
                $return[$item['option_value']] = $item['option_label'];
            }            
        }
        return $return;
    }
    

    
    public function AttrSetRevenueTotal($label, $array=[]){
        if(!empty($array)){
            foreach($array as $k=> $v){

                $sqlt = "SELECT SUM(total) as totalc, SUM(tax) as ttax FROM (SELECT
                    cpe.attribute_set_id,
                    eas.attribute_set_name,
                    SUM( CASE
                        WHEN oi.base_amount_refunded > 0 THEN oi.row_total_incl_tax - oi.tax_amount - IFNULL(oi.base_amount_refunded, 0) 
                        ELSE oi.row_total_incl_tax - oi.tax_amount - IFNULL(oi.base_discount_amount, 0) - IFNULL(oi.mp_reward_discount, 0)
                    END
                    ) AS total,
                    SUM( CASE
                        WHEN oi.base_amount_refunded > 0 THEN oi.tax_amount - oi.tax_refunded 
                        ELSE oi.tax_amount
                    END
                    ) AS tax   
                    FROM
                        sales_order_item AS oi
                    JOIN
                        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id
                    JOIN
                        sales_order AS o ON o.entity_id = oi.order_id
                    JOIN
                        eav_attribute_set AS eas ON eas.attribute_set_id = cpe.attribute_set_id
                    WHERE
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    AND oi.parent_item_id IS NULL AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                    AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                    GROUP BY
                        cpe.attribute_set_id, eas.attribute_set_name  
                    ORDER BY `total` DESC) AS subq";
                
                $resultt = $this->resource->getConnection()->fetchAll($sqlt);
                $totals = $resultt[0]['totalc'];
                $ttax = $resultt[0]['ttax'];


                $sql = "SELECT
                    cpe.attribute_set_id,
                    eas.attribute_set_name,
                    SUM( CASE
                        WHEN oi.base_amount_refunded > 0 THEN oi.row_total_incl_tax - oi.tax_amount - IFNULL(oi.base_amount_refunded, 0) 
                        ELSE oi.row_total_incl_tax - oi.tax_amount - IFNULL(oi.base_discount_amount, 0) - IFNULL(oi.mp_reward_discount, 0)
                    END
                    ) AS total,
                    SUM( CASE
                        WHEN oi.base_amount_refunded > 0 THEN oi.tax_amount - oi.tax_refunded 
                        ELSE oi.tax_amount
                    END
                    ) AS tax   
                    FROM
                        sales_order_item AS oi
                    JOIN
                        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id
                    JOIN
                        sales_order AS o ON o.entity_id = oi.order_id
                    JOIN
                        eav_attribute_set AS eas ON eas.attribute_set_id = cpe.attribute_set_id
                    WHERE
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    AND oi.parent_item_id IS NULL AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                    AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                    GROUP BY
                        cpe.attribute_set_id, eas.attribute_set_name  
                    ORDER BY `total` DESC";
                
                $result = $this->resource->getConnection()->fetchAll($sql);
                if (!empty($result)) { 
                    echo " <div class = 'col-m-12'> <h4> $label ($k): $totals</h4> ";
                    echo "<table class='admin__table-primary analysis-data'><tr><th>Attr set Name</th><th>Total sale </th> <th>Tax</th></tr>";
                    foreach($result as $item) { 
                        echo "<tr><td>$item[attribute_set_name]</td><td>$item[total] </td><td>$item[tax] </td></tr>";
                    }
                    echo "</table></div>";
                }
            }
        }else{

            $sqlt = "SELECT SUM(total) as totalc, SUM(tax) as ttax FROM (SELECT
                    cpe.attribute_set_id,
                    eas.attribute_set_name,
                    SUM( CASE
                        WHEN oi.base_amount_refunded > 0 THEN oi.row_total_incl_tax - oi.tax_amount - IFNULL(oi.base_amount_refunded, 0) 
                        ELSE oi.row_total_incl_tax - oi.tax_amount - IFNULL(oi.base_discount_amount, 0) - IFNULL(oi.mp_reward_discount, 0)
                    END
                    ) AS total,
                    SUM( CASE
                        WHEN oi.base_amount_refunded > 0 THEN oi.tax_amount - oi.tax_refunded 
                        ELSE oi.tax_amount
                    END
                    ) AS tax   
                    FROM
                        sales_order_item AS oi
                    JOIN
                        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id
                    JOIN
                        sales_order AS o ON o.entity_id = oi.order_id
                    JOIN
                        eav_attribute_set AS eas ON eas.attribute_set_id = cpe.attribute_set_id
                    WHERE
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    AND oi.parent_item_id IS NULL AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                    GROUP BY
                        cpe.attribute_set_id, eas.attribute_set_name  
                    ORDER BY `total` DESC) AS subq";
                
                $resultt = $this->resource->getConnection()->fetchAll($sqlt);
                $totals = $resultt[0]['totalc'];
                $ttax = $resultt[0]['ttax'];

            $sql = "SELECT
            cpe.attribute_set_id,
            eas.attribute_set_name,
            SUM( CASE
                WHEN oi.base_amount_refunded > 0 THEN oi.row_total_incl_tax - oi.tax_amount - IFNULL(oi.base_amount_refunded, 0) 
                ELSE oi.row_total_incl_tax - oi.tax_amount - IFNULL(oi.base_discount_amount, 0) - IFNULL(oi.mp_reward_discount, 0)
            END
            ) AS total,
            SUM( CASE
                        WHEN oi.base_amount_refunded > 0 THEN oi.tax_amount - oi.tax_refunded 
                        ELSE oi.tax_amount
                    END
                    ) AS tax   
            FROM
                sales_order_item AS oi
            JOIN
                catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id
            JOIN
                sales_order AS o ON o.entity_id = oi.order_id
            JOIN
                eav_attribute_set AS eas ON eas.attribute_set_id = cpe.attribute_set_id
            WHERE
            o.state IN ('complete','processing')
            AND o.store_id = 1
            AND oi.parent_item_id IS NULL AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
            GROUP BY
                cpe.attribute_set_id, eas.attribute_set_name  
            ORDER BY `total` DESC";
        
        $result = $this->resource->getConnection()->fetchAll($sql);
        if (!empty($result)) { 
            echo "<h4> $label: $totals </h4>";
            echo "<table class='admin__table-primary analysis-data'><tr><th>Attr set Name </th><th>Total sale </th><th>Tax </th></tr>";
            foreach($result as $item) { 
                echo "<tr><td>$item[attribute_set_name]</td><td>$item[total] </td><td>$item[tax] </td></tr>";
            }
            echo "</table>";
        }

        }
    }


    ////////////////////// orders
    public function totalOrdersAlltype(){
        $data = [];

        $sql = "SELECT count(*) as total  FROM `sales_order` WHERE store_id = 1" ;
        $result = $this->resource->getConnection()->fetchAll($sql);
        if (!empty($result)) { 
            $data['total'] = floatval($result[0]['total']); 
        }

        $sql = "SELECT count(*) as total  FROM `sales_order` WHERE `state` = 'complete' AND store_id = 1 
        AND status NOT IN ('gift_card_against_adjustment', 'full_return_approved', 'order_resent_return_received', 'partial_refund_complete', 'partial_return_approved', 'pending_replaced_product_receive', 'pending_return_received', 'return', 'refund_issues', 'refunded_against_cancellation','canceled', 'cancelpending', 'Order cancellation requested')";
        $result = $this->resource->getConnection()->fetchAll($sql);
        if (!empty($result)) { 
            $data['complete'] = floatval($result[0]['total']); 
        }

        $sql = "SELECT count(*) as total  FROM `sales_order` WHERE `state` = 'canceled' AND store_id = 1 
        OR status IN ('canceled', 'cancelpending', 'Order cancellation requested')";
        $result = $this->resource->getConnection()->fetchAll($sql);
        if (!empty($result)) { 
            $data['canceled'] = floatval($result[0]['total']); 
        }
        
        $sql = "SELECT count(*) as total FROM
            (SELECT DISTINCT
                CONCAT(cust.entity_id, '_', DATE(cnclord.created_at)) AS uniqueid,
                (
                    SELECT COUNT(*)
                    FROM sales_order AS ord
                    WHERE ord.customer_id = cust.entity_id
                        AND ord.created_at > cnclord.created_at
                        AND ord.created_at <= DATE_ADD(cnclord.created_at, INTERVAL 5 DAY)
                        AND ord.state <> 'canceled'
                        AND ord.store_id = 1
                ) AS has_placed_order_after_cancel
            FROM
                sales_order AS cnclord
            INNER JOIN
                customer_entity AS cust ON cnclord.customer_id = cust.entity_id
            WHERE
                cnclord.state = 'canceled'
            HAVING
                has_placed_order_after_cancel > 0
            ) as subquery";

         $result = $this->resource->getConnection()->fetchAll($sql);
         if (!empty($result)) { 
             $data['reordered'] = floatval($result[0]['total']); 
         }



        /*$sql = "SELECT count(*) as total  FROM `sales_order` WHERE `state` IN ('complete', 'replacement_request')
        AND status IN ('full_replacement_approved', 'partial_replacement_approved', 'pending_replaced_product_receive', 'replacement_order', 'replacement_sent')";*/
        
        $sql = "SELECT COUNT(DISTINCT `coc`.`order_id`) AS total
        FROM `cancel_order_custom` AS `coc`
        INNER JOIN `sales_order` AS `so` ON `coc`.`order_id` = `so`.`entity_id`
        WHERE `coc`.`return_cancel_status` = 'replace' AND so.store_id = 1 ";
        
        
        $result = $this->resource->getConnection()->fetchAll($sql);
        if (!empty($result)) { 
            $data['replaced'] = floatval($result[0]['total']); 
        }

        /*$sql = "SELECT count(*) as total  FROM `sales_order` WHERE `state` IN ('complete', 'closed') 
        AND status IN ('gift_card_against_adjustment', 'full_return_approved', 'order_resent_return_received', 'partial_refund_complete', 'partial_return_approved', 'pending_replaced_product_receive', 'pending_return_received', 'return', 'refund_issues', 'refunded_against_cancellation')";*/
        
        $sql = "SELECT COUNT(DISTINCT `coc`.`order_id`) AS total
        FROM `cancel_order_custom` AS `coc`
        INNER JOIN `sales_order` AS `so` ON `coc`.`order_id` = `so`.`entity_id`
        WHERE `coc`.`return_cancel_status` = 'return' AND so.store_id = 1 ";
       
        $result = $this->resource->getConnection()->fetchAll($sql);
        if (!empty($result)) { 
            $data['returned'] = floatval($result[0]['total']); 
        }
        return $data;
       
    }
    
    public function totalOrdersAll($label, $array=[]){        

        if(!empty($array)){
            $datalabels = [];
            $datalabels[] = '';
            $datalbl = [];
            $datalbl['total']      = [];
            $datalbl['total'][]      ='<strong>Total</strong>';
            $datalbl['fullfilled'] = [];
            $datalbl['fullfilled'][]      ='<strong>Fullfilled</strong>';
            $datalbl['canceled'] = [];
            $datalbl['canceled'][]      ='<strong>Canceled</strong>';
            $datalbl['reordered'] = [];
            $datalbl['reordered'][]      ='<strong>Cancelled and reordered</strong>';
            $datalbl['replaced'] = [];
            $datalbl['replaced'][]      ='<strong>Replaced</strong>';
            $datalbl['returned'] = [];
            $datalbl['returned'][]      ='<strong>Return & Refunded</strong>';

            foreach($array as $k=> $v){

                $datalabels[] = $k;
                $sql = "SELECT count(*) as total  FROM `sales_order` WHERE created_at BETWEEN '".$v['start']."' AND '".$v['end']."'";
                $result = $this->resource->getConnection()->fetchAll($sql);              
                if (!empty($result)) { 
                    $total = floatval($result[0]['total']); 
                    $datalbl['total'][] =$total;                    
                }


                $sql = "SELECT count(*) as total  FROM `sales_order` WHERE (`state` = 'complete' 
                    AND status NOT IN ('gift_card_against_adjustment', 'full_return_approved', 'order_resent_return_received', 'partial_refund_complete', 'partial_return_approved', 'pending_replaced_product_receive', 'pending_return_received', 'return', 'refund_issues', 'refunded_against_cancellation','canceled', 'cancelpending', 'Order cancellation requested'))
                    AND store_id = 1 
                    AND created_at BETWEEN '".$v['start']."' AND '".$v['end']."'";
                $result = $this->resource->getConnection()->fetchAll($sql);
                if (!empty($result)) { 
                    $total = floatval($result[0]['total']); 
                    $datalbl['fullfilled'][] =$total;                    
                }


                $sql = "SELECT count(*) as total  FROM `sales_order` WHERE (`state` = 'canceled' 
                OR status IN ('canceled', 'cancelpending', 'Order cancellation requested'))
                AND store_id = 1 
                AND created_at BETWEEN '".$v['start']."' AND '".$v['end']."'";
                $result = $this->resource->getConnection()->fetchAll($sql);
                if (!empty($result)) { 
                    $total = floatval($result[0]['total']); 
                    $datalbl['canceled'][] =$total;                    
                }


                $sql = "SELECT count(*) as total FROM
                (SELECT DISTINCT
                    CONCAT(cust.entity_id, '_', DATE(cnclord.created_at)) AS uniqueid,
                    (
                        SELECT COUNT(*)
                        FROM sales_order AS ord
                        WHERE ord.customer_id = cust.entity_id
                            AND ord.created_at > cnclord.created_at
                            AND ord.created_at <= DATE_ADD(cnclord.created_at, INTERVAL 3 DAY)
                            AND ord.state <> 'canceled'
                            AND ord.store_id = 1
                    ) AS has_placed_order_after_cancel
                FROM
                    sales_order AS cnclord
                INNER JOIN
                    customer_entity AS cust ON cnclord.customer_id = cust.entity_id
                WHERE
                    cnclord.state = 'canceled'
                    AND cnclord.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                HAVING
                    has_placed_order_after_cancel > 0
                ) as subquery";
                $result = $this->resource->getConnection()->fetchAll($sql);
                if (!empty($result)) { 
                    $total = floatval($result[0]['total']); 
                    $datalbl['reordered'][] = $total;                    
                }


                /*$sql = "SELECT count(*) as total  FROM `sales_order` WHERE (`state` IN ('complete', 'replacement_request')
                AND status IN ('full_replacement_approved', 'partial_replacement_approved', 'pending_replaced_product_receive', 'replacement_order', 'replacement_sent'))
                AND created_at BETWEEN '".$v['start']."' AND '".$v['end']."'";*/

                $sql = "SELECT COUNT(DISTINCT `coc`.`order_id`) AS total
                FROM `cancel_order_custom` AS `coc`
                INNER JOIN `sales_order` AS `so` ON `coc`.`order_id` = `so`.`entity_id`
                WHERE `coc`.`return_cancel_status` = 'replace'
                AND so.store_id = 1
                AND `so`.`created_at` BETWEEN '".$v['start']."' AND '".$v['end']."'";

                $result = $this->resource->getConnection()->fetchAll($sql);
                if (!empty($result)) { 
                    $total = floatval($result[0]['total']); 
                    $datalbl['replaced'][] =$total;                    
                }


                /*$sql = "SELECT count(*) as total  FROM `sales_order` WHERE (`state` IN ('complete', 'closed')
                    AND status IN ('gift_card_against_adjustment', 'full_return_approved', 'order_resent_return_received', 'partial_refund_complete', 'partial_return_approved', 'pending_replaced_product_receive', 'pending_return_received', 'return', 'refund_issues', 'refunded_against_cancellation'))
                    AND created_at BETWEEN '".$v['start']."' AND '".$v['end']."'";*/

                $sql = "SELECT COUNT(DISTINCT `coc`.`order_id`) AS total
                FROM `cancel_order_custom` AS `coc`
                INNER JOIN `sales_order` AS `so` ON `coc`.`order_id` = `so`.`entity_id`
                WHERE `coc`.`return_cancel_status` = 'return'
                AND so.store_id = 1
                AND `so`.`created_at` BETWEEN '".$v['start']."' AND '".$v['end']."'";    


                $result = $this->resource->getConnection()->fetchAll($sql);
                if (!empty($result)) { 
                    $total = floatval($result[0]['total']); 
                    $datalbl['returned'][] =$total;                    
                }

                
            }
           echo "<div class= 'container row'><div class = col-m-12> <h4> $label  </h4>";
            echo "<table class='admin__table-primary analysis-data'><tr>";
           
                foreach( $datalabels as  $value){
                    echo "<th> $value </th>";
                }
                echo "<tr></tr>";
                foreach($datalbl['total'] as  $value){
                    echo "<td> $value </td>";
                }
                echo "<tr></tr>";
                foreach($datalbl['fullfilled'] as  $value){
                    echo "<td> $value </td>";
                }
                echo "<tr></tr>";
                foreach($datalbl['canceled'] as  $value){
                    echo "<td> $value </td>";
                }
                echo "<tr></tr>";
                foreach($datalbl['reordered'] as  $value){
                    echo "<td> $value </td>";
                }
                echo "<tr></tr>";
                foreach($datalbl['replaced'] as  $value){
                    echo "<td> $value </td>";
                }
                echo "<tr></tr>";
                foreach($datalbl['returned'] as  $value){
                    echo "<td> $value </td>";
                }
            echo "</tr></table></div></div>";

        }

    }



    
    ////////////////////// Shoes
    public function totalSold($attset, $label, $array=[], $brandselected =''){

        $attrsetcond = $this->getAttrsetCond($attset);

        if(!empty($array)){
            $keylabels = $keydata = [];
            foreach($array as $k=> $v){

                if($brandselected != ''){

                    $sql = "SELECT 
                SUM(oi.qty_ordered) AS total_qty_ordered
                FROM 
                    sales_order AS o 
                JOIN 
                    sales_order_item AS oi ON oi.order_id = o.entity_id 
                JOIN 
                    catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                LEFT JOIN 
                    catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133 
                WHERE 
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    /*AND oi.parent_item_id IS NULL*/
                    AND oi.product_type = 'simple' AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                    AND cpei.value = $brandselected                   
                    AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'";


                }else{                

                    $sql = "SELECT 
                    SUM(oi.qty_ordered) AS total_qty_ordered
                    FROM 
                        sales_order AS o 
                    JOIN 
                        sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN 
                        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                    WHERE 
                        o.state IN ('complete','processing')
                        AND o.store_id = 1
                        /*AND oi.parent_item_id IS NULL*/
                        AND oi.product_type = 'simple' AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled                   
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'";

                }


                $result = $this->resource->getConnection()->fetchAll($sql);
                
               
               // echo "<h4> $label ($k) : </h4>";
                if (!empty($result)) { 
                   
                    foreach ($result as $item) { 
                        $total = floatval($item['total_qty_ordered']); 
                        $keylabels[] = $k;
                        $keydata[] = $total;
                    }
                    
                }
                
            }
            echo "<div class= 'container row'><div class = col-m-12> <h4> $label  </h4>";
            echo "<table class='admin__table-primary analysis-data'><tr>";
                foreach($keylabels as  $value){
                    echo "<th> $value </th>";
                }
                echo "<tr></tr>";
                foreach($keydata as  $value){
                    echo "<td> $value </td>";
                }
            echo "</tr></table></div></div>";

        }else{

            if($brandselected != ''){
                $sql = "SELECT 
                SUM(oi.qty_ordered) AS total_qty_ordered
                FROM 
                    sales_order AS o 
                JOIN 
                    sales_order_item AS oi ON oi.order_id = o.entity_id 
                JOIN 
                    catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                LEFT JOIN 
                    catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133 
                WHERE 
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    /*AND oi.parent_item_id IS NULL*/
                    AND cpei.value = $brandselected         
                    AND oi.product_type = 'simple' AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled";

            }else{
                $sql = "SELECT 
                SUM(oi.qty_ordered) AS total_qty_ordered
                FROM 
                    sales_order AS o 
                JOIN 
                    sales_order_item AS oi ON oi.order_id = o.entity_id 
                JOIN 
                    catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                WHERE 
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    /*AND oi.parent_item_id IS NULL*/
                    AND oi.product_type = 'simple' AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled";
            }
            
            $result = $this->resource->getConnection()->fetchAll($sql);
            
            echo "<div class= 'container row'><div class = col-m-12>";
            //echo "<h4> $label </h4>";
            if (!empty($result)) { 
              
                foreach ($result as $item) { 
                    $total = floatval($item['total_qty_ordered']);  
                    echo "<h4> $label : $total </h4>"; 
                }
                
            }
            echo "</div></div>";
        }

    }



    public function totalAttrGraph($attset, $interval, $brandselected =''){
        
        if(is_array($attset)){
            $graphid = $attset[0];
        }else{
            $graphid = $attset;
        }
        $attrsetcond = $this->getAttrsetCond($attset);

        
        $labels = [];
        $gData  = [];
      
        $daterange = $this->getDaterange();
        $array = $daterange[$interval];
        if(!empty($array)){
            foreach($array as $k=> $v){
               
                if($brandselected != ''){
                    $sql = "SELECT 
                    SUM(oi.qty_ordered) AS total_qty_ordered
                    FROM 
                        sales_order AS o 
                    JOIN 
                        sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN 
                        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                    LEFT JOIN 
                    catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133 
                    WHERE 
                        o.state IN ('complete','processing')
                        AND o.store_id = 1
                        /*AND oi.parent_item_id IS NULL*/
                        AND oi.product_type = 'simple' AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND cpei.value = $brandselected
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'";
                }else{
                    $sql = "SELECT 
                    SUM(oi.qty_ordered) AS total_qty_ordered
                    FROM 
                        sales_order AS o 
                    JOIN 
                        sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN 
                        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                    WHERE 
                        o.state IN ('complete','processing')
                        AND o.store_id = 1
                        /*AND oi.parent_item_id IS NULL*/
                        AND oi.product_type = 'simple' AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'";
                }   
                $result = $this->resource->getConnection()->fetchAll($sql);
                if (!empty($result)) { 
                    $labels[] = $k; 
                         
                    foreach($result as $item) {   
                        $total = floatval($item['total_qty_ordered']); 
                        $gData['Quantity'][] = $total;
                    }
                }
               
            }

        }
        if($interval == 'monthly'){
            echo "<div class = col-m-12>";
        }else{
            echo "<div class = col-m-6>";
        }
        
        $labelsjsonenc = json_encode($labels);
        $labelsjsonvalue = htmlspecialchars($labelsjsonenc, ENT_QUOTES, 'UTF-8');
       
        
        $colors= ['#66CCCC'];
        $datasets = [];
        $i = 0;
        foreach($gData as $k => $v){
            $datasets[] =   [
                'label' => $k ,
                'data' => $v,
                'borderColor' => $colors[$i],
                'fill' => false,
                'tension' => 0.1
            ];
            $i++;
        } 
        $datasetsjsonenc = json_encode($datasets);
        $datasetsjsonvalue = htmlspecialchars($datasetsjsonenc, ENT_QUOTES, 'UTF-8');

        
        echo '<canvas class ="drawChartline" data-label = "'.$labelsjsonvalue.'" data-dataset = "'.$datasetsjsonvalue.'"  id="chart-total-'.$graphid.'-'.$interval.'"></canvas>';
        echo "</div>";

    }


    public function topSold($attset, $label, $array=[], $brandselected ='', $prodtype = 'simple'){
        
        $attrsetcond = $this->getAttrsetCond($attset);
        $prodtypeCond = $this->getprodtypeCond($prodtype);

        if(!empty($array)){
            foreach($array as $k=> $v){

                if($brandselected != ''){
                    $sql = "SELECT 
                    cpe.sku AS product_sku,
                    cpev.value AS product_name,
                    SUM(oi.qty_ordered) AS total_qty_ordered
                    FROM 
                        sales_order AS o 
                    JOIN 
                        sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN 
                        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                    LEFT JOIN 
                        catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133 
                    JOIN 
                        catalog_product_entity_varchar AS cpev ON cpev.entity_id = cpe.entity_id AND cpev.attribute_id = 71
                    WHERE 
                        o.state IN ('complete','processing')
                        AND o.store_id = 1
                        $prodtypeCond
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND cpei.value = $brandselected
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                    GROUP BY
                        cpev.value,
                        cpe.sku
                    ORDER BY 
                        total_qty_ordered DESC LIMIT 15";

                }else{
                    $sql = "SELECT 
                cpe.sku AS product_sku,
                cpev.value AS product_name,
                SUM(oi.qty_ordered) AS total_qty_ordered
                FROM 
                    sales_order AS o 
                JOIN 
                    sales_order_item AS oi ON oi.order_id = o.entity_id 
                JOIN 
                    catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                JOIN 
                    catalog_product_entity_varchar AS cpev ON cpev.entity_id = cpe.entity_id AND cpev.attribute_id = 71
                WHERE 
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    $prodtypeCond
                    AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                    AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                GROUP BY
                    cpev.value,
                    cpe.sku
                ORDER BY 
                    total_qty_ordered DESC LIMIT 15";

                }
                
                $result = $this->resource->getConnection()->fetchAll($sql);
                
                echo "<div class= 'container row'><div class = col-m-12>";
                echo "<h4> $label ($k) </h4>";
                if (!empty($result)) { 
                    echo "<table class='admin__table-primary analysis-data'><tr><th>Product Name</th><th>Qty ordered</th></tr>";
                    foreach ($result as $item) { 
                        $total = floatval($item['total_qty_ordered']);                  
                        echo "<tr><td>$item[product_name]</td><td>$total</td></tr>";
                    }
                    echo "</table>";
                }
                echo "</div></div>";
            }
        }else{
            if($brandselected != ''){
                $sql = "SELECT 
                cpe.sku AS product_sku,
                cpev.value AS product_name,
                SUM(oi.qty_ordered) AS total_qty_ordered
                FROM 
                    sales_order AS o 
                JOIN 
                    sales_order_item AS oi ON oi.order_id = o.entity_id 
                JOIN 
                    catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                LEFT JOIN 
                    catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133 
                JOIN 
                    catalog_product_entity_varchar AS cpev ON cpev.entity_id = cpe.entity_id AND cpev.attribute_id = 71
                WHERE 
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    $prodtypeCond
                    AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                    AND cpei.value = $brandselected
                GROUP BY
                    cpev.value,
                    cpe.sku
                ORDER BY 
                    total_qty_ordered DESC LIMIT 15";

            }else{            
                $sql = "SELECT 
                cpe.sku AS product_sku,
                cpev.value AS product_name,
                SUM(oi.qty_ordered) AS total_qty_ordered
                FROM 
                    sales_order AS o 
                JOIN 
                    sales_order_item AS oi ON oi.order_id = o.entity_id  
                JOIN 
                    catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                JOIN 
                    catalog_product_entity_varchar AS cpev ON cpev.entity_id = cpe.entity_id AND cpev.attribute_id = 71
                WHERE 
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    $prodtypeCond
                    AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                GROUP BY
                    cpev.value,
                    cpe.sku
                ORDER BY 
                    total_qty_ordered DESC LIMIT 15";
            }
            $result = $this->resource->getConnection()->fetchAll($sql);
            
            echo "<div style='margin-top:50px;' class = col-m-12>";
            echo "<h4> $label </h4>";


            //export data---------------------------
            echo "<div class = 'analyse-export'>";
            if(is_array($attset)){
                $attrsetstring = implode(",",$attset);
            }else{
                $attrsetstring = $attset;
            }  
            $ftype = 'topSold';
            if($prodtype == 'simple'){$ftype = 'topSoldSimple';}
            ?>
            Start date: <input type="date"  name="st_date" class="admin__control-date st_date"/>
            &nbsp; End date: <input type="date"  name="end_date" class="admin__control-date end_date"/>
            &nbsp; Limit: <input type="text" class="limitvalue" name= "limitvalue" type="text" style="width:100px;" />
            <input type= "hidden" class="ftype" name = "ftype" value ="<?php echo $ftype; ?>" />
            <input type= "hidden" class="brandattr" name = "brandattr" value ="<?php echo $brandselected; ?>" />
            <input type= "hidden" class="attrset" name = "attrset" value ="<?php echo $attrsetstring; ?>" />
            <button class="analyse-export-btn"> Create csv</button>
            <div class= "csvfilename" style="display:inline;"> </div>
            <?php            
            echo "</div>";    
            //-----------------------------------------  
            
            
            //echo "<h4> $label </h4>";
            if (!empty($result)) { 
                echo "<table class='admin__table-primary analysis-data'><tr><th>Product Name</th><th>Qty ordered</th></tr>";
                foreach ($result as $item) { 
                    $total = floatval($item['total_qty_ordered']);                  
                    echo "<tr><td>$item[product_name]</td><td>$total</td></tr>";
                }
                echo "</table>";
            }
            echo "</div>";
        }

    }
    
    public function topAttrSold($attset, $attr, $label, $array=[], $brandselected ='', $prodtype = 'simple'){        
        
        $attrsetcond = $this->getAttrsetCond($attset);
        $prodtypeCond = $this->getprodtypeCond($prodtype);
        $attr = (int) $attr;

        if(!empty($array)){
            foreach($array as $k=> $v){

                if($brandselected != ''){
                    $sql = "SELECT 
                    eavov.value AS option_label,
                    SUM(oi.qty_ordered) AS total_qty_ordered
                    FROM 
                        sales_order AS o 
                    JOIN 
                        sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN 
                        catalog_product_entity_int AS cpev ON cpev.entity_id = oi.product_id AND cpev.attribute_id = $attr
                    JOIN
                        eav_attribute_option_value AS eavov ON eavov.option_id = cpev.value AND eavov.store_id = 0
                    JOIN
                        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                    LEFT JOIN 
                        catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133 
                    WHERE
                        o.state IN ('complete','processing')
                        AND o.store_id = 1
                        $prodtypeCond
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND cpei.value = $brandselected
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                    GROUP BY
                        eavov.value HAVING SUM(oi.qty_ordered) > 0
                    ORDER BY
                        total_qty_ordered DESC LIMIT 15";
                }else{
                    $sql = "SELECT 
                    eavov.value AS option_label,
                    SUM(oi.qty_ordered) AS total_qty_ordered
                    FROM 
                        sales_order AS o 
                    JOIN 
                        sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN 
                        catalog_product_entity_int AS cpev ON cpev.entity_id = oi.product_id AND cpev.attribute_id = $attr
                    JOIN
                        eav_attribute_option_value AS eavov ON eavov.option_id = cpev.value AND eavov.store_id = 0
                    JOIN
                        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                    WHERE
                        o.state IN ('complete','processing')
                        AND o.store_id = 1
                        $prodtypeCond
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                    GROUP BY
                        eavov.value HAVING SUM(oi.qty_ordered) > 0
                    ORDER BY
                        total_qty_ordered DESC LIMIT 15";

                }

                $result = $this->resource->getConnection()->fetchAll($sql);
                
                echo "<div class = col-m-12>";
                echo "<h4 class='newblk'> $label ($k) </h4>";
                if (!empty($result)) { 
                    echo "<table class='admin__table-primary analysis-data'><tr><th>".$this->data['attrLabels'][$attr]."</th><th>Qty ordered</th></tr>";
                    foreach ($result as $item) {   
                        $total = floatval($item['total_qty_ordered']);             
                        echo "<tr><td>$item[option_label]</td><td>$total</td></tr>";
                    }
                    echo "</table>";
                }
                echo "</div>";
            }
        }else{
            if($brandselected != ''){
                $sql = "SELECT 
                eavov.value AS option_label,
                SUM(oi.qty_ordered) AS total_qty_ordered
                FROM 
                    sales_order AS o 
                JOIN 
                    sales_order_item AS oi ON oi.order_id = o.entity_id 
                JOIN 
                    catalog_product_entity_int AS cpev ON cpev.entity_id = oi.product_id AND cpev.attribute_id = $attr
                JOIN
                    eav_attribute_option_value AS eavov ON eavov.option_id = cpev.value AND eavov.store_id = 0
                JOIN
                    catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                LEFT JOIN 
                    catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133 
                WHERE
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    $prodtypeCond
                    AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                    AND cpei.value = $brandselected
                GROUP BY
                    eavov.value HAVING SUM(oi.qty_ordered) > 0
                ORDER BY
                    total_qty_ordered DESC LIMIT 15";

            }else{

                $sql = "SELECT 
                eavov.value AS option_label,
                SUM(oi.qty_ordered) AS total_qty_ordered
                FROM 
                    sales_order AS o 
                JOIN 
                    sales_order_item AS oi ON oi.order_id = o.entity_id 
                JOIN 
                    catalog_product_entity_int AS cpev ON cpev.entity_id = oi.product_id AND cpev.attribute_id = $attr
                JOIN
                    eav_attribute_option_value AS eavov ON eavov.option_id = cpev.value AND eavov.store_id = 0
                JOIN
                    catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                WHERE
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    $prodtypeCond
                    AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                GROUP BY
                    eavov.value HAVING SUM(oi.qty_ordered) > 0
                ORDER BY
                    total_qty_ordered DESC LIMIT 15";

            }
            $result = $this->resource->getConnection()->fetchAll($sql);
            
            echo "<div class = col-m-12>";
            echo "<h4 class='newblk'> $label </h4>";
            if (!empty($result)) { 
                echo "<table class='admin__table-primary analysis-data'><tr><th>".$this->data['attrLabels'][$attr]."</th><th>Qty ordered</th></tr>";
                foreach ($result as $item) {   
                    $total = floatval($item['total_qty_ordered']);             
                    echo "<tr><td>$item[option_label]</td><td>$total</td></tr>";
                }
                echo "</table>";
            }
            echo "</div>";
        }
    }

    public function topAttrSoldArray($attset, $attr, $brandselected ='', $prodtype = 'simple'){        
        
        $attrsetcond = $this->getAttrsetCond($attset);
        $prodtypeCond = $this->getprodtypeCond($prodtype);
        $attr = (int) $attr;

            $return = [];

            if($brandselected != ''){
                $sql = "SELECT 
                eavov.value AS option_label,
                SUM(oi.qty_ordered) AS total_qty_ordered
                FROM 
                    sales_order AS o 
                JOIN 
                    sales_order_item AS oi ON oi.order_id = o.entity_id 
                JOIN 
                    catalog_product_entity_int AS cpev ON cpev.entity_id = oi.product_id AND cpev.attribute_id = $attr
                JOIN
                    eav_attribute_option_value AS eavov ON eavov.option_id = cpev.value AND eavov.store_id = 0
                JOIN
                    catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                LEFT JOIN 
                    catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133
                WHERE
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    $prodtypeCond
                    AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                    AND cpei.value = $brandselected
                GROUP BY
                    eavov.value HAVING SUM(oi.qty_ordered) > 0
                ORDER BY
                    total_qty_ordered DESC LIMIT 5";
            }else{
                $sql = "SELECT 
                eavov.value AS option_label,
                SUM(oi.qty_ordered) AS total_qty_ordered
                FROM 
                    sales_order AS o 
                JOIN 
                    sales_order_item AS oi ON oi.order_id = o.entity_id 
                JOIN 
                    catalog_product_entity_int AS cpev ON cpev.entity_id = oi.product_id AND cpev.attribute_id = $attr
                JOIN
                    eav_attribute_option_value AS eavov ON eavov.option_id = cpev.value AND eavov.store_id = 0
                JOIN
                    catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                WHERE
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    $prodtypeCond
                    AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                GROUP BY
                    eavov.value HAVING SUM(oi.qty_ordered) > 0
                ORDER BY
                    total_qty_ordered DESC LIMIT 5";
            }
            
            $result = $this->resource->getConnection()->fetchAll($sql);
            
           
            if (!empty($result)) { 
              
                foreach ($result as $item) {   
                    $return[$item['option_label']] = 0;
                }
                
            }
            return $return;
    }


    public function topAttrArrayGraph($attset, $attr, $labelarray, $interval, $brandselected ='', $prodtype = 'simple'){
        
        if(is_array($attset)){
            $graphid = $attset[0];
        }else{
            $graphid = $attset;
        }
        $attrsetcond = $this->getAttrsetCond($attset);
        $prodtypeCond = $this->getprodtypeCond($prodtype);
        $labels = [];
        $gData  = [];
      
        $daterange = $this->getDaterange();
        $array = $daterange[$interval];
        if(!empty($array)){
            foreach($array as $k=> $v){
               
                if($brandselected != ''){
                    $sql = "SELECT 
                    eavov.value AS option_label,
                    SUM(oi.qty_ordered) AS total_qty_ordered
                    FROM 
                        sales_order AS o 
                    JOIN 
                        sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN 
                        catalog_product_entity_int AS cpev ON cpev.entity_id = oi.product_id AND cpev.attribute_id = $attr
                    JOIN
                        eav_attribute_option_value AS eavov ON eavov.option_id = cpev.value AND eavov.store_id = 0
                    JOIN
                        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                    LEFT JOIN 
                        catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133
                    WHERE
                        o.state IN ('complete','processing')
                        AND o.store_id = 1
                        $prodtypeCond
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND cpei.value = $brandselected
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                    GROUP BY
                        eavov.value HAVING SUM(oi.qty_ordered) > 0
                    ORDER BY
                        total_qty_ordered DESC LIMIT 15";

                }else{
                    $sql = "SELECT 
                    eavov.value AS option_label,
                    SUM(oi.qty_ordered) AS total_qty_ordered
                    FROM 
                        sales_order AS o 
                    JOIN 
                        sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN 
                        catalog_product_entity_int AS cpev ON cpev.entity_id = oi.product_id AND cpev.attribute_id = $attr
                    JOIN
                        eav_attribute_option_value AS eavov ON eavov.option_id = cpev.value AND eavov.store_id = 0
                    JOIN
                        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                    WHERE
                        o.state IN ('complete','processing')
                        AND o.store_id = 1
                        $prodtypeCond
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                    GROUP BY
                        eavov.value HAVING SUM(oi.qty_ordered) > 0
                    ORDER BY
                        total_qty_ordered DESC LIMIT 15";

                }
                
                $result = $this->resource->getConnection()->fetchAll($sql);
                if (!empty($result)) { 
                    $labels[] = $k;
                    //$tmparr = ['0-9999'=> 0,'10000-19999'=> 0,'20000-above'=> 0]; 
                    $tmparr  = $labelarray;
                    foreach($result as $item) {   
                        $total = floatval($item['total_qty_ordered']); 
                        $oplabel = $item['option_label'];
                        if(isset($tmparr[$oplabel])){
                            $tmparr[$oplabel] = $total;
                        }
                        
                    }                    
                    foreach($tmparr as  $r => $tmp) { 
                        $gData[$r][]  = $tmp ; 
                    }
                }
               
            }

        }
        
        echo "<div class = col-m-12>";
        
        
        $labelsjsonenc = json_encode($labels);
        $labelsjsonvalue = htmlspecialchars($labelsjsonenc, ENT_QUOTES, 'UTF-8');
       
        
        $colors= ['#4BC0C0','#ff6361','#003f5c','#8B4513','#663046','#1F456E','#564C4D','#7A4988','#13388E', 
        '#2F4F4F', '#524F81','#444C38', '#D06002','#FF9ABA','#FC4C4E','#9E4244', '#F3E5AB'];
        $datasets = [];
        $i = 0;
        foreach($gData as $k => $v){
            $datasets[] =   [
                'label' => $k ,
                'data' => $v,
                'borderColor' => $colors[$i],
                'fill' => false,
                'tension' => 0.1
            ];
            $i++;
        } 
        $datasetsjsonenc = json_encode($datasets);
        $datasetsjsonvalue = htmlspecialchars($datasetsjsonenc, ENT_QUOTES, 'UTF-8');

        
        echo '<canvas class ="drawChartline" data-label = "'.$labelsjsonvalue.'" data-dataset = "'.$datasetsjsonvalue.'"  id="chart-top'.$attr.'-'.$interval.'"></canvas>';
        echo "</div>";

    }

