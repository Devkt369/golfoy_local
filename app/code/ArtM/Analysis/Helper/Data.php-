                    }
                    $datarange['0-9999'][] = $tmparr['0-9999'];
                    $datarange['10000-14999'][] = $tmparr['10000-14999'];
                    $datarange['15000-19999'][] = $tmparr['15000-19999'];
                    $datarange['20000-above'][] = $tmparr['20000-above'];
                    
                }
                
            }
           echo "<div class= 'container row'><div class = col-m-12> <h4> $label  </h4>";
            echo "<table class='admin__table-primary analysis-data'><tr>";
           
                foreach( $datalabels as  $value){
                    echo "<th> $value </th>";
                }
                echo "<tr></tr>";
                foreach($datarange['0-9999'] as  $value){
                    echo "<td> $value </td>";
                }
                echo "<tr></tr>";
                foreach($datarange['10000-14999'] as  $value){
                    echo "<td> $value </td>";
                }
                echo "<tr></tr>";
                foreach($datarange['15000-19999'] as  $value){
                    echo "<td> $value </td>";
                }
                echo "<tr></tr>";
                foreach($datarange['20000-above'] as  $value){
                    echo "<td> $value </td>";
                }
            echo "</tr></table></div></div>";
        }else{  
            
            if($brandselected != ''){
                $sql = " SELECT 
                CASE 
                WHEN price_incl_tax >= 0 AND price_incl_tax < 10000 THEN '0-9999' 
                WHEN price_incl_tax >= 10000 AND price_incl_tax < 15000 THEN '10000-14999'
                WHEN price_incl_tax >= 15000 AND price_incl_tax < 20000 THEN '15000-19999'
                ELSE '20000-above' 
                END AS price_range,
                SUM(oi.qty_ordered) AS total_ordered
                FROM 
                    sales_order AS o 
                    JOIN sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                    LEFT JOIN 
                        catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133
                WHERE 
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                    AND cpei.value = $brandselected
                    AND oi.price_incl_tax IS NOT NULL
                GROUP BY 
