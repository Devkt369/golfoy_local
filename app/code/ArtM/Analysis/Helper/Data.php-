            $datarange['0-29999'][]      ='<strong>0-29999</strong>';
            $datarange['30000-39999'] = [];
            $datarange['30000-39999'][]      ='<strong>30000-39999</strong>';
            $datarange['40000-49999'] = [];
            $datarange['40000-49999'][]      ='<strong>40000-49999</strong>';
            $datarange['50000-above'] = [];
            $datarange['50000-above'][]      ='<strong>50000-above</strong>';

            foreach($array as $k=> $v){

                if($brandselected != ''){
                    $sql = " SELECT 
                    CASE 
                    WHEN price_incl_tax >= 0 AND price_incl_tax < 30000 THEN '0-29999' 
                    WHEN price_incl_tax >= 30000 AND price_incl_tax < 40000 THEN '30000-39999'
                    WHEN price_incl_tax >= 40000 AND price_incl_tax < 50000 THEN '40000-49999'
                    ELSE '50000-above' 
                    END AS price_range,
                    SUM(oi.qty_ordered) AS total_ordered
                    FROM 
