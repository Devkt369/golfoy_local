    ////////////////////// gloves

    
    
    public function PRangeAttrSoldGloves($attset, $label, $array=[], $brandselected =''){        
        
        $attrsetcond = $this->getAttrsetCond($attset);

        if(!empty($array)){           
            $datalabels = [];
            $datalabels[] = '';
            $datarange = [];
            $datarange['0-999']      = [];
            $datarange['0-999'][]      ='<strong>0-999</strong>';
            $datarange['1000-1499'] = [];
            $datarange['1000-1499'][]      ='<strong>1000-1499</strong>';
            $datarange['1500-1999'] = [];
            $datarange['1500-1999'][]      ='<strong>1500-1999</strong>';
            $datarange['2000-above'] = [];
            $datarange['2000-above'][]      ='<strong>2000-above</strong>';

            foreach($array as $k=> $v){

                if($brandselected != ''){
                    $sql = " SELECT 
                    CASE 
                    WHEN price_incl_tax >= 0 AND price_incl_tax < 1000 THEN '0-999' 
                    WHEN price_incl_tax >= 1000 AND price_incl_tax < 1500 THEN '1000-1499'
                    WHEN price_incl_tax >= 1500 AND price_incl_tax < 2000 THEN '1500-1999'
                    ELSE '2000-above' 
                    END AS price_range,
                    SUM(oi.qty_ordered) AS total_ordered
                    FROM 
                        sales_order AS o 
                        JOIN sales_order_item AS oi ON oi.order_id = o.entity_id 
                        JOIN catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                        LEFT JOIN 
                        catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133
                    WHERE 
                        o.state IN ('complete','processing') 
                        AND o.store_id = 1
                        AND oi.price_incl_tax IS NOT NULL
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND cpei.value = $brandselected
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                    GROUP BY 
