        }
    }

    
    public function getOnClearance($attset, $label,  $array=[], $brandselected =''){
        
        $attrsetcond = $this->getAttrsetCond($attset);

        if(!empty($array)){
            
            $keylabels[] = '';
            $dataClearance[] = '<strong>On Clearance</strong>';
            $dataNormal[] = '<strong>Normal</strong>';
            foreach($array as $k=> $v){

                if($brandselected != ''){
                    $sql = "SELECT 
                    SUM(CASE WHEN oi.on_clearance = 1 THEN oi.qty_ordered ELSE 0 END) as clearance,
                    SUM(CASE WHEN oi.on_clearance = 0 THEN oi.qty_ordered ELSE 0 END) as normal
                    FROM 
                        sales_order AS o 
                    JOIN 
                        sales_order_item AS oi ON oi.order_id = o.entity_id  
                    JOIN
                        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                    LEFT JOIN 
                        catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133 
                    WHERE
                        o.state IN ('complete','processing')
                        AND o.store_id = 1
                        AND oi.product_type = 'simple'
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND cpei.value = $brandselected
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'";

                }else{
                    $sql = "SELECT 
                    SUM(CASE WHEN oi.on_clearance = 1 THEN oi.qty_ordered ELSE 0 END) as clearance,
                    SUM(CASE WHEN oi.on_clearance = 0 THEN oi.qty_ordered ELSE 0 END) as normal
                    FROM 
                        sales_order AS o 
                    JOIN 
                        sales_order_item AS oi ON oi.order_id = o.entity_id  
                    JOIN
                        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                    WHERE
                        o.state IN ('complete','processing')
                        AND o.store_id = 1
                        AND oi.product_type = 'simple'
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'";

                }
                

                $result = $this->resource->getConnection()->fetchAll($sql);
                
               
                if (!empty($result)) {                    
                    foreach ($result as $item) {   
                        $totalClearnce   = floatval($item['clearance']);    
                        $totalNormal     = floatval($item['normal']);          
                        $keylabels[]     = $k;
                        $dataNormal[]    = $totalNormal;
                        $dataClearance[] = $totalClearnce;
                    }                   
                }
                
            }
            echo "<div class= 'container row'><div class = col-m-12> <h4> $label  </h4>";
            echo "<table class='admin__table-primary analysis-data'><tr>";
                foreach($keylabels as  $value){
                    echo "<th> $value </th>";
                }
                echo "<tr></tr>";
                foreach($dataNormal as  $value){
                    echo "<td> $value </td>";
                }
                echo "<tr></tr>";
                foreach($dataClearance as  $value){
                    echo "<td> $value </td>";
                }
            echo "</tr></table></div></div>";
        }else{



            if($brandselected != ''){
                $sql = "SELECT 
                SUM(CASE WHEN oi.on_clearance = 1 THEN oi.qty_ordered ELSE 0 END) as clearance,
                SUM(CASE WHEN oi.on_clearance = 0 THEN oi.qty_ordered ELSE 0 END) as normal
                FROM 
                    sales_order AS o 
                JOIN 
                    sales_order_item AS oi ON oi.order_id = o.entity_id  
                JOIN
                catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                LEFT JOIN 
                    catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133
                WHERE
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                    /*AND oi.parent_item_id IS NULL*/
                    AND cpei.value = $brandselected
                    AND oi.product_type = 'simple'";

            }else{
                $sql = "SELECT 
                SUM(CASE WHEN oi.on_clearance = 1 THEN oi.qty_ordered ELSE 0 END) as clearance,
                SUM(CASE WHEN oi.on_clearance = 0 THEN oi.qty_ordered ELSE 0 END) as normal
                FROM 
                    sales_order AS o 
                JOIN 
                    sales_order_item AS oi ON oi.order_id = o.entity_id  
                JOIN
                catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                WHERE
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                    /*AND oi.parent_item_id IS NULL*/
                    AND oi.product_type = 'simple'";

            }
            
            $result = $this->resource->getConnection()->fetchAll($sql);
            
            echo "<div class = col-m-12>";
            echo "<h4 class='newblk'> $label </h4>";
            if (!empty($result)) { 
                echo "<table class='admin__table-primary analysis-data'><tr><th> Sale Type </th><th>Qty ordered</th></tr>";
                    foreach ($result as $item) {   
                        $totalClearnce = floatval($item['clearance']);    
                        $totalNormal = floatval($item['normal']);           
                        echo "<tr><td>Clearance</td><td>$totalClearnce</td></tr>";
                        echo "<tr><td>Normal</td><td>$totalNormal</td></tr>";
                    }
                    echo "</table>";
            }
            echo "</div>";
        }

    }

    public function ClearanceGraph($attset, $interval, $brandselected =''){
        
        if(is_array($attset)){
            $graphid = $attset[0];
        }else{
            $graphid = $attset;
        }
        $attrsetcond = $this->getAttrsetCond($attset);
        
        $labels = [];
        $gData  = [];
      
        $daterange = $this->getDaterange();
        $array = $daterange[$interval];
        if(!empty($array)){
            foreach($array as $k=> $v){
               
                if($brandselected != ''){
                    $sql = "SELECT 
                    SUM(CASE WHEN oi.on_clearance = 1 THEN 1 ELSE 0 END) as clearance,
                    SUM(CASE WHEN oi.on_clearance = 0 THEN 1 ELSE 0 END) as normal
                    FROM 
                        sales_order AS o 
                    JOIN 
                        sales_order_item AS oi ON oi.order_id = o.entity_id  
                    JOIN
                    catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                    LEFT JOIN 
                        catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133 
                    WHERE
                        o.state IN ('complete','processing')
                        AND o.store_id = 1
                        AND oi.product_type = 'simple'
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND cpei.value = $brandselected
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'";

                }else{
                    $sql = "SELECT 
                    SUM(CASE WHEN oi.on_clearance = 1 THEN 1 ELSE 0 END) as clearance,
                    SUM(CASE WHEN oi.on_clearance = 0 THEN 1 ELSE 0 END) as normal
                    FROM 
                        sales_order AS o 
                    JOIN 
                        sales_order_item AS oi ON oi.order_id = o.entity_id  
                    JOIN
                    catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                    WHERE
                        o.state IN ('complete','processing') 
                        AND o.store_id = 1
                        AND oi.product_type = 'simple'
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'";

                }
               
                $result = $this->resource->getConnection()->fetchAll($sql);
                if (!empty($result)) { 
                    $labels[] = $k;  
                    
                         $tmparr = ['Clearance'=> 0,'Normal'=> 0]; 
                    
                    
                         
                    foreach($result as $item) {   
                        $totalClearnce = floatval($item['clearance']);    
                        $totalNormal = floatval($item['normal']);  
                        $gData['Clearance'][] = $totalClearnce;
                        $gData['Normal'][] = $totalNormal;
                    }
                   
                   
                }
               
            }

        }
        if($interval == 'monthly'){
            echo "<div class = col-m-12>";
        }else{
            echo "<div class = col-m-6>";
        }
        
        $labelsjsonenc = json_encode($labels);
        $labelsjsonvalue = htmlspecialchars($labelsjsonenc, ENT_QUOTES, 'UTF-8');
       
        $colors= ['#4BC0C0','#ff6361','#003f5c'];
      
        
        $datasets = [];
        $i = 0;
        foreach($gData as $k => $v){
            $datasets[] =   [
                'label' => $k ,
                'data' => $v,
                'borderColor' => $colors[$i],
                'fill' => false,
                'tension' => 0.1
            ];
            $i++;
        } 
        $datasetsjsonenc = json_encode($datasets);
        $datasetsjsonvalue = htmlspecialchars($datasetsjsonenc, ENT_QUOTES, 'UTF-8');

        
        echo '<canvas class ="drawChartline" data-label = "'.$labelsjsonvalue.'" data-dataset = "'.$datasetsjsonvalue.'"  id="chart-clearance-'.$graphid.'-'.$interval.'"></canvas>';
        echo "</div>";

    }

    public function topAttrGraph($attset, $attr, $interval, $brandselected ='', $prodtype = 'simple'){
       
        if(is_array($attset)){
            $graphid = $attset[0];
        }else{
            $graphid = $attset;
        }
        $attrsetcond = $this->getAttrsetCond($attset);
        $prodtypeCond = $this->getprodtypeCond($prodtype);
        $labels = [];
        $gData  = [];
      
        $daterange = $this->getDaterange();
        $array = $daterange[$interval];
        if(!empty($array)){
            foreach($array as $k=> $v){
               
                if($brandselected != ''){
                    $sql = "SELECT 
                    eavov.value AS option_label,
                    SUM(oi.qty_ordered) AS total_qty_ordered
                    FROM 
                        sales_order AS o 
                    JOIN 
                        sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN 
                        catalog_product_entity_int AS cpev ON cpev.entity_id = oi.product_id AND cpev.attribute_id = $attr
                    JOIN
                        eav_attribute_option_value AS eavov ON eavov.option_id = cpev.value AND eavov.store_id = 0
                    JOIN
                        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                    LEFT JOIN 
                        catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133 
                    WHERE
                        o.state IN ('complete','processing') 
                        AND o.store_id = 1
                        $prodtypeCond
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND cpei.value = $brandselected
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                    GROUP BY
                        eavov.value HAVING SUM(oi.qty_ordered) > 0
                    ORDER BY
                        option_label DESC LIMIT 15";

                }else{
                    $sql = "SELECT 
                    eavov.value AS option_label,
                    SUM(oi.qty_ordered) AS total_qty_ordered
                    FROM 
                        sales_order AS o 
                    JOIN 
                        sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN 
                        catalog_product_entity_int AS cpev ON cpev.entity_id = oi.product_id AND cpev.attribute_id = $attr
                    JOIN
                        eav_attribute_option_value AS eavov ON eavov.option_id = cpev.value AND eavov.store_id = 0
                    JOIN
                        catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                    WHERE
                        o.state IN ('complete','processing') 
                        AND o.store_id = 1
                        $prodtypeCond
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                    GROUP BY
                        eavov.value HAVING SUM(oi.qty_ordered) > 0
                    ORDER BY
                        option_label DESC LIMIT 15";

                }
                
                $result = $this->resource->getConnection()->fetchAll($sql);
                if (!empty($result)) { 
                    $labels[] = $k;  
                    if($attr == '241'){
                         $tmparr = ['Yes'=> 0,'No'=> 0]; 
                    }else{
                        $tmparr = ['Spikeless'=> 0,'Spiked'=> 0,'Hybrid'=> 0]; 
                    }
                    
                         
                    foreach($result as $item) {   
                        $total = floatval($item['total_qty_ordered']); 
                        $range = $item['option_label'];
                        $tmparr[$range] = $total;
                    }
                    foreach($tmparr as  $r => $tmp) { 
                        $gData[$r][]  = $tmp ; 
                    }
                }
               
            }

        }
        if($interval == 'monthly'){
            echo "<div class = col-m-12>";
        }else{
            echo "<div class = col-m-6>";
        }
        
        $labelsjsonenc = json_encode($labels);
        $labelsjsonvalue = htmlspecialchars($labelsjsonenc, ENT_QUOTES, 'UTF-8');
       
        $colors= ['#4BC0C0','#ff6361','#003f5c'];
        
        $datasets = [];
        $i = 0;
        foreach($gData as $k => $v){
            
            $datasets[] =   [
                'label' => $k ,
                'data' => $v,
                'borderColor' => $colors[$i],
                'fill' => false,
                'tension' => 0.1
            ];
            $i++;
        } 
        $datasetsjsonenc = json_encode($datasets);
        $datasetsjsonvalue = htmlspecialchars($datasetsjsonenc, ENT_QUOTES, 'UTF-8');

        
        echo '<canvas class ="drawChartline" data-label = "'.$labelsjsonvalue.'" data-dataset = "'.$datasetsjsonvalue.'"  id="chart-'.$graphid.'-'.$attr.'-'.$interval.'"></canvas>';
        echo "</div>";

    }













    ////////////////////// tshirts

    
    
    public function PRangeAttrSoldTshirts($attset, $label, $array=[], $brandselected =''){        
        
        $attrsetcond = $this->getAttrsetCond($attset);

        if(!empty($array)){           
            $datalabels = [];
            $datalabels[] = '';
            $datarange = [];
            $datarange['0-1000']      = [];
            $datarange['0-1000'][]      ='<strong>0-1000</strong>';
            $datarange['1001-2000'] = [];
            $datarange['1001-2000'][]      ='<strong>1001-2000</strong>';
            $datarange['2001-above'] = [];
            $datarange['2001-above'][]      ='<strong>2001-above</strong>';

            foreach($array as $k=> $v){

                if($brandselected != ''){
                    $sql = " SELECT 
                    CASE 
                    WHEN price_incl_tax >= 0 AND price_incl_tax < 1001 THEN '0-1000' 
                    WHEN price_incl_tax >= 1001 AND price_incl_tax < 2001 THEN '1001-2000'
                    ELSE '2001-above' 
                    END AS price_range,
                    SUM(oi.qty_ordered) AS total_ordered
                    FROM 
                        sales_order AS o 
                        JOIN sales_order_item AS oi ON oi.order_id = o.entity_id 
                        JOIN catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                        LEFT JOIN 
                        catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133
                    WHERE 
                        o.state IN ('complete','processing') 
                        AND o.store_id = 1
                        AND oi.price_incl_tax IS NOT NULL
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND cpei.value = $brandselected
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                    GROUP BY 
                        price_range
                    ORDER BY price_range";

                }else{
                    $sql = " SELECT 
                    CASE 
                    WHEN price_incl_tax >= 0 AND price_incl_tax < 1001 THEN '0-1000' 
                    WHEN price_incl_tax >= 1001 AND price_incl_tax < 2001 THEN '1001-2000'
                    ELSE '2001-above' 
                    END AS price_range,
                    SUM(oi.qty_ordered) AS total_ordered
                    FROM 
                        sales_order AS o 
                        JOIN sales_order_item AS oi ON oi.order_id = o.entity_id 
                        JOIN catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                    WHERE 
                        o.state IN ('complete','processing')
                        AND o.store_id = 1
                        AND oi.price_incl_tax IS NOT NULL
                        AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                        AND o.created_at BETWEEN '".$v['start']."' AND '".$v['end']."'
                    GROUP BY 
                        price_range
                    ORDER BY price_range";

                }
                
                $result = $this->resource->getConnection()->fetchAll($sql);
                
              
                if (!empty($result)) { 
                    $datalabels[] = $k;
                    $tmparr = ['0-1000'=>0, '1001-2000'=>0,'2001-above'=>0];
                 
                    foreach ($result as $item) { 
                        $total = floatval($item['total_ordered']);   
                        $tmparr[$item['price_range']] = $total;  
                    }
                    $datarange['0-1000'][] = $tmparr['0-1000'];
                    $datarange['1001-2000'][] = $tmparr['1001-2000'];
                    $datarange['2001-above'][] = $tmparr['2001-above'];                    
                }
                
            }
           echo "<div class= 'container row'><div class = col-m-12> <h4> $label  </h4>";
            echo "<table class='admin__table-primary analysis-data'><tr>";
           
                foreach( $datalabels as  $value){
                    echo "<th> $value </th>";
                }
                echo "<tr></tr>";
                foreach($datarange['0-1000'] as  $value){
                    echo "<td> $value </td>";
                }
                echo "<tr></tr>";
                foreach($datarange['1001-2000'] as  $value){
                    echo "<td> $value </td>";
                }
                echo "<tr></tr>";
                foreach($datarange['2001-above'] as  $value){
                    echo "<td> $value </td>";
                }
            echo "</tr></table></div></div>";
        }else{   
            
            if($brandselected != ''){
                 
                $sql = " SELECT 
                CASE 
                WHEN price_incl_tax >= 0 AND price_incl_tax < 1001 THEN '0-1000' 
                WHEN price_incl_tax >= 1001 AND price_incl_tax < 2001 THEN '1001-2000'
                ELSE '2001-above' 
                END AS price_range,
                SUM(oi.qty_ordered) AS total_ordered
                FROM 
                    sales_order AS o 
                    JOIN sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                    LEFT JOIN 
                    catalog_product_entity_int AS cpei ON cpei.entity_id = cpe.entity_id AND  cpei.attribute_id = 133
                WHERE 
                    o.state IN ('complete','processing') 
                    AND o.store_id = 1
                    AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                    AND cpei.value = $brandselected
                    AND oi.price_incl_tax IS NOT NULL
                GROUP BY 
                    price_range
                ORDER BY price_range";
            }else{
                $sql = " SELECT 
                CASE 
                WHEN price_incl_tax >= 0 AND price_incl_tax < 1001 THEN '0-1000' 
                WHEN price_incl_tax >= 1001 AND price_incl_tax < 2001 THEN '1001-2000'
                ELSE '2001-above' 
                END AS price_range,
                SUM(oi.qty_ordered) AS total_ordered
                FROM 
                    sales_order AS o 
                    JOIN sales_order_item AS oi ON oi.order_id = o.entity_id 
                    JOIN catalog_product_entity AS cpe ON cpe.entity_id = oi.product_id $attrsetcond
                WHERE 
                    o.state IN ('complete','processing')
                    AND o.store_id = 1
                    AND oi.qty_ordered <> oi.qty_refunded AND oi.qty_ordered <> oi.qty_canceled
                    AND oi.price_incl_tax IS NOT NULL
                GROUP BY 
                    price_range
                ORDER BY price_range";

            }
            
            $result = $this->resource->getConnection()->fetchAll($sql);
            
            echo "<div class = col-m-12>";
            echo "<h4 class='newblk'> $label </h4>";
            if (!empty($result)) { 
                echo "<table class='admin__table-primary analysis-data'><tr><th>Price Range</th><th>Qty ordered</th></tr>";
                foreach ($result as $item) {   
                    $total = floatval($item['total_ordered']);             
                    echo "<tr><td>$item[price_range]</td><td>$total</td></tr>";
                }
                echo "</table>";
            }
            echo "</div>";
        }
    }

