        return $fileName;

    }


    public function MonthlysalesOrderReplaced(){

        $sql = "SELECT oi.name, oi.qty_ordered  FROM `cancel_order_custom` AS rr 
        LEFT JOIN sales_order_item AS oi on rr.product_ids = oi.product_id AND rr.order_id = oi.order_id
        WHERE `return_cancel_status` = 'replace'
        AND oi.qty_ordered <> oi.qty_refunded
        AND oi.created_at >= DATE_FORMAT(NOW() - INTERVAL 1 MONTH, '%Y-%m-01 00:00:00')
