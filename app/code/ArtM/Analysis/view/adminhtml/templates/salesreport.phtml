<?php
$helper = $this->helper('ArtM\Analysis\Helper\Data');

// Get all files in the directory
$directoryList = $helper->getFilesInDirectory();

// Sort the file list in descending order
arsort($directoryList);

// Define the number of items per page
$itemsPerPage = 10;

// Get the current page from the URL parameter (default to 1 if not set)
$current_page = isset($_GET['page']) ? max(1, intval($_GET['page'])) : 1;

// Use array_slice to extract a portion of the file list based on the current page
$currentPageFiles = array_slice($directoryList, ($current_page - 1) * $itemsPerPage, $itemsPerPage);

// Calculate the starting number for the current page
$startNumber = ($current_page - 1) * $itemsPerPage + 1;

$i = $startNumber;

// Calculate total pages
$totalPages = ceil(count($directoryList) / $itemsPerPage);
?>

<!-- Total Pages Information -->
<div class="total-pages-info">
    Total Pages: <?php echo $totalPages; ?>
</div>
<div class="total-record">
    Total Record : <?php echo count($directoryList); ?>
</div>

<!-- Pagination Links -->
<div class="pagination">
    <?php

        $pagesPerBlock = 10;

        $startPage = floor(($current_page - 1) / $pagesPerBlock) * $pagesPerBlock + 1;
        $endPage = min($startPage + $pagesPerBlock - 1, $totalPages);

        // Previous Button
        if ($startPage > 1) {
            echo '<a href="?page=' . ($startPage - 1) . '">Previous</a>';
        }

        for ($page = $startPage; $page <= $endPage; $page++) {
            echo '<a href="?page=' . $page . '"' . ($page == $current_page ? ' class="current"' : '') . '>' . $page . '</a>';
        }

        // Next Button
        if ($endPage < $totalPages) {
            echo '<a href="?page=' . ($endPage + 1) . '">Next</a>';
        }
    ?>
</div>

