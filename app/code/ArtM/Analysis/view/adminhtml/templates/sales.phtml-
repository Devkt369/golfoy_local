<script type="text/javascript">
  require(['jquery', 'chartJs'], function($, Chart) {

    /*$("#analysisperiod").change(function() {
        var currVal = $(this).val(); 
        $(document).find("#period-"+currVal).trigger('click');
    });*/


    $(".analyse-export-btn").click(function() {
        var st_date = $(this).parents('.analyse-export').find('.st_date').val();
        var end_date = $(this).parents('.analyse-export').find('.end_date').val();
        var limitvalue = $(this).parents('.analyse-export').find('.limitvalue').val();
        var ftype = $(this).parents('.analyse-export').find('.ftype').val();
        var attrset = $(this).parents('.analyse-export').find('.attrset').val();
        var csvfilename = $(this).parents('.analyse-export').find('.csvfilename');
        var brandattr = $(this).parents('.analyse-export').find('.brandattr').val();
       // console.log(st_date + end_date + limitvalue + ftype + attrset);
       
       csvfilename.html("generating ...");
        var url = "<?php echo $block->getUrl('analysis/data/createcsv'); ?>";
        $.ajax({
          url: url,
          type: "POST",
          dataType: 'json',
          data: { st_date: st_date, end_date: end_date, limitvalue: limitvalue, ftype: ftype, attrset: attrset, brandattr: brandattr},
          success: function (response) { 
           csvfilename.html(response.link);
          }
        });
    });


    if($('.drawChartline').length) {
        $('.drawChartline').each(function() {

          var ctx = $(this).attr('id'); 
          var labels = JSON.parse($(this).attr('data-label'));
          var dataset = JSON.parse($(this).attr('data-dataset'));
          var myChart = new Chart(ctx, {
            type: 'line',
            data: {
              labels: labels,
              datasets: dataset
            },
            options: {
              scales: {
                y: {
                  beginAtZero: true
                }
              }
            }
          });

        });
    }
    if($('.drawChartpie').length) {
        $('.drawChartpie').each(function() {

          var ctx = $(this).attr('id'); 
          var labels = JSON.parse($(this).attr('data-label'));
          var dataset = JSON.parse($(this).attr('data-dataset'));
          var myChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
              labels: labels,
              datasets: dataset
            },
            options: {
              scales: {
                y: {
                  beginAtZero: true
                }
              }
            }
          });

        });
    }
  });
</script>