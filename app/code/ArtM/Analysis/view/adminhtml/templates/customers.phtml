<script type="text/javascript">
  require(['jquery', 'chartJs'], function($, Chart) {

    /*$("#analysisperiod").change(function() {
        var currVal = $(this).val(); 
        $(document).find("#period-"+currVal).trigger('click');
    });*/


  


    if($('.drawChartline').length) {
        $('.drawChartline').each(function() {

          var ctx = $(this).attr('id'); 
          var labels = JSON.parse($(this).attr('data-label'));
          var dataset = JSON.parse($(this).attr('data-dataset'));
          var myChart = new Chart(ctx, {
            type: 'line',
            data: {
              labels: labels,
              datasets: dataset
            },
            options: {
              scales: {
                y: {
                  beginAtZero: true
                }
              }
            }
          });

        });
    }
    if($('.drawChartpie').length) {
        $('.drawChartpie').each(function() {

          var ctx = $(this).attr('id'); 
          var labels = JSON.parse($(this).attr('data-label'));
          var dataset = JSON.parse($(this).attr('data-dataset'));
          var myChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
              labels: labels,
              datasets: dataset
            },
            options: {
              scales: {
                y: {
                  beginAtZero: true
                }
              }
            }
          });

        });
    }
  });
</script>