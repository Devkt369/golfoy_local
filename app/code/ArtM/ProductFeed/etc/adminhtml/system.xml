<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
	<system>
		<tab id="artm" translate="label" sortOrder="999">
			<label>artm</label>
		</tab>
		<section id="review" sortOrder="100" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
			<label>review</label>
			<tab>artm</tab>
			<resource>ArtM_ProductFeed::config_artm_review</resource>
			<group id="generalproductfeed" sortOrder="100" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
				<label>Google Product Review Feed</label>
				<field id="productfeed" type="select" sortOrder="10" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
					<label>Cron Status</label>
					<comment><![CDATA[
						<a href="/productfeed/feed/index" target="_blank">Generate and View Product Review Feed</a>
						<br><a href="/media/productreview/google_reviews_feed.xml" target="_blank">View File</a>
					]]></comment>
					<source_model>Magento\Config\Model\Config\Source\Enabledisable</source_model>
				</field>
			</group>
		</section>
	</system>
</config>
