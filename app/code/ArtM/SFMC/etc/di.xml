<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="ArtM\SFMC\Logger\Handler">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </type>
    <type name="ArtM\SFMC\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">SFMC</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">ArtM\SFMC\Logger\Handler</item>
            </argument>
        </arguments>
    </type>
    <type name="ArtM\SFMC\Logger\ProductLogger">
        <arguments>
            <argument name="name" xsi:type="string">SFMC</argument>
            <argument name="handlers" xsi:type="array">
                <item name="product" xsi:type="object">ArtM\SFMC\Logger\HandlerProduct</item>
            </argument>
        </arguments>
    </type>
    <type name="ArtM\SFMC\Logger\OrderLogger">
        <arguments>
            <argument name="name" xsi:type="string">SFMC</argument>
            <argument name="handlers" xsi:type="array">
                <item name="order" xsi:type="object">ArtM\SFMC\Logger\HandlerOrder</item>
            </argument>
        </arguments>
    </type>
    <type name="ArtM\SFMC\Logger\DeleteLogger">
        <arguments>
            <argument name="name" xsi:type="string">SFMC</argument>
            <argument name="handlers" xsi:type="array">
                <item name="order" xsi:type="object">ArtM\SFMC\Logger\HandlerDelete</item>
            </argument>
        </arguments>
    </type>
    <type name="ArtM\SFMC\Logger\CartLogger">
        <arguments>
            <argument name="name" xsi:type="string">SFMC</argument>
            <argument name="handlers" xsi:type="array">
                <item name="order" xsi:type="object">ArtM\SFMC\Logger\CartHandler</item>
            </argument>
        </arguments>
    </type>
    <type name="ArtM\SFMC\Logger\AbandonedCouponLogger">
        <arguments>
            <argument name="name" xsi:type="string">SFMC</argument>
            <argument name="handlers" xsi:type="array">
                <item name="order" xsi:type="object">ArtM\SFMC\Logger\HandlerAbandonedCoupon</item>
            </argument>
        </arguments>
    </type>
</config>