<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
	<group id="default">
		<job name="artm_sfmc_customer" instance="ArtM\SFMC\Cron\Customer" method="execute">
			<schedule>0 1 * * *</schedule>
		</job>
		<job name="artm_sfmc_product" instance="ArtM\SFMC\Cron\Product" method="execute">
			<schedule>0 2 * * *</schedule>
		</job>
		<job name="artm_sfmc_order" instance="ArtM\SFMC\Cron\Order" method="execute">
			<schedule>0 3 * * *</schedule>
		</job>
		<job name="artm_sfmc_abanedcart" instance="ArtM\SFMC\Cron\AbandonedCart" method="execute">
			<schedule>0 7 * * *</schedule>
		</job>
		<job name="artm_sfmc_abanedcart_coupon" instance="ArtM\SFMC\Cron\AbandonedCoupon" method="execute">
			<schedule>0 8 * * *</schedule>
		</job>
	</group>
</config>