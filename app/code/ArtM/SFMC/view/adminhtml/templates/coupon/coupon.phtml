<?php
$couponData = $block->getCouponData();

// Pagination settings
$recordsPerPage = 20;
$totalRecords = count($couponData);
$totalPages = ceil($totalRecords / $recordsPerPage);

// Get current page or set a default page if not set
$currentpage = isset($_GET['page']) ? $_GET['page'] : 1;

// Calculate the starting and ending page numbers for display
$startPage = max(1, $currentpage - 2);
$endPage = min($totalPages, $startPage + 4);
?>

<br><br><br><br><br><br>
<!-- Display pagination links with next and previous buttons -->
<div class="pagination coupon-pagination">
    <div class="pagination-list">
        <div class="page-info">
            Total Pages: <?php echo $totalPages; ?>
        </div>
        <div class="pagination-items">
            <?php
            // Display previous button
            $prevPage = $currentpage - 1;
            if ($prevPage > 0) {
                echo "<a href='" . $block->getUrl('sfmc/index/coupon') . "?page=$prevPage'>&laquo; Previous</a> ";
            }

            // Display page numbers with active class for the current page
            for ($i = $startPage; $i <= $endPage; $i++) {
                $activeClass = ($i == $currentpage) ? 'active' : '';
                echo "<a class='$activeClass' href='" . $block->getUrl('sfmc/index/coupon') . "?page=$i'>$i</a> ";
            }

            // Display next button
            $nextPage = $currentpage + 1;
            if ($nextPage <= $totalPages) {
                echo "<a href='" . $block->getUrl('sfmc/index/coupon') . "?page=$nextPage'>Next &raquo;</a>";
            }
            ?>
        </div>
    </div>
    <div class="page-input">
        <form action="<?php echo $block->getUrl('sfmc/index/coupon'); ?>" method="get">
            <label for="pageInput">Go to Page:</label>
            <input type="text" id="pageInput" name="page" placeholder="Enter page number">
            <button type="submit">Go</button>
        </form>
    </div>
</div>

<h2>Coupon Data Table</h2>

<table class="coupon-sync-data">
    <thead>
        <tr>
            <th>Coupon Code</th>
            <th>Coupon Status</th>
            <th>Response</th>
            <th>Last Update</th>
        </tr>
    </thead>
    <tbody>
        <?php
        // Calculate the starting record for the current page
        $startRecord = ($currentpage - 1) * $recordsPerPage;

        // Display records for the current page
        for ($i = $startRecord; $i < min($startRecord + $recordsPerPage, $totalRecords); $i++) :
            $coupon = $couponData[$i];
        ?>
            <tr>
                <td><?php echo $coupon['coupon_code']; ?></td>
                <td><?php echo $coupon['coupon_status']; ?></td>
                <td><?php echo $coupon['response']; ?></td>
                <td><?php echo $coupon['last_update']; ?></td>
            </tr>
        <?php endfor; ?>
    </tbody>
</table>
