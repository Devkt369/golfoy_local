<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="catalog_category_save_after">
        <observer name="artm_categorypage_flush_cache_on_category_save"
                  instance="ArtM\CategoryPage\Observer\FlushCategoryPageCache"/>
    </event>
    <event name="catalog_category_delete_after">
        <observer name="artm_categorypage_flush_cache_on_category_delete"
                  instance="ArtM\CategoryPage\Observer\FlushCategoryPageCache"/>
    </event>
</config>
