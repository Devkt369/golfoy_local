<script>
    require(['jquery', 'ArtM_CategoryPage/js/category-showcase'], function($, initShowcase) {
        var $root = $('#artm-categorypage-drawer');
        var trigger = document.querySelector('.artm-cat-drawer-trigger');
        var drawer = document.getElementById('artm-cat-drawer');
        var overlay = document.getElementById('artm-cat-overlay');
        var closeBtn = document.getElementById('artm-cat-drawer-close');
        var initialised = false;

        function openDrawer() {
            drawer.classList.add('is-open');
            overlay.classList.add('is-open');
            document.body.classList.add('artm-cat-drawer-open');
            drawer.setAttribute('aria-hidden', 'false');
            if (!initialised) {
                initialised = true;
                var config = JSON.parse($root.attr('data-page-config') || '{}');
                // Don't auto-select a category; let the user tap one first
                config.initialCategoryId = 0;
                initShowcase($root, config);
            }
        }

        function closeDrawer() {
            drawer.classList.remove('is-open');
            overlay.classList.remove('is-open');
            document.body.classList.remove('artm-cat-drawer-open');
            drawer.setAttribute('aria-hidden', 'true');
        }

        if (trigger) trigger.addEventListener('click', openDrawer);
        if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
        if (overlay) overlay.addEventListener('click', closeDrawer);
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeDrawer();
        });
    });
</script>
