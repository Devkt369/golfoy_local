<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="ArtM_CategoryPage::css/category-page.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="ArtM\CategoryPage\Block\Frontend\Page"
                   name="artm.categorypage.frontend"
                   template="ArtM_CategoryPage::frontend/page.phtml"/>
        </referenceContainer>
    </body>
</page>
