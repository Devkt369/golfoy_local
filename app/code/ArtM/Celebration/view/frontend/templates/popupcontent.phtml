<script>    
require(['jquery'], function($) {
    $(document).ready(function() {
        
        $('.celebration-popup').click(function(){
            $('#celebration-popup').click();
        });
        
        $('.cta_create_card span').click(function(){
            // $('#diwali_celebration').hide();
            // $('#diwali_celebration').css('display','none');
            $('button#create-grettings').click();
        });
        
        
        function openPopup() {
            $('#popup').css('display', 'flex');
            $('#popupForm')[0].reset();
            $('#popup button[type="submit"]').show();
            $('.unique_id').empty();
            // $('.popup-container').empty();
            $('.popup-container').remove();
        }

        $('#closePopup').click(closePopup);
        $('a.close-btn').click(closePopup);
        function closePopup() {
            $('#popup').css('display', 'none');
            $('.popup-container').hide();
        }

        $('#openPopup').click(openPopup);
//        $('.celebration-popup').click(openPopup);
        $('.diwali-container-outer').click(openPopup);
        $('.create-own').click(openPopup);
        
        const toInput = $("#to");
        const fromInput = $("#from");

        function limitInput(input, maxLength) {
            input.on('input', function() {
                if ($(this).val().length > maxLength) {
                    $(this).val($(this).val().substr(0, maxLength));
                }
            });
        }

        limitInput(toInput, 12);
        limitInput(fromInput, 12);
        

        $('#popupForm').submit(function(e) {
            e.preventDefault();
            var baseUrl = window.BASE_URL;
            $.ajax({
                url: baseUrl+'celebration/submit/submit',
                type: 'POST',
                data: $(this).serialize(),
                success: function(response) {
                    console.log('Success:', response);
                    // closePopup();
                    $('#popup button[type="submit"]').hide();
                    if (response.success) {
                        var idElement = $('<div></div>').text('Response ID: ' + response.success);
                        // $('.unique_id').append(idElement);

                        // Create a share link button
                        var baseUrl = window.BASE_URL; // Ensure BASE_URL is defined in your JS scope
                        var shareUrl = baseUrl + '?diwali=' + response.success;
                        $('form#popupForm .grettings-created').hide();
                        var shareButton = $('<button></button>')
                            .text('Share Your Greeting Card')
                            .addClass('btn btn-primary')
                            .attr('type', 'button')  // Define as a button element
                            .on('click', function() {
                                // Check if the browser supports the Web Share API
                                if (navigator.share) {
                                    navigator.share({
                                        title: 'Check this out!',
                                        text: 'Diwali Celebration Link',
                                        url: shareUrl
                                    }).then(function() {
                                        console.log('Thanks for sharing!');
                                    }).catch(function(err) {
                                        console.error('Error sharing:', err);
                                    });
                                } else {
                                    // Fallback for browsers that don't support the Web Share API
                                    alert('Sharing is not supported on this browser.');
                                }
                            });
                        $('.card_ready_text').text('Your Diwali Greeting Card is Ready!');
                        $('.unique_id').append(shareButton);
                        // Create "Create Other" button
                        var createOtherButton = $('<button></button>')
                            .text('Create Another Card')
                            .addClass('btn btn-secondary')
                            .attr('type', 'button')
                            .on('click', function() {
                                // Reset the form
                                $('#popupForm')[0].reset();
                                // Hide the success message and buttons
                                $('.card_ready_text').text('');
                                $('.unique_id').addClass('hide').empty();
                                // Show the original submit button
                                $('form#popupForm .grettings-created').show();
                            });
                        
                        // Append the "Create Other" button after the share button
                        $('.unique_id').append(createOtherButton);
                        $('.unique_id').removeClass('hide');
                    }
                    // var idElement = $('<div></div>').text('Response ID: ' + response.success);
                    // $('.unique_id').append(idElement);
                    // $('.unique_id').removeClass('hide');
                },
                error: function(xhr, status, error) {
                    console.error('Error:', error);
                }
            });
        });
    });
});
</script>

