                                                $userdata = $userdataCollection->addFieldToFilter('id', $customPrintData['id'])->getFirstItem();
                                                
                                                if ($userdata && $userdata->getId()) {
                                                    $additionalData = $userdata->getAdditionalData();
                                                    $imgPath = $userdata->getImgPath();
                                                    
                                                    if ($additionalData) {
                                                        $additionalDataArray = json_decode($additionalData, true);
                                                        
                                                        if ($additionalDataArray && isset($additionalDataArray['price_breakdown'])) {
                                                            $totalPrice = isset($additionalDataArray['total_price']) ? $additionalDataArray['total_price'] : 0;
                                                            $mediaUrl = $storeManager->getStore()->getBaseUrl(\Magento\Framework\UrlInterface::URL_TYPE_MEDIA);
                                                            
                                                            echo '<div class="custom-print-container">';
                                                            echo '<h4 class="custom-print-title">Custom Print (' . $block->escapeHtml($customPrintData['id']) . ') - ' . $currencySymbol . number_format($totalPrice, 2) . '</h4>';
                                                            
                                                            // Display main preview image with View Details button
                                                            if ($imgPath) {
                                                                $imageUrl = $mediaUrl . $imgPath;
                                                                echo '<div class="custom-print-image-container">';
                                                                echo '<img src="' . $block->escapeUrl($imageUrl) . '" class="custom-print-preview-image" alt="Custom Print Preview" onerror="this.style.display=\'none\'; this.nextSibling.style.display=\'block\';"/>';
                                                                echo '<div class="custom-print-error-message">Main preview image not available</div>';
                                                                echo '<button onclick="showCustomPrintDetails(\'' . $customPrintData['id'] . '\', \'' . $block->escapeUrl($imageUrl) . '\')" class="custom-print-details-button">View Details</button>';
                                                                echo '</div>';
                                                            } else {
                                                                // If no image, just show the button
                                                                echo '<div class="custom-print-image-container">';
                                                                echo '<button onclick="showCustomPrintDetails(\'' . $customPrintData['id'] . '\', \'\')" class="custom-print-details-button">View Details</button>';
                                                                echo '</div>';
                                                            }
                                                            
                                                            // Hidden details div for popup
                                                            echo '<div id="customPrintDetails_' . $customPrintData['id'] . '" class="hidden-details">';
                                                            
                                                            // Process each area from price_breakdown for popup
                                                            foreach ($additionalDataArray['price_breakdown'] as $area) {
                                                                $areaId = $area['area_id'];
                                                                $areaName = $area['areaname'];
                                                                $areaType = $area['area_filled_with'];
                                                                $areaPrice = $area['price_for_this_type'];
                                                                
                                                                echo '<div class="asset-card">';
                                                                echo '<h5>' . $block->escapeHtml($areaName) . '</h5>';
                                                                echo '<p class="area-info"><strong>Type:</strong> <span class="area-type-badge">' . ucfirst($block->escapeHtml($areaType)) . '</span></p>';
                                                                echo '<p class="area-price"><strong>Price:</strong> ' . $currencySymbol . number_format($areaPrice, 2) . '</p>';
                                                                
                                                                // Check if asset data exists for this area
                                                                if (isset($additionalDataArray['asset_paths'][$areaId])) {
                                                                    $assetData = $additionalDataArray['asset_paths'][$areaId];
                                                                    
                                                                    if ($areaType == 'text' && isset($assetData['data'])) {
                                                                        // Display text area data
                                                                        $textData = $assetData['data'];
