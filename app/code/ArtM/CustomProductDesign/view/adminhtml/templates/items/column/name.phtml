<?php 
    $_product = $_item->getProduct();
    $order    = $_item->getOrder();

    $qtyOrdered  = (float)$_item->getQtyOrdered();
    $qtyCanceled = (float)$_item->getQtyCanceled();
    $qtyRefunded = (float)$_item->getQtyRefunded();

    $showEstimation = (
        $qtyCanceled == 0 &&
        $qtyRefunded == 0
    );

    if (
        $showEstimation &&
        $order->getStatus() != 'canceled' &&
        $order->getStatus() != 'closed' &&
        $order->getStatus() != 'delivered' &&
        !$order->getPosId()
    ) {
        $orderStoreId = (int)$order->getStoreId();
        $estimateDeliveryHelper = $this->helper(ArtM\EstimateDelivery\Helper\Data::class);

        if ($estimateDeliveryHelper->IsEnabled($orderStoreId)) {
            $sku = $_item->getSku();
            $estimateDelivery = $estimateDeliveryHelper->getEstimatedDeliveryDate($sku, $orderStoreId);
            if (!empty($estimateDelivery['total_days'])) {
                $estimationAfter = (int)$estimateDelivery['total_days'];
                $createdAt = new DateTime($order->getCreatedAt());
                $createdAt->modify("+{$estimationAfter} days");
                $formattedDate = $createdAt->format('l, jS F Y');
                echo "<div style='font-weight:600;'>
                        Estimated delivery by 
                        <span style='color:#e60023;'>" . htmlspecialchars($formattedDate) . "</span>
                    </div>";
            }
        } else {
            // Fallback: parse select attribute text for shippingdays and dispatch
            $shippingDaysText = $_product->getAttributeText('shippingdays');
            $dispatchText = $_product->getAttributeText('dispatch');
            $shippingDays = 0;
            $dispatch = 0;
            if (is_string($shippingDaysText) && preg_match('/\d+/', $shippingDaysText, $matches)) {
                $shippingDays = (int)$matches[0];
            } elseif (is_numeric($shippingDaysText)) {
                $shippingDays = (int)$shippingDaysText;
            }
            if (is_string($dispatchText) && preg_match('/\d+/', $dispatchText, $matches)) {
                $dispatch = (int)$matches[0];
            } elseif (is_numeric($dispatchText)) {
                $dispatch = (int)$dispatchText;
            }
            $estimationAfter = $shippingDays + $dispatch;
            if ($estimationAfter > 0) {
                $createdAt = new DateTime($order->getCreatedAt());
                $createdAt->modify("+{$estimationAfter} days");
                $formattedDate = $createdAt->format('l, jS F Y');
                echo "<div style='font-weight:600;'>
                        Estimated delivery by 
                        <span style='color:#e60023;'>" . htmlspecialchars($formattedDate) . "</span>
                    </div>";
            }
        }
    }
    
?>
