                        <?php
                        // Display complete option value without truncation (skip for Customization)
                        $fullOptionValue = $_formattedOption['value'];
                        if (isset($_formattedOption['remainder']) && $_formattedOption['remainder']) {
                            $fullOptionValue .= $_formattedOption['remainder'];
                        }
                        
                        // Don't show raw JSON for Customization option, show custom print images instead
                        if (!(isset($originalOption['label']) && $originalOption['label'] == 'Customization')) {
                            echo $block->escapeHtml($fullOptionValue, ['a', 'br']);
                        }
                        ?>
                        
                        <?php
                        // Check if this is "Customization" option with JSON data
                        if (isset($originalOption['label']) && $originalOption['label'] == 'Customization') {
                            $optionValue = $fullOptionValue;
                            
                            // Decode HTML entities first
                            $decodedValue = html_entity_decode($optionValue, ENT_QUOTES, 'UTF-8');
                            $optionValue = $decodedValue;
                            
                            if (is_string($optionValue) && strpos($optionValue, '{"id":"') !== false) {
                                // Handle multiple JSON objects in the string
                                preg_match_all('/\{"id":"[^"]+","product_id":"[^"]+","session_id":"[^"]+"\}/', $optionValue, $matches);
                                
                                if (!empty($matches[0])) {
                                    foreach ($matches[0] as $jsonString) {
                                        $customPrintData = json_decode($jsonString, true);
                                        
                                        if ($customPrintData && isset($customPrintData['id'])) {
                                            try {
                                                // Get userdata from database including additional_data
