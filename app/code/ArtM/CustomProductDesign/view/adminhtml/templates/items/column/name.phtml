<script>
function showCustomPrintDetails(printId, finalImageUrl) {
    // Get the details content
    var detailsContent = document.getElementById('customPrintDetails_' + printId);
    
    if (!detailsContent) {
        alert('Details not found');
        return;
    }
    
    // Create modal if it doesn't exist
    var modalId = 'customPrintModal_' + printId;
    var existingModal = document.getElementById(modalId);
    
    if (existingModal) {
        existingModal.style.display = 'block';
        return;
    }
    
    // Create modal HTML
    var modal = document.createElement('div');
    modal.id = modalId;
    modal.className = 'custom-print-modal';
    
    var modalContent = document.createElement('div');
    modalContent.className = 'custom-print-modal-content';
    
    var modalHeader = document.createElement('div');
    modalHeader.className = 'custom-print-modal-header';
    
    var modalTitle = document.createElement('h2');
    modalTitle.className = 'custom-print-modal-title';
    modalTitle.textContent = 'Custom Print Details (ID: ' + printId + ')';
    
    var closeBtn = document.createElement('button');
    closeBtn.className = 'custom-print-modal-close';
    closeBtn.innerHTML = '&times;';
    closeBtn.onclick = function() {
        modal.style.display = 'none';
    };
    
    modalHeader.appendChild(modalTitle);
    modalHeader.appendChild(closeBtn);
    
    var modalBody = document.createElement('div');
    
    // Add full-width final image if available
    if (finalImageUrl && finalImageUrl !== '') {
        var finalImageContainer = document.createElement('div');
        var finalImage = document.createElement('img');
        finalImage.className = 'final-preview-image';
        finalImage.src = finalImageUrl;
        finalImage.alt = 'Final Custom Print Preview';
        finalImage.onerror = function() {
            this.style.display = 'none';
            var errorDiv = document.createElement('div');
            errorDiv.className = 'final-image-error';
            errorDiv.textContent = 'Final preview image not available';
            this.parentNode.appendChild(errorDiv);
        };
        finalImageContainer.appendChild(finalImage);
        modalBody.appendChild(finalImageContainer);
    }
    
    // Add area details in card container
    var cardContainer = document.createElement('div');
    cardContainer.className = 'asset-cards-container';
    cardContainer.innerHTML = detailsContent.innerHTML;
    modalBody.appendChild(cardContainer);
    
    modalContent.appendChild(modalHeader);
    modalContent.appendChild(modalBody);
    modal.appendChild(modalContent);
    
    // Add modal to body
    document.body.appendChild(modal);
    
    // Show modal
    modal.style.display = 'block';
    
    // Close modal when clicking outside
    modal.onclick = function(event) {
        if (event.target === modal) {
            modal.style.display = 'none';
        }
    };
}

// Close modal with Escape key
document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
        var modals = document.querySelectorAll('.custom-print-modal');
        modals.forEach(function(modal) {
            if (modal.style.display === 'block') {
                modal.style.display = 'none';
            }
        });
    }
});

// Function to handle image download
function downloadImage(url, filename) {
    // Create a temporary anchor element
    var link = document.createElement('a');
    link.href = url;
    link.download = filename || 'image';
    
    // For cross-origin images, we might need to fetch and create a blob
    fetch(url)
        .then(response => response.blob())
        .then(blob => {
            var objectUrl = URL.createObjectURL(blob);
            link.href = objectUrl;
            
            // Trigger download
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            
            // Clean up the object URL
            setTimeout(() => URL.revokeObjectURL(objectUrl), 100);
        })
        .catch(error => {
            // Fallback to direct link if fetch fails
            console.log('Fetch failed, using direct download:', error);
            link.target = '_blank';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        });
}
</script>
