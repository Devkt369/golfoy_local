    // PHP-loaded data as fallback
    const pageLoadImages = <?php echo json_encode($pageLoadImages); ?>;
    const pageLoadDebug = <?php echo json_encode($pageLoadDebug); ?>;

    // Initialize
    $(document).ready(function() {
        bindEvents();
        
        console.log('Page Load Debug:', pageLoadDebug);
        console.log('Page Load Images:', pageLoadImages);
        
        // Load images on page load - try PHP data first, then AJAX
        setTimeout(function() {
            if (pageLoadImages && pageLoadImages.length > 0) {
                console.log('Using PHP-loaded images (' + pageLoadImages.length + ' found)');
                allImages = pageLoadImages;
                renderGallery();
            } else {
                console.log('No PHP-loaded images, trying AJAX');
                loadImages();
            }
        }, 100);
    });

    function bindEvents() {
        // Upload button click
        $('#upload-clipart-btn').on('click', function() {
            $('#clipart-file-input').click();
        });

        // File input change
        $('#clipart-file-input').on('change', function(e) {
            const files = Array.from(e.target.files);
            if (files.length > 0) {
                uploadImages(files);
            }
        });

        // Show only hidden images button
        $('#show-hidden-btn').on('click', function() {
            toggleHiddenFilter();
        });

        // Selection controls
        $('#select-all-btn').on('click', function() {
            selectAllImages();
        });

        $('#deselect-all-btn').on('click', function() {
            deselectAllImages();
        });

        // Bulk actions
        $('#bulk-hide-btn').on('click', function() {
            bulkToggleVisibility(false);
        });

        $('#bulk-show-btn').on('click', function() {
            bulkToggleVisibility(true);
        });

        $('#bulk-delete-btn').on('click', function() {
            bulkDeleteImages();
        });

        // Popup close
        $('.popup-close, .popup-overlay').on('click', function() {
            $('#image-preview-popup').hide();
        });
    }

    function loadImages() {
        console.log('Loading images...');
        
        // Load images directly from the filesystem
        $.ajax({
            url: window.location.href,
            method: 'POST',
            data: {
                action: 'load_images',
                form_key: window.FORM_KEY
            },
            dataType: 'json',
            success: function(response) {
                console.log('Load images response:', response);
                
                // Show debug information
                if (response && response.debug) {
                    console.log('Debug Info:', response.debug);
                    console.log('Base Directory:', response.debug.baseDir);
                    console.log('Base Directory Exists:', response.debug.baseDirExists);
                    console.log('Files Found:', response.debug.filteredFiles);
                }
                
                if (response && response.success && response.images) {
                    allImages = response.images;
                    console.log('Loaded ' + allImages.length + ' images');
                    
                    if (allImages.length === 0) {
                        var debugHtml = '<div style="text-align:center;padding:40px;color:#666;">';
                        debugHtml += '<p>0 images found</p>';
                        // if (response.debug) {
                        //     debugHtml += '<div style="margin-top:20px;padding:15px;background:#f8f9fa;border-radius:4px;text-align:left;font-size:12px;">';
                        //     debugHtml += '<strong>Debug Information:</strong><br>';
                        //     debugHtml += 'Base Directory: ' + response.debug.baseDir + '<br>';
                        //     debugHtml += 'Directory Exists: ' + response.debug.baseDirExists + '<br>';
                        //     debugHtml += 'Files Found: ' + (response.debug.filteredFiles ? response.debug.filteredFiles.length : 0) + '<br>';
                        //     if (response.debug.filteredFiles && response.debug.filteredFiles.length > 0) {
                        //         debugHtml += 'Files: ' + response.debug.filteredFiles.join(', ');
                        //     }
                        //     debugHtml += '</div>';
                        // }
                        debugHtml += '</div>';
                        $('#clipart-gallery').html(debugHtml);
                    } else {
                        renderGallery();
                    }
                } else {
                    console.log('No images found or invalid response');
                    allImages = [];
                    $('#clipart-gallery').html('<div style="text-align:center;padding:40px;color:#666;">No images found. Click "Upload Images" to add some clipart images.</div>');
                }
            },
            error: function(xhr, status, error) {
                console.log('AJAX Error:', {xhr: xhr, status: status, error: error});
                console.log('Response Text:', xhr.responseText);
                
                // Use PHP-loaded data as fallback
                console.log('AJAX failed, using PHP-loaded data as fallback');
                allImages = pageLoadImages || [];
                console.log('Fallback loaded ' + allImages.length + ' images');
                
                if (allImages.length === 0) {
                    var debugHtml = '<div style="text-align:center;padding:40px;color:#666;">';
                    debugHtml += '<p>No images found. Click "Upload Images" to add some clipart images.</p>';
                    if (pageLoadDebug) {
                        debugHtml += '<div style="margin-top:20px;padding:15px;background:#f8f9fa;border-radius:4px;text-align:left;font-size:12px;">';
                        debugHtml += '<strong>Debug Information (PHP Fallback):</strong><br>';
                        debugHtml += 'Base Directory: ' + pageLoadDebug.final_base_dir + '<br>';
                        debugHtml += 'Directory Exists: ' + pageLoadDebug.base_exists + '<br>';
                        debugHtml += 'Files Found: ' + (pageLoadDebug.filtered_files ? pageLoadDebug.filtered_files.length : 0) + '<br>';
                        if (pageLoadDebug.filtered_files && pageLoadDebug.filtered_files.length > 0) {
                            debugHtml += 'Files: ' + pageLoadDebug.filtered_files.join(', ') + '<br>';
                        }
                        debugHtml += 'Images Processed: ' + pageLoadDebug.images_found + '<br>';
                        if (pageLoadDebug.tried_paths) {
                            debugHtml += 'Tried Paths: <br>';
                            pageLoadDebug.tried_paths.forEach(function(path, index) {
                                debugHtml += '- ' + path + ' (exists: ' + pageLoadDebug.path_exists[index] + ')<br>';
                            });
                        }
                        debugHtml += '</div>';
                    }
                    debugHtml += '</div>';
                    $('#clipart-gallery').html(debugHtml);
                } else {
                    renderGallery();
                }
            }
        });
    }

    function renderGallery() {
        const $gallery = $('#clipart-gallery');
        $gallery.empty();

        if (allImages.length === 0) {
            $gallery.html('<div style="text-align:center;padding:40px;color:#666;font-size:16px;">No clipart images found.<br><br>Click the "Upload Images" button above to add some images.</div>');
            return;
        }

        // Add/remove CSS class for hidden-only view
        if (showOnlyHidden) {
            $gallery.addClass('show-hidden-only');
        } else {
            $gallery.removeClass('show-hidden-only');
        }

        // Filter images based on current view mode
        let imagesToShow = allImages;
        if (showOnlyHidden) {
            imagesToShow = allImages.filter(image => image.hidden);
            
            if (imagesToShow.length === 0) {
                $gallery.html('<div style="text-align:center;padding:40px;color:#666;font-size:16px;">0 images found.</div>');
                return;
            }
        }

        imagesToShow.forEach(function(image) {
            const $item = createImageItem(image);
            $gallery.append($item);
        });

        // Show simple image count
        const $imageCount = $('<div style="text-align:center;padding:5px;color:#666;font-size:14px;margin-bottom:15px;">' + imagesToShow.length + ' Image(s) found</div>');
        $gallery.prepend($imageCount);
    }

    function createImageItem(image) {
        const isSelected = selectedImages.has(image.filename);
        const hiddenClass = image.hidden ? 'dimmed' : '';
        const selectedClass = isSelected ? 'selected' : '';

        const $item = $(`
            <div class="clipart-item ${hiddenClass} ${selectedClass}" data-filename="${image.filename}">
                <div class="clipart-controls">
                    <button class="control-btn select-checkbox ${isSelected ? 'selected' : ''}" title="Select/Deselect">
                        <i class="fa fa-${isSelected ? 'check-square' : 'square-o'}"></i>
                    </button>
                    <button class="control-btn toggle-visibility" title="${image.hidden ? 'Show Image' : 'Hide Image'}">
                        <i class="fa fa-${image.hidden ? 'eye' : 'eye-slash'}"></i>
                    </button>
                    <button class="control-btn delete-btn" title="Delete Image">
                        <i class="fa fa-trash-o"></i>
                    </button>
                </div>
                <img src="${image.thumbnail_url}" alt="${image.filename}" class="clipart-thumbnail">
                <div class="clipart-filename">${image.filename}</div>
            </div>
        `);

        // Bind events
        $item.find('.select-checkbox').on('click', function(e) {
            e.stopPropagation();
            toggleSelection(image.filename);
        });

        $item.find('.toggle-visibility').on('click', function(e) {
            e.stopPropagation();
            toggleImageVisibility(image.filename, !image.hidden);
        });

        $item.find('.delete-btn').on('click', function(e) {
            e.stopPropagation();
            deleteImage(image.filename);
        });

        $item.find('.clipart-thumbnail').on('click', function() {
            showImagePreview(image);
        });

        return $item;
    }

    function uploadImages(files) {
        const validFiles = files.filter(file => {
            const validTypes = ['image/png', 'image/jpg', 'image/jpeg'];
            return validTypes.includes(file.type);
        });

        if (validFiles.length === 0) {
            showNotification('Please select valid image files (PNG, JPG, JPEG)', 'error');
            return;
        }

        const formData = new FormData();
        validFiles.forEach(file => {
            formData.append('images[]', file);
        });

        $('#upload-progress').show();
        updateProgress(0);

        // Add action parameter to formData
        formData.append('action', 'upload_images');
        
        // Add Magento form key for security
        formData.append('form_key', window.FORM_KEY);

        $.ajax({
            url: window.location.href,
            method: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            xhr: function() {
                const xhr = new window.XMLHttpRequest();
                xhr.upload.addEventListener("progress", function(evt) {
                    if (evt.lengthComputable) {
                        const percentComplete = (evt.loaded / evt.total) * 100;
                        updateProgress(percentComplete);
                    }
                }, false);
                return xhr;
            },
            success: function(response) {
                $('#upload-progress').hide();
                $('#clipart-file-input').val('');
                
                try {
                    if (typeof response === 'string') {
                        response = JSON.parse(response);
                    }
                    
                    if (response.success) {
                        showNotification(`Successfully uploaded ${response.uploaded_count} images`, 'success');
                        loadImages(); // Reload gallery
                    } else {
                        showNotification(response.message || 'Upload failed', 'error');
                    }
                } catch (e) {
                    showNotification('Upload completed but response was invalid', 'warning');
                    loadImages(); // Still reload gallery
                }
            },
            error: function() {
                $('#upload-progress').hide();
                showNotification('Upload failed', 'error');
            }
        });
    }

    function updateProgress(percent) {
        $('.progress-fill').css('width', percent + '%');
        $('.progress-text').text(`Uploading... ${Math.round(percent)}%`);
    }

    function toggleSelection(filename) {
        if (selectedImages.has(filename)) {
            selectedImages.delete(filename);
        } else {
            selectedImages.add(filename);
        }
        
        updateSelectionUI();
        updateBulkActionsVisibility();
    }

    function updateSelectionUI() {
        $('.clipart-item').each(function() {
            const filename = $(this).data('filename');
            const isSelected = selectedImages.has(filename);
            
            $(this).toggleClass('selected', isSelected);
            const $checkbox = $(this).find('.select-checkbox');
            $checkbox.toggleClass('selected', isSelected);
            $checkbox.find('i').removeClass().addClass(`fa fa-${isSelected ? 'check-square' : 'square-o'}`);
        });

        $('#selected-count').text(`${selectedImages.size} selected`);
    }

    function updateBulkActionsVisibility() {
        $('#bulk-actions').toggle(selectedImages.size > 0);
    }

    function selectAllImages() {
        // Get all visible images (considering current filter)
        let imagesToSelect;
        if (showOnlyHidden) {
            imagesToSelect = allImages.filter(image => image.hidden);
        } else {
            imagesToSelect = allImages;
        }

        // Add all images to selection
        imagesToSelect.forEach(image => {
            selectedImages.add(image.filename);
        });

        updateSelectionUI();
        updateBulkActionsVisibility();
    }

    function deselectAllImages() {
        selectedImages.clear();
        
        updateSelectionUI();
        updateBulkActionsVisibility();
    }

    let showOnlyHidden = false;

    function toggleHiddenFilter() {
        showOnlyHidden = !showOnlyHidden;
        
        const $btn = $('#show-hidden-btn');
        if (showOnlyHidden) {
            $btn.html('<i class="fa fa-list"></i> Show All Images');
            $btn.removeClass('btn-secondary').addClass('btn-info');
        } else {
            $btn.html('<i class="fa fa-filter"></i> Show Only Hidden Images');
            $btn.removeClass('btn-info').addClass('btn-secondary');
        }
        
        renderGallery();
    }

    function bulkToggleVisibility(visible) {
        if (selectedImages.size === 0) return;

        const filenames = Array.from(selectedImages);
        
        $.ajax({
            url: window.location.href,
            method: 'POST',
            data: {
                action: 'bulk_visibility',
                filenames: filenames,
                visible: visible,
                form_key: window.FORM_KEY
            },
            success: function(response) {
                try {
                    if (typeof response === 'string') {
                        response = JSON.parse(response);
                    }
                    
                    if (response.success) {
                        showNotification(`Successfully ${visible ? 'showed' : 'hidden'} ${filenames.length} images`, 'success');
                        loadImages();
                        selectedImages.clear();
                        updateBulkActionsVisibility();
                    } else {
                        showNotification(response.message || 'Operation failed', 'error');
                    }
                } catch (e) {
                    showNotification('Operation completed but response was invalid', 'warning');
                    loadImages();
                }
            }
        });
    }

    function bulkDeleteImages() {
        if (selectedImages.size === 0) return;

        if (!confirm(`Are you sure you want to delete ${selectedImages.size} selected images?`)) {
            return;
        }

        const filenames = Array.from(selectedImages);
        
        $.ajax({
            url: window.location.href,
            method: 'POST',
            data: {
                action: 'bulk_delete',
                filenames: filenames,
                form_key: window.FORM_KEY
            },
            success: function(response) {
                try {
                    if (typeof response === 'string') {
                        response = JSON.parse(response);
                    }
                    
                    if (response.success) {
                        showNotification(`Successfully deleted ${filenames.length} images`, 'success');
                        loadImages();
                        selectedImages.clear();
                        updateBulkActionsVisibility();
                    } else {
                        showNotification(response.message || 'Delete failed', 'error');
                    }
                } catch (e) {
                    showNotification('Delete completed but response was invalid', 'warning');
                    loadImages();
                }
            }
        });
    }

    function toggleImageVisibility(filename, hidden) {
        $.ajax({
            url: window.location.href,
            method: 'POST',
            data: {
                action: 'toggle_visibility',
                filename: filename,
                hidden: hidden,
                form_key: window.FORM_KEY
            },
            success: function(response) {
                try {
                    if (typeof response === 'string') {
                        response = JSON.parse(response);
                    }
                    
                    if (response.success) {
                        showNotification(`Image ${hidden ? 'hidden' : 'shown'} successfully`, 'success');
                        loadImages();
                    } else {
                        showNotification(response.message || 'Operation failed', 'error');
                    }
                } catch (e) {
                    showNotification('Operation completed but response was invalid', 'warning');
                    loadImages();
                }
            }
        });
    }

    function deleteImage(filename) {
        if (!confirm('Are you sure you want to delete this image?')) {
            return;
        }

        $.ajax({
            url: window.location.href,
            method: 'POST',
            data: {
                action: 'delete_image',
                filename: filename,
                form_key: window.FORM_KEY
            },
            success: function(response) {
                try {
                    if (typeof response === 'string') {
                        response = JSON.parse(response);
                    }
                    
                    if (response.success) {
                        showNotification('Image deleted successfully', 'success');
                        loadImages();
                    } else {
                        showNotification(response.message || 'Delete failed', 'error');
                    }
                } catch (e) {
                    showNotification('Delete completed but response was invalid', 'warning');
                    loadImages();
                }
            }
        });
    }

    function showImagePreview(image) {
        $('#preview-image').attr('src', image.original_url);
        $('#popup-filename').text(image.filename);
        $('#popup-filesize').text(`Size: ${image.filesize || 'Unknown'}`);
        $('#image-preview-popup').show();
    }

    function showNotification(message, type) {
        // You can integrate this with Magento's notification system
        alert(message);
    }
});
</script>