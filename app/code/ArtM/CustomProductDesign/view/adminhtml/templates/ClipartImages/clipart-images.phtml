<?php
// Debug: Log all requests
file_put_contents(sys_get_temp_dir() . '/clipart_debug.log', 
    date('Y-m-d H:i:s') . " - Method: " . $_SERVER['REQUEST_METHOD'] . 
    ", POST data: " . print_r($_POST, true) . "\n", FILE_APPEND);

// Handle AJAX requests only
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['action']) && !empty($_POST['action'])) {
    // Validate Magento form key for security
    $objectManager = \Magento\Framework\App\ObjectManager::getInstance();
    $formKey = $objectManager->get(\Magento\Framework\Data\Form\FormKey\Validator::class);
    $request = $objectManager->get(\Magento\Framework\App\RequestInterface::class);
    
    if (!$formKey->validate($request)) {
        $response = ['success' => false, 'message' => 'Invalid form key. Please refresh the page.'];
        header('Content-Type: application/json');
        echo json_encode($response);
        exit;
    }
    
    // Use Magento's proper filesystem methods
    $filesystem = $objectManager->get(\Magento\Framework\Filesystem::class);
    $mediaDirectory = $filesystem->getDirectoryWrite(\Magento\Framework\App\Filesystem\DirectoryList::MEDIA);
    $storeManager = $objectManager->get(\Magento\Store\Model\StoreManagerInterface::class);
    
    // Get proper paths using Magento methods
    $clipartRelativePath = 'customprint/cliparts/';
    $baseDir = $mediaDirectory->getAbsolutePath($clipartRelativePath);
    $mediaBaseUrl = $storeManager->getStore()->getBaseUrl(\Magento\Framework\UrlInterface::URL_TYPE_MEDIA);
    
    $thumbnailDir = $baseDir . 'thumbnail/';
    
    // Ensure directories exist
    if (!is_dir($baseDir)) {
        mkdir($baseDir, 0755, true);
    }
    if (!is_dir($thumbnailDir)) {
        mkdir($thumbnailDir, 0755, true);
    }
    
    $response = ['success' => false, 'message' => ''];
    
    try {
        switch ($_POST['action']) {
        case 'load_images':
            $images = [];
            $debugInfo = [
                'baseDir' => $baseDir,
                'thumbnailDir' => $thumbnailDir,
                'baseDirExists' => is_dir($baseDir),
                'thumbnailDirExists' => is_dir($thumbnailDir),
                'files' => []
            ];
            
            if (is_dir($baseDir)) {
                $allFiles = scandir($baseDir);
                $files = array_diff($allFiles, array('.', '..', 'thumbnail'));
                $debugInfo['allFiles'] = $allFiles;
                $debugInfo['filteredFiles'] = $files;
                
                foreach ($files as $filename) {
                    $originalPath = $baseDir . $filename;
                    $thumbnailPath = $thumbnailDir . $filename;
                    
                    if (is_file($originalPath) && in_array(strtolower(pathinfo($filename, PATHINFO_EXTENSION)), ['png', 'jpg', 'jpeg'])) {
                        // Get file size
                        $filesize = filesize($originalPath);
                        $filesizeFormatted = $filesize < 1024 ? $filesize . ' B' : 
                                           ($filesize < 1048576 ? round($filesize/1024, 1) . ' KB' : 
                                            round($filesize/1048576, 1) . ' MB');
                        
                        // Check if hidden (we'll use a simple .hidden file system)
                        $hiddenFile = $baseDir . '.' . $filename . '.hidden';
                        $isHidden = file_exists($hiddenFile);
                        
                        $images[] = [
                            'filename' => $filename,
                            'original_url' => $mediaBaseUrl . 'customprint/cliparts/' . $filename,
                            'thumbnail_url' => file_exists($thumbnailPath) ? 
                                             $mediaBaseUrl . 'customprint/cliparts/thumbnail/' . $filename : 
                                             $mediaBaseUrl . 'customprint/cliparts/' . $filename,
                            'filesize' => $filesizeFormatted,
                            'hidden' => $isHidden
                        ];
                    }
                }
            }
            
            $response = [
                'success' => true, 
                'images' => $images,
                'debug' => $debugInfo
            ];
            break;
            
        case 'upload_images':
            $uploadedCount = 0;
            $errors = [];
            
            if (isset($_FILES['images']) && is_array($_FILES['images']['name'])) {
                for ($i = 0; $i < count($_FILES['images']['name']); $i++) {
                    $filename = $_FILES['images']['name'][$i];
                    $tmpName = $_FILES['images']['tmp_name'][$i];
                    $fileSize = $_FILES['images']['size'][$i];
                    $fileType = $_FILES['images']['type'][$i];
                    
                    // Validate file type
                    $allowedTypes = ['image/png', 'image/jpg', 'image/jpeg'];
                    if (!in_array($fileType, $allowedTypes)) {
                        $errors[] = "Invalid file type for $filename";
                        continue;
                    }
                    
                    // Generate unique filename if exists
                    $originalFilename = $filename;
                    $counter = 1;
                    while (file_exists($baseDir . $filename)) {
                        $pathInfo = pathinfo($originalFilename);
                        $filename = $pathInfo['filename'] . '_' . $counter . '.' . $pathInfo['extension'];
                        $counter++;
                    }
                    
                    // Move original file
                    $originalPath = $baseDir . $filename;
                    if (move_uploaded_file($tmpName, $originalPath)) {
                        // Create thumbnail
                        createThumbnail($originalPath, $thumbnailDir . $filename);
                        $uploadedCount++;
                    } else {
                        $errors[] = "Failed to upload $filename";
                    }
                }
            }
            
            if ($uploadedCount > 0) {
                $response = [
                    'success' => true, 
                    'uploaded_count' => $uploadedCount,
                    'message' => $uploadedCount . ' files uploaded successfully'
                ];
                if (!empty($errors)) {
                    $response['warnings'] = $errors;
                }
            } else {
                $response = ['success' => false, 'message' => 'No files were uploaded. ' . implode(', ', $errors)];
            }
            break;
            
        case 'delete_image':
            if (isset($_POST['filename'])) {
                $filename = basename($_POST['filename']); // Security: prevent path traversal
                $originalPath = $baseDir . $filename;
                $thumbnailPath = $thumbnailDir . $filename;
                $hiddenFile = $baseDir . '.' . $filename . '.hidden';
                
                $deleted = 0;
                if (file_exists($originalPath) && unlink($originalPath)) $deleted++;
                if (file_exists($thumbnailPath) && unlink($thumbnailPath)) $deleted++;
                if (file_exists($hiddenFile) && unlink($hiddenFile)) $deleted++;
                
                $response = ['success' => $deleted > 0, 'message' => $deleted > 0 ? 'Image deleted successfully' : 'Failed to delete image'];
            }
            break;
            
        case 'bulk_delete':
            if (isset($_POST['filenames']) && is_array($_POST['filenames'])) {
                $deletedCount = 0;
                foreach ($_POST['filenames'] as $filename) {
                    $filename = basename($filename); // Security
                    $originalPath = $baseDir . $filename;
                    $thumbnailPath = $thumbnailDir . $filename;
                    $hiddenFile = $baseDir . '.' . $filename . '.hidden';
                    
                    if (file_exists($originalPath) && unlink($originalPath)) $deletedCount++;
                    if (file_exists($thumbnailPath)) unlink($thumbnailPath);
                    if (file_exists($hiddenFile)) unlink($hiddenFile);
                }
                
                $response = [
                    'success' => $deletedCount > 0, 
                    'message' => "$deletedCount images deleted successfully"
                ];
            }
            break;
            
        case 'toggle_visibility':
            if (isset($_POST['filename']) && isset($_POST['hidden'])) {
                $filename = basename($_POST['filename']); // Security
                $hiddenFile = $baseDir . '.' . $filename . '.hidden';
                $hidden = filter_var($_POST['hidden'], FILTER_VALIDATE_BOOLEAN);
                
                if ($hidden) {
                    // Hide the image
                    $success = file_put_contents($hiddenFile, time());
                } else {
                    // Show the image
                    $success = file_exists($hiddenFile) ? unlink($hiddenFile) : true;
                }
                
                $response = [
                    'success' => $success !== false, 
                    'message' => 'Visibility updated successfully'
                ];
            }
            break;
            
        case 'bulk_visibility':
            if (isset($_POST['filenames']) && is_array($_POST['filenames']) && isset($_POST['visible'])) {
                $updatedCount = 0;
                $visible = filter_var($_POST['visible'], FILTER_VALIDATE_BOOLEAN);
                
                foreach ($_POST['filenames'] as $filename) {
                    $filename = basename($filename); // Security
                    $hiddenFile = $baseDir . '.' . $filename . '.hidden';
                    
                    if ($visible) {
                        // Show the image
                        if (file_exists($hiddenFile) && unlink($hiddenFile)) $updatedCount++;
                    } else {
                        // Hide the image
                        if (file_put_contents($hiddenFile, time())) $updatedCount++;
                    }
                }
                
                $response = [
                    'success' => $updatedCount > 0,
                    'message' => "$updatedCount images updated successfully"
                ];
            }
            break;
            
        default:
            $response = ['success' => false, 'message' => 'Unknown action: ' . $_POST['action']];
            break;
        }
    } catch (Exception $e) {
        $response = ['success' => false, 'message' => 'Error: ' . $e->getMessage()];
    }
    
    header('Content-Type: application/json');
    echo json_encode($response);
    exit;
}

// Function to create thumbnail
function createThumbnail($sourcePath, $destPath) {
    $imageInfo = getimagesize($sourcePath);
    if (!$imageInfo) return false;
    
    $sourceWidth = $imageInfo[0];
    $sourceHeight = $imageInfo[1];
    $mimeType = $imageInfo['mime'];
    
    // Calculate new dimensions (70px width, maintain ratio)
    $targetWidth = 70;
    $targetHeight = (int) round(($sourceHeight * $targetWidth) / $sourceWidth);
    
    // Create source image resource
    switch ($mimeType) {
        case 'image/jpeg':
            $sourceImage = imagecreatefromjpeg($sourcePath);
            break;
        case 'image/png':
            $sourceImage = imagecreatefrompng($sourcePath);
            break;
        default:
            return false;
    }
    
    if (!$sourceImage) return false;
    
    // Create new image
    $newImage = imagecreatetruecolor($targetWidth, $targetHeight);
    
    // Handle transparency for PNG
    if ($mimeType === 'image/png') {
        imagealphablending($newImage, false);
        imagesavealpha($newImage, true);
        $transparent = imagecolorallocatealpha($newImage, 255, 255, 255, 127);
        imagefilledrectangle($newImage, 0, 0, $targetWidth, $targetHeight, $transparent);
    }
    
    // Resize
    imagecopyresampled(
        $newImage, $sourceImage,
        0, 0, 0, 0,
        $targetWidth, $targetHeight,
        $sourceWidth, $sourceHeight
    );
    
    // Save thumbnail
    $success = false;
    switch ($mimeType) {
        case 'image/jpeg':
            $success = imagejpeg($newImage, $destPath, 90);
            break;
        case 'image/png':
            $success = imagepng($newImage, $destPath, 9);
            break;
    }
    
    // Clean up
    imagedestroy($sourceImage);
    imagedestroy($newImage);
    
    return $success;
}

