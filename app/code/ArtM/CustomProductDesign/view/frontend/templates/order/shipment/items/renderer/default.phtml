    require(['jquery'], function($) {
        window.openCustomizationPopup = function(url) {
            $.get(url, function(response) {
                $('#customization-popup-content').html(response);
                $('#customization-popup').fadeIn();
            });
        };
        $('#customization-popup-close').on('click', function() {
            $('#customization-popup').fadeOut();
            $('#customization-popup-content').html('');
        });
        // Optional: close when clicking outside modal
        $('#customization-popup').on('click', function(e) {
            if (e.target === this) {
                $('#customization-popup').fadeOut();
                $('#customization-popup-content').html('');
            }
        });
    });
