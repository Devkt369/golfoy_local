/** @var \Magento\Sales\Block\Order\Item\Renderer\DefaultRenderer $block */
$_item = $block->getItem();

?>

<tr id="order-item-row-<?= (int) $_item->getId() ?>" class="new changes qweqw23123213">
    <td class="col name" data-th="<?= $block->escapeHtml(__('Product Name')) ?>">
        <div class="product-details">
            <span><img src="/media/catalog/product<?= $_item->getProduct()->getSmallImage() ?>" width="120px"></span>
            <div style="display: flex; flex-direction: column;">
                <strong class="product name product-item-name"><?= $block->escapeHtml($_item->getName()) ?></strong>
                <?php if ($_options = $block->getItemOptions()): ?>
                    <div class="item-options">
                        <?php foreach ($_options as $_option): ?>
                            <?php if (isset($_option['label']) && $_option['label'] === 'Customization'): ?>
                                <?php
                                $optionValue = isset($_option['print_value']) ? $_option['print_value'] : $_option['value'];
                                $helper = $this->helper('ArtM\CustomProductDesign\Helper\Data');
                                echo $helper->getCustomizationLink($optionValue);
                                ?>
                            <?php else: ?>
                                <div class="option-row">
                                    <p><?= $block->escapeHtml($_option['label']) ?></p>
                                    <?php if (!$block->getPrintStatus()): ?>
                                        <?php $_formatedOptionValue = $block->getFormatedOptionValue($_option) ?>
                                        <span<?= (isset($_formatedOptionValue['full_view']) ? ' class="tooltip wrapper"' : '') ?>>
                                            <?php
                                            $formatedval = $_formatedOptionValue['value'];
                                            if (strpos($formatedval, 'customprint') !== false) {
                                                echo '<span class="custom-print-account-img"><img src="/media/' . htmlspecialchars($formatedval) . '" alt="Custom Print" /></span>';
                                            } else {
                                                echo $block->escapeHtml($_formatedOptionValue['value'], ['a']);
                                            }
                                            ?>
                                            <?php if (isset($_formatedOptionValue['full_view'])): ?>
                                                <div class="tooltip content">
                                                    <p class="item options">
                                                        <span><?= $block->escapeHtml($_option['label']) ?></span>
                                                        <span><?= $block->escapeHtml($_formatedOptionValue['full_view']) ?></span>
                                                    </p>
                                                </div>
                                            <?php endif; ?>
                                            </span>
                                </div>
                            <?php else: ?>
                                <?php if (strpos($_option['value'], 'customprint') !== false): ?>
                                    <span>Image Uploaded</span>
                                <?php else: ?>
                                    <span><?= $block->escapeHtml($_option['print_value'] ?? $_option['value']) ?></span>
                                <?php endif; ?>
                            <?php endif; ?>
                        <?php endif; ?>
                    <?php endforeach; ?>
                    </div>
                <?php endif; ?>
            </div>
        </div>
        <?php
        if (($_item->getOrder()->getStatus() == 'delivered') && ($block->getItem()->getQtyShipped() > 0) && $_item && !$_item->getParentItem()):
            $customReviewBlock = $block->getLayout()->createBlock(
                \ArtM\Review\Block\OrderItemReview::class,
                'order_item_review_form_' . $_item->getId()
            );
            if ($customReviewBlock) {
                $customReviewBlock->setTemplate('ArtM_Review::order/item_review.phtml');
                $customReviewBlock->setOrderItem($_item); // Pass order context directly down
                echo $customReviewBlock->toHtml();
            }
        endif;
        ?>
        <?php $addtInfoBlock = $block->getProductAdditionalInformationBlock(); ?>
        <?php if ($addtInfoBlock): ?>
            <?= $addtInfoBlock->setItem($_item)->toHtml() ?>
        <?php endif; ?>
        <?= $block->escapeHtml($_item->getDescription()) ?>
    </td>
    <td class="col qty" data-th="<?= $block->escapeHtml(__('Qty')) ?>">
        <ul class="items-qty">
            <?php if ($block->getItem()->getQtyOrdered() > 0): ?>
                <li class="item">
                    <span class="content"><?= (float) $block->getItem()->getQtyOrdered() ?></span>
                </li>
            <?php endif; ?>
    </td>
    <td class="col price" data-th="<?= $block->escapeHtml(__('Price')) ?>">
        <?= $block->getItemPriceHtml() ?>
    </td>
    <td class="col subtotal" data-th="<?= $block->escapeHtml(__('Total')) ?>">
        <?= $block->getItemRowTotalHtml() ?>
    </td>
    <td class="col status-and-action" data-th="<?= $block->escapeHtml(__('Status & Actions')) ?>">

        <?php
        $_product = $_item->getProduct();
        $order    = $_item->getOrder();

        $qtyOrdered  = (float) $_item->getQtyOrdered();
        $qtyInvoiced = (float) $_item->getQtyInvoiced();
        $qtyShipped  = (float) $_item->getQtyShipped();
        $qtyCanceled = (float) $_item->getQtyCanceled();
        $qtyRefunded = (float) $_item->getQtyRefunded();

        $orderStatus = $order->getStatus();

        /**
         * Default values
         */
        $statusTitle = '';
        $statusText  = '';
        $buttonText  = '';
        $buttonUrl   = '';

        /**
         * ESTIMATED DELIVERY DATE
         */
        $formattedDate = '';

        if (
            $qtyCanceled <= 0 &&
            $qtyRefunded <= 0 &&
            !$order->getPosId()
        ) {

            $estimationAfter = 0;

            if ($this->helper(ArtM\EstimateDelivery\Helper\Data::class)->IsEnabled()) {

                $estimateDelivery = $this->helper(
                    ArtM\EstimateDelivery\Helper\Data::class
                )->getEstimatedDeliveryDate($_item->getSku());

                if (!empty($estimateDelivery['total_days'])) {
                    $estimationAfter = (int) $estimateDelivery['total_days'];
                }
            } else {

                $shippingDaysText = $_product->getAttributeText('shippingdays');
                $dispatchText     = $_product->getAttributeText('dispatch');

                $shippingDays = 0;
                $dispatch     = 0;

                if (preg_match('/\d+/', (string)$shippingDaysText, $matches)) {
                    $shippingDays = (int)$matches[0];
                }

                if (preg_match('/\d+/', (string)$dispatchText, $matches)) {
                    $dispatch = (int)$matches[0];
                }

                $estimationAfter = $shippingDays + $dispatch;
            }

            if ($estimationAfter > 0) {
                $createdAt = new DateTime($order->getCreatedAt());
                $createdAt->modify("+{$estimationAfter} days");
                $formattedDate = $createdAt->format('j M Y');
            }
        }

        /**
         * CASE 1
         * Cancel Pending
         */
        if ($orderStatus == 'cancelpending') {

            $statusTitle = __('');
            $statusText  = __('Order Cancellation request was sent');

            /**
             * CASE 2
             * Refunded
             */
        } elseif ($qtyRefunded > 0) {

            $statusTitle = __('Refunded');

            /**
             * CASE 3
             * Cancelled
             */
        } elseif ($qtyCanceled > 0) {

            $statusTitle = __('Cancelled');

            /**
             * CASE 4
             * Delivered
             */
        } elseif ($orderStatus == 'delivered' || $orderStatus == 'replacement_order' && $qtyShipped > 0) {

            $statusTitle = __('Delivered');

            // $buttonText = __('Return / Exchange');
            // $buttonUrl  = $block->getUrl('returns');

            // // Test Static Text
            // $statusText = __('Return window closed on 28 May 2026 (13 days left)');

            if ($orderStatus == 'delivered' || $orderStatus == 'replacement_order' && $qtyShipped > 0) {

                echo $block->getLayout()
                    ->createBlock(\ArtM\CancelOrder\Block\Ordercancelbutton::class)
                    ->setTemplate('ArtM_CancelOrder::order/item/returnexchange.phtml')
                    ->setData('order', $order)
                    ->setData('item', $_item)
                    ->toHtml();
            } else {
        ?>
                <div style="font-weight:600;">
                    <?= $block->escapeHtml($statusTitle) ?>
                </div>
        <?php }

            /**
             * CASE 5
             * Shipped
             */
        } elseif ($qtyShipped > 0) {

            $statusTitle = __('Shipped');

            if (!empty($formattedDate)) {
                $statusText = __('Expected delivery by %1', $formattedDate);
            }

            $shipmentCollection = $order->getShipmentsCollection();

            if ($shipmentCollection->getSize()) {

                foreach ($shipmentCollection as $shipment) {

                    $buttonText = __('Track Shipment');

                    $buttonUrl = $block->getUrl(
                        'sales/order/shipment',
                        [
                            'order_id'    => $order->getId(),
                            'shipment_id' => $shipment->getId()
                        ]
                    );

                    break;
                }
            }

            /**
             * CASE 6
             * Processing
             */
        } elseif ($qtyInvoiced > 0) {

            $statusTitle = __('Processing');
            $statusText  = __('Shipment will be created soon');

            /**
             * CASE 7
             * Pending
             */
        } else {

            $statusTitle = __('Pending');
        }
        ?>

        <div class="order-item-status-wrapper">

            <div style="font-weight:600; margin-bottom:6px;">
                <?= $block->escapeHtml($statusTitle) ?>
            </div>

            <?php if (!empty($statusText)) : ?>
                <div class="expected-date">
                    <?= $block->escapeHtml($statusText) ?>
                </div>
            <?php endif; ?>

            <?php if (!empty($buttonText) && !empty($buttonUrl)) : ?>
                <a class="action primary"
                    href="<?= $block->escapeUrl($buttonUrl) ?>">
                    <?= $block->escapeHtml($buttonText) ?>
                </a>
            <?php endif; ?>

        </div>

    </td>
</tr>

<!-- Modal HTML -->
<div id="customization-popup" style="display:none;position:fixed;top:0;left:0;width:100vw;height:100vh;background:rgba(0,0,0,0.5);z-index:99999;overflow: scroll;">
    <div style="background:#fff;margin:40px auto;padding:20px;width:90vw;max-width:600px;border-radius:8px;position:relative;">
        <span id="customization-popup-close" style="position:absolute;top:10px;right:10px;cursor:pointer;font-size:22px;">&times;</span>
        <div id="customization-popup-content"></div>
    </div>
</div>
<!-- script here -->
<script>
    require(['jquery'], function($) {
        window.openCustomizationPopup = function(url) {
            $.get(url, function(response) {
                $('#customization-popup-content').html(response);
                $('#customization-popup').fadeIn();
            });
        };
        $('#customization-popup-close').on('click', function() {
            $('#customization-popup').fadeOut();
            $('#customization-popup-content').html('');
        });
        // Optional: close when clicking outside modal
        $('#customization-popup').on('click', function(e) {
            if (e.target === this) {
                $('#customization-popup').fadeOut();
                $('#customization-popup-content').html('');
            }
        });
    });
</script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        document.querySelectorAll(".right-boxes").forEach(function(box) {
            const blocks = box.querySelectorAll(".custom-card-block");

            if (blocks.length > 1) {
                box.classList.add("grid-apply"); // apply grid for multiple blocks
            } else {
                box.classList.remove("grid-apply"); // keep single block as normal
            }
        });
    });
</script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Select all .custom-print-data containers
        const containers = document.querySelectorAll(".custom-print-data");

        containers.forEach(function(container) {
            // Count how many .custom-print-inner-blocks are inside
            const innerBlocks = container.querySelectorAll(".custom-print-inner-blocks");

            if (innerBlocks.length > 1) {
                // Add class if more than 1 inner block
                container.classList.add("multiple-inner");
            } else {
                // Remove class if 1 or 0 inner blocks
                container.classList.remove("multiple-inner");
            }
        });
    });
</script>

