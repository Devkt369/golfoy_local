    <td class="col status-and-action" data-th="<?= $block->escapeHtml(__('Status & Actions')) ?>">

        <?php

        $_product = $_item->getProduct();
        $order = $_item->getOrder();

        $qtyOrdered  = (float) $_item->getQtyOrdered();
        $qtyInvoiced = (float) $_item->getQtyInvoiced();
        $qtyShipped  = (float) $_item->getQtyShipped();
        $qtyCanceled = (float) $_item->getQtyCanceled();
        $qtyRefunded = (float) $_item->getQtyRefunded();

        $orderStatus = $order->getStatus();

        $trackingStatusService = \Magento\Framework\App\ObjectManager::getInstance()->get(
            \ArtM\ShipmentTracking\Model\Service\ShipmentTrackingStatus::class
        );

        $itemCurrentTracking = null;

        if ($qtyShipped > 0 && !$_item->getParentItem()) {
            $itemCurrentTracking = $trackingStatusService->getItemCurrentStatus($_item);
        }

        $statusTitle = '';
        $statusText = '';
        $statusDate = '';
        $statusDisplayText = '';
        $buttonText = '';
        $buttonUrl = '';
        $trackingStatus = '';

        $formatItemStatusDate = function ($date) {
            if (empty($date)) {
                return '';
            }

            try {
                return (new DateTime($date))->format('j M Y');
            } catch (Exception $e) {
                return '';
            }
        };

        if (!empty($itemCurrentTracking)) {

            $statusDate = $formatItemStatusDate(
                $itemCurrentTracking['delivered_at']
                    ?? $itemCurrentTracking['current_status_at']
                    // ?? $itemCurrentTracking['out_for_delivery_at']
                    //  ?? $itemCurrentTracking['shipment_created_at']
                    ?? ''
            );
        }

        /**
         * Estimated Delivery Date
         */
        $formattedDate = '';

        if (
            $qtyCanceled <= 0 &&
            $qtyRefunded <= 0 &&
            !$order->getPosId()
        ) {

            $estimationAfter = 0;

            if ($this->helper(ArtM\EstimateDelivery\Helper\Data::class)->IsEnabled()) {

                $estimateDelivery = $this->helper(
                    ArtM\EstimateDelivery\Helper\Data::class
                )->getEstimatedDeliveryDate($_item->getSku());

                if (!empty($estimateDelivery['total_days'])) {
                    $estimationAfter = (int)$estimateDelivery['total_days'];
                }
            } else {

                $shippingDaysText = $_product->getAttributeText('shippingdays');
                $dispatchText = $_product->getAttributeText('dispatch');

                $shippingDays = 0;
                $dispatch = 0;

                if (preg_match('/\d+/', (string)$shippingDaysText, $matches)) {
                    $shippingDays = (int)$matches[0];
                }

                if (preg_match('/\d+/', (string)$dispatchText, $matches)) {
                    $dispatch = (int)$matches[0];
                }

                $estimationAfter = $shippingDays + $dispatch;
            }

            if ($estimationAfter > 0) {
                $createdAt = new DateTime($order->getCreatedAt());
                $createdAt->modify("+{$estimationAfter} days");
                $formattedDate = $createdAt->format('j M Y');
            }
        }

        /**
         * Status Logic
         */
        if ($orderStatus == 'cancelpending') {

            $statusTitle = __('Pending Cancellation');
            $statusText  = __('Order cancellation request was sent');
        } elseif ($qtyRefunded > 0) {

            $statusTitle = __('Refunded');
        } elseif ($qtyCanceled > 0 || $orderStatus == 'canceled') {

            $statusTitle = __('Cancelled');
        } elseif (
            $orderStatus == 'delivered'
            || ($orderStatus == 'replacement_order' && $qtyShipped > 0)
        ) {

            $statusTitle = __('Delivered');
        } elseif ($qtyShipped > 0) {

            $statusTitle = !empty($itemCurrentTracking['tracking_status'])
                ? __($itemCurrentTracking['tracking_status'])
                : __('Shipped');

            $trackingStatus = strtolower(
                trim($itemCurrentTracking['tracking_status'] ?? '')
            );

            if (
                !in_array(
                    $trackingStatus,
                    ['delivered', 'rto', 'returned'],
                    true
                )
                && !empty($formattedDate)
            ) {
                $statusText = __('Expected delivery by %1', $formattedDate);
            }

            $buttonText = __('Track Shipment');

            if (!empty($itemCurrentTracking['shipment_id'])) {

                $buttonUrl = $block->getUrl(
                    'sales/order/shipment',
                    [
                        'order_id' => $order->getId(),
                        'shipment_id' => (int)$itemCurrentTracking['shipment_id']
                    ]
                );
            } else {

                foreach ($order->getShipmentsCollection() as $shipment) {

                    foreach ($shipment->getAllItems() as $shipmentItem) {

                        if ((int)$shipmentItem->getOrderItemId() !== (int)$_item->getId()) {
                            continue;
                        }

                        $buttonUrl = $block->getUrl(
                            'sales/order/shipment',
                            [
                                'order_id' => $order->getId(),
                                'shipment_id' => $shipment->getId()
                            ]
                        );

                        break 2;
                    }
                }
            }
        } elseif ($qtyInvoiced > 0) {

            $statusTitle = __('Processing');
            $statusText = __('Shipment will be created soon');
        } else {

            $statusTitle = __('Pending');
        }

        if (!empty($statusDate) && $statusTitle != 'In transit') {
            $statusDisplayText = __('%1 on %2', $statusTitle, $statusDate);
        }
        ?>
        <?php
        $statusBadgeClass = 'status-default';

        switch ((string)$statusTitle) {
            case 'Delivered':
                $statusBadgeClass = 'status-delivered';
                break;

            case 'Processing':
                $statusBadgeClass = 'status-processing';
                break;

            case 'Pending':
                $statusBadgeClass = 'status-pending';
                break;

            case 'Refunded':
                $statusBadgeClass = 'status-refunded';
                break;

            case 'Cancelled':
                $statusBadgeClass = 'status-cancelled';
                break;

            case 'Pending Cancellation':
                $statusBadgeClass = 'status-cancelpending';
                break;

            default:
                $statusBadgeClass = 'status-default';
        }
        ?>

        <div class="order-item-status-wrapper">
            <div class="status-badge-div-web">
                <span class="status-badge <?= $statusBadgeClass ?>">
                    <?= $block->escapeHtml($statusTitle) ?>
                </span>
            </div>
            <div class="status-mobile-row">

                <?php if (!empty($statusDisplayText)) : ?>
                    <div class="status-date">
                        <?= $block->escapeHtml($statusDisplayText) ?>
                    </div>

                <?php endif; ?>

                <?php if (!empty($statusText)) : ?>
                    <div class="expected-date">
                        <?= $block->escapeHtml($statusText) ?>
                    </div>
                <?php endif; ?>

                <?php if ($statusTitle == "Delivered") : ?>
                    <div class="return-exchange-button">
                        <?php
                        echo $block->getLayout()
                            ->createBlock(\ArtM\CancelOrder\Block\Ordercancelbutton::class)
                            ->setTemplate('ArtM_CancelOrder::order/item/returnexchange.phtml')
                            ->setData('order', $order)
                            ->setData('item', $_item)
                            ->setData('delivered_date', $statusDate)
                            ->toHtml();
                        ?>
                    </div>
                <?php endif; ?>

            </div>

            <?php if (
                !empty($buttonText)
                && !empty($buttonUrl)
                && (
                    empty($trackingStatus)
                    || !in_array($trackingStatus, ['delivered', 'rto', 'returned'], true)
                )
            ) : ?>
                <a class="action primary track-shipment-btn" href="<?= $block->escapeUrl($buttonUrl) ?>">
                    <?= $block->escapeHtml($buttonText) ?>
                </a>
            <?php endif; ?>
        </div>


