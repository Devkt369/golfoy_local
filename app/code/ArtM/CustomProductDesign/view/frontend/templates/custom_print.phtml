                        $textOptions.append('<div class="customprint_field_heading">Font:</div>');
                        $textOptions.append($fontSwatchRow);
                        $textOptions.append('<div class="customprint_field_heading">Color:</div> <input data-field="text_color" type="color" class="font-color mobile_hide_only" value="#000000">');
