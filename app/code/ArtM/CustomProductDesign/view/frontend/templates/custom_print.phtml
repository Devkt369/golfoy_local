                                    var priceBreakdown = (imgRow.price_breakdown || imgRow.additional_data && imgRow.additional_data.price_breakdown) || [];
                                    var totalPrice = (imgRow.total_price !== undefined ? imgRow.total_price : imgRow.additional_data && imgRow.additional_data.total_price) || 0;
                                    if (typeof priceBreakdown === 'string') {
                                        try {
                                            priceBreakdown = JSON.parse(priceBreakdown);
