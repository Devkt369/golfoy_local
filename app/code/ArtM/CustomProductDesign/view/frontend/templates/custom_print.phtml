                    // Collect asset data (uploaded images and text content)
                    var assetData = {};
                    var areas = areasByImage[currentImage] || [];
                    areas.forEach(function(area) {
                        var areaId = area.area_id;
                        var content = userContent[areaId];
                        if (content && content.type) {
