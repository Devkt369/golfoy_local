                                        priceHtml += '<div class="customprint-price-breakdown" style="margin-bottom:8px;color:#333;font-size:16px;font-weight:normal;">';
                                        priceBreakdown.forEach(function(row, idx) {
                                            var label = '';
                                            if (row.additional_data) {
                                                try {
                                                    var addData = typeof row.additional_data === 'string' ? JSON.parse(row.additional_data) : row.additional_data;
                                                    if (addData.area_name && addData.area_name.trim() !== '') {
                                                        label = addData.area_name;
                                                    }
                                                } catch (e) {}
