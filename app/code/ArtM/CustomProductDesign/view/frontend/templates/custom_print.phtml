                            }
                            // If not found, show canvas and form as usual
                            // infoDiv.text('Current Image: ' + imgFileName + ' (No saved data found for this image)');
                            $parent.prepend(infoDiv);
                            $parent.addClass('customprint-editing-mode').removeClass('customprint-saved-mode');
                            $('#customprint-area-options').empty();
                            selectedAreaId = null; // Reset selection
                            fabric.Image.fromURL(getMediaUrl(img), function(fabImg) {
                                var maxWidth = 700;
                                var maxHeight = 500;
                                var imgWidth = fabImg.width;
                                var imgHeight = fabImg.height;
                                var ratio = Math.min(maxWidth / imgWidth, maxHeight / imgHeight, 1);
                                var canvasWidth = Math.round(imgWidth * ratio);
                                var canvasHeight = Math.round(imgHeight * ratio);
                                var $canvas = $('<canvas id="customprint-canvas" width="' + canvasWidth + '" height="' + canvasHeight + '"></canvas>');
                                $parent.append($canvas);
                                canvas = new fabric.Canvas('customprint-canvas');
                                fabImg.set({
                                    selectable: false
                                });
                                var scale = Math.min(canvas.width / fabImg.width, canvas.height / fabImg.height);
                                canvas.setBackgroundImage(fabImg, canvas.renderAll.bind(canvas), {
                                    scaleX: scale,
                                    scaleY: scale
                                });
                                drawAreas(img);
                                var areas = areasByImage[img] || [];
                                if (areas.length > 0) {
