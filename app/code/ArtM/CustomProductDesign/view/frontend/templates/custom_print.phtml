        <script>
            require([
                'jquery',
                'https://cdnjs.cloudflare.com/ajax/libs/fabric.js/5.2.4/fabric.min.js'
            ], function($) {
                var justDeletedCustomization = false;
                var endpoints = {
                    loadAreas: '/customprint/area/load',
                    saveConfig: '/customprint/area/save',
                    getCliparts: '/customprint/cliparts/clipartlist'
                };
                var productId = $('#product_id').val();
                var images = [];
                var areasByImage = {};
                var currentImage = null;
                var canvas = null;
                var areaObjects = [];
                var userImageObjects = {}; // Store image object per area
                var userContent = {};
                var selectedAreaId = null;
                var pendingAction = null;

                $("#customprint-trigger, #customprint-modal, #customprint-gallery").hide();
                $(".customprint-frontend-block").css({
                    "border": "none"
                });
                $(".product-design").on("click", function() {
                    if ($("input#print-design-check").is(":checked")) {
                        $(".customprint-frontend-block").addClass('active');
                        $("#customprint-trigger, #customprint-gallery").show();
                        $(".design-sub-title").show();
                        $(".customprint-frontend-block").css({
                            "border": "1px solid #f1f1f1"
                        });
                        $(".customprint-frontend-block").css({
                            "display": "inline-block"
                        });
                    } else {
                        $(".customprint-frontend-block").removeClass('active');
                        $(".customprint-frontend-block").css({
                            "border": "none"
                        });
                        $(".customprint-frontend-block").css({
                            "display": "none"
                        });
                        $(".design-sub-title").hide();
                        $("#customprint-trigger, #customprint-gallery").hide();
                    }
                });

                function loadCustomPrintGallery() {
                    console.log('Loading custom print gallery...');
                    var productId = $('#product_id').val();
                    var customerId = window.customerId || null;
                    var sessionId = window.sessionId || null;
                    $.get('/customprint/userdata/gallery', {
                        product_id: productId,
                        customer_id: customerId,
                        session_id: sessionId
                    }, function(resp) {
                        console.log('Gallery response:', resp);
                        $("div#customprint-gallery").remove();
                        var $gallery = $('<div id="customprint-gallery"><div class="customprint-gallery-images"></div></div>');
                        var $images = $gallery.find('.customprint-gallery-images');
                        var mediaBase = (window.MEDIA_URL ? window.MEDIA_URL : '/media/');
                        console.log('Images found:', resp.images ? resp.images.length : 0);
                        if (resp.images && resp.images.length) {
                            $('input#print-design-check').prop('checked', true);
                            $("#customprint-trigger").show();
                            $(".customprint-frontend-block").css({
                                "border": "1px solid #f1f1f1"
                            });
                            $(".customprint-frontend-block").css({
                                "display": "inline-block"
                            });
                            $gallery.prepend('<h4>Configured Images</h4>');
                            resp.images.forEach(function(row) {
                                console.log('Processing image row:', row);
                                var imgSrc = '';
                                var baseUrl = window.BASE_URL || '';
                                if (row.img_path && row.img_path.trim() !== '') {
                                    var mediaPrefix = '/pub/media/';
                                    var relPath = row.img_path.startsWith('/') ? row.img_path.substring(1) : row.img_path;
                                    imgSrc = baseUrl + mediaPrefix + relPath;
                                    console.log('Image source constructed:', imgSrc);
                                }
                                if (imgSrc) {
                                    $images.append('<div style="display:inline-block;margin:10px;text-align:center;"><img src="' + imgSrc + '" style="max-width:120px;border-radius:8px;"><br><span style="font-size:12px;color:#555;">' + (row.created_at || '') + '</span></div>');
                                } else {
                                    console.log('No image source - skipping row');
                                }
                            });
                        } else {
                            $("div#customprint-gallery").remove();
                            $gallery = '';
                            $images.append('<div class="design-sub-title" style="color:#888; display:none;">Please click above link to configure your custom prints.</div>');
                        }
                        $('.customprint-frontend-block').append($gallery);
                    }, 'json');
                }



                // Modal logic
                $('#customprint-trigger').on('click', function() {
                    $('#customprint-modal').fadeIn();
                    // Clear previous content to avoid stale UI
                    $('#customprint-image-gallery').empty();
                    $('#customprint-canvas-container').empty();
                    $('#customprint-area-options').empty();
                    $('#customprint-download-btn').hide();
                    loadImagesAndAreas();
                });
                $('#customprint-close').on('click', function() {
                    console.log('justDeletedCustomization');

                    function doCloseModal() {
                        $('#customprint-modal').fadeOut();
                    }
                    // If unsaved popup is already open, do nothing
                    if ($('#customprint-unsaved-popup').is(':visible')) {
                        return;
                    }
                    if ($('#customprint-save-btn').is(':visible')) {
                        if (justDeletedCustomization) {
                            justDeletedCustomization = false;
                            doCloseModal();
                        } else {
                            pendingAction = doCloseModal;
                            $('#customprint-unsaved-popup').fadeIn();
                        }
                    } else {
                        doCloseModal();
                    }

                });
                $('#customprint-modal').on('click', function(e) {
                    // If unsaved popup is open, block modal close

                    if ($('#customprint-unsaved-popup').is(':visible')) {
                        return;
                    }
                    if (e.target === this) {
                        if ($('#customprint-save-btn').is(':visible')) {
                            pendingAction = function() {
                                $('#customprint-modal').fadeOut();
                            };
                            $('#customprint-unsaved-popup').fadeIn();
                        } else {
                            $(this).fadeOut();
                        }
                    }
                });

                // Unsaved changes popup handlers
                $('#customprint-unsaved-discard').on('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    $('#customprint-save-btn').hide();
                    $('#customprint-unsaved-popup').fadeOut();
                    var action = pendingAction;
                    pendingAction = null;
                    if (typeof action === 'function') {
                        setTimeout(action, 0);
                    }
                });
                $('#customprint-unsaved-keep').on('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    $('#customprint-unsaved-popup').fadeOut();
                    pendingAction = null;
                });

                function loadImagesAndAreas() {
                    $.get(endpoints.loadAreas, {
                        product_id: productId
                    }, function(resp) {
                        images = [];
                        areasByImage = {};
                        // Debug output
                        console.log('CustomPrint AJAX Response:', resp);
                        if (!resp || typeof resp !== 'object') {
                            $('#customprint-image-gallery').html('<div style="color:red;font-weight:bold;">Error: No response from server.</div>');
                            return;
                        }
                        if (resp.areas && resp.areas.length) {
                            resp.areas.forEach(function(area) {
                                var img = area.image;
                                if (!images.includes(img)) images.push(img);
                                if (!areasByImage[img]) areasByImage[img] = [];
                                areasByImage[img].push(area);
                            });
                        }
                        renderImageGallery();
                        // Automatically show the first image and its canvas if available
                        if (images.length > 0) {
                            showImageCanvas(images[0]);
                        } else {
                            $('#customprint-canvas-container').html('<div style="color:red;font-weight:bold;">No custom print areas found for this product.</div>');
                            $('#customprint-area-options').html('');
                        }
                    }, 'json').fail(function(xhr, status, error) {
                        $('#customprint-image-gallery').html('<div style="color:red;font-weight:bold;">AJAX Error: ' + error + '</div>');
                        // After $areaDiv is fully constructed, initialize all .bar_fill inside it
                        $areaDiv.find('.bar_fill').each(function() {
                            var $bar = $(this);
                            var min = parseInt($bar.attr('min')) || 0;
                            var max = parseInt($bar.attr('max')) || 100;
                            var step = parseInt($bar.attr('each_bar_value')) || 1;
                            var valueAfter = parseInt(($bar.attr('value_after') || '20%').replace('%', '')) || 20;
                            var showValue = $bar.attr('show_value') === 'true';
                            var totalBars = Math.floor((max - min) / step) + 1;
                            var $lines = $bar.find('.bar_lines');
                            $lines.empty();
                            for (var i = 0; i < totalBars; i++) {
                                var percent = (i / (totalBars - 1)) * 100;
                                var barValue = min + i * step;
                                var showLabel = (i === 0 || i === totalBars - 1 || (valueAfter && (i % Math.floor(totalBars * valueAfter / 100) === 0)));
                                if (showLabel && showValue) {
                                    var label = $('<span></span>', {
                                        'class': 'bar_label',
                                        'data-value': barValue
                                    }).text(barValue);
                                    $lines.append(label);
                                } else {
                                    var tick = $('<span></span>', {
                                        'class': 'bar_tick',
                                        'data-value': barValue
                                    });
                                    $lines.append(tick);
                                }
                            }
                            // Attach scroll event to .bar_fill instead of .bar_lines
                            $bar.off('scroll').on('scroll', function() {
                                var $barFill = $(this);
                                var $barLines = $barFill.find('.bar_lines');
                                var barFillWidth = $barFill.width();
                                var scrollLeft = $barFill.scrollLeft();
                                var centerX = scrollLeft + barFillWidth / 2;
                                var closest = null;
                                var closestDist = Infinity;
                                $barLines.children('span').each(function() {
                                    var $tick = $(this);
                                    var tickLeft = $tick.position().left + $tick.width() / 2;
                                    var dist = Math.abs(tickLeft - centerX);
                                    if (dist < closestDist) {
                                        closestDist = dist;
                                        closest = $tick;
                                    }
                                });
                                if (closest) {
                                    var value = closest.data('value');
                                    var target = $barFill.attr('data-target');
                                    // Update only elements with matching data-flow
                                    $('[data-flow="' + target + '"]').each(function() {
                                        if ($(this).is('input')) {
                                            $(this).val(value).trigger('input');
                                        } else {
                                            $(this).text(value);
                                        }
                                    });
                                }
                            });
                        });
                    });
                }

                function renderImageGallery() {
                    var $gallery = $('#customprint-image-gallery').empty();
                    if (images.length === 0) {
                        $gallery.append('<div style="color:red;font-weight:bold;">No custom print images found for this product.</div>');
                        $('#customprint-download-btn').hide();
                        return;
                    }
                    images.forEach(function(img, idx) {
                        var $img = $('<img>')
                            .attr('src', getMediaUrl(img))
                            .addClass('customprint-thumb')
                            .css({
                                maxWidth: '120px',
                                margin: '10px',
                                cursor: 'pointer',
                                border: '2px solid #007bff',
                                borderRadius: '8px'
                            });
