                            } catch (e) {}
                        }
                        if (!label && area.area_label) label = area.area_label;
                        // Do NOT fallback to 'Area N' -- only show actual names
                        var filledType = (userContent[areaId] && userContent[areaId].type) ? userContent[areaId].type : null;
                        var priceForType = 0;
                        if (filledType === 'text') {
