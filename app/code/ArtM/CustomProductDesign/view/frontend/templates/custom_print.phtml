                function drawAreas(img) {
                    areaObjects = [];
                    var areas = areasByImage[img] || [];
                    areas.forEach(function(area, idx) {
                        var data = JSON.parse(area.area_data);
                        var rect = new fabric.Rect({
                            left: data.x * canvas.width,
                            top: data.y * canvas.height,
                            width: data.width * canvas.width,
                            height: data.height * canvas.height,
                            fill: 'rgba(0,0,0,0)', // fully transparent
                            stroke: '#cccccc', // light grey
                            strokeDashArray: [6, 4], // dotted border
                            strokeWidth: 2,
                            selectable: false,
                            evented: true,
                            hasControls: false,
                            areaId: area.area_id
                        });
                        rect.on('mouseover', function() {
                            showTooltip(area, rect.left, rect.top);
                        });
                        rect.on('mouseout', hideTooltip);
                        rect.on('mousedown', function() {
                            // Remove highlight from all areas
                            areaObjects.forEach(function(obj) {
                                obj.set('fill', 'rgba(0,0,0,0)');
                                obj.set('stroke', '#cccccc');
                            });
                            // Highlight selected area
                            rect.set('stroke', 'black');
                            canvas.renderAll();
                            selectedAreaId = area.area_id;
                            $('.customprint-area-option').hide();
                            $('.customprint-area-option[data-area-id="' + area.area_id + '"]').show();
                            // Select content object (text or image) for this area
                            var obj = canvas.getObjects().find(function(o) {
                                return o.userAreaId === area.area_id && (o.type === 'textbox' || o.type === 'image');
                            });
                            if (obj) {
                                canvas.setActiveObject(obj);
                                canvas.renderAll();
                            }
                        });
                        canvas.add(rect);
                        areaObjects.push(rect);
                    });
                    canvas.renderAll();
                }

                function getAreaColor(idx, border) {
                    var colors = ['rgba(255,0,0,0.2)', 'rgba(0,255,0,0.2)', 'rgba(0,0,255,0.2)', 'rgba(255,255,0,0.2)'];
                    var borders = ['red', 'green', 'blue', 'orange'];
                    return border ? borders[idx % borders.length] : colors[idx % colors.length];
