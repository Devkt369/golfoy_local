                                    if (!imgPath.startsWith('/pub/media/')) {
                                        if (imgPath.startsWith('/')) {
                                            imgPath = '/pub/media' + imgPath;
                                        } else {
                                            imgPath = '/pub/media/' + imgPath;
                                        }
                                    }
                                    var imgSrc = baseUrl.replace(/\/$/, '') + imgPath;
