                                    html += '<button id="customprint-remove-image-btn" style="background:#dc3545;color:#fff;border:none;padding: 11px 16px 8px 16px;border-radius:6px;cursor:pointer;font-weight:bold;">Remove Configuration</button>';
                                    html += '<a href="' + imgSrc + '" download="custom_print_saved.png" id="customprint-download-btn-saved" title="Download Preview" style="background:#fff;border:1px solid #007bff;color:#007bff;padding:8px 16px;border-radius:6px;cursor:pointer;font-weight:bold;display:flex;align-items:center;gap:6px;text-decoration:none;">';
                                    html += '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#007bff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg> Download Preview</a>';
                                    html += '</div>';
                                    infoDiv.html(html);
                                    $parent.addClass('customprint-saved-mode').removeClass('customprint-editing-mode');
                                    $parent.prepend(infoDiv);
                                    // Remove handler
                                    $('#customprint-remove-image-btn').off('click').on('click', function(e) {
                                        e.preventDefault();
                                        e.stopPropagation();
                                        $('#customprint-unsaved-popup').hide();
                                        if (confirm('Are you sure you want to delete this configuration?')) {
                                            $.post('/customprint/userdata/delete', {
                                                id: imgRow.id
                                            }, function(resp) {
                                                if (resp.success) {
                                                    $('#customprint-save-btn').hide();
                                                    pendingAction = null;
                                                    loadImagesAndAreas();
                                                    loadCustomPrintGallery();
