                function showClipartPopup(areaId) {
                    // Remove existing popup if any
                    $('#clipart-popup').remove();

                    // Create popup overlay
                    var $overlay = $('<div id="clipart-popup" style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:10000;display:flex;align-items:center;justify-content:center;"></div>');

                    // Create popup content
                    var $popup = $('<div style="background:white;border-radius:8px;padding:20px;max-width:80%;max-height:80%;overflow-y:auto;position:relative;"></div>');

                    // Add header
                    $popup.append('<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;border-bottom:1px solid #eee;padding-bottom:10px;max-height: 40px;">' +
                        '<h3 class="customprint_field_heading_popup">Choose from below images</h3>' +
                        '<button id="close-clipart-popup" style="background:none;border:none;font-size:24px;cursor:pointer;color:#999;">&times;</button>' +
                        '</div>');

                    // Add loading message
                    var $gallery = $('<div id="clipart-gallery"></div>');
                    $gallery.append('<div style="grid-column:1/-1;text-align:center;color:#666;">Loading...</div>');
                    $popup.append($gallery);

                    $overlay.append($popup);
                    $('body').append($overlay);

                    // Load cliparts
                    loadCliparts(function(cliparts) {
                        $gallery.empty();
                        if (cliparts.length === 0) {
                            $gallery.append('<div style="grid-column:1/-1;text-align:center;color:#666;">No cliparts available</div>');
                            return;
                        }

                        cliparts.forEach(function(originalUrl) {
                            var $item = $('<div class="clipart-item"></div>');

                            // Create thumbnail URL by inserting 'thumbnail/' before the filename
                            var urlParts = originalUrl.split('/');
                            var filename = urlParts.pop(); // Get the filename (e.g., '1.png')
                            var thumbnailUrl = urlParts.join('/') + '/thumbnail/' + filename;

                            var $img = $('<img style="width:80px;height:80px;object-fit:contain;display:block;margin:0 auto 5px;" src="' + thumbnailUrl + '" alt="Clipart">');
                            var $name = $('<div style="font-size:12px;color:#666;word-break:break-all;">' + filename + '</div>');

                            $item.append($img);

                            // Add hover effect
                            $item.on('mouseenter', function() {
                                $(this).css({
                                    'border-color': '#007bff',
                                    'background': '#e3f2fd'
                                });
                            }).on('mouseleave', function() {
                                $(this).css({
                                    'border-color': '#ddd',
                                    'background': '#f9f9f9'
                                });
                            });

                            // Add click handler - use original URL for canvas, not thumbnail
                            $item.on('click', function() {
                                console.log('Clipart clicked - Thumbnail:', thumbnailUrl, 'Original:', originalUrl);
                                handleClipartSelect(areaId, originalUrl); // Pass original URL for canvas
                                $('#clipart-popup').remove();
                            });

                            $gallery.append($item);
                        });
                    });

                    // Close handlers
                    $('#close-clipart-popup, #clipart-popup').on('click', function(e) {
                        if (e.target === this) {
                            $('#clipart-popup').remove();
                        }
                    });
                }

                function updateAreaContent(areaId, type, value) {
                    $('#customprint-save-btn').show();
                    userContent[areaId] = userContent[areaId] || {};
                    userContent[areaId].type = type;
                    userContent[areaId].value = value;
                    // Remove the other type from canvas and userContent
                    if (type === 'text') {
                        // Remove image object for this area
                        if (canvas) {
                            var objs = canvas.getObjects();
                            for (var i = objs.length - 1; i >= 0; i--) {
                                if (objs[i].userAreaId === areaId && objs[i].type === 'image') {
                                    canvas.remove(objs[i]);
                                }
                            }
                            canvas.renderAll();
                        }
                        userImageObjects[areaId] = undefined;
                    } else if (type === 'image') {
                        // Remove text object for this area
                        if (canvas) {
                            var objs = canvas.getObjects();
                            for (var i = objs.length - 1; i >= 0; i--) {
                                if (objs[i].userAreaId === areaId && objs[i].type === 'textbox') {
                                    canvas.remove(objs[i]);
                                }
                            }
                            canvas.renderAll();
                        }
                    }
                    renderUserContentOnCanvas(areaId);
                }

                function handleImageUpload(areaId, file) {
                    var reader = new FileReader();
                    reader.onload = function(e) {
                        updateAreaContent(areaId, 'image', e.target.result);
                    };
                    reader.readAsDataURL(file);
                }

                function handleClipartSelect(areaId, url) {
                    console.log('Clipart selected:', {
                        areaId: areaId,
                        url: url
                    });
                    updateAreaContent(areaId, 'image', url);
                    console.log('Updated userContent:', userContent);
                }

                function updateTextProperties(areaId, $areaDiv) {
