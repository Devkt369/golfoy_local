                    var align = $areaDiv.find('.font-align').val();
                    userContent[areaId] = userContent[areaId] || {};
                    userContent[areaId].font = font;
                    userContent[areaId].color = color;
                    userContent[areaId].size = size;
                    userContent[areaId].align = align;
                    renderUserContentOnCanvas(areaId);
                }

                function renderUserContentOnCanvas(areaId) {
                    // Remove previous text object, but keep image object if present
                    canvas.getObjects().forEach(function(obj) {
                        if (obj.userAreaId === areaId && obj.type === 'textbox') canvas.remove(obj);
                    });
                    var area = (areasByImage[currentImage] || []).find(a => a.area_id == areaId);
                    if (!area) return;
                    var data = JSON.parse(area.area_data);
                    var left = data.x * canvas.width;
                    var top = data.y * canvas.height;
                    var width = data.width * canvas.width;
                    var height = data.height * canvas.height;
                    var content = userContent[areaId];
                    if (!content || !content.type || !content.value) return;

                    var objToSelect = null;
                    if (content.type === 'text') {
                        var clipRect = new fabric.Rect({
                            left: left,
                            top: top,
                            width: width,
                            height: height,
                            absolutePositioned: true
                        });
                        var text = new fabric.Textbox(content.value, {
                            left: left + 10,
                            top: top + 10,
                            width: width - 20,
                            height: height - 20,
                            fontFamily: content.font || 'Arial',
                            fontSize: parseInt(content.size) || 18,
                            fill: content.color || '#000',
                            textAlign: content.align || 'left',
                            userAreaId: areaId,
                            editable: true,
                            clipPath: clipRect,
                            borderColor: 'black',
                            borderDashArray: [6, 4]
                        });
                        text.setControlsVisibility({
                            mt: false,
                            mb: false,
                            ml: false,
                            mr: false
                        });
                        canvas.add(text);
                        objToSelect = text;
                    } else if (content.type === 'image') {
                        // If image object already exists for this area, just update its image if changed
                        var prevObj = userImageObjects[areaId];
                        if (prevObj) {
                            // If image URL changed, replace image
                            if (prevObj._originalUrl !== content.value) {
                                canvas.remove(prevObj);
                                prevObj = null;
                            }
                        }
                        if (!prevObj) {
                            // For cliparts, ensure we use the original URL (not thumbnail) for canvas
                            var imageUrl;
                            if (content.value.startsWith('/media/customprint/cliparts/') || content.value.startsWith('/customprint/cliparts/')) {
                                // It's a clipart - make sure we use original, not thumbnail
                                imageUrl = content.value.replace('/thumbnail/', '/'); // Remove thumbnail path if present
                            } else {
                                // It's an uploaded image
                                imageUrl = getMediaUrl(content.value);
                            }
                            fabric.Image.fromURL(imageUrl, function(imgObj) {
                                var clipRect = new fabric.Rect({
                                    left: left,
                                    top: top,
                                    width: width,
                                    height: height,
                                    absolutePositioned: true
                                });
                                var scale = Math.min((width - 20) / imgObj.width, (height - 20) / imgObj.height);
                                imgObj.set({
                                    left: left + 10,
                                    top: top + 10,
                                    scaleX: scale,
                                    scaleY: scale,
                                    userAreaId: areaId,
                                    hasControls: true,
                                    clipPath: clipRect,
                                    borderColor: 'black',
                                    borderDashArray: [6, 4]
                                });
                                imgObj._originalUrl = content.value;
                                userImageObjects[areaId] = imgObj;
                                canvas.add(imgObj);
                                canvas.setActiveObject(imgObj);
                                canvas.discardActiveObject();
                                canvas.renderAll();
                            });
                        } else {
                            // Already present, just update position/scale if needed
                            prevObj.set({
                                left: left + 10,
                                top: top + 10
                            });
                            prevObj.setCoords();
                            canvas.renderAll();
                        }
                        return;
                    }
                    if (objToSelect) {
                        canvas.setActiveObject(objToSelect);
                        canvas.discardActiveObject();
                    }
                    canvas.renderAll();
                }

