                                });
                                canvas.on('selection:updated', function(e) {
                                    var obj = e.selected && e.selected[0];
                                    if (obj && obj.userAreaId && (obj.type === 'textbox' || obj.type === 'image')) {
                                        areaObjects.forEach(function(rect) {
                                            if (rect.areaId == obj.userAreaId) {
                                                rect.set('stroke', 'black');
                                            } else {
                                                rect.set('stroke', '#cccccc');
                                            }
                                        });
                                        canvas.renderAll();
                                        selectedAreaId = obj.userAreaId;
                                        $('.customprint-area-option').hide();
                                        $('.customprint-area-option[data-area-id="' + obj.userAreaId + '"]').show();
                                    }
