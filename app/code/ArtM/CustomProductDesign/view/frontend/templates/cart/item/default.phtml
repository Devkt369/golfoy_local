<script>
    document.addEventListener("DOMContentLoaded", function() {
        document.querySelectorAll(".right-boxes").forEach(function(box) {
            const blocks = box.querySelectorAll(".custom-card-block");

            if (blocks.length > 1) {
                box.classList.add("grid-apply"); // apply grid for multiple blocks
            } else {
                box.classList.remove("grid-apply"); // keep single block as normal
            }
        });
    });
</script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Select all .custom-print-data containers
        const containers = document.querySelectorAll(".custom-print-data");

        containers.forEach(function(container) {
            // Count how many .custom-print-inner-blocks are inside
            const innerBlocks = container.querySelectorAll(".custom-print-inner-blocks");

            if (innerBlocks.length > 1) {
                // Add class if more than 1 inner block
                container.classList.add("multiple-inner");
            } else {
                // Remove class if 1 or 0 inner blocks
                container.classList.remove("multiple-inner");
            }
        });
    });
</script>