            $dataJson = $_item->getData('custom_design_userdata_ids');
            $jsonObjects = $dataJson ? preg_split('/(?<=\})\s*(?=\{)/', $dataJson) : [];
            $hasCustomization = false;

            // Check if we have valid JSON data
            if ($jsonObjects) {
                foreach ($jsonObjects as $jsonStr) {
                    if (json_decode($jsonStr, true)) {
                        $hasCustomization = true;
                        break;
                    }
                }
            }

            if ($hasCustomization): ?>
                <div class="custom-print-data-blocks">
                    <?php
                    // Split JSON objects by "}{"
                    $jsonObjects = preg_split('/(?<=\})\s*(?=\{)/', $dataJson);
                    $overallTotalPrice = 0; // Initialize total price variable
                    $mediaUrl = $block->getUrl('pub/media/') ?: '/pub/media/';

                    // Calculate overall total price once
                    if ($jsonObjects) {
                        foreach ($jsonObjects as $jsonStr) {
                            $data = json_decode($jsonStr, true);
                            if ($data && isset($data['additional_data'])) {
                                $additionalData = json_decode($data['additional_data'], true);
                                $totalPrice = $additionalData['total_price'] ?? 0;
                                $overallTotalPrice += $totalPrice;
                            }
                        }
                    }

                    // Display heading with total price
                    if (!isset($headingDisplayed)): ?>
                        <div class="custom-print-data-block_heading">
                            <span class="customize-text">Customized Details</span>
                            <span class="customize-text total-cost">Printing Cost: ₹<?php echo htmlspecialchars($overallTotalPrice); ?></span>
                        </div>
                        <?php $headingDisplayed = true; ?>
                    <?php endif; ?>

                    <?php
                    // Process each JSON object
                    if ($jsonObjects) {
                        foreach ($jsonObjects as $jsonStr) {
                            $data = json_decode($jsonStr, true);
