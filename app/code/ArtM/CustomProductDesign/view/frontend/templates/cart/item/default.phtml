                        var currentStyle = jQuery(this).attr('style') || '';
                        jQuery(this).attr('style', currentStyle + 'padding-top: ' + finalPadding + 'px !important; padding-bottom: ' + finalPadding + 'px !important;');
                    });
                }
            });

        });
    });
</script>

